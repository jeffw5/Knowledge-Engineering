  dct:created "2025-08-01T19:11:40.243Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:governance
  a skos:Concept ;
  skos:prefLabel "Governance"@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:filters ;
  skos:narrower voc:certification-level , voc:status ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T18:54:22.568Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:certification-level
  a skos:Concept ;
  skos:prefLabel "Certification level"@en ;
  skos:definition "Describes the current governance certification level of Marketplace content and is an important process within governance that can help establish controls that will enable accuracy and reliability."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:governance ;
  skos:narrower voc:bronze , voc:gold , voc:silver , voc:uncertified ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T18:55:22.919Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:bronze
  a skos:Concept ;
  skos:prefLabel "Bronze"@en ;
  skos:definition "A certification level that is used to gain understanding. This level establishes a baseline catalog with standard metadata attributes, establishes ownership and accountability, starts the data lineage journey & adopts intake and approval processes."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:certification-level ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T18:55:39.846Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:gold
  a skos:Concept ;
  skos:prefLabel "Gold"@en ;
  skos:definition "A certification level that is used to establish trust. It enables automated controls and monitoring, monitors measurements and enables continuous improvement, establishes governance through full lifecycle from source & extends data lineage understanding to data source or origin."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:certification-level ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T18:55:39.846Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:silver
  a skos:Concept ;
  skos:prefLabel "Silver"@en ;
  skos:definition "A certification level that is used to measure and monitor. This level establishes measurement of controls to determine effectiveness, establishes underlying data quality measurement framework & understands and documents classification from Legal and security point of view."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:certification-level ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T18:55:39.846Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:uncertified
  a skos:Concept ;
  skos:prefLabel "Uncertified"@en ;
  skos:definition "Indicates that no certification level has been attained."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:certification-level ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T18:55:39.846Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:status
  a skos:Concept ;
  skos:prefLabel "Status"@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:governance ;
  skos:narrower voc:active , voc:deprecated , voc:inactive , voc:retired ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T18:55:22.919Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:active
  a skos:Concept ;
  skos:prefLabel "Active"@en ;
  skos:definition "Currently in use or operation; fully functional and supported."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:status ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T18:58:23.314Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:deprecated
  a skos:Concept ;
  skos:prefLabel "Deprecated"@en ;
  skos:definition "No longer recommended for use and planned for retirement in the future; may have limited functionality or support."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:status ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T18:58:23.314Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:inactive
  a skos:Concept ;
  skos:prefLabel "Inactive"@en ;
  skos:definition "Not currently in use but potentially reusable; may or may not be supported."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:status ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T18:58:23.314Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:retired
  a skos:Concept ;
  skos:prefLabel "Retired"@en ;
  skos:definition "Permanently out of use and not supported; typically kept for archival purposes."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:status ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T18:58:23.314Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:metric-reporting-scope
  a skos:Concept ;
  skos:prefLabel "Metric reporting scope"@en ;
  skos:definition "Indicates if the metric is reported internally within VZ, externally from VZ, or both."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:filters ;
  skos:narrower voc:external , voc:internal ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T19:06:33.796Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:external
  a skos:Concept ;
  skos:prefLabel "External"@en ;
  skos:definition "Data and insights related to factors outside the organization’s direct control, such as market trends, competitor activity, or public perception. This data is often gathered from publicly available sources or third-party providers."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:metric-reporting-scope ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T19:14:49.217Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:internal
  a skos:Concept ;
  skos:prefLabel "Internal"@en ;
  skos:definition "Data and insights reflecting the performance, usage, or behavior within an organization’s own systems and processes. This data is typically not shared publicly."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:metric-reporting-scope ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T19:14:58.636Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:ownership
  a skos:Concept ;
  skos:prefLabel "Ownership"@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:filters ;
  skos:narrower voc:owner , voc:responsible-hub-and-spoke ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T18:54:22.568Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:owner
  a skos:Concept ;
  skos:prefLabel "Owner"@en ;
  skos:definition "Describes the high-level owner of Marketplace content and to whom questions about Marketplace content can be directed."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:ownership ;
  skos:narrower voc:accountable-executive-sponsor ,
      voc:business-process-owner ,
      voc:consulted-business-metric-stewards ,
      voc:consulted-spoke ,
      voc:consulted-technical-metric-stewards ,
      voc:data-architect ,
      voc:data-product-analyst ,
      voc:data-product-governance ,
      voc:data-product-owner ,
      voc:data-scientist ,
      voc:machine-learning-engineer ,
      voc:product-group-coordinator ,
      voc:responsible-business-metric-stewards ,
      voc:responsible-business-report-stewards ,
      voc:responsible-metric-champion ,
      voc:responsible-technical-metric-stewards ,
      voc:responsible-technical-report-stewards ,
      voc:scrum-master ,
      voc:solution-leader ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T19:00:03.767Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:accountable-executive-sponsor
  a skos:Concept ;
  skos:prefLabel "Accountable executive sponsor"@en ;
  skos:definition "An executive who is ultimately accountable for the metric. This person drives cross-domain coordination of strategies, provides an escalation path for the Metric Champion, and ensures data strategy is aligned to business strategy (typically a VP or above)."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:owner ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T19:00:24.792Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:business-process-owner
  a skos:Concept ;
  skos:prefLabel "Business process owner"@en ;
  skos:definition "The customer of data products. There could be more than one customer for a particular product – but there needs to be at least one."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:owner ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T19:00:24.792Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:consulted-business-metric-stewards
  a skos:Concept ;
  skos:prefLabel "Consulted business metric stewards"@en ;
  skos:definition "The Business Metric Stewards who represent the spokes who do not own this metric, but are to be consulted regarding it."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:owner ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T19:00:24.792Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:consulted-spoke
  a skos:Concept ;
  skos:prefLabel "Consulted spoke"@en ;
  skos:definition "The spoke teams who represent the spokes who do not own this metric, but are to be consulted regarding it."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:owner ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T19:00:24.792Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:consulted-technical-metric-stewards
  a skos:Concept ;
  skos:prefLabel "Consulted technical metric stewards"@en ;
  skos:definition "The Technical Metric Stewards who represent the spokes who do not own this metric, but are to be consulted regarding it."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:owner ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T19:00:24.792Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:data-architect
  a skos:Concept ;
  skos:prefLabel "Data architect"@en ;
  skos:definition "Ensures solution aligns with overall technical vision, product architecture fits together."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:owner ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T19:00:24.792Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:data-product-analyst
  a skos:Concept ;
  skos:prefLabel "Data product analyst"@en ;
  skos:definition "Data products must have this role which develops analysis and provide technical product requirements as needed. They deeply understand the data, its use-cases and its business context."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:owner ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T19:00:24.792Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:data-product-governance
  a skos:Concept ;
  skos:prefLabel "Data product governance"@en ;
  skos:definition "Ensures product is not redundant, confirms compliance with governance standards, certifies product"@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:owner ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T19:00:24.792Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:data-product-owner
  a skos:Concept ;
  skos:prefLabel "Data product owner"@en ;
  skos:definition "Data products must have this role which provides solutions to the needs of business process owners. They are the single point of contact for the business process owner. They are accountable for establishing the overall feature roadmap, including the prioritization and initial feature sequencing, for understanding the technical challenges necessary for developing that roadmap, ensuring the product meets their customers’ needs, identifying new use cases for the product, etc."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:owner ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T19:00:24.792Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:data-scientist
  a skos:Concept ;
  skos:prefLabel "Data scientist"@en ;
  skos:definition "Data products may have this role which develops reusable production ML models. They’re responsible for model creation, model performance, and model refresh/rebuild."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:owner ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T19:00:24.792Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:machine-learning-engineer
  a skos:Concept ;
  skos:prefLabel "Machine learning engineer"@en ;
  skos:definition "Data products may have this role which develops production ML model scoring pipelines. They’re responsible for scoring pipeline, model API, and model monitoring."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:owner ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T19:00:24.792Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:product-group-coordinator
  a skos:Concept ;
  skos:prefLabel "Product group coordinator"@en ;
  skos:definition "Scrum-master-in-chief; same role as a scrum master, for a group of products. Does not interact with customers or translate business needs."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:owner ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T19:00:24.792Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:responsible-business-metric-stewards
  a skos:Concept ;
  skos:prefLabel "Responsible business metric stewards"@en ;
  skos:definition "This role fully understands the business context of the metric and very often comes up with the need for the metric, defines and manages the business definition, objectives and purpose of the metric, provides business formula for the calculation of the metric in simple understandable language, manages & approves all business decisions related to the metric, and is responsible for ongoing maintenance of business metadata of the metric."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:owner ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T19:00:24.792Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:responsible-business-report-stewards
  a skos:Concept ;
  skos:prefLabel "Responsible business report stewards"@en ;
  skos:definition "This role fully understands the business context of the report and very often comes up with the need for the report, defines and manages the business definition, objectives and purpose of the report, manages & approves all business decisions related to the report, and is responsible for ongoing maintenance of business metadata of the report."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:owner ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T19:00:24.792Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:responsible-metric-champion
  a skos:Concept ;
  skos:prefLabel "Responsible metric champion"@en ;
  skos:definition "A leader who is responsible for the overall strategy regarding the metric (typically a Sr. Director or above)."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:owner ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T19:00:24.792Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:responsible-technical-metric-stewards
  a skos:Concept ;
  skos:prefLabel "Responsible technical metric stewards"@en ;
  skos:definition "This role not only understands the business context, objectives and purpose of the metric, but is also responsible for defining the technical details of metric calculations. This individual is responsible for understanding and defining one or many of the following details: how a metric should be calculated, which are the best data sources for pulling the data for calculations, what additional calculations need to be made in order to report the metric (Report/Dashboard etc.). This person approves all decisions that affect the data used in calculating a metric."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:owner ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T19:00:24.792Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:responsible-technical-report-stewards
  a skos:Concept ;
  skos:prefLabel "Responsible technical report stewards"@en ;
  skos:definition "This role not only understands the business context, objectives and purpose of the report, but is also responsible for defining the technical details of the report. This individual is responsible for understanding and defining many report details."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:owner ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T19:00:24.792Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:scrum-master
  a skos:Concept ;
  skos:prefLabel "Scrum master"@en ;
  skos:definition "Data products may have this role which enables a team's delivery across sprints. They manage sprint planning/iteration, facilitate daily standups, administrate the team's board, and capture retrospective opportunities."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:owner ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T19:00:24.792Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:solution-leader
  a skos:Concept ;
  skos:prefLabel "Solution leader"@en ;
  skos:definition "Data products must have this role which is the delivery owner for the data product. They define the product's technical vision and own the in-depth delivery of the product's technical solution and are responsible for the product's technical performance. They confirm that the correct skills are present for technical delivery, and work to resolve gaps."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:owner ;
  owl:versionInfo "0.1.0" ;
