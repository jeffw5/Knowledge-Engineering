voc:customer-bill-collection
  a skos:Concept ;
  skos:prefLabel "Customer bill collection"@en ;
  skos:definition "The process data and records related to managing overdue payments, credit violations, and facility billing audits for a Customer."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:customer-core ;
  skos:narrower voc:customer-payment , voc:dunning ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
