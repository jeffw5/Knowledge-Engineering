rulestax:guardrail-rule
  a skos:Concept ;
  rdfs:label "Guardrail rule"@en ;
  skos:prefLabel "Guardrail rule"@en ;
  skos:altLabel "AI guardrail"@en ,
      "Agent guardrail"@en ,
      "Artificial intelligence guardrail"@en ;
  skos:definition "A rule that limits the inputs, actions, or outputs of an automated agent."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core-rules/> ;
  skos:topConceptOf <https://www.insperity.com/taxonomy/core-rules/> ;
  skos:narrower rulestax:action-guardrail ,
      rulestax:circuit-breaker-rule ,
      rulestax:input-guardrail ,
      rulestax:output-guardrail ;
  core:hasPrimaryTerm rulesvoc:rules ;
  dct:subject rulesvoc:guardrail , rulesvoc:rules ;
  core:formalizedBy core:rule ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-17T01:38:18Z"^^xsd:dateTime ;
  dct:modified "2026-10-19T18:44:22Z"^^xsd:dateTime .

