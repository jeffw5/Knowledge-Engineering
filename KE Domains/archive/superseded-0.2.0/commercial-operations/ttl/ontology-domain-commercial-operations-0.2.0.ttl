<https://www.insperity.com/ontology/domain-commercial-operations/>
  a owl:Ontology ;
  rdfs:label "Commercial operations domain ontology"@en ;
  dct:title "Commercial operations domain ontology"@en ;
  dct:description "The container ontology of the Commercial Operations operational area. It extends the core domain ontology with the classes every commercial domain shares (account, lead, opportunity, proposal, client service agreement, clause, competitor, worksite employee, sale), so that the sales, marketing, legal, customer success, pricing and contracts, and partner and channel ontologies import only the core and this ontology, never each other."@en ;
  dct:subject domainvoc:commercial ;
  owl:imports <https://www.insperity.com/ontology/core/> ;
  vaem:namespace "https://www.insperity.com/ontology/domain-commercial-operations/"^^xsd:anyURI ;
  vann:preferredNamespacePrefix "commercialops" ;
  dct:language "en" ;
  dct:publisher <https://www.insperity.com/resource/core/Organization/insperity> ;
  dct:conformsTo <http://purl.obolibrary.org/obo/bfo/2020/bfo.owl> ,
      <https://www.insperity.com/standard/semantic-governance/1.9/> ;
  skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en ;
  skos:changeNote "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_commercial_operations.py against Baseline Core v1.0 (core 0.1.0)."@en ,
      "0.2.0 (2026-10-20): Census moved here from pricing and contracts, because sales and pricing and contracts both use it (D2); the container holds the PEO buyer persona graph that every domain addresses. Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_commercial_operations.py against Baseline Core v1.0 (core 0.1.0)."@en ;
  owl:versionInfo "0.2.0" ;
  owl:versionIRI <https://www.insperity.com/ontology/domain-commercial-operations/0.2.0/> ;
  dct:identifier "ontology-domain-commercial-operations" ;
  dct:isPartOf <https://www.insperity.com/domain/commercial-operations/> ;
  dct:requires <https://www.insperity.com/ontology/core/0.1.0/> ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-20"^^xsd:date ;
  dct:modified "2026-10-20T04:19:14Z"^^xsd:dateTime .

commercialops:account
  a owl:Class ;
  rdfs:label "Account"@en ;
  skos:prefLabel "Account"@en ;
  skos:definition "An information asset that records the commercial relationship between the organization and a party that is, or may become, a client."@en ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:onProperty core:concerns ;
      owl:someValuesFrom core:party
  ] ,
      core:information-asset ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-commercial-operations/> ;
  core:hasPrimaryTerm commercialopsvoc:account ;
  dct:subject commercialopsvoc:account ;
  owl:versionInfo "0.2.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-20"^^xsd:date ;
  dct:modified "2026-10-20T04:19:14Z"^^xsd:dateTime .

commercialops:lead
  a owl:Class ;
  rdfs:label "Lead"@en ;
  skos:prefLabel "Lead"@en ;
  skos:definition "An information asset that records a party, or a person at a party, that has shown interest in or fits the profile for the organization's offerings and has not yet been qualified."@en ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:onProperty core:concerns ;
      owl:someValuesFrom core:party
  ] ,
      core:information-asset ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-commercial-operations/> ;
  core:hasPrimaryTerm commercialopsvoc:lead ;
  dct:subject commercialopsvoc:lead ;
  owl:versionInfo "0.2.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-20"^^xsd:date ;
  dct:modified "2026-10-20T04:19:14Z"^^xsd:dateTime .

commercialops:opportunity
  a owl:Class ;
  rdfs:label "Opportunity"@en ;
  skos:prefLabel "Opportunity"@en ;
  skos:definition "An information asset that records a potential sale of one or more offerings to a prospect or client that the organization has qualified and is pursuing."@en ;
  skos:scopeNote "The opportunity is the record; the selling steps that advance it consume and produce it (core:consumes, core:produces), so its history stays anchored on the process step."@en ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:onProperty core:concerns ;
      owl:someValuesFrom core:party
  ] ,
      [
      a owl:Restriction ;
      owl:onProperty core:concerns ;
      owl:someValuesFrom core:offering
  ] ,
      [
      a owl:Restriction ;
      owl:allValuesFrom core:party ;
      owl:onProperty commercialops:attributedTo
  ] ,
      core:information-asset ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-commercial-operations/> ;
  core:hasPrimaryTerm commercialopsvoc:opportunity ;
  dct:subject commercialopsvoc:opportunity ;
  owl:versionInfo "0.2.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-20"^^xsd:date ;
  dct:modified "2026-10-20T04:19:14Z"^^xsd:dateTime .

commercialops:proposal
  a owl:Class ;
  rdfs:label "Proposal"@en ;
  skos:prefLabel "Proposal"@en ;
  skos:definition "An information asset that sets out the offerings, terms and prices the organization offers a prospect or client in pursuit of an opportunity."@en ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:onProperty core:concerns ;
      owl:someValuesFrom commercialops:opportunity
  ] ,
      core:information-asset ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-commercial-operations/> ;
  core:hasPrimaryTerm commercialopsvoc:proposal ;
  dct:subject commercialopsvoc:proposal ;
  owl:versionInfo "0.2.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-20"^^xsd:date ;
  dct:modified "2026-10-20T04:19:14Z"^^xsd:dateTime .

commercialops:census
  a owl:Class ;
  rdfs:label "Census"@en ;
  skos:prefLabel "Census"@en ;
  skos:definition "An information asset that lists a prospective client's employees with the attributes needed to price benefits and coverage."@en ;
  skos:scopeNote "Holds personal information about the employees it lists; its handling is governed by the data protection and retention norms of the legal domain."@en ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:onProperty core:concerns ;
      owl:someValuesFrom core:person
  ] ,
      core:information-asset ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-commercial-operations/> ;
  core:hasPrimaryTerm commercialopsvoc:census ;
  dct:subject commercialopsvoc:census ;
  owl:versionInfo "0.2.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-20"^^xsd:date ;
  dct:modified "2026-10-20T04:19:14Z"^^xsd:dateTime .

commercialops:client-service-agreement
  a owl:Class ;
  rdfs:label "Client service agreement"@en ;
  skos:prefLabel "Client service agreement"@en ;
  skos:altLabel "CSA"@en ;
  skos:definition "A directive that is the contract between a professional employer organization and its client, establishing their co-employment relationship and allocating employer responsibilities between them."@en ;
  skos:scopeNote "Kept as a class (Baseline decision 8) because it carries its own axioms; core taxonomy-core-policy \"Client service agreement\" is formalized by it in the domain layer."@en ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:onProperty core:concerns ;
      owl:someValuesFrom core:party
  ] ,
      [
      a owl:Restriction ;
      owl:allValuesFrom commercialops:clause ;
      owl:onProperty core:hasComponent
  ] ,
      core:directive ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-commercial-operations/> ;
  core:hasPrimaryTerm policyvoc:agreement ;
  dct:subject policyvoc:agreement ;
  owl:versionInfo "0.2.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-20"^^xsd:date ;
  dct:modified "2026-10-20T04:19:14Z"^^xsd:dateTime .

commercialops:clause
  a owl:Class ;
  rdfs:label "Clause"@en ;
  skos:prefLabel "Clause"@en ;
  skos:definition "A directive that is a distinct provision of an agreement or instrument and states a right, obligation, condition or term."@en ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:onProperty core:componentOf ;
      owl:someValuesFrom core:directive
  ] ,
