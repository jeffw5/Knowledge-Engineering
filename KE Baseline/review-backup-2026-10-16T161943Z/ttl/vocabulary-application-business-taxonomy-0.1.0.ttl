  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:data-product
  a skos:Concept ;
  skos:prefLabel "Data product"@en ;
  skos:definition "A curated and packaged dataset designed to deliver specific insights or solve a particular business problem."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:marketplace-content-type ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T18:56:32.754Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:metrics
  a skos:Concept ;
  skos:prefLabel "Metrics"@en ;
  skos:definition "A quantifiable measure used to track and evaluate the performance of a specific process, system, or objective. Metrics provide insights into key performance indicators (KPIs) and help businesses make data-driven decisions."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:marketplace-content-type ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T18:57:37.738Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:model
  a skos:Concept ;
  skos:prefLabel "Model"@en ;
  skos:definition "A mathematical representation of a process, system, or concept. In a marketplace, models are typically algorithms or statistical formulas trained on large datasets to make predictions, classifications, or generate insights. Examples include machine learning models for fraud detection or natural language processing models for sentiment analysis."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:marketplace-content-type ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T18:56:32.754Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:report
  a skos:Concept ;
  skos:prefLabel "Report"@en ;
  skos:definition "A structured presentation of data and information, often in a visual format, designed to communicate findings, insights, and recommendations. Reports can be static or interactive and are used to share analysis, track progress, or support decision-making."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:marketplace-content-type ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T18:56:32.754Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:table
  a skos:Concept ;
  skos:prefLabel "Table"@en ;
  skos:definition "A collection of data elements or datasets that make sense to group together, typically represented as a table."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:marketplace-content-type ;
  owl:versionInfo "0.1.0" ;
