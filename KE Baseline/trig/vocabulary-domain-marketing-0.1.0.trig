    dct:created "2025-03-31T20:29:05.848Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:paid-search-advertising
    a skos:Concept ;
    skos:prefLabel "Paid search advertising"@en ;
    skos:definition "A type of SEM that involves bidding on keywords to display ads in the sponsored results section of SERPs."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
    skos:broader voc:search-engine-marketing ;
