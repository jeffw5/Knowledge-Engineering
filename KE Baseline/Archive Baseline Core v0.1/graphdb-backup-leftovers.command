curl -sf -G "$GDB/repositories/$REPO/statements" --data-urlencode 'context=<https://www.insperity.com/vocabulary/domain-procurement/>' -H 'Accept: application/trig' -o "$OUT/vocabulary-domain-procurement.trig" && echo "saved vocabulary-domain-procurement.trig" || echo "FAILED vocabulary/domain-procurement/"
curl -sf -G "$GDB/repositories/$REPO/statements" --data-urlencode 'context=<https://www.insperity.com/vocabulary/domain-sales/>' -H 'Accept: application/trig' -o "$OUT/vocabulary-domain-sales.trig" && echo "saved vocabulary-domain-sales.trig" || echo "FAILED vocabulary/domain-sales/"
curl -sf -G "$GDB/repositories/$REPO/statements" --data-urlencode 'context=<https://www.insperity.com/vocabulary/domain-security/>' -H 'Accept: application/trig' -o "$OUT/vocabulary-domain-security.trig" && echo "saved vocabulary-domain-security.trig" || echo "FAILED vocabulary/domain-security/"
curl -sf -G "$GDB/repositories/$REPO/statements" --data-urlencode 'context=<https://www.insperity.com/vocabulary/domain-supplychain/>' -H 'Accept: application/trig' -o "$OUT/vocabulary-domain-supplychain.trig" && echo "saved vocabulary-domain-supplychain.trig" || echo "FAILED vocabulary/domain-supplychain/"
ls -l "$OUT"
