partytax:party
  a skos:Concept ;
  rdfs:label "Party"@en ;
  skos:prefLabel "Party"@en ;
  skos:definition "n abstract, top-level generalized entity representing any autonomous human actor (Individual / Natural Person) or legally recognized group, collective, or organization (Institution / Legal Entity) that has agency, can incur legal rights and obligations, possess assets, or enter into transactions and relationships within an enterprise ecosystem."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core-party/> ;
  skos:topConceptOf <https://www.insperity.com/taxonomy/core-party/> ;
  skos:narrower partytax:organization , partytax:person , partytax:vendor ;
  core:hasPrimaryTerm partyvoc:party ;
  dct:subject partyvoc:party ;
  core:formalizedBy core:party ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
