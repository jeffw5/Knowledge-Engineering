voc:metric
  a skos:Concept ;
  skos:prefLabel "Metric"@en ;
  skos:definition "Represent areas of business operation that are important in assessing business performance, customer satisfaction/loyalty and operational efficiency, typically following a preferred progression or a numerical directionality which indicates how the business is improving."@en ;
  skos:notation "TL2000067" ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
