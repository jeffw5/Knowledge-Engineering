<https://www.insperity.com/ontology/domain-marketing/> {
  <https://www.insperity.com/ontology/domain-marketing/> a owl:Ontology;
    rdfs:label "Marketing domain ontology"@en;
    skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en;
    terms:description "The marketing ontology. It extends the core domain ontology and the Commercial Operations ontology with marketing campaigns and with competitive intelligence and battlecards as sourced information assets about competitors and markets."@en;
    terms:title "Marketing domain ontology"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_marketing.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.1.1 (2026-10-20): Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_marketing.py against Baseline Core v1.0 (core 0.1.0)."@en;
    terms:created "2026-10-20"^^xsd:date;
    owl:versionInfo "0.1.1";
    terms:subject domainvoc:marketing;
    owl:imports <https://www.insperity.com/ontology/core/>, <https://www.insperity.com/ontology/domain-commercial-operations/>;
    terms:isPartOf <https://www.insperity.com/domain/commercial-operations/>;
    owl:versionIRI <https://www.insperity.com/ontology/domain-marketing/0.1.1/>;
    vaem:namespace "https://www.insperity.com/ontology/domain-marketing/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft;
    vann:preferredNamespacePrefix "marketing";
    terms:publisher <https://www.insperity.com/resource/core/Organization/insperity>;
    terms:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/>, <http://purl.obolibrary.org/obo/bfo/2020/bfo.owl>;
    terms:identifier "ontology-domain-marketing";
    terms:requires <https://www.insperity.com/ontology/core/0.1.0/>, <https://www.insperity.com/ontology/domain-commercial-operations/0.2.0/> .
  
  domainmarketing:campaign a owl:Class;
    rdfs:subClassOf core:process, _:node11888, _:node11889, _:node11890;
    rdfs:label "Campaign"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-marketing/>;
    skos:prefLabel "Campaign"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A process of coordinated marketing activities, run over a period through one or more channels, toward a stated objective."@en;
    skos:scopeNote "Its audience and objective are stated in the directive (campaign plan) that governs it; its leads are produced by its steps (core:produces), which is how attribution traces a lead back to a campaign."@en;
    owl:versionInfo "0.1.1";
    terms:subject marketingvoc:campaign;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm marketingvoc:campaign .
  
  domainmarketing:intelligence a owl:Class;
    rdfs:subClassOf core:information-asset, _:node11891;
    rdfs:label "Intelligence"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-marketing/>;
    skos:prefLabel "Intelligence"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "An information asset that records information gathered and analyzed about a market, competitor or environment to inform the organization's decisions."@en;
    skos:scopeNote "Intelligence must cite its source (dcterms:source) and is governed like any other information asset: its provenance and timeliness are measured with the core trust dimensions."@en;
    owl:versionInfo "0.1.1";
    terms:subject marketingvoc:intelligence;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm marketingvoc:intelligence .
  
  _:node11888 a owl:Restriction;
    owl:onProperty core:hasStep;
    owl:someValuesFrom core:process-step .
  
  _:node11889 a owl:Restriction;
    owl:onProperty core:measuredBy;
    owl:allValuesFrom core:measure .
  
  _:node11890 a owl:Restriction;
    owl:onProperty core:governedBy;
    owl:allValuesFrom core:directive .
  
  _:node11891 a owl:Restriction;
    owl:onProperty core:concerns;
    owl:someValuesFrom core:party .
  
  domainmarketing:battlecard a owl:Class;
    rdfs:subClassOf domainmarketing:intelligence, _:node11892;
    rdfs:label "Battlecard"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-marketing/>;
    skos:prefLabel "Battlecard"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "Intelligence that equips sellers to position an offering against a specific competitor."@en;
    owl:versionInfo "0.1.1";
    terms:subject marketingvoc:battlecard;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm marketingvoc:battlecard .
  
  _:node11892 a owl:Restriction;
    owl:onProperty core:concerns;
    owl:someValuesFrom core:organization .
}
