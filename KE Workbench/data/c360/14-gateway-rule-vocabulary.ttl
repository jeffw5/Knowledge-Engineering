<https://www.insperity.com/vocabulary/gateway-rule/> a skos:ConceptScheme ;
    rdfs:label "Gateway rule vocabulary"@en ;
    skos:prefLabel "Gateway rule vocabulary"@en ;
    skos:definition "A concept scheme of the rules the requirements engineering semantic gateway applies before a demand request enters demand planning."@en ;
    skos:hasTopConcept grule:traceable, grule:reviewed, grule:evidenced, grule:measurable, grule:owned, grule:unflagged ;
    dcterms:title "Gateway rule vocabulary"@en ;
    dcterms:description "A concept scheme of the rules the requirements engineering semantic gateway applies before a demand request enters demand planning."@en ;
    dcterms:subject domaintax:EnterpriseArchitecture ;
    vaem:namespace "https://www.insperity.com/vocabulary/gateway-rule/"^^xsd:anyURI ;
    vann:preferredNamespacePrefix "grule" ;
    dcterms:language "en" ;
    dcterms:creator "Jeffrey Wallk" ;
    dcterms:publisher <https://www.insperity.com/resource/core/Organization/insperity> ;
