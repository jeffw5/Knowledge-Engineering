    dct:modified "2026-10-18T00:25:49Z"^^xsd:dateTime .

  assettax:OperationalEquipment
    a skos:Concept ;
    rdfs:label "Operational equipment"@en ;
    skos:prefLabel "Operational equipment"@en ;
    skos:altLabel "Machinery"@en ;
    skos:definition "An equipment that is used directly in producing goods or delivering physical services."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/core-asset/> ;
    skos:broader assettax:Equipment ;
    owl:versionInfo "0.1.0" ;
