  <https://www.insperity.com/vocabulary/domain-legal/> a skos:ConceptScheme;
    rdfs:label "Legal domain vocabulary"@en;
    skos:prefLabel "Legal domain vocabulary"@en;
    skos:hasTopConcept legalvoc:liability, legalvoc:accreditation, legalvoc:americans-with-disabilities-act,
      legalvoc:arbitration, legalvoc:bond, legalvoc:certification, legalvoc:certified-professional-employer-organization,
      legalvoc:confidentiality, legalvoc:consent, legalvoc:consolidated-omnibus-budget-reconciliation-act,
      legalvoc:controlling-the-assault-of-non-solicited-pornography-and-marketing-act, legalvoc:counsel,
      legalvoc:disclosure, legalvoc:dispute, legalvoc:employee-retirement-income-security-act,
      legalvoc:employer-of-record, legalvoc:fair-labor-standards-act, legalvoc:family-and-medical-leave-act,
      legalvoc:federal-insurance-contributions-act, legalvoc:federal-unemployment-tax-act,
      legalvoc:fiduciary, legalvoc:filing, legalvoc:governing-law, legalvoc:health-insurance-portability-and-accountability-act,
      legalvoc:indemnification, legalvoc:internal-revenue-code, legalvoc:law, legalvoc:lawsuit,
      legalvoc:limitation, legalvoc:matter, legalvoc:multiple-employer-plan, legalvoc:multiple-employer-welfare-arrangement,
      legalvoc:patient-protection-and-affordable-care-act, legalvoc:producer, legalvoc:provision,
      legalvoc:remedy, legalvoc:small-business-efficiency-act, legalvoc:telephone-consumer-protection-act,
      legalvoc:warranty;
    skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en;
    terms:description "A controlled vocabulary of the primitives of commercial and regulatory law as they bear on a professional employer organization's commercial operations: contract provisions, disputes and legal matters, the federal statutes that govern co-employment, benefits, employment taxes and marketing communication, and the registrations, certifications and financial assurances a professional employer organization must hold."@en;
    terms:title "Legal domain vocabulary"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_legal.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.1.1 (2026-10-20): Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_legal.py against Baseline Core v1.0 (core 0.1.0)."@en;
    terms:created "2026-10-20"^^xsd:date;
    owl:versionInfo "0.1.1";
    terms:subject domainvoc:legal;
    terms:isPartOf <https://www.insperity.com/domain/commercial-operations/>;
    owl:versionIRI <https://www.insperity.com/vocabulary/domain-legal/0.1.1/>;
    vaem:namespace "https://www.insperity.com/vocabulary/domain-legal/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft;
    vann:preferredNamespacePrefix "legalvoc";
    terms:publisher <https://www.insperity.com/resource/core/Organization/insperity>;
    terms:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/>;
    terms:identifier "vocabulary-domain-legal" .
  
