  commercialopsshp:account-shape
    a sh:NodeShape ;
    rdfs:label "Account shape"@en ;
    skos:prefLabel "Account shape"@en ;
    skos:definition "A shape that checks an account names the party it is about."@en ;
    rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-commercial-operations/> ;
    sh:targetClass commercialops:account ;
    sh:property [
        sh:path core:concerns ;
        sh:class core:party ;
        sh:message "An account must be about a party (the prospect or client)."@en ;
        sh:minCount "1"^^xsd:integer
    ] ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-20"^^xsd:date ;
    dct:modified "2026-10-20T00:16:35Z"^^xsd:dateTime .

  commercialopsshp:opportunity-shape
    a sh:NodeShape ;
    rdfs:label "Opportunity shape"@en ;
    skos:prefLabel "Opportunity shape"@en ;
    skos:definition "A shape that checks an opportunity names its party and offerings and credits a party for its source."@en ;
    rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-commercial-operations/> ;
    sh:targetClass commercialops:opportunity ;
    sh:property [
        sh:path core:concerns ;
        sh:message "An opportunity must be about the prospect or client it pursues and the offerings it would sell."@en ;
        sh:minCount "1"^^xsd:integer
    ] ,
        [
        sh:path commercialops:attributedTo ;
        sh:class core:party ;
        sh:message "attributed to must point to a party."@en
    ] ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-20"^^xsd:date ;
    dct:modified "2026-10-20T00:16:35Z"^^xsd:dateTime .

  commercialopsshp:client-service-agreement-shape
    a sh:NodeShape ;
    rdfs:label "Client service agreement shape"@en ;
    skos:prefLabel "Client service agreement shape"@en ;
    skos:definition "A shape that checks a client service agreement names its parties and is built from clauses."@en ;
    rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-commercial-operations/> ;
    sh:targetClass commercialops:client-service-agreement ;
    sh:property [
        sh:path core:concerns ;
        sh:class core:party ;
        sh:message "A client service agreement must name both parties to the co-employment relationship."@en ;
        sh:minCount "2"^^xsd:integer ;
        sh:severity sh:Warning
    ] ,
        [
        sh:path core:hasComponent ;
        sh:class commercialops:clause ;
        sh:message "A client service agreement should be built from clauses, including the allocation of employer responsibilities."@en ;
        sh:minCount "1"^^xsd:integer ;
        sh:severity sh:Warning
    ] ;
    owl:versionInfo "0.1.0" ;
