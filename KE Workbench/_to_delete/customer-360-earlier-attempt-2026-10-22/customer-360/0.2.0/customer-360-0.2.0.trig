# ---- 04-client-personas.ttl: Client personas with emotional and social jobs
<https://www.insperity.com/graph/outcome-benchmark/client-personas> {
  ob:BusinessOwner
    a owl:NamedIndividual, jtbd:client-persona ;
    rdfs:label "Business Owner / Chief Executive Officer"@en ;
    skos:prefLabel "Business Owner / Chief Executive Officer"@en ;
    skos:altLabel "Business Owner / CEO"@en ;
    skos:altLabel "Owner"@en ;
