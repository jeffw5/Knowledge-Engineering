commercialopsvoc:ideal-customer-profile
  a skos:Concept ;
  rdfs:label "ideal customer profile"@en ;
  skos:prefLabel "ideal customer profile"@en ;
  skos:altLabel "ICP"@en ;
  skos:definition "A description of the kind of organization that gains the most value from the organization's offerings and is most valuable to serve, used to target and qualify."@en ;
  skos:scopeNote "A multiword lexical unit (Baseline decision 3)."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-commercial-operations/> ;
