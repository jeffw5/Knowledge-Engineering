<https://www.insperity.com/vocabulary/core-time/> {
  <https://www.insperity.com/vocabulary/core-time/> a skos:ConceptScheme;
    rdfs:label "Core time vocabulary"@en;
    skos:prefLabel "Core time vocabulary"@en;
    skos:hasTopConcept timevoc:time;
    terms:description "The indefinite continued progress of existence and events in the past, present, and future regarded as a whole."@en;
    terms:title "Core time vocabulary"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2025-03-25T16:59:24.459Z"^^xsd:dateTime;
    skos:altLabel "Vocabulary | Core | Time"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/vocabulary/core-time/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  timevoc:time a skos:Concept;
    skos:prefLabel "Time"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-25T17:23:50.870Z"^^xsd:dateTime;
    skos:definition "The indefinite continued progress of existence and events in the past, present, and future regarded as a whole."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-time/>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/core-time/>;
    skos:narrower timevoc:absolute, timevoc:episodic, timevoc:relative .
  
  timevoc:absolute a skos:Concept;
    skos:prefLabel "Absolute"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:51:46.840Z"^^xsd:dateTime;
    skos:definition "A specific point in time, measurable and independent of other events."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-time/>;
    skos:broader timevoc:time;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower timevoc:day, timevoc:hour, timevoc:minute, timevoc:month, timevoc:quarter,
      timevoc:second, timevoc:week, timevoc:year .
  
  timevoc:episodic a skos:Concept;
    skos:prefLabel "Episodic"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:51:46.840Z"^^xsd:dateTime;
    skos:definition "Occurring in episodes or distinct periods."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-time/>;
    skos:broader timevoc:time;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower timevoc:full-period, timevoc:multiple-periods, timevoc:partial-period .
  
  timevoc:relative a skos:Concept;
    skos:prefLabel "Relative"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:51:46.840Z"^^xsd:dateTime;
    skos:inScheme <https://www.insperity.com/vocabulary/core-time/>;
    skos:broader timevoc:time;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower timevoc:current, timevoc:future, timevoc:past .
  
  timevoc:day a skos:Concept;
    skos:prefLabel "Day"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:51:46.840Z"^^xsd:dateTime;
    skos:definition "A unit of time equal to 24 hours."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-time/>;
    skos:broader timevoc:absolute;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  timevoc:hour a skos:Concept;
    skos:prefLabel "Hour"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:51:46.840Z"^^xsd:dateTime;
    skos:definition "A unit of time equal to 60 minutes."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-time/>;
    skos:broader timevoc:absolute;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  timevoc:minute a skos:Concept;
    skos:prefLabel "Minute"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:51:46.840Z"^^xsd:dateTime;
    skos:definition "A unit of time equal to 60 seconds."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-time/>;
    skos:broader timevoc:absolute;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  timevoc:month a skos:Concept;
    skos:prefLabel "Month"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:51:46.840Z"^^xsd:dateTime;
    skos:definition "A unit of time typically consisting of 28-31 days, representing approximately one cycle of the moon’s phases."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-time/>;
    skos:broader timevoc:absolute;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  timevoc:quarter a skos:Concept;
    skos:prefLabel "Quarter"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:51:46.840Z"^^xsd:dateTime;
    skos:definition "A unit of time equal to three months."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-time/>;
    skos:broader timevoc:absolute;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  timevoc:second a skos:Concept;
    skos:prefLabel "Second"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:51:46.840Z"^^xsd:dateTime;
    skos:definition "A unit of time, a fraction of a minute."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-time/>;
    skos:broader timevoc:absolute;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower timevoc:subsecond .
  
  timevoc:week a skos:Concept;
    skos:prefLabel "Week"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:51:46.840Z"^^xsd:dateTime;
    skos:definition "A unit of time equal to seven days."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-time/>;
    skos:broader timevoc:absolute;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  timevoc:year a skos:Concept;
    skos:prefLabel "Year"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:51:46.840Z"^^xsd:dateTime;
    skos:definition "A unit of time equal to 12 months or approximately 365 days, representing the time it takes for the Earth to orbit the sun."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-time/>;
    skos:broader timevoc:absolute;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  timevoc:subsecond a skos:Concept;
    skos:prefLabel "Subsecond"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:51:46.840Z"^^xsd:dateTime;
    skos:inScheme <https://www.insperity.com/vocabulary/core-time/>;
    skos:broader timevoc:second;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  timevoc:full-period a skos:Concept;
    skos:prefLabel "Full period"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:51:46.840Z"^^xsd:dateTime;
    skos:definition "The complete duration of a specific time frame."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-time/>;
