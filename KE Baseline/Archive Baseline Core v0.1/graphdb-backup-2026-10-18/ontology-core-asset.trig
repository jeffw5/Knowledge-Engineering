    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T01:55:00Z"^^xsd:dateTime;
    terms:created "2024-09-24T20:47:11.594Z"^^xsd:dateTime;
    skos:definition "A set of detailed instructions outlining the steps required to perform a specific operational task consistently."@en;
    skos:altLabel "Operational SOP"@en;
    owl:versionInfo "0.1.0";
    dc:subject assetvoc:operational-standard-operating-procedure;
    core:hasLifecycleStatus core:Draft .
  
  ont:PreventativeControls a owl:Class;
    rdfs:subClassOf ont:Artifact;
    rdfs:label "Preventative controls"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core-asset/>;
    skos:prefLabel "Preventative controls"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T01:55:00Z"^^xsd:dateTime;
    terms:created "2024-09-24T20:47:11.594Z"^^xsd:dateTime;
    skos:definition "A security mechanism designed to prevent security incidents from occurring in the first place."@en;
    owl:versionInfo "0.1.0";
