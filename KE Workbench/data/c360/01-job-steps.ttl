# ==========================================================================
#  Job map stages: the universal eight-stage job map
#  Target named graph: <https://www.insperity.com/graph/outcome-benchmark/job-steps>
#  8 individuals of jtbd:job-map-stage.
#  Source: PEO Outcome Benchmark (Outcome-Driven Innovation study blueprint)
#  Status: Draft 0.1.0, generated 2026-10-22, pending business and compliance SME review
# ==========================================================================

@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix jtbd:    <https://www.insperity.com/ontology/jobs-to-be-done/> .
@prefix ob:      <https://www.insperity.com/resource/outcome-benchmark/> .
@prefix theme:   <https://www.insperity.com/taxonomy/benchmark-theme/> .
@prefix metric:  <https://www.insperity.com/vocabulary/outcome-metric-type/> .
@prefix hr:      <http://example.org/hrservices/ddd#> .


ob:DefineStep a owl:NamedIndividual, jtbd:job-map-stage ;
    rdfs:label "Define"@en ;
    skos:prefLabel "Define"@en ;
    skos:definition "A job map stage in which the job executor works to determine objectives and plan the approach."@en ;
    jtbd:hasIdentifier "DEF" ;
    jtbd:hasStepOrder "1"^^xsd:positiveInteger ;
    jtbd:precedesJobStep ob:LocateStep ;
    dcterms:created "2026-10-22"^^xsd:date ;
    skos:editorialNote "Draft: pending business and compliance review before the survey is fielded."@en .

ob:LocateStep a owl:NamedIndividual, jtbd:job-map-stage ;
    rdfs:label "Locate"@en ;
    skos:prefLabel "Locate"@en ;
    skos:definition "A job map stage in which the job executor works to gather the inputs and information needed."@en ;
    jtbd:hasIdentifier "LOC" ;
    jtbd:hasStepOrder "2"^^xsd:positiveInteger ;
    jtbd:precedesJobStep ob:PrepareStep ;
    dcterms:created "2026-10-22"^^xsd:date ;
    skos:editorialNote "Draft: pending business and compliance review before the survey is fielded."@en .

ob:PrepareStep a owl:NamedIndividual, jtbd:job-map-stage ;
    rdfs:label "Prepare"@en ;
    skos:prefLabel "Prepare"@en ;
    skos:definition "A job map stage in which the job executor works to set up the environment and inputs."@en ;
    jtbd:hasIdentifier "PRE" ;
    jtbd:hasStepOrder "3"^^xsd:positiveInteger ;
    jtbd:precedesJobStep ob:ConfirmStep ;
    dcterms:created "2026-10-22"^^xsd:date ;
    skos:editorialNote "Draft: pending business and compliance review before the survey is fielded."@en .

ob:ConfirmStep a owl:NamedIndividual, jtbd:job-map-stage ;
    rdfs:label "Confirm"@en ;
    skos:prefLabel "Confirm"@en ;
    skos:definition "A job map stage in which the job executor works to verify readiness before acting."@en ;
    jtbd:hasIdentifier "CON" ;
    jtbd:hasStepOrder "4"^^xsd:positiveInteger ;
    jtbd:precedesJobStep ob:ExecuteStep ;
    dcterms:created "2026-10-22"^^xsd:date ;
    skos:editorialNote "Draft: pending business and compliance review before the survey is fielded."@en .

ob:ExecuteStep a owl:NamedIndividual, jtbd:job-map-stage ;
    rdfs:label "Execute"@en ;
    skos:prefLabel "Execute"@en ;
    skos:definition "A job map stage in which the job executor works to carry out the core task."@en ;
    jtbd:hasIdentifier "EXE" ;
    jtbd:hasStepOrder "5"^^xsd:positiveInteger ;
    jtbd:precedesJobStep ob:MonitorStep ;
    dcterms:created "2026-10-22"^^xsd:date ;
    skos:editorialNote "Draft: pending business and compliance review before the survey is fielded."@en .

ob:MonitorStep a owl:NamedIndividual, jtbd:job-map-stage ;
    rdfs:label "Monitor"@en ;
    skos:prefLabel "Monitor"@en ;
    skos:definition "A job map stage in which the job executor works to check that the task is going as intended."@en ;
    jtbd:hasIdentifier "MON" ;
    jtbd:hasStepOrder "6"^^xsd:positiveInteger ;
    jtbd:precedesJobStep ob:ModifyStep ;
    dcterms:created "2026-10-22"^^xsd:date ;
    skos:editorialNote "Draft: pending business and compliance review before the survey is fielded."@en .

ob:ModifyStep a owl:NamedIndividual, jtbd:job-map-stage ;
    rdfs:label "Modify"@en ;
    skos:prefLabel "Modify"@en ;
    skos:definition "A job map stage in which the job executor works to make adjustments and corrections."@en ;
    jtbd:hasIdentifier "MOD" ;
    jtbd:hasStepOrder "7"^^xsd:positiveInteger ;
    jtbd:precedesJobStep ob:ConcludeStep ;
    dcterms:created "2026-10-22"^^xsd:date ;
    skos:editorialNote "Draft: pending business and compliance review before the survey is fielded."@en .

ob:ConcludeStep a owl:NamedIndividual, jtbd:job-map-stage ;
    rdfs:label "Conclude"@en ;
    skos:prefLabel "Conclude"@en ;
    skos:definition "A job map stage in which the job executor works to finish, close out and prepare for next time."@en ;
    jtbd:hasIdentifier "CONC" ;
    jtbd:hasStepOrder "8"^^xsd:positiveInteger ;
    dcterms:created "2026-10-22"^^xsd:date ;
    skos:editorialNote "Draft: pending business and compliance review before the survey is fielded."@en .
