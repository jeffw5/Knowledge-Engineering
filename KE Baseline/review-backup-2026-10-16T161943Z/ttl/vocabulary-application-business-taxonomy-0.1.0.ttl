voc:earnings-before-interest-taxes-depreciation-and-amortization
  a skos:Concept ;
  skos:prefLabel "Earnings before interest, taxes, depreciation and amortization"@en ;
  skos:altLabel "EBITDA"@en ,
      "Earnings Before Interest, Taxes, Depreciation & Amortization"@en ;
  skos:definition "An acronym for Earnings Before Interest, Taxes, Depreciation and Amortization, a measure of the organization's operating profitability."@en ;
  skos:notation "TL4000131" ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:profitability ;
