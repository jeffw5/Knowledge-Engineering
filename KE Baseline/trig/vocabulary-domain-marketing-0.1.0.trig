    a skos:Concept ;
    skos:prefLabel "Social media marketing"@en ;
    skos:altLabel "SMM"@en ;
    skos:definition "Using social media platforms to connect with target audiences, build relationships, and drive traffic and conversions."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
