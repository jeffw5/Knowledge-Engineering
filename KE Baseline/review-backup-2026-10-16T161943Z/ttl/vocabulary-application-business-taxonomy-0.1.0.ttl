voc:controlled-unclassified-information
  a skos:Concept ;
  skos:prefLabel "Controlled unclassified information"@en ;
  skos:altLabel "CUI"@en , "Controlled Unclassified Information"@en ;
  skos:definition "An acronym for Controlled Unclassified Information is a category of federal ”unclassified information” the USG creates or processes, or that an entity creates or possesses for, or on behalf of, the US Government that requires safeguarding and dissemination protections. 1 Verizon (VZ) CUI information examples include: Export Control, Systems Vulnerability, Technical Configurations, Controlled Technical Information"@en ;
  skos:example "Controlled Technical Information"@en ,
      "Export Control"@en ,
      "Systems Vulnerability"@en ,
      "Technical Configurations"@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:regulatory-classification ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T19:15:17.067Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

