voc:radiator
  a skos:Concept ;
  skos:prefLabel "Radiator"@en ;
  skos:definition "A heating device typically made of metal and designed with a large surface area to efficiently transfer heat from a hot fluid (like steam or hot water) to the surrounding air, thus warming a room."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-facilities/> ;
  skos:broader voc:furniture ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
