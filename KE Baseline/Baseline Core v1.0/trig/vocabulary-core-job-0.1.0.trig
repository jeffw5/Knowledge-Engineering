  jobvoc:emotional
    a skos:Concept ;
    rdfs:label "emotional"@en ;
    skos:prefLabel "emotional"@en ;
    skos:definition "A kind of job concerned with how a party wants to feel, or to be perceived, while getting a task done."@en ;
    skos:scopeNote "A job that involves money is associated with finance; that is a subject association, not a job kind."@en ;
