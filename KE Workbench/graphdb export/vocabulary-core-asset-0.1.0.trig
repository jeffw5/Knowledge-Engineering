  assetvoc:solution-architecture a skos:Concept;
    skos:prefLabel "Solution architecture"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:52:33.260Z"^^xsd:dateTime;
    skos:definition "The high-level design of a system, encompassing its components, their relationships, and the principles guiding its design."@en;
