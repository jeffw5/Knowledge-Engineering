voc:supporting-job
  a skos:Concept ;
  skos:prefLabel "Supporting job"@en ;
  skos:definition "A job that is necessary to enable or facilitate the completion of a primary job."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-requirements/> ;
