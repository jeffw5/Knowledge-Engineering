  <https://www.insperity.com/ontology/domain-customer-care/>
    a owl:Ontology ;
    rdfs:label "Domain Customer Care Ontology"@en ;
    dct:title "Domain Customer Care Ontology"@en ;
    dct:description "The customer care ontology. It extends the core domain ontology and the Commercial Operations ontology with the client success process and its steps, client health scores that measure accounts, and playbooks that govern client success steps."@en ;
