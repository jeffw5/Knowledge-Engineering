<https://www.insperity.com/vocabulary/gateway-status/> a skos:ConceptScheme ;
    rdfs:label "Gateway status vocabulary"@en ;
    skos:prefLabel "Gateway status vocabulary"@en ;
    skos:definition "A concept scheme of the standing a demand request can have at the requirements engineering semantic gateway."@en ;
    skos:hasTopConcept gstat:draft, gstat:held, gstat:admitted, gstat:delivered ;
    dcterms:title "Gateway status vocabulary"@en ;
    dcterms:description "A concept scheme of the standing a demand request can have at the requirements engineering semantic gateway."@en ;
