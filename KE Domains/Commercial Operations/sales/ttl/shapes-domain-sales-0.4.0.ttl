  skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en ;
  skos:changeNote "0.3.0 (2026-10-20): Sales processes (D24): a sales service is enabled by one or more sales processes (core:supports), each built from selling steps (core:hasStep). New Sales process branch (census collection, employment cost analysis, benefits plan analysis), the census request, census validation and current benefits collection steps, and the census template, census validation report and current benefits report records. A selling step is a step of any process, and a sales service must be enabled by a process. The bridge from selling steps to the buyer persona's job steps (core:addresses) moves to the value map, a separate assembly. Built by build_domains.py from spec_sales.py against Baseline Core v1.0 (core 0.1.0)."@en ,
      "0.4.0 (2026-10-21): Restructured to the operational areas and the naming standard (D26, D27): titled 'Domain Sales Vocabulary', '… Taxonomy', '… Ontology' and '… Shapes'; imports the Commercial Operations ontology at its new IRI. Built by build_domains.py from spec_sales.py against Baseline Core v1.0 (core 0.1.0)."@en ,
      "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_sales.py against Baseline Core v1.0 (core 0.1.0)."@en ,
      "0.2.0 (2026-10-20): Sales services: the Sales service class and taxonomy branch, and the step and record kinds the first service graphs are assembled from (total cost of employment analysis, benefits comparison). Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_sales.py against Baseline Core v1.0 (core 0.1.0)."@en ;
  owl:versionInfo "0.4.0" ;
  owl:versionIRI <https://www.insperity.com/shapes/domain-sales/0.4.0/> ;
  dct:identifier "shapes-domain-sales" ;
  dct:isPartOf <https://www.insperity.com/shapes/commercial-operations/> ;
  dct:requires <https://www.insperity.com/ontology/domain-sales/0.4.0/> ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-22"^^xsd:date ;
  dct:modified "2026-10-22T02:04:02Z"^^xsd:dateTime .

salesshp:selling-step-shape
  a sh:NodeShape ;
  rdfs:label "Selling step shape"@en ;
  skos:prefLabel "Selling step shape"@en ;
  skos:definition "A shape that checks a selling step belongs to a process and that what it addresses is a job step."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-sales/> ;
  sh:targetClass sales:selling-step ;
  sh:property [
      sh:path core:isStepOf ;
      sh:class core:process ;
      sh:message "A selling step must be a step of a process."@en ;
      sh:minCount "1"^^xsd:integer
  ] ,
      [
      sh:path core:addresses ;
      sh:class core:job-step ;
      sh:message "addresses must point to a job step of the buyer persona."@en
  ] ,
      [
      sh:path dct:type ;
      sh:message "A selling step should be classified by its selling stage and its kind of selling activity."@en ;
      sh:minCount "1"^^xsd:integer ;
      sh:severity sh:Warning
  ] ;
  owl:versionInfo "0.4.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-22"^^xsd:date ;
  dct:modified "2026-10-22T02:04:02Z"^^xsd:dateTime .

salesshp:sales-service-shape
  a sh:NodeShape ;
  rdfs:label "Sales service shape"@en ;
  skos:prefLabel "Sales service shape"@en ;
  skos:definition "A shape that checks a sales service is enabled by a process, delivered by a selling step and classified in the Sales taxonomy."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-sales/> ;
  sh:targetClass sales:sales-service ;
  sh:property [
      sh:path [
          sh:inversePath core:supports
      ] ;
      sh:class core:process ;
      sh:message "A sales service must be enabled by at least one process."@en ;
      sh:minCount "1"^^xsd:integer
  ] ,
      [
      sh:path [
          sh:inversePath core:deliveryOf
      ] ;
      sh:class sales:selling-step ;
      sh:message "A sales service must have at least one selling step that is its delivery."@en ;
      sh:minCount "1"^^xsd:integer
  ] ,
      [
      sh:path dct:type ;
      sh:message "A sales service should be classified by a Sales service concept."@en ;
      sh:minCount "1"^^xsd:integer ;
      sh:severity sh:Warning
  ] ;
  owl:versionInfo "0.4.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-22"^^xsd:date ;
  dct:modified "2026-10-22T02:04:02Z"^^xsd:dateTime .

salesshp:quota-shape
  a sh:NodeShape ;
  rdfs:label "Quota shape"@en ;
  skos:prefLabel "Quota shape"@en ;
  skos:definition "A shape that checks a quota names what it measures."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-sales/> ;
  sh:targetClass sales:quota ;
  sh:property [
      sh:path core:measures ;
      sh:message "A quota must name the selling process, party or territory it measures."@en ;
      sh:minCount "1"^^xsd:integer
  ] ;
  owl:versionInfo "0.4.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-22"^^xsd:date ;
