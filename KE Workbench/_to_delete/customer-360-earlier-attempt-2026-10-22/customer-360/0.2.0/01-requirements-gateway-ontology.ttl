  a owl:ObjectProperty ;
  rdfs:label "has recommended action"@en ;
  skos:prefLabel "has recommended action"@en ;
  skos:definition "A relation between an outcome requirement and the kind of work the measured gap calls for: fix, innovate, protect or simplify."@en ;
  rdfs:domain rg:outcome-requirement ;
  rdfs:range skos:Concept ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/requirements-gateway/> ;
