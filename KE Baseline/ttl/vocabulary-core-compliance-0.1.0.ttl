voc:data-security
  a skos:Concept ;
  skos:prefLabel "Data security"@en ;
  skos:definition "Within the DAMA-DMBOK2 framework, data security focuses on protecting data from unauthorized access, use, disclosure, disruption, modification, or destruction. It encompasses technical, organizational, and legal controls to ensure confidentiality, integrity, and availability of data."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/> ;
  skos:broader voc:data-governance ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-03T21:09:26.455Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:data-storage-and-operations
  a skos:Concept ;
  skos:prefLabel "Data storage & operations"@en ;
  skos:definition "The processes and technologies involved in storing, managing, and securing data throughout its lifecycle."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/> ;
  skos:broader voc:data-governance ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
