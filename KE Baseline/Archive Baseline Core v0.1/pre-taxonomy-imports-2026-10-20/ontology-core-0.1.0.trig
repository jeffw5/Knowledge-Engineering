    a owl:ObjectProperty ;
    rdfs:label "fulfills role"@en ;
    skos:prefLabel "fulfills role"@en ;
    skos:definition "A relation between a step and a role that is realized in it, such as the approver role in an approval step."@en ;
    rdfs:subPropertyOf obo:BFO_0000055 ;
