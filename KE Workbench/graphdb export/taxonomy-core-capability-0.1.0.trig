<https://www.insperity.com/taxonomy/core-capability/> {
  <https://www.insperity.com/taxonomy/core-capability/> a skos:ConceptScheme;
    rdfs:label "Core capability taxonomy"@en;
    skos:prefLabel "Core capability taxonomy"@en;
    skos:hasTopConcept <https://www.insperity.com/taxonomy/core-capability/customer-facing-capability>,
      <https://www.insperity.com/taxonomy/core-capability/information-and-knowledge-capability>,
      <https://www.insperity.com/taxonomy/core-capability/strategic-capability>, <https://www.insperity.com/taxonomy/core-capability/supporting-capability>;
    terms:description "Classification of business capabilities, the abilities an organization has or needs to achieve outcomes, independent of how they are organized or implemented."@en;
    terms:title "Core capability taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2026-10-14"^^xsd:dateTime;
    skos:altLabel "Capability taxonomy"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/taxonomy/core-capability/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-capability/customer-facing-capability> a
      skos:Concept;
    skos:prefLabel "Customer-facing capability"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A capability for creating and delivering value to clients and their workers."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-capability/>;
    skos:altLabel "Core capability"@en, "Value delivery capability"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-capability/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-capability/client-relationship-management>,
      <https://www.insperity.com/taxonomy/core-capability/client-support-management>, <https://www.insperity.com/taxonomy/core-capability/marketing-management>,
      <https://www.insperity.com/taxonomy/core-capability/offering-management>, <https://www.insperity.com/taxonomy/core-capability/sales-management>,
      <https://www.insperity.com/taxonomy/core-capability/service-delivery-management> .
  
  <https://www.insperity.com/taxonomy/core-capability/information-and-knowledge-capability>
    a skos:Concept;
    skos:prefLabel "Information and knowledge capability"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A capability for managing and using data, knowledge, and artificial intelligence."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-capability/>;
    skos:altLabel "Data and artificial intelligence capability"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-capability/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-capability/analytics-management>,
      <https://www.insperity.com/taxonomy/core-capability/artificial-intelligence-management>,
      <https://www.insperity.com/taxonomy/core-capability/content-management>, <https://www.insperity.com/taxonomy/core-capability/data-management>,
      <https://www.insperity.com/taxonomy/core-capability/knowledge-management>, <https://www.insperity.com/taxonomy/core-capability/semantic-management> .
  
  <https://www.insperity.com/taxonomy/core-capability/strategic-capability> a skos:Concept;
    skos:prefLabel "Strategic capability"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A capability for setting direction and shaping the organization."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-capability/>;
    skos:altLabel "Direction-setting capability"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-capability/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-capability/enterprise-architecture-management>,
      <https://www.insperity.com/taxonomy/core-capability/innovation-management>, <https://www.insperity.com/taxonomy/core-capability/performance-management>,
      <https://www.insperity.com/taxonomy/core-capability/portfolio-management>, <https://www.insperity.com/taxonomy/core-capability/strategy-management> .
  
  <https://www.insperity.com/taxonomy/core-capability/supporting-capability> a skos:Concept;
    skos:prefLabel "Supporting capability"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A capability that enables strategic and customer-facing capabilities."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-capability/>;
    skos:altLabel "Enabling capability"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-capability/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-capability/facilities-management>,
      <https://www.insperity.com/taxonomy/core-capability/financial-management>, <https://www.insperity.com/taxonomy/core-capability/legal-management>,
      <https://www.insperity.com/taxonomy/core-capability/procurement-management>, <https://www.insperity.com/taxonomy/core-capability/risk-and-compliance-management>,
      <https://www.insperity.com/taxonomy/core-capability/technology-management>, <https://www.insperity.com/taxonomy/core-capability/workforce-management> .
  
  <https://www.insperity.com/taxonomy/core-capability/analytics-management> a skos:Concept;
    skos:prefLabel "Analytics management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
