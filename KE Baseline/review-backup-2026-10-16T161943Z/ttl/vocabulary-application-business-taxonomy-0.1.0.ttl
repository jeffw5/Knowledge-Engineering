voc:in-house
  a skos:Concept ;
  skos:prefLabel "In-House"@en ;
  skos:definition "A sales channel where employees of the company directly sell products or services to customers, typically through phone, email, or online chat."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:sales-channel ;
  owl:versionInfo "0.1.0" ;
