voc:product-configuration
  a skos:Concept ;
  skos:prefLabel "Product configuration"@en ;
  skos:definition "The process or result of customizing a product by selecting and arranging various options, components, or features to meet specific customer requirements or create distinct product variants."@en ;
  skos:notation "TL2000027" ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
