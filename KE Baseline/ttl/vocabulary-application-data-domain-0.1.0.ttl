voc:finance
  a skos:Concept ;
  skos:prefLabel "Finance"@en ;
  skos:definition "Data assets describing all financial aspects of the enterprise, such as financial accounts, general ledgers, and accounting entries."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:enterprise-corporate ;
  owl:versionInfo "0.1.0" ;
