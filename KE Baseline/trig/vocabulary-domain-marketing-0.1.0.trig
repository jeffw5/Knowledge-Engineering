    dct:created "2025-03-31T20:29:05.848Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:search-engine-marketing
    a skos:Concept ;
    skos:prefLabel "Search engine marketing"@en ;
    skos:altLabel "SEM"@en ;
    skos:definition "Promoting a website by increasing its visibility in search engine results pages (SERPs)."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
    skos:broader voc:performance-marketing ;
    skos:narrower voc:paid-search-advertising , voc:search-engine-optimization ;
