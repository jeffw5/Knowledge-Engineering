  personavoc:analytic-engineering-persona a skos:Concept;
    skos:prefLabel "Analytic engineering persona"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:46:17.202Z"^^xsd:dateTime;
    skos:definition "Represents individuals focused on data analysis, building data pipelines, and generating insights."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-persona/>;
    skos:broader personavoc:persona-type;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  personavoc:data-engineering-persona a skos:Concept;
    skos:prefLabel "Data engineering persona"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:46:17.202Z"^^xsd:dateTime;
    skos:definition "Represents individuals responsible for building and maintaining data infrastructure, ensuring data quality, and enabling data access."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-persona/>;
    skos:broader personavoc:persona-type;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  personavoc:knowledge-engineering-persona a skos:Concept;
    skos:prefLabel "Knowledge engineering persona"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:46:17.202Z"^^xsd:dateTime;
    skos:definition "Represents individuals focused on capturing, organizing, and applying knowledge within systems or organizations."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-persona/>;
    skos:broader personavoc:persona-type;
    skos:altLabel "KE Persona"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  personavoc:platform-engineering-persona a skos:Concept;
    skos:prefLabel "Platform engineering persona"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:46:17.202Z"^^xsd:dateTime;
    skos:definition "Represents individuals responsible for building and maintaining the underlying infrastructure and tools that support software development and deployment."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-persona/>;
    skos:broader personavoc:persona-type;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  personavoc:quality-engineering-persona a skos:Concept;
    skos:prefLabel "Quality engineering persona"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:46:17.202Z"^^xsd:dateTime;
    skos:definition "Represents individuals focused on ensuring the quality of software and systems through testing, automation, and process improvement."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-persona/>;
    skos:broader personavoc:persona-type;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  personavoc:systems-engineering-persona a skos:Concept;
    skos:prefLabel "Systems engineering persona"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:46:17.202Z"^^xsd:dateTime;
    skos:definition "Represents individuals responsible for designing, building, and managing complex systems, considering all aspects from hardware to software and human interaction."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-persona/>;
    skos:broader personavoc:persona-type;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  personavoc:user-experience-engineering-persona a skos:Concept;
    skos:prefLabel "User experience engineering persona"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:46:17.202Z"^^xsd:dateTime;
    skos:definition "Represents individuals focused on the design and development of user interfaces, ensuring usability, accessibility, and a positive user experience."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-persona/>;
