    terms:identifier "vocabulary-domain-marketing" .
  
  marketingvoc:search-engine-optimization a skos:Concept;
    rdfs:label "search engine optimization"@en;
    skos:prefLabel "search engine optimization"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "The practice of improving content so that search engines show it to parties searching for related topics."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/>;
    skos:altLabel "SEO"@en;
    skos:scopeNote "A multiword lexical unit (Baseline decision 3)."@en;
    owl:versionInfo "0.2.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-marketing/> .
  
  marketingvoc:alternative a skos:Concept;
    rdfs:label "alternative"@en;
    skos:prefLabel "alternative"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A different way a buyer could get a job done instead of acquiring the organization's offering, including doing nothing."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/>;
    owl:versionInfo "0.2.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-marketing/> .
  
  marketingvoc:audience a skos:Concept;
    rdfs:label "audience"@en;
    skos:prefLabel "audience"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A group of parties that a message or campaign is meant to reach."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/>;
    owl:versionInfo "0.2.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-marketing/> .
  
  marketingvoc:awareness a skos:Concept;
    rdfs:label "awareness"@en;
    skos:prefLabel "awareness"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "The degree to which the parties in a market know of a brand or offering."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/>;
    owl:versionInfo "0.2.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-marketing/> .
  
  marketingvoc:battlecard a skos:Concept;
    rdfs:label "battlecard"@en;
    skos:prefLabel "battlecard"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A concise reference that equips sellers to position an offering against a specific competitor."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/>;
    owl:versionInfo "0.2.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-marketing/> .
  
  marketingvoc:campaign a skos:Concept;
    rdfs:label "campaign"@en;
    skos:prefLabel "campaign"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A coordinated set of marketing activities, run over a period through one or more channels, toward a stated objective."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/>;
    owl:versionInfo "0.2.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-marketing/> .
  
  marketingvoc:case-study a skos:Concept;
    rdfs:label "case study"@en;
    skos:prefLabel "case study"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A document that tells how a client used an offering to get a job done and what it gained."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/>;
    skos:scopeNote "A multiword lexical unit (Baseline decision 3)."@en;
    owl:versionInfo "0.2.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-marketing/> .
  
  marketingvoc:demand a skos:Concept;
    rdfs:label "demand"@en;
    skos:prefLabel "demand"@en;
    skos:editorialNote "Candidate for promotion to the core: General primitive missing from the core (core-services \"demand management\" is polymorphic)."@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A desire of buyers for an offering, backed by the ability and willingness to acquire it."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/>;
    owl:versionInfo "0.2.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-marketing/> .
  
  marketingvoc:differentiator a skos:Concept;
    rdfs:label "differentiator"@en;
    skos:prefLabel "differentiator"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A characteristic of an offering that sets it apart, favorably for its buyers, from competing alternatives."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/>;
    owl:versionInfo "0.2.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-marketing/> .
  
