domainsalestax:onboard
  a skos:Concept ;
  rdfs:label "Onboard"@en ;
  skos:prefLabel "Onboard"@en ;
  skos:altLabel "Onboarding stage"@en ;
  skos:definition "A selling stage in which a won client is handed off to be brought into active service."@en ;
  skos:scopeNote "The last selling stage ends at the handoff; bringing the client into service is customer success onboarding."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/> ;
  skos:broader domainsalestax:selling-stage ;
