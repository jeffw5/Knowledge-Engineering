legalshp:norm-shape
  a sh:NodeShape ;
  rdfs:label "Norm shape"@en ;
  skos:prefLabel "Norm shape"@en ;
  skos:definition "A shape that checks a norm binds a role and is traced to the provision, clause or policy that states it."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-legal/> ;
  sh:targetClass legal:norm ;
  sh:property [
      sh:path legal:binds ;
      sh:class core:role ;
      sh:message "A norm must name the role it binds."@en ;
      sh:minCount "1"^^xsd:integer
  ] ,
      [
      sh:path core:componentOf ;
      sh:class core:directive ;
      sh:message "A norm should be traced to the provision, clause or policy that states it."@en ;
      sh:minCount "1"^^xsd:integer ;
      sh:severity sh:Warning
  ] ;
  owl:versionInfo "0.2.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-22"^^xsd:date ;
  dct:modified "2026-10-22T02:04:02Z"^^xsd:dateTime .

legalshp:statute-shape
  a sh:NodeShape ;
  rdfs:label "Statute shape"@en ;
  skos:prefLabel "Statute shape"@en ;
  skos:definition "A shape that checks a statute names its jurisdiction."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-legal/> ;
  sh:targetClass legal:statute ;
  sh:property [
      sh:path legal:hasJurisdiction ;
      sh:class core:location ;
      sh:message "A statute must name the jurisdiction in which it applies."@en ;
      sh:minCount "1"^^xsd:integer
  ] ;
  owl:versionInfo "0.2.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-22"^^xsd:date ;
  dct:modified "2026-10-22T02:04:02Z"^^xsd:dateTime .

