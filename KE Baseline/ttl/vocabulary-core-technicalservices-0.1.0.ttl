  dct:created "2025-04-04T17:48:52.903Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:training
  a skos:Concept ;
  skos:prefLabel "Training"@en ;
  skos:definition "Equipping individuals with the knowledge, skills, and awareness necessary to identify, assess, and respond to potential threats, ultimately enhancing an organization's ability to mitigate risks."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-technicalservices/> ;
