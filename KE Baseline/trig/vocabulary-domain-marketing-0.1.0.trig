    a skos:Concept ;
    skos:prefLabel "Pricing tactics"@en ;
    skos:definition "Short-term methods for adjusting prices to achieve specific goals."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
