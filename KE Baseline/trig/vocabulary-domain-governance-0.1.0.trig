    a skos:Concept ;
    skos:prefLabel "Data enrichment"@en ;
    skos:definition "The process of enhancing existing data by adding relevant information from external sources, thereby improving its quality, completeness, and usefulness for analysis and decision-making."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:onboarding-management ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-profiling
    a skos:Concept ;
    skos:prefLabel "Data profiling"@en ;
    skos:definition "The process of analyzing data to understand its structure, content, and quality, often used to identify data quality issues and inconsistencies."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:onboarding-management ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:search-and-discovery
    a skos:Concept ;
    skos:prefLabel "Search & discovery"@en ;
    skos:definition "Tools and capabilities that enable users to easily find, access, and understand relevant data assets within an organization."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:preventative-controls ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:governance-development-activity
    a skos:Concept ;
    skos:prefLabel "Governance development activity"@en ;
    skos:definition "Activities focused on creating, defining, and refining data governance frameworks, policies, standards, and procedures."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:data-governance-activities ;
    skos:narrower voc:define-data-governance ,
        voc:develop-goals-principles-and-policies ,
        voc:develop-organizational-touchpoints ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:define-data-governance
    a skos:Concept ;
    skos:prefLabel "Define data governance"@en ;
    skos:definition "Establishing a common understanding of data governance within an organization, including its goals, principles, scope, and framework."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:governance-development-activity ;
    skos:narrower voc:charter , voc:mission-and-vision , voc:value-drivers ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:charter
    a skos:Concept ;
    skos:prefLabel "Charter"@en ;
    skos:definition "A legal document filed with the state that establishes a corporation, outlining its purpose, structure, and key operating principles, granting it legal recognition."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:define-data-governance ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:mission-and-vision
    a skos:Concept ;
    skos:prefLabel "Mission & vision"@en ;
    skos:definition "An organization’s overall purpose and long-term aspirations, guiding its actions and decision-making, including compliance efforts."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:define-data-governance ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:value-drivers
    a skos:Concept ;
    skos:prefLabel "Value drivers"@en ;
    skos:definition "A specific, measurable benefit, outcome, or strategic advantage that an organization achieves by successfully implementing and maturing its Data Governance program."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:define-data-governance ;
    skos:narrower voc:business-value ,
        voc:data-quality ,
        voc:data-risk-management ,
        voc:operational-efficiency ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-10-31T15:27:37.400Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:business-value
    a skos:Concept ;
    skos:prefLabel "Business value"@en ;
    skos:definition "represents the worth an organization creates through its operations, offerings, and interactions, encompassing financial performance, market position, and stakeholder satisfaction."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:value-drivers ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-quality
    a skos:Concept ;
    skos:prefLabel "Data quality"@en ;
    skos:definition "The state of data being fit for its intended use, characterized by accuracy, completeness, consistency, timeliness, and validity."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:value-drivers ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-risk-management
    a skos:Concept ;
    skos:prefLabel "Data risk management"@en ;
    skos:definition "The process of identifying, assessing, and mitigating risks associated with data, including unauthorized access, data breaches, and data loss."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:value-drivers ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:operational-efficiency
    a skos:Concept ;
    skos:prefLabel "Operational efficiency"@en ;
    skos:definition "The ability to perform data governance activities effectively and efficiently, minimizing manual effort and maximizing resource utilization."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:value-drivers ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:develop-goals-principles-and-policies
    a skos:Concept ;
    skos:prefLabel "Develop goals, principles & policies"@en ;
    skos:definition "Defining the desired outcomes, guiding values, and specific rules that will govern data management practices within an organization."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:governance-development-activity ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:develop-organizational-touchpoints
    a skos:Concept ;
    skos:prefLabel "Develop organizational touchpoints"@en ;
    skos:definition "Ensuring that data governance initiatives are integrated into existing organizational structures, processes, and culture."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:governance-development-activity ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:governance-operational-activity
    a skos:Concept ;
    skos:prefLabel "Governance operational activity"@en ;
    skos:definition "Day-to-day activities that support the implementation and execution of data governance, such as data quality monitoring, issue resolution, and access management."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:data-governance-activities ;
    skos:narrower voc:change-management ,
        voc:data-management-project-support-and-prioritization ,
        voc:develop-data-governance-strategy ,
        voc:implement-data-governance ,
        voc:third-party-sharing ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:change-management
    a skos:Concept ;
    skos:prefLabel "Change management"@en ;
    skos:definition "Systematic approach that organizations use to help people adapt to and embrace changes in their work environment, processes, or systems. It involves planning, implementing, and managing the transition to a new state, while also addressing the human impact of those changes."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:governance-operational-activity ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-management-project-support-and-prioritization
    a skos:Concept ;
    skos:prefLabel "Data management project support & prioritization"@en ;
    skos:definition "Aligning data governance efforts with other data management initiatives, such as data warehousing, business intelligence, and data analytics."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:governance-operational-activity ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:develop-data-governance-strategy
    a skos:Concept ;
    skos:prefLabel "Develop data governance strategy"@en ;
    skos:definition "Creating a roadmap for implementing and maturing data governance within an organization, aligning it with business objectives and priorities."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:governance-operational-activity ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:implement-data-governance
    a skos:Concept ;
    skos:prefLabel "Implement data governance"@en ;
    skos:definition "Putting data governance principles, policies, and procedures into practice through people, processes, and technology."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:governance-operational-activity ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:third-party-sharing
    a skos:Concept ;
    skos:prefLabel "Third party sharing"@en ;
    skos:altLabel "3rd Party Sharing"@en ;
    skos:definition "The exchange of data with external entities, such as partners, vendors, or customers, while ensuring compliance with data governance policies and regulations."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:governance-operational-activity ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:governance-planning-activity
    a skos:Concept ;
    skos:prefLabel "Governance planning activity"@en ;
    skos:definition "Activities related to defining the overall data governance strategy, setting goals, allocating resources, and establishing timelines."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:data-governance-activities ;
    skos:narrower voc:assess-regulatory-compliance-requirements ,
        voc:perform-readiness-assessment ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:assess-regulatory-compliance-requirements
    a skos:Concept ;
    skos:prefLabel "Assess regulatory compliance requirements"@en ;
    skos:definition "Systematically evaluating an organization's adherence to laws, regulations, and industry standards to ensure operations align with legal and ethical frameworks, identifying potential risks and implementing controls to mitigate them."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:governance-planning-activity ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:perform-readiness-assessment
    a skos:Concept ;
    skos:prefLabel "Perform readiness assessment"@en ;
    skos:definition "Evaluating an organization’s preparedness to implement or mature its data governance program, identifying strengths, weaknesses, and areas for improvement."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:governance-planning-activity ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-governance-agent
    a skos:Concept ;
    skos:prefLabel "Data governance agent"@en ;
    skos:definition "An individual or a role within an organization responsible for implementing and enforcing data governance policies and procedures, ensuring data quality, consistency, and security throughout its lifecycle."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:governance ;
    skos:narrower voc:data-governance-council , voc:data-owners , voc:data-stewards ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-governance-council
    a skos:Concept ;
    skos:prefLabel "Data governance council"@en ;
    skos:definition "A cross-functional group within an organization responsible for overseeing and guiding the strategic direction of the organization's data governance program, ensuring data is managed effectively and ethically to meet business goals and regulatory requirements."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:data-governance-agent ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-owners
    a skos:Concept ;
    skos:prefLabel "Data owners"@en ;
    skos:definition "Individuals or groups ultimately responsible for the quality, integrity, and security of specific data assets."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:data-governance-agent ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-stewards
    a skos:Concept ;
    skos:prefLabel "Data stewards"@en ;
    skos:definition "Individuals responsible for the day-to-day management and maintenance of data quality within a specific domain or business unit."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:data-governance-agent ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-governance-lifecycle
    a skos:Concept ;
    skos:prefLabel "Data governance lifecycle"@en ;
    skos:definition "A cyclical framework that outlines the stages of data governance, from initial planning and design to implementation, monitoring, and continuous improvement."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:governance ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-governance-operations
    a skos:Concept ;
    skos:prefLabel "Data governance operations"@en ;
    skos:definition "The ongoing activities and tasks performed to ensure that data governance policies and procedures are followed and that data quality is maintained."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:governance ;
    skos:narrower voc:artificial-intelligence-governance ,
        voc:data-catalog-operations ,
        voc:data-governance-controls ,
        voc:data-governance-design ,
        voc:data-literacy ,
        voc:data-protection ,
        voc:governance-reporting-and-metrics ,
        voc:semantic-governance ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:artificial-intelligence-governance
    a skos:Concept ;
    skos:prefLabel "Artificial intelligence governance"@en ;
    skos:altLabel "AI governance"@en , "Artificial Intelligence Governance"@en ;
    skos:definition "A specialized subset of data governance that focuses on establishing the rules, policies, ethics, and controls necessary to manage the data, models, and processes used for Artificial Intelligence (AI) and Machine Learning (ML) systems."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:data-governance-operations ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-10-31T15:35:50.726Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-catalog-operations
    a skos:Concept ;
    skos:prefLabel "Data catalog operations"@en ;
    skos:definition "The continuous activity of managing, enriching, and maintaining the Data Catalog—a centralized inventory of all data assets across the organization. This operation makes governed data discoverable and provides crucial business context."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:data-governance-operations ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-10-31T15:35:23.648Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-governance-controls
    a skos:Concept ;
    skos:prefLabel "Data governance controls"@en ;
    skos:definition "The policies, standards, processes, and tools systematically applied to data assets to enforce the rules established by the governance body. These controls are the practical mechanisms that ensure data is managed securely, reliably, and compliantly."@en ;
    skos:example "Data quality validation rules, mandatory data classification tags, data retention schedules, and policy approval workflows."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:data-governance-operations ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-10-31T15:34:50.467Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-governance-design
    a skos:Concept ;
    skos:prefLabel "Data governance design"@en ;
    skos:definition "The strategic, upfront process of establishing the Data Governance framework, including defining the organizational structure, roles, decision rights, and accountability models (e.g., Data Owners, Data Stewards). It is the architectural planning for how governance will function."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:data-governance-operations ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-10-31T15:34:29.716Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-literacy
    a skos:Concept ;
    skos:prefLabel "Data literacy"@en ;
    skos:definition "The ability of employees across an organization to read, understand, analyze, and communicate with data in context. In governance, it is the programmatic effort to train and empower data consumers to correctly interpret reports, understand data quality rules, and responsibly apply policies (like data privacy rules) to their daily work."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:data-governance-operations ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-10-31T15:33:43.192Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-protection
    a skos:Concept ;
    skos:prefLabel "Data protection"@en ;
    skos:definition "The overarching set of security and privacy measures designed to safeguard data from unauthorized access, corruption, or loss throughout its lifecycle. This is the implementation of security policies defined by governance."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:data-governance-operations ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-10-31T15:36:09.785Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:governance-reporting-and-metrics
    a skos:Concept ;
    skos:prefLabel "Governance reporting & metrics"@en ;
    skos:definition "The practice of defining, collecting, and communicating Key Performance Indicators (KPIs) and operational status reports that measure the success and compliance of the data governance program."@en ;
    skos:scopeNote "To demonstrate the Return on Investment (ROI) of governance, identify areas of non-compliance, and track improvements in data quality, security, and process efficiency."@en ;
    skos:example "Tracking data quality scores, policy adherence rates, time spent resolving data issues, and reduction in regulatory fines."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:data-governance-operations ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-10-31T15:33:59.665Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:semantic-governance
    a skos:Concept ;
    skos:prefLabel "Semantic governance"@en ;
    skos:definition "A specialized discipline under Data Governance that helps Verizon find, understand & use data more effectively by capturing human expertise in structured knowledge systems."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:data-governance-operations ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-10-31T15:36:53.630Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-governance-policy
    a skos:Concept ;
    skos:prefLabel "Data governance policy"@en ;
    skos:definition "The process of creating, approving, implementing, communicating, enforcing, and maintaining data governance policies throughout their lifecycle."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:governance ;
    skos:narrower voc:access-control-policies ,
        voc:business-policy ,
        voc:data-privacy-regulations ,
        voc:data-quality-standards ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:access-control-policies
    a skos:Concept ;
    skos:prefLabel "Access control policies"@en ;
    skos:definition "Rules and procedures that determine who or what can access specific resources within a system, ensuring only authorized individuals or entities have the necessary permissions."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:data-governance-policy ;
    skos:narrower voc:data-access-policy ,
        voc:data-provenance-policy ,
        voc:data-retention-and-archival-policy ,
        voc:data-usage-policy ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-access-policy
    a skos:Concept ;
    skos:prefLabel "Data access policy"@en ;
    skos:definition "Rules and procedures that govern who can access specific data within an organization based on their roles and responsibilities."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:access-control-policies ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-provenance-policy
    a skos:Concept ;
    skos:prefLabel "Data provenance policy"@en ;
    skos:definition "Guidelines for documenting the origin, movement, and transformations of data throughout its lifecycle, ensuring data integrity and traceability."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:access-control-policies ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-retention-and-archival-policy
    a skos:Concept ;
    skos:prefLabel "Data retention & archival policy"@en ;
    skos:definition "Policies that define how long data should be retained, archived, and eventually deleted based on legal, regulatory, and business requirements."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:access-control-policies ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-usage-policy
    a skos:Concept ;
    skos:prefLabel "Data usage policy"@en ;
    skos:definition "Guidelines that define the permissible uses of data within an organization, ensuring compliance with privacy regulations and ethical considerations."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:access-control-policies ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:business-policy
    a skos:Concept ;
    skos:prefLabel "Business policy"@en ;
    skos:definition "High-level guidelines that govern an organization’s business operations and activities, including compliance-related aspects."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:data-governance-policy ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-privacy-regulations
    a skos:Concept ;
    skos:prefLabel "Data privacy regulations"@en ;
    skos:definition "Laws and regulations designed to protect the personal information of individuals, such as GDPR, CCPA, and HIPAA."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:data-governance-policy ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-quality-standards
    a skos:Concept ;
    skos:prefLabel "Data quality standards"@en ;
    skos:definition "Specific criteria and thresholds that define acceptable levels of data quality for different data elements or datasets."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:data-governance-policy ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-governance-services
    a skos:Concept ;
    skos:prefLabel "Data governance services"@en ;
    skos:definition "Specialized expertise and support provided to organizations to help them establish, improve, or manage their data governance programs."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:governance ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-governance-standards
    a skos:Concept ;
    skos:prefLabel "Data governance standards"@en ;
    skos:definition "A set of documented rules, guidelines, and best practices that define how data should be managed, protected, and used within an organization."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:governance ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-governance-tools
    a skos:Concept ;
    skos:prefLabel "Data governance tools"@en ;
    skos:definition "Software applications designed to support data governance activities, such as data cataloging, metadata management, and policy enforcement."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:governance ;
    skos:narrower voc:business-glossary ,
        voc:data-governance-scorecards ,
        voc:document-management-tools ,
        voc:online-presence ,
        voc:workflow-tools ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:business-glossary
    a skos:Concept ;
    skos:prefLabel "Business glossary"@en ;
    skos:definition "A list of business terms and their definitions that organizations use to ensure the same definitions are used company-wide when analyzing data. A business glossary produces a common business vocabulary, used by everyone in an organization."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:data-governance-tools ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-governance-scorecards
    a skos:Concept ;
    skos:prefLabel "Data governance scorecards"@en ;
    skos:definition "Visual representations of key data governance metrics, used to track progress, identify areas for improvement, and communicate performance to stakeholders."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:data-governance-tools ;
    skos:narrower voc:scorecard-metrics ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:scorecard-metrics
    a skos:Concept ;
    skos:prefLabel "Scorecard metrics"@en ;
    skos:definition "Key performance indicators (KPIs) used to measure and track the overall success of a data governance program against its defined goals and objectives."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:data-governance-scorecards ;
    skos:narrower voc:adoption-and-awareness-metrics ,
        voc:compliance-metrics ,
        voc:data-quality-metrics ,
        voc:operational-metrics ,
        voc:security-metrics ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:adoption-and-awareness-metrics
    a skos:Concept ;
    skos:prefLabel "Adoption & awareness metrics"@en ;
    skos:definition "Measure how well users embrace and integrate a product, feature, or process into their routine, while awareness metrics track the extent to which users are informed about a product or feature."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:scorecard-metrics ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:compliance-metrics
    a skos:Concept ;
    skos:prefLabel "Compliance metrics"@en ;
    skos:definition "Quantitative and qualitative measures of your business's performance. These are evaluated in terms of policy violations, financial loss, mitigated risks, non-compliance with regulations, time to recover, impact of breaches on key operations, and effectiveness of compliance programs."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:scorecard-metrics ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:data-quality-metrics
    a skos:Concept ;
    skos:prefLabel "Data quality metrics"@en ;
    skos:definition "Measurements used to assess and monitor the quality of data, such as accuracy rate, completeness percentage, and duplication rate."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:scorecard-metrics ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:operational-metrics
    a skos:Concept ;
    skos:prefLabel "Operational metrics"@en ;
    skos:definition "Measurements used to track the efficiency and effectiveness of data governance operations, such as issue resolution time and policy compliance rate."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:scorecard-metrics ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:security-metrics
    a skos:Concept ;
    skos:prefLabel "Security metrics"@en ;
    skos:definition "Measurements used to assess and monitor the security posture of data, such as the number of data breaches, unauthorized access attempts, and data leakage incidents."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:scorecard-metrics ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:document-management-tools
    a skos:Concept ;
    skos:prefLabel "Document management tools"@en ;
    skos:definition "Software applications used to create, store, manage, and track documents related to data governance, such as policies, procedures, and standards."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:data-governance-tools ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:online-presence
    a skos:Concept ;
    skos:prefLabel "Online presence"@en ;
    skos:definition "The availability and accessibility of information about an organization’s data governance program on internal and external platforms."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:data-governance-tools ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:workflow-tools
    a skos:Concept ;
    skos:prefLabel "Workflow tools"@en ;
    skos:definition "Software solutions that automate and streamline processes for managing, organizing, and ensuring the quality, security, and compliance of an organization's data assets, encompassing tasks like data cataloging, metadata management, and policy enforcement."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:data-governance-tools ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-04-03T19:30:28.004Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .
}
