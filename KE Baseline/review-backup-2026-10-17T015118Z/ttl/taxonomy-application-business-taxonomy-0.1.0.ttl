tax:DataProductOwner
  a owl:Class ;
  rdfs:label "Data product owner"@en ;
  skos:prefLabel "Data product owner"@en ;
  skos:definition "Data products must have this role which provides solutions to the needs of business process owners. They are the single point of contact for the business process owner. They are accountable for establishing the overall feature roadmap, including the prioritization and initial feature sequencing, for understanding the technical challenges necessary for developing that roadmap, ensuring the product meets their customers’ needs, identifying new use cases for the product, etc."@en ;
  rdfs:subClassOf skos:Concept , tax:Owner ;
