<https://www.insperity.com/vocabulary/domain-finance/> {
  <https://www.insperity.com/vocabulary/domain-finance/> a skos:ConceptScheme;
    rdfs:label "Domain finance vocabulary"@en;
    skos:prefLabel "Domain finance vocabulary"@en;
    skos:hasTopConcept domainfinancevoc:finance;
    terms:description "The management and allocation of financial resources, including investing, borrowing, lending, budgeting, saving, and forecasting."@en;
    terms:title "Domain finance vocabulary"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2025-03-25T17:01:30.859Z"^^xsd:dateTime .
  
  domainfinancevoc:finance a skos:Concept;
    skos:prefLabel "Finance"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-25T17:26:29.484Z"^^xsd:dateTime;
    skos:definition "The management and allocation of financial resources, including investing, borrowing, lending, budgeting, saving, and forecasting."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:financial-operations a skos:Concept;
    skos:prefLabel "Financial operations"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:36:58.523Z"^^xsd:dateTime;
    skos:definition "The day-to-day management of a company’s financial resources, including cash flow, working capital, and investments."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:financial-planning-and-analysis a skos:Concept;
    skos:prefLabel "Financial planning & analysis"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:36:58.523Z"^^xsd:dateTime;
    skos:definition "The process of analyzing financial data to support strategic decision-making."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:tax-management-and-reporting a skos:Concept;
    skos:prefLabel "Tax management & reporting"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:12.735Z"^^xsd:dateTime;
    skos:definition "Managing tax obligations and ensuring compliance with tax laws."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:treasury a skos:Concept;
    skos:prefLabel "Treasury"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:12.735Z"^^xsd:dateTime;
    skos:definition "The department responsible for managing a company’s cash, investments, and financial risks."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:accounting a skos:Concept;
    skos:prefLabel "Accounting"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:36:58.523Z"^^xsd:dateTime;
    skos:definition "The process of recording, classifying, summarizing, and interpreting financial transactions to provide information for decision-making."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:cost-accounting-management a skos:Concept;
    skos:prefLabel "Cost accounting management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:36:58.523Z"^^xsd:dateTime;
    skos:definition "The process of tracking, analyzing, and controlling costs associated with producing goods or services."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:financial-supply-change-management a skos:Concept;
    skos:prefLabel "Financial supply change management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:36:58.523Z"^^xsd:dateTime;
    skos:definition "Optimizing the flow of cash and related financial information throughout the supply chain."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:working-capital-management a skos:Concept;
    skos:prefLabel "Working capital management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:12.735Z"^^xsd:dateTime;
    skos:definition "Managing short-term assets and liabilities to ensure a company has sufficient liquidity to operate."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:asset-management a skos:Concept;
    skos:prefLabel "Asset management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:36:58.523Z"^^xsd:dateTime;
    skos:definition "The process of managing a company’s assets, including investments, cash, and inventory, to maximize returns and minimize risk."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:equity-management a skos:Concept;
    skos:prefLabel "Equity management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:36:58.523Z"^^xsd:dateTime;
    skos:definition "The process of managing a company’s equity, including issuing and repurchasing shares, to maximize shareholder value."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:general-ledger a skos:Concept;
    skos:prefLabel "General ledger"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:36:58.523Z"^^xsd:dateTime;
    skos:definition "The primary accounting record of a company, containing all financial transactions."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:liability-management a skos:Concept;
    skos:prefLabel "Liability management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:36:58.523Z"^^xsd:dateTime;
    skos:definition "The process of managing a company’s liabilities, including debt and accounts payable, to minimize costs and risks."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:revenue-management a skos:Concept;
    skos:prefLabel "Revenue management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:12.735Z"^^xsd:dateTime;
    skos:definition "The process of maximizing revenue from a company’s products or services, including pricing, promotion, and distribution."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:revenue-growth a skos:Concept;
    skos:prefLabel "Revenue growth"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:12.735Z"^^xsd:dateTime;
    skos:definition "The percentage increase in revenue over a period of time."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:revenue-recovery a skos:Concept;
    skos:prefLabel "Revenue recovery"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:12.735Z"^^xsd:dateTime;
    skos:definition "The process of recovering lost or uncollected revenue."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:revenue-streams a skos:Concept;
    skos:prefLabel "Revenue streams"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:12.735Z"^^xsd:dateTime;
    skos:definition "The different sources of revenue for a company."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:capital-expenditures a skos:Concept;
    skos:prefLabel "Capital expenditures"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:36:58.523Z"^^xsd:dateTime;
    skos:definition "Investments in long-term assets, such as property, plant, and equipment."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:cost a skos:Concept;
    skos:prefLabel "Cost"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:36:58.523Z"^^xsd:dateTime;
    skos:definition "The monetary value of resources used or sacrificed to achieve a specific objective."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:operating-expense a skos:Concept;
    skos:prefLabel "Operating expense"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:36:58.523Z"^^xsd:dateTime;
    skos:definition "Expenses incurred in the normal course of business operations, excluding cost of goods sold and capital expenditures."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:bank-account-management a skos:Concept;
    skos:prefLabel "Bank account management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:36:58.523Z"^^xsd:dateTime;
    skos:definition "Managing and monitoring bank accounts to ensure sufficient liquidity and optimize interest earnings."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:credit-management a skos:Concept;
    skos:prefLabel "Credit management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:36:58.523Z"^^xsd:dateTime;
    skos:definition "The process of granting credit to customers, monitoring credit limits, and collecting outstanding debts."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:management-information-systems a skos:Concept;
    skos:prefLabel "Management information systems"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:36:58.523Z"^^xsd:dateTime;
    skos:definition "Systems that provide information to support decision-making within an organization."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:payment a skos:Concept;
    skos:prefLabel "Payment"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:12.735Z"^^xsd:dateTime;
    skos:definition "The transfer of funds from a payer to a payee."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:order-to-cash a skos:Concept;
    skos:prefLabel "Order to cash"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:36:58.523Z"^^xsd:dateTime;
    skos:definition "The business process encompassing sales order creation to cash collection."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:procure-to-pay a skos:Concept;
    skos:prefLabel "Procure to pay"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:12.735Z"^^xsd:dateTime;
    skos:definition "The business process encompassing purchase requisition to supplier payment."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:record-to-report a skos:Concept;
    skos:prefLabel "Record to report"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:12.735Z"^^xsd:dateTime;
    skos:definition "The accounting process from recording transactions to generating financial statements."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-finance/> .
  
  domainfinancevoc:payment-gateways a skos:Concept;
    skos:prefLabel "Payment gateways"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:12.735Z"^^xsd:dateTime;
    skos:definition "Online services that authorize and process credit card payments."@en;
