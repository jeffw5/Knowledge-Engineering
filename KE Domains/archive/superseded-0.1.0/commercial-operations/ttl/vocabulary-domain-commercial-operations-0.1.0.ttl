commercialopsvoc:workers-compensation
  a skos:Concept ;
  rdfs:label "workers' compensation"@en ;
  skos:prefLabel "workers' compensation"@en ;
  skos:definition "A system, required by state law, that provides wage replacement and medical benefits to workers injured in the course of employment."@en ;
  skos:scopeNote "A multiword lexical unit (Baseline decision 3): its meaning is not the sum of \"worker\" and \"compensation\"."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-commercial-operations/> ;
  skos:topConceptOf <https://www.insperity.com/vocabulary/domain-commercial-operations/> ;
