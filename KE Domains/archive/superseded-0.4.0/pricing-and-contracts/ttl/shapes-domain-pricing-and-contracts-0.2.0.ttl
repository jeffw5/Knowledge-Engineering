pricingcontractsshp:quote-shape
  a sh:NodeShape ;
  rdfs:label "Quote shape"@en ;
  skos:prefLabel "Quote shape"@en ;
  skos:definition "A shape that checks a quote names the opportunity it prices and is built from pricing components."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-pricing-and-contracts/> ;
  sh:targetClass pricingcontracts:quote ;
  sh:property [
      sh:path core:concerns ;
      sh:class commercialops:opportunity ;
      sh:message "A quote must be for an opportunity."@en ;
      sh:minCount "1"^^xsd:integer
  ] ,
      [
      sh:path core:hasComponent ;
      sh:class core:measure ;
      sh:message "A quote should list the pricing components it is built from."@en ;
      sh:minCount "1"^^xsd:integer ;
      sh:severity sh:Warning
  ] ;
  owl:versionInfo "0.2.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-20"^^xsd:date ;
  dct:modified "2026-10-20T04:19:14Z"^^xsd:dateTime .

pricingcontractsshp:underwriting-decision-shape
  a sh:NodeShape ;
  rdfs:label "Underwriting decision shape"@en ;
  skos:prefLabel "Underwriting decision shape"@en ;
  skos:definition "A shape that checks an underwriting decision names its inputs and the guideline that governs it."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-pricing-and-contracts/> ;
  sh:targetClass pricingcontracts:underwriting-decision ;
  sh:property [
      sh:path core:consumes ;
      sh:class core:information-asset ;
      sh:message "An underwriting decision should name the inputs it consumed (census, loss run, class codes)."@en ;
      sh:minCount "1"^^xsd:integer ;
      sh:severity sh:Warning
  ] ,
      [
      sh:path core:governedBy ;
      sh:class core:directive ;
      sh:message "An underwriting decision should name the underwriting guideline that governs it."@en ;
      sh:minCount "1"^^xsd:integer ;
      sh:severity sh:Warning
  ] ;
  owl:versionInfo "0.2.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-20"^^xsd:date ;
