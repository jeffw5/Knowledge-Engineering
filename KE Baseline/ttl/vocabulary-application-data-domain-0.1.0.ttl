voc:workforce-resource
  a skos:Concept ;
  skos:prefLabel "Workforce resource"@en ;
  skos:definition "Data representing the employees and other non-human assets specifically involved in field operational tasks."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
