  domainsalestax:selling-stage
    a skos:Concept ;
    rdfs:label "Selling stage"@en ;
    skos:prefLabel "Selling stage"@en ;
    skos:definition "A process step of the selling process: the provider's view of where an opportunity stands in the buyer's journey."@en ;
    skos:scopeNote "Buying stages are the provider's point of view (Baseline decision 21). A stage may address one or more of the buyer persona's jobs or job steps; it must not be confused with those job steps, and the mismatch between them is where value gaps are created."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/> ;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-sales/> ;
    skos:narrower domainsalestax:decide ,
        domainsalestax:discover ,
        domainsalestax:evaluate ,
        domainsalestax:onboard ,
        domainsalestax:propose ,
        domainsalestax:qualify ;
    dct:subject domainvoc:selling-stage , domaincommercialoperationsvoc:selling-stage ;
    core:formalizedBy domainsales:selling-step ;
    owl:versionInfo "0.1.0" ;
    skos:broadMatch processtax:process-step ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-20"^^xsd:date ;
    dct:modified "2026-10-20T02:31:43Z"^^xsd:dateTime .

  domainsalestax:decide
    a skos:Concept ;
    rdfs:label "Decide"@en ;
    skos:prefLabel "Decide"@en ;
    skos:altLabel "Close"@en , "Decision stage"@en ;
    skos:definition "A selling stage in which the buyer negotiates and makes its decision, ending in a win or a loss."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/> ;
    skos:broader domainsalestax:selling-stage ;
    core:hasPrimaryTerm decisionvoc:decide ;
    dct:subject decisionvoc:decide ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-20"^^xsd:date ;
    dct:modified "2026-10-20T02:31:43Z"^^xsd:dateTime .

  domainsalestax:discover
    a skos:Concept ;
    rdfs:label "Discover"@en ;
    skos:prefLabel "Discover"@en ;
    skos:altLabel "Discovery"@en ;
    skos:definition "A selling stage in which the seller learns the prospect's situation, needs and the jobs it is trying to get done."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/> ;
    skos:broader domainsalestax:selling-stage ;
