  voc:user-behavior-data
    a skos:Concept ;
    skos:prefLabel "User behavior data"@en ;
    skos:definition "Information about how users interact with a system or product, including their actions, patterns, and choices."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/core-persona/> ;
    skos:broader voc:persona ;
    skos:narrower voc:device-and-platform-data ,
        voc:engagement-metric ,
        voc:event-tracking ,
        voc:navigation-pattern ,
