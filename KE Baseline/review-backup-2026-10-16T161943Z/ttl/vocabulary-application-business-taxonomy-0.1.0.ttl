voc:service-capacity
  a skos:Concept ;
  skos:prefLabel "Service capacity"@en ;
  skos:definition "The maximum workload, throughput, or number of concurrent users/transactions a service can handle while still meeting its defined performance targets and quality levels. It involves ensuring that the service has sufficient resources to meet current and future demand predictably."@en ;
  skos:notation "TL3000130" ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:service-assurance ;
  owl:versionInfo "0.1.0" ;
