<https://www.insperity.com/ontology/domain-pricing/> {

  <https://www.insperity.com/ontology/domain-pricing/>
    a owl:Ontology ;
    rdfs:label "Domain Pricing Ontology"@en ;
    dct:title "Domain Pricing Ontology"@en ;
    dct:description "The pricing ontology. It extends the core domain ontology and the Commercial Operations ontology with quotes for opportunities, and underwriting and its decisions, which consume the Commercial Operations census. Agreements and their clauses are in Domain Legal (Business Operations)."@en ;
    dct:subject domainvoc:commercial ;
    owl:imports <https://www.insperity.com/ontology/commercial-operations/> ,
        <https://www.insperity.com/ontology/core/> ;
    vaem:namespace "https://www.insperity.com/ontology/domain-pricing/"^^xsd:anyURI ;
    vann:preferredNamespacePrefix "pricing" ;
    dct:language "en" ;
    dct:publisher <https://www.insperity.com/resource/core/Organization/insperity> ;
    dct:conformsTo <http://purl.obolibrary.org/obo/bfo/2020/bfo.owl> ,
        <https://www.insperity.com/standard/semantic-governance/1.9/> ;
    skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en ;
    skos:changeNote "0.3.0 (2026-10-21): Restructured to the operational areas and the naming standard (D26, D27): titled 'Domain Pricing Vocabulary', '… Taxonomy', '… Ontology' and '… Shapes', at …/<kind>/domain-pricing/ (formerly Pricing and contracts, …/<kind>/domain-pricing-and-contracts/). Contract management steps, agreement terms and agreement statuses, with the term and signature primitives, moved to Domain Legal (Business Operations); pricing review stays here. Built by build_domains.py from spec_pricing.py against Baseline Core v1.0 (core 0.1.0)."@en ,
        "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_pricing.py against Baseline Core v1.0 (core 0.1.0)."@en ,
        "0.2.0 (2026-10-20): Census moved to the Commercial Operations container (D2). Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_pricing.py against Baseline Core v1.0 (core 0.1.0)."@en ;
    owl:versionInfo "0.3.0" ;
    owl:versionIRI <https://www.insperity.com/ontology/domain-pricing/0.3.0/> ;
    dct:identifier "ontology-domain-pricing" ;
    dct:isPartOf <https://www.insperity.com/ontology/commercial-operations/> ;
    dct:replaces <https://www.insperity.com/ontology/domain-pricing-and-contracts/> ;
    dct:requires <https://www.insperity.com/ontology/commercial-operations/0.4.0/> ,
        <https://www.insperity.com/ontology/core/0.1.0/> ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-22"^^xsd:date ;
    dct:modified "2026-10-22T02:04:02Z"^^xsd:dateTime .

  pricing:quote
    a owl:Class ;
    rdfs:label "Quote"@en ;
    skos:prefLabel "Quote"@en ;
    skos:definition "An information asset that states the prices at which the organization offers an offering to a prospect or client in pursuit of an opportunity, valid for a stated period."@en ;
    skos:scopeNote "Its components are the pricing components (measures); a proposal (Commercial Operations) presents one or more quotes."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty core:concerns ;
        owl:someValuesFrom commercialops:opportunity
    ] ,
        [
        a owl:Restriction ;
        owl:allValuesFrom core:measure ;
        owl:onProperty core:hasComponent
    ] ,
        core:information-asset ;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-pricing/> ;
    core:hasPrimaryTerm pricingvoc:quote ;
    dct:subject pricingvoc:quote ;
    owl:versionInfo "0.3.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-22"^^xsd:date ;
    dct:modified "2026-10-22T02:04:02Z"^^xsd:dateTime .

  pricing:underwriting
    a owl:Class ;
    rdfs:label "Underwriting"@en ;
    skos:prefLabel "Underwriting"@en ;
    skos:definition "A process that assesses the risk of covering a client and decides whether, and at what price, to offer coverage."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty core:hasStep ;
        owl:someValuesFrom core:process-step
    ] ,
        [
        a owl:Restriction ;
        owl:allValuesFrom core:directive ;
        owl:onProperty core:governedBy
    ] ,
        core:process ;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-pricing/> ;
    core:hasPrimaryTerm pricingvoc:underwriting ;
    dct:subject pricingvoc:underwriting ;
    owl:versionInfo "0.3.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-22"^^xsd:date ;
    dct:modified "2026-10-22T02:04:02Z"^^xsd:dateTime .

  pricing:underwriting-decision
    a owl:Class ;
    rdfs:label "Underwriting decision"@en ;
    skos:prefLabel "Underwriting decision"@en ;
    skos:definition "A decision, made in underwriting, on whether and on what terms to offer coverage to a client."@en ;
    skos:scopeNote "Kept as a class because it carries its own axioms; it consumes the census, loss runs, class codes and experience modification factor (Baseline decision 8)."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty core:consumes ;
        owl:someValuesFrom core:information-asset
    ] ,
        [
        a owl:Restriction ;
        owl:allValuesFrom core:directive ;
        owl:onProperty core:governedBy
    ] ,
        core:decision ;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-pricing/> ;
    core:hasPrimaryTerm decisionvoc:decision ;
    dct:subject decisionvoc:decision ;
    owl:versionInfo "0.3.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-22"^^xsd:date ;
    dct:modified "2026-10-22T02:04:02Z"^^xsd:dateTime .
}
