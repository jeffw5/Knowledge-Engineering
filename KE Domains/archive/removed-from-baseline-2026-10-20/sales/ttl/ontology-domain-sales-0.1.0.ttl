<https://www.insperity.com/ontology/domain-sales/>
  a owl:Ontology ;
  rdfs:label "Domain sales ontology"@en ;
  dct:title "Domain sales ontology"@en ;
  skos:altLabel "Sales domain ontology"@en ;
  dct:description "The sales ontology. It extends the core domain ontology and the Commercial Operations ontology with the selling process and its steps, anchored on the process step and bridged to the buyer persona's job steps through core:addresses, and with sales quotas."@en ;
  dct:subject domaintax:EnterpriseArchitecture ;
  owl:imports <https://www.insperity.com/ontology/core/> ,
      <https://www.insperity.com/ontology/core/0.1.0/> ,
      <https://www.insperity.com/ontology/domain-commercial-operations/0.1.0/> ;
  vaem:namespace "https://www.insperity.com/ontology/domain-sales/"^^xsd:anyURI ;
  vann:preferredNamespacePrefix "domainsales" ;
  dct:language "en" ;
  dct:publisher <https://www.insperity.com/resource/core/Organization/insperity> ;
  dct:conformsTo <http://purl.obolibrary.org/obo/bfo/2020/bfo.owl> ,
      <https://www.insperity.com/standard/semantic-governance/1.9/> ;
  skos:changeNote "0.1.0 (2026-10-19): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.9 (Draft), Part III."@en ;
  owl:versionInfo "0.1.0" ;
  owl:versionIRI <https://www.insperity.com/ontology/domain-sales/0.1.0/> ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
