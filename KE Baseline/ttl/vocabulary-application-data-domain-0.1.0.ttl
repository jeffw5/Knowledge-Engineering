  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:customer-payment
  a skos:Concept ;
  skos:prefLabel "Customer payment"@en ;
  skos:definition "The technical record of a transfer of wealth (e.g., payment) received from a Customer for products or usage."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:customer-bill-collection ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-10-24T20:07:18.820Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:customer-core-performance
  a skos:Concept ;
  skos:prefLabel "Customer core performance"@en ;
  skos:definition "Customer Core Performance represent the analytical data and metrics derived from the customer’s financial, contractual, and operational activities. These statistics provide insights into customer usage patterns, billing trends, account behavior, credit status, and payment history. Examples Include: • Monthly data usage per customer segment • Average bill amount and payment delay rates • Churn probability based on billing irregularities • Number of active vs. dormant accounts • Collection success rate by region or segment"@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:customer-core ;
  owl:versionInfo "0.1.0" ;
  skos:related voc:performance ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-10-24T20:07:01.918Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:customer-usage
  a skos:Concept ;
  skos:prefLabel "Customer usage"@en ;
  skos:definition "Customer Usage holds detailed records of how individual customers consume telecom services and products over time. It captures quantitative usage events such as data consumption, voice minutes, SMS, or other measurable activities linked to subscribed services or products. This information is critical for rating, billing, usage analytics, and customer profiling. In addition to core telecom usage, Customer Usage also tracks detailed consumption of service-layer offerings such as content streaming, cloud storage, gaming, and value-added services. These records help assess service performance, enable usage-based pricing, and support targeted customer engagement."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:customer-core ;
  owl:versionInfo "0.1.0" ;
  skos:related voc:usage ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-10-24T20:07:01.918Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:profile
  a skos:Concept ;
  skos:prefLabel "Profile"@en ;
  skos:altLabel "Customer Profile"@en ;
  skos:definition "A customer profile is a detailed description of a customer or group of customers, encompassing their demographics, behaviors, interests, and needs. Information included: Demographics: Age, gender, location, income, education, occupation, etc. Behavioral: Churn score, Channel Preference, Purchase history, website usage, social media engagement, etc."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:customer-core ;
  owl:versionInfo "0.1.0" ;
  skos:related voc:party-profile ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-10-24T20:07:01.918Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:customer-experience
  a skos:Concept ;
  skos:prefLabel "Customer experience"@en ;
  skos:altLabel "CX"@en ;
  skos:definition "Customer Experience focuses on the customer's journey, perception, and interactions across all touchpoints with the service provider. It captures customer engagements, reported problems, service or order requests, SLA commitments, satisfaction metrics, and feedback loops. It encompasses: • Interaction and Engagement Management • Customer Problem and Complaint Handling • SLA Monitoring and Performance Tracking • Customer Satisfaction and Feedback Management • Journey Mapping and Experience Analytics"@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:data-domain ;
  skos:narrower voc:customer-bill-inquiry ,
      voc:customer-experience-performance ,
      voc:customer-problem ,
      voc:customer-product-order ,
      voc:customer-service-level-agreement ,
      voc:interactions ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-10-24T20:05:19.620Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:customer-bill-inquiry
  a skos:Concept ;
  skos:prefLabel "Customer bill inquiry"@en ;
  skos:definition "Represents invoice inquiries associated with invoices sent to customers and handles disputes and adjustments on individual charges, invoices, and accounts. A request for information about a statement of money owed by a customer."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:customer-experience ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-10-24T20:07:33.928Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:customer-experience-performance
  a skos:Concept ;
  skos:prefLabel "Customer experience performance"@en ;
  skos:definition "Customer Experience Statistics reflect the measurements and trends related to customer interactions, perceptions, and satisfaction across all service channels and touchpoints. These statistics help evaluate service quality, responsiveness, and overall customer sentiment."@en ;
  skos:example "\n• Average response time to customer complaints \n• Net Promoter Score (NPS) by product type \n• Volume of service issues reported per month \n• SLA breach rate by service or region \n• CSAT scores after support interactions"@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:customer-experience ;
  owl:versionInfo "0.1.0" ;
  skos:related voc:performance ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-10-24T20:07:33.928Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:customer-problem
  a skos:Concept ;
  skos:prefLabel "Customer problem"@en ;
  skos:definition "The data record for technical assistance and operational problem handling reported by or for a Customer."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:customer-experience ;
  owl:versionInfo "0.1.0" ;
  skos:related voc:trouble-or-problem ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-10-24T20:07:33.928Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:customer-product-order
  a skos:Concept ;
  skos:prefLabel "Customer product order"@en ;
  skos:definition "The data record of a formal communication used by a Customer to procure, update, or remove one or many products."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:customer-experience ;
  skos:narrower voc:sales-quote , voc:sales-quote-specification ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-10-24T20:07:33.928Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:sales-quote
  a skos:Concept ;
  skos:prefLabel "Sales quote"@en ;
  skos:definition "A document or record provided to a prospective customer (Prospect) detailing the cost and validity period for purchasing specific Products."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:customer-product-order ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-10-24T20:07:40.460Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:sales-quote-specification
  a skos:Concept ;
  skos:prefLabel "Sales quote specification"@en ;
  skos:altLabel "Sales Quote Spec"@en ;
  skos:definition "The technical blueprint or template that defines the structure, format, and common characteristics of a Sales Quote."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:customer-product-order ;
