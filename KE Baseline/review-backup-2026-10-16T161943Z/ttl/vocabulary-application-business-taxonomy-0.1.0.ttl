voc:wireless
  a skos:Concept ;
  skos:prefLabel "Wireless"@en ;
  skos:altLabel "Mobile"@en ;
  skos:definition "Also known in business use as Mobile, this is a service type that uses radio waves to transmit and receive data, offering mobility and flexibility without physical connections."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
