tax:operational-equipment
  a skos:Concept ;
  skos:prefLabel "Operational equipment"@en ;
  skos:altLabel "Machinery"@en ;
  skos:definition "An equipment that is used directly in producing goods or delivering physical services."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core/> ;
  skos:broader tax:equipment ;
  dc:subject tax:operational-equipment ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-16T23:03:55Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T23:03:55Z"^^xsd:dateTime .

tax:party-record
  a skos:Concept ;
  skos:prefLabel "Party record"@en ;
  skos:altLabel "Client record"@en , "Master record"@en , "Personnel record"@en ;
  skos:definition "A record that holds identifying and descriptive information about a party."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core/> ;
  skos:broader tax:record ;
  dc:subject tax:party-record ;
  owl:versionInfo "0.1.0" ;
