      <https://ontologies.verizon.com/taxonomy-core-services-technicalservices/> .
  
  <https://www.insperity.com/taxonomy/core-time/> prov:wasDerivedFrom <https://ontologies.verizon.com/taxonomy-core-time/>,
      <https://www.insperity.com/taxonomy/core/TimeTaxonomy> .
  
  <https://www.insperity.com/taxonomy/core-asset/> prov:wasDerivedFrom <https://www.insperity.com/taxonomy/core/AssetTaxonomy> .
  
