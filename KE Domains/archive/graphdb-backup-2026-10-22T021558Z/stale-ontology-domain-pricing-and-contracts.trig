<https://www.insperity.com/ontology/domain-pricing-and-contracts/> {
  pricingcontracts:quote a owl:Class;
    rdfs:subClassOf core:information-asset, _:node12011, _:node12012;
    rdfs:label "Quote"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-pricing-and-contracts/>;
    skos:prefLabel "Quote"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "An information asset that states the prices at which the organization offers an offering to a prospect or client in pursuit of an opportunity, valid for a stated period."@en;
    skos:scopeNote "Its components are the pricing components (measures); a proposal (Commercial Operations) presents one or more quotes."@en;
    owl:versionInfo "0.2.0";
    terms:subject pricingcontractsvoc:quote;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm pricingcontractsvoc:quote .
  
  pricingcontracts:underwriting-decision a owl:Class;
    rdfs:subClassOf core:decision, _:node12015, _:node12016;
    rdfs:label "Underwriting decision"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-pricing-and-contracts/>;
    skos:prefLabel "Underwriting decision"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A decision, made in underwriting, on whether and on what terms to offer coverage to a client."@en;
    skos:scopeNote "Kept as a class because it carries its own axioms; it consumes the census, loss runs, class codes and experience modification factor (Baseline decision 8)."@en;
    owl:versionInfo "0.2.0";
    terms:subject decisionvoc:decision;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm decisionvoc:decision .
  
  <https://www.insperity.com/ontology/domain-pricing-and-contracts/> a owl:Ontology;
    rdfs:label "Pricing and contracts domain ontology"@en;
    skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en;
    terms:description "The pricing and contracts ontology. It extends the core domain ontology and the Commercial Operations ontology with quotes for opportunities, and underwriting and its decisions, which consume the Commercial Operations census. Agreements are the Commercial Operations client service agreement and its clauses."@en;
    terms:title "Pricing and contracts domain ontology"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_pricing_and_contracts.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.2.0 (2026-10-20): Census moved to the Commercial Operations container (D2). Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_pricing_and_contracts.py against Baseline Core v1.0 (core 0.1.0)."@en;
    terms:created "2026-10-20"^^xsd:date;
    owl:versionInfo "0.2.0";
    terms:subject domainvoc:commercial;
    owl:imports <https://www.insperity.com/ontology/core/>, <https://www.insperity.com/ontology/domain-commercial-operations/>;
    terms:isPartOf <https://www.insperity.com/domain/commercial-operations/>;
    owl:versionIRI <https://www.insperity.com/ontology/domain-pricing-and-contracts/0.2.0/>;
    vaem:namespace "https://www.insperity.com/ontology/domain-pricing-and-contracts/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft;
    vann:preferredNamespacePrefix "pricingcontracts";
    terms:publisher <https://www.insperity.com/resource/core/Organization/insperity>;
    terms:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/>, <http://purl.obolibrary.org/obo/bfo/2020/bfo.owl>;
    terms:identifier "ontology-domain-pricing-and-contracts";
    terms:requires <https://www.insperity.com/ontology/core/0.1.0/>, <https://www.insperity.com/ontology/domain-commercial-operations/0.2.0/> .
  
  pricingcontracts:underwriting a owl:Class;
    rdfs:subClassOf core:process, _:node12013, _:node12014;
    rdfs:label "Underwriting"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-pricing-and-contracts/>;
    skos:prefLabel "Underwriting"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A process that assesses the risk of covering a client and decides whether, and at what price, to offer coverage."@en;
    owl:versionInfo "0.2.0";
    terms:subject pricingcontractsvoc:underwriting;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm pricingcontractsvoc:underwriting .
  
  _:node12011 a owl:Restriction;
    owl:onProperty core:concerns;
    owl:someValuesFrom commercialops:opportunity .
  
  _:node12012 a owl:Restriction;
    owl:onProperty core:hasComponent;
    owl:allValuesFrom core:measure .
  
  _:node12013 a owl:Restriction;
    owl:onProperty core:hasStep;
    owl:someValuesFrom core:process-step .
  
  _:node12014 a owl:Restriction;
    owl:onProperty core:governedBy;
    owl:allValuesFrom core:directive .
  
  _:node12015 a owl:Restriction;
    owl:onProperty core:consumes;
    owl:someValuesFrom core:information-asset .
  
  _:node12016 a owl:Restriction;
    owl:onProperty core:governedBy;
    owl:allValuesFrom core:directive .
}
