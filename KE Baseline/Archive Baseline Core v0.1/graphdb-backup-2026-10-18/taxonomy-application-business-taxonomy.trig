  <https://www.insperity.com/taxonomy/application-business-taxonomy/PhoneCases> terms:created
      "2025-04-23T13:59:38.158Z"^^xsd:dateTime;
    skos:definition "Protective covers for smartphones, offering impact resistance, scratch protection and personalized style."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ScreenProtectors>
    terms:created "2025-04-23T13:59:38.158Z"^^xsd:dateTime;
    skos:definition "Thin films or tempered glass layers applied to smartphone and tablet screens to prevent scratches, cracks and smudges."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/SmartHomeProducts>
    terms:created "2025-04-23T13:59:38.158Z"^^xsd:dateTime;
    skos:definition "Devices and systems that automate and control home functions, such as lighting, temperature, security and appliances."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/TabletAccessories>
    terms:created "2025-04-23T13:59:38.158Z"^^xsd:dateTime;
    skos:definition "Peripherals and add-ons for tablets, such as keyboards, styluses, cases and chargers."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ConnectedDevices>
    terms:created "2025-04-23T13:59:38.158Z"^^xsd:dateTime;
    skos:definition "Devices that can connect to the internet or other devices, such as smartwatches, fitness trackers and home automation systems."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ConnectedHomeDevices>
    terms:created "2025-04-23T13:59:38.158Z"^^xsd:dateTime;
    skos:definition "Devices that connect to the internet and can be controlled remotely, such as smart thermostats, smart lighting and smart appliances."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Hum> terms:created
      "2025-04-23T13:59:38.158Z"^^xsd:dateTime;
    skos:definition "A device that plugs into a car’s OBD-II port and provides vehicle diagnostics, location tracking and other features."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Laptop> terms:created
      "2025-04-23T13:59:38.158Z"^^xsd:dateTime;
    skos:definition "A portable personal computer designed for mobile use."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/MobileHotspotDevices>
    terms:created "2025-04-23T13:59:38.158Z"^^xsd:dateTime;
    skos:definition "Devices that create a Wi-Fi network using a cellular connection, allowing multiple devices to connect to the internet."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/SecurityCameras>
    terms:created "2025-04-23T13:59:38.158Z"^^xsd:dateTime;
    skos:definition "Cameras used for surveillance and security purposes."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Smartwatch> terms:created
      "2025-04-23T13:59:38.158Z"^^xsd:dateTime;
    skos:definition "A wearable device that functions as a watch and also provides smartphone-like functionality, such as notifications, fitness tracking and mobile payments."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Tablet> terms:created
      "2025-04-23T13:59:38.158Z"^^xsd:dateTime;
    skos:definition "A portable touchscreen device, larger than a smartphone but smaller than a laptop."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerPremisesEquipment>
    terms:created "2025-04-23T13:59:38.158Z"^^xsd:dateTime;
    skos:definition "Also known as CPE, equipment installed at a customer’s location to provide access to telecommunications services, such as modems, routers and set-top boxes."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Routers> terms:created
      "2025-04-23T13:59:38.158Z"^^xsd:dateTime;
    skos:definition "Network devices that establish and manage internet connections, allowing multiple devices to share the same network."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/SetTopBoxes> terms:created
      "2025-04-23T13:59:38.158Z"^^xsd:dateTime;
    skos:definition "Devices that connect to televisions to provide access to cable or satellite TV channels, streaming services and other interactive features."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/UsbModems> terms:created
      "2025-04-23T13:59:38.158Z"^^xsd:dateTime;
    skos:definition "Devices that connect to a computer via USB and provide access to a cellular network."@en;
    skos:altLabel "USB modems"@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Smartphone> terms:created
      "2025-04-23T13:59:38.158Z"^^xsd:dateTime;
    skos:definition "A mobile phone with advanced computing capabilities and connectivity features."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ProductFeatures>
    terms:created "2025-04-23T13:59:38.158Z"^^xsd:dateTime;
    skos:definition "The characteristics and capabilities of a product, such as its size, weight, battery life and processing power."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ProductCompatibility>
    terms:created "2025-04-23T13:59:38.158Z"^^xsd:dateTime;
    skos:definition "Information about which other the organization products or services a specific product can successfully interact with or be used alongside."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ProductReviewsRatings>
    terms:created "2025-04-23T13:59:38.158Z"^^xsd:dateTime;
    skos:definition "Feedback and evaluations from customers who have purchased and used a product."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ProductWarrantySupport>
    terms:created "2025-04-23T13:59:38.158Z"^^xsd:dateTime;
    skos:definition "Guarantees and support services offered to customers who purchase a product."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ProductSegmentation>
    terms:created "2025-04-22T20:45:18.239Z"^^xsd:dateTime;
    skos:definition "Offering different versions or variations of a product to appeal to different customer segments."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ProductSpecification>
    terms:created "2025-06-23T17:03:58.838Z"^^xsd:dateTime;
    skos:definition "A detailed document outlining a product's requirements, including its features, functionality, design, technical aspects, and performance criteria, serving as a blueprint for the development team."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ProductUsage> terms:created
      "2025-06-23T17:03:58.838Z"^^xsd:dateTime;
    skos:definition "The manner and extent to which customers interact with a product, encompassing aspects like frequency of use, features utilized, duration of engagement, and overall user behavior patterns."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Project> terms:created
      "2025-06-23T17:12:27.405Z"^^xsd:dateTime;
    skos:definition "A temporary and planned endeavor undertaken to create a unique product, service, or result with a defined scope, start, and end."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ResourceCatalog>
    terms:created "2025-04-22T20:48:03.067Z"^^xsd:dateTime;
    skos:definition "The process of acquiring, managing and disposing of assets effectively and efficiently."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Application> terms:created
      "2025-04-23T14:21:57.901Z"^^xsd:dateTime;
    skos:definition "A software program designed to perform specific tasks for users."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/MobileApplication>
    terms:created "2025-04-23T14:21:57.901Z"^^xsd:dateTime;
    skos:definition "A software application designed to run on mobile devices, such as smartphones and tablets."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Asset> terms:created
      "2025-04-23T14:29:10.297Z"^^xsd:dateTime;
    skos:definition "A resource owned or controlled by a company that has economic value, such as property, equipment, or investments."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/EthernetBackhaulAsset>
    terms:created "2025-04-23T14:21:57.901Z"^^xsd:dateTime;
    skos:definition "Assets related to the Ethernet Backhaul (EBH)"@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/FixedWirelessAccessAsset>
    terms:created "2025-04-23T14:21:57.901Z"^^xsd:dateTime;
    skos:definition "Assets related to Fixed Wireless Access (FWA), which provides broadband internet access using wireless signals instead of traditional cable or DSL lines."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/IntelligentEdgeNetworkAsset>
    terms:created "2025-04-23T14:21:57.901Z"^^xsd:dateTime;
    skos:definition "Assets located at the edge of a network, closer to end users, such as edge computing servers and content delivery networks (CDNs)."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/RadioAccessNetworkAsset>
    terms:created "2025-04-23T14:21:57.901Z"^^xsd:dateTime;
    skos:definition "Assets related to the Radio Access Network (RAN) in telecommunications, such as cell towers, antennas and base stations."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Carbon> terms:created
      "2025-04-23T14:21:57.901Z"^^xsd:dateTime;
    skos:definition "Carbon emissions, often used in the context of environmental sustainability and corporate social responsibility."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Data> terms:created
      "2025-04-23T14:21:57.901Z"^^xsd:dateTime;
    skos:definition "Information processed or stored by a computer system."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Device> terms:created
      "2025-04-23T14:21:57.901Z"^^xsd:dateTime;
    skos:definition "An electronic gadget or appliance, such as a smartphone, tablet, or laptop."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ConnectedDevice>
    terms:created "2025-04-23T14:21:57.901Z"^^xsd:dateTime;
    skos:definition "A device that can connect to the internet or other devices, such as smartwatches, fitness trackers and home automation systems."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/MobileDevice> terms:created
      "2025-04-23T14:21:57.901Z"^^xsd:dateTime;
    skos:definition "A portable electronic device, such as a smartphone or tablet."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Server> terms:created
      "2025-04-23T14:21:57.901Z"^^xsd:dateTime;
    skos:definition "A computer designed to process requests and deliver data to other computers over a network."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/SimCard> terms:created
      "2025-04-23T14:21:57.901Z"^^xsd:dateTime;
    skos:definition "A small card that stores subscriber information and allows a mobile device to connect to a cellular network."@en;
    skos:altLabel "SIM card"@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/System> terms:created
      "2025-04-23T14:21:57.901Z"^^xsd:dateTime;
    skos:definition "A set of interconnected components that work together to achieve a common goal."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ResourceInvestment>
    terms:created "2025-04-22T20:48:03.067Z"^^xsd:dateTime;
    skos:definition "Allocating financial and other resources to acquire, develop, or improve assets and capabilities."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CostPerAcquisition>
    terms:created "2025-04-23T14:29:10.297Z"^^xsd:dateTime;
    skos:definition "Also known as CPA, the average cost of acquiring a new customer."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/TotalCostOfOwnership>
    terms:created "2025-04-23T14:29:10.297Z"^^xsd:dateTime;
    skos:definition "Also known as TCO, the total cost of acquiring, owning and operating an asset over its entire lifecycle."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/RootBusinessEntities>
    terms:created "2025-06-23T17:12:27.405Z"^^xsd:dateTime;
    skos:definition "The core, high-level concepts in a business data model that are central to its operations, such as Customer, Product, or Order."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Association> terms:created
      "2025-06-23T17:12:27.405Z"^^xsd:dateTime;
    skos:definition "A relationship or link that connects two or more business entities or objects, describing how they interact."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/SalesOperations>
    terms:created "2025-04-22T20:44:37.444Z"^^xsd:dateTime;
    skos:definition "Activities that support the sales process, such as sales forecasting, lead generation and sales training."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/SalesForecasting>
    terms:created "2025-04-23T13:54:37.912Z"^^xsd:dateTime;
    skos:definition "Predicting future sales revenue based on historical data, market trends and other factors."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/SalesFunnel> terms:created
      "2025-04-23T13:54:37.912Z"^^xsd:dateTime;
    skos:definition "A visual representation of the stages a customer goes through from initial awareness to purchase."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/LeadGeneration>
    terms:created "2025-04-23T13:54:37.912Z"^^xsd:dateTime;
    skos:definition "Identifying and attracting potential customers."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/LeadQualification>
    terms:created "2025-04-23T13:54:37.912Z"^^xsd:dateTime;
    skos:definition "Identifying and qualifying potential customers who fit the ideal customer profile."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Opportunities> terms:created
      "2025-04-23T13:54:37.912Z"^^xsd:dateTime;
    skos:definition "Qualified leads that have a high potential for conversion into paying customers."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/OutboundProspecting>
    terms:created "2025-04-23T13:54:37.912Z"^^xsd:dateTime;
    skos:definition "Reaching out to potential customers who have not yet expressed interest in a company’s products or services."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/SalesOutlets> terms:created
      "2025-04-23T13:54:37.912Z"^^xsd:dateTime;
    skos:definition "Channels through which a company sells its products or services, such as retail stores, online marketplaces and direct sales forces."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/SalesStrategy> terms:created
      "2025-04-23T13:54:37.912Z"^^xsd:dateTime;
    skos:definition "A plan outlining how a company will achieve its sales goals, including target markets, sales channels and sales tactics."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CrossSelling> terms:created
      "2025-04-23T13:54:37.912Z"^^xsd:dateTime;
    skos:definition "Selling additional products or services to existing customers."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Upselling> terms:created
      "2025-04-23T13:54:37.912Z"^^xsd:dateTime;
    skos:definition "Encouraging customers to purchase a more expensive or feature-rich product or service than they initially intended."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/SalesPerformance>
    terms:created "2025-04-22T20:44:37.444Z"^^xsd:dateTime;
    skos:definition "Measuring and evaluating the effectiveness of a company’s sales efforts."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerGrowth>
    terms:created "2025-04-23T13:54:37.912Z"^^xsd:dateTime;
    skos:definition "Increasing the number of customers a company serves."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/AcquisitionRateConversion>
    terms:created "2025-04-23T13:54:37.912Z"^^xsd:dateTime;
    skos:definition "The percentage of potential customers who convert into paying customers."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/GrossAdds> terms:created
      "2025-04-23T13:54:37.912Z"^^xsd:dateTime;
    skos:definition "The total number of new customers acquired during a specific period."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/NetAdds> terms:created
      "2025-04-23T13:54:37.912Z"^^xsd:dateTime;
    skos:definition "The number of new customers remaining after deducting churned customers from gross adds."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Sales> terms:created
      "2025-04-23T13:54:37.912Z"^^xsd:dateTime;
    skos:definition "The revenue generated from the sale of products or services."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/AccessorySales>
    terms:created "2025-04-23T13:54:37.912Z"^^xsd:dateTime;
    skos:definition "Revenue generated from the sale of accessories related to a company’s core products, such as phone cases, chargers and headphones."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/DeviceSales> terms:created
      "2025-04-23T13:54:37.912Z"^^xsd:dateTime;
    skos:definition "Revenue generated from the sale of electronic devices, such as smartphones, tablets and laptops."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/GrossSales> terms:created
      "2025-04-23T13:54:37.912Z"^^xsd:dateTime;
    skos:definition "Total revenue generated from sales before deducting returns, discounts and allowances."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/NetSales> terms:created
      "2025-04-23T13:54:37.912Z"^^xsd:dateTime;
    skos:definition "Revenue remaining after deducting returns, discounts and allowances from gross sales."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ServiceSales> terms:created
      "2025-04-23T13:54:37.912Z"^^xsd:dateTime;
    skos:definition "Revenue generated from the sale of services, such as telecommunications, internet and cloud computing."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Upgrades> terms:created
      "2025-04-23T13:54:37.912Z"^^xsd:dateTime;
    skos:definition "Encouraging customers to upgrade to a newer or more advanced version of a product or service."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/DeviceUpgrades>
    terms:created "2025-04-23T13:54:37.912Z"^^xsd:dateTime;
    skos:definition "Revenue generated from upgrading to a newer model of a device, such as a smartphone or tablet."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/GrossUpgrades> terms:created
      "2025-04-23T13:54:37.912Z"^^xsd:dateTime;
    skos:definition "The total number of upgrades before deducting downgrades or cancellations."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/NetUpgrades> terms:created
      "2025-04-23T13:54:37.912Z"^^xsd:dateTime;
    skos:definition "The number of upgrades remaining after deducting downgrades or cancellations."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ServiceUpgrades>
    terms:created "2025-04-23T13:54:37.912Z"^^xsd:dateTime;
    skos:definition "Revenue generated from upgrading to a higher-tier service plan with more features or benefits."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ServiceActivation>
    terms:created "2025-04-22T20:48:03.067Z"^^xsd:dateTime;
    skos:definition "The process of activating a new service for a customer."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/FeaturePlans> terms:created
      "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Service plans that offer specific features or benefits, such as unlimited texting or international calling."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/InternationalCallingTravel>
    terms:created "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Options for making and receiving calls and using data while traveling internationally."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/PlanCompatibility>
    terms:created "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Ensuring that a device is compatible with a particular service plan."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/PlanRateAccess>
    terms:created "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "The pricing and terms of a service plan, including data allowances, speed limits and overage charges."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ServiceContract>
    terms:created "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "A formal agreement between a service provider and a customer that outlines the terms and conditions of service."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ServicePlan> terms:created
      "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "A specific package of services offered at a particular price, such as a mobile phone plan or an internet plan."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ConnectedDevicePlans>
    terms:created "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Service plans designed for connected devices, such as tablets, laptops and smartwatches."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/HomeInternetPlans>
    terms:created "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Service plans designed for home internet access, typically offering different speeds and data allowances. Includes 5G Home Internet, LTE Home Internet, All Access Home Internet"@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/SmartphonePlans>
    terms:created "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Service plans designed for smartphones, typically including voice calls, text messages and data."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ServiceAssurance>
    terms:created "2025-04-22T20:48:03.067Z"^^xsd:dateTime;
    skos:definition "Ensuring that services are delivered to customers at the agreed-upon quality and performance levels."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ServiceCapacity>
    terms:created "2025-06-23T17:12:27.405Z"^^xsd:dateTime;
    skos:definition "The maximum workload, throughput, or number of concurrent users/transactions a service can handle while still meeting its defined performance targets and quality levels. It involves ensuring that the service has sufficient resources to meet current and future demand predictably."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ServicePerformance>
    terms:created "2025-06-23T17:12:27.405Z"^^xsd:dateTime;
    skos:definition "Measures how effectively a service is delivering on its promised quality and functionality from a user perspective. It encompasses various metrics like response time, availability, reliability, and throughput, ensuring the service meets agreed-upon service level objectives (SLOs)."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ServiceAvailability>
    terms:created "2025-04-22T20:48:03.067Z"^^xsd:dateTime;
    skos:definition "The geographic areas where a service is offered and the quality of service available."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CoverageMaps> terms:created
      "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Maps that show the areas where a service provider offers coverage."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/NetworkOutages>
    terms:created "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Interruptions in service availability, often caused by technical issues or natural disasters."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/NetworkSpeed> terms:created
      "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "The speed at which data can be transmitted over a network, often measured in megabits per second (Mbps) or gigabits per second (Gbps)."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ServiceCatalog>
    terms:created "2025-06-23T17:03:58.838Z"^^xsd:dateTime;
    skos:definition "A structured repository that contains and organizes all network-related Service Specifications, including both abstract and resource-facing service definitions. It acts as the single source of truth for reusable, standard network service building blocks."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/AccessConnectivity>
    terms:created "2025-04-22T20:48:03.067Z"^^xsd:dateTime;
    skos:definition "Services that provide access to communication networks and the internet."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/BroadbandService>
    terms:created "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "High-speed internet access that provides a continuous connection to the internet."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CloudService> terms:created
      "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Services delivered over the internet, such as data storage, computing power and software applications."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/DataUsage> terms:created
      "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "The amount of data transmitted over a network, often measured in gigabytes (GB) or terabytes (TB)."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/MachineToMachine>
    terms:created "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Also known as M2M, Communication between devices without human intervention, often used in the Internet of Things (IoT)."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/MultimediaMessagingService>
    terms:created "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Also known as MMS, a service that allows users to send and receive multimedia messages, such as pictures, videos and audio files."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/NumberPorting> terms:created
      "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Also called porting, the process of transferring a phone number from one service provider to another."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/PayTv> terms:created
      "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Television services delivered through a paid subscription, such as cable TV and satellite TV."@en;
    skos:altLabel "Pay TV"@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/SmsService> terms:created
      "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Short Message Service (SMS), which allows users to send and receive text messages."@en;
    skos:altLabel "SMS service"@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/VoiceService> terms:created
      "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Traditional telephone services that allow users to make and receive voice calls."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/BusinessDigitalVoice>
    terms:created "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "A cloud-based phone system designed for businesses, offering features like VoIP calling, voicemail-to-email, and virtual extensions."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ApplicationsValueAddedServices>
    terms:created "2025-04-22T20:48:03.067Z"^^xsd:dateTime;
    skos:definition "Services that provide additional functionality or value beyond basic access and connectivity."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/BusinessSolutions>
    terms:created "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Services designed to meet the specific needs of businesses, such as cloud computing, data analytics and customer relationship management (CRM) software."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ConvenienceSupport>
    terms:created "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Services that make life easier for customers, such as online bill pay, technical support and customer service."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/WebBrowsing> terms:created
      "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Accessing and navigating websites on the internet."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/DigitalEntertainmentService>
    terms:created "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Services that provide digital entertainment content, such as streaming music, movies and TV shows."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/IptvService> terms:created
      "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Internet Protocol Television (IPTV) service, which delivers television programming over the internet, such as YouTube TV."@en;
    skos:altLabel "IPTV service"@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/MusicStreamingService>
    terms:created "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "A service that allows users to stream music over the internet, such as Spotify and Apple Music."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/FamilySafety> terms:created
      "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Services designed to enhance family communication and safety, such as parental controls and location-based services."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/EHealthService>
    terms:created "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Electronic health services, such as telemedicine, remote patient monitoring and online health information."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/FinancialServices>
    terms:created "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Services related to banking, investments and insurance."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/SecurityPrivacy>
    terms:created "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Services designed to protect user data and privacy, such as antivirus software, firewalls and virtual private networks (VPNs)."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/LocationBasedServices>
    terms:created "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Services that use a device’s location to provide relevant information or functionality, such as navigation apps and location-based advertising."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ServiceCessation>
    terms:created "2025-04-22T20:48:03.067Z"^^xsd:dateTime;
    skos:definition "The process of discontinuing a service for a customer."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/EarlyTerminationFees>
    terms:created "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Fees charged to customers who cancel their service contract before the end of the agreed-upon term."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ServiceConfiguration>
    terms:created "2025-04-22T20:48:03.067Z"^^xsd:dateTime;
    skos:definition "Setting up and customizing a service to meet a customer’s specific needs."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ServiceLevelAgreementManagement>
    terms:created "2025-04-22T20:48:03.067Z"^^xsd:dateTime;
    skos:definition "Defining, monitoring and reporting on service level agreements (SLAs) with customers."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ServiceLevelAgreement>
    terms:created "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "A formal agreement between a service provider and a customer that defines the level of service that will be provided."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ServiceLevelAgreementMonitoring>
    terms:created "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Tracking service performance against agreed-upon SLAs."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ServiceLevelAgreementReporting>
    terms:created "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "Providing regular reports to customers on service performance against SLAs."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ServiceProvisioning>
    terms:created "2025-04-22T20:48:03.067Z"^^xsd:dateTime;
    skos:definition "The process of creating and activating new services for customers, including setting up accounts, configuring services, and assigning resources."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ServiceSpecification>
    terms:created "2025-06-23T17:12:27.405Z"^^xsd:dateTime;
    skos:definition "Defines the detailed technical and functional description of a network-facing service within the telecom operator’s infrastructure. It acts as a blueprint for creating consistent and reusable service instances that deliver specific network capabilities, independent of any customer or commercial context."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ServiceUsage> terms:created
      "2025-04-22T20:48:03.067Z"^^xsd:dateTime;
    skos:definition "The amount of a service that a customer uses during a billing cycle."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/DslUsage> terms:created
      "2025-04-23T14:50:30.969Z"^^xsd:dateTime;
    skos:definition "The amount of data transmitted over a Digital Subscriber Line (DSL) connection."@en;
    skos:altLabel "DSL usage"@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Workflow> terms:created
      "2025-06-23T17:12:27.405Z"^^xsd:dateTime;
    skos:definition "A sequence of connected steps or tasks, often automated, that constitute a work process from initiation to completion."@en .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Account> skos:definition
      "A record of financial transactions, credits, and debits, or a formal business relationship with a customer or client."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Agreement> skos:definition
      "A formal understanding or arrangement between two or more parties, outlining mutual obligations and terms."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Commitment> skos:definition
      "A pledge or obligation to undertake a future action or to adhere to a specific course of conduct."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Anomaly> skos:definition
      "A deviation from what is standard, normal, or expected; an irregularity or outlier in a dataset or process."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/BaseTypes> skos:definition
      "The fundamental data types (e.g., string, integer, boolean) from which more complex data structures are built in a data model."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/BusinessInteraction>
    skos:definition "An instance of communication or activity between two or more business parties, or between a business and a system."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/BusinessTaxonomy>
    skos:definition "The business taxonomy categorizes and organizes data content that is to be used in the organization's Data Marketplace to enable a more intuitive user experience for browse & discovery"@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/BusinessTaxonomyFilters>
    skos:definition "Standardized criteria, attributes, and controlled vocabulary terms derived from an organization's business taxonomy that are applied to search engines, catalogs, reporting tools, and content repositories to narrow down, partition, and retrieve information assets according to validated business concepts rather than arbitrary keywords or raw database schemas."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/AllowedGlobalAccess>
    skos:definition "Describes whether or not the Marketplace content is allowed to be viewed outside the United States."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ApplicableHubSpoke>
    skos:definition "Describes the business spoke to which Marketplace content is related."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/BillingSegment>
    skos:definition "Describes the billing status of a customer's connection as relates to Marketplace content."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CareChannel> skos:definition
      "Describes the customer care segments to which Marketplace content is related."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Categorization>
    skos:definition "Information and digital assets must be classified according to the organization's information security needs, based on confidentiality, integrity, availability, and relevant interested party requirements."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/MarketplaceContentType>
    skos:definition "Describes the type of Marketplace content."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/TaxonomyBreadcrumb>
    skos:definition "Inferred from assigned taxonomy node which shows the content hierarchy."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerSegment>
    skos:definition "Describes the portion of the customer population to which Marketplace content is related."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Governance> skos:definition
      "The holistic system of decision rights, policies, standards, and accountability frameworks that oversees how raw data is collected and managed, how semantic meaning and relationships are standardized, how analytical insights are derived, and how artificial intelligence models are developed and deployed—ensuring compliance, ethical alignment, operational trustworthiness, and business value across the entire intelligence lifecycle."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CertificationLevel>
    skos:definition "Describes the current governance certification level of Marketplace content and is an important process within governance that can help establish controls that will enable accuracy and reliability."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Status> skos:definition
      "A discrete, standardized state attribute that records an asset’s current condition, operational readiness, legal entitlement, or regulatory standing at a specific point within its cradle-to-grave continuum—serving as the formal trigger for governing transitions, access rights, accounting treatments, and maintenance actions"@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/MetricReportingScope>
    skos:definition "Indicates if the metric is reported internally within the organization, externally from the organization, or both."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Ownership> skos:definition
      "The recognized right and practical capability to exercise exclusive control over a digital asset—including the powers to access, use, derive economic benefit from, restrict others from accessing, and irrevocably transfer or dispose of that asset—either through legal title (contractual and intellectual property rights) or cryptographic control (possession of private keys and ledger state authority)."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Owner> skos:definition
      "Describes the high-level owner of Marketplace content and to whom questions about Marketplace content can be directed."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/AccountableExecutiveSponsor>
    skos:definition "An executive who is ultimately accountable for the metric. This person drives cross-domain coordination of strategies, provides an escalation path for the Metric Champion, and ensures data strategy is aligned to business strategy (typically a VP or above)."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/BusinessProcessOwner>
    skos:definition "The customer of data products. There could be more than one customer for a particular product – but there needs to be at least one."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ConsultedBusinessMetricStewards>
    skos:definition "The Business Metric Stewards who represent the spokes who do not own this metric, but are to be consulted regarding it."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ConsultedSpoke>
    skos:definition "The spoke teams who represent the spokes who do not own this metric, but are to be consulted regarding it."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ConsultedTechnicalMetricStewards>
    skos:definition "The Technical Metric Stewards who represent the spokes who do not own this metric, but are to be consulted regarding it."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/DataArchitect> skos:definition
      "Ensures solution aligns with overall technical vision, product architecture fits together."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/DataProductAnalyst>
    skos:definition "Data products must have this role which develops analysis and provide technical product requirements as needed. They deeply understand the data, its use-cases and its business context."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/DataProductGovernance>
    skos:definition "Ensures product is not redundant, confirms compliance with governance standards, certifies product"@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/DataProductOwner>
    skos:definition "Data products must have this role which provides solutions to the needs of business process owners. They are the single point of contact for the business process owner. They are accountable for establishing the overall feature roadmap, including the prioritization and initial feature sequencing, for understanding the technical challenges necessary for developing that roadmap, ensuring the product meets their customers’ needs, identifying new use cases for the product, etc."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/DataScientist> skos:definition
      "Data products may have this role which develops reusable production ML models. They’re responsible for model creation, model performance, and model refresh/rebuild."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/MachineLearningEngineer>
    skos:definition "Data products may have this role which develops production ML model scoring pipelines. They’re responsible for scoring pipeline, model API, and model monitoring."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ProductGroupCoordinator>
    skos:definition "Scrum-master-in-chief; same role as a scrum master, for a group of products. Does not interact with customers or translate business needs."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ResponsibleBusinessMetricStewards>
    skos:definition "This role fully understands the business context of the metric and very often comes up with the need for the metric, defines and manages the business definition, objectives and purpose of the metric, provides business formula for the calculation of the metric in simple understandable language, manages & approves all business decisions related to the metric, and is responsible for ongoing maintenance of business metadata of the metric."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ResponsibleBusinessReportStewards>
    skos:definition "This role fully understands the business context of the report and very often comes up with the need for the report, defines and manages the business definition, objectives and purpose of the report, manages & approves all business decisions related to the report, and is responsible for ongoing maintenance of business metadata of the report."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ResponsibleMetricChampion>
    skos:definition "A leader who is responsible for the overall strategy regarding the metric (typically a Sr. Director or above)."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ResponsibleTechnicalMetricStewards>
    skos:definition "This role not only understands the business context, objectives and purpose of the metric, but is also responsible for defining the technical details of metric calculations. This individual is responsible for understanding and defining one or many of the following details: how a metric should be calculated, which are the best data sources for pulling the data for calculations, what additional calculations need to be made in order to report the metric (Report/Dashboard etc.). This person approves all decisions that affect the data used in calculating a metric."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ResponsibleTechnicalReportStewards>
    skos:definition "This role not only understands the business context, objectives and purpose of the report, but is also responsible for defining the technical details of the report. This individual is responsible for understanding and defining many report details."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ScrumMaster> skos:definition
      "Data products may have this role which enables a team's delivery across sprints. They manage sprint planning/iteration, facilitate daily standups, administrate the team's board, and capture retrospective opportunities."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/SolutionLeader>
    skos:definition "Data products must have this role which is the delivery owner for the data product. They define the product's technical vision and own the in-depth delivery of the product's technical solution and are responsible for the product's technical performance. They confirm that the correct skills are present for technical delivery, and work to resolve gaps."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ResponsibleHubSpoke>
    skos:definition "Describes which business spoke is ultimately responsible for the publication of Marketplace content."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/RegulatoryClassification>
    skos:definition "Describes the Cybersecurity aligned specified data categories that assign classifications for Marketplace content based on applicable security controls and relevant regulations."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/SalesChannel> skos:definition
      "Describes the traditional the organization derived sales groupings to which Marketplace content is related."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ServiceType> skos:definition
      "Describes the traditional the organization business service areas to which Marketplace content is related."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Calendar> skos:definition
      "A system for organizing and scheduling events, appointments, and tasks for a party."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Catalog> skos:definition
      "A structured and organized collection of items, products, or services, including their descriptive information."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ClosedLoop> skos:definition
      "A process or system in which the output is used to modify the input in a continuous cycle of feedback and adjustment."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CommunicationInteraction>
    skos:definition "An instance of communication or engagement between two or more parties."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerAccountManagement>
    skos:definition "Managing customer accounts, including account creation, profile updates and account closures."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerAccountActivations>
    skos:definition "Activating new customer accounts and services."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerAccountCancellations>
    skos:definition "Processing customer requests to cancel accounts or services."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerAccountClosureRetention>
    skos:definition "Managing the process of closing customer accounts, including handling outstanding balances and attempting to retain customers if possible."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerAccountCreationOnboarding>
    skos:definition "The process of creating new customer accounts and guiding customers through the initial setup and onboarding process."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerProfileManagement>
    skos:definition "Maintaining accurate and up-to-date customer profiles, including contact information, preferences and purchase history."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerSubscriptionsEntitlements>
    skos:definition "Managing customer subscriptions to services and ensuring customers have access to the appropriate features and benefits."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerAcquisitionConversion>
    skos:definition "Attracting new customers and converting them into paying customers."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerAcquisitionCost>
    skos:definition "The average expense incurred to acquire a new customer."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerConversion>
    skos:definition "The process of turning a potential customer into a paying customer."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerBehavioralData>
    skos:definition "Information collected about customer actions and interactions, such as website browsing history, purchase history and app usage."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerExperience>
    skos:definition "Evaluating and optimizing the overall experience customers have when interacting with a company through all service channels & touchpoints."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerPlanRecommendationsChanges>
    skos:definition "The process of analyzing a customer’s current service plan and usage patterns to recommend more suitable or cost-effective plans, and then implementing any desired changes."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerProductFeatureUsage>
    skos:definition "Understanding how customers use your products or services, including frequency, features used and pain points."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerUsage> skos:definition
      "Understanding how customers use your products or services, including frequency, features used and pain points over time, which is used for rating, billing, usage analytics, and customer profiling."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/DigitalExperience>
    skos:definition "Evaluating and optimizing the overall experience customers have when interacting with a company through digital channels."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerCareCallCenter>
    skos:definition "Providing support and assistance to customers through phone calls, emails and other channels."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ContactCenterPerformance>
    skos:definition "Measuring the effectiveness and efficiency of the call center in handling customer interactions."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/AgentAvailability>
    skos:definition "Ensuring sufficient staffing levels to handle incoming customer contacts promptly."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/AgentPerformance>
    skos:definition "Evaluating the performance of individual agents based on metrics such as call resolution rate, customer satisfaction and adherence to procedures."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/AgentProductivity>
    skos:definition "Measuring the output and efficiency of individual call center agents."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/AverageHandlingTime>
    skos:definition "The average duration of a customer interaction with a call center agent."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ConversationHandling>
    skos:definition "Analyzing the flow and effectiveness of conversations between agents and customers."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerCaseResolution>
    skos:definition "Tracking the timeliness and effectiveness of resolving customer issues."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerCaseResolutionTimeEfficiency>
    skos:definition "Measures of how effectively resources are used to resolve customer cases, often considering factors like resolution time, first contact resolution rate, and customer satisfaction."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerCaseVolumeHandling>
    skos:definition "The total number of customer cases (issues, complaints, requests) received within a specific timeframe and the processes and procedures used to manage and resolve customer cases efficiently and effectively."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/MessagingPerformance>
    skos:definition "Evaluating the effectiveness of messaging channels, such as live chat and email, in handling customer interactions."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/OverallPerformance>
    skos:definition "Assessing the overall effectiveness of the contact center in meeting customer needs and business objectives."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/SentimentGuidance>
    skos:definition "Using technology to analyze customer sentiment during interactions and provide guidance to agents."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerCall> skos:definition
      "Incoming and outgoing phone calls from customers seeking assistance or information."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CallInRates> skos:definition
      "Tracking the volume of incoming calls to the call center."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CallRoutingQueuing>
    skos:definition "Directing customer calls to the appropriate agents or departments and managing call queues."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CallVolume> skos:definition
      "The total number of calls received by a call center or customer service department within a specific timeframe."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/FirstCallResolution>
    skos:definition "Resolving customer issues on the first contact to improve customer satisfaction."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerContact>
    skos:definition "Any interaction between a customer and a company, regardless of the channel used."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/InteractionFrequencyDuration>
    skos:definition "Analyzing the frequency and length of customer interactions to identify patterns and areas for improvement."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerIncident>
    skos:definition "A reported issue or problem experienced by a customer."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CaseBreakdown> skos:definition
      "Categorizing and analyzing customer incidents to identify common issues and trends."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerIssue> skos:definition
      "A specific problem or challenge faced by a customer."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerProblem>
    skos:definition "A general term for any issue a customer may encounter."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerProblemReport>
    skos:definition "A formal record of a customer issue, including details about the problem and any steps taken to resolve it."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerTroubleTicket>
    skos:definition "A digital or physical record created to document and track a customer’s reported issue or service request until it is resolved."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerRequest>
    skos:definition "A specific ask or inquiry from a customer."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerChurn> skos:definition
      "The rate at which customers stop doing business with a company."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ChurnPrediction>
    skos:definition "Identifying customers at risk of churning"@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ChurnPrevention>
    skos:definition "Developing strategies to retain customers at risk of churning."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ModelScoring> skos:definition
      "Evaluating the accuracy and effectiveness of predictive models, including scores, churn propensities, purchasing propensities and product recommendations used for further analytical reporting"@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerFeedback>
    skos:definition "Information provided by customers about their experiences with a company’s products, services, or brand."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerComplaints>
    skos:definition "Expressions of dissatisfaction and related troubleshooting from customers regarding a product, service, or interaction."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerEffortScore>
    skos:definition "Assessing how easy it is for customers to interact with your business."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerFeatureFeedback>
    skos:definition "Input from customers regarding desired product features or improvements."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerSurvey>
    skos:definition "A structured questionnaire used to gather quantitative and qualitative feedback from customers."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerAfterCallSurvey>
    skos:definition "A short survey presented to customers after a call with customer service, typically used to gauge customer satisfaction and identify areas for improvement."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerInteractionEngagement>
    skos:definition "Activities and communications that foster relationships and encourage ongoing interaction with customers."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerActivity>
    skos:definition "Activity that pertains to a specific customer"@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerSupportInteractions>
    skos:definition "Analyzing interactions between customers and support agents to identify trends and areas for improvement."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerToCustomerInteractions>
    skos:definition "Facilitating and encouraging communication and collaboration among customers."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/DigitalInteractions>
    skos:definition "Engaging with customers through digital channels, such as email, chatbots and mobile apps."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/OnlineReviews> skos:definition
      "Monitoring and responding to customer reviews posted on websites and platforms."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/SalesInteractions>
    skos:definition "Managing interactions between sales representatives and customers throughout the sales process."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/SocialMediaMonitoring>
    skos:definition "Tracking brand mentions and conversations about a company on social media platforms."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerJourney>
    skos:definition "The complete experience a customer has with a company, from initial awareness to post-purchase interactions."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/Authentication>
    skos:definition "Verifying a customer’s identity to grant access to accounts or services."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerJourneyCompletion>
    skos:definition "Successfully guiding a customer through their desired interaction or transaction."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerJourneyResolution>
    skos:definition "Addressing and resolving any issues or challenges a customer encounters during their journey."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerTouchpoints>
    skos:definition "Specific interactions a customer has the organization facing processes either digitally or external communications or internal interactions."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerProfile>
    skos:definition "Defines the Customer Profile type information"@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerProfileDemographics>
    skos:definition "Basic characteristics of a customer, such as age, gender, location and socioeconomic status."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerProfilePersonalization>
    skos:definition "Using customer data to create customized experiences and communications."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerProfileSegmentation>
    skos:definition "Dividing customers into groups based on shared characteristics to tailor marketing and service efforts."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerReferral>
    skos:definition "A recommendation from a satisfied customer that encourages others to engage with a company."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerTestimonial>
    skos:definition "A positive statement from a customer about their experience with a company’s products or services."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/InfluencerMarketing>
    skos:definition "Partnering with individuals with a strong online presence to promote products or services to their followers."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/ReferralProgramData>
    skos:definition "Tracking and analyzing the effectiveness of customer referral programs."@en;
    owl:versionInfo "0.1.0" .
  
  <https://www.insperity.com/taxonomy/application-business-taxonomy/CustomerRetentionGrowth>
