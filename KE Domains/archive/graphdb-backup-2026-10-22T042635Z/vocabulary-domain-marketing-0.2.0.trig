  <https://www.insperity.com/vocabulary/domain-marketing/> a skos:ConceptScheme;
    rdfs:label "Domain Marketing Vocabulary"@en;
    skos:prefLabel "Domain Marketing Vocabulary"@en;
    skos:hasTopConcept marketingvoc:search-engine-optimization, marketingvoc:alternative,
      marketingvoc:audience, marketingvoc:awareness, marketingvoc:battlecard, marketingvoc:campaign,
      marketingvoc:case-study, marketingvoc:demand, marketingvoc:differentiator, marketingvoc:displacement,
      marketingvoc:email, marketingvoc:firmographics, marketingvoc:funnel, marketingvoc:generation,
      marketingvoc:impression, marketingvoc:intelligence, marketingvoc:intent, marketingvoc:interview,
      marketingvoc:landscape, marketingvoc:nurturing, marketingvoc:positioning, marketingvoc:profile,
      marketingvoc:public-relations, marketingvoc:research, marketingvoc:share, marketingvoc:social-media,
      marketingvoc:status-quo, marketingvoc:strength, marketingvoc:strengths-weaknesses-opportunities-and-threats-analysis,
      marketingvoc:threat, marketingvoc:touchpoint, marketingvoc:trade-show, marketingvoc:weakness,
      marketingvoc:webinar;
    skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en;
    terms:description "A controlled vocabulary of the primitives of marketing professional employer organization services, including competitive intelligence: campaigns, audiences, funnels, positioning, demand, intent, and the intelligence, battlecards, landscapes and alternatives used to compete."@en;
    terms:title "Domain Marketing Vocabulary"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_marketing.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.1.1 (2026-10-20): Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_marketing.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.2.0 (2026-10-21): Restructured to the operational areas and the naming standard (D26, D27): titled 'Domain Marketing Vocabulary', '… Taxonomy', '… Ontology' and '… Shapes'; imports the Commercial Operations ontology at its new IRI. Built by build_domains.py from spec_marketing.py against Baseline Core v1.0 (core 0.1.0)."@en;
    terms:created "2026-10-22"^^xsd:date;
    owl:versionInfo "0.2.0";
    terms:subject domainvoc:marketing;
    terms:isPartOf <https://www.insperity.com/vocabulary/commercial-operations/>;
    owl:versionIRI <https://www.insperity.com/vocabulary/domain-marketing/0.2.0/>;
    vaem:namespace "https://www.insperity.com/vocabulary/domain-marketing/"^^xsd:anyURI;
