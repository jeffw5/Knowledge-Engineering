  dct:created "2026-10-16T23:03:55Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T23:03:55Z"^^xsd:dateTime .

tax:software-asset
  a skos:Concept ;
  skos:prefLabel "Software asset"@en ;
  skos:altLabel "Digital system"@en , "Software"@en ;
  skos:definition "An asset that is a set of executable instructions or a trained model that performs computation."@en ;
  skos:scopeNote "The deployed software is an asset; an artificial intelligence agent acting in a process is classified as an automated agent in the party taxonomy."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core/> ;
  skos:topConceptOf <https://www.insperity.com/taxonomy/core/> ;
  skos:narrower tax:application ,
      tax:application-programming-interface ,
      tax:data-store ,
      tax:machine-learning-model ,
      tax:software-component ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-16T23:03:55Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T23:03:55Z"^^xsd:dateTime .

tax:software-component
  a skos:Concept ;
  skos:prefLabel "Software component"@en ;
  skos:altLabel "Library"@en , "Microservice"@en ;
  skos:definition "A software asset that is a deployable unit of code providing a defined function to other software."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core/> ;
  skos:broader tax:software-asset ;
  dc:subject tax:software-component ;
  owl:versionInfo "0.1.0" ;
