<https://www.insperity.com/vocabulary/domain-sales/> {
  <https://www.insperity.com/vocabulary/domain-sales/> a skos:ConceptScheme;
    rdfs:label "Sales domain vocabulary"@en;
    skos:prefLabel "Sales domain vocabulary"@en;
    skos:hasTopConcept salesvoc:quota, salesvoc:champion, salesvoc:decision-maker, salesvoc:gatekeeper,
      salesvoc:cycle, salesvoc:cadence, salesvoc:booking, salesvoc:demonstration, salesvoc:objection,
      salesvoc:outreach, salesvoc:prospecting, salesvoc:collection, salesvoc:comparison;
    skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en;
    terms:description "A controlled vocabulary of the primitives of selling professional employer organization services: quotas, prospecting and outreach, the roles in a buying committee, objections, demonstrations and bookings."@en;
    terms:title "Sales domain vocabulary"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_sales.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.2.0 (2026-10-20): Sales services: the Sales service class and taxonomy branch, and the step and record kinds the first service graphs are assembled from (total cost of employment analysis, benefits comparison). Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_sales.py against Baseline Core v1.0 (core 0.1.0)."@en;
    terms:created "2026-10-20"^^xsd:date;
    owl:versionInfo "0.2.0";
    terms:subject domainvoc:sales;
    terms:isPartOf <https://www.insperity.com/domain/commercial-operations/>;
    owl:versionIRI <https://www.insperity.com/vocabulary/domain-sales/0.2.0/>;
    vaem:namespace "https://www.insperity.com/vocabulary/domain-sales/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft;
    vann:preferredNamespacePrefix "salesvoc";
    terms:publisher <https://www.insperity.com/resource/core/Organization/insperity>;
    terms:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/>;
    terms:identifier "vocabulary-domain-sales" .
  
  salesvoc:quota a skos:Concept;
    rdfs:label "quota"@en;
    skos:prefLabel "quota"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A target, assigned to a party or territory for a period, for the sales it is expected to achieve."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-sales/>;
    owl:versionInfo "0.2.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-sales/> .
  
  salesvoc:champion a skos:Concept;
    rdfs:label "champion"@en;
    skos:prefLabel "champion"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A role borne by a person at a buyer who advocates internally for the organization's offering."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-sales/>;
    owl:versionInfo "0.2.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-sales/> .
  
  salesvoc:decision-maker a skos:Concept;
    rdfs:label "decision maker"@en;
    skos:prefLabel "decision maker"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A role borne by a person with the authority to commit the buyer to an agreement."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-sales/>;
    skos:scopeNote "A multiword lexical unit (Baseline decision 3)."@en;
    owl:versionInfo "0.2.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-sales/> .
  
  salesvoc:gatekeeper a skos:Concept;
    rdfs:label "gatekeeper"@en;
    skos:prefLabel "gatekeeper"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A role borne by a person at a buyer who controls access to the people who decide."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-sales/>;
    owl:versionInfo "0.2.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-sales/> .
  
  salesvoc:cycle a skos:Concept;
    rdfs:label "cycle"@en;
    skos:prefLabel "cycle"@en;
    skos:editorialNote "Candidate for promotion to the core: General primitive missing from the core (core-lifecycle holds only \"lifecycle\")."@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A series of stages that repeats or that runs from a defined start to a defined end."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-sales/>;
    owl:versionInfo "0.2.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-sales/> .
  
  salesvoc:cadence a skos:Concept;
    rdfs:label "cadence"@en;
    skos:prefLabel "cadence"@en;
