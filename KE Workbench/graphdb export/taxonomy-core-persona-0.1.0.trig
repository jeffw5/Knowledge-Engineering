<https://www.insperity.com/taxonomy/core-persona/> {
  <https://www.insperity.com/taxonomy/core-persona/> a owl:Ontology;
    rdfs:label "Core persona taxonomy"@en;
    terms:description "The persona taxonomy categorizes data types used to understand individual users and work together to create comprehensive user profiles for personalized experiences."@en;
    terms:title "Core persona taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2024-09-05T00:04:05.311Z"^^xsd:dateTime;
    skos:altLabel "Taxonomy | Core | Persona"@en;
    owl:versionInfo "0.1.0";
    owl:versionIRI <https://www.insperity.com/taxonomy/core-persona/0.1.0/>;
    vann:preferredNamespaceUri "https://www.insperity.com/taxonomy/core-persona/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  personatax:Persona a owl:Class;
    rdfs:label "Persona"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-persona/>;
    skos:prefLabel "Persona"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2024-09-05T00:05:56.430Z"^^xsd:dateTime;
    skos:definition "A semi-fictional representation of your ideal customer, based on research and data about existing and potential customers."@en;
    owl:versionInfo "0.1.0";
    dc:subject personavoc:persona;
    core:hasLifecycleStatus core:Draft .
  
  personatax:PersonaData a owl:Class;
