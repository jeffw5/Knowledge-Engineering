  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-19"^^xsd:date ;
  dct:modified "2026-10-19T02:19:17Z"^^xsd:dateTime .

core:Control
  a owl:Class ;
  rdfs:label "Control"@en ;
  skos:prefLabel "Control"@en ;
  skos:definition "A directive that specifies a check or safeguard applied in a process step to keep a risk or an obligation within accepted limits."@en ;
  rdfs:subClassOf core:Directive ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/core/> ;
