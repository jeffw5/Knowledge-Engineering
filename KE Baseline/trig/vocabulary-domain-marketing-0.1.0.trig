  voc:brand-identity
    a skos:Concept ;
    skos:prefLabel "Brand identity"@en ;
    skos:definition "The visual and verbal elements that distinguish a brand from its competitors."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
    skos:broader voc:brand-management ;
    owl:versionInfo "0.1.0" ;
