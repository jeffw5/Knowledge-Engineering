shp:AnalyticProductShape
  a sh:NodeShape ;
  rdfs:label "Analytic product shape"@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/core-asset/> ;
  sh:targetClass asset:AnalyticProduct ;
  sh:property [
      sh:path core:enables ;
      sh:class valuestreamtax:DataAnalyticsInsights
  ] ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
