<https://www.insperity.com/taxonomy/core-role/> {
  <https://www.insperity.com/taxonomy/core-role/> a skos:ConceptScheme;
    rdfs:label "Core role taxonomy"@en;
    skos:prefLabel "Core role taxonomy"@en;
    skos:hasTopConcept roletax:agreement-party-role, roletax:commercial-role, roletax:employment-role,
      roletax:governance-role, roletax:knowledge-engineering-role, roletax:plan-role, roletax:responsibility-role;
    terms:description "Classification of roles, the positions or functions a party bears because of its situation and that are realized when it takes part in process steps."@en;
    terms:title "Core role taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2026-10-14"^^xsd:dateTime;
    skos:altLabel "Role taxonomy"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/taxonomy/core-role/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  roletax:agreement-party-role a skos:Concept;
    skos:prefLabel "Agreement party role"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A role borne by a party because it is a signatory to or named in an agreement."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-role/>;
    skos:altLabel "Contracting party"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-role/>;
    skos:narrower roletax:guarantor, roletax:principal, roletax:representative .
  
  roletax:commercial-role a skos:Concept;
    skos:prefLabel "Commercial role"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A role that arises from a commercial relationship or agreement."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-role/>;
    skos:altLabel "Business relationship role"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-role/>;
    skos:narrower roletax:broker, roletax:supplier, roletax:client, roletax:partner, roletax:prospect .
  
  roletax:employment-role a skos:Concept;
    skos:prefLabel "Employment role"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A role that arises from an employment relationship between a worker and an employer."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-role/>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-role/>;
    skos:narrower roletax:employer, roletax:worker, roletax:executive, roletax:manager .
  
  roletax:governance-role a skos:Concept;
    skos:prefLabel "Governance role"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A role that carries authority or duty for the oversight of policies, data, knowledge, or controls."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-role/>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-role/>;
    skos:narrower roletax:auditor, roletax:change-reviewer, roletax:custodian, roletax:owner,
      roletax:regulator, roletax:steward .
  
  roletax:knowledge-engineering-role a skos:Concept;
    skos:prefLabel "Knowledge engineering role"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A role that builds, reviews, or maintains governed knowledge artifacts."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-role/>;
    skos:altLabel "Design-time role"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-role/>;
    skos:narrower roletax:drafting-assistant, roletax:knowledge-engineer, roletax:subject-matter-expert .
  
  roletax:plan-role a skos:Concept;
    skos:prefLabel "Plan role"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A role that arises from participation in a benefit, retirement, or insurance plan."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-role/>;
    skos:altLabel "Benefit plan role"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-role/>;
    skos:narrower roletax:beneficiary, roletax:dependent, roletax:plan-administrator,
      roletax:plan-participant, roletax:plan-sponsor .
  
  roletax:responsibility-role a skos:Concept;
    skos:prefLabel "Responsibility role"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A role that defines the kind of responsibility a party has for a process step or decision."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-role/>;
    skos:altLabel "RACI role"@en, "Responsibility assignment"@en;
    skos:scopeNote "Used to qualify performedBy and approvedBy."@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-role/>;
    skos:narrower roletax:accountable-role, roletax:consulted-role, roletax:informed-role,
      roletax:responsible-role .
  
  roletax:accountable-role a skos:Concept;
    skos:prefLabel "Accountable role"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A responsibility role borne by the party that answers for the outcome and approves the work."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-role/>;
    skos:broader roletax:responsibility-role;
    skos:altLabel "Accountable"@en, "Approver"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  roletax:guarantor a skos:Concept;
    skos:prefLabel "Guarantor"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An agreement party role borne by a party that promises to meet another party's obligation if it defaults."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-role/>;
    skos:broader roletax:agreement-party-role;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  roletax:principal a skos:Concept;
    skos:prefLabel "Principal"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An agreement party role borne by the party on whose behalf an agreement is made or an action taken."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-role/>;
    skos:broader roletax:agreement-party-role;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  roletax:representative a skos:Concept;
    skos:prefLabel "Representative"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An agreement party role borne by a party authorized to act for another."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-role/>;
    skos:broader roletax:agreement-party-role;
    skos:altLabel "Agent"@en, "Authorized representative"@en, "Legal representative"@en;
    owl:versionInfo "0.1.0";
    dc:subject domainsecurityvoc:agent;
    core:hasLifecycleStatus core:Draft .
  
  roletax:auditor a skos:Concept;
    skos:prefLabel "Auditor"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A governance role borne by a party who independently examines records and controls."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-role/>;
    skos:broader roletax:governance-role;
    skos:altLabel "External auditor"@en, "Internal auditor"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  roletax:beneficiary a skos:Concept;
    skos:prefLabel "Beneficiary"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A plan role borne by a party designated to receive a benefit on a participant's death."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-role/>;
    skos:broader roletax:plan-role;
    skos:altLabel "Designated beneficiary"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  roletax:broker a skos:Concept;
    skos:prefLabel "Broker"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A commercial role borne by a party that arranges agreements between other parties for a commission or fee."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-role/>;
    skos:broader roletax:commercial-role;
    skos:altLabel "Agent of record"@en, "Intermediary"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  roletax:carrier a skos:Concept;
    skos:prefLabel "Carrier"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A supplier that underwrites and pays insurance benefits."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-role/>;
    skos:broader roletax:supplier;
    skos:altLabel "Insurance carrier"@en, "Insurer"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  roletax:supplier a skos:Concept;
    skos:prefLabel "Supplier"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A commercial role borne by a party that provides goods or services to the organization."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-role/>;
    skos:broader roletax:commercial-role;
    skos:altLabel "Vendor"@en, "Provider"@en;
    owl:versionInfo "0.1.0";
    dc:subject rolevoc:provider;
    core:hasLifecycleStatus core:Draft;
    skos:narrower roletax:carrier .
  
  roletax:change-reviewer a skos:Concept;
    skos:prefLabel "Change reviewer"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A governance role borne by the party who approves changes before they enter source control and release."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-role/>;
    skos:broader roletax:governance-role;
    skos:altLabel "Approver of record"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  roletax:client a skos:Concept;
    skos:prefLabel "Client"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A commercial role borne by a party that purchases services from the organization under an agreement."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-role/>;
    skos:broader roletax:commercial-role;
    skos:altLabel "Customer"@en, "Client company"@en;
    owl:versionInfo "0.1.0";
    dc:subject rolevoc:customer;
    core:hasLifecycleStatus core:Draft .
  
  roletax:client-employer a skos:Concept;
    skos:prefLabel "Client employer"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An employer that is a client of a co-employer and directs the day-to-day work of worksite employees."@en;
