  voc:brand-leadership
    a skos:Concept ;
    skos:prefLabel "Brand leadership"@en ;
    skos:definition "The position of a brand that dominates its market category in terms of market share, customer loyalty, and brand equity."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
    skos:broader voc:brand-management ;
    owl:versionInfo "0.1.0" ;
