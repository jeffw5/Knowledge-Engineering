voc:location
  a skos:Concept ;
  skos:prefLabel "Location"@en ;
  skos:definition "Data representing the site or position of something (e.g., customer address, equipment site) using coordinates, addresses, or physical representations."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
