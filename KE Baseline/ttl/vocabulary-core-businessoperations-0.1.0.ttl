  dct:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:strengths-weaknesses-opportunities-and-threats-analysis
  a skos:Concept ;
  skos:prefLabel "Strengths, weaknesses, opportunities and threats analysis"@en ;
  skos:altLabel "SWOT analysis"@en ,
      "Strengths Weaknesses Opportunities Threats Analysis"@en ;
  skos:definition "A planning tool used to analyze an organization’s strengths, weaknesses, opportunities, and threats."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/> ;
  skos:broader voc:strategy ;
  skos:narrower voc:external-analysis , voc:internal-analysis , voc:strategic-fit ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:external-analysis
  a skos:Concept ;
  skos:prefLabel "External analysis"@en ;
  skos:definition "Analyzing the external environment to identify opportunities and threats."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/> ;
  skos:broader voc:strengths-weaknesses-opportunities-and-threats-analysis ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:internal-analysis
  a skos:Concept ;
  skos:prefLabel "Internal analysis"@en ;
  skos:definition "Analyzing an organization’s internal environment to identify strengths and weaknesses."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/> ;
  skos:broader voc:strengths-weaknesses-opportunities-and-threats-analysis ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:strategic-fit
  a skos:Concept ;
  skos:prefLabel "Strategic fit"@en ;
  skos:definition "The degree to which an organization’s resources and capabilities align with its external environment."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/> ;
  skos:broader voc:strengths-weaknesses-opportunities-and-threats-analysis ;
