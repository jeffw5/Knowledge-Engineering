  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:interactions
  a skos:Concept ;
  skos:prefLabel "Interactions"@en ;
  skos:altLabel "Customer Interactions"@en ;
  skos:definition "The data record of communications with customers and the technical translation of those communications into system events (e.g., orders, inquiries, problems)."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:customer-experience ;
