voc:threat-management
  a skos:Concept ;
  skos:prefLabel "Threat management"@en ;
  skos:definition "A comprehensive process that encompasses identifying, assessing, and responding to potential threats, using various strategies and techniques to mitigate risks and protect organizations or individuals."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-technicalservices/> ;
  skos:broader voc:security-management ;
  skos:narrower voc:investigation ,
      voc:mitigation ,
      voc:monitoring ,
      voc:prevention ,
      voc:training ;
  owl:versionInfo "0.1.0" ;
