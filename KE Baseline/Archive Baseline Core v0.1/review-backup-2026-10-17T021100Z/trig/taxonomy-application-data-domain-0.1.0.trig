  tax:CustomerCore
    a owl:Class ;
    rdfs:label "Customer core"@en ;
    skos:prefLabel "Customer core"@en ;
    skos:definition "Customer Core represents the foundational data and management structures related to the customer's identity, contractual agreements, billing, usage, payment, and collection activities. It focuses on the customer's official profile, financial status, service entitlements, and operational records critical for enabling and sustaining service delivery. This includes: • Customer Profile Management • Account and Contract Management • Billing and Charging Information • Usage and Consumption Tracking • Credit Management and Collections • Customer Analytics & Performance KPI"@en ;
    rdfs:subClassOf tax:DataDomain ;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/application-data-domain/> ;
    dc:subject applicationdatadomainvoc:customer-core ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime ;
    dct:modified "2026-10-17T01:38:18Z"^^xsd:dateTime .

  tax:Billing
    a owl:Class ;
    rdfs:label "Billing"@en ;
    skos:prefLabel "Billing"@en ;
    skos:definition "Billing encompasses all aspects of customer invoicing and account management. This includes: Rate Application: Managing the correlation of usage data, applying regulated and non-regulated rates, discounts, and taxes to usage. Invoice Item Generation: Handling real-time and non-real-time call detail records (CDRs) and other data sources to create invoice items. Bill Management: Representing the bill format, scheduling bill production, managing customer invoicing profiles, performing financial calculations to determine the total bill amount (excluding rating and rating discounts), and processing credits and adjustments. Account and Balance Management: Managing customer accounts and their associated balance information. Balances represent monetary or non-monetary amounts (e.g., free minutes, loyalty points) indicating the financial relationship between the service provider and the customer, including pre-paid balances, post-paid accounts receivable, and other credit or debt scenarios."@en ;
    rdfs:subClassOf tax:CustomerCore ;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/application-data-domain/> ;
    dc:subject applicationdatadomainvoc:billing ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime ;
    dct:modified "2026-10-17T01:38:18Z"^^xsd:dateTime .

