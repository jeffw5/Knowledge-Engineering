<https://www.insperity.com/vocabulary/core-process/> {
  <https://www.insperity.com/vocabulary/core-process/> a skos:ConceptScheme;
    rdfs:label "Core process vocabulary"@en;
    skos:prefLabel "Core process vocabulary"@en;
    skos:hasTopConcept processvoc:process;
    terms:description "A collection of interrelated activities or tasks performed to achieve a specific outcome."@en;
    terms:title "Core process vocabulary"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2025-03-25T16:57:48.322Z"^^xsd:dateTime;
    skos:altLabel "Vocabulary | Core | Process"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/vocabulary/core-process/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  processvoc:process a skos:Concept;
    skos:prefLabel "Process"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-25T17:21:38.665Z"^^xsd:dateTime;
    skos:definition "A collection of interrelated activities or tasks performed to achieve a specific outcome."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-process/>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/core-process/>;
    skos:narrower processvoc:measurement, processvoc:observation, processvoc:process-step .
  
  processvoc:measurement a skos:Concept;
    skos:prefLabel "Measurement"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:47:45.019Z"^^xsd:dateTime;
    skos:definition "Quantitative data collected about a process or its output, used for analysis and improvement."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-process/>;
    skos:broader processvoc:process;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  processvoc:observation a skos:Concept;
    skos:prefLabel "Observation"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:47:45.019Z"^^xsd:dateTime;
    skos:definition "Qualitative information gathered by watching and noticing details about a process, often subjective in nature."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-process/>;
    skos:broader processvoc:process;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  processvoc:process-step a skos:Concept;
    skos:prefLabel "Process step"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:47:45.019Z"^^xsd:dateTime;
    skos:definition "A defined stage within a larger process, representing a single activity or task."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-process/>;
    skos:broader processvoc:process;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower processvoc:customer, processvoc:inputs, processvoc:outputs, processvoc:process-action,
      processvoc:supplier .
  
  processvoc:customer a skos:Concept;
    skos:prefLabel "Customer"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:47:45.019Z"^^xsd:dateTime;
    skos:definition "A process directly experienced by a customer, impacting their perception of the overall service or product."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-process/>;
    skos:broader processvoc:process-step;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  processvoc:inputs a skos:Concept;
    skos:prefLabel "Inputs"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:47:45.019Z"^^xsd:dateTime;
    skos:definition "A process focused on receiving, handling, and preparing inputs required for other processes."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-process/>;
    skos:broader processvoc:process-step;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  processvoc:outputs a skos:Concept;
    skos:prefLabel "Outputs"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:47:45.019Z"^^xsd:dateTime;
    skos:definition "A process responsible for delivering, presenting, or distributing the final results of a series of activities."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-process/>;
    skos:broader processvoc:process-step;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower processvoc:approval .
  
  processvoc:process-action a skos:Concept;
    skos:prefLabel "Process action"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:47:45.019Z"^^xsd:dateTime;
    skos:definition "A process primarily focused on executing a series of tasks or activities, often with minimal decision points."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-process/>;
    skos:broader processvoc:process-step;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower processvoc:decision-action, processvoc:discrete-action .
  
  processvoc:supplier a skos:Concept;
    skos:prefLabel "Supplier"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:47:45.019Z"^^xsd:dateTime;
    skos:definition "A process managed by an external entity that provides necessary inputs or services to another process."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-process/>;
    skos:broader processvoc:process-step;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  processvoc:approval a skos:Concept;
    skos:prefLabel "Approval"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:47:45.019Z"^^xsd:dateTime;
    skos:definition "Outlines a specific point where a decision or action requires review and authorization by a designated individual or group before the process can continue."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-process/>;
    skos:broader processvoc:outputs;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  processvoc:decision-action a skos:Concept;
    skos:prefLabel "Decision action"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:47:45.019Z"^^xsd:dateTime;
    skos:definition "A specific point within a process where a choice must be made, potentially altering the process flow."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-process/>;
    skos:broader processvoc:process-action;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  processvoc:discrete-action a skos:Concept;
    skos:prefLabel "Discrete action"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:47:45.019Z"^^xsd:dateTime;
    skos:definition "A clearly defined and independent task within a process, often with a clear start and end point."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-process/>;
    skos:broader processvoc:process-action;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
}
