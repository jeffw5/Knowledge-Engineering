  a sales:sales-service ;
  rdfs:label "Proposal and quote"@en ;
  skos:prefLabel "Proposal and quote"@en ;
  skos:definition "A sales service that prepares and presents a proposal of services, fees and rates, backed by a binding quote, in answer to the buyer's requirements or request for proposal."@en ;
