tax:ResponsibleTechnicalMetricStewards
  a owl:Class ;
  rdfs:label "Responsible technical metric stewards"@en ;
  skos:prefLabel "Responsible technical metric stewards"@en ;
  skos:definition "This role not only understands the business context, objectives and purpose of the metric, but is also responsible for defining the technical details of metric calculations. This individual is responsible for understanding and defining one or many of the following details: how a metric should be calculated, which are the best data sources for pulling the data for calculations, what additional calculations need to be made in order to report the metric (Report/Dashboard etc.). This person approves all decisions that affect the data used in calculating a metric."@en ;
  rdfs:subClassOf skos:Concept , tax:Owner ;
  rdfs:isDefinedBy <https://www.insperity.com/taxonomy/application-business-taxonomy/> ;
  dc:subject applicationbusinesstaxonomyvoc:responsible-technical-metric-stewards ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
