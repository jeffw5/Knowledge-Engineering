commercialopsvoc:insurance
  a skos:Concept ;
  rdfs:label "insurance"@en ;
  skos:prefLabel "insurance"@en ;
  skos:definition "An arrangement under which a carrier agrees to compensate a party for specified losses in return for a premium."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-commercial-operations/> ;
  skos:topConceptOf <https://www.insperity.com/vocabulary/domain-commercial-operations/> ;
