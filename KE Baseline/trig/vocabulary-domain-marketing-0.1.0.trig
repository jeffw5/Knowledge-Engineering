    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:customer-value
    a skos:Concept ;
    skos:prefLabel "Customer value"@en ;
    skos:definition "The perceived benefits that customers receive from a product or service, relative to its cost."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
    skos:broader voc:customer-engagement ;
    owl:versionInfo "0.1.0" ;
