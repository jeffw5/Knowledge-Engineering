marketingshp:campaign-shape
  a sh:NodeShape ;
  rdfs:label "Campaign shape"@en ;
  skos:prefLabel "Campaign shape"@en ;
  skos:definition "A shape that checks a campaign is broken into steps and is measured."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-marketing/> ;
  sh:targetClass marketing:campaign ;
  sh:property [
      sh:path core:hasStep ;
      sh:class core:process-step ;
      sh:message "A campaign should have at least one step."@en ;
      sh:minCount "1"^^xsd:integer ;
      sh:severity sh:Warning
  ] ,
      [
      sh:path core:measuredBy ;
      sh:class core:measure ;
      sh:message "A campaign should name the measures it is judged by."@en ;
      sh:minCount "1"^^xsd:integer ;
      sh:severity sh:Warning
  ] ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-20"^^xsd:date ;
  dct:modified "2026-10-20T00:16:35Z"^^xsd:dateTime .

marketingshp:intelligence-shape
  a sh:NodeShape ;
  rdfs:label "Intelligence shape"@en ;
  skos:prefLabel "Intelligence shape"@en ;
  skos:definition "A shape that checks competitive intelligence names what it is about and cites its source."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-marketing/> ;
  sh:targetClass marketing:intelligence ;
  sh:property [
      sh:path core:concerns ;
      sh:message "Intelligence must be about a competitor, market or party."@en ;
      sh:minCount "1"^^xsd:integer
  ] ,
      [
      sh:path dct:source ;
      sh:message "Intelligence should cite the source it was gathered from."@en ;
      sh:minCount "1"^^xsd:integer ;
      sh:severity sh:Warning
  ] ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-20"^^xsd:date ;
  dct:modified "2026-10-20T00:16:35Z"^^xsd:dateTime .

marketingshp:battlecard-shape
  a sh:NodeShape ;
  rdfs:label "Battlecard shape"@en ;
  skos:prefLabel "Battlecard shape"@en ;
  skos:definition "A shape that checks a battlecard names the competitor organization it positions against."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-marketing/> ;
  sh:targetClass marketing:battlecard ;
  sh:property [
      sh:path core:concerns ;
      sh:class core:organization ;
      sh:message "A battlecard must name the competitor organization it is about."@en ;
      sh:minCount "1"^^xsd:integer
  ] ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-20"^^xsd:date ;
  dct:modified "2026-10-20T00:16:35Z"^^xsd:dateTime .
