<https://www.insperity.com/taxonomy/core-value/> {
  <https://www.insperity.com/taxonomy/core-value/> a skos:ConceptScheme;
    rdfs:label "Core value taxonomy"@en;
    skos:prefLabel "Core value taxonomy"@en;
    skos:hasTopConcept <https://www.insperity.com/taxonomy/core-value/economic-value>,
      <https://www.insperity.com/taxonomy/core-value/information-value>, <https://www.insperity.com/taxonomy/core-value/risk-reduction-value>,
      <https://www.insperity.com/taxonomy/core-value/societal-value>, <https://www.insperity.com/taxonomy/core-value/stakeholder-value>,
      <https://www.insperity.com/taxonomy/core-value/value-proposition>, <https://www.insperity.com/taxonomy/core-value/value-stream>;
    terms:description "Classification of value, the benefit or worth that stakeholders receive from offerings, capabilities, and process outcomes, and of the structures used to describe how it is delivered."@en;
    terms:title "Core value taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2026-10-14"^^xsd:dateTime;
    skos:altLabel "Value taxonomy"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/taxonomy/core-value/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-value/economic-value> a skos:Concept;
    skos:prefLabel "Economic value"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A value expressed as a financial gain, saving, or avoided cost."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-value/>;
    skos:altLabel "Financial value"@en, "Monetary value"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-value/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-value/capital-efficiency>,
      <https://www.insperity.com/taxonomy/core-value/cost-avoidance>, <https://www.insperity.com/taxonomy/core-value/cost-reduction>,
      <https://www.insperity.com/taxonomy/core-value/productivity-gain>, <https://www.insperity.com/taxonomy/core-value/revenue-growth> .
  
  <https://www.insperity.com/taxonomy/core-value/information-value> a skos:Concept;
    skos:prefLabel "Information value"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A value from better knowledge, decisions, and trust."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-value/>;
    skos:altLabel "Decision value"@en, "Knowledge value"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-value/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-value/decision-quality>, <https://www.insperity.com/taxonomy/core-value/reuse-value>,
      <https://www.insperity.com/taxonomy/core-value/trust-and-transparency> .
  
  <https://www.insperity.com/taxonomy/core-value/risk-reduction-value> a skos:Concept;
    skos:prefLabel "Risk reduction value"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A value from lowering the likelihood or impact of adverse events."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-value/>;
    skos:altLabel "Protection value"@en, "Risk mitigation value"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-value/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-value/compliance-assurance>,
      <https://www.insperity.com/taxonomy/core-value/loss-avoidance>, <https://www.insperity.com/taxonomy/core-value/resilience> .
  
  <https://www.insperity.com/taxonomy/core-value/societal-value> a skos:Concept;
    skos:prefLabel "Societal value"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A value that benefits communities or the wider public beyond direct stakeholders."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-value/>;
    skos:altLabel "Public value"@en, "Social value"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-value/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-value/community-value>, <https://www.insperity.com/taxonomy/core-value/environmental-value> .
  
  <https://www.insperity.com/taxonomy/core-value/stakeholder-value> a skos:Concept;
    skos:prefLabel "Stakeholder value"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A value experienced by a particular group of stakeholders."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-value/>;
    skos:altLabel "Experience value"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-value/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-value/client-value>, <https://www.insperity.com/taxonomy/core-value/employee-value>,
      <https://www.insperity.com/taxonomy/core-value/partner-value>, <https://www.insperity.com/taxonomy/core-value/shareholder-value> .
  
  <https://www.insperity.com/taxonomy/core-value/value-proposition> a skos:Concept;
    skos:prefLabel "Value proposition"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A value-related statement of the benefits an offering or capability delivers to a stakeholder and why it is preferable to alternatives."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-value/>;
    skos:altLabel "Offer value statement"@en;
    owl:versionInfo "0.1.0";
    dc:subject businessoperationsvoc:value-proposition;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-value/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-value/client-value-proposition>,
      <https://www.insperity.com/taxonomy/core-value/employee-value-proposition> .
  
  <https://www.insperity.com/taxonomy/core-value/value-stream> a skos:Concept;
    skos:prefLabel "Value stream"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A value-related structure that is an end-to-end sequence of stages delivering an outcome to a stakeholder."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-value/>;
    skos:altLabel "Value chain"@en;
    owl:versionInfo "0.1.0";
    dc:subject valuestreamvoc:value-stream;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-value/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-value/customer-value-stream>,
      <https://www.insperity.com/taxonomy/core-value/internal-value-stream> .
  
  <https://www.insperity.com/taxonomy/core-value/capital-efficiency> a skos:Concept;
    skos:prefLabel "Capital efficiency"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An economic value from using less capital or working capital for the same outcome."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-value/>;
    skos:broader <https://www.insperity.com/taxonomy/core-value/economic-value>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-value/client-value> a skos:Concept;
    skos:prefLabel "Client value"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A stakeholder value experienced by client organizations."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-value/>;
    skos:broader <https://www.insperity.com/taxonomy/core-value/stakeholder-value>;
    skos:altLabel "Customer value"@en;
    owl:versionInfo "0.1.0";
    dc:subject domainmarketingvoc:customer-value;
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-value/client-value-proposition> a skos:Concept;
    skos:prefLabel "Client value proposition"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A value proposition addressed to clients."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-value/>;
    skos:broader <https://www.insperity.com/taxonomy/core-value/value-proposition>;
    skos:altLabel "Customer value proposition"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-value/community-value> a skos:Concept;
    skos:prefLabel "Community value"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A societal value that benefits the communities where the organization and its clients operate."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-value/>;
    skos:broader <https://www.insperity.com/taxonomy/core-value/societal-value>;
    skos:altLabel "Community benefit"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-value/compliance-assurance> a skos:Concept;
    skos:prefLabel "Compliance assurance"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A risk reduction value from meeting legal, regulatory, and contractual obligations."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-value/>;
    skos:broader <https://www.insperity.com/taxonomy/core-value/risk-reduction-value>;
    skos:altLabel "Regulatory assurance"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-value/cost-avoidance> a skos:Concept;
    skos:prefLabel "Cost avoidance"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An economic value from preventing spending that would otherwise occur."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-value/>;
    skos:broader <https://www.insperity.com/taxonomy/core-value/economic-value>;
    skos:altLabel "Avoided cost"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-value/cost-reduction> a skos:Concept;
    skos:prefLabel "Cost reduction"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An economic value from lowering current spending."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-value/>;
    skos:broader <https://www.insperity.com/taxonomy/core-value/economic-value>;
    skos:altLabel "Cost savings"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-value/customer-value-stream> a skos:Concept;
    skos:prefLabel "Customer value stream"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A value stream that delivers an outcome to an external client or worker."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-value/>;
    skos:broader <https://www.insperity.com/taxonomy/core-value/value-stream>;
    skos:altLabel "Operational value stream"@en, "Prospect to client value stream"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-value/decision-quality> a skos:Concept;
