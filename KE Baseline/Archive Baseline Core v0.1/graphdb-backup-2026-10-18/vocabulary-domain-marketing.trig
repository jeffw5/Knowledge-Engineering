<https://www.insperity.com/vocabulary/domain-marketing/> {
  <https://www.insperity.com/vocabulary/domain-marketing/> a skos:ConceptScheme;
    rdfs:label "Domain marketing vocabulary"@en;
    skos:prefLabel "Domain marketing vocabulary"@en;
    skos:hasTopConcept domainmarketingvoc:marketing;
    terms:description "The process of creating, communicating, and delivering value to customers and for managing customer relationships in ways that benefit the organization and its stakeholders."@en;
    terms:title "Domain marketing vocabulary"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2025-03-25T17:02:58.984Z"^^xsd:dateTime;
    skos:altLabel "Vocabulary | Domain | Marketing"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/vocabulary/domain-marketing/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  domainmarketingvoc:marketing a skos:Concept;
    skos:prefLabel "Marketing"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-25T17:28:17.221Z"^^xsd:dateTime;
    skos:definition "The process of creating, communicating, and delivering value to customers and for managing customer relationships in ways that benefit the organization and its stakeholders."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-marketing/>;
    skos:narrower domainmarketingvoc:account-based-marketing, domainmarketingvoc:brand-management,
      domainmarketingvoc:campaign-management, domainmarketingvoc:content-marketing, domainmarketingvoc:customer-engagement,
      domainmarketingvoc:influencer-marketing, domainmarketingvoc:marketing-communications,
      domainmarketingvoc:marketing-insights-and-analysis, domainmarketingvoc:marketing-management,
      domainmarketingvoc:marketing-mix, domainmarketingvoc:performance-marketing .
  
  domainmarketingvoc:account-based-marketing a skos:Concept;
    skos:prefLabel "Account-Based marketing"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T20:29:05.848Z"^^xsd:dateTime;
    skos:definition "A strategic approach that focuses marketing and sales resources on a defined set of target accounts, treating each account as a market of one."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/>;
    skos:broader domainmarketingvoc:marketing;
    skos:altLabel "ABM"@en, "Account Based Marketing"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domainmarketingvoc:account-selection-and-prioritization, domainmarketingvoc:ideal-customer-profile-development,
      domainmarketingvoc:personalized-content .
  
  domainmarketingvoc:brand-management a skos:Concept;
    skos:prefLabel "Brand management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T20:29:05.848Z"^^xsd:dateTime;
    skos:definition "The process of creating, maintaining, and enhancing the value of a brand over time."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/>;
    skos:broader domainmarketingvoc:marketing;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domainmarketingvoc:brand-awareness, domainmarketingvoc:brand-equity,
      domainmarketingvoc:brand-identity, domainmarketingvoc:brand-leadership, domainmarketingvoc:brand-positioning,
      domainmarketingvoc:reputation-management .
  
  domainmarketingvoc:campaign-management a skos:Concept;
    skos:prefLabel "Campaign management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T20:29:05.848Z"^^xsd:dateTime;
    skos:definition "The process of planning, executing, tracking, and analyzing marketing campaigns."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/>;
    skos:broader domainmarketingvoc:marketing;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domainmarketingvoc:campaign-budgeting, domainmarketingvoc:campaign-execution,
      domainmarketingvoc:campaign-partnerships, domainmarketingvoc:campaign-planning .
  
  domainmarketingvoc:content-marketing a skos:Concept;
    skos:prefLabel "Content marketing"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T20:29:05.848Z"^^xsd:dateTime;
    skos:definition "Creating and distributing valuable, relevant, and consistent content to attract and engage a clearly defined audience."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/>;
    skos:broader domainmarketingvoc:marketing;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domainmarketingvoc:content-creation, domainmarketingvoc:content-distribution,
      domainmarketingvoc:content-planning .
  
  domainmarketingvoc:customer-engagement a skos:Concept;
    skos:prefLabel "Customer engagement"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T20:29:05.848Z"^^xsd:dateTime;
    skos:definition "The level of interaction and involvement that customers have with a brand."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/>;
    skos:broader domainmarketingvoc:marketing;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domainmarketingvoc:customer-feedback, domainmarketingvoc:customer-journey,
      domainmarketingvoc:customer-profile, domainmarketingvoc:customer-referral, domainmarketingvoc:customer-retention-and-growth,
      domainmarketingvoc:customer-value .
  
  domainmarketingvoc:influencer-marketing a skos:Concept;
    skos:prefLabel "Influencer marketing"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T20:29:05.848Z"^^xsd:dateTime;
    skos:definition "Partnering with individuals who have a strong following and influence over a target audience to promote a brand or product."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/>;
    skos:broader domainmarketingvoc:marketing;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domainmarketingvoc:influencer-discovery-and-vetting, domainmarketingvoc:influencer-relationship-management .
  
  domainmarketingvoc:marketing-communications a skos:Concept;
    skos:prefLabel "Marketing communications"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T20:29:05.848Z"^^xsd:dateTime;
    skos:definition "The various tools and channels that companies use to communicate with their target markets."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/>;
    skos:broader domainmarketingvoc:marketing;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domainmarketingvoc:integrated-marketing-communication-management, domainmarketingvoc:internal-communication,
      domainmarketingvoc:mass-communication-management, domainmarketingvoc:personal-communication-management .
  
  domainmarketingvoc:marketing-insights-and-analysis a skos:Concept;
    skos:prefLabel "Marketing insights & analysis"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T20:29:05.848Z"^^xsd:dateTime;
    skos:definition "Gathering and interpreting data to understand customer behavior, market trends, and campaign performance."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/>;
    skos:broader domainmarketingvoc:marketing;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domainmarketingvoc:demand-forecasting, domainmarketingvoc:industry-trends,
      domainmarketingvoc:market-demographics, domainmarketingvoc:market-research, domainmarketingvoc:market-segments,
      domainmarketingvoc:market-targets, domainmarketingvoc:marketing-analysis .
  
  domainmarketingvoc:marketing-management a skos:Concept;
    skos:prefLabel "Marketing management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T20:29:05.848Z"^^xsd:dateTime;
    skos:definition "The process of planning, organizing, implementing, and controlling marketing activities."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/>;
    skos:broader domainmarketingvoc:marketing;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domainmarketingvoc:marketing-analytics-and-metrics, domainmarketingvoc:marketing-plans,
      domainmarketingvoc:marketing-strategy, domainmarketingvoc:marketing-technology, domainmarketingvoc:risk-identification-and-mitigation .
  
  domainmarketingvoc:marketing-mix a skos:Concept;
    skos:prefLabel "Marketing mix"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T20:29:05.848Z"^^xsd:dateTime;
    skos:definition "The set of controllable, tactical marketing tools that the firm blends to produce the response it wants in the target market."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/>;
    skos:broader domainmarketingvoc:marketing;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domainmarketingvoc:channel-management, domainmarketingvoc:pricing-management,
      domainmarketingvoc:product-management .
  
  domainmarketingvoc:performance-marketing a skos:Concept;
    skos:prefLabel "Performance marketing"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T20:29:05.848Z"^^xsd:dateTime;
    skos:definition "A type of marketing where advertisers pay only when a specific action is taken, such as a sale or lead."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/>;
    skos:broader domainmarketingvoc:marketing;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domainmarketingvoc:affiliate-marketing, domainmarketingvoc:conversion-rate-optimization,
      domainmarketingvoc:native-advertising, domainmarketingvoc:search-engine-marketing,
      domainmarketingvoc:social-media-marketing .
  
  domainmarketingvoc:account-selection-and-prioritization a skos:Concept;
    skos:prefLabel "Account selection & prioritization"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T20:29:05.848Z"^^xsd:dateTime;
    skos:definition "The process of identifying and ranking potential accounts based on their attractiveness and fit with the company’s ideal customer profile."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/>;
    skos:broader domainmarketingvoc:account-based-marketing;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domainmarketingvoc:ideal-customer-profile-development a skos:Concept;
    skos:prefLabel "Ideal customer profile development"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T20:29:05.848Z"^^xsd:dateTime;
    skos:definition "Creating a detailed description of the type of customer that would gain the most value from the company’s products or services and represent the highest profit potential."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/>;
    skos:broader domainmarketingvoc:account-based-marketing;
    skos:altLabel "ICP Development"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domainmarketingvoc:personalized-content a skos:Concept;
    skos:prefLabel "Personalized content"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T20:29:05.848Z"^^xsd:dateTime;
    skos:definition "Tailoring content to the specific interests, needs, and preferences of individual customers or accounts."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/>;
    skos:broader domainmarketingvoc:account-based-marketing;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domainmarketingvoc:brand-awareness a skos:Concept;
    skos:prefLabel "Brand awareness"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T20:29:05.848Z"^^xsd:dateTime;
    skos:definition "The extent to which consumers are familiar with a brand and its products or services."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/>;
    skos:broader domainmarketingvoc:brand-management;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domainmarketingvoc:brand-equity a skos:Concept;
    skos:prefLabel "Brand equity"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T20:29:05.848Z"^^xsd:dateTime;
    skos:definition "The value that a brand adds to a product or service, based on consumer perceptions and experiences."@en;
