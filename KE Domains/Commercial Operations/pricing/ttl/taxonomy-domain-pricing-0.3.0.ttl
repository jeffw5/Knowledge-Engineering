pricingtax:pricing-component
  a skos:Concept ;
  rdfs:label "Pricing component"@en ;
  skos:prefLabel "Pricing component"@en ;
  skos:definition "A measure that is one of the amounts or rates from which the price of a professional employer organization offering is built."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/domain-pricing/> ;
  skos:topConceptOf <https://www.insperity.com/taxonomy/domain-pricing/> ;
  skos:narrower pricingtax:benefits-rate ,
      pricingtax:discount ,
      pricingtax:employer-burden ,
      pricingtax:service-fee ,
      pricingtax:unemployment-insurance-rate ,
      pricingtax:workers-compensation-rate ;
  core:hasPrimaryTerm assetvoc:component ;
  dct:subject assetvoc:component , decisionvoc:pricing ;
  core:formalizedBy core:measure ;
  owl:versionInfo "0.3.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-22"^^xsd:date ;
  dct:modified "2026-10-22T02:04:02Z"^^xsd:dateTime .

