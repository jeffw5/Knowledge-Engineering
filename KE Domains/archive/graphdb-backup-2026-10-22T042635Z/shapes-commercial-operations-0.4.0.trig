<https://www.insperity.com/shapes/commercial-operations/> {
  <https://www.insperity.com/shapes/commercial-operations/> a owl:Ontology;
    rdfs:label "Commercial Operations Shapes"@en;
    skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en;
    terms:description "SHACL shapes for the shared commercial records and agreements."@en;
    terms:title "Commercial Operations Shapes"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_commercial_operations.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.2.0 (2026-10-20): Census moved here from pricing and contracts, because sales and pricing and contracts both use it (D2); the container holds the PEO buyer persona graph that every domain addresses. Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_commercial_operations.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.3.0 (2026-10-20): Supplier and customer of a process step (has supplier, has customer) for the SIPOCM view of assembled processes (D24), with a shape that checks they point to a party or a role. Built by build_domains.py from spec_commercial_operations.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.4.0 (2026-10-21): Restructured to the operational areas and the naming standard (D26, D27): titled 'Commercial Operations Vocabulary', '… Taxonomy', '… Ontology' and '… Shapes', at …/<kind>/commercial-operations/ (formerly …/<kind>/domain-commercial-operations/). The client service agreement, commercial agreement and clause (classes, concepts and the clause primitive) moved to Domain Legal in Business Operations. A taxonomy branch lists the area's domains. Built by build_domains.py from spec_commercial_operations.py against Baseline Core v1.0 (core 0.1.0)."@en;
    terms:created "2026-10-22"^^xsd:date;
    owl:versionInfo "0.4.0";
    terms:subject domainvoc:commercial;
    owl:imports <https://www.insperity.com/ontology/commercial-operations/>;
    owl:versionIRI <https://www.insperity.com/shapes/commercial-operations/0.4.0/>;
    vaem:namespace "https://www.insperity.com/shapes/commercial-operations/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft;
    vann:preferredNamespacePrefix "commercialopsshp";
    terms:publisher <https://www.insperity.com/resource/core/Organization/insperity>;
    terms:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/>;
    terms:identifier "shapes-commercial-operations";
    terms:requires <https://www.insperity.com/ontology/commercial-operations/0.4.0/>;
    terms:replaces <https://www.insperity.com/shapes/commercial-operations/> .
  
  <https://www.insperity.com/shapes/commercial-operations/process-step-boundary-shape>
    a sh:NodeShape;
    rdfs:label "Process step boundary shape"@en;
    rdfs:isDefinedBy <https://www.insperity.com/shapes/commercial-operations/>;
    skos:prefLabel "Process step boundary shape"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A shape that checks the supplier and customer of a process step are parties or roles."@en;
    owl:versionInfo "0.4.0";
    sh:property _:node12125, _:node12130;
    sh:targetClass core:process-step;
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/shapes/commercial-operations/account-shape> a sh:NodeShape;
    rdfs:label "Account shape"@en;
    rdfs:isDefinedBy <https://www.insperity.com/shapes/commercial-operations/>;
    skos:prefLabel "Account shape"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A shape that checks an account names the party it is about."@en;
    owl:versionInfo "0.4.0";
    sh:property _:node12135;
    sh:targetClass <https://www.insperity.com/ontology/commercial-operations/account>;
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/shapes/commercial-operations/opportunity-shape> a sh:NodeShape;
    rdfs:label "Opportunity shape"@en;
    rdfs:isDefinedBy <https://www.insperity.com/shapes/commercial-operations/>;
    skos:prefLabel "Opportunity shape"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A shape that checks an opportunity names its party and offerings and credits a party for its source."@en;
    owl:versionInfo "0.4.0";
    sh:property _:node12136, _:node12137;
    sh:targetClass <https://www.insperity.com/ontology/commercial-operations/opportunity>;
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/shapes/commercial-operations/census-shape> a sh:NodeShape;
    rdfs:label "Census shape"@en;
    rdfs:isDefinedBy <https://www.insperity.com/shapes/commercial-operations/>;
    skos:prefLabel "Census shape"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A shape that checks a census is about the persons it lists."@en;
    owl:versionInfo "0.4.0";
    sh:property _:node12138;
    sh:targetClass <https://www.insperity.com/ontology/commercial-operations/census>;
    core:hasLifecycleStatus core:Draft .
  
  _:node12126 rdf:first _:node12127;
    rdf:rest _:node12128 .
  
  _:node12128 rdf:first _:node12129;
    rdf:rest rdf:nil .
  
  _:node12131 rdf:first _:node12132;
    rdf:rest _:node12133 .
  
  _:node12133 rdf:first _:node12134;
    rdf:rest rdf:nil .
  
  _:node12125 sh:path <https://www.insperity.com/ontology/commercial-operations/hasSupplier>;
    sh:or _:node12126;
    sh:message "has supplier must point to a party or a role."@en .
  
  _:node12130 sh:path <https://www.insperity.com/ontology/commercial-operations/hasCustomer>;
    sh:or _:node12131;
    sh:message "has customer must point to a party or a role."@en .
  
  _:node12135 sh:path core:concerns;
    sh:class core:party;
    sh:minCount 1;
    sh:message "An account must be about a party (the prospect or client)."@en .
  
  _:node12136 sh:path core:concerns;
    sh:minCount 1;
    sh:message "An opportunity must be about the prospect or client it pursues and the offerings it would sell."@en .
  
  _:node12137 sh:path <https://www.insperity.com/ontology/commercial-operations/attributedTo>;
    sh:class core:party;
    sh:message "attributed to must point to a party."@en .
  
  _:node12138 sh:path core:concerns;
    sh:class core:person;
    sh:minCount 1;
    sh:message "A census must be about the employees it lists."@en;
    sh:severity sh:Warning .
  
  _:node12127 sh:class core:party .
  
  _:node12129 sh:class core:role .
  
  _:node12132 sh:class core:party .
  
  _:node12134 sh:class core:role .
}
