    dct:created "2026-10-17T01:38:18Z"^^xsd:dateTime ;
    dct:modified "2026-10-18T00:25:49Z"^^xsd:dateTime .

  assettax:PhysicalAsset
    a skos:Concept ;
    rdfs:label "Physical asset"@en ;
    skos:prefLabel "Physical asset"@en ;
    skos:altLabel "Material asset"@en , "Tangible asset"@en ;
    skos:definition "An asset that has material existence and can be located, handled, or occupied."@en ;
    skos:scopeNote "Aligned to the BFO material entity category."@en ;
    skos:example "A worksite building; a laptop."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/core-asset/> ;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-asset/> ;
    skos:narrower assettax:Equipment , assettax:Facility , assettax:Inventory , assettax:Vehicle ;
    core:hasPrimaryTerm assetvoc:physical-asset ;
    dct:subject assetvoc:physical-asset ;
    core:formalizedBy core:PhysicalAsset ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-17T01:38:18Z"^^xsd:dateTime ;
    dct:modified "2026-10-19T02:19:17Z"^^xsd:dateTime .

  assettax:Equipment
    a skos:Concept ;
    rdfs:label "Equipment"@en ;
    skos:prefLabel "Equipment"@en ;
    skos:altLabel "Tool"@en ;
    skos:definition "A physical asset that is a durable device or apparatus used to perform work."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/core-asset/> ;
    skos:broader assettax:PhysicalAsset ;
    skos:narrower assettax:CommunicationEquipment ,
        assettax:ComputingEquipment ,
        assettax:OperationalEquipment ;
    core:hasPrimaryTerm domainsecurityvoc:equipment ;
    dct:subject domainsecurityvoc:equipment ;
    owl:versionInfo "0.1.0" ;
