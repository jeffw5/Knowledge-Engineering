  vann:preferredNamespaceUri "https://www.insperity.com/shapes/core-asset/"^^xsd:anyURI ;
  dct:language "en" ;
  skos:changeNote "0.1.0 (2026-10-15): shapes moved out of the core-asset ontology into their own shapes graph under https://www.insperity.com/shapes/, as Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III requires."@en ;
