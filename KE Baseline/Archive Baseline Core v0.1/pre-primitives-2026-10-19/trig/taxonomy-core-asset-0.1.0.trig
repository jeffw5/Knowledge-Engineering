    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-17T01:38:18Z"^^xsd:dateTime ;
    dct:modified "2026-10-18T00:25:49Z"^^xsd:dateTime .

  assettax:CommunicationEquipment
    a skos:Concept ;
    rdfs:label "Communication equipment"@en ;
    skos:prefLabel "Communication equipment"@en ;
    skos:definition "An equipment that transmits or receives voice or data."@en ;
    skos:example "Telephone handset; network router."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/core-asset/> ;
    skos:broader assettax:Equipment ;
