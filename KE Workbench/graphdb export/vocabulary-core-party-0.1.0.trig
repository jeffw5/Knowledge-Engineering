<https://www.insperity.com/vocabulary/core-party/> {
  <https://www.insperity.com/vocabulary/core-party/> a skos:ConceptScheme;
    rdfs:label "Core party vocabulary"@en;
    skos:prefLabel "Core party vocabulary"@en;
    skos:hasTopConcept partyvoc:party;
    terms:description "A general term referring to any individual or group involved in a transaction or interaction."@en;
    terms:title "Core party vocabulary"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2025-03-25T16:57:05.783Z"^^xsd:dateTime;
    skos:altLabel "Vocabulary | Core | Party"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/vocabulary/core-party/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  partyvoc:party a skos:Concept;
    skos:prefLabel "Party"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-25T17:20:50.757Z"^^xsd:dateTime;
    skos:definition "A general term referring to any individual or group involved in a transaction or interaction."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-party/>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/core-party/>;
    skos:narrower partyvoc:organization, partyvoc:person, partyvoc:vendor .
  
  partyvoc:organization a skos:Concept;
    skos:prefLabel "Organization"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:52.864Z"^^xsd:dateTime;
    skos:definition "A structured group of people with a common purpose, such as a business, charity, or government agency."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-party/>;
    skos:broader partyvoc:party;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower partyvoc:business-unit, partyvoc:commercial, partyvoc:corporate-services,
      partyvoc:executive-team, partyvoc:network-technology, partyvoc:virtual-team .
  
  partyvoc:person a skos:Concept;
    skos:prefLabel "Person"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:52.864Z"^^xsd:dateTime;
    skos:definition "An individual, typically an employee, customer, or partner."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-party/>;
    skos:broader partyvoc:party;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  partyvoc:vendor a skos:Concept;
    skos:prefLabel "Vendor"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:52.864Z"^^xsd:dateTime;
    skos:definition "A third-party company that provides goods or services to an organization."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-party/>;
    skos:broader partyvoc:party;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  partyvoc:business-unit a skos:Concept;
    skos:prefLabel "Business unit"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:52.864Z"^^xsd:dateTime;
    skos:definition "A distinct and often independently operated segment of a company (e.g., Verizon Business Group, Verizon Consumer Group)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-party/>;
    skos:broader partyvoc:organization;
    skos:altLabel "BU"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower partyvoc:edai .
  
  partyvoc:commercial a skos:Concept;
    skos:prefLabel "Commercial"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:52.864Z"^^xsd:dateTime;
    skos:definition "Relating to the business and revenue-generating activities of a company."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-party/>;
    skos:broader partyvoc:organization;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  partyvoc:corporate-services a skos:Concept;
    skos:prefLabel "Corporate services"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:52.864Z"^^xsd:dateTime;
    skos:definition "Centralized functions that support the entire organization, such as finance, HR, legal, and IT."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-party/>;
    skos:broader partyvoc:organization;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower partyvoc:finance, partyvoc:human-resources, partyvoc:legal-and-security,
      partyvoc:strategy .
  
  partyvoc:executive-team a skos:Concept;
    skos:prefLabel "Executive team"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:52.864Z"^^xsd:dateTime;
    skos:definition "The top leadership team of an organization, typically consisting of the CEO and other C-level executives."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-party/>;
    skos:broader partyvoc:organization;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower partyvoc:chief-financial-officer, partyvoc:chief-human-resources-officer,
      partyvoc:chief-operations-officer .
  
  partyvoc:network-technology a skos:Concept;
    skos:prefLabel "Network technology"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:52.864Z"^^xsd:dateTime;
    skos:definition "The infrastructure and technologies used to build and operate communication networks."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-party/>;
    skos:broader partyvoc:organization;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower partyvoc:artificial-intelligence-and-data, partyvoc:global-network-and-technology .
  
  partyvoc:virtual-team a skos:Concept;
    skos:prefLabel "Virtual team"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:52.864Z"^^xsd:dateTime;
    skos:definition "A group of people working together from different locations using technology to communicate and collaborate."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-party/>;
    skos:broader partyvoc:organization;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  partyvoc:edai a skos:Concept;
    skos:prefLabel "EDAI"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-10-31T14:27:32.350Z"^^xsd:dateTime;
    skos:definition "Responsible for foundational data and analytics, data integration, definition and standards, as well as governance across the ecosystem."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-party/>;
    skos:broader partyvoc:business-unit;
    skos:altLabel "Enterprise Data Analytics & Insights, Intelligence, Innovation"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower partyvoc:data-and-artificial-intelligence .
  
  partyvoc:data-and-artificial-intelligence a skos:Concept;
    skos:prefLabel "Data & artificial intelligence"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:52.864Z"^^xsd:dateTime;
    skos:definition "The collection, processing, and interpretation of data to extract meaningful insights and support decision-making."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-party/>;
    skos:broader partyvoc:edai;
    skos:altLabel "Data & Analytics"@en, "D&A"@en, "Data & AI"@en, "Data & Artificial Intelligence"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower partyvoc:data-and-artificial-intelligence-governance, partyvoc:data-and-artificial-intelligence-hub-and-spoke .
  
  partyvoc:data-and-artificial-intelligence-governance a skos:Concept;
    skos:prefLabel "Data & artificial intelligence governance"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-10-31T14:24:26.179Z"^^xsd:dateTime;
    skos:definition "Establishes data management policies, processes and technologies across Verizon."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-party/>;
    skos:broader partyvoc:data-and-artificial-intelligence;
    skos:altLabel "DAG"@en, "Data & Analytics Governance"@en, "Data & Artificial Intelligence Governance"@en,
      "Data & AI governance"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower partyvoc:end-to-end-governance .
  
  partyvoc:data-and-artificial-intelligence-hub-and-spoke a skos:Concept;
    skos:prefLabel "Data & artificial intelligence hub & spoke"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:52.864Z"^^xsd:dateTime;
    skos:definition "A model for organizing data and analytics resources where a central “hub” provides common tools and governance, while “spokes” represent specific business units or functions."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-party/>;
    skos:broader partyvoc:data-and-artificial-intelligence;
    skos:altLabel "Data & Analytics Hub & Spoke"@en, "D&A Hub & Spoke"@en, "Data & Artificial Intelligence Hub & Spoke"@en,
      "Data & AI hub & spoke"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  partyvoc:end-to-end-governance a skos:Concept;
    skos:prefLabel "End to end governance"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-10-31T14:25:56.254Z"^^xsd:dateTime;
    skos:definition "Establish the data management policies, processes, and enabling technologies necessary to ensure data is Trusted, Available, and Governed to service the needs of customers, employees, business stakeholders is management end to end."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-party/>;
    skos:broader partyvoc:data-and-artificial-intelligence-governance;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  partyvoc:finance a skos:Concept;
