<https://www.insperity.com/shapes/core/>
  a owl:Ontology ;
  rdfs:label "Core domain shapes"@en ;
  dct:title "Core domain shapes"@en ;
  dct:description "SHACL shapes that keep data built on the core domain ontology anchored on the process step: every step belongs to a process, and every directive, measure, issue and event is tied to the steps it governs, measures, concerns or triggers."@en ;
  dct:subject domaintax:EnterpriseArchitecture ;
  owl:imports <https://www.insperity.com/ontology/core/> ;
  vaem:namespace "https://www.insperity.com/shapes/core/"^^xsd:anyURI ;
  vann:preferredNamespacePrefix "coreshp" ;
  dct:language "en" ;
  dct:publisher <https://www.insperity.com/resource/core/Organization/insperity> ;
  dct:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/> ;
  skos:changeNote "0.1.0 (2026-10-19): process-step anchoring shapes for https://www.insperity.com/ontology/core/, built from shapes-core.source.ttl. Replace the core-compliance, core-domain, core-party, core-process and core-product shapes graphs."@en ;
  owl:versionInfo "0.1.0" ;
  owl:versionIRI <https://www.insperity.com/shapes/core/0.1.0/> ;
  dct:identifier "shapes-core" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:contributor "Jeffrey Wallk" ;
  dct:created "2026-10-18"^^xsd:date ;
  dct:modified "2026-10-19T02:19:17Z"^^xsd:dateTime .

coreshp:ProcessShape
  a sh:NodeShape ;
  rdfs:label "Process shape"@en ;
  skos:prefLabel "Process shape"@en ;
  skos:definition "A shape that checks a process is broken down into steps."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/core/> ;
  sh:targetClass core:Process ;
  sh:property [
      sh:path core:hasStep ;
      sh:class core:ProcessStep ;
      sh:message "A process should have at least one process step."@en ;
      sh:minCount "1"^^xsd:integer ;
      sh:severity sh:Warning
  ] ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-19"^^xsd:date ;
  dct:modified "2026-10-19T02:19:17Z"^^xsd:dateTime .

coreshp:ProcessStepShape
  a sh:NodeShape ;
  rdfs:label "Process step shape"@en ;
  skos:prefLabel "Process step shape"@en ;
  skos:definition "A shape that checks a process step is part of a process and that what it is related to has the right type."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/core/> ;
  sh:targetClass core:ProcessStep ;
  sh:property [
      sh:path core:precedes ;
      sh:class core:ProcessStep ;
      sh:message "precedes must point to another process step."@en
  ] ,
      [
      sh:path core:occursIn ;
      sh:class core:Location ;
      sh:message "occurs in must point to a location."@en
  ] ,
      [
      sh:path core:occupiesTime ;
      sh:class core:Time ;
      sh:maxCount "1"^^xsd:integer ;
      sh:message "A process step occupies at most one time."@en
  ] ,
      [
      sh:path core:isStepOf ;
      sh:class core:Process ;
      sh:message "A process step must be a step of a process."@en ;
      sh:minCount "1"^^xsd:integer
  ] ,
      [
      sh:path core:performedBy ;
      sh:class core:Party ;
      sh:message "A process step should name the party that performs it."@en ;
      sh:minCount "1"^^xsd:integer ;
      sh:severity sh:Warning
  ] ,
      [
      sh:path core:fulfillsRole ;
      sh:class core:Role ;
      sh:message "fulfills role must point to a role."@en
  ] ,
      [
      sh:path core:exercisesCapability ;
      sh:class core:Capability ;
      sh:message "exercises capability must point to a capability."@en
  ] ,
      [
      sh:path core:governedBy ;
      sh:class core:Directive ;
      sh:message "governed by must point to a directive."@en
  ] ,
      [
      sh:path core:measuredBy ;
      sh:class core:Measure ;
      sh:message "measured by must point to a measure."@en
  ] ,
      [
      sh:path core:hasIssue ;
      sh:class core:Issue ;
      sh:message "has issue must point to an issue."@en
  ] ,
      [
      sh:path core:triggeredBy ;
      sh:class core:Event ;
      sh:message "triggered by must point to an event."@en
  ] ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-19"^^xsd:date ;
  dct:modified "2026-10-19T02:19:17Z"^^xsd:dateTime .

coreshp:EventShape
  a sh:NodeShape ;
  rdfs:label "Event shape"@en ;
  skos:prefLabel "Event shape"@en ;
  skos:definition "A shape that checks an event is tied to a process step it triggers."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/core/> ;
  sh:targetClass core:Event ;
  sh:property [
      sh:path core:triggers ;
      sh:class core:ProcessStep ;
      sh:message "An event should trigger at least one process step."@en ;
      sh:minCount "1"^^xsd:integer ;
      sh:severity sh:Warning
  ] ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-19"^^xsd:date ;
  dct:modified "2026-10-19T02:19:17Z"^^xsd:dateTime .

