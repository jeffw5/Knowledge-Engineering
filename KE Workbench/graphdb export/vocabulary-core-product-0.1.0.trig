    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower productvoc:functional-product, productvoc:supplied-product, productvoc:technical-product .
  
  productvoc:product-collection a skos:Concept;
    skos:prefLabel "Product collection"@en;
