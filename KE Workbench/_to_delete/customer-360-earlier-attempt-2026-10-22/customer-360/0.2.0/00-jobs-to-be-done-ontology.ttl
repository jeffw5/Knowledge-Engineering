<https://www.insperity.com/ontology/jobs-to-be-done/>
  a owl:Ontology ;
  rdfs:label "Jobs-to-be-done ontology"@en ;
  skos:prefLabel "Jobs-to-be-done ontology"@en ;
  dct:title "Jobs-to-be-done ontology"@en ;
  dct:description "A domain ontology that extends the core persona, job, job step and desired outcome classes for outcome-driven research: client personas and their functional, consumption-chain, emotional and social jobs, the universal job map, appreciative inquiry interviews that discover them, subject-matter expert reviews and decisions, and the survey waves that score each desired outcome."@en ;
  dct:subject <https://www.insperity.com/taxonomy/core-domain/EnterpriseArchitecture> ;
  vaem:namespace "https://www.insperity.com/ontology/jobs-to-be-done/"^^xsd:anyURI ;
  vann:preferredNamespacePrefix "jtbd" ;
  dct:language "en" ;
  dct:publisher <https://www.insperity.com/resource/core/Organization/insperity> ;
  dct:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/> ;
  dct:conformsTo <http://purl.obolibrary.org/obo/bfo/2020/bfo.owl> ;
  skos:changeNote "0.2.0 (2026-10-22): realigned as an extension of the core ontology (persona, job, job step, desired outcome, measure, decision); lower-case hyphenated class names; job steps are per job, the eight universal steps become job map stages; adds interviews, reviews, decisions, survey waves and scores."@en ;
  owl:versionInfo "0.2.0" ;
  owl:versionIRI <https://www.insperity.com/ontology/jobs-to-be-done/0.2.0/> ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-22"^^xsd:date ;
  dct:modified "2026-10-22T19:46:03Z"^^xsd:dateTime ;
  owl:imports <https://www.insperity.com/ontology/core/> .

# ---- Classes ----------------------------------------------------------

jtbd:client-persona
  a owl:Class ;
  rdfs:label "Client persona"@en ;
  skos:prefLabel "Client persona"@en ;
  skos:definition "A persona that describes a role at or within a client company that executes, or takes part in, jobs a human resources partner helps get done."@en ;
  rdfs:subClassOf core:persona ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/jobs-to-be-done/> ;
  core:hasPrimaryTerm personavoc:persona ;
  core:hasLifecycleStatus core:Draft ;
  dct:created "2026-10-22"^^xsd:date ;
  dct:modified "2026-10-22T19:46:03Z"^^xsd:dateTime .

jtbd:job-to-be-done
  a owl:Class ;
  rdfs:label "Job to be done"@en ;
  skos:prefLabel "Job to be done"@en ;
  skos:definition "A job that a client persona is trying to get done, stated without naming the product or service that might help."@en ;
  rdfs:subClassOf core:job ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/jobs-to-be-done/> ;
  core:hasPrimaryTerm jobvoc:job ;
  core:hasLifecycleStatus core:Draft ;
  dct:created "2026-10-22"^^xsd:date ;
  dct:modified "2026-10-22T19:46:03Z"^^xsd:dateTime .

jtbd:core-functional-job
  a owl:Class ;
  rdfs:label "Core functional job"@en ;
  skos:prefLabel "Core functional job"@en ;
  skos:definition "A job to be done that is a main functional task the client hires a human resources partner to help with."@en ;
  rdfs:subClassOf jtbd:job-to-be-done ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/jobs-to-be-done/> ;
  core:hasLifecycleStatus core:Draft ;
  dct:created "2026-10-22"^^xsd:date ;
  dct:modified "2026-10-22T19:46:03Z"^^xsd:dateTime .

jtbd:consumption-chain-job
  a owl:Class ;
  rdfs:label "Consumption chain job"@en ;
  skos:prefLabel "Consumption chain job"@en ;
  skos:definition "A job to be done that the client carries out to choose, adopt, use or renew the provider relationship itself."@en ;
  rdfs:subClassOf jtbd:job-to-be-done ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/jobs-to-be-done/> ;
  core:hasLifecycleStatus core:Draft ;
  dct:created "2026-10-22"^^xsd:date ;
  dct:modified "2026-10-22T19:46:03Z"^^xsd:dateTime .

jtbd:emotional-job
  a owl:Class ;
  rdfs:label "Emotional job"@en ;
  skos:prefLabel "Emotional job"@en ;
  skos:definition "A job to be done that states how the job executor wants to feel while getting functional jobs done."@en ;
  rdfs:subClassOf jtbd:job-to-be-done ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/jobs-to-be-done/> ;
  core:hasPrimaryTerm jobvoc:emotional ;
  core:hasLifecycleStatus core:Draft ;
  dct:created "2026-10-22"^^xsd:date ;
  dct:modified "2026-10-22T19:46:03Z"^^xsd:dateTime .

jtbd:social-job
  a owl:Class ;
  rdfs:label "Social job"@en ;
  skos:prefLabel "Social job"@en ;
  skos:definition "A job to be done that states how the job executor wants to be seen by others while getting functional jobs done."@en ;
  rdfs:subClassOf jtbd:job-to-be-done ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/jobs-to-be-done/> ;
  core:hasLifecycleStatus core:Draft ;
  dct:created "2026-10-22"^^xsd:date ;
  dct:modified "2026-10-22T19:46:03Z"^^xsd:dateTime .

jtbd:job-step
  a owl:Class ;
  rdfs:label "Job step"@en ;
  skos:prefLabel "Job step"@en ;
  skos:definition "A job step that is one stage of one job to be done, placed on the universal job map."@en ;
  rdfs:subClassOf core:job-step ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/jobs-to-be-done/> ;
  core:hasPrimaryTerm processvoc:step ;
  core:hasLifecycleStatus core:Draft ;
