      <https://www.insperity.com/taxonomy/core-governance/data-governance-council> .
  
  <https://www.insperity.com/taxonomy/core-governance/governance-discipline> a skos:Concept;
    skos:prefLabel "Governance discipline"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A governance area of practice that directs and oversees a defined subject."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-governance/>;
    skos:altLabel "Governance domain"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-governance/>;
