  partnerchannel:channel-partner
    a owl:Class ;
    rdfs:label "Channel partner"@en ;
    skos:prefLabel "Channel partner"@en ;
    skos:definition "A role borne by an organization that refers, sells or integrates with the organization's offerings under a partner agreement."@en ;
    rdfs:subClassOf [
