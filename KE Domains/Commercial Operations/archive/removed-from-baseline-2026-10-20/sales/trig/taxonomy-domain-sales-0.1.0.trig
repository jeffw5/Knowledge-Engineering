  domainsalestax:objection-handling
    a skos:Concept ;
    rdfs:label "Objection handling"@en ;
    skos:prefLabel "Objection handling"@en ;
    skos:definition "A selling activity that answers a buyer's objection so that the decision can proceed."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/> ;
    skos:broader domainsalestax:selling-activity ;
