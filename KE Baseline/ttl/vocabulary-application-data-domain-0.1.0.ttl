voc:stock-item
  a skos:Concept ;
  skos:prefLabel "Stock item"@en ;
  skos:definition "Data required by the supply chain, including the catalog, inventory, and shipment tracking of physical goods."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
