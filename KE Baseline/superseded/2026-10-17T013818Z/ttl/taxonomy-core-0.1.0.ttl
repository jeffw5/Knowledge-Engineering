  dct:created "2026-10-16T23:03:55Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T23:03:55Z"^^xsd:dateTime .

tax:taxonomy
  a skos:Concept ;
  skos:prefLabel "Taxonomy"@en ;
  skos:altLabel "Classification scheme"@en , "Concept scheme"@en ;
  skos:definition "A knowledge artifact that arranges concepts into a classification hierarchy."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core/> ;
  skos:broader tax:knowledge-artifact ;
  dc:subject tax:taxonomy ;
  owl:versionInfo "0.1.0" ;
