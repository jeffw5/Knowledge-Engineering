voc:resource-network-and-device
  a skos:Concept ;
  skos:prefLabel "Resource (network & device)"@en ;
  skos:definition "Represents roles, information and activities carried out by parties (e.g. individuals / organizations) playing roles that are involved in the strategic planning, definition, development and operational aspects of Resources (e.g. functions, applications, computing, networking and storage) that represent the infrastructure of an enterprise that are used to realize Services. The Resource domain includes physical and logical components of the telecom infrastructure that are used to support and deliver services. This includes hardware, software, network elements, and virtual resources such as VNFs and containers, which are provisioned, configured, and managed to enable network services. • Physical resources: Routers, switches, base stations, fiber cables, servers • Logical resources: IP addresses, VLANs, transport tunnels, slices • Virtual resources: Virtual Machines (VMs), containers, SDN-controlled links, virtual routers • Software resources: Network function applications Activities include management of: strategies, capabilities, lifecycles, inventories, topologies, installations, activations, alarms, problems, performance, mediation, usage statistics and support of Resources that are managed by an enterprise."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:data-domain ;
  skos:narrower voc:resource ,
      voc:resource-capacity ,
      voc:resource-configuration ,
      voc:resource-order ,
      voc:resource-performance ,
      voc:resource-specification ,
      voc:resource-strategy-and-plan ,
      voc:resource-test ,
      voc:resource-topology ,
      voc:resource-trouble ,
      voc:resource-usage ,
      voc:stock-item ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-10-24T20:05:46.942Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

