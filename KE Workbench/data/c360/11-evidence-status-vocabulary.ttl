<https://www.insperity.com/vocabulary/evidence-status/> a skos:ConceptScheme ;
    rdfs:label "Evidence status vocabulary"@en ;
    skos:prefLabel "Evidence status vocabulary"@en ;
    skos:definition "A concept scheme of how far a jobs-to-be-done element has been validated by qualitative and quantitative research."@en ;
    skos:hasTopConcept evid:candidate, evid:validated, evid:benchmarked, evid:retired ;
    dcterms:title "Evidence status vocabulary"@en ;
    dcterms:description "A concept scheme of how far a jobs-to-be-done element has been validated by qualitative and quantitative research."@en ;
    dcterms:subject domaintax:EnterpriseArchitecture ;
    vaem:namespace "https://www.insperity.com/vocabulary/evidence-status/"^^xsd:anyURI ;
    vann:preferredNamespacePrefix "evid" ;
    dcterms:language "en" ;
    dcterms:creator "Jeffrey Wallk" ;
    dcterms:publisher <https://www.insperity.com/resource/core/Organization/insperity> ;
    dcterms:conformsTo <http://purl.obolibrary.org/obo/bfo/2020/bfo.owl> , <https://www.insperity.com/standard/semantic-governance/1.9/> ;
    skos:changeNote "0.3.0 (2026-10-22): classes and taxonomy concepts renamed to lower-case hyphenated identifiers (Semantic Governance v1.9 §3.2 as amended for Baseline Core v1.0); classes aligned to Baseline Core v1.0; header fields added (§3.11)."@en ;
