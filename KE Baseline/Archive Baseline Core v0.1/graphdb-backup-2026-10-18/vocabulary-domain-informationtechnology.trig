<https://www.insperity.com/vocabulary/domain-informationtechnology/> {
  <https://www.insperity.com/vocabulary/domain-informationtechnology/> a skos:ConceptScheme;
    rdfs:label "Domain informationtechnology vocabulary"@en;
    skos:prefLabel "Domain informationtechnology vocabulary"@en;
    skos:hasTopConcept domaininformationtechnologyvoc:information-technology;
    terms:description "The use of computers and telecommunications equipment to store, retrieve, transmit, and manipulate data."@en;
    terms:title "Domain informationtechnology vocabulary"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2025-03-25T17:02:21.006Z"^^xsd:dateTime .
  
  domaininformationtechnologyvoc:information-technology a skos:Concept;
    skos:prefLabel "Information technology"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-25T17:27:38.486Z"^^xsd:dateTime;
    skos:definition "The use of computers and telecommunications equipment to store, retrieve, transmit, and manipulate data."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-informationtechnology/> .
  
  domaininformationtechnologyvoc:continual-service-improvement a skos:Concept;
    skos:prefLabel "Continual service improvement"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:44.351Z"^^xsd:dateTime;
    skos:definition "The process of identifying and implementing improvements to IT services to increase efficiency, effectiveness, and customer satisfaction."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-informationtechnology/>;
    skos:broader domaininformationtechnologyvoc:information-technology .
  
  domaininformationtechnologyvoc:service-design a skos:Concept;
    skos:prefLabel "Service design"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:57.530Z"^^xsd:dateTime;
    skos:definition "The process of designing new or changed IT services to meet the needs of customers."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-informationtechnology/>;
    skos:broader domaininformationtechnologyvoc:information-technology .
  
  domaininformationtechnologyvoc:service-operation a skos:Concept;
    skos:prefLabel "Service operation"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:57.530Z"^^xsd:dateTime;
    skos:definition "The stage of the ITIL lifecycle that deals with the day-to-day operation of IT services."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-informationtechnology/>;
    skos:broader domaininformationtechnologyvoc:information-technology .
  
  domaininformationtechnologyvoc:service-strategy a skos:Concept;
    skos:prefLabel "Service strategy"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:57.530Z"^^xsd:dateTime;
    skos:definition "The stage of the ITIL lifecycle that deals with the overall strategy for IT services."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-informationtechnology/>;
    skos:broader domaininformationtechnologyvoc:information-technology .
  
  domaininformationtechnologyvoc:service-transition a skos:Concept;
    skos:prefLabel "Service transition"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:57.530Z"^^xsd:dateTime;
    skos:definition "The stage of the ITIL lifecycle that deals with the transition of new or changed IT services into operation."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-informationtechnology/>;
    skos:broader domaininformationtechnologyvoc:information-technology .
  
  domaininformationtechnologyvoc:360-learning a skos:Concept;
    skos:prefLabel "360 learning"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:44.351Z"^^xsd:dateTime;
    skos:definition "A holistic approach to learning and development that involves gathering feedback from multiple sources (peers, managers, self, etc.) to gain a comprehensive view of an individual’s skills and development needs."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-informationtechnology/>;
    skos:broader domaininformationtechnologyvoc:continual-service-improvement .
  
  domaininformationtechnologyvoc:continual-service-improvement-monitoring a skos:Concept;
    skos:prefLabel "Continual service improvement monitoring"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:44.351Z"^^xsd:dateTime;
    skos:definition "The ongoing process of collecting and analyzing data to track the performance of IT services and identify areas for improvement."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-informationtechnology/>;
    skos:broader domaininformationtechnologyvoc:continual-service-improvement .
  
  domaininformationtechnologyvoc:continual-service-improvement-service-evaluation a
      skos:Concept;
    skos:prefLabel "Continual service improvement service evaluation"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:44.351Z"^^xsd:dateTime;
    skos:definition "The systematic assessment of IT services to determine their effectiveness, efficiency, and overall value."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-informationtechnology/>;
    skos:broader domaininformationtechnologyvoc:continual-service-improvement .
  
  domaininformationtechnologyvoc:continual-service-improvement-service-management a
      skos:Concept;
    skos:prefLabel "Continual service improvement service management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:44.351Z"^^xsd:dateTime;
    skos:definition "The integration of CSI principles and practices into all aspects of IT service management."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-informationtechnology/>;
    skos:broader domaininformationtechnologyvoc:continual-service-improvement .
  
  domaininformationtechnologyvoc:continual-service-improvement-service-measurement a
      skos:Concept;
    skos:prefLabel "Continual service improvement service measurement"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:44.351Z"^^xsd:dateTime;
    skos:definition "The process of defining, collecting, and analyzing data to measure the performance of IT services and identify areas for improvement."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-informationtechnology/>;
    skos:broader domaininformationtechnologyvoc:continual-service-improvement .
  
  domaininformationtechnologyvoc:improvement-initiatives-definition a skos:Concept;
    skos:prefLabel "Improvement initiatives definition"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:44.351Z"^^xsd:dateTime;
    skos:definition "The process of clearly defining improvement initiatives, including their goals, objectives, scope, and stakeholders."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-informationtechnology/>;
    skos:broader domaininformationtechnologyvoc:continual-service-improvement .
  
  domaininformationtechnologyvoc:process-evaluation a skos:Concept;
    skos:prefLabel "Process evaluation"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:44.351Z"^^xsd:dateTime;
    skos:definition "The systematic assessment of a process to determine its effectiveness, efficiency, and overall value."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-informationtechnology/>;
    skos:broader domaininformationtechnologyvoc:continual-service-improvement .
  
  domaininformationtechnologyvoc:service-reporting a skos:Concept;
    skos:prefLabel "Service reporting"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:57.530Z"^^xsd:dateTime;
    skos:definition "The process of providing information about the performance of IT services to stakeholders."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-informationtechnology/>;
    skos:broader domaininformationtechnologyvoc:continual-service-improvement .
  
  domaininformationtechnologyvoc:business-continuity-management a skos:Concept;
    skos:prefLabel "Business continuity management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:44.351Z"^^xsd:dateTime;
    skos:definition "The process of creating systems of prevention and recovery to deal with potential threats to an organization."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-informationtechnology/>;
    skos:broader domaininformationtechnologyvoc:continual-service-improvement-service-management .
  
  domaininformationtechnologyvoc:process-automation a skos:Concept;
    skos:prefLabel "Process automation"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:44.351Z"^^xsd:dateTime;
    skos:definition "The use of technology to automate business processes, typically to improve efficiency, reduce costs, and minimize errors."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-informationtechnology/>;
    skos:broader domaininformationtechnologyvoc:continual-service-improvement-service-management .
  
  domaininformationtechnologyvoc:service-catalog-development a skos:Concept;
    skos:prefLabel "Service catalog development"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:57.530Z"^^xsd:dateTime;
    skos:definition "The process of creating and maintaining a comprehensive and accurate catalog of all IT services offered to customers."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-informationtechnology/>;
    skos:broader domaininformationtechnologyvoc:continual-service-improvement-service-management .
  
  domaininformationtechnologyvoc:service-management-business-continuity-management a
      skos:Concept;
    skos:prefLabel "Service management business continuity management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:57.530Z"^^xsd:dateTime;
    skos:definition "The integration of BCM principles and practices into IT service management to ensure the continuity of critical IT services in the event of a disruption."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-informationtechnology/> .
  
  domaininformationtechnologyvoc:service-management-event-management a skos:Concept;
    skos:prefLabel "Service management event management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:57.530Z"^^xsd:dateTime;
    skos:definition "The process of managing events that could impact IT services, including identifying, analyzing, and responding to events."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-informationtechnology/> .
  
  domaininformationtechnologyvoc:service-management-integration a skos:Concept;
    skos:prefLabel "Service management integration"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:57.530Z"^^xsd:dateTime;
    skos:definition "The coordination and alignment of different IT service management processes to ensure they work together effectively."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-informationtechnology/> .
  
  domaininformationtechnologyvoc:service-management-service-catalog-development a skos:Concept;
    skos:prefLabel "Service management service catalog development"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:57.530Z"^^xsd:dateTime;
    skos:definition "The process of creating and maintaining a comprehensive and accurate catalog of all IT services offered to customers."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-informationtechnology/> .
  
  domaininformationtechnologyvoc:service-management-service-catalog-planning a skos:Concept;
    skos:prefLabel "Service management service catalog planning"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:57.530Z"^^xsd:dateTime;
    skos:definition "The process of planning for the development, implementation, and maintenance of the service catalog."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-informationtechnology/> .
  
  domaininformationtechnologyvoc:service-measurement-service-catalog-planning a skos:Concept;
    skos:prefLabel "Service measurement service catalog planning"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:57.530Z"^^xsd:dateTime;
    skos:definition "The process of planning for the measurement of IT services, including defining metrics, collecting data, and analyzing results."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-informationtechnology/> .
  
  domaininformationtechnologyvoc:availability-management a skos:Concept;
    skos:prefLabel "Availability management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:44.351Z"^^xsd:dateTime;
    skos:definition "The process of ensuring that IT services are available to users when they need them."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-informationtechnology/> .
  
  domaininformationtechnologyvoc:capacity-planning a skos:Concept;
    skos:prefLabel "Capacity planning"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:44.351Z"^^xsd:dateTime;
    skos:definition "The process of determining the production capacity required by an organization to meet changing demands for its products or services."@en;
