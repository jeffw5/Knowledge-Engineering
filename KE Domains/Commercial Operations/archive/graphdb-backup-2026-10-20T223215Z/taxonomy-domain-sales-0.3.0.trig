    terms:subject domainvoc:sales, domaincommercialoperationsvoc:stage;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-sales/>;
    skos:narrower domainsalestax:decide, domainsalestax:discover, domainsalestax:evaluate,
      domainsalestax:onboard, domainsalestax:propose, domainsalestax:qualify;
    core:hasPrimaryTerm domaincommercialoperationsvoc:stage;
    core:formalizedBy domainsales:selling-step;
    skos:broadMatch processtax:process-step .
  
