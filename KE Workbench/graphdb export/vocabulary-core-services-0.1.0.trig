<https://www.insperity.com/vocabulary/core-services/> {
  <https://www.insperity.com/vocabulary/core-services/> a skos:ConceptScheme;
    rdfs:label "Core services vocabulary"@en;
    skos:prefLabel "Core services vocabulary"@en;
    skos:hasTopConcept servicesvoc:services;
    terms:description "Intangible activities or benefits provided by one party to another."@en;
    terms:title "Core services vocabulary"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2025-03-25T16:59:03.618Z"^^xsd:dateTime;
    skos:altLabel "Vocabulary | Core | Services"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/vocabulary/core-services/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  servicesvoc:services a skos:Concept;
    skos:prefLabel "Services"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-25T17:23:29.451Z"^^xsd:dateTime;
    skos:definition "Intangible activities or benefits provided by one party to another, often in exchange for payment."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-services/>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/core-services/>;
    skos:narrower servicesvoc:business-services, servicesvoc:functional-services .
  
  servicesvoc:business-services a skos:Concept;
    skos:prefLabel "Business services"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:50:54.800Z"^^xsd:dateTime;
    skos:definition "A service provided to a business to support its core operations or achieve specific business outcomes."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-services/>;
    skos:broader servicesvoc:services;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower servicesvoc:commercial-services, servicesvoc:customer-services, servicesvoc:network-services,
      servicesvoc:product-services .
  
  servicesvoc:functional-services a skos:Concept;
    skos:prefLabel "Functional services"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:50:54.800Z"^^xsd:dateTime;
    skos:definition "A service that supports a specific business function, such as human resources, finance, or marketing."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-services/>;
    skos:broader servicesvoc:services;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower servicesvoc:business-operations, servicesvoc:data-and-analytic-services,
      servicesvoc:data-stewardship, servicesvoc:financial-services, servicesvoc:knowledge-exploration,
      servicesvoc:order-entry, servicesvoc:order-fulfillment, servicesvoc:policy-management,
      servicesvoc:risk-management, servicesvoc:security-management, servicesvoc:service-level-management,
      servicesvoc:service-resource-assignment, servicesvoc:service-usage-tracking, servicesvoc:threat-management .
  
  servicesvoc:commercial-services a skos:Concept;
    skos:prefLabel "Commercial services"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:50:54.800Z"^^xsd:dateTime;
    skos:definition "Services designed for use by businesses and organizations, as opposed to individual consumers."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-services/>;
    skos:broader servicesvoc:business-services;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower servicesvoc:contract-management, servicesvoc:demand-management, servicesvoc:marketing-management,
      servicesvoc:pricing-management, servicesvoc:retail-operations, servicesvoc:sales-operations .
  
  servicesvoc:customer-services a skos:Concept;
    skos:prefLabel "Customer services"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:50:54.800Z"^^xsd:dateTime;
    skos:definition "Support provided to customers before, during, and after a purchase. It encompasses all interactions a customer has with a company."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-services/>;
    skos:broader servicesvoc:business-services;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  servicesvoc:network-services a skos:Concept;
    skos:prefLabel "Network services"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:50:54.800Z"^^xsd:dateTime;
    skos:definition "Services related to the design, implementation, and maintenance of computer networks."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-services/>;
    skos:broader servicesvoc:business-services;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  servicesvoc:product-services a skos:Concept;
    skos:prefLabel "Product services"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:50:54.800Z"^^xsd:dateTime;
    skos:definition "Services that are offered in conjunction with a physical product, such as installation, maintenance, or repair."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-services/>;
    skos:broader servicesvoc:business-services;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  servicesvoc:contract-management a skos:Concept;
    skos:prefLabel "Contract management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:50:54.800Z"^^xsd:dateTime;
    skos:definition "The process of managing contracts with customers, vendors, partners, or employees."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-services/>;
    skos:broader servicesvoc:commercial-services;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  servicesvoc:demand-management a skos:Concept;
    skos:prefLabel "Demand management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:50:54.800Z"^^xsd:dateTime;
    skos:definition "The process of forecasting, influencing, and fulfilling customer demand for products and services."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-services/>;
    skos:broader servicesvoc:commercial-services, servicesvoc:customer-services;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  servicesvoc:marketing-management a skos:Concept;
    skos:prefLabel "Marketing management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:50:54.800Z"^^xsd:dateTime;
    skos:definition "The process of planning, executing, and measuring marketing campaigns to achieve specific business goals."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-services/>;
    skos:broader servicesvoc:commercial-services;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  servicesvoc:pricing-management a skos:Concept;
    skos:prefLabel "Pricing management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:50:54.800Z"^^xsd:dateTime;
    skos:definition "The process of setting and adjusting prices for products and services to maximize profitability."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-services/>;
    skos:broader servicesvoc:commercial-services;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  servicesvoc:retail-operations a skos:Concept;
    skos:prefLabel "Retail operations"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:50:54.800Z"^^xsd:dateTime;
    skos:definition "All activities related to selling goods or services directly to consumers for their personal use."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-services/>;
    skos:broader servicesvoc:commercial-services;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  servicesvoc:sales-operations a skos:Concept;
    skos:prefLabel "Sales operations"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:50:54.800Z"^^xsd:dateTime;
    skos:definition "All activities that support the sales process, including sales forecasting, territory planning, and sales training."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-services/>;
    skos:broader servicesvoc:commercial-services;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  servicesvoc:advertising a skos:Concept;
    skos:prefLabel "Advertising"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:50:54.800Z"^^xsd:dateTime;
    skos:definition "A form of marketing communication that uses paid media to reach a target audience with persuasive messages."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-services/>;
    skos:broader servicesvoc:marketing-management;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  servicesvoc:campaign-management a skos:Concept;
    skos:prefLabel "Campaign management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:50:54.800Z"^^xsd:dateTime;
    skos:definition "The process of planning, executing, and measuring marketing campaigns across multiple channels."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-services/>;
    skos:broader servicesvoc:marketing-management;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  servicesvoc:competitive-analysis a skos:Concept;
    skos:prefLabel "Competitive analysis"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:50:54.800Z"^^xsd:dateTime;
    skos:definition "The process of identifying and evaluating competitors to understand their strengths, weaknesses, and strategies."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-services/>;
    skos:broader servicesvoc:marketing-management;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  servicesvoc:marketing-monitoring-and-measurement a skos:Concept;
    skos:prefLabel "Marketing monitoring & measurement"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:50:54.800Z"^^xsd:dateTime;
    skos:definition "The process of tracking, analyzing, and reporting on the performance of marketing campaigns and activities."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-services/>;
    skos:broader servicesvoc:marketing-management;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  servicesvoc:competitive-benchmarking a skos:Concept;
    skos:prefLabel "Competitive benchmarking"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:50:54.800Z"^^xsd:dateTime;
    skos:definition "The process of comparing a company’s products, services, and processes against those of its competitors or industry best practices."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-services/>;
    skos:broader servicesvoc:competitive-analysis;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  servicesvoc:industry-standards a skos:Concept;
    skos:prefLabel "Industry standards"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:50:54.800Z"^^xsd:dateTime;
    skos:definition "Established norms, guidelines, or specifications that define acceptable quality, performance, or safety levels within a particular industry."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-services/>;
    skos:broader servicesvoc:competitive-analysis;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  servicesvoc:innovation a skos:Concept;
    skos:prefLabel "Innovation"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:50:54.800Z"^^xsd:dateTime;
    skos:definition "The process of introducing new ideas, products, services, or processes that create value."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-services/>;
    skos:broader servicesvoc:competitive-analysis;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  servicesvoc:market-differentiation a skos:Concept;
    skos:prefLabel "Market differentiation"@en;
    terms:creator "Jeffrey Wallk";
