  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-03-31T20:34:58.047Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:manufacturing
  a skos:Concept ;
  skos:prefLabel "Manufacturing"@en ;
  skos:definition "The process of converting raw materials into finished goods."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-supplychain/> ;
  skos:broader voc:supply-chain ;
