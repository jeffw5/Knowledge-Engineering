<https://www.insperity.com/vocabulary/core-asset/>
  a skos:ConceptScheme ;
  rdfs:label "Core asset vocabulary"@en ;
  skos:prefLabel "Core asset vocabulary"@en ;
  dct:title "Core asset vocabulary"@en ;
  skos:altLabel "Vocabulary | Core | Asset"@en ;
  dct:description "A controlled vocabulary of preferred terms, synonyms and definitions for the kinds of asset an organization controls (physical, biological, human and digital) and for the digital assets that data, analytics, knowledge and artificial intelligence work produces: data, data products, analytics, artifacts, digital agents and intellectual property. It supplies the terms that the classes of the core asset ontology are anchored to."@en ;
  skos:hasTopConcept voc:asset ;
  vann:preferredNamespaceUri "https://www.insperity.com/vocabulary/core-asset/"^^xsd:anyURI ;
  dct:language "en" ;
  skos:editorialNote "Some definitions in this vocabulary were first drafted with the assistance of generative artificial intelligence tools."@en ;
  skos:changeNote "0.1.0 (2026-10-15): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:contributor "Jeffrey Wallk" ;
  dct:created "2025-03-25T16:59:57.433Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T01:55:00Z"^^xsd:dateTime .

voc:asset
  a skos:Concept ;
  skos:prefLabel "Asset"@en ;
  skos:definition "A resource controlled by an entity from which future economic benefits are expected to be generated."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-asset/> ;
  skos:topConceptOf <https://www.insperity.com/vocabulary/core-asset/> ;
  skos:narrower voc:biological-asset , voc:digital-asset , voc:physical-asset ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-03-25T17:24:34.035Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T01:55:00Z"^^xsd:dateTime .

voc:biological-asset
  a skos:Concept ;
  skos:prefLabel "Biological asset"@en ;
  skos:definition "A living animal or plant under the control of an entity, from which future economic benefits are expected (e.g., livestock, crops)."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-asset/> ;
  skos:broader voc:asset ;
  skos:narrower voc:human-asset ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-03-31T18:52:33.260Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T01:55:00Z"^^xsd:dateTime .

voc:human-asset
  a skos:Concept ;
  skos:prefLabel "Human asset"@en ;
  skos:definition "The skills, knowledge, and experience of an organization’s workforce, considered as a valuable resource."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-asset/> ;
  skos:broader voc:biological-asset ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-03-31T18:52:33.260Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T01:55:00Z"^^xsd:dateTime .

voc:digital-asset
  a skos:Concept ;
  skos:prefLabel "Digital asset"@en ;
  skos:definition "Any content or data in digital form that has value and is owned or controlled by an entity (e.g., websites, documents, multimedia)."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-asset/> ;
  skos:broader voc:asset ;
