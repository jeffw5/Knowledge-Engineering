  assettax:Facility
    a skos:Concept ;
    rdfs:label "Facility"@en ;
    skos:prefLabel "Facility"@en ;
    skos:altLabel "Building"@en , "Premises"@en ;
    skos:definition "A physical asset that is a building, room, or fixed installation used to house people, equipment, or operations."@en ;
    skos:example "Headquarters building; regional service center."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/core-asset/> ;
    skos:broader assettax:PhysicalAsset ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-17T01:38:18Z"^^xsd:dateTime ;
    dct:modified "2026-10-18T00:25:49Z"^^xsd:dateTime .

  assettax:Inventory
    a skos:Concept ;
    rdfs:label "Inventory"@en ;
    skos:prefLabel "Inventory"@en ;
    skos:altLabel "Stock"@en , "Supplies"@en ;
    skos:definition "A physical asset that is a stock of materials or goods held for use, sale, or distribution."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/core-asset/> ;
    skos:broader assettax:PhysicalAsset ;
    core:hasPrimaryTerm lifecyclevoc:inventory ;
    dct:subject lifecyclevoc:inventory ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-17T01:38:18Z"^^xsd:dateTime ;
    dct:modified "2026-10-18T00:25:49Z"^^xsd:dateTime .

  assettax:Vehicle
    a skos:Concept ;
    rdfs:label "Vehicle"@en ;
    skos:prefLabel "Vehicle"@en ;
    skos:altLabel "Fleet asset"@en ;
    skos:definition "A physical asset that is a means of transporting people or goods."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/core-asset/> ;
    skos:broader assettax:PhysicalAsset ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
