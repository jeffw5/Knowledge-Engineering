voc:enterprise-risk
  a skos:Concept ;
  skos:prefLabel "Enterprise risk"@en ;
  skos:definition "Represents all items that relate to risk of an enterprise. It also concerns security vulnerabilities and operational capability to resolve any detected degradations and violations"@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:enterprise-corporate ;
  skos:narrower voc:enterprise-security ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-10-24T20:07:48.966Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:enterprise-security
  a skos:Concept ;
  skos:prefLabel "Enterprise security"@en ;
  skos:definition "Data records related to security vulnerabilities, security events, and the operational capability to resolve detected degradations or violations."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:enterprise-risk ;
  owl:versionInfo "0.1.0" ;
