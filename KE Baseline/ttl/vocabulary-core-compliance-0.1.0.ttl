  a skos:Concept ;
  skos:prefLabel "California consumer privacy act"@en ;
  skos:altLabel "CCPA"@en ;
  skos:definition "A California law that enhances privacy rights and consumer protection for residents of California, with implications for businesses handling their data."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/> ;
