voc:sustainability
  a skos:Concept ;
  skos:prefLabel "Sustainability"@en ;
  skos:definition "Meeting the needs of the present without compromising the ability of future generations to meet their own needs."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/> ;
  skos:broader voc:business-operations ;
  skos:narrower voc:circular-economy ,
      voc:corporate-social-responsibility ,
      voc:economic-sustainability ,
      voc:environmental-sustainability ,
      voc:social-sustainability ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:circular-economy
  a skos:Concept ;
  skos:prefLabel "Circular economy"@en ;
  skos:definition "An economic system aimed at eliminating waste and the continual use of resources."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/> ;
  skos:broader voc:sustainability ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:corporate-social-responsibility
  a skos:Concept ;
  skos:prefLabel "Corporate social responsibility"@en ;
  skos:altLabel "CSR"@en ;
  skos:definition "A business approach that contributes to sustainable development by delivering economic, social and environmental benefits for all stakeholders."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/> ;
  skos:broader voc:sustainability ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:economic-sustainability
  a skos:Concept ;
  skos:prefLabel "Economic sustainability"@en ;
  skos:definition "Ensuring that business activities are profitable and contribute to economic growth."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/> ;
  skos:broader voc:sustainability ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:environmental-sustainability
  a skos:Concept ;
  skos:prefLabel "Environmental sustainability"@en ;
  skos:definition "Minimizing the negative impact of business activities on the environment."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/> ;
  skos:broader voc:sustainability ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:social-sustainability
  a skos:Concept ;
  skos:prefLabel "Social sustainability"@en ;
  skos:definition "Ensuring that business activities benefit society and do not have negative social impacts."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/> ;
  skos:broader voc:sustainability ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:technology
  a skos:Concept ;
  skos:prefLabel "Technology"@en ;
