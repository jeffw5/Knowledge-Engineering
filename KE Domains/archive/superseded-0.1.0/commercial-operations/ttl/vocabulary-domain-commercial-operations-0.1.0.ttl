  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-20"^^xsd:date ;
  dct:modified "2026-10-20T00:16:35Z"^^xsd:dateTime .

commercialopsvoc:opportunity
  a skos:Concept ;
  rdfs:label "opportunity"@en ;
  skos:prefLabel "opportunity"@en ;
  skos:altLabel "deal"@en ;
  skos:definition "A potential sale to a prospect or client that the organization has qualified and is actively pursuing, sized by the offerings and the number of workers it would cover."@en ;
  skos:scopeNote "The sales sense. The favorable external condition of a strengths, weaknesses, opportunities and threats analysis is a different sense and is not this term."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-commercial-operations/> ;
  skos:topConceptOf <https://www.insperity.com/vocabulary/domain-commercial-operations/> ;
  owl:versionInfo "0.1.0" ;
