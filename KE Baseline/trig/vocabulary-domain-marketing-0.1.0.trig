  voc:content-creation
    a skos:Concept ;
    skos:prefLabel "Content creation"@en ;
    skos:definition "The process of developing and producing various types of content, such as blog posts, articles, videos, and infographics."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
