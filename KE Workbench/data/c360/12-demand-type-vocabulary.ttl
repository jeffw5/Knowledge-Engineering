<https://www.insperity.com/vocabulary/demand-type/> a skos:ConceptScheme ;
    rdfs:label "Demand type vocabulary"@en ;
    skos:prefLabel "Demand type vocabulary"@en ;
    skos:definition "A concept scheme of the kinds of work a demand request asks for, taken from the outcome playbook's action rule."@en ;
    skos:hasTopConcept dtype:fix, dtype:innovate, dtype:protect, dtype:simplify ;
    dcterms:title "Demand type vocabulary"@en ;
    dcterms:description "A concept scheme of the kinds of work a demand request asks for, taken from the outcome playbook's action rule."@en ;
    dcterms:subject domaintax:EnterpriseArchitecture ;
    vaem:namespace "https://www.insperity.com/vocabulary/demand-type/"^^xsd:anyURI ;
    vann:preferredNamespacePrefix "dtype" ;
