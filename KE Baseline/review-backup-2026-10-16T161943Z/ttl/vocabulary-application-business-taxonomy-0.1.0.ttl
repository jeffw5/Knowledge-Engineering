voc:wholesale
  a skos:Concept ;
  skos:prefLabel "Wholesale"@en ;
  skos:definition "The sale of goods in large quantities, typically to retailers, who then sell to consumers."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
