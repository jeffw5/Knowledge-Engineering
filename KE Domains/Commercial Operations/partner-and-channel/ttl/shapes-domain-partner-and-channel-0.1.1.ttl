partnerchannelshp:channel-partner-shape
  a sh:NodeShape ;
  rdfs:label "Channel partner shape"@en ;
  skos:prefLabel "Channel partner shape"@en ;
  skos:definition "A shape that checks the channel partner role is borne by an organization."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-partner-and-channel/> ;
  sh:targetClass partnerchannel:channel-partner ;
  sh:property [
      sh:path core:roleOf ;
      sh:class core:organization ;
      sh:message "A channel partner role must be borne by an organization."@en ;
      sh:minCount "1"^^xsd:integer
  ] ;
  owl:versionInfo "0.1.1" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-20"^^xsd:date ;
  dct:modified "2026-10-20T04:19:14Z"^^xsd:dateTime .

partnerchannelshp:partner-program-shape
  a sh:NodeShape ;
  rdfs:label "Partner program shape"@en ;
  skos:prefLabel "Partner program shape"@en ;
  skos:definition "A shape that checks a partner program governs channel partners."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-partner-and-channel/> ;
  sh:targetClass partnerchannel:partner-program ;
  sh:property [
      sh:path core:governs ;
      sh:message "A partner program should govern the channel partners enrolled in it."@en ;
      sh:minCount "1"^^xsd:integer ;
      sh:severity sh:Warning
  ] ;
  owl:versionInfo "0.1.1" ;
  core:hasLifecycleStatus core:Draft ;
