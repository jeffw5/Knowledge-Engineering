    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    skos:changeNote "0.2.0 (2026-10-21): Restructured to the operational areas and the naming standard (D26, D27): titled 'Domain Sales.Partner & Channel Vocabulary', '… Taxonomy', '… Ontology' and '… Shapes', at …/<kind>/domain-sales.partner-and-channel/ (formerly the Partner and channel domain, …/<kind>/domain-partner-and-channel/), now an L2 domain of Domain Sales. Built by build_domains.py from spec_sales_partner_and_channel.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_sales_partner_and_channel.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.1.1 (2026-10-20): Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_sales_partner_and_channel.py against Baseline Core v1.0 (core 0.1.0)."@en;
    terms:created "2026-10-22"^^xsd:date;
    owl:versionInfo "0.2.0";
    terms:subject domainvoc:commercial;
    terms:isPartOf <https://www.insperity.com/taxonomy/commercial-operations/>;
    owl:versionIRI <https://www.insperity.com/taxonomy/domain-sales.partner-and-channel/0.2.0/>;
