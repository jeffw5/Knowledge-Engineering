voc:workforce-schedule
  a skos:Concept ;
  skos:prefLabel "Workforce schedule"@en ;
  skos:definition "Data defining the planning, reservation, and assignment of a technician or resource to a specific task or time slot."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
