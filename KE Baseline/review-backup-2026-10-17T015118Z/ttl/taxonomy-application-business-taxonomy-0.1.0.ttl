tax:Ownership
  a owl:Class ;
  rdfs:label "Ownership"@en ;
  skos:prefLabel "Ownership"@en ;
  skos:definition "The recognized right and practical capability to exercise exclusive control over a digital asset—including the powers to access, use, derive economic benefit from, restrict others from accessing, and irrevocably transfer or dispose of that asset—either through legal title (contractual and intellectual property rights) or cryptographic control (possession of private keys and ledger state authority)."@en ;
  rdfs:subClassOf tax:BusinessTaxonomyFilters ;
  rdfs:isDefinedBy <https://www.insperity.com/taxonomy/application-business-taxonomy/> ;
  dc:subject applicationbusinesstaxonomyvoc:ownership ;
