pricingcontractsvoc:census
  a skos:Concept ;
  rdfs:label "census"@en ;
  skos:prefLabel "census"@en ;
  skos:definition "A list of a prospective client's employees with the attributes needed to price benefits and coverage, such as age, location, pay and coverage elections."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-pricing-and-contracts/> ;
