    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:brand-positioning
    a skos:Concept ;
    skos:prefLabel "Brand positioning"@en ;
    skos:definition "The process of establishing a unique and desirable image for a brand in the minds of target customers."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
    skos:broader voc:brand-management ;
