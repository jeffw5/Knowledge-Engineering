    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "Data representing non-physical infrastructure components (e.g., IP addresses, VLANs, virtual machines)."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/PhysicalResource> skos:prefLabel
      "Physical resource"@en;
