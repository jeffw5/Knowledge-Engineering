  voc:rules
    a skos:Concept ;
    skos:prefLabel "Rules"@en ;
    skos:definition "Statements that define or restrict an organization's activities, guiding decision-making and ensuring actions align with business strategy, ultimately streamlining operations and enhancing efficiency."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/core-rules/> ;
    skos:narrower voc:decision-logic , voc:process-flow , voc:structural-rule ;
