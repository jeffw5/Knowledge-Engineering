issuevoc:issue
  a skos:Concept ;
  rdfs:label "Issue"@en ;
  skos:prefLabel "Issue"@en ;
  skos:definition "A generic term used to describe any problem, concern, or question that needs to be addressed. It is a broad term that encompasses defects, incidents, problems, requests, needs, and questions."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-issue/> ;
