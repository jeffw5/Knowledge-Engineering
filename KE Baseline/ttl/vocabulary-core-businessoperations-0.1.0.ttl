  dct:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:outbound-logistics
  a skos:Concept ;
  skos:prefLabel "Outbound logistics"@en ;
  skos:definition "The collection, storage, and distribution of finished goods to customers."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/> ;
  skos:broader voc:value-chain-analysis ;
  owl:versionInfo "0.1.0" ;
