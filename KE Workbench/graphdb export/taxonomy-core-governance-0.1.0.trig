<https://www.insperity.com/taxonomy/core-governance/> {
  <https://www.insperity.com/taxonomy/core-governance/> a skos:ConceptScheme;
    rdfs:label "Core governance taxonomy"@en;
    skos:prefLabel "Core governance taxonomy"@en;
    skos:hasTopConcept <https://www.insperity.com/taxonomy/core-governance/control>, <https://www.insperity.com/taxonomy/core-governance/governance-activity>,
      <https://www.insperity.com/taxonomy/core-governance/governance-body>, <https://www.insperity.com/taxonomy/core-governance/governance-discipline>,
      <https://www.insperity.com/taxonomy/core-governance/governance-record>;
    terms:description "Classification of governance concepts, the disciplines, bodies, controls, activities, and records through which the organization directs, oversees, and assures its work, data, knowledge, and artificial intelligence."@en;
    terms:title "Core governance taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2026-10-14"^^xsd:dateTime;
    skos:altLabel "Governance taxonomy"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/taxonomy/core-governance/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-governance/control> a skos:Concept;
    skos:prefLabel "Control"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A governance measure that modifies risk by preventing, detecting, or correcting unwanted outcomes."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-governance/>;
    skos:altLabel "Internal control"@en, "Safeguard"@en;
    owl:versionInfo "0.1.0";
    dc:subject applicationbusinesstaxonomyvoc:internal-control;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-governance/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-governance/access-control>,
      <https://www.insperity.com/taxonomy/core-governance/corrective-control>, <https://www.insperity.com/taxonomy/core-governance/detective-control>,
      <https://www.insperity.com/taxonomy/core-governance/human-oversight>, <https://www.insperity.com/taxonomy/core-governance/preventive-control>,
      <https://www.insperity.com/taxonomy/core-governance/quality-gate>, <https://www.insperity.com/taxonomy/core-governance/segregation-of-duties> .
  
  <https://www.insperity.com/taxonomy/core-governance/governance-activity> a skos:Concept;
    skos:prefLabel "Governance activity"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A governance process step undertaken to direct, assure, or improve governed work."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-governance/>;
    skos:altLabel "Assurance activity"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-governance/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-governance/impact-assessment>,
      <https://www.insperity.com/taxonomy/core-governance/attestation>, <https://www.insperity.com/taxonomy/core-governance/audit>,
      <https://www.insperity.com/taxonomy/core-governance/change-control>, <https://www.insperity.com/taxonomy/core-governance/monitoring>,
      <https://www.insperity.com/taxonomy/core-governance/review>, <https://www.insperity.com/taxonomy/core-governance/risk-assessment> .
  
  <https://www.insperity.com/taxonomy/core-governance/governance-body> a skos:Concept;
    skos:prefLabel "Governance body"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A governance structure that is a group with authority to make or review governance decisions."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-governance/>;
    skos:altLabel "Governing body"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-governance/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-governance/architecture-review-board>,
      <https://www.insperity.com/taxonomy/core-governance/artificial-intelligence-oversight-committee>,
