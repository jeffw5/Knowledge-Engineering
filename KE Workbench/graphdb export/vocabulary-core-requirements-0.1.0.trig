<https://www.insperity.com/vocabulary/core-requirements/> {
  <https://www.insperity.com/vocabulary/core-requirements/> a skos:ConceptScheme;
    rdfs:label "Core requirements vocabulary"@en;
    skos:prefLabel "Core requirements vocabulary"@en;
    skos:hasTopConcept requirementsvoc:requirements;
    terms:description "Statements that describe what a product or service should do and the constraints under which it must operate."@en;
    terms:title "Core requirements vocabulary"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2025-03-25T17:01:01.370Z"^^xsd:dateTime;
    skos:altLabel "Vocabulary | Core | Requirements"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/vocabulary/core-requirements/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  requirementsvoc:requirements a skos:Concept;
    skos:prefLabel "Requirements"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-25T17:25:47.474Z"^^xsd:dateTime;
    skos:definition "Statements that describe what a product or service should do and the constraints under which it must operate."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-requirements/>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/core-requirements/>;
    skos:narrower requirementsvoc:job, requirementsvoc:journey, requirementsvoc:outcome,
      requirementsvoc:requirement .
  
  requirementsvoc:job a skos:Concept;
    skos:prefLabel "Job"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:54:17.113Z"^^xsd:dateTime;
    skos:definition "A high-level task or activity that a user wants to accomplish."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-requirements/>;
    skos:broader requirementsvoc:requirements;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower requirementsvoc:emotional-job, requirementsvoc:functional-job, requirementsvoc:supporting-job .
  
  requirementsvoc:journey a skos:Concept;
    skos:prefLabel "Journey"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:54:17.113Z"^^xsd:dateTime;
    skos:definition "The end-to-end experience a user has while interacting with a product or service."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-requirements/>;
    skos:broader requirementsvoc:requirements;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower requirementsvoc:journey-step .
  
  requirementsvoc:outcome a skos:Concept;
    skos:prefLabel "Outcome"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:54:17.113Z"^^xsd:dateTime;
    skos:definition "The desired result or benefit that a user aims to achieve by completing a job."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-requirements/>;
    skos:broader requirementsvoc:requirements;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  requirementsvoc:requirement a skos:Concept;
    skos:prefLabel "Requirement"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:54:17.113Z"^^xsd:dateTime;
    skos:definition "A specific, documented need that a product or service must fulfill."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-requirements/>;
    skos:broader requirementsvoc:requirements;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower requirementsvoc:need, requirementsvoc:specification .
  
  requirementsvoc:emotional-job a skos:Concept;
    skos:prefLabel "Emotional job"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:54:17.113Z"^^xsd:dateTime;
    skos:definition "The underlying emotional needs and motivations that drive users to engage with a product or service."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-requirements/>;
    skos:broader requirementsvoc:job;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  requirementsvoc:functional-job a skos:Concept;
    skos:prefLabel "Functional job"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:54:17.113Z"^^xsd:dateTime;
    skos:definition "The specific tasks and actions that users need to perform to accomplish their goals."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-requirements/>;
    skos:broader requirementsvoc:job;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower requirementsvoc:job-step .
  
  requirementsvoc:supporting-job a skos:Concept;
    skos:prefLabel "Supporting job"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:54:17.113Z"^^xsd:dateTime;
    skos:definition "A job that is necessary to enable or facilitate the completion of a primary job."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-requirements/>;
    skos:broader requirementsvoc:job;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  requirementsvoc:job-step a skos:Concept;
    skos:prefLabel "Job step"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:54:17.113Z"^^xsd:dateTime;
    skos:definition "A discrete action or sub-task within a larger job."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-requirements/>;
    skos:broader requirementsvoc:functional-job;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  requirementsvoc:journey-step a skos:Concept;
    skos:prefLabel "Journey step"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:54:17.113Z"^^xsd:dateTime;
    skos:definition "A specific stage or touchpoint within a user journey."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-requirements/>;
    skos:broader requirementsvoc:journey;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  requirementsvoc:need a skos:Concept;
    skos:prefLabel "Need"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:54:17.113Z"^^xsd:dateTime;
    skos:definition "A high-level problem or opportunity that a product or service aims to address."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-requirements/>;
    skos:broader requirementsvoc:requirement;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower requirementsvoc:job-executor .
  
  requirementsvoc:specification a skos:Concept;
    skos:prefLabel "Specification"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:54:17.113Z"^^xsd:dateTime;
    skos:definition "A detailed description of a product or service’s technical requirements."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-requirements/>;
    skos:broader requirementsvoc:requirement;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower requirementsvoc:feature .
  
  requirementsvoc:job-executor a skos:Concept;
    skos:prefLabel "Job executor"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:54:17.113Z"^^xsd:dateTime;
    skos:definition "The person or system responsible for performing a job."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-requirements/>;
    skos:broader requirementsvoc:need;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  requirementsvoc:feature a skos:Concept;
    skos:prefLabel "Feature"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:54:17.113Z"^^xsd:dateTime;
    skos:definition "A distinct function or attribute of a product or service."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-requirements/>;
    skos:broader requirementsvoc:specification;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower requirementsvoc:functional-feature .
  
  requirementsvoc:functional-feature a skos:Concept;
    skos:prefLabel "Functional feature"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:54:17.113Z"^^xsd:dateTime;
    skos:definition "A feature that relates to the core functionality of a product or service."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-requirements/>;
    skos:broader requirementsvoc:feature;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower requirementsvoc:non-functional-feature .
  
  requirementsvoc:non-functional-feature a skos:Concept;
    skos:prefLabel "Non-Functional feature"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:54:17.113Z"^^xsd:dateTime;
    skos:definition "A feature that relates to the quality, performance, or other non-functional aspects of a product or service."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-requirements/>;
    skos:broader requirementsvoc:functional-feature;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
}
