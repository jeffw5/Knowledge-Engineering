voc:market-segment
  a skos:Concept ;
  skos:prefLabel "Market segment"@en ;
  skos:altLabel "Market Segmentation"@en ;
  skos:definition "Data used to define and describe subsets of the market (e.g., based on demographics, behavior) for targeted marketing and sales efforts."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
