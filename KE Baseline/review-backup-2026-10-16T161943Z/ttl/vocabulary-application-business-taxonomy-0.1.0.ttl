voc:medium-business
  a skos:Concept ;
  skos:prefLabel "Medium business"@en ;
  skos:definition "Companies larger than small businesses but smaller than enterprises, with specific revenue and employee ranges depending on industry."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
