<https://www.insperity.com/shapes/domain-sales/>
  a owl:Ontology ;
  rdfs:label "Domain Sales Shapes"@en ;
  dct:title "Domain Sales Shapes"@en ;
  dct:description "SHACL shapes for selling steps and quotas."@en ;
  dct:subject domainvoc:sales ;
  owl:imports <https://www.insperity.com/ontology/domain-sales/> ;
  vaem:namespace "https://www.insperity.com/shapes/domain-sales/"^^xsd:anyURI ;
  vann:preferredNamespacePrefix "salesshp" ;
  dct:language "en" ;
  dct:publisher <https://www.insperity.com/resource/core/Organization/insperity> ;
