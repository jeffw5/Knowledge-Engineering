  <https://www.insperity.com/taxonomy/application-data-domain/ResourceTrouble> skos:prefLabel
      "Resource trouble"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Data managing problems (e.g., alarms, degradations) found in allocated Resource instances, including detection and resolution history."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/Alarm> skos:prefLabel
      "Alarm"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "A data record signaling an unexpected or critical event or condition that indicates a potential Resource or service issue."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/AlarmSeverityAssignmentProfile>
    skos:prefLabel "Alarm severity assignment profile"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "Data defining the rules for assigning a level of criticality (severity) to a specific type of Alarm."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/ResourceUsage> skos:prefLabel
      "Resource usage"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Data that collects and records Resource consumption data (e.g., utilization) for use by other business entities."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/StockItem> skos:prefLabel
      "Stock item"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Data required by the supply chain, including the catalog, inventory, and shipment tracking of physical goods."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/ServiceNetwork> skos:prefLabel
      "Service (network)"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Service (Network) exclusively models network-level services—the technical capabilities directly provisioned, managed, and assured by the telecom infrastructure. These services are infrastructure-facing, not customer-facing, and are used as enablers within products. Scope Includes: • Connectivity services (e.g., 5G access, LTE, broadband, MPLS VPN) • Transport services (e.g., fiber, microwave, DWDM links) • Core services (e.g., voice routing, IMS, EPC) • Network-sliced or virtualized services (e.g., NFV/SDN-based slices)"@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/Service> skos:prefLabel
      "Service"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Data representing the instances of both customer-facing and resource-facing types of network services."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/ServiceCapacity> skos:prefLabel
      "Service capacity"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Service Capacity refers to the maximum amount of load, traffic, or service instances that a network service can support under defined technical and operational conditions. It represents a measurable limit or threshold applied to a service specification, often tied to performance, resource availability, and quality of service (QoS) constraints. Scope Includes: • Bandwidth limits (e.g., max throughput for a transport service) • Concurrent sessions or flows (e.g., number of voice calls or VPN tunnels) • Service instances per resource (e.g., number of virtual services on a node) • Latency or jitter thresholds for specific capacity tiers • Allocation limits for network slices, virtualized functions, or access ports"@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/ServiceConfiguration>
    skos:prefLabel "Service configuration"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Service Configuration refers to the specific set of parameters, policies, and settings applied to a network service instance to define its operational behavior. This includes QoS profiles, routing rules, port bindings, bandwidth allocation, and other technical attributes."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/ServiceOrder> skos:prefLabel
      "Service order"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "A Service Order is a formal request to create, modify, suspend, or terminate a network service instance based on a predefined service specification."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/ServicePerformance> skos:prefLabel
      "Service performance"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Service Performance refers to the continuous monitoring, measurement, and evaluation of a network service’s behavior and effectiveness against defined technical and operational criteria. It ensures that network services operate within expected thresholds and meet agreed service levels."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/ServiceLevelSpecification>
    skos:prefLabel "Service level specification"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "A Service Level Specification defines the agreed set of performance commitments or objectives for a network service, usually expressed in measurable KPIs (Key Performance Indicators). These are often formalized in SLAs (Service Level Agreements)."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/ServicePerformanceSpecification>
    skos:prefLabel "Service performance specification"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "A Service Performance Specification defines what metrics to monitor, how they are measured, and the data collection methods used to assess the performance of a network service. It is more technical than the SLS and used by systems to implement performance monitoring."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/ServiceProblem> skos:prefLabel
      "Service problem"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "A Service Problem is any detected or reported issue affecting the expected performance, availability, or behavior of a network service."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/ServiceSpecification>
    skos:prefLabel "Service specification"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "A Service Specification defines the detailed technical and functional description of a network-facing service within the telecom operator’s infrastructure. It acts as a blueprint for creating consistent and reusable service instances that deliver specific network capabilities, independent of any customer or commercial context. Scope: In the revised model, where the Services Domain is restricted to network-only services, the Service Specification exclusively defines characteristics of services that are: • Provisioned and managed directly by the network (physical or virtual) • Used as building blocks by higher-layer products or orchestration systems • Not directly visible or exposed to the end customer Examples of Network Service Specifications: • 5G Radio Access Service Specification • MPLS VPN Transport Service Specification • IMS Voice Core Routing Specification • Fiber Broadband Access Specification • Network Slice Specification for IoT Low-Latency Use Cases Attributes Typically Defined in a Network Service Specification: • Service type and category (e.g., transport, access, core) • Technical parameters (bandwidth, latency, QoS class) • Resource dependencies (e.g., physical ports, VNFs, slices) • Lifecycle behavior (provisioning rules, assurance triggers) • Interfaces and control protocols (e.g., NETCONF, REST, gRPC)"@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/ResourceFacingServiceSpecification>
    skos:prefLabel "Resource facing service specification"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "A Resource-Facing Service Specification defines a network service in terms of its direct interaction with and dependency on underlying network resources—such as physical infrastructure, virtual network functions (VNFs), and logical connections. It provides the technical blueprint required to bind service behavior with resource orchestration and assurance."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/ServiceCatalog> skos:prefLabel
      "Service catalog"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "The Service Catalogue is a structured repository that contains and organizes all network-related Service Specifications, including both abstract and resource-facing service definitions. It acts as the single source of truth for reusable, standard network service building blocks."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/ServiceStrategyPlan> skos:prefLabel
      "Service strategy & plan"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Service Strategy and Plan refers to the roadmap, policies, and investment direction guiding the evolution, scaling, and optimization of network services."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/ServiceTest> skos:prefLabel
      "Service test"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "A Service Test is a controlled validation process to verify the performance, integrity, and readiness of a network service instance or configuration before, during, or after deployment."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/TelecomInfraProjectServiceManagement>
    skos:prefLabel "Telecom infra project service management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "In the context of Capital TIP, Service Management refers to the practices and frameworks for managing open, disaggregated, and vendor-neutral network services as defined by the Telecom Infra Project (TIP)."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/SharedReferenceData> skos:prefLabel
      "Shared (reference data)"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T02:10:03Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "The shared domain includes reference data information that is usable across content areas and describes content that is used across the organization with the same definition."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/Calendar> skos:prefLabel
      "Calendar"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Represents Entities used to provide time related functions. This includes scheduling, time conflicts and time based presentation support"@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/ScheduleDefinition> skos:prefLabel
      "Schedule definition"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "The technical blueprint that defines the parameters, frequency, and duration of a recurring Schedule."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/CommunicationInteraction>
    skos:prefLabel "Communication interaction"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Data describing an exchange of information (e.g., call, email, chat) between two or more humans and/or machines."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/DigitalIdentity> skos:prefLabel
      "Digital identity"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Data entities used for identification and authentication of a Party or Resource to grant them system permissions based on their roles."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/Location> skos:prefLabel
      "Location"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Data representing the site or position of something (e.g., customer address, equipment site) using coordinates, addresses, or physical representations."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/GeographicPlace> skos:prefLabel
      "Geographic place"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "A group of entities that are used to define a geographic location and enable it to be marked it on a map or given an address"@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/LocalPlace> skos:prefLabel
      "Local place"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "A set of entities that determine where things are in relation to a local coordinate system."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/OpenGisSfs> skos:prefLabel
      "OpenGIS simple features specification"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "A set of geometric standards defined by the Open Geospatial Consortium (OGC), an international industry consortium made up of companies, government agencies, and universities participating in a consensus process to develop publicly available interface standards"@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/Party> skos:prefLabel
      "Party"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "A Party represents an individual, an organization, or an organization unit that are of interest, involved or that provide value directly or indirectly from an enterprise perspective (Enterprise is to be understood here as provider, service provider or operator). Hence the Party plays one or more roles with the enterprise or with another Party playing a role with the enterprise (indirectly). This is introduced to specify that the only party an enterprise would be interested in and will consider in its systems is a party playing a role (directly or indirectly)."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/ContactMedium> skos:prefLabel
      "Contact medium"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "Data representing the various means (e.g., phone number, email address) by which a Party Role or Account can be reached."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/Currency> skos:prefLabel
      "Currency"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime .
  
  <https://www.insperity.com/taxonomy/application-data-domain/Identification> skos:prefLabel
      "Identification"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime .
  
  <https://www.insperity.com/taxonomy/application-data-domain/PartyCommunity> skos:prefLabel
      "Party community"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime .
  
  <https://www.insperity.com/taxonomy/application-data-domain/PartyDemographic> skos:prefLabel
      "Party demographic"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime .
  
  <https://www.insperity.com/taxonomy/application-data-domain/PartyOrganization> skos:prefLabel
      "Party organization"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime .
  
  <https://www.insperity.com/taxonomy/application-data-domain/PartyPermission> skos:prefLabel
      "Party permission"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime .
  
  <https://www.insperity.com/taxonomy/application-data-domain/PartyProfile> skos:prefLabel
      "Party profile"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime .
  
  <https://www.insperity.com/taxonomy/application-data-domain/PartyRoleExamples> skos:prefLabel
      "Party role examples"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime .
  
  <https://www.insperity.com/taxonomy/application-data-domain/PartyRoleGroup> skos:prefLabel
      "Party role group"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime .
  
  <https://www.insperity.com/taxonomy/application-data-domain/Skill> skos:prefLabel
      "Skill"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime .
  
  <https://www.insperity.com/taxonomy/application-data-domain/PartyPayment> skos:prefLabel
      "Party payment"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime .
  
  <https://www.insperity.com/taxonomy/application-data-domain/Bank> skos:prefLabel "Bank"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime .
  
  <https://www.insperity.com/taxonomy/application-data-domain/PartyPrivacy> skos:prefLabel
      "Party privacy"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime .
  
  <https://www.insperity.com/taxonomy/application-data-domain/PartyPrivacyProfile> skos:prefLabel
      "Party privacy profile"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime .
  
  <https://www.insperity.com/taxonomy/application-data-domain/PartyPrivacyProfileType>
    skos:prefLabel "Party privacy profile type"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime .
  
  <https://www.insperity.com/taxonomy/application-data-domain/PartyRoles> skos:prefLabel
      "Party roles"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime .
  
  <https://www.insperity.com/taxonomy/application-data-domain/Permission> skos:prefLabel
      "Permission"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime .
  
  <https://www.insperity.com/taxonomy/application-data-domain/> terms:description "The Data Domain Taxonomy is used to to assign technical data stewards in the AI&D organization."@en;
    terms:title "Application data domain taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T02:11:00Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en,
      "2026-10-17: Conformance Review before release — 1 definition changed."@en;
    terms:created "2025-10-14T19:39:17.802Z"^^xsd:dateTime .
  
  <https://www.insperity.com/taxonomy/application-data-domain/DataDomain> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-27T18:03:06.403Z"^^xsd:dateTime;
    skos:definition "The Data Domain Taxonomy is used to to assign technical data stewards in the AI&D organization."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/BusinessPartner> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "The Business Partner domain represents roles, information and activities carried out by parties (e.g. individuals / organizations) playing roles that are involved in the strategic planning, definition, development, operational aspects and all types of contact with Business Partners (e.g. Suppliers, Partners, etc.) with which an enterprise collaborates in order to operate their business. Activities include management of Business Partner: strategies, capabilities, value propositions, relationships, profiles, data, privacy, security, interactions, communications, tenders, agreements, orders, requisitions, supplies, accounts, balances, inventories, reconciliations, service level agreements (SLAs), training, problems, cases, invoices, payments, revenues, disputes, collections, loyalty, performance, usage statistics, analytics and support of Business Partners as they supply, acquire, use, support, purchase, pay for and are supported for goods and services (products) that they provide and / or obtain from an enterprise. A Business Partner is a commercial party with which the Enterprise (i.e. Service Provider) has some form of cooperative alliance. This relationship may range from a formal contractual, exclusive bond in which both parties commit to not ally with third parties, to a loose arrangement of associated parties. Many of the Business Partner Domain information and activities are business partner role-specific specializations of generalized concepts defined within the Foundation Domain"@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/AppliedPartyBillingRate>
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "The specific rate structure (price, discount, tax) applied to a Business Partner's billed items."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/BusinessPartnerAccount>
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "The technical record and core attributes for a financial or operational account held by an external Business Partner."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/BusinessPartnerPerformance>
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Metrics and analytical data representing a Business Partner's operational and financial success (e.g., usage patterns, profitability)."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/BusinessPartnerProductOrder>
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "The data record of a formal communication used by the enterprise to purchase or modify goods/services from a Business Partner."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/PartyBill> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "A preliminary document or record that details all charged items, credits, and the total monetary amount owed to or by a Party (e.g., a Business Partner)."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/PartyBillCollection> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "The process data and records related to managing overdue payments, credit violations, and financial recovery actions with a Party."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/BusinessPartnerPayment>
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "The technical record of a transfer of wealth (e.g., payment, funds transfer) between the enterprise and a Business Partner."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/Dunning> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "The technical record of attempts, communications, and actions to collect overdue payments from a customer."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/CustomerBillCollection>
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "The process data and records related to managing overdue payments, credit violations, and facility billing audits for a Customer."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/PartyInteraction> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "The data record of communications and engagements with a Party (individual or organization), and the resulting events (e.g., creating an order or a problem)."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/PartyProblem> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Data records for technical assistance issues or operational problems reported to or by another Party (e.g., a supplier or partner)."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/PartyProductSpecificationOffering>
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Data representing how Parties (playing roles) are involved with defining, procuring, or being billed for Product Specifications and Product Offerings."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/PartyRoleProductOffering>
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "Data linking a specific Party Role (e.g., supplier) to the commercial Product Offerings they are involved with."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/PartyRoleProductSpecification>
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "Data linking a specific Party Role (e.g., product developer) to the technical blueprint (Product Specification) they are involved with."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/PartyRevenueSettlement>
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Data related to the distribution of revenue and final monetary settlements with a Party."@en .
  
  vzdatadomaintax:PartyRevenueSharing terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "The definition and records of how revenue is distributed among various stakeholders (Parties) based on an agreement."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/PartySettlement> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "Data representing the final calculated monetary value (pay-out or pay-in) due to or from a Party based on product/service usage or fees."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/PartyServiceLevelAgreement>
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "A data record of the formal contract and performance commitments (SLA) established with a third-party organization (Party)."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/PartyStrategyPlan> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Data assets related to the strategic roadmap, goals, and planning for business relationships with external Parties."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/CustomerCore> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Customer Core represents the foundational data and management structures related to the customer's identity, contractual agreements, billing, usage, payment, and collection activities. It focuses on the customer's official profile, financial status, service entitlements, and operational records critical for enabling and sustaining service delivery. This includes: • Customer Profile Management • Account and Contract Management • Billing and Charging Information • Usage and Consumption Tracking • Credit Management and Collections • Customer Analytics & Performance KPI"@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/Billing> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Billing encompasses all aspects of customer invoicing and account management. This includes: Rate Application: Managing the correlation of usage data, applying regulated and non-regulated rates, discounts, and taxes to usage. Invoice Item Generation: Handling real-time and non-real-time call detail records (CDRs) and other data sources to create invoice items. Bill Management: Representing the bill format, scheduling bill production, managing customer invoicing profiles, performing financial calculations to determine the total bill amount (excluding rating and rating discounts), and processing credits and adjustments. Account and Balance Management: Managing customer accounts and their associated balance information. Balances represent monetary or non-monetary amounts (e.g., free minutes, loyalty points) indicating the financial relationship between the service provider and the customer, including pre-paid balances, post-paid accounts receivable, and other credit or debt scenarios."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/AppliedCustomerBillingRateSpecification>
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "The detailed configuration or template for the billing rate (price, discount, tax) applied to a Customer's usage or subscribed items."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/CustomerBillingStatistic>
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "Aggregated and derived data (metrics) calculated from Customer Bill records for analysis and reporting."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/CustomerPayment> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "The technical record of a transfer of wealth (e.g., payment) received from a Customer for products or usage."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/CustomerCorePerformance>
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Customer Core Performance represent the analytical data and metrics derived from the customer’s financial, contractual, and operational activities. These statistics provide insights into customer usage patterns, billing trends, account behavior, credit status, and payment history. Examples Include: • Monthly data usage per customer segment • Average bill amount and payment delay rates • Churn probability based on billing irregularities • Number of active vs. dormant accounts • Collection success rate by region or segment"@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/CustomerUsage> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Customer Usage holds detailed records of how individual customers consume telecom services and products over time. It captures quantitative usage events such as data consumption, voice minutes, SMS, or other measurable activities linked to subscribed services or products. This information is critical for rating, billing, usage analytics, and customer profiling. In addition to core telecom usage, Customer Usage also tracks detailed consumption of service-layer offerings such as content streaming, cloud storage, gaming, and value-added services. These records help assess service performance, enable usage-based pricing, and support targeted customer engagement."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/Profile> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "A customer profile is a detailed description of a customer or group of customers, encompassing their demographics, behaviors, interests, and needs. Information included: Demographics: Age, gender, location, income, education, occupation, etc. Behavioral: Churn score, Channel Preference, Purchase history, website usage, social media engagement, etc."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/CustomerExperience> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Customer Experience focuses on the customer's journey, perception, and interactions across all touchpoints with the service provider. It captures customer engagements, reported problems, service or order requests, SLA commitments, satisfaction metrics, and feedback loops. It encompasses: • Interaction and Engagement Management • Customer Problem and Complaint Handling • SLA Monitoring and Performance Tracking • Customer Satisfaction and Feedback Management • Journey Mapping and Experience Analytics"@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/CustomerBillInquiry> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Represents invoice inquiries associated with invoices sent to customers and handles disputes and adjustments on individual charges, invoices, and accounts. A request for information about a statement of money owed by a customer."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/CustomerExperiencePerformance>
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Customer Experience Statistics reflect the measurements and trends related to customer interactions, perceptions, and satisfaction across all service channels and touchpoints. These statistics help evaluate service quality, responsiveness, and overall customer sentiment."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/CustomerProblem> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "The data record for technical assistance and operational problem handling reported by or for a Customer."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/CustomerProductOrder>
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "The data record of a formal communication used by a Customer to procure, update, or remove one or many products."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/SalesQuote> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "A document or record provided to a prospective customer (Prospect) detailing the cost and validity period for purchasing specific Products."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/SalesQuoteSpecification>
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "The technical blueprint or template that defines the structure, format, and common characteristics of a Sales Quote."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/CustomerServiceLevelAgreement>
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "A data record of the formal contract and performance commitments (SLA) specifically established with a Customer."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/Interactions> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "The data record of communications with customers and the technical translation of those communications into system events (e.g., orders, inquiries, problems)."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/EnterpriseCorporate> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "The Enterprise domain represents roles, information and activities that are required to run and support a business. These concepts focus on both the setting and achieving of strategic corporate goals and objectives, as well as providing those support services that are required throughout an Enterprise. These concepts are sometimes considered to be the corporate functions and/or processes (e.g., Financial Management, Human Resources Management processes, etc.). Since Enterprise Management is aimed at general support within the Enterprise, they may interface as needed with almost every other process in the Enterprise, be they operational, strategy, infrastructure or product processes."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/EnterpriseEffectiveness>
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Data used to measure and evaluate the overall success and efficiency of the enterprise, such as business objectives and process KPIs."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/EnterprisePartyRoles>
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-27T18:14:03.412Z"^^xsd:dateTime;
    skos:definition "Data defining the roles that different Parties play within the Enterprise (Corporate) domain."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/EnterpriseRisk> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Represents all items that relate to risk of an enterprise. It also concerns security vulnerabilities and operational capability to resolve any detected degradations and violations"@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/EnterpriseSecurity> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "Data records related to security vulnerabilities, security events, and the operational capability to resolve detected degradations or violations."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/Finance> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Data assets describing all financial aspects of the enterprise, such as financial accounts, general ledgers, and accounting entries."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/RevenueAssurance> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Data controls, violations, and KPIs used to ensure accurate revenue capture and reconciliation across all business processes."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/Workforce> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Data modeling field resource management, including human and non-human field assets, their roles, skills, schedules, and work order assignments."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/EmployeePay> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "The detailed data (e.g., pay grades, ranges, components) that defines an employee's compensation structure."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/WorkSpecification> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "The technical blueprint or definition for a specific type of work (e.g., installation, repair) that can be manually performed by a technician."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/WorkforceResource> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "Data representing the employees and other non-human assets specifically involved in field operational tasks."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/WorkforceSchedule> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "Data defining the planning, reservation, and assignment of a technician or resource to a specific task or time slot."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/MarketSales> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Represents roles, information and activities pertaining to marketing and sales strategy, capability delivery, lifecycle management and support of parties (e.g. individuals / organizations) that move through sales lifecycle stages (e.g. contact / lead / prospect) as they learn about, inquire, choose, negotiate, order and are supported for goods and services (i.e. products) that are offered by an enterprise. On the Sales side, this includes sales contacts / leads / prospects through to the sales force and sales statistics. Market includes market strategy and plans, market segments, competitors and their products, through to campaign formulation and reporting."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/Competitor> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Data used to identify, profile, and track other providers operating in the same market segments."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/CompetitorIntelligence>
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "Factual data gathered and analyzed about a competitor's plans, products, financial status, and market activities."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/CompetitorProductCorrelation>
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:33:40.651Z"^^xsd:dateTime;
    skos:definition "Data representing a comparison or mapping between the enterprise's Product Offerings and a competitor's product offerings."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/MarketSalesStrategyPlan>
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Data assets related to the long-term business plans and strategies for market presence, product focus, and sales channels."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/MarketSalesForecast> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Data representing predictions and projections for future market demand, sales volume, new service requirements, and customer needs."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/MarketSegment> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Data used to define and describe subsets of the market (e.g., based on demographics, behavior) for targeted marketing and sales efforts."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/MarketingCampaign> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Data representing the strategy, plan, target market, and execution assets for promoting a product offering."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/MarketingPerformance>
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-10-14T20:11:57.668Z"^^xsd:dateTime;
    skos:definition "Data used to define performance objectives and measured indicators (KPIs) related to the effectiveness of marketing and sales activities."@en .
  
  <https://www.insperity.com/taxonomy/application-data-domain/SalesChannel> terms:creator
      "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
