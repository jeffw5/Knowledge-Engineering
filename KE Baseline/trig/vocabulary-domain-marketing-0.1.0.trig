    dct:created "2025-03-31T20:29:05.848Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:search-engine-optimization
    a skos:Concept ;
    skos:prefLabel "Search engine optimization"@en ;
    skos:altLabel "SEO"@en ;
    skos:definition "Improving the ranking of a website in organic search results."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
    skos:broader voc:search-engine-marketing ;
