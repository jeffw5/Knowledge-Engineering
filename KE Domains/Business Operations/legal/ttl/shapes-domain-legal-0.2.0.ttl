legalshp:legal-matter-shape
  a sh:NodeShape ;
  rdfs:label "Legal matter shape"@en ;
  skos:prefLabel "Legal matter shape"@en ;
  skos:definition "A shape that checks a legal matter is governed by directives."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-legal/> ;
  sh:targetClass legal:legal-matter ;
  sh:property [
      sh:path core:governedBy ;
      sh:class core:directive ;
      sh:message "governed by must point to a directive."@en
  ] ;
  owl:versionInfo "0.2.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-22"^^xsd:date ;
  dct:modified "2026-10-22T02:04:02Z"^^xsd:dateTime .

legalshp:client-service-agreement-shape
  a sh:NodeShape ;
  rdfs:label "Client service agreement shape"@en ;
  skos:prefLabel "Client service agreement shape"@en ;
  skos:definition "A shape that checks a client service agreement names its parties and is built from clauses."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-legal/> ;
  sh:targetClass legal:client-service-agreement ;
  sh:property [
      sh:path core:concerns ;
      sh:class core:party ;
      sh:message "A client service agreement must name both parties to the co-employment relationship."@en ;
      sh:minCount "2"^^xsd:integer ;
      sh:severity sh:Warning
  ] ,
      [
      sh:path core:hasComponent ;
      sh:class legal:clause ;
      sh:message "A client service agreement should be built from clauses, including the allocation of employer responsibilities."@en ;
      sh:minCount "1"^^xsd:integer ;
      sh:severity sh:Warning
  ] ;
  owl:versionInfo "0.2.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-22"^^xsd:date ;
