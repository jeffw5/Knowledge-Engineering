voc:segmentation
  a skos:Concept ;
  skos:prefLabel "Segmentation"@en ;
  skos:definition "Data entities used to specify the rules and criteria for dividing a large set of entity instances (e.g., customers) into smaller subsets."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
