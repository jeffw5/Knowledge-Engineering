voc:market-sales
  a skos:Concept ;
  skos:prefLabel "Market sales"@en ;
  skos:altLabel "Market & Sales"@en ;
  skos:definition "Represents roles, information and activities pertaining to marketing and sales strategy, capability delivery, lifecycle management and support of parties (e.g. individuals / organizations) that move through sales lifecycle stages (e.g. contact / lead / prospect) as they learn about, inquire, choose, negotiate, order and are supported for goods and services (i.e. products) that are offered by an enterprise. On the Sales side, this includes sales contacts / leads / prospects through to the sales force and sales statistics. Market includes market strategy and plans, market segments, competitors and their products, through to campaign formulation and reporting."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:data-domain ;
  skos:narrower voc:competitor ,
      voc:market-and-sales-strategy-plan ,
      voc:market-sales-forecast ,
      voc:market-segment ,
      voc:marketing-campaign ,
      voc:marketing-performance ,
      voc:sales-channel ,
      voc:sales-commission ,
      voc:sales-lead-and-opportunity ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-10-24T20:05:31.540Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

