<https://www.insperity.com/taxonomy/core-party/> {
  <https://www.insperity.com/taxonomy/core-party/> terms:description "The party taxonomy categorizes entities such as organizations (companies, agencies), persons (individuals, contacts) and vendors (suppliers of goods or services) which helps to effectively manage relationships and interactions with various internal & external entities."@en;
    terms:title "Core party taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk" .
  
  partytax:Person terms:creator "Jeffrey Wallk" .
  
  partytax:Party terms:creator "Jeffrey Wallk" .
}

<https://www.insperity.com/taxonomy/core-product/> {
  <https://www.insperity.com/taxonomy/core-product/> terms:description "The product taxonomy organizes products based on shared characteristics. This structured categorization, ranging from broad concepts (business driver) to specific details (physical attributes), helps to understand how products are utilized across the organization."@en;
    terms:title "Core product taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk" .
  
  producttax:IndividualProduct terms:creator "Jeffrey Wallk" .
}

<https://www.insperity.com/taxonomy/core-persona/> {
  <https://www.insperity.com/taxonomy/core-persona/> terms:description "The persona taxonomy categorizes data types used to understand individual users and work together to create comprehensive user profiles for personalized experiences."@en;
    terms:title "Core persona taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk" .
  
  personatax:Persona terms:creator "Jeffrey Wallk" .
}

<https://www.insperity.com/taxonomy/core-compliance/> {
  <https://www.insperity.com/taxonomy/core-compliance/> terms:description "The compliance taxonomy organizes and categorizes Verizon’s compliance obligations to effectively manage compliance risks, streamline audits and ensure adherence to relevant legal and ethical requirements."@en;
    terms:title "Core compliance taxonomy"@en;
    terms:contributor "Jeffrey Wallk" .
}

<https://www.insperity.com/taxonomy/reference-domain/> {
  <https://www.insperity.com/taxonomy/reference-domain/> terms:description "The domain reference taxonomy categorizes and organizes information related to business operations. It encompasses key domains such as commercial aspects, corporate structure, network infrastructure, and supply chain management, providing a comprehensive view of an organization’s operational landscape. This taxonomy facilitates data analysis, knowledge management, and decision-making by standardizing terminology and relationships between different business areas."@en;
    terms:title "Reference domain taxonomy"@en;
    terms:contributor "Jeffrey Wallk" .
}

<https://www.insperity.com/taxonomy/application-business-taxonomy/> {
  <https://www.insperity.com/taxonomy/application-business-taxonomy/> terms:description
      "The business taxonomy categorizes and organizes data content that is to be used in the organization's Data Marketplace to enable a more intuitive user experience for browsing and discovery."@en;
    terms:title "Application business taxonomy taxonomy"@en;
    terms:contributor "Jeffrey Wallk" .
}

<https://www.insperity.com/taxonomy/application-data-domain/> {
  <https://www.insperity.com/taxonomy/application-data-domain/> terms:description "The Data Domain Taxonomy is used to to assign technical data stewards in the AI&D organization."@en;
    terms:title "Application data domain taxonomy"@en;
    terms:contributor "Jeffrey Wallk" .
}

<https://www.insperity.com/taxonomy/core-businessoperations/> {
  <https://www.insperity.com/taxonomy/core-businessoperations/> terms:description "The business operations taxonomy categorizes and organizes information, providing a comprehensive view of the organization's operational landscape"@en;
    terms:title "Core businessoperations taxonomy"@en;
    terms:contributor "Jeffrey Wallk" .
}

<https://www.insperity.com/taxonomy/core-services/> {
  <https://www.insperity.com/taxonomy/core-services/> terms:description "The service taxonomy categorizes services to help Verizon align services with business goals. Business services focus on high-level organizational outcomes, functional services group activities to deliver business value, and technical services support functional services through specific technology-based functions."@en;
    terms:title "Core services taxonomy"@en;
    terms:contributor "Jeffrey Wallk" .
}

<https://www.insperity.com/taxonomy/core-services-technicalservices/> {
  <https://www.insperity.com/taxonomy/core-services-technicalservices/> terms:description
      "The technical service taxonomy categorizes crucial technical functions within Verizon to enable a streamlined service delivery and enhanced user experience."@en;
    terms:title "Core services technicalservices taxonomy"@en;
    terms:contributor "Jeffrey Wallk" .
}

