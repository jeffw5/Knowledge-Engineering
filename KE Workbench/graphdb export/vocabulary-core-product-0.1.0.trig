<https://www.insperity.com/vocabulary/core-product/> {
  <https://www.insperity.com/vocabulary/core-product/> a skos:ConceptScheme;
    rdfs:label "Core product vocabulary"@en;
    skos:prefLabel "Core product vocabulary"@en;
    skos:hasTopConcept productvoc:product;
    terms:description "A good, service, or idea offered to the market to satisfy a customer need or want."@en;
    terms:title "Core product vocabulary"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2025-03-25T16:58:08.023Z"^^xsd:dateTime;
    skos:altLabel "Vocabulary | Core | Product"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/vocabulary/core-product/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  productvoc:product a skos:Concept;
    skos:prefLabel "Product"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-25T17:21:56.471Z"^^xsd:dateTime;
    skos:definition "A good, service, or idea offered to the market to satisfy a customer need or want."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-product/>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/core-product/>;
    skos:narrower productvoc:physical-product, productvoc:product-business-drivers, productvoc:product-concept,
      productvoc:product-function, productvoc:product-lifecycle .
  
  productvoc:physical-product a skos:Concept;
    skos:prefLabel "Physical product"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:48:06.981Z"^^xsd:dateTime;
    skos:definition "A tangible, material object offered for sale."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-product/>;
    skos:broader productvoc:product;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower productvoc:component-parts, productvoc:individual-product, productvoc:product-collection .
  
  productvoc:product-business-drivers a skos:Concept;
    skos:prefLabel "Product business drivers"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:48:06.981Z"^^xsd:dateTime;
    skos:definition "Factors that influence the success of a product, such as market demand, competition, and technology."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-product/>;
    skos:broader productvoc:product;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower productvoc:cost, productvoc:marketing-strategy, productvoc:pricing-strategy,
      productvoc:product-innovation, productvoc:revenue-stream, productvoc:sales-strategy .
  
  productvoc:product-concept a skos:Concept;
    skos:prefLabel "Product concept"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:48:06.981Z"^^xsd:dateTime;
    skos:definition "A detailed idea for a product."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-product/>;
    skos:broader productvoc:product;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower productvoc:user-journey, productvoc:user-persona, productvoc:user-story .
  
  productvoc:product-function a skos:Concept;
    skos:prefLabel "Product function"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:48:06.981Z"^^xsd:dateTime;
    skos:definition "What a product does and how it works."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-product/>;
    skos:broader productvoc:product;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower productvoc:data-flow, productvoc:product-features, productvoc:roadmap,
      productvoc:system-architecture .
  
  productvoc:product-lifecycle a skos:Concept;
    skos:prefLabel "Product lifecycle"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:48:06.981Z"^^xsd:dateTime;
    skos:definition "The stages a product goes through from conception to decline in the market."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-product/>;
    skos:broader productvoc:product;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower productvoc:decline, productvoc:development, productvoc:growth, productvoc:introduction,
      productvoc:maturity .
  
  productvoc:component-parts a skos:Concept;
    skos:prefLabel "Component parts"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:48:06.981Z"^^xsd:dateTime;
    skos:definition "The individual elements that make up a product."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-product/>;
    skos:broader productvoc:physical-product;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  productvoc:individual-product a skos:Concept;
    skos:prefLabel "Individual product"@en;
