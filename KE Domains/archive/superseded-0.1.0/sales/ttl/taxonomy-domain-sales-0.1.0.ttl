salestax:selling-stage
  a skos:Concept ;
  rdfs:label "Selling stage"@en ;
  skos:prefLabel "Selling stage"@en ;
  skos:definition "A process step of the selling process: the provider's view of where an opportunity stands in the buyer's journey."@en ;
  skos:scopeNote "Buying stages are the provider's point of view (Baseline decision 21). A stage may address one or more of the buyer persona's jobs or job steps; it must not be confused with those job steps, and the mismatch between them is where value gaps are created."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/> ;
  skos:topConceptOf <https://www.insperity.com/taxonomy/domain-sales/> ;
  skos:narrower salestax:decide ,
      salestax:discover ,
      salestax:evaluate ,
      salestax:onboard ,
      salestax:propose ,
      salestax:qualify ;
  core:hasPrimaryTerm commercialopsvoc:stage ;
  dct:subject domainvoc:sales , commercialopsvoc:stage ;
  core:formalizedBy sales:selling-step ;
  owl:versionInfo "0.1.0" ;
  skos:broadMatch processtax:process-step ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-20"^^xsd:date ;
  dct:modified "2026-10-20T00:16:35Z"^^xsd:dateTime .

