voc:resource-trouble
  a skos:Concept ;
  skos:prefLabel "Resource trouble"@en ;
  skos:definition "Data managing problems (e.g., alarms, degradations) found in allocated Resource instances, including detection and resolution history."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:resource-network-and-device ;
