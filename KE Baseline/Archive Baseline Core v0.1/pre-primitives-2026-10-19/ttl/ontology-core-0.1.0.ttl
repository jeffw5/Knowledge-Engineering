  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-19"^^xsd:date ;
  dct:modified "2026-10-19T02:19:17Z"^^xsd:dateTime .

core:Policy
  a owl:Class ;
  rdfs:label "Policy"@en ;
  skos:prefLabel "Policy"@en ;
  skos:definition "A directive that states the intent of the organization or of an authority, and the principles its process steps must follow."@en ;
  rdfs:subClassOf core:Directive ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/core/> ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-19"^^xsd:date ;
  dct:modified "2026-10-19T02:19:17Z"^^xsd:dateTime .

core:Rule
  a owl:Class ;
  rdfs:label "Rule"@en ;
  skos:prefLabel "Rule"@en ;
  skos:altLabel "Rules"@en ;
