voc:marketing-campaign
  a skos:Concept ;
  skos:prefLabel "Marketing campaign"@en ;
  skos:definition "Data representing the strategy, plan, target market, and execution assets for promoting a product offering."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
