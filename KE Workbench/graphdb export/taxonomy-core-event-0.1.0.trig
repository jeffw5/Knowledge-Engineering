<https://www.insperity.com/taxonomy/core-event/> {
  <https://www.insperity.com/taxonomy/core-event/> a skos:ConceptScheme;
    rdfs:label "Core event taxonomy"@en;
    skos:prefLabel "Core event taxonomy"@en;
    skos:hasTopConcept <https://www.insperity.com/taxonomy/core-event/business-event>,
      <https://www.insperity.com/taxonomy/core-event/change-event>, <https://www.insperity.com/taxonomy/core-event/governance-event>,
      <https://www.insperity.com/taxonomy/core-event/interaction-event>, <https://www.insperity.com/taxonomy/core-event/process-event>,
      <https://www.insperity.com/taxonomy/core-event/system-event>, <https://www.insperity.com/taxonomy/core-event/time-event>;
    terms:description "Classification of occurrences that happen at a point or short span in time and can start, end, or result from a process step."@en;
    terms:title "Core event taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2026-10-14"^^xsd:dateTime;
    skos:altLabel "Event taxonomy"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/taxonomy/core-event/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-event/business-event> a skos:Concept;
    skos:prefLabel "Business event"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An event that changes the state of a business relationship, agreement, or transaction."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-event/>;
    skos:example "Employee termination; client contract signed."@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-event/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-event/agreement-event>, <https://www.insperity.com/taxonomy/core-event/party-event>,
      <https://www.insperity.com/taxonomy/core-event/transaction-event> .
  
  <https://www.insperity.com/taxonomy/core-event/change-event> a skos:Concept;
    skos:prefLabel "Change event"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An event that records a change in data, configuration, or governed knowledge."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-event/>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-event/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-event/configuration-change>,
      <https://www.insperity.com/taxonomy/core-event/data-change>, <https://www.insperity.com/taxonomy/core-event/knowledge-change>,
      <https://www.insperity.com/taxonomy/core-event/regulatory-change> .
  
  <https://www.insperity.com/taxonomy/core-event/governance-event> a skos:Concept;
    skos:prefLabel "Governance event"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An event in which a governance decision or control outcome is recorded."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-event/>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-event/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-event/approval-denied>, <https://www.insperity.com/taxonomy/core-event/approval-granted>,
      <https://www.insperity.com/taxonomy/core-event/audit-completed>, <https://www.insperity.com/taxonomy/core-event/control-failure-detected>,
      <https://www.insperity.com/taxonomy/core-event/release-published> .
  
  <https://www.insperity.com/taxonomy/core-event/interaction-event> a skos:Concept;
    skos:prefLabel "Interaction event"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An event in which a party communicates with the organization or one of its systems."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-event/>;
    skos:altLabel "Engagement event"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-event/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-event/answer-delivery>, <https://www.insperity.com/taxonomy/core-event/feedback-submission>,
      <https://www.insperity.com/taxonomy/core-event/inquiry>, <https://www.insperity.com/taxonomy/core-event/notification-delivery>,
      <https://www.insperity.com/taxonomy/core-event/request-submission> .
  
  <https://www.insperity.com/taxonomy/core-event/process-event> a skos:Concept;
    skos:prefLabel "Process event"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An event that marks a change in the execution state of a process or process step."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-event/>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-event/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-event/escalation-raised>, <https://www.insperity.com/taxonomy/core-event/handoff>,
      <https://www.insperity.com/taxonomy/core-event/process-completion>, <https://www.insperity.com/taxonomy/core-event/process-exception>,
      <https://www.insperity.com/taxonomy/core-event/process-start> .
  
  <https://www.insperity.com/taxonomy/core-event/system-event> a skos:Concept;
    skos:prefLabel "System event"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An event that is generated by a software system about its own operation."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-event/>;
    skos:altLabel "Technical event"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-event/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-event/availability-change>,
      <https://www.insperity.com/taxonomy/core-event/job-completion>, <https://www.insperity.com/taxonomy/core-event/message-receipt>,
      <https://www.insperity.com/taxonomy/core-event/system-alert> .
  
  <https://www.insperity.com/taxonomy/core-event/time-event> a skos:Concept;
    skos:prefLabel "Time event"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An event that occurs because a point in time is reached."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-event/>;
    skos:altLabel "Scheduled event"@en, "Temporal event"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-event/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-event/deadline-reached>, <https://www.insperity.com/taxonomy/core-event/effective-date-reached>,
      <https://www.insperity.com/taxonomy/core-event/expiration-reached>, <https://www.insperity.com/taxonomy/core-event/period-end>,
      <https://www.insperity.com/taxonomy/core-event/period-start> .
  
  <https://www.insperity.com/taxonomy/core-event/agreement-amendment> a skos:Concept;
    skos:prefLabel "Agreement amendment"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An agreement event in which the terms of an existing agreement are changed."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-event/>;
    skos:broader <https://www.insperity.com/taxonomy/core-event/agreement-event>;
    skos:altLabel "Contract amendment"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-event/agreement-event> a skos:Concept;
    skos:prefLabel "Agreement event"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A business event that creates, changes, or ends an agreement between parties."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-event/>;
    skos:broader <https://www.insperity.com/taxonomy/core-event/business-event>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower <https://www.insperity.com/taxonomy/core-event/agreement-amendment>,
      <https://www.insperity.com/taxonomy/core-event/agreement-execution>, <https://www.insperity.com/taxonomy/core-event/agreement-renewal>,
      <https://www.insperity.com/taxonomy/core-event/agreement-termination> .
  
  <https://www.insperity.com/taxonomy/core-event/agreement-execution> a skos:Concept;
    skos:prefLabel "Agreement execution"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An agreement event in which parties sign or accept an agreement and it becomes binding."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-event/>;
    skos:broader <https://www.insperity.com/taxonomy/core-event/agreement-event>;
    skos:altLabel "Contract signing"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-event/agreement-renewal> a skos:Concept;
    skos:prefLabel "Agreement renewal"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An agreement event in which an agreement is extended for a further term."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-event/>;
    skos:broader <https://www.insperity.com/taxonomy/core-event/agreement-event>;
    skos:altLabel "Contract renewal"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-event/agreement-termination> a skos:Concept;
    skos:prefLabel "Agreement termination"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An agreement event in which an agreement ends before or at its expiry."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-event/>;
    skos:broader <https://www.insperity.com/taxonomy/core-event/agreement-event>;
    skos:altLabel "Cancellation"@en, "Contract termination"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-event/answer-delivery> a skos:Concept;
    skos:prefLabel "Answer delivery"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An interaction event in which an artificial intelligence agent or person returns an answer to a question."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-event/>;
    skos:broader <https://www.insperity.com/taxonomy/core-event/interaction-event>;
    skos:altLabel "Assistant answer"@en, "Response"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-event/approval-denied> a skos:Concept;
    skos:prefLabel "Approval denied"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A governance event in which an authorized party rejects an item."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-event/>;
    skos:broader <https://www.insperity.com/taxonomy/core-event/governance-event>;
    skos:altLabel "Rejection"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-event/approval-granted> a skos:Concept;
