  assettax:RelationalDatabase
    a skos:Concept ;
    rdfs:label "Relational database"@en ;
    skos:prefLabel "Relational database"@en ;
    skos:definition "A data store that stores data in tables related by keys and queried with a structured query language."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/core-asset/> ;
    skos:broader assettax:DataStore ;
