partnerchannel:channel-partner
  a owl:Class ;
  rdfs:label "Channel partner"@en ;
  skos:prefLabel "Channel partner"@en ;
  skos:definition "A role borne by an organization that refers, sells or integrates with the organization's offerings under a partner agreement."@en ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:onProperty core:roleOf ;
      owl:someValuesFrom core:organization
  ] ,
      core:role ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-sales.partner-and-channel/> ;
  core:hasPrimaryTerm rolevoc:partner ;
  dct:subject rolevoc:partner ;
  owl:versionInfo "0.2.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-22"^^xsd:date ;
  dct:modified "2026-10-22T02:04:02Z"^^xsd:dateTime .

partnerchannel:partner-program
  a owl:Class ;
  rdfs:label "Partner program"@en ;
  skos:prefLabel "Partner program"@en ;
  skos:definition "A directive that sets the activities, benefits and rules under which channel partners refer, sell and are rewarded."@en ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:onProperty core:governs ;
      owl:someValuesFrom partnerchannel:channel-partner
  ] ,
      core:directive ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-sales.partner-and-channel/> ;
  core:hasPrimaryTerm partnerchannelvoc:program ;
  dct:subject partnerchannelvoc:program ;
  owl:versionInfo "0.2.0" ;
