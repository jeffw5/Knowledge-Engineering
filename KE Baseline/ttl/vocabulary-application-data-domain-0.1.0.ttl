voc:product
  a skos:Concept ;
  skos:prefLabel "Product"@en ;
  skos:definition "Represents roles, information and activities carried out by parties (e.g. individuals / organizations) playing roles that are involved in the strategic planning, definition, development and operational aspects of Products that are offered. Activities include management of Product: strategies, capabilities, lifecycles, offerings, instances, performance, contract operations, usage statistics and support of goods and services (products) that are offered to customers by an enterprise. Includes products bought by a Customer to the Service Provider & products bought by the Service Provider to Business Partners."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:data-domain ;
  skos:narrower voc:loyalty ,
      voc:product-capacity ,
      voc:product-configuration ,
      voc:product-offering ,
      voc:product-order ,
      voc:product-party-roles ,
      voc:product-performance ,
      voc:product-portfolio-plan ,
      voc:product-specification ,
      voc:product-test ,
      voc:product-usage ,
      voc:products ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-10-24T20:10:31.528Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

