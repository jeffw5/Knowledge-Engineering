        processtax:ManualStep ,
        processtax:SubprocessStep ,
        processtax:UserStep ,
        processtax:ValidationStep ,
        processtax:WaitStep ;
    core:hasPrimaryTerm processvoc:process-step ;
    dct:subject processvoc:process-step ;
    core:formalizedBy core:ProcessStep ;
    owl:versionInfo "0.1.0" ;
