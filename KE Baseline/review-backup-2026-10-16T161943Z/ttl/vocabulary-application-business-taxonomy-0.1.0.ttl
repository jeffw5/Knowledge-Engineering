voc:social-media
  a skos:Concept ;
  skos:prefLabel "Social media"@en ;
  skos:definition "Using social media platforms as a channel for customers to reach out to a company for support or information."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
