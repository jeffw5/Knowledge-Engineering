voc:market-sales-forecast
  a skos:Concept ;
  skos:prefLabel "Market sales forecast"@en ;
  skos:definition "Data representing predictions and projections for future market demand, sales volume, new service requirements, and customer needs."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:market-sales ;
  owl:versionInfo "0.1.0" ;
