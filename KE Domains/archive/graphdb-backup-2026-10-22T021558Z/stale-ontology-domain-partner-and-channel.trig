<https://www.insperity.com/ontology/domain-partner-and-channel/> {
  partnerchannel:channel-partner a owl:Class;
    rdfs:subClassOf core:role, _:node12021;
    rdfs:label "Channel partner"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-partner-and-channel/>;
    skos:prefLabel "Channel partner"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A role borne by an organization that refers, sells or integrates with the organization's offerings under a partner agreement."@en;
    owl:versionInfo "0.1.1";
    terms:subject rolevoc:partner;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm rolevoc:partner .
  
  partnerchannel:partner-program a owl:Class;
    rdfs:subClassOf core:directive, _:node12022;
    rdfs:label "Partner program"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-partner-and-channel/>;
    skos:prefLabel "Partner program"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A directive that sets the activities, benefits and rules under which channel partners refer, sell and are rewarded."@en;
    owl:versionInfo "0.1.1";
    terms:subject partnerchannelvoc:program;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm partnerchannelvoc:program .
  
  <https://www.insperity.com/ontology/domain-partner-and-channel/> a owl:Ontology;
    rdfs:label "Partner and channel domain ontology"@en;
    skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en;
    terms:description "The partner and channel ontology. It extends the core domain ontology and the Commercial Operations ontology with the channel partner role borne by organizations and the partner programs that govern how partners refer, sell and are rewarded."@en;
    terms:title "Partner and channel domain ontology"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_partner_and_channel.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.1.1 (2026-10-20): Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_partner_and_channel.py against Baseline Core v1.0 (core 0.1.0)."@en;
    terms:created "2026-10-20"^^xsd:date;
    owl:versionInfo "0.1.1";
    terms:subject domainvoc:commercial;
    owl:imports <https://www.insperity.com/ontology/core/>, <https://www.insperity.com/ontology/domain-commercial-operations/>;
    terms:isPartOf <https://www.insperity.com/domain/commercial-operations/>;
    owl:versionIRI <https://www.insperity.com/ontology/domain-partner-and-channel/0.1.1/>;
    vaem:namespace "https://www.insperity.com/ontology/domain-partner-and-channel/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft;
    vann:preferredNamespacePrefix "partnerchannel";
    terms:publisher <https://www.insperity.com/resource/core/Organization/insperity>;
    terms:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/>, <http://purl.obolibrary.org/obo/bfo/2020/bfo.owl>;
    terms:identifier "ontology-domain-partner-and-channel";
    terms:requires <https://www.insperity.com/ontology/core/0.1.0/>, <https://www.insperity.com/ontology/domain-commercial-operations/0.2.0/> .
  
  _:node12021 a owl:Restriction;
    owl:onProperty core:roleOf;
    owl:someValuesFrom core:organization .
  
  _:node12022 a owl:Restriction;
    owl:onProperty core:governs;
    owl:someValuesFrom partnerchannel:channel-partner .
}
