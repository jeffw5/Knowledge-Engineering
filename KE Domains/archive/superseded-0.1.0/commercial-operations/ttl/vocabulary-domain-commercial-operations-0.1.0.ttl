commercialopsvoc:payroll
  a skos:Concept ;
  rdfs:label "payroll"@en ;
  skos:prefLabel "payroll"@en ;
  skos:definition "The calculation, payment and recording of workers' wages, withholdings and employment taxes for each pay period."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-commercial-operations/> ;
  skos:topConceptOf <https://www.insperity.com/vocabulary/domain-commercial-operations/> ;
