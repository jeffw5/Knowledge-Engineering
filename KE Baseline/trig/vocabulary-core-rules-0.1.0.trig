  voc:decision-logic
    a skos:Concept ;
    skos:prefLabel "Decision logic"@en ;
    skos:definition "Core of what is typically referred to as 'business rules.' When a business decision needs to be made, the business rules are the individual statements of business logic that determine the result of the decision."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/> ;
    skos:broader voc:rules ;
    skos:narrower voc:action-enabler-rule ,
        voc:constraint-rule ,
        voc:derivation-rule ,
        voc:guideline ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:action-enabler-rule
    a skos:Concept ;
    skos:prefLabel "Action enabler rule"@en ;
    skos:definition "Process based rules that test conditions and upon finding them true, initiate another business event, message or other activity"@en ;
    skos:example "IF <condition> THEN action"@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/> ;
    skos:broader voc:decision-logic ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:constraint-rule
    a skos:Concept ;
    skos:prefLabel "Constraint rule"@en ;
    skos:definition "Rules used for validation of data"@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/> ;
    skos:broader voc:decision-logic ;
    skos:narrower voc:mandatory-constraint ,
        voc:operation-constraint ,
        voc:stimulus-and-response ,
        voc:structure-constraint ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:mandatory-constraint
    a skos:Concept ;
    skos:prefLabel "Mandatory constraint"@en ;
    skos:definition "Rules that reject the attempted business transaction"@en ;
    skos:scopeNote "Grammar to use during rule documentation not implementation."@en ;
    skos:example "<term> MUST BE IN LIST <a,b,c>"@en ,
        "<term> MUST HAVE <at least, at most, exactly n of> <term>"@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/> ;
    skos:broader voc:constraint-rule ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:operation-constraint
    a skos:Concept ;
    skos:prefLabel "Operation constraint"@en ;
    skos:definition "Places restrictions before and after a given operation"@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/> ;
    skos:broader voc:constraint-rule ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:stimulus-and-response
    a skos:Concept ;
    skos:prefLabel "Stimulus & response"@en ;
    skos:definition "Require conditions to be true prior to an action being taken"@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/> ;
    skos:broader voc:constraint-rule ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:structure-constraint
    a skos:Concept ;
    skos:prefLabel "Structure constraint"@en ;
    skos:definition "Authoritative constraint that established policies around classes, objects and the relationships between them that should not be disregarded"@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/> ;
    skos:broader voc:constraint-rule ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:derivation-rule
    a skos:Concept ;
    skos:prefLabel "Derivation rule"@en ;
    skos:definition "Also known as the Eligibility Rule, a set of conditions or logic that determines whether a specific characteristic or value should be derived or assigned based on other existing data or values."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/> ;
    skos:broader voc:decision-logic ;
    skos:narrower voc:computation-rule , voc:inference-rule ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:computation-rule
    a skos:Concept ;
    skos:prefLabel "Computation rule"@en ;
    skos:definition "Rule that creates new information from existing information based on mathematical calculation or use of algorithm. Result is a piece of knowledge inferred, but not simply known."@en ;
    skos:example "<term> IS COMPUTED AS <formula>"@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/> ;
    skos:broader voc:derivation-rule ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:inference-rule
    a skos:Concept ;
    skos:prefLabel "Inference rule"@en ;
    skos:definition "Specify that if certain facts are true, a particular conclusion can be determined."@en ;
    skos:example "IF <term> <operator> <term> THEN <term> <operator> <term>"@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/> ;
    skos:broader voc:derivation-rule ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:guideline
    a skos:Concept ;
    skos:prefLabel "Guideline"@en ;
    skos:definition "Rule that does not reject the transaction; they merely warn about an undesirable circumstance. Usually translates to warning messages."@en ;
    skos:example "<term> SHOULD BE IN LIST <a,b,c>"@en ,
        "<term> SHOULD HAVE <at least, at most, exactly n of> <term>"@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/> ;
    skos:broader voc:decision-logic ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:process-flow
    a skos:Concept ;
    skos:prefLabel "Process flow"@en ;
    skos:definition "Rules that purely direct the movement through a process flow (or workflow, etc.)"@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/> ;
    skos:broader voc:rules ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:structural-rule
    a skos:Concept ;
    skos:prefLabel "Structural rule"@en ;
    skos:definition "Defines the fundamental structure and organization of data, concepts, and knowledge, ensuring consistency and facilitating analysis, and is often considered a \"definitional rule\"."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/> ;
    skos:broader voc:rules ;
    skos:narrower voc:facts , voc:terms ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:facts
    a skos:Concept ;
    skos:prefLabel "Facts"@en ;
    skos:definition "Word or phrase used by the business"@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/> ;
    skos:broader voc:structural-rule ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:terms
    a skos:Concept ;
    skos:prefLabel "Terms"@en ;
    skos:definition "Relationships between two business concepts expressed as a statement connecting terms through prepositions and verbs into sensible business-relevant observations"@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/> ;
    skos:broader voc:structural-rule ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime ;
