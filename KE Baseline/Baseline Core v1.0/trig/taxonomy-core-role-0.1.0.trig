    dct:subject <https://www.insperity.com/vocabulary/core-asset/knowledge-engineering> ,
        rolevoc:role ;
    core:formalizedBy core:role ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-17T01:38:18Z"^^xsd:dateTime ;
    dct:modified "2026-10-19T18:44:22Z"^^xsd:dateTime .

  roletax:drafting-assistant
