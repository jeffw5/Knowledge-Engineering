<https://www.insperity.com/ontology/domain-sales/> {
  <https://www.insperity.com/ontology/domain-sales/> a owl:Ontology;
    rdfs:label "Sales domain ontology"@en;
    skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en;
    terms:description "The sales ontology. It extends the core domain ontology and the Commercial Operations ontology with the selling process and its steps, anchored on the process step and bridged to the buyer persona's job steps through core:addresses, and with sales quotas."@en;
    terms:title "Sales domain ontology"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_sales.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.2.0 (2026-10-20): Sales services: the Sales service class and taxonomy branch, and the step and record kinds the first service graphs are assembled from (total cost of employment analysis, benefits comparison). Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_sales.py against Baseline Core v1.0 (core 0.1.0)."@en;
    terms:created "2026-10-20"^^xsd:date;
    owl:versionInfo "0.2.0";
    terms:subject domainvoc:sales;
    owl:imports <https://www.insperity.com/ontology/core/>, <https://www.insperity.com/ontology/domain-commercial-operations/>;
    terms:isPartOf <https://www.insperity.com/domain/commercial-operations/>;
    owl:versionIRI <https://www.insperity.com/ontology/domain-sales/0.2.0/>;
    vaem:namespace "https://www.insperity.com/ontology/domain-sales/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft;
    vann:preferredNamespacePrefix "sales";
    terms:publisher <https://www.insperity.com/resource/core/Organization/insperity>;
    terms:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/>, <http://purl.obolibrary.org/obo/bfo/2020/bfo.owl>;
    terms:identifier "ontology-domain-sales";
    terms:requires <https://www.insperity.com/ontology/core/0.1.0/>, <https://www.insperity.com/ontology/domain-commercial-operations/0.2.0/> .
  
  domainsales:quota a owl:Class;
    rdfs:subClassOf core:measure, _:node11880;
    rdfs:label "Quota"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-sales/>;
    skos:prefLabel "Quota"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A measure that is the target of sales assigned to a party or territory for a period."@en;
    owl:versionInfo "0.2.0";
    terms:subject salesvoc:quota;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm salesvoc:quota .
  
  domainsales:selling-process a owl:Class;
    rdfs:subClassOf core:process, _:node11876;
    rdfs:label "Selling process"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-sales/>;
    skos:prefLabel "Selling process"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A process by which the organization pursues an opportunity from discovery to a won or lost decision and the handoff of a won client."@en;
    owl:versionInfo "0.2.0";
    terms:subject processvoc:process;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm processvoc:process .
  
  domainsales:selling-step a owl:Class;
    rdfs:subClassOf core:process-step, _:node11877, _:node11878;
    rdfs:label "Selling step"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-sales/>;
    skos:prefLabel "Selling step"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A process step of a selling process that advances an opportunity from one selling stage to the next."@en;
    skos:scopeNote "Anchors the selling stages on the process step. A selling step addresses the buyer persona's job steps through core:addresses, intentionally not one-to-one (Baseline decisions 17 and 21); its delivered outcome compared with their desired outcomes is where value gaps show."@en;
    owl:versionInfo "0.2.0";
    terms:subject processvoc:step;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm processvoc:step .
  
  domainsales:sales-service a owl:Class;
    rdfs:subClassOf core:service, _:node11879;
    rdfs:label "Sales service"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-sales/>;
    skos:prefLabel "Sales service"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A service that the organization delivers to a buyer, or to its own sellers, in the course of selling, assembled from the selling steps that deliver and support it."@en;
    skos:scopeNote "Kept as a class for its shape: every sales service must have at least one selling step that is its delivery (core:deliveryOf), and is classified by a Sales service concept (dcterms:type)."@en;
    owl:versionInfo "0.2.0";
    terms:subject servicesvoc:services;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm servicesvoc:services .
  
  _:node11876 a owl:Restriction;
    owl:onProperty core:hasStep;
    owl:someValuesFrom domainsales:selling-step .
  
  _:node11877 a owl:Restriction;
    owl:onProperty core:isStepOf;
    owl:someValuesFrom domainsales:selling-process .
  
  _:node11878 a owl:Restriction;
    owl:onProperty core:addresses;
    owl:allValuesFrom core:job-step .
  
  _:node11879 a owl:Restriction;
    owl:onProperty core:hasComponent;
    owl:allValuesFrom core:asset .
  
  _:node11880 a owl:Restriction;
    owl:onProperty core:measures;
    owl:someValuesFrom domainsales:selling-process .
}
