issuevoc:defect
  a skos:Concept ;
  rdfs:label "Defect"@en ;
  skos:prefLabel "Defect"@en ;
  skos:definition "A flaw or imperfection in a product or system that causes it to deviate from its intended behavior or specifications. This deviation may or may not impact usability."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-issue/> ;
  skos:broader issuevoc:issue ;
  skos:narrower issuevoc:major-defect , issuevoc:minor-defect ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-03-31T18:44:16.026Z"^^xsd:dateTime ;
  dct:modified "2026-10-18T00:25:49Z"^^xsd:dateTime .

issuevoc:major-defect
  a skos:Concept ;
  rdfs:label "Major defect"@en ;
  skos:prefLabel "Major defect"@en ;
  skos:definition "A significant defect that severely impacts the functionality, performance, or usability of a product or system. It may render the product unusable or cause a critical loss of data or functionality."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-issue/> ;
  skos:broader issuevoc:defect ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-03-31T18:44:16.026Z"^^xsd:dateTime ;
  dct:modified "2026-10-18T00:25:49Z"^^xsd:dateTime .

issuevoc:minor-defect
  a skos:Concept ;
  rdfs:label "Minor defect"@en ;
  skos:prefLabel "Minor defect"@en ;
  skos:definition "A small, insignificant flaw that does not significantly impact the functionality or usability of a product or system. It may be a cosmetic issue or a slight deviation from the specifications."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-issue/> ;
  skos:broader issuevoc:defect ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-03-31T18:44:16.026Z"^^xsd:dateTime ;
  dct:modified "2026-10-18T00:25:49Z"^^xsd:dateTime .

issuevoc:problem
  a skos:Concept ;
  rdfs:label "Problem"@en ;
  skos:prefLabel "Problem"@en ;
  skos:definition "A situation or event that needs to be investigated and resolved. It may be a symptom of a defect, an unexpected behavior, or a performance issue."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-issue/> ;
  skos:broader issuevoc:issue ;
  skos:narrower issuevoc:incident ;
  owl:versionInfo "0.1.0" ;
