<https://www.insperity.com/vocabulary/domain-sales/> {
  <https://www.insperity.com/vocabulary/domain-sales/> a skos:ConceptScheme;
    rdfs:label "Domain Sales Vocabulary"@en;
    skos:prefLabel "Domain Sales Vocabulary"@en;
    skos:hasTopConcept domainsalesvoc:quota, domainsalesvoc:champion, domainsalesvoc:decision-maker,
      domainsalesvoc:gatekeeper, domainsalesvoc:cycle, domainsalesvoc:cadence, domainsalesvoc:booking,
      domainsalesvoc:demonstration, domainsalesvoc:objection, domainsalesvoc:outreach, domainsalesvoc:prospecting,
      domainsalesvoc:collection, domainsalesvoc:comparison;
    skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en;
    terms:description "A controlled vocabulary of the primitives of selling professional employer organization services: quotas, prospecting and outreach, the roles in a buying committee, objections, demonstrations and bookings."@en;
    terms:title "Domain Sales Vocabulary"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_sales.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.2.0 (2026-10-20): Sales services: the Sales service class and taxonomy branch, and the step and record kinds the first service graphs are assembled from (total cost of employment analysis, benefits comparison). Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_sales.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.3.0 (2026-10-20): Sales processes (D24): a sales service is enabled by one or more sales processes (core:supports), each built from selling steps (core:hasStep). New Sales process branch (census collection, employment cost analysis, benefits plan analysis), the census request, census validation and current benefits collection steps, and the census template, census validation report and current benefits report records. A selling step is a step of any process, and a sales service must be enabled by a process. The bridge from selling steps to the buyer persona's job steps (core:addresses) moves to the value map, a separate assembly. Built by build_domains.py from spec_sales.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.4.0 (2026-10-21): Restructured to the operational areas and the naming standard (D26, D27): titled 'Domain Sales Vocabulary', '… Taxonomy', '… Ontology' and '… Shapes'; imports the Commercial Operations ontology at its new IRI. Built by build_domains.py from spec_sales.py against Baseline Core v1.0 (core 0.1.0)."@en;
    terms:created "2026-10-22"^^xsd:date;
    owl:versionInfo "0.4.0";
    terms:subject domainvoc:sales;
    terms:isPartOf <https://www.insperity.com/vocabulary/commercial-operations/>;
    owl:versionIRI <https://www.insperity.com/vocabulary/domain-sales/0.4.0/>;
    vaem:namespace "https://www.insperity.com/vocabulary/domain-sales/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft;
    vann:preferredNamespacePrefix "salesvoc";
    terms:publisher <https://www.insperity.com/resource/core/Organization/insperity>;
    terms:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/>;
    terms:identifier "vocabulary-domain-sales" .
  
  domainsalesvoc:quota a skos:Concept;
    rdfs:label "quota"@en;
    skos:prefLabel "quota"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A target, assigned to a party or territory for a period, for the sales it is expected to achieve."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-sales/>;
    owl:versionInfo "0.4.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-sales/> .
  
  domainsalesvoc:champion a skos:Concept;
    rdfs:label "champion"@en;
    skos:prefLabel "champion"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A role borne by a person at a buyer who advocates internally for the organization's offering."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-sales/>;
    owl:versionInfo "0.4.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-sales/> .
  
  domainsalesvoc:decision-maker a skos:Concept;
    rdfs:label "decision maker"@en;
    skos:prefLabel "decision maker"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A role borne by a person with the authority to commit the buyer to an agreement."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-sales/>;
    skos:scopeNote "A multiword lexical unit (Baseline decision 3)."@en;
    owl:versionInfo "0.4.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-sales/> .
  
  domainsalesvoc:gatekeeper a skos:Concept;
    rdfs:label "gatekeeper"@en;
    skos:prefLabel "gatekeeper"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A role borne by a person at a buyer who controls access to the people who decide."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-sales/>;
    owl:versionInfo "0.4.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-sales/> .
  
  domainsalesvoc:cycle a skos:Concept;
    rdfs:label "cycle"@en;
    skos:prefLabel "cycle"@en;
    skos:editorialNote "Candidate for promotion to the core: General primitive missing from the core (core-lifecycle holds only \"lifecycle\")."@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A series of stages that repeats or that runs from a defined start to a defined end."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-sales/>;
    owl:versionInfo "0.4.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-sales/> .
  
  domainsalesvoc:cadence a skos:Concept;
    rdfs:label "cadence"@en;
    skos:prefLabel "cadence"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A planned sequence of outreach contacts across channels and days for a lead or account."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-sales/>;
    owl:versionInfo "0.4.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-sales/> .
  
  domainsalesvoc:booking a skos:Concept;
    rdfs:label "booking"@en;
    skos:prefLabel "booking"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A record of a sale entered when the client signs an agreement, before the client's service starts."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-sales/>;
    owl:versionInfo "0.4.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-sales/> .
  
  domainsalesvoc:demonstration a skos:Concept;
    rdfs:label "demonstration"@en;
    skos:prefLabel "demonstration"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A presentation that shows a buyer how an offering works in use."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-sales/>;
    skos:altLabel "demo"@en;
    owl:versionInfo "0.4.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-sales/> .
  
  domainsalesvoc:objection a skos:Concept;
    rdfs:label "objection"@en;
    skos:prefLabel "objection"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A concern raised by a buyer that stands in the way of a decision to buy."@en;
