voc:access-controls
  a skos:Concept ;
  skos:prefLabel "Access controls"@en ;
  skos:definition "Mechanisms that limit access to resources based on predefined rules and permissions."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
