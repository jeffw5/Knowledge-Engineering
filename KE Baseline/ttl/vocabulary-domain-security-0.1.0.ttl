  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:smartphones
  a skos:Concept ;
  skos:prefLabel "Smartphones"@en ;
  skos:altLabel "Cell Phones"@en , "Mobile Phones"@en ;
  skos:definition "Mobile phones with advanced computing capabilities."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:endpoint ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:48.776Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:tablets
  a skos:Concept ;
  skos:prefLabel "Tablets"@en ;
  skos:definition "Mobile devices with touchscreens and capabilities similar to laptops."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:endpoint ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:48.776Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:software
  a skos:Concept ;
  skos:prefLabel "Software"@en ;
  skos:definition "Programs and other operating information used by a computer."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:systems ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:48.776Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:risk
  a skos:Concept ;
  skos:prefLabel "Risk"@en ;
  skos:definition "The potential for loss or damage that could happen if a thread successfully exploits a vulnerability."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security ;
  skos:narrower voc:risk-classification , voc:risk-management ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T15:45:11.803Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:risk-classification
  a skos:Concept ;
  skos:prefLabel "Risk classification"@en ;
  skos:definition "The process of grouping similar risks together, often for the purpose of setting insurance rates or making informed decisions about risk management."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:risk ;
  skos:narrower voc:critical-risk-data , voc:high-risk-data , voc:moderate-risk-data ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T15:46:22.363Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:critical-risk-data
  a skos:Concept ;
  skos:prefLabel "Critical risk data"@en ;
  skos:altLabel "Highly Sensitive Data"@en ;
  skos:definition "Data that must be protected or an organization will face legal consequences, fines and reputation damage if leaked. Includes Personal Health Information (PHI), financial information, Personally identifiable information (PII) and trade secrets"@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:risk-classification ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T15:48:28.441Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:high-risk-data
  a skos:Concept ;
  skos:prefLabel "High risk data"@en ;
  skos:definition "If compromised, this data could cause significant harm, but not as much as critical risk. Includes National ID numbers, Biometric data, Legal information, Sensitive corporate information"@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:risk-classification ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T15:49:33.778Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:moderate-risk-data
  a skos:Concept ;
  skos:prefLabel "Moderate risk data"@en ;
  skos:definition "Not as highly sensitive, but requires control because there would be impact if compromised. Includes internal communications, employee information, operational data, and marketing data."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:risk-classification ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T15:50:14.736Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:risk-management
  a skos:Concept ;
  skos:prefLabel "Risk management"@en ;
  skos:definition "The process of identifying, assessing, and mitigating risks to an organization."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:risk ;
  skos:narrower voc:fraud-management ,
      voc:risk-acceptance ,
      voc:risk-assessment ,
      voc:risk-avoidance ,
      voc:risk-communication ,
      voc:risk-identification ,
      voc:risk-mitigation ,
      voc:risk-monitoring ,
      voc:risk-response ,
      voc:risk-transference ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:fraud-management
  a skos:Concept ;
  skos:prefLabel "Fraud management"@en ;
  skos:definition "Detecting, investigating, and preventing fraudulent activities within an organization."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:risk-management ;
  skos:narrower voc:fraud-detection , voc:fraud-investigation , voc:fraud-prevention ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:fraud-detection
  a skos:Concept ;
  skos:prefLabel "Fraud detection"@en ;
  skos:definition "Identifying suspicious activities or patterns that may indicate fraud."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:fraud-management ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:fraud-investigation
  a skos:Concept ;
  skos:prefLabel "Fraud investigation"@en ;
  skos:definition "Gathering evidence and determining the facts surrounding a suspected fraud incident."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:fraud-management ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:fraud-prevention
  a skos:Concept ;
  skos:prefLabel "Fraud prevention"@en ;
  skos:definition "Implementing controls and measures to deter and prevent fraudulent activities."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:fraud-management ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:risk-acceptance
  a skos:Concept ;
  skos:prefLabel "Risk acceptance"@en ;
  skos:definition "Acknowledging a risk but choosing not to take action (usually for low-impact risks)."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:risk-management ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:risk-assessment
  a skos:Concept ;
  skos:prefLabel "Risk assessment"@en ;
  skos:definition "Analyzing and evaluating identified risks based on likelihood and impact. This often involves qualitative (e.g., High, Medium, Low) and quantitative (e.g., financial impact) analysis."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:risk-management ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:risk-avoidance
  a skos:Concept ;
  skos:prefLabel "Risk avoidance"@en ;
  skos:definition "Altering business processes or plans to completely avoid a particular risk."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:risk-management ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:risk-communication
  a skos:Concept ;
  skos:prefLabel "Risk communication"@en ;
  skos:definition "Effectively communicating risk information to relevant stakeholders, including management, employees, and potentially customers or partners."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:risk-management ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:risk-identification
  a skos:Concept ;
  skos:prefLabel "Risk identification"@en ;
  skos:definition "Recognizing potential threats, vulnerabilities, and their possible impact on assets."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:risk-management ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:risk-mitigation
  a skos:Concept ;
  skos:prefLabel "Risk mitigation"@en ;
  skos:definition "Implementing controls to reduce the likelihood or impact of a risk."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:risk-management ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:risk-monitoring
  a skos:Concept ;
  skos:prefLabel "Risk monitoring"@en ;
  skos:definition "Continuously tracking and reviewing risks, the effectiveness of controls, and making adjustments as needed. This is crucial as the threat landscape constantly evolves."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:risk-management ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:risk-response
  a skos:Concept ;
  skos:prefLabel "Risk response"@en ;
  skos:definition "Developing and implementing strategies to address assessed risks. Common responses include:"@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:risk-management ;
  skos:narrower voc:disaster-recovery ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:disaster-recovery
  a skos:Concept ;
  skos:prefLabel "Disaster recovery"@en ;
  skos:definition "The process of restoring critical systems and data after a disaster or major disruption."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:risk-response ;
  skos:narrower voc:business-continuity-planning ,
      voc:data-backup-and-recovery ,
      voc:disaster-recovery-testing ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:business-continuity-planning
  a skos:Concept ;
  skos:prefLabel "Business continuity planning"@en ;
  skos:definition "Developing plans and procedures to ensure business operations continue in the event of a disruption."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:disaster-recovery ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:data-backup-and-recovery
  a skos:Concept ;
  skos:prefLabel "Data backup & recovery"@en ;
  skos:definition "Regularly backing up data and having procedures in place to restore it if lost or corrupted."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:disaster-recovery ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:disaster-recovery-testing
  a skos:Concept ;
  skos:prefLabel "Disaster recovery testing"@en ;
  skos:definition "Simulating disaster scenarios to test the effectiveness of disaster recovery plans."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:disaster-recovery ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:risk-transference
  a skos:Concept ;
  skos:prefLabel "Risk transference"@en ;
  skos:definition "Shifting the responsibility for handling a risk to a third party (e.g., insurance)."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:risk-management ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:security-activities
  a skos:Concept ;
  skos:prefLabel "Security activities"@en ;
  skos:definition "Refers to measures taken to protect individuals, organizations, or information from harm, risks, or threats."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security ;
  skos:narrower voc:define-security-policies ,
      voc:define-security-standards ,
      voc:identify-security-requirements ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T15:51:22.586Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:define-security-policies
  a skos:Concept ;
  skos:prefLabel "Define security policies"@en ;
  skos:definition "Involves creating a documented set of rules and guidelines that outline how an organization will protect its assets, including data, systems, personnel, and physical resources. These policies establish a framework for maintaining confidentiality, integrity, and availability of information, while also providing a foundation for establishing secure practices and handling security incidents."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security-activities ;
  skos:narrower voc:enforcement-and-penalties ,
      voc:policy-requirements ,
      voc:protocols ,
      voc:purpose-and-scope ,
      voc:responsibilities ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T15:51:54.165Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:enforcement-and-penalties
  a skos:Concept ;
  skos:prefLabel "Enforcement & penalties"@en ;
  skos:definition "Ensures that security rules and guidelines are consistently followed, and penalties are the consequences for violating those policies. It involves monitoring, detecting, and taking action against security policy violations, which can range from logging the event to blocking connections or taking other corrective actions."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:define-security-policies ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T15:52:26.452Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:policy-requirements
  a skos:Concept ;
  skos:prefLabel "Policy requirements"@en ;
  skos:definition "a documented statement outlining specific security functionalities needed to ensure a software or system meets defined security properties. These requirements are often derived from industry standards, legal mandates, and past vulnerabilities. They serve as the foundation for designing and implementing secure systems and applications."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:define-security-policies ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T15:53:05.278Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:protocols
  a skos:Concept ;
  skos:prefLabel "Protocols"@en ;
  skos:definition "The specific procedures and rules used to implement those policies, often involving cryptography and network security measures."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:define-security-policies ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T15:53:37.433Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:purpose-and-scope
  a skos:Concept ;
  skos:prefLabel "Purpose & scope"@en ;
  skos:definition "The purpose of a policy outlines the reason for its existence and the objectives it aims to achieve. The scope of a policy specifies what it applies to, including individuals, departments, situations, and actions."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:define-security-policies ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T15:54:27.353Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:responsibilities
  a skos:Concept ;
  skos:prefLabel "Responsibilities"@en ;
  skos:definition "Define the roles and accountability assigned to individuals or groups for implementing, monitoring, and ensuring compliance with a policy. These responsibilities can cover areas like policy ownership, oversight, implementation, and adherence. Effective policies clearly define these responsibilities, ensuring that actions are taken consistently and effectively."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:define-security-policies ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T15:54:54.621Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:define-security-standards
  a skos:Concept ;
  skos:prefLabel "Define security standards"@en ;
  skos:definition "Establishing specific, measurable guidelines and expectations for how an organization should protect its assets and information. These standards ensure consistency in security practices, compliance with regulations, and a baseline level of protection against threats. They act as a framework for implementing security measures and can be customized to fit specific needs and risk profiles."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security-activities ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T15:55:24.982Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:identify-security-requirements
  a skos:Concept ;
  skos:prefLabel "Identify security requirements"@en ;
  skos:definition "Involves determining the specific measures a system or application must take to protect its assets and users from potential threats and vulnerabilities. It's a crucial step in planning and design, ensuring the security objectives, expectations, and responsibilities of stakeholders are aligned and compliance with relevant standards is met."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security-activities ;
  skos:narrower voc:discovery-and-selection ,
      voc:implementation-and-testing ,
      voc:investigation-and-documentation ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T15:55:55.279Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:discovery-and-selection
  a skos:Concept ;
  skos:prefLabel "Discovery & selection"@en ;
  skos:altLabel "Requirements Analysis"@en ,
      "Requirements Definition"@en ,
      "Requirements Elicitation"@en ,
      "Requirements Gathering"@en ;
  skos:definition "The process of identifying and understanding the needs and expectations of stakeholders for a project, while requirements selection is the process of choosing which of those identified requirements will be included in the final project scope."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:identify-security-requirements ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T15:57:46.735Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:implementation-and-testing
  a skos:Concept ;
  skos:prefLabel "Implementation & testing"@en ;
  skos:definition "Involves translating documented requirements into a functioning product and verifying that it meets those specifications. Implementation involves building the software or system based on the defined requirements, while testing ensures that the implemented solution behaves as expected and meets the established criteria."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:identify-security-requirements ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T15:58:15.999Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:investigation-and-documentation
  a skos:Concept ;
  skos:prefLabel "Investigation & documentation"@en ;
  skos:definition "The process of systematically identifying, analyzing, and formally recording the needs, expectations, and constraints of a project. This includes understanding what a system or product should do, how it should function, and the conditions it needs to operate under. The goal is to create a clear and comprehensive understanding of the project's goals and scope, ensuring that stakeholders and development teams are on the same page."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:identify-security-requirements ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T15:58:47.565Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:security-processes
  a skos:Concept ;
  skos:prefLabel "Security processes"@en ;
  skos:definition "The procedures and protocols designed to safeguard an organization's assets, data, and systems from unauthorized access, threats, or breaches. They encompass a range of actions, from physical security measures to cybersecurity practices, all aimed at ensuring the safety and integrity of the organization's resources."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security ;
  skos:narrower voc:access , voc:audit , voc:authentication , voc:authorization , voc:entitlement ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T15:59:20.713Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:access
  a skos:Concept ;
  skos:prefLabel "Access"@en ;
  skos:definition "The mechanisms and procedures that control who and what can access a specific resource or system within an organization. It involves both authentication, verifying a user's identity, and authorization, determining what specific access privileges they have. This process helps ensure that only authorized individuals can interact with sensitive data or systems, protecting against unauthorized access and potential breaches."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security-processes ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T15:59:51.865Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:audit
  a skos:Concept ;
  skos:prefLabel "Audit"@en ;
  skos:definition "A systematic review and evaluation of an organization's information security procedures and controls to assess their effectiveness and identify any weaknesses or areas for improvement. It helps ensure compliance with industry standards and regulations, detect vulnerabilities, and strengthen overall security posture."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security-processes ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T16:00:31.183Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:authentication
  a skos:Concept ;
  skos:prefLabel "Authentication"@en ;
  skos:definition "The process of verifying the identity of a user, device, or system to ensure that they are who they claim to be before granting them access to a system or resource. It's a fundamental security measure to prevent unauthorized access and protect sensitive information."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security-processes ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T16:02:31.030Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:authorization
  a skos:Concept ;
  skos:prefLabel "Authorization"@en ;
  skos:definition "The process of verifying and granting or denying access to specific resources or actions within a system after a user has been successfully authenticated. It's about controlling what a user is allowed to do with an authenticated identity."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security-processes ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T16:03:10.173Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:entitlement
  a skos:Concept ;
  skos:prefLabel "Entitlement"@en ;
  skos:definition "The right or privilege granted to a user, process, or system to access or interact with a specific resource or system within a security context. It defines what actions are allowed and what resources are accessible."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security-processes ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T16:03:38.129Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:security-tools
  a skos:Concept ;
  skos:prefLabel "Security tools"@en ;
  skos:definition "Software or hardware used to enhance security posture and mitigate risks."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security ;
  skos:narrower voc:antivirus-software ,
      voc:application-security-tools ,
      voc:authentication-and-access-control-systems ,
      voc:backup-software ,
      voc:data-loss-prevention-solutions ,
      voc:data-masking-tools ,
      voc:email-security-solutions ,
      voc:encryption-software ,
      voc:firewalls ,
      voc:security-information-and-event-management ,
      voc:security-models ,
      voc:surveillance-and-security-personnel ,
      voc:vulnerability-scanners ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:48.776Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:antivirus-software
  a skos:Concept ;
  skos:prefLabel "Antivirus software"@en ;
  skos:definition "Software designed to detect and remove malicious software from computer systems."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security-tools ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:application-security-tools
  a skos:Concept ;
  skos:prefLabel "Application security tools"@en ;
  skos:definition "Software and methodologies used to identify and mitigate vulnerabilities within applications, protecting them from various threats."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security-tools ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T16:04:15.137Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:authentication-and-access-control-systems
  a skos:Concept ;
  skos:prefLabel "Authentication & access control systems"@en ;
  skos:definition "Security mechanisms that verify user identities (authentication) and determine their permitted actions (authorization) within a system or network. Authentication ensures a user is who they claim to be, while access control, or authorization, dictates what they can do after successful authentication. This combined approach is crucial for securing data and resources."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security-tools ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T16:04:45.333Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:backup-software
  a skos:Concept ;
  skos:prefLabel "Backup software"@en ;
  skos:definition "A type of computer program designed to create copies of your data and files for safekeeping and later recovery."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security-tools ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T16:05:14.881Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:data-loss-prevention-solutions
  a skos:Concept ;
  skos:prefLabel "Data loss prevention solutions"@en ;
  skos:definition "Tools and techniques used to detect and prevent the unauthorized transmission or loss of sensitive data."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security-tools ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:data-masking-tools
  a skos:Concept ;
  skos:prefLabel "Data masking tools"@en ;
  skos:definition "Software solutions that replace sensitive data with fake, yet realistic, information to protect it while enabling data sharing for testing, training, or analytics"@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security-tools ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T16:05:44.569Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:email-security-solutions
  a skos:Concept ;
  skos:prefLabel "Email security solutions"@en ;
  skos:definition "Tools and practices that safeguard email communication from various cyber threats, including unauthorized access, data leaks, and malicious content like malware, phishing attempts, and spam. They aim to protect individuals, businesses, and organizations by ensuring the confidentiality, integrity, and availability of email messages."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security-tools ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T16:06:09.588Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:encryption-software
  a skos:Concept ;
  skos:prefLabel "Encryption software"@en ;
  skos:definition "Software that uses cryptographic algorithms to convert digital data into an unreadable format (ciphertext), protecting it from unauthorized access. This process, called encryption, ensures that only authorized individuals with the correct decryption key can access the original data (plaintext). Encryption software is crucial for safeguarding sensitive information both at rest (stored on devices) and in transit (being transmitted over networks)."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security-tools ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T16:06:33.672Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:firewalls
  a skos:Concept ;
  skos:prefLabel "Firewalls"@en ;
  skos:definition "A part of a computer system or network which is designed to block unauthorized access while permitting outward communication."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security-tools ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T16:06:59.341Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:security-information-and-event-management
  a skos:Concept ;
  skos:prefLabel "Security information & event management"@en ;
  skos:definition "A type of security software that provides a centralized platform for collecting, analyzing, and managing security data from multiple sources."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security-tools ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:48.776Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:security-models
  a skos:Concept ;
  skos:prefLabel "Security models"@en ;
  skos:definition "Frameworks that define security policies and controls for systems or organizations."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security-tools ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:48.776Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:surveillance-and-security-personnel
  a skos:Concept ;
  skos:prefLabel "Surveillance & security personnel"@en ;
  skos:definition "Individuals responsible for monitoring security systems, responding to incidents, and enforcing security policies."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security-tools ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:48.776Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:vulnerability-scanners
  a skos:Concept ;
  skos:prefLabel "Vulnerability scanners"@en ;
  skos:definition "A computer program that identifies and assesses security weaknesses in networks, systems, and applications. It helps organizations identify potential vulnerabilities like misconfigurations, outdated software, or weak passwords before they can be exploited."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security-tools ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T16:07:53.656Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:threats
  a skos:Concept ;
  skos:prefLabel "Threats"@en ;
  skos:definition "Potential dangers or risks that could exploit vulnerabilities and cause harm."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security ;
  skos:narrower voc:dangers ,
      voc:emerging-threats ,
      voc:phishing ,
      voc:ransomware ,
      voc:social-engineering ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:48.776Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:dangers
  a skos:Concept ;
  skos:prefLabel "Dangers"@en ;
  skos:definition "Situations or events that pose a threat to security."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:threats ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:emerging-threats
  a skos:Concept ;
  skos:prefLabel "Emerging threats"@en ;
  skos:definition "New and evolving threats that may not be well understood or have known countermeasures."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:threats ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:phishing
  a skos:Concept ;
  skos:prefLabel "Phishing"@en ;
  skos:definition "A type of social engineering attack that tricks users into revealing sensitive information."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:threats ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:ransomware
  a skos:Concept ;
  skos:prefLabel "Ransomware"@en ;
  skos:definition "Malicious software that encrypts data and demands a ransom for its release."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:threats ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:social-engineering
  a skos:Concept ;
  skos:prefLabel "Social engineering"@en ;
  skos:definition "Manipulating individuals into divulging confidential information or performing actions that compromise security."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:threats ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:48.776Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:vulnerability
  a skos:Concept ;
  skos:prefLabel "Vulnerability"@en ;
  skos:definition "A weakness in a system or application that could be exploited by a threat."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:security ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
