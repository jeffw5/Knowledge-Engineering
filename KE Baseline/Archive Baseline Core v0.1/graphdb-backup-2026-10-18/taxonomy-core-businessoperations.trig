  <https://www.insperity.com/taxonomy/core-businessoperations/> a owl:Ontology;
    rdfs:label "Core business operations taxonomy"@en;
    terms:description "The business operations taxonomy categorizes and organizes information, providing a comprehensive view of the organization's operational landscape"@en;
    terms:title "Core businessoperations taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T02:20:31Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en,
      "2026-10-17: Conformance Review before release — 1 label changed."@en, "2026-10-17: Conformance Review before release — 1 description changed."@en;
    terms:created "2025-03-26T14:43:19.667Z"^^xsd:dateTime;
    skos:altLabel "Taxonomy | Core | Business Operations"@en, "Core businessoperations taxonomy"@en;
    owl:versionInfo "0.1.0";
    owl:imports <https://www.insperity.com/taxonomy/core-process/>;
    owl:versionIRI <https://www.insperity.com/taxonomy/core-businessoperations/0.1.0/>;
    vann:preferredNamespaceUri "https://www.insperity.com/taxonomy/core-businessoperations/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-businessoperations/BusinessOperations> a
      owl:Class;
