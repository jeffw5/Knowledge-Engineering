  a sh:NodeShape ;
  rdfs:label "Asset shape"@en ;
  skos:prefLabel "Asset shape"@en ;
  skos:definition "A shape that checks an asset has a lifecycle and that its components are assets."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/core/> ;
  sh:targetClass core:asset ;
  sh:property [
      sh:path core:hasLifecycle ;
