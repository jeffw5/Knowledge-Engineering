<https://www.insperity.com/vocabulary/core-domain/> {
  <https://www.insperity.com/vocabulary/core-domain/> a skos:ConceptScheme;
    rdfs:label "Core domain vocabulary"@en;
    skos:prefLabel "Core domain vocabulary"@en;
    skos:hasTopConcept domainvoc:domain;
    terms:description "A business domain defines the core area of expertise and operations for a company."@en;
    terms:title "Core domain vocabulary"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2025-03-25T17:00:29.476Z"^^xsd:dateTime;
    skos:altLabel "Vocabulary | Core | Domain"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/vocabulary/core-domain/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  domainvoc:domain a skos:Concept;
    skos:prefLabel "Domain"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-25T17:25:10.376Z"^^xsd:dateTime;
    skos:definition "A business domain defines the core area of expertise and operations for a company."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-domain/>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/core-domain/>;
    skos:narrower domainvoc:commercial, domainvoc:corporate, domainvoc:network, domainvoc:supply-chain .
  
  domainvoc:commercial a skos:Concept;
    skos:prefLabel "Commercial"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:30.207Z"^^xsd:dateTime;
    skos:definition "Relating to business or commerce, particularly the buying and selling of goods and services."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-domain/>;
    skos:broader domainvoc:domain;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domainvoc:customer-support, domainvoc:marketing, domainvoc:sales .
  
  domainvoc:corporate a skos:Concept;
    skos:prefLabel "Corporate"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:30.207Z"^^xsd:dateTime;
    skos:definition "Relating to a corporation or large company, often referring to its overall structure, management, and operations."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-domain/>;
    skos:broader domainvoc:domain;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domainvoc:compliance, domainvoc:facilities, domainvoc:finance, domainvoc:human-resource,
      domainvoc:information-technology, domainvoc:legal, domainvoc:procurement .
  
  domainvoc:network a skos:Concept;
    skos:prefLabel "Network"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:30.207Z"^^xsd:dateTime;
    skos:definition "A system that allows users to exchange information and data through a network of interconnected nodes and links."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-domain/>;
    skos:broader domainvoc:domain;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domainvoc:supply-chain a skos:Concept;
    skos:prefLabel "Supply chain"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:30.207Z"^^xsd:dateTime;
    skos:definition "The network of all individuals, organizations, resources, activities, and technology involved in creating and selling a product, from the delivery of source materials from the supplier to the manufacturer through to its eventual delivery to the end user."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-domain/>;
    skos:broader domainvoc:domain;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domainvoc:logistics .
  
  domainvoc:customer-support a skos:Concept;
    skos:prefLabel "Customer support"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:30.207Z"^^xsd:dateTime;
    skos:definition "The process of providing assistance and guidance to customers before, during, and after their purchase of a product or service."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-domain/>;
    skos:broader domainvoc:commercial;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domainvoc:marketing a skos:Concept;
    skos:prefLabel "Marketing"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:30.207Z"^^xsd:dateTime;
    skos:definition "The activities a company undertakes to promote the buying or selling of a product or service. This includes advertising, public relations, and market research."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-domain/>;
    skos:broader domainvoc:commercial;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domainvoc:sales a skos:Concept;
    skos:prefLabel "Sales"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:30.207Z"^^xsd:dateTime;
    skos:definition "The process of selling goods or services to customers, often involving persuasion and negotiation to close deals."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-domain/>;
    skos:broader domainvoc:commercial;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domainvoc:retail-sales, domainvoc:sales-operations .
  
  domainvoc:retail-sales a skos:Concept;
    skos:prefLabel "Retail sales"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:30.207Z"^^xsd:dateTime;
    skos:definition "The sale of goods directly to consumers for personal use, typically through physical stores or online platforms."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-domain/>;
    skos:broader domainvoc:sales;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domainvoc:sales-operations a skos:Concept;
    skos:prefLabel "Sales operations"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:30.207Z"^^xsd:dateTime;
    skos:definition "The processes, systems, and technology that support and enable sales teams to sell more effectively and efficiently."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-domain/>;
    skos:broader domainvoc:sales;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domainvoc:compliance a skos:Concept;
    skos:prefLabel "Compliance"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:30.207Z"^^xsd:dateTime;
    skos:definition "Adhering to laws, regulations, and internal policies that are relevant to a particular industry or organization."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-domain/>;
    skos:broader domainvoc:corporate;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domainvoc:facilities a skos:Concept;
    skos:prefLabel "Facilities"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:30.207Z"^^xsd:dateTime;
    skos:definition "Buildings, equipment, and other physical assets that are required for a company to operate."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-domain/>;
    skos:broader domainvoc:corporate;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domainvoc:real-estate .
  
  domainvoc:finance a skos:Concept;
    skos:prefLabel "Finance"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:30.207Z"^^xsd:dateTime;
    skos:definition "The management of money, including activities such as investing, borrowing, lending, budgeting, and forecasting."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-domain/>;
    skos:broader domainvoc:corporate;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domainvoc:human-resource a skos:Concept;
    skos:prefLabel "Human resource"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:30.207Z"^^xsd:dateTime;
    skos:definition "The department within a company responsible for managing the employee life cycle, including recruitment, hiring, training, compensation, and benefits."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-domain/>;
    skos:broader domainvoc:corporate;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domainvoc:information-technology a skos:Concept;
    skos:prefLabel "Information technology"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:30.207Z"^^xsd:dateTime;
    skos:definition "The use of computers and telecommunications equipment to store, retrieve, transmit, and manipulate data."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-domain/>;
    skos:broader domainvoc:corporate;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domainvoc:legal a skos:Concept;
    skos:prefLabel "Legal"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:30.207Z"^^xsd:dateTime;
    skos:definition "Relating to the law and its application, often involving legal advice, representation, and documentation."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-domain/>;
    skos:broader domainvoc:corporate;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domainvoc:risk, domainvoc:security .
  
  domainvoc:procurement a skos:Concept;
    skos:prefLabel "Procurement"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:30.207Z"^^xsd:dateTime;
    skos:definition "The process of acquiring goods or services from external sources, typically involving sourcing, negotiation, and contract management."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-domain/>;
    skos:broader domainvoc:corporate;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domainvoc:real-estate a skos:Concept;
    skos:prefLabel "Real estate"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:30.207Z"^^xsd:dateTime;
    skos:definition "Property consisting of land and the buildings on it, along with its natural resources such as crops, minerals, or water."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-domain/>;
    skos:broader domainvoc:facilities;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domainvoc:risk a skos:Concept;
    skos:prefLabel "Risk"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:30.207Z"^^xsd:dateTime;
    skos:definition "The possibility of something happening that will have an impact on an organization’s objectives."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-domain/>;
    skos:broader domainvoc:legal;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domainvoc:security a skos:Concept;
    skos:prefLabel "Security"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:30.207Z"^^xsd:dateTime;
    skos:definition "The protection of an organization’s assets, including its physical property, information, and employees, from threats and vulnerabilities."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-domain/>;
    skos:broader domainvoc:legal;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domainvoc:logistics a skos:Concept;
    skos:prefLabel "Logistics"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:30.207Z"^^xsd:dateTime;
