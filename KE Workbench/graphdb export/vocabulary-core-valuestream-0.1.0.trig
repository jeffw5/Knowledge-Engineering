<https://www.insperity.com/vocabulary/core-valuestream/> {
  <https://www.insperity.com/vocabulary/core-valuestream/> a skos:ConceptScheme;
    rdfs:label "Core valuestream vocabulary"@en;
    skos:prefLabel "Core valuestream vocabulary"@en;
    skos:hasTopConcept valuestreamvoc:value-stream;
    terms:description "A series of steps an organization undertakes to deliver a product or service to a customer, from initial concept to final delivery and beyond."@en;
    terms:title "Core valuestream vocabulary"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2025-03-25T16:59:41.558Z"^^xsd:dateTime;
    skos:altLabel "Vocabulary | Core | Value Stream"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/vocabulary/core-valuestream/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  valuestreamvoc:value-stream a skos:Concept;
