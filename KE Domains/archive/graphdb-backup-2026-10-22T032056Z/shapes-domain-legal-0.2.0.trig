<https://www.insperity.com/shapes/domain-legal/> {
  <https://www.insperity.com/shapes/domain-legal/> a owl:Ontology;
    rdfs:label "Domain Legal Shapes"@en;
    skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en;
    terms:description "SHACL shapes that keep every norm traced to the provision that states it and every statute scoped to its jurisdiction."@en;
    terms:title "Domain Legal Shapes"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_legal.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.1.1 (2026-10-20): Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_legal.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.2.0 (2026-10-21): Restructured to the operational areas and the naming standard (D26, D27): titled 'Domain Legal Vocabulary', '… Taxonomy', '… Ontology' and '… Shapes'; moved from Commercial Operations to Business Operations. It now owns the client service agreement, commercial agreement and clause (from Commercial Operations) and the contract management steps, agreement terms and agreement statuses (from Pricing and contracts). It cites Commercial Operations primitives (D27) but imports only the core and the Business Operations ontology. Built by build_domains.py from spec_legal.py against Baseline Core v1.0 (core 0.1.0)."@en;
    terms:created "2026-10-22"^^xsd:date;
    owl:versionInfo "0.2.0";
    terms:subject domainvoc:legal;
    owl:imports <https://www.insperity.com/ontology/domain-legal/>;
    terms:isPartOf <https://www.insperity.com/shapes/business-operations/>;
    owl:versionIRI <https://www.insperity.com/shapes/domain-legal/0.2.0/>;
    vaem:namespace "https://www.insperity.com/shapes/domain-legal/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft;
    vann:preferredNamespacePrefix "legalshp";
    terms:publisher <https://www.insperity.com/resource/core/Organization/insperity>;
    terms:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/>;
    terms:identifier "shapes-domain-legal";
    terms:requires <https://www.insperity.com/ontology/domain-legal/0.2.0/> .
  
  legalshp:norm-shape a sh:NodeShape;
    rdfs:label "Norm shape"@en;
    rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-legal/>;
    skos:prefLabel "Norm shape"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A shape that checks a norm binds a role and is traced to the provision, clause or policy that states it."@en;
    owl:versionInfo "0.2.0";
    sh:property _:node12061, _:node12062;
    sh:targetClass domainlegal:norm;
    core:hasLifecycleStatus core:Draft .
  
  legalshp:statute-shape a sh:NodeShape;
    rdfs:label "Statute shape"@en;
    rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-legal/>;
    skos:prefLabel "Statute shape"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A shape that checks a statute names its jurisdiction."@en;
    owl:versionInfo "0.2.0";
    sh:property _:node12063;
    sh:targetClass domainlegal:statute;
    core:hasLifecycleStatus core:Draft .
  
  legalshp:regulation-shape a sh:NodeShape;
    rdfs:label "Regulation shape"@en;
    rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-legal/>;
    skos:prefLabel "Regulation shape"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A shape that checks a regulation names its jurisdiction."@en;
    owl:versionInfo "0.2.0";
    sh:property _:node12064;
    sh:targetClass domainlegal:regulation;
    core:hasLifecycleStatus core:Draft .
  
  legalshp:legal-matter-shape a sh:NodeShape;
    rdfs:label "Legal matter shape"@en;
    rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-legal/>;
    skos:prefLabel "Legal matter shape"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A shape that checks a legal matter is governed by directives."@en;
    owl:versionInfo "0.2.0";
    sh:property _:node12065;
    sh:targetClass domainlegal:legal-matter;
    core:hasLifecycleStatus core:Draft .
  
  legalshp:client-service-agreement-shape a sh:NodeShape;
    rdfs:label "Client service agreement shape"@en;
    rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-legal/>;
    skos:prefLabel "Client service agreement shape"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A shape that checks a client service agreement names its parties and is built from clauses."@en;
    owl:versionInfo "0.2.0";
    sh:property _:node12066, _:node12067;
    sh:targetClass domainlegal:client-service-agreement;
    core:hasLifecycleStatus core:Draft .
  
  _:node12061 sh:path domainlegal:binds;
    sh:class core:role;
    sh:minCount 1;
    sh:message "A norm must name the role it binds."@en .
  
  _:node12062 sh:path core:componentOf;
    sh:class core:directive;
    sh:minCount 1;
    sh:message "A norm should be traced to the provision, clause or policy that states it."@en;
    sh:severity sh:Warning .
  
  _:node12063 sh:path domainlegal:hasJurisdiction;
    sh:class core:location;
    sh:minCount 1;
    sh:message "A statute must name the jurisdiction in which it applies."@en .
  
  _:node12064 sh:path domainlegal:hasJurisdiction;
    sh:class core:location;
    sh:minCount 1;
    sh:message "A regulation must name the jurisdiction in which it applies."@en .
  
  _:node12065 sh:path core:governedBy;
    sh:class core:directive;
    sh:message "governed by must point to a directive."@en .
  
  _:node12066 sh:path core:concerns;
    sh:class core:party;
    sh:minCount 2;
    sh:message "A client service agreement must name both parties to the co-employment relationship."@en;
    sh:severity sh:Warning .
  
  _:node12067 sh:path core:hasComponent;
    sh:class domainlegal:clause;
    sh:minCount 1;
    sh:message "A client service agreement should be built from clauses, including the allocation of employer responsibilities."@en;
    sh:severity sh:Warning .
}
