    skos:narrower <https://www.insperity.com/taxonomy/core-policy/industry-standard>,
      <https://www.insperity.com/taxonomy/core-policy/internal-standard>, <https://www.insperity.com/taxonomy/core-policy/international-standard> .
  
  <https://www.insperity.com/taxonomy/core-policy/acceptable-use-policy> a skos:Concept;
    skos:prefLabel "Acceptable use policy"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
