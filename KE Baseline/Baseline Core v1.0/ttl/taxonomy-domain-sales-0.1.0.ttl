  a skos:Concept ;
  rdfs:label "Evaluate"@en ;
  skos:prefLabel "Evaluate"@en ;
  skos:altLabel "Evaluation"@en ;
  skos:definition "A selling stage in which the buyer assesses the organization's offerings against its needs and its alternatives."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/> ;
