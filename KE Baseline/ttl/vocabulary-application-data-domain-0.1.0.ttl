voc:usage
  a skos:Concept ;
  skos:prefLabel "Usage"@en ;
  skos:definition "An occurrence record of employing a product, service, or resource for its intended purpose, which is of business interest and potentially chargeable."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
