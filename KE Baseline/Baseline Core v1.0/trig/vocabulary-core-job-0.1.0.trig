  jobvoc:functional
    a skos:Concept ;
    rdfs:label "functional"@en ;
    skos:prefLabel "functional"@en ;
    skos:definition "A kind of job concerned with the practical task a party is trying to get done."@en ;
    skos:scopeNote "Job kinds are functional and emotional; both are evaluated in the context of the job being performed."@en ;
