  applicationdatadomainvoc:resource-capacity terms:created "2025-10-24T20:11:44.803Z"^^xsd:dateTime;
    skos:definition "Data representing the measurable, specific ability of a Resource entity over an extended period (e.g., maximum port bandwidth)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:resource-network-and-device;
    skos:related applicationdatadomainvoc:capacity .
  
  applicationdatadomainvoc:service-capacity terms:created "2025-10-24T20:12:39.056Z"^^xsd:dateTime;
    skos:definition "Service Capacity refers to the maximum amount of load, traffic, or service instances that a network service can support under defined technical and operational conditions. It represents a measurable limit or threshold applied to a service specification, often tied to performance, resource availability, and quality of service (QoS) constraints. Scope Includes: • Bandwidth limits (e.g., max throughput for a transport service) • Concurrent sessions or flows (e.g., number of voice calls or VPN tunnels) • Service instances per resource (e.g., number of virtual services on a node) • Latency or jitter thresholds for specific capacity tiers • Allocation limits for network slices, virtualized functions, or access ports"@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:service-network;
    skos:related applicationdatadomainvoc:capacity .
  
  applicationdatadomainvoc:entity-catalog terms:created "2025-10-24T20:09:08.211Z"^^xsd:dateTime;
    skos:definition "Data representing the structured repository (Catalog) of specifications and entities for various common business entities."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:catalog .
  
  applicationdatadomainvoc:product-catalog terms:created "2025-10-24T20:11:12.276Z"^^xsd:dateTime;
    skos:definition "A collection of data entities representing the structured repository of Product Offering specifications and their prices."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:product-offering;
    skos:related applicationdatadomainvoc:catalog .
  
  applicationdatadomainvoc:resource-catalog terms:created "2025-10-24T20:12:05.962Z"^^xsd:dateTime;
    skos:definition "A collection of data entities representing the structured repository of Resource Specifications."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:resource-specification;
    skos:related applicationdatadomainvoc:catalog .
  
  applicationdatadomainvoc:service-catalog terms:created "2025-10-24T20:12:56.127Z"^^xsd:dateTime;
    skos:definition "The Service Catalogue is a structured repository that contains and organizes all network-related Service Specifications, including both abstract and resource-facing service definitions. It acts as the single source of truth for reusable, standard network service building blocks."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:service-specification;
    skos:example """Examples of Entries in the Network Service Catalogue:
        •        LTE Access Service
        •        DWDM Transport Service
        •        Virtual Firewall Service
        •        5G Low-Latency Network Slice Service"""@en;
    skos:scopeNote """        •        Includes only network services (access, transport, core, virtualized, etc.)
        •        Organizes specifications by service type, technology domain, or use case
        •        Serves orchestration and fulfillment systems for service instantiation
        •        Excludes commercial product configurations and customer-facing bundles
"""@en;
    skos:related applicationdatadomainvoc:catalog .
  
  applicationdatadomainvoc:business-rule terms:created "2025-10-24T20:09:16.516Z"^^xsd:dateTime;
    skos:definition "A formal set of information that defines the instructions or logic governing how a specific process or activity must be performed."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:closed-loop .
  
  applicationdatadomainvoc:closed-loop-activity terms:created "2025-10-24T20:09:16.516Z"^^xsd:dateTime;
    skos:definition "Data representing a specific unit of work within the Closed Loop management framework."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:closed-loop .
  
  applicationdatadomainvoc:product-configuration terms:created "2025-10-24T20:10:46.974Z"^^xsd:dateTime;
    skos:definition "Data defining how an instance of a Product is set up and functions in terms of its technical characteristics and related specifications."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:product;
    skos:related applicationdatadomainvoc:configuration-and-profiling .
  
  applicationdatadomainvoc:resource-configuration terms:created "2025-10-24T20:11:44.803Z"^^xsd:dateTime;
    skos:definition "Data defining how a Resource operates or functions in terms of its technical settings and related specifications."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:resource-network-and-device;
    skos:related applicationdatadomainvoc:configuration-and-profiling .
  
  applicationdatadomainvoc:service-configuration terms:created "2025-10-24T20:12:39.056Z"^^xsd:dateTime;
    skos:definition "Service Configuration refers to the specific set of parameters, policies, and settings applied to a network service instance to define its operational behavior. This includes QoS profiles, routing rules, port bindings, bandwidth allocation, and other technical attributes."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:service-network;
    skos:related applicationdatadomainvoc:configuration-and-profiling .
  
  applicationdatadomainvoc:example-metric-entities terms:created "2025-10-24T20:09:25.726Z"^^xsd:dateTime;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:metric;
    skos:notation "Data illustrating the use and composition of Metric entities for different business scenarios." .
  
  applicationdatadomainvoc:metric-best-practices terms:created "2025-10-24T20:09:25.726Z"^^xsd:dateTime;
    skos:definition "Data or documentation defining recommended or optimal ways to define and manage Metrics."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:metric .
  
  applicationdatadomainvoc:metric-definition terms:created "2025-10-24T20:09:25.726Z"^^xsd:dateTime;
    skos:definition "Data describing the core definition of a metric, including its category, dimensions, and relationship to measured entities."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:metric .
  
  applicationdatadomainvoc:metric-definition-measure terms:created "2025-10-24T20:09:25.726Z"^^xsd:dateTime;
    skos:definition "Data specifying the specific aspect, including thresholds and consequences, that is to be measured as part of a Metric Definition."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:metric .
  
  applicationdatadomainvoc:metric-measure terms:created "2025-10-24T20:09:25.726Z"^^xsd:dateTime;
    skos:definition "Data entities containing the actual, measured values according to a Metric Definition Measure."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:metric .
  
  applicationdatadomainvoc:metric-monitoring terms:created "2025-10-24T20:09:25.726Z"^^xsd:dateTime;
    skos:definition "Data entities enabling the tracking, scheduling, and collection of Metric Measure data (e.g., measurement jobs)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:metric .
  
  applicationdatadomainvoc:performance-category terms:created "2025-10-24T20:09:32.725Z"^^xsd:dateTime;
    skos:definition "Data used to classify or group different types of Performance measures (e.g., financial, operational, quality)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:performance .
  
  applicationdatadomainvoc:performance-monitoring terms:created "2025-10-24T20:09:32.725Z"^^xsd:dateTime;
    skos:definition "Data structures and processes related to the continuous tracking and data collection of Performance measures."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:performance .
  
  applicationdatadomainvoc:performance-specification terms:created "2025-10-24T20:09:32.725Z"^^xsd:dateTime;
    skos:definition "The technical blueprint that defines the characteristics and behavior of a Performance measure or indicator."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:performance .
  
  applicationdatadomainvoc:performance-threshold terms:created "2025-10-24T20:09:32.725Z"^^xsd:dateTime;
    skos:definition "Data defining the acceptable limits or boundary values for a Performance metric, which trigger an alert or action if violated."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:performance .
  
  applicationdatadomainvoc:product-performance terms:created "2025-10-24T20:10:46.974Z"^^xsd:dateTime;
    skos:definition "Data handling the goals, results, and assessment of end-to-end performance for a Product."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:product;
    skos:related applicationdatadomainvoc:performance .
  
  applicationdatadomainvoc:resource-performance terms:created "2025-10-24T20:11:44.803Z"^^xsd:dateTime;
    skos:definition "Data (statistics, operational characteristics) collected, correlated, and validated to monitor and report on Resource functioning."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:resource-network-and-device;
    skos:related applicationdatadomainvoc:performance .
  
  applicationdatadomainvoc:service-performance terms:created "2025-10-24T20:12:39.056Z"^^xsd:dateTime;
    skos:definition "Service Performance refers to the continuous monitoring, measurement, and evaluation of a network service’s behavior and effectiveness against defined technical and operational criteria. It ensures that network services operate within expected thresholds and meet agreed service levels."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:service-network;
    skos:related applicationdatadomainvoc:performance .
  
  applicationdatadomainvoc:policy-application terms:created "2025-10-24T20:09:44.299Z"^^xsd:dateTime;
    skos:definition "Data defining the components and capabilities that use Policy entities to make decisions, enforce rules, and execute actions."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:policy .
  
  applicationdatadomainvoc:policy-framework terms:created "2025-10-24T20:09:44.299Z"^^xsd:dateTime;
    skos:definition "The high-level data model and structure that organizes and relates various Policy specifications and rules."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:policy .
  
  applicationdatadomainvoc:policy-framework-specification terms:created "2025-10-24T20:09:44.299Z"^^xsd:dateTime;
    skos:definition "Data defining the invariant characteristics and behavior (templates) for Policy entities, such as Policy Rules and their components."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:policy;
    skos:altLabel "Policy Framework Spec"@en .
  
  applicationdatadomainvoc:policy-management terms:created "2025-10-24T20:09:44.299Z"^^xsd:dateTime;
    skos:definition "Data entities used to define, manage, and govern the lifecycle of Policy structures and rules that impact other domains."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:policy .
  
  applicationdatadomainvoc:policy-structure terms:created "2025-10-24T20:09:44.299Z"^^xsd:dateTime;
    skos:definition "Data representing the core components of a Policy as a triplet: {event, condition, action}, including grouping and nesting rules."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:policy .
  
  applicationdatadomainvoc:activity terms:created "2025-10-24T20:09:58.060Z"^^xsd:dateTime;
    skos:definition "A distinct unit of work or action within a larger Project or workflow, with defined start and end points."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:project .
  
  applicationdatadomainvoc:activity-lifecycle terms:created "2025-10-24T20:09:58.060Z"^^xsd:dateTime;
    skos:definition "The data model representing the possible states and transitions of an Activity (e.g., planned, in-progress, completed)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:project .
  
  applicationdatadomainvoc:project-calendar terms:created "2025-10-24T20:09:58.060Z"^^xsd:dateTime;
    skos:definition "Data defining the working days, holidays, and availability used for scheduling and tracking Project timelines."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:project .
  
  applicationdatadomainvoc:project-resource terms:created "2025-10-24T20:09:58.060Z"^^xsd:dateTime;
