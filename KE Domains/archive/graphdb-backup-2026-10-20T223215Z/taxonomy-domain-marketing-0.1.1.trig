<https://www.insperity.com/taxonomy/domain-marketing/> {
  <https://www.insperity.com/taxonomy/domain-marketing/> a skos:ConceptScheme;
    rdfs:label "Marketing domain taxonomy"@en;
    skos:prefLabel "Marketing domain taxonomy"@en;
    skos:hasTopConcept marketingtax:audience-definition, marketingtax:buyer-persona, marketingtax:competitive-alternative,
      marketingtax:competitive-insight, marketingtax:competitive-intelligence, marketingtax:competitive-intelligence-activity,
      marketingtax:competitive-outcome, marketingtax:funnel-stage, marketingtax:marketing-campaign,
      marketingtax:marketing-channel, marketingtax:marketing-content, marketingtax:marketing-measure,
      marketingtax:marketing-signal;
    skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en;
    terms:description "A classification of marketing campaigns, channels, content, audiences, funnel stages and measures, and of competitive intelligence: its products, activities, the kinds of competitive alternative a professional employer organization faces, competitive insights and competitive outcomes."@en;
    terms:title "Marketing domain taxonomy"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_marketing.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.1.1 (2026-10-20): Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_marketing.py against Baseline Core v1.0 (core 0.1.0)."@en;
    terms:created "2026-10-20"^^xsd:date;
    owl:versionInfo "0.1.1";
    terms:subject domainvoc:marketing;
    terms:isPartOf <https://www.insperity.com/domain/commercial-operations/>;
    owl:versionIRI <https://www.insperity.com/taxonomy/domain-marketing/0.1.1/>;
    terms:source <https://www.insperity.com/vocabulary/core-asset/>, <https://www.insperity.com/vocabulary/core-domain/>,
      <https://www.insperity.com/vocabulary/core-event/>, <https://www.insperity.com/vocabulary/core-issue/>,
      <https://www.insperity.com/vocabulary/core-persona/>, <https://www.insperity.com/vocabulary/core-process/>,
      <https://www.insperity.com/vocabulary/core-product/>, <https://www.insperity.com/vocabulary/core-role/>,
      <https://www.insperity.com/vocabulary/core-services/>, <https://www.insperity.com/vocabulary/domain-marketing/>,
      <https://www.insperity.com/vocabulary/core-decision/>, <https://www.insperity.com/vocabulary/core-governance/>,
      <https://www.insperity.com/vocabulary/core-job/>, <https://www.insperity.com/vocabulary/core-measure/>,
      <https://www.insperity.com/vocabulary/core-value/>, <https://www.insperity.com/vocabulary/domain-commercial-operations/>;
    vaem:namespace "https://www.insperity.com/taxonomy/domain-marketing/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft;
    vann:preferredNamespacePrefix "marketingtax";
    terms:publisher <https://www.insperity.com/resource/core/Organization/insperity>;
    terms:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/> .
  
  marketingtax:audience-definition a skos:Concept;
    rdfs:label "Audience definition"@en;
    skos:prefLabel "Audience definition"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "An information asset that defines the parties a campaign or message is meant to reach."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-marketing/>;
    owl:versionInfo "0.1.1";
    terms:subject assetvoc:definition, marketingvoc:audience;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-marketing/>;
    skos:narrower marketingtax:firmographic-profile, marketingtax:target-segment;
    core:hasPrimaryTerm assetvoc:definition .
  
  marketingtax:buyer-persona a skos:Concept;
    rdfs:label "Buyer persona"@en;
    skos:prefLabel "Buyer persona"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A persona of a person who takes part in buying the organization's offerings, assembled from the jobs, job steps and desired outcomes of that person."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-marketing/>;
    skos:scopeNote "One Persona model (Baseline decision 22); buyer personas are instances assembled from the Persona and Jobs models and are not typed by role (decision 23)."@en;
    owl:versionInfo "0.1.1";
    terms:subject personavoc:persona, domaincommercialoperationsvoc:buyer;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-marketing/>;
    core:hasPrimaryTerm personavoc:persona .
  
  marketingtax:competitive-alternative a skos:Concept;
    rdfs:label "Competitive alternative"@en;
    skos:prefLabel "Competitive alternative"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A kind of competitor or alternative that a buyer of professional employer organization services may choose instead."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-marketing/>;
    owl:versionInfo "0.1.1";
    terms:subject domaincommercialoperationsvoc:competitor, marketingvoc:alternative;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-marketing/>;
    skos:narrower marketingtax:administrative-services-competitor, marketingtax:human-capital-management-software-provider,
      marketingtax:insurance-carrier, marketingtax:payroll-provider, marketingtax:professional-employer-organization-competitor,
      marketingtax:status-quo;
    core:hasPrimaryTerm marketingvoc:alternative .
  
  marketingtax:competitive-insight a skos:Concept;
    rdfs:label "Competitive insight"@en;
    skos:prefLabel "Competitive insight"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "Competitive intelligence that states a finding about a competitor or about the organization's position against it."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-marketing/>;
    owl:versionInfo "0.1.1";
    terms:subject issuevoc:finding, domaincommercialoperationsvoc:competitor;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-marketing/>;
    skos:narrower marketingtax:competitive-threat, marketingtax:competitor-strength, marketingtax:competitor-weakness,
      marketingtax:differentiator;
    core:hasPrimaryTerm issuevoc:finding .
  
  marketingtax:competitive-intelligence a skos:Concept;
    rdfs:label "Competitive intelligence"@en;
    skos:prefLabel "Competitive intelligence"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "Intelligence about competitors, their offerings and the market, gathered and analyzed to inform the organization's decisions."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-marketing/>;
    skos:altLabel "CI"@en;
    owl:versionInfo "0.1.1";
    terms:subject domaincommercialoperationsvoc:competitor, marketingvoc:intelligence;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-marketing/>;
    skos:narrower marketingtax:battlecard, marketingtax:competitive-landscape, marketingtax:competitor-profile,
      marketingtax:market-intelligence, marketingtax:pricing-intelligence;
    core:hasPrimaryTerm marketingvoc:intelligence .
  
  marketingtax:competitive-intelligence-activity a skos:Concept;
    rdfs:label "Competitive intelligence activity"@en;
    skos:prefLabel "Competitive intelligence activity"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A process step that gathers or analyzes competitive intelligence."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-marketing/>;
    owl:versionInfo "0.1.1";
    terms:subject processvoc:activity, domaincommercialoperationsvoc:competitor, marketingvoc:intelligence;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-marketing/>;
    skos:narrower marketingtax:competitor-monitoring, marketingtax:market-research, marketingtax:strengths-weaknesses-opportunities-and-threats-analysis,
      marketingtax:win-loss-analysis;
    core:hasPrimaryTerm processvoc:activity .
  
  marketingtax:competitive-outcome a skos:Concept;
    rdfs:label "Competitive outcome"@en;
    skos:prefLabel "Competitive outcome"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "An event that ends a competition between the organization and a competitor for a buyer."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-marketing/>;
    owl:versionInfo "0.1.1";
    terms:subject jobvoc:outcome, domaincommercialoperationsvoc:competitor;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-marketing/>;
    skos:narrower marketingtax:competitive-loss, marketingtax:displacement;
    core:hasPrimaryTerm jobvoc:outcome .
  
  marketingtax:funnel-stage a skos:Concept;
    rdfs:label "Funnel stage"@en;
    skos:prefLabel "Funnel stage"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A status of a lead that records how far it has progressed from awareness to a purchase."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-marketing/>;
    skos:scopeNote "The provider's view of a lead's progress; it is not a job step of the buyer persona (Baseline decision 21)."@en;
    owl:versionInfo "0.1.1";
    terms:subject domaincommercialoperationsvoc:stage, marketingvoc:funnel;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-marketing/>;
