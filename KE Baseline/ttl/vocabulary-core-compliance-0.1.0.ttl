voc:data-access-controls
  a skos:Concept ;
  skos:prefLabel "Data access controls"@en ;
  skos:definition "Security measures that regulate who can access specific data based on their roles and responsibilities within an organization."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/> ;
