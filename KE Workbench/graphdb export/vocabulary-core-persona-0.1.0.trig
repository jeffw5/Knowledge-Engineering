  <https://www.insperity.com/vocabulary/core-persona/> a skos:ConceptScheme;
    rdfs:label "Core persona vocabulary"@en;
    skos:prefLabel "Core persona vocabulary"@en;
    skos:hasTopConcept personavoc:persona;
    terms:description "A semi-fictional representation of your ideal customer, based on research and data about existing and potential customers."@en;
    terms:title "Core persona vocabulary"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2025-03-25T16:57:28.358Z"^^xsd:dateTime;
    skos:altLabel "Vocabulary | Core | Persona"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/vocabulary/core-persona/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  personavoc:persona a skos:Concept;
    skos:prefLabel "Persona"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-25T17:21:12.495Z"^^xsd:dateTime;
    skos:definition "A semi-fictional representation of your ideal customer, based on research and data about existing and potential customers."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-persona/>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/core-persona/>;
    skos:narrower personavoc:persona-data, personavoc:personalization-data, personavoc:preference-data,
      personavoc:prior-history-data, personavoc:profile-data, personavoc:user-behavior-data .
  
  personavoc:persona-data a skos:Concept;
    skos:prefLabel "Persona data"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:46:17.202Z"^^xsd:dateTime;
    skos:definition "Information collected and used to create and refine personas."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-persona/>;
    skos:broader personavoc:persona;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower personavoc:persona-demographics, personavoc:persona-ethnographics, personavoc:persona-industry,
      personavoc:persona-role, personavoc:persona-type .
  
  personavoc:personalization-data a skos:Concept;
    skos:prefLabel "Personalization data"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:46:17.202Z"^^xsd:dateTime;
    skos:definition "Information used to tailor user experiences, often collected from individual user interactions and preferences."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-persona/>;
    skos:broader personavoc:persona;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower personavoc:personalization-algorithm, personavoc:recommendation-history,
      personavoc:user-segment-data .
  
  personavoc:preference-data a skos:Concept;
    skos:prefLabel "Preference data"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:46:17.202Z"^^xsd:dateTime;
    skos:definition "Data reflecting user’s choices, likes, dislikes, and configurations."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-persona/>;
    skos:broader personavoc:persona;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
