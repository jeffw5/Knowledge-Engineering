customersuccessshp:client-success-step-shape
  a sh:NodeShape ;
  rdfs:label "Client success step shape"@en ;
  skos:prefLabel "Client success step shape"@en ;
  skos:definition "A shape that checks a client success step belongs to a client success process."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-customer-success/> ;
  sh:targetClass customersuccess:client-success-step ;
  sh:property [
      sh:path core:isStepOf ;
      sh:class customersuccess:client-success-process ;
      sh:message "A client success step must be a step of a client success process."@en ;
      sh:minCount "1"^^xsd:integer
  ] ,
      [
      sh:path core:addresses ;
      sh:class core:job-step ;
      sh:message "addresses must point to a job step of the client persona."@en
  ] ;
  owl:versionInfo "0.1.1" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-20"^^xsd:date ;
  dct:modified "2026-10-20T04:19:14Z"^^xsd:dateTime .

customersuccessshp:health-score-shape
  a sh:NodeShape ;
  rdfs:label "Health score shape"@en ;
  skos:prefLabel "Health score shape"@en ;
  skos:definition "A shape that checks a health score measures an account."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-customer-success/> ;
  sh:targetClass customersuccess:health-score ;
  sh:property [
      sh:path core:measures ;
      sh:class commercialops:account ;
      sh:message "A health score must measure a client account."@en ;
      sh:minCount "1"^^xsd:integer
  ] ;
  owl:versionInfo "0.1.1" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-20"^^xsd:date ;
  dct:modified "2026-10-20T04:19:14Z"^^xsd:dateTime .

customersuccessshp:playbook-shape
  a sh:NodeShape ;
  rdfs:label "Playbook shape"@en ;
  skos:prefLabel "Playbook shape"@en ;
  skos:definition "A shape that checks a playbook governs at least one client success step."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-customer-success/> ;
  sh:targetClass customersuccess:playbook ;
  sh:property [
      sh:path core:governs ;
      sh:message "A playbook should govern the steps it sets."@en ;
      sh:minCount "1"^^xsd:integer ;
      sh:severity sh:Warning
  ] ;
  owl:versionInfo "0.1.1" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-20"^^xsd:date ;
  dct:modified "2026-10-20T04:19:14Z"^^xsd:dateTime .
