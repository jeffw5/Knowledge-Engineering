    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:product .
  
  applicationdatadomainvoc:product-offering terms:created "2025-10-24T20:10:46.974Z"^^xsd:dateTime;
    skos:definition "Data describing tangible and intangible goods made available for a price to the market via a catalog."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:product .
  
  applicationdatadomainvoc:product-order terms:created "2025-10-24T20:10:46.974Z"^^xsd:dateTime;
    skos:definition "The data record of a formal request to procure or update one or many Products (both customer and business partner orders)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:product .
  
  applicationdatadomainvoc:product-party-roles terms:created "2025-10-24T20:10:46.974Z"^^xsd:dateTime;
    skos:definition "Data defining the roles (e.g., Product Manager) that different Parties play within the Product domain."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:product;
    skos:related applicationdatadomainvoc:party-roles .
  
  applicationdatadomainvoc:product-portfolio-plan terms:created "2025-10-24T20:10:46.974Z"^^xsd:dateTime;
