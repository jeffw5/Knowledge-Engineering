  a owl:Ontology ;
  rdfs:label "Customer success domain ontology"@en ;
  dct:title "Customer success domain ontology"@en ;
  dct:description "The customer success ontology. It extends the core domain ontology and the Commercial Operations ontology with the client success process and its steps, client health scores that measure accounts, and playbooks that govern client success steps."@en ;
