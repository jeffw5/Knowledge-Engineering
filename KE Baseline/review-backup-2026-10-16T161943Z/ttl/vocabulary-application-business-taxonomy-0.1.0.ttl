  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-07-31T20:53:26.466Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:gross-profit-margin
  a skos:Concept ;
  skos:prefLabel "Gross profit margin"@en ;
  skos:definition "A measurement of Total Revenue minus Cost of Goods Sold divided by Revenue."@en ;
  skos:notation "TL5000071" ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:margin ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-07-31T20:53:31.968Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:net-profit-margin
  a skos:Concept ;
  skos:prefLabel "Net profit margin"@en ;
  skos:definition "A measurement of Net Income divided by Revenue."@en ;
  skos:notation "TL5000073" ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:margin ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-07-31T20:53:31.968Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:operating-profit-margin
  a skos:Concept ;
  skos:prefLabel "Operating profit margin"@en ;
  skos:definition "A measurement of Operating Income divided by Revenue."@en ;
  skos:notation "TL5000072" ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:margin ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
