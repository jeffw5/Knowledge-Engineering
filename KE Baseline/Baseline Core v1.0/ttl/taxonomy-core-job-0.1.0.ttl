jobtax:job
  a skos:Concept ;
  rdfs:label "Job"@en ;
  skos:prefLabel "Job"@en ;
  skos:definition "An activity that a party is trying to get done, described independently of any product, service or process that might help."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core-job/> ;
  skos:topConceptOf <https://www.insperity.com/taxonomy/core-job/> ;
  skos:narrower jobtax:core-job ,
      jobtax:emotional-job ,
      jobtax:functional-job ,
      jobtax:related-job ;
  core:hasPrimaryTerm jobvoc:job ;
  dct:subject jobvoc:job ;
  core:formalizedBy core:job ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-19"^^xsd:date ;
  dct:modified "2026-10-19T18:44:21Z"^^xsd:dateTime .

jobtax:functional-job
  a skos:Concept ;
  rdfs:label "Functional job"@en ;
  skos:prefLabel "Functional job"@en ;
  skos:definition "A job concerned with the practical task the party is trying to get done."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core-job/> ;
  skos:broader jobtax:job ;
  core:hasPrimaryTerm jobvoc:job ;
  dct:subject jobvoc:functional , jobvoc:job ;
  owl:versionInfo "0.1.0" ;
