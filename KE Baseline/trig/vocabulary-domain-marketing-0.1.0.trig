  voc:service-management
    a skos:Concept ;
    skos:prefLabel "Service management"@en ;
    skos:definition "The process of designing, delivering, and managing services."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
    skos:broader voc:product-management ;
    owl:versionInfo "0.1.0" ;
