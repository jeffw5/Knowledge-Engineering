    vaem:namespace "https://www.insperity.com/vocabulary/hr-service-operations/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft;
    vann:preferredNamespacePrefix "hrserviceopsvoc";
    terms:publisher <https://www.insperity.com/resource/core/Organization/insperity>;
    terms:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/>;
    terms:identifier "vocabulary-hr-service-operations" .
  
  hrserviceopsvoc:administration a skos:Concept;
    rdfs:label "administration"@en;
    skos:prefLabel "administration"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "The organized performance of the routine work of running an activity, such as payroll or benefits, on behalf of others."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/hr-service-operations/>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/hr-service-operations/> .
  
  hrserviceopsvoc:coaching a skos:Concept;
