commercialopsvoc:qualification
  a skos:Concept ;
  rdfs:label "qualification"@en ;
  skos:prefLabel "qualification"@en ;
  skos:definition "A determination that a lead or opportunity meets the criteria for the organization to pursue it."@en ;
  skos:scopeNote "Narrower than core-decision determination: the determination is made against fit and readiness criteria such as the ideal customer profile."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-commercial-operations/> ;
