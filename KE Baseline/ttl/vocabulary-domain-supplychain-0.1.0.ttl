voc:production-scheduling
  a skos:Concept ;
  skos:prefLabel "Production scheduling"@en ;
  skos:definition "The process of creating a schedule for production activities."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-supplychain/> ;
