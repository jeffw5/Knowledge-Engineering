    terms:created "2025-10-31T15:36:53.630Z"^^xsd:dateTime;
    skos:definition "A specialized discipline under Data Governance that helps Verizon find, understand & use data more effectively by capturing human expertise in structured knowledge systems."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/>;
    skos:broader domaingovernancevoc:data-governance-operations;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domaingovernancevoc:access-control-policies a skos:Concept;
