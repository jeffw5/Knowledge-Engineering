  voc:influencer-discovery-and-vetting
    a skos:Concept ;
    skos:prefLabel "Influencer discovery & vetting"@en ;
    skos:definition "Identifying and evaluating potential influencers based on their reach, relevance, and credibility."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
