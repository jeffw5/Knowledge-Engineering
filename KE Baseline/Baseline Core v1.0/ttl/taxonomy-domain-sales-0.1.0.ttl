domainsalestax:buying-role
  a skos:Concept ;
  rdfs:label "Buying role"@en ;
  skos:prefLabel "Buying role"@en ;
  skos:definition "A role borne by a person at a buyer that shapes how the buyer reaches its decision."@en ;
  skos:scopeNote "Buying roles are roles in a purchase decision, not personas (Baseline decisions 22 and 23): a persona instance may bear one in a given opportunity."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/> ;
  skos:topConceptOf <https://www.insperity.com/taxonomy/domain-sales/> ;
  skos:narrower domainsalestax:champion ,
      domainsalestax:decision-maker ,
      domainsalestax:economic-buyer ,
      domainsalestax:gatekeeper ,
      domainsalestax:influencer ;
  dct:subject commercialoperationsvoc:buying-role , rolevoc:buying-role ;
  core:formalizedBy core:role ;
  owl:versionInfo "0.1.0" ;
  skos:broadMatch roletax:commercial-role ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
