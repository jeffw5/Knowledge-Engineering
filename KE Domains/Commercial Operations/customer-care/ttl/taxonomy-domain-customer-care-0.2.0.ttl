customercaretax:client-success-stage
  a skos:Concept ;
  rdfs:label "Client success stage"@en ;
  skos:prefLabel "Client success stage"@en ;
  skos:definition "A process step of the client success process: the provider's view of where a client stands after the sale."@en ;
  skos:scopeNote "The provider's view (Baseline decision 21); the client persona's jobs and job steps are addressed by these steps, not equal to them. Specializes, through the steps, the core \"Client lifecycle\"."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/domain-customer-care/> ;
  skos:topConceptOf <https://www.insperity.com/taxonomy/domain-customer-care/> ;
  skos:narrower customercaretax:adoption ,
      customercaretax:advocacy ,
      customercaretax:client-onboarding ,
      customercaretax:client-renewal ,
      customercaretax:expansion ;
  core:hasPrimaryTerm commercialopsvoc:stage ;
  dct:subject commercialopsvoc:stage , measurevoc:success , rolevoc:client ;
  core:formalizedBy customercare:client-success-step ;
  owl:versionInfo "0.2.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-22"^^xsd:date ;
  dct:modified "2026-10-22T02:04:02Z"^^xsd:dateTime .

