# Standards: Semantic Governance: Services, Architecture & Integration v1.9 (Draft), Part III

@prefix core: <https://www.insperity.com/ontology/core/> .
@prefix coreshp: <https://www.insperity.com/shapes/core/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix domaintax: <https://www.insperity.com/taxonomy/core-domain/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vaem: <http://www.linkedmodel.org/schema/vaem#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://www.insperity.com/shapes/core/>
  a owl:Ontology ;
  rdfs:label "Core domain shapes"@en ;
  dct:title "Core domain shapes"@en ;
  dct:description "SHACL shapes that keep data built on the core domain ontology anchored: every process step belongs to a process and every job step to a job; directives, measures, issues and events are tied to the steps they govern, measure, concern or trigger; assets have lifecycles; and desired outcomes are mapped to job steps and measured, so value gaps can be found."@en ;
  dct:subject domaintax:EnterpriseArchitecture ;
  owl:imports <https://www.insperity.com/ontology/core/> ;
  vaem:namespace "https://www.insperity.com/shapes/core/"^^xsd:anyURI ;
  vann:preferredNamespacePrefix "coreshp" ;
  dct:language "en" ;
  dct:publisher <https://www.insperity.com/resource/core/Organization/insperity> ;
  dct:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/> ;
  skos:changeNote "0.1.0 (2026-10-19): process-step anchoring shapes for https://www.insperity.com/ontology/core/, built from shapes-core.source.ttl. Replace the core-compliance, core-domain, core-party, core-process and core-product shapes graphs."@en ;
  owl:versionInfo "0.1.0" ;
  owl:versionIRI <https://www.insperity.com/shapes/core/0.1.0/> ;
  dct:identifier "shapes-core" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:contributor "Jeffrey Wallk" ;
  dct:created "2026-10-18"^^xsd:date ;
  dct:modified "2026-10-19T18:45:40Z"^^xsd:dateTime .

coreshp:process-shape
  a sh:NodeShape ;
  rdfs:label "Process shape"@en ;
  skos:prefLabel "Process shape"@en ;
  skos:definition "A shape that checks a process is broken down into steps."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/core/> ;
  sh:targetClass core:process ;
  sh:property [
      sh:path core:hasStep ;
      sh:class core:process-step ;
      sh:message "A process should have at least one process step."@en ;
      sh:minCount "1"^^xsd:integer ;
      sh:severity sh:Warning
  ] ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-19"^^xsd:date ;
  dct:modified "2026-10-19T18:45:40Z"^^xsd:dateTime .

coreshp:process-step-shape
  a sh:NodeShape ;
  rdfs:label "Process step shape"@en ;
  skos:prefLabel "Process step shape"@en ;
  skos:definition "A shape that checks a process step is part of a process and that what it is related to has the right type."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/core/> ;
  sh:targetClass core:process-step ;
  sh:property [
      sh:path core:governedBy ;
      sh:class core:directive ;
      sh:message "governed by must point to a directive."@en
  ] ,
      [
      sh:path core:measuredBy ;
      sh:class core:measure ;
      sh:message "measured by must point to a measure."@en
  ] ,
      [
      sh:path core:hasIssue ;
      sh:class core:issue ;
      sh:message "has issue must point to an issue."@en
  ] ,
      [
      sh:path core:triggeredBy ;
      sh:class core:event ;
      sh:message "triggered by must point to an event."@en
  ] ,
      [
      sh:path core:precedes ;
      sh:class core:process-step ;
      sh:message "precedes must point to another process step."@en
  ] ,
      [
      sh:path core:occursIn ;
      sh:class core:location ;
      sh:message "occurs in must point to a location."@en
  ] ,
      [
      sh:path core:occupiesTime ;
      sh:class core:time ;
      sh:maxCount "1"^^xsd:integer ;
      sh:message "A process step occupies at most one time."@en
  ] ,
      [
      sh:path core:deliveryOf ;
      sh:class core:asset ;
      sh:message "delivery of must point to the product or service delivered."@en
  ] ,
      [
      sh:path core:addresses ;
      sh:class core:job-step ;
      sh:message "addresses must point to a job step."@en
  ] ,
      [
      sh:path core:isStepOf ;
      sh:class core:process ;
      sh:message "A process step must be a step of a process."@en ;
      sh:minCount "1"^^xsd:integer
  ] ,
      [
      sh:path core:performedBy ;
      sh:message "A process step should name the party (manual) or digital agent (automated) that performs it."@en ;
      sh:minCount "1"^^xsd:integer ;
      sh:or ( [
          sh:class core:party
      ] [
          sh:class core:asset
      ] ) ;
      sh:severity sh:Warning
  ] ,
      [
      sh:path core:fulfillsRole ;
      sh:class core:role ;
      sh:message "fulfills role must point to a role."@en
  ] ,
      [
      sh:path core:exercisesCapability ;
      sh:class core:capability ;
      sh:message "exercises capability must point to a capability."@en
  ] ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-19"^^xsd:date ;
  dct:modified "2026-10-19T18:45:40Z"^^xsd:dateTime .

coreshp:job-shape
  a sh:NodeShape ;
  rdfs:label "Job shape"@en ;
  skos:prefLabel "Job shape"@en ;
  skos:definition "A shape that checks a job is broken down into job steps."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/core/> ;
  sh:targetClass core:job ;
  sh:property [
      sh:path core:hasStep ;
      sh:class core:job-step ;
      sh:message "A job should have at least one job step."@en ;
      sh:minCount "1"^^xsd:integer ;
      sh:severity sh:Warning
  ] ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-19"^^xsd:date ;
  dct:modified "2026-10-19T18:45:40Z"^^xsd:dateTime .

coreshp:job-step-shape
  a sh:NodeShape ;
  rdfs:label "Job step shape"@en ;
  skos:prefLabel "Job step shape"@en ;
  skos:definition "A shape that checks a job step is part of a job and has a desired outcome."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/core/> ;
  sh:targetClass core:job-step ;
  sh:property [
      sh:path core:isStepOf ;
      sh:class core:job ;
      sh:message "A job step must be a step of a job."@en ;
      sh:minCount "1"^^xsd:integer
  ] ,
      [
      sh:path core:hasOutcome ;
      sh:message "A job step should have at least one desired outcome."@en ;
      sh:qualifiedMinCount "1"^^xsd:integer ;
      sh:qualifiedValueShape [
          sh:class core:desired-outcome
      ] ;
      sh:severity sh:Warning
  ] ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-19"^^xsd:date ;
  dct:modified "2026-10-19T18:45:40Z"^^xsd:dateTime .

coreshp:desired-outcome-shape
  a sh:NodeShape ;
  rdfs:label "Desired outcome shape"@en ;
  skos:prefLabel "Desired outcome shape"@en ;
  skos:definition "A shape that checks a desired outcome is mapped to a job step and measured."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/core/> ;
  sh:targetClass core:desired-outcome ;
  sh:property [
      sh:path core:outcomeOf ;
      sh:class core:job-step ;
      sh:message "A desired outcome must be mapped to a job step."@en ;
      sh:minCount "1"^^xsd:integer
  ] ,
      [
      sh:path core:measuredBy ;
      sh:class core:measure ;
      sh:message "A desired outcome should name the measure (metric card) that measures it."@en ;
      sh:minCount "1"^^xsd:integer ;
      sh:severity sh:Warning
  ] ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-19"^^xsd:date ;
  dct:modified "2026-10-19T18:45:40Z"^^xsd:dateTime .

coreshp:delivered-outcome-shape
  a sh:NodeShape ;
  rdfs:label "Delivered outcome shape"@en ;
  skos:prefLabel "Delivered outcome shape"@en ;
  skos:definition "A shape that checks a delivered outcome is mapped to a job step and says what achieved it."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/core/> ;
  sh:targetClass core:delivered-outcome ;
  sh:property [
      sh:path core:outcomeOf ;
      sh:class core:job-step ;
      sh:message "A delivered outcome must be mapped to a job step."@en ;
      sh:minCount "1"^^xsd:integer
  ] ,
      [
      sh:path core:achievedBy ;
      sh:message "A delivered outcome should name the product, service or process step that achieved it."@en ;
      sh:minCount "1"^^xsd:integer ;
      sh:severity sh:Warning
  ] ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-19"^^xsd:date ;
  dct:modified "2026-10-19T18:45:40Z"^^xsd:dateTime .

