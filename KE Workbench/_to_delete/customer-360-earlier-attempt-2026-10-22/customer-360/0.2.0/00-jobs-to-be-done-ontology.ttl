  dct:modified "2026-10-22T19:46:03Z"^^xsd:dateTime .

jtbd:subject-matter-review
  a owl:Class ;
  rdfs:label "Subject-matter review"@en ;
  skos:prefLabel "Subject-matter review"@en ;
  skos:definition "A process in which one business or compliance subject-matter expert judges the wording, placement and permitted uses of a persona, job or desired outcome."@en ;
  rdfs:subClassOf obo:BFO_0000015 ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/jobs-to-be-done/> ;
  core:hasLifecycleStatus core:Draft ;
  dct:created "2026-10-22"^^xsd:date ;
  dct:modified "2026-10-22T19:46:03Z"^^xsd:dateTime .

jtbd:review-decision
  a owl:Class ;
  rdfs:label "Review decision"@en ;
  skos:prefLabel "Review decision"@en ;
  skos:definition "A decision that accepts or drops a persona, job or desired outcome after its subject-matter reviews, with its final wording and approved uses."@en ;
  rdfs:subClassOf core:decision ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/jobs-to-be-done/> ;
  core:hasPrimaryTerm decisionvoc:decision ;
  core:hasLifecycleStatus core:Draft ;
  dct:created "2026-10-22"^^xsd:date ;
  dct:modified "2026-10-22T19:46:03Z"^^xsd:dateTime .

jtbd:survey-wave
  a owl:Class ;
  rdfs:label "Survey wave"@en ;
  skos:prefLabel "Survey wave"@en ;
  skos:definition "A process in which the outcome benchmark survey is fielded once and its importance and satisfaction ratings are collected."@en ;
  rdfs:subClassOf obo:BFO_0000015 ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/jobs-to-be-done/> ;
  core:hasLifecycleStatus core:Draft ;
