      jobtax:job ,
      jobtax:job-executor ,
      jobtax:job-step ,
      jobtax:job-study ;
  dct:subject domaintax:EnterpriseArchitecture ;
  vaem:namespace "https://www.insperity.com/taxonomy/core-job/"^^xsd:anyURI ;
  vann:preferredNamespacePrefix "jobtax" ;
  dct:language "en" ;
  dct:source <https://www.insperity.com/vocabulary/> ,
      <https://www.insperity.com/vocabulary/core-job/> ,
