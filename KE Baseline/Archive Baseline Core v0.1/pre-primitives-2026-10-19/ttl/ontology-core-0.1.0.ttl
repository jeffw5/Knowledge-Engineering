  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-19"^^xsd:date ;
  dct:modified "2026-10-19T02:19:17Z"^^xsd:dateTime .

core:DecisionModel
  a owl:Class ;
  rdfs:label "Decision model"@en ;
  skos:prefLabel "Decision model"@en ;
  skos:definition "A directive that specifies how a decision is to be made, from its inputs, rules and possible outcomes."@en ;
