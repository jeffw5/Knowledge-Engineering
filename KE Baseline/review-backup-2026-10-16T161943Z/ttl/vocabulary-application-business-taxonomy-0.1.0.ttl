voc:postpaid
  a skos:Concept ;
  skos:prefLabel "Postpaid"@en ;
  skos:definition "A billing model where the customer pays for services after usage, typically at the end of a billing cycle."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
