      personavoc:persona-user-identifier .
  
  personavoc:user-behavior-data a skos:Concept;
    skos:prefLabel "User behavior data"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:46:17.202Z"^^xsd:dateTime;
    skos:definition "Information about how users interact with a system or product, including their actions, patterns, and choices."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-persona/>;
    skos:broader personavoc:persona;
    owl:versionInfo "0.1.0";
