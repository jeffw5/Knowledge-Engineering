<https://www.insperity.com/vocabulary/domain-supplychain/> {
  <https://www.insperity.com/vocabulary/domain-supplychain/> a skos:ConceptScheme;
    rdfs:label "Domain supplychain vocabulary"@en;
    skos:prefLabel "Domain supplychain vocabulary"@en;
    skos:hasTopConcept <https://www.insperity.com/vocabulary/domain-supplychain/supply-chain>;
    terms:description "The entire network of entities involved in the process of getting a product or service from its origin to the end customer."@en;
    terms:title "Domain supplychain vocabulary"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2025-03-25T17:05:09.416Z"^^xsd:dateTime;
    skos:altLabel "Vocabulary | Domain | Supply Chain"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/vocabulary/domain-supplychain/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/vocabulary/domain-supplychain/supply-chain> a skos:Concept;
