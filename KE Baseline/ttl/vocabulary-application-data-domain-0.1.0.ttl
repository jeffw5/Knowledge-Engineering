voc:resource-test
  a skos:Concept ;
  skos:prefLabel "Resource test"@en ;
  skos:definition "Data representing a procedure performed on a Resource (physical, logical, or compound) to diagnose or verify its function."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
