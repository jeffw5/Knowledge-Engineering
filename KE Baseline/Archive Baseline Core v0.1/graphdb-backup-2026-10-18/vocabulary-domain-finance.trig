  domainfinancevoc:profitability a skos:Concept;
    skos:prefLabel "Profitability"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T19:37:12.735Z"^^xsd:dateTime;
    skos:definition "A company’s ability to generate profits from its operations."@en;
