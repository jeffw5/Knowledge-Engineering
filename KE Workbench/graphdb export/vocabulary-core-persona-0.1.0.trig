  personavoc:profile-data a skos:Concept;
    skos:prefLabel "Profile data"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:46:17.202Z"^^xsd:dateTime;
    skos:definition "Information directly provided by the user for their account or profile."@en;
