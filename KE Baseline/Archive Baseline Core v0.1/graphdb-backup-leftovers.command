curl -sf -G "$GDB/repositories/$REPO/statements" --data-urlencode 'context=<https://www.insperity.com/vocabulary/core-businessoperations/>' -H 'Accept: application/trig' -o "$OUT/vocabulary-core-businessoperations.trig" && echo "saved vocabulary-core-businessoperations.trig" || echo "FAILED vocabulary/core-businessoperations/"
curl -sf -G "$GDB/repositories/$REPO/statements" --data-urlencode 'context=<https://www.insperity.com/vocabulary/core-technicalservices/>' -H 'Accept: application/trig' -o "$OUT/vocabulary-core-technicalservices.trig" && echo "saved vocabulary-core-technicalservices.trig" || echo "FAILED vocabulary/core-technicalservices/"
curl -sf -G "$GDB/repositories/$REPO/statements" --data-urlencode 'context=<https://www.insperity.com/vocabulary/domain-facilities/>' -H 'Accept: application/trig' -o "$OUT/vocabulary-domain-facilities.trig" && echo "saved vocabulary-domain-facilities.trig" || echo "FAILED vocabulary/domain-facilities/"
