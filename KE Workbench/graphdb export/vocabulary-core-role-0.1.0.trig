<https://www.insperity.com/vocabulary/core-role/> {
  <https://www.insperity.com/vocabulary/core-role/> a skos:ConceptScheme;
    rdfs:label "Core role vocabulary"@en;
    skos:prefLabel "Core role vocabulary"@en;
    skos:hasTopConcept rolevoc:role;
    terms:description "Dictates the user’s permissions and functionalities within a system or platform."@en;
    terms:title "Core role vocabulary"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2025-03-25T16:58:27.000Z"^^xsd:dateTime;
    skos:altLabel "Vocabulary | Core | Role"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/vocabulary/core-role/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  rolevoc:role a skos:Concept;
    skos:prefLabel "Role"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-25T17:22:53.278Z"^^xsd:dateTime;
    skos:definition "Dictates the user’s permissions and functionalities within a system or platform."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-role/>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/core-role/>;
    skos:narrower rolevoc:consumer, rolevoc:customer, rolevoc:partner, rolevoc:provider .
  
  rolevoc:consumer a skos:Concept;
    skos:prefLabel "Consumer"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:48:58.171Z"^^xsd:dateTime;
    skos:definition "Grants access to view and consume content or services, with limited editing capabilities."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-role/>;
    skos:broader rolevoc:role;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  rolevoc:customer a skos:Concept;
    skos:prefLabel "Customer"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:48:58.171Z"^^xsd:dateTime;
    skos:definition "Focuses on transactional interactions, like making purchases or managing orders. May have access to purchase history and support resources."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-role/>;
    skos:broader rolevoc:role;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  rolevoc:partner a skos:Concept;
    skos:prefLabel "Partner"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:48:58.171Z"^^xsd:dateTime;
    skos:definition "Allows collaboration and shared access to resources for joint business operations."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-role/>;
    skos:broader rolevoc:role;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  rolevoc:provider a skos:Concept;
    skos:prefLabel "Provider"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:48:58.171Z"^^xsd:dateTime;
    skos:definition "Grants the ability to create, manage, and distribute content or services to other users."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-role/>;
    skos:broader rolevoc:role;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
}
