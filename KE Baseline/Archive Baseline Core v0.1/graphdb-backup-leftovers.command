curl -sf -G "$GDB/repositories/$REPO/statements" --data-urlencode 'context=<https://www.insperity.com/vocabulary/domain-humanresource/>' -H 'Accept: application/trig' -o "$OUT/vocabulary-domain-humanresource.trig" && echo "saved vocabulary-domain-humanresource.trig" || echo "FAILED vocabulary/domain-humanresource/"
curl -sf -G "$GDB/repositories/$REPO/statements" --data-urlencode 'context=<https://www.insperity.com/vocabulary/domain-informationtechnology/>' -H 'Accept: application/trig' -o "$OUT/vocabulary-domain-informationtechnology.trig" && echo "saved vocabulary-domain-informationtechnology.trig" || echo "FAILED vocabulary/domain-informationtechnology/"
