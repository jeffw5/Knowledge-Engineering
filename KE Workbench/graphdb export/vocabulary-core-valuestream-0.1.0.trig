    skos:definition "A series of steps an organization undertakes to deliver a product or service to a customer, from initial concept to final delivery and beyond."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-valuestream/>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/core-valuestream/>;
    skos:narrower valuestreamvoc:customer-acquisition-and-onboarding, valuestreamvoc:customer-support-and-service-assurance,
      valuestreamvoc:data-analytics-and-insights, valuestreamvoc:infrastructure-and-facility-management,
      valuestreamvoc:marketing-and-brand-management, valuestreamvoc:network-provisioning-and-maintenance,
      valuestreamvoc:order-to-cash, valuestreamvoc:product-development-and-innovation, valuestreamvoc:regulatory-compliance-and-governance,
      valuestreamvoc:revenue-management-and-billing, valuestreamvoc:supply-chain-management .
  
  valuestreamvoc:customer-acquisition-and-onboarding a skos:Concept;
