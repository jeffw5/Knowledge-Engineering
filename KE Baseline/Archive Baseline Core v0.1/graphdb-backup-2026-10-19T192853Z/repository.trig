}

<https://www.insperity.com/vocabulary/domain-supplychain/> {
  <https://www.insperity.com/vocabulary/domain-supplychain/> skos:hasTopConcept <https://www.insperity.com/vocabulary/domain-supplychain/supply-chain>;
    terms:description "The entire network of entities involved in the process of getting a product or service from its origin to the end customer."@en;
    terms:title "Domain supplychain vocabulary"@en;
    terms:contributor "Jeffrey Wallk" .
}

<https://www.insperity.com/taxonomy/core/> {
  <https://www.insperity.com/taxonomy/core/> skos:hasTopConcept <https://www.insperity.com/taxonomy/core/financial-asset>,
      <https://www.insperity.com/taxonomy/core/information-asset>, <https://www.insperity.com/taxonomy/core/intangible-asset>,
      <https://www.insperity.com/taxonomy/core/physical-asset>, <https://www.insperity.com/taxonomy/core/software-asset>;
    terms:description "Classification of the things of value that process steps consume, produce, use, or maintain, from buildings and equipment to documents, records, datasets, and software."@en;
    terms:title "Core taxonomy"@en;
    terms:contributor "Jeffrey Wallk" .
}

<https://www.insperity.com/taxonomy/core-asset/> {
  <https://www.insperity.com/taxonomy/core-asset/> skos:hasTopConcept assettax:financial-asset,
      assettax:information-asset, assettax:intangible-asset, assettax:physical-asset, assettax:software-asset;
    terms:description "Classification of the things of value that process steps consume, produce, use, or maintain, from buildings and equipment to documents, records, datasets, and software."@en;
    terms:title "Core asset taxonomy"@en;
    terms:contributor "Jeffrey Wallk" .
}

<https://www.insperity.com/taxonomy/core-capability/> {
  <https://www.insperity.com/taxonomy/core-capability/> skos:hasTopConcept <https://www.insperity.com/taxonomy/core-capability/customer-facing-capability>,
      <https://www.insperity.com/taxonomy/core-capability/information-and-knowledge-capability>,
      <https://www.insperity.com/taxonomy/core-capability/strategic-capability>, <https://www.insperity.com/taxonomy/core-capability/supporting-capability>;
    terms:description "Classification of business capabilities, the abilities an organization has or needs to achieve outcomes, independent of how they are organized or implemented."@en;
    terms:title "Core capability taxonomy"@en;
    terms:contributor "Jeffrey Wallk" .
}

<https://www.insperity.com/taxonomy/core-decision/> {
  <https://www.insperity.com/taxonomy/core-decision/> skos:hasTopConcept <https://www.insperity.com/taxonomy/core-decision/decision-model>,
      <https://www.insperity.com/taxonomy/core-decision/operational-decision>, <https://www.insperity.com/taxonomy/core-decision/strategic-decision>,
      <https://www.insperity.com/taxonomy/core-decision/tactical-decision>;
    terms:description "Classification of decisions, the determinations of an outcome or course of action made by a party or automated agent, and of the models used to make them."@en;
    terms:title "Core decision taxonomy"@en;
    terms:contributor "Jeffrey Wallk" .
}

<https://www.insperity.com/taxonomy/core-event/> {
  <https://www.insperity.com/taxonomy/core-event/> skos:hasTopConcept <https://www.insperity.com/taxonomy/core-event/business-event>,
      <https://www.insperity.com/taxonomy/core-event/change-event>, <https://www.insperity.com/taxonomy/core-event/governance-event>,
      <https://www.insperity.com/taxonomy/core-event/interaction-event>, <https://www.insperity.com/taxonomy/core-event/process-event>,
      <https://www.insperity.com/taxonomy/core-event/system-event>, <https://www.insperity.com/taxonomy/core-event/time-event>;
    terms:description "Classification of occurrences that happen at a point or short span in time and can start, end, or result from a process step."@en;
    terms:title "Core event taxonomy"@en;
    terms:contributor "Jeffrey Wallk" .
}

<https://www.insperity.com/taxonomy/core-governance/> {
  <https://www.insperity.com/taxonomy/core-governance/> skos:hasTopConcept <https://www.insperity.com/taxonomy/core-governance/control>,
      <https://www.insperity.com/taxonomy/core-governance/governance-activity>, <https://www.insperity.com/taxonomy/core-governance/governance-body>,
      <https://www.insperity.com/taxonomy/core-governance/governance-discipline>, <https://www.insperity.com/taxonomy/core-governance/governance-record>;
    terms:description "Classification of governance concepts, the disciplines, bodies, controls, activities, and records through which the organization directs, oversees, and assures its work, data, knowledge, and artificial intelligence."@en;
    terms:title "Core governance taxonomy"@en;
    terms:contributor "Jeffrey Wallk" .
}

