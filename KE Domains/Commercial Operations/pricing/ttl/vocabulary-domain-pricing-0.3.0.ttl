pricingvoc:experience-modification-factor
  a skos:Concept ;
  rdfs:label "experience modification factor"@en ;
  skos:prefLabel "experience modification factor"@en ;
  skos:altLabel "EMR"@en , "experience mod"@en ;
  skos:definition "A factor that adjusts an employer's workers' compensation premium up or down from the base rate according to its claims history relative to similar employers."@en ;
  skos:scopeNote "A multiword lexical unit (Baseline decision 3)."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-pricing/> ;
  skos:topConceptOf <https://www.insperity.com/vocabulary/domain-pricing/> ;
