  roletax:responsibility-role
    a skos:Concept ;
    rdfs:label "Responsibility role"@en ;
    skos:prefLabel "Responsibility role"@en ;
    skos:altLabel "RACI role"@en , "Responsibility assignment"@en ;
    skos:definition "A role that defines the kind of responsibility a party has for a process step or decision."@en ;
    skos:scopeNote "Used to qualify performedBy and approvedBy."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/core-role/> ;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-role/> ;
    skos:narrower roletax:accountable-role ,
        roletax:consulted-role ,
        roletax:informed-role ,
        roletax:responsible-role ;
    core:hasPrimaryTerm rolevoc:role ;
    dct:subject rolevoc:responsibility , rolevoc:role ;
    core:formalizedBy core:role ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-17T01:38:18Z"^^xsd:dateTime ;
    dct:modified "2026-10-19T18:44:22Z"^^xsd:dateTime .

