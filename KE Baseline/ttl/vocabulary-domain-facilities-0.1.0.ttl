  dct:created "2025-04-02T14:13:10.546Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:shade
  a skos:Concept ;
  skos:prefLabel "Shade"@en ;
  skos:definition "A place sheltered from the sun, or a device such as a screen or blind used to provide such shelter. In the context of energy demand, shades are often used to reduce solar heat gain in buildings, thereby decreasing the need for air conditioning."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-facilities/> ;
  skos:broader voc:furniture ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-02T14:13:10.546Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:shutter
  a skos:Concept ;
  skos:prefLabel "Shutter"@en ;
  skos:definition "A solid or louvered cover for a window, typically made of wood or metal, that can be closed for security, privacy, or to protect the window from damage. Shutters can also help to insulate windows, reducing heat loss in the winter and heat gain in the summer."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-facilities/> ;
  skos:broader voc:furniture ;
  owl:versionInfo "0.1.0" ;
