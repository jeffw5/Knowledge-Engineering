voc:employee-pay
  a skos:Concept ;
  skos:prefLabel "Employee pay"@en ;
  skos:definition "The detailed data (e.g., pay grades, ranges, components) that defines an employee's compensation structure."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
