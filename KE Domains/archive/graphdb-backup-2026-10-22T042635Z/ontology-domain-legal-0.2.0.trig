<https://www.insperity.com/ontology/domain-legal/> {
  <https://www.insperity.com/ontology/domain-legal/> a owl:Ontology;
    rdfs:label "Domain Legal Ontology"@en;
    skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en;
    terms:description "The legal ontology. It extends the core domain ontology and the Business Operations ontology with the client service agreement and its clauses, and with deontic norms (obligation, permission, prohibition, right) that bind roles and are traced to the provisions that state them, statutes and regulations scoped to a jurisdiction, and legal matters, so that rules, constraints and logic have a single source of truth in law."@en;
    terms:title "Domain Legal Ontology"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_legal.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.1.1 (2026-10-20): Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_legal.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.2.0 (2026-10-21): Restructured to the operational areas and the naming standard (D26, D27): titled 'Domain Legal Vocabulary', '… Taxonomy', '… Ontology' and '… Shapes'; moved from Commercial Operations to Business Operations. It now owns the client service agreement, commercial agreement and clause (from Commercial Operations) and the contract management steps, agreement terms and agreement statuses (from Pricing and contracts). It cites Commercial Operations primitives (D27) but imports only the core and the Business Operations ontology. Built by build_domains.py from spec_legal.py against Baseline Core v1.0 (core 0.1.0)."@en;
    terms:created "2026-10-22"^^xsd:date;
    owl:versionInfo "0.2.0";
    terms:subject domainvoc:legal;
    owl:imports <https://www.insperity.com/ontology/core/>, <https://www.insperity.com/ontology/business-operations/>;
    terms:isPartOf <https://www.insperity.com/ontology/business-operations/>;
    owl:versionIRI <https://www.insperity.com/ontology/domain-legal/0.2.0/>;
    vaem:namespace "https://www.insperity.com/ontology/domain-legal/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft;
    vann:preferredNamespacePrefix "legal";
    terms:publisher <https://www.insperity.com/resource/core/Organization/insperity>;
    terms:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/>, <http://purl.obolibrary.org/obo/bfo/2020/bfo.owl>;
    terms:identifier "ontology-domain-legal";
    terms:requires <https://www.insperity.com/ontology/core/0.1.0/>, <https://www.insperity.com/ontology/business-operations/0.1.0/> .
  
  domainlegal:norm a owl:Class;
    rdfs:subClassOf core:policy, _:node12139, _:node12140;
    rdfs:label "Norm"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-legal/>;
    skos:prefLabel "Norm"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A policy that states what a party in a role is obliged, permitted or forbidden to do, or is entitled to."@en;
    skos:scopeNote "Deontic norms after the Legal Knowledge Interchange Format. A norm is part of the provision, clause or policy that states it (core:componentOf), which is its single source of truth; rules and constraints that implement it are governed by it."@en;
    owl:versionInfo "0.2.0";
    terms:subject policyvoc:norm;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm policyvoc:norm .
  
  domainlegal:permission a owl:Class;
    rdfs:subClassOf domainlegal:norm;
    rdfs:label "Permission"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-legal/>;
    skos:prefLabel "Permission"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A norm that allows the bearer of a role to perform an action."@en;
    owl:versionInfo "0.2.0";
    terms:subject policyvoc:permission;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm policyvoc:permission .
  
  domainlegal:legal-matter a owl:Class;
    rdfs:subClassOf core:process, _:node12146, _:node12147;
    rdfs:label "Legal matter"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-legal/>;
    skos:prefLabel "Legal matter"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A process in which a legal issue, case or transaction is handled as a unit of legal work."@en;
    owl:versionInfo "0.2.0";
    terms:subject legalvoc:matter;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm legalvoc:matter .
  
  domainlegal:binds a owl:ObjectProperty;
    rdfs:subPropertyOf core:concerns;
    rdfs:label "binds"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-legal/>;
    skos:prefLabel "binds"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A relation between a norm and the role whose bearer it obliges, permits, forbids or entitles."@en;
    skos:scopeNote "Norms bind roles, not persons or organizations: the party bound is whoever bears the role (co-employer, employer of record, fiduciary, client)."@en;
    owl:versionInfo "0.2.0";
    core:hasLifecycleStatus core:Draft .
  
  domainlegal:obligation a owl:Class;
    rdfs:subClassOf domainlegal:norm;
    rdfs:label "Obligation"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-legal/>;
    skos:prefLabel "Obligation"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A norm that requires the bearer of a role to perform an action or achieve a state."@en;
    owl:versionInfo "0.2.0";
    terms:subject policyvoc:obligation;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm policyvoc:obligation .
  
  domainlegal:prohibition a owl:Class;
    rdfs:subClassOf domainlegal:norm;
    rdfs:label "Prohibition"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-legal/>;
    skos:prefLabel "Prohibition"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A norm that forbids the bearer of a role to perform an action."@en;
    owl:versionInfo "0.2.0";
    terms:subject policyvoc:prohibition;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm policyvoc:prohibition .
  
  domainlegal:right a owl:Class;
    rdfs:subClassOf domainlegal:norm;
    rdfs:label "Right"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-legal/>;
    skos:prefLabel "Right"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A norm that entitles the bearer of a role to an action, benefit or protection."@en;
    owl:versionInfo "0.2.0";
    terms:subject policyvoc:right;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm policyvoc:right .
  
  domainlegal:statute a owl:Class;
    rdfs:subClassOf core:policy, _:node12141, _:node12142;
    rdfs:label "Statute"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-legal/>;
    skos:prefLabel "Statute"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A policy that is a law enacted by a legislative body for a jurisdiction."@en;
    owl:versionInfo "0.2.0";
    terms:subject policyvoc:statute;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm policyvoc:statute .
  
  domainlegal:hasJurisdiction a owl:ObjectProperty;
    rdfs:subPropertyOf core:concerns;
    rdfs:label "has jurisdiction"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-legal/>;
    skos:prefLabel "has jurisdiction"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A relation between a directive and the jurisdiction in which it applies."@en;
    owl:versionInfo "0.2.0";
    core:hasLifecycleStatus core:Draft .
  
  domainlegal:provision a owl:Class;
    rdfs:subClassOf core:directive, _:node12145;
    rdfs:label "Provision"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-legal/>;
