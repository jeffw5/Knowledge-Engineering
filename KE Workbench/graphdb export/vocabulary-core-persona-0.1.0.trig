    skos:inScheme <https://www.insperity.com/vocabulary/core-persona/>;
    skos:broader personavoc:persona-data;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  personavoc:persona-role a skos:Concept;
    skos:prefLabel "Persona role"@en;
