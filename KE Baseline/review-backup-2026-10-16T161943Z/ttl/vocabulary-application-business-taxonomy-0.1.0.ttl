voc:multiple-dwelling-unit
  a skos:Concept ;
  skos:prefLabel "Multiple dwelling unit"@en ;
  skos:altLabel "MDU"@en , "Multiple Dwelling Unit"@en ;
  skos:definition "This is a building or complex comprising multiple separate residential units, such as apartments or condominiums."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
