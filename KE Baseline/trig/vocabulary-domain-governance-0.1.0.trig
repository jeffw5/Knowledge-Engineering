  voc:data-governance-operating-framework
    a skos:Concept ;
    skos:prefLabel "Data governance operating framework"@en ;
    skos:definition "A comprehensive structure that outlines the processes, roles, responsibilities, and tools required to implement and maintain effective data governance."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/> ;
    skos:broader voc:governance-control-activity ;
    owl:versionInfo "0.1.0" ;
