  voc:customer-feedback
    a skos:Concept ;
    skos:prefLabel "Customer feedback"@en ;
    skos:definition "Information, insights, and opinions provided by customers about their experiences with a product, service, or brand. This feedback can be collected through surveys, reviews, social media, customer service interactions, and other channels."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
    skos:broader voc:customer-engagement ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-04-01T16:06:48.412Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:customer-journey
    a skos:Concept ;
    skos:prefLabel "Customer journey"@en ;
    skos:definition "The complete sum of experiences customers go through when interacting with your company and brand – from the very first moment they become aware of your brand to the point they become a loyal customer (and even beyond)."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
    skos:broader voc:customer-engagement ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-04-01T16:06:48.412Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:customer-profile
    a skos:Concept ;
    skos:prefLabel "Customer profile"@en ;
    skos:definition "A detailed description of your ideal customer. It includes demographic, geographic, psychographic (interests, values, attitudes), and behavioral data. Customer profiles help businesses target their marketing efforts effectively."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
    skos:broader voc:customer-engagement ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-04-01T16:06:48.412Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:customer-referral
    a skos:Concept ;
    skos:prefLabel "Customer referral"@en ;
    skos:definition "A recommendation for your business from a satisfied customer, often given to a potential customer who could also benefit from your products or services."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
    skos:broader voc:customer-engagement ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-04-01T16:06:48.412Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:customer-retention-and-growth
    a skos:Concept ;
    skos:prefLabel "Customer retention & growth"@en ;
    skos:definition "Strategies and actions taken to keep existing customers and encourage them to continue doing business with a company over time, while also finding ways to increase the value of those customers."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
    skos:broader voc:customer-engagement ;
    skos:narrower voc:customer-loyalty , voc:customer-satisfaction ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-04-01T16:06:48.412Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:customer-loyalty
    a skos:Concept ;
    skos:prefLabel "Customer loyalty"@en ;
    skos:definition "When a customer has a strong, positive emotional connection with a brand, leading them to consistently choose that brand over competitors and recommend it to others."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
    skos:broader voc:customer-retention-and-growth ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-04-01T16:07:07.203Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:customer-satisfaction
    a skos:Concept ;
    skos:prefLabel "Customer satisfaction"@en ;
    skos:definition "The extent to which customers are happy with a product, service, or experience."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
    skos:broader voc:customer-retention-and-growth ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
