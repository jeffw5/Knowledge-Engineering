<https://www.insperity.com/taxonomy/domain-customer-care/> {
  <https://www.insperity.com/taxonomy/domain-customer-care/> a skos:ConceptScheme;
    rdfs:label "Domain Customer Care Taxonomy"@en;
    skos:prefLabel "Domain Customer Care Taxonomy"@en;
    skos:hasTopConcept customercaretax:churn, customercaretax:client-health, customercaretax:client-status,
      customercaretax:client-success-activity, customercaretax:client-success-measure, customercaretax:client-success-playbook,
      customercaretax:client-success-role, customercaretax:client-success-stage, customercaretax:expansion-type;
    skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en;
    terms:description "A classification of the client success stages and activities after the sale, client health scores and signals, client statuses, churn and its causes, expansion, client success measures and roles."@en;
    terms:title "Domain Customer Care Taxonomy"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    skos:changeNote "0.2.0 (2026-10-21): Restructured to the operational areas and the naming standard (D26, D27): titled 'Domain Customer Care Vocabulary', '… Taxonomy', '… Ontology' and '… Shapes', at …/<kind>/domain-customer-care/ (formerly Customer success, …/<kind>/domain-customer-success/). Built by build_domains.py from spec_customer_care.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_customer_care.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.1.1 (2026-10-20): Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_customer_care.py against Baseline Core v1.0 (core 0.1.0)."@en;
    terms:created "2026-10-22"^^xsd:date;
    owl:versionInfo "0.2.0";
    terms:subject domainvoc:customer-support;
    terms:isPartOf <https://www.insperity.com/taxonomy/commercial-operations/>;
    owl:versionIRI <https://www.insperity.com/taxonomy/domain-customer-care/0.2.0/>;
    terms:source <https://www.insperity.com/vocabulary/core-asset/>, <https://www.insperity.com/vocabulary/core-domain/>,
      <https://www.insperity.com/vocabulary/core-event/>, <https://www.insperity.com/vocabulary/core-issue/>,
      <https://www.insperity.com/vocabulary/core-lifecycle/>, <https://www.insperity.com/vocabulary/core-location/>,
      <https://www.insperity.com/vocabulary/core-process/>, <https://www.insperity.com/vocabulary/core-role/>,
      <https://www.insperity.com/vocabulary/core-services/>, <https://www.insperity.com/vocabulary/core-decision/>,
      <https://www.insperity.com/vocabulary/core-governance/>, <https://www.insperity.com/vocabulary/core-logic/>,
      <https://www.insperity.com/vocabulary/core-measure/>, <https://www.insperity.com/vocabulary/core-policy/>,
      <https://www.insperity.com/vocabulary/commercial-operations/>, <https://www.insperity.com/vocabulary/domain-customer-care/>;
    vaem:namespace "https://www.insperity.com/taxonomy/domain-customer-care/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft;
    vann:preferredNamespacePrefix "customercaretax";
    terms:publisher <https://www.insperity.com/resource/core/Organization/insperity>;
    terms:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/>;
    terms:identifier "taxonomy-domain-customer-care";
    terms:replaces <https://www.insperity.com/taxonomy/domain-customer-success/> .
  
  customercaretax:churn a skos:Concept;
    rdfs:label "Churn"@en;
    skos:prefLabel "Churn"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "An event in which a client ends its relationship with the organization, or covers fewer workers."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-customer-care/>;
    skos:altLabel "Attrition"@en;
    skos:scopeNote "Classified by its cause; the agreement termination itself is core taxonomy-core-event \"Agreement termination\"."@en;
    owl:versionInfo "0.2.0";
    terms:subject customercarevoc:churn;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-customer-care/>;
    skos:narrower customercaretax:client-churn, customercaretax:worksite-employee-churn;
    core:hasPrimaryTerm customercarevoc:churn;
    core:formalizedBy core:event;
    skos:broadMatch eventtax:business-event .
  
  customercaretax:client-health a skos:Concept;
    rdfs:label "Client health"@en;
    skos:prefLabel "Client health"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A measure of the overall condition of a client relationship."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-customer-care/>;
    owl:versionInfo "0.2.0";
    terms:subject rolevoc:client, customercarevoc:health;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-customer-care/>;
    skos:narrower customercaretax:adoption-signal, customercaretax:client-health-score,
      customercaretax:risk-signal, customercaretax:satisfaction-signal;
    core:hasPrimaryTerm customercarevoc:health;
    core:formalizedBy customercare:health-score .
  
  customercaretax:client-status a skos:Concept;
    rdfs:label "Client status"@en;
    skos:prefLabel "Client status"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A status of a client relationship that records its condition after the sale."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-customer-care/>;
    owl:versionInfo "0.2.0";
    terms:subject lifecyclevoc:status, rolevoc:client;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-customer-care/>;
    skos:narrower customercaretax:at-risk-client, customercaretax:client-under-notice,
      customercaretax:former-client, customercaretax:reference-client;
    core:hasPrimaryTerm lifecyclevoc:status;
    core:formalizedBy core:lifecycle-status .
  
  customercaretax:client-success-activity a skos:Concept;
    rdfs:label "Client success activity"@en;
    skos:prefLabel "Client success activity"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A process step that keeps, grows or recovers a client."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-customer-care/>;
    owl:versionInfo "0.2.0";
    terms:subject measurevoc:success, processvoc:activity, rolevoc:client;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-customer-care/>;
    skos:narrower customercaretax:benefits-enrollment, customercaretax:business-review,
      customercaretax:client-escalation, customercaretax:health-assessment, customercaretax:onboarding-milestone,
      customercaretax:payroll-conversion, customercaretax:retention-save, customercaretax:win-back;
    core:hasPrimaryTerm processvoc:activity;
    core:formalizedBy core:process-step;
    skos:broadMatch processtax:process-step .
  
  customercaretax:client-success-measure a skos:Concept;
    rdfs:label "Client success measure"@en;
    skos:prefLabel "Client success measure"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A measure of how well the organization keeps, grows and satisfies its clients."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-customer-care/>;
    owl:versionInfo "0.2.0";
    terms:subject measurevoc:measure, measurevoc:success, rolevoc:client;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-customer-care/>;
    skos:narrower customercaretax:adoption-rate, customercaretax:churn-rate, customercaretax:client-retention-rate,
      customercaretax:client-satisfaction, customercaretax:net-promoter-score, customercaretax:worksite-employee-retention-rate;
    core:hasPrimaryTerm measurevoc:measure;
    core:formalizedBy core:measure;
    skos:broadMatch measuretax:key-performance-indicator .
  
  customercaretax:client-success-playbook a skos:Concept;
    rdfs:label "Client success playbook"@en;
    skos:prefLabel "Client success playbook"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A directive that sets the steps a client success team follows in a recurring situation, such as onboarding, a renewal or a risk signal."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-customer-care/>;
