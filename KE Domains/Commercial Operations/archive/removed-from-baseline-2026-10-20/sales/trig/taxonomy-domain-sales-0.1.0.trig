    a skos:Concept ;
    rdfs:label "Qualify"@en ;
    skos:prefLabel "Qualify"@en ;
    skos:altLabel "Qualification stage"@en ;
    skos:definition "A selling stage in which the seller determines whether the opportunity fits the ideal customer profile and is worth pursuing."@en ;
