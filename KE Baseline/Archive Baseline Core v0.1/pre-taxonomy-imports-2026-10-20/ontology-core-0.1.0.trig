  core:consumes
    a owl:ObjectProperty ;
    rdfs:label "consumes"@en ;
    skos:prefLabel "consumes"@en ;
    skos:definition "A relation between a step and a continuant, such as a physical asset or a record, that is present at its start and is used or changed by it."@en ;
    skos:scopeNote "RO defines has input for material entities. When a step uses information, the input is the carrier (a file, a record, a database) that the information is concretized in."@en ;
    rdfs:subPropertyOf obo:RO_0002233 ;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core/> ;
    owl:versionInfo "0.1.0" ;
