  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-19"^^xsd:date ;
  dct:modified "2026-10-19T02:19:17Z"^^xsd:dateTime .

core:Directive
  a owl:Class ;
  rdfs:label "Directive"@en ;
  skos:prefLabel "Directive"@en ;
  skos:definition "A generically dependent continuant that prescribes how process steps are to be carried out, such as a policy, a rule, a requirement or a control."@en ;
  rdfs:subClassOf obo:BFO_0000031 ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/core/> ;
  owl:versionInfo "0.1.0" ;
