  applicationdatadomainvoc:work-breakdown-structure terms:created "2025-10-24T20:09:58.060Z"^^xsd:dateTime;
    skos:definition "Data representing the hierarchical decomposition of a Project's total scope into manageable work elements."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:project .
  
  applicationdatadomainvoc:work-order terms:created "2025-10-24T20:09:58.060Z"^^xsd:dateTime;
    skos:definition "A formal request or directive to perform a specified piece of work, often derived from a Work Specification."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:project .
  
  applicationdatadomainvoc:association terms:created "2025-10-24T20:10:06.124Z"^^xsd:dateTime;
    skos:definition "A pattern that allows for the flexible and dynamic creation of relationships between explicitly modeled entities."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:root-business-entities .
  
  applicationdatadomainvoc:characteristic terms:created "2025-10-24T20:10:06.124Z"^^xsd:dateTime;
    skos:definition "A pattern that allows for the creation of unique, non-standard attributes for an entity instance or entity type."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:root-business-entities .
  
  applicationdatadomainvoc:entity-identification terms:created "2025-10-24T20:10:06.124Z"^^xsd:dateTime;
    skos:definition "A collection of data entities used to dynamically specify and represent various identification formats and instances for any entity type."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:root-business-entities .
  
  applicationdatadomainvoc:entity-specification-action terms:created "2025-10-24T20:10:06.124Z"^^xsd:dateTime;
