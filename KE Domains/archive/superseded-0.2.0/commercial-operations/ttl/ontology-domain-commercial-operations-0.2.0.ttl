commercialops:worksite-employee
  a owl:Class ;
  rdfs:label "Worksite employee"@en ;
  skos:prefLabel "Worksite employee"@en ;
  skos:altLabel "WSE"@en ;
  skos:definition "A role borne by a person employed at a client's worksite under a co-employment relationship between the client and a professional employer organization."@en ;
  skos:scopeNote "The unit in which a professional employer organization sizes opportunities, prices services and counts paid worksite employees. Formalizes core taxonomy-core-role \"Worksite employee\"."@en ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:onProperty core:roleOf ;
      owl:someValuesFrom core:person
  ] ,
      core:role ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-commercial-operations/> ;
  core:hasPrimaryTerm rolevoc:employee ;
  dct:subject rolevoc:employee ;
  owl:versionInfo "0.2.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-20"^^xsd:date ;
  dct:modified "2026-10-20T04:19:14Z"^^xsd:dateTime .

