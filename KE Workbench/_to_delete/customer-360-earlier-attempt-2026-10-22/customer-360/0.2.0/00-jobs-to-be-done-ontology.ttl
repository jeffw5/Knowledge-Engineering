  dct:modified "2026-10-22T19:46:03Z"^^xsd:dateTime .

jtbd:job-map-stage
  a owl:Class ;
  rdfs:label "Job map stage"@en ;
  skos:prefLabel "Job map stage"@en ;
  skos:definition "A generically dependent continuant that names one of the eight universal stages every job passes through, from define to conclude."@en ;
  rdfs:subClassOf obo:BFO_0000031 ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/jobs-to-be-done/> ;
  core:hasLifecycleStatus core:Draft ;
