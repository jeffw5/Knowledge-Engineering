  a owl:Ontology ;
  rdfs:label "Marketing domain ontology"@en ;
  dct:title "Marketing domain ontology"@en ;
  dct:description "The marketing ontology. It extends the core domain ontology and the Commercial Operations ontology with marketing campaigns and with competitive intelligence and battlecards as sourced information assets about competitors and markets."@en ;
