@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix jtbd:    <https://www.insperity.com/ontology/jobs-to-be-done/> .
@prefix ob:      <https://www.insperity.com/resource/outcome-benchmark/> .
@prefix theme:   <https://www.insperity.com/taxonomy/benchmark-theme/> .
@prefix metric:  <https://www.insperity.com/vocabulary/outcome-metric-type/> .
@prefix hr:      <http://example.org/hrservices/ddd#> .


ob:BusinessOwner a owl:NamedIndividual, jtbd:client-persona ;
    rdfs:label "Business Owner / Chief Executive Officer"@en ;
    skos:prefLabel "Business Owner / Chief Executive Officer"@en ;
    skos:altLabel "Business Owner / CEO"@en ;
    skos:altLabel "Owner"@en ;
    skos:definition "A client persona who owns or runs a small or mid-sized client company and makes the final decision on its human resources provider and cost."@en ;
    jtbd:hasIdentifier "P1" ;
    jtbd:hasShortName "Owner" ;
    jtbd:hasTypicalTitles "Founder, CEO, President, Managing Partner"@en ;
    jtbd:hasPersonaContext "Runs a 5–150 employee company; often the final HR decision-maker; HR is a distraction from growing the business."@en ;
    jtbd:hasBuyingRole "Economic buyer — signs the agreement and owns the cost/value decision"@en ;
    jtbd:hasPersonaGoal "Grow the business without becoming an expert in employment law, insurance and payroll tax."@en ;
    jtbd:hasEmotionalJob "Feel confident the company is not exposed to a lawsuit or penalty it doesn't know about"@en ;
    jtbd:hasEmotionalJob "Feel able to compete with larger employers for talent"@en ;
    jtbd:hasEmotionalJob "Be seen by employees as an employer that takes care of its people"@en ;
    jtbd:executesJob ob:Job-J05, ob:Job-J07, ob:Job-J10, ob:Job-J14, ob:Job-J18, ob:Job-J20, ob:Job-C1, ob:Job-C3, ob:Job-C4 ;
    jtbd:participatesInJob ob:Job-J01, ob:Job-J02, ob:Job-J04, ob:Job-J09, ob:Job-J12, ob:Job-J16, ob:Job-J19, ob:Job-C2 ;
    dcterms:created "2026-10-22"^^xsd:date ;
    skos:editorialNote "Draft: pending business and compliance review before the survey is fielded."@en .

ob:FinanceLeader a owl:NamedIndividual, jtbd:client-persona ;
    rdfs:label "Finance Leader"@en ;
    skos:prefLabel "Finance Leader"@en ;
    skos:altLabel "Finance"@en ;
    skos:definition "A client persona who funds payroll, pays employer taxes and keeps the books, and judges the provider on total cost and accuracy."@en ;
    jtbd:hasIdentifier "P2" ;
    jtbd:hasShortName "Finance" ;
    jtbd:hasTypicalTitles "CFO, Controller, Office / Finance Manager who runs payroll"@en ;
    jtbd:hasPersonaContext "Owns payroll funding, tax deposits, GL posting and the HR provider invoice; frequently also the payroll processor in smaller firms."@en ;
    jtbd:hasBuyingRole "Evaluator and gatekeeper on total cost; often the day-to-day payroll user"@en ;
    jtbd:hasPersonaGoal "Keep employer costs predictable and the books accurate with minimal manual reconciliation."@en ;
    jtbd:hasEmotionalJob "Avoid the embarrassment of a missed or wrong payroll"@en ;
    jtbd:hasEmotionalJob "Feel in control of every dollar of employer cost"@en ;
    jtbd:hasEmotionalJob "Be seen by the owner as a trusted steward of company money"@en ;
    jtbd:executesJob ob:Job-J01, ob:Job-J02, ob:Job-J04, ob:Job-J07, ob:Job-J20, ob:Job-C1, ob:Job-C2, ob:Job-C4 ;
    jtbd:participatesInJob ob:Job-J03, ob:Job-J05, ob:Job-J06, ob:Job-J11, ob:Job-J14, ob:Job-J21, ob:Job-C3 ;
    dcterms:created "2026-10-22"^^xsd:date ;
    skos:editorialNote "Draft: pending business and compliance review before the survey is fielded."@en .

ob:HumanResourcesLeader a owl:NamedIndividual, jtbd:client-persona ;
    rdfs:label "Human Resources Leader"@en ;
    skos:prefLabel "Human Resources Leader"@en ;
    skos:altLabel "HR Leader"@en ;
    skos:altLabel "HR"@en ;
    skos:definition "A client persona who runs human resources operations across every discipline, often as a team of one, and uses the provider every day."@en ;
    jtbd:hasIdentifier "P3" ;
    jtbd:hasShortName "HR" ;
    jtbd:hasTypicalTitles "HR Manager, HR Generalist, People Operations lead (often a team of one)"@en ;
    jtbd:hasPersonaContext "Covers every HR discipline at once — benefits, compliance, hiring, employee relations — with little specialist support."@en ;
    jtbd:hasBuyingRole "Primary evaluator and daily user; champions or blocks the provider"@en ;
    jtbd:hasPersonaGoal "Run reliable HR operations and spend more time on people strategy than on paperwork."@en ;
    jtbd:hasEmotionalJob "Feel confident in giving advice on issues outside their expertise"@en ;
    jtbd:hasEmotionalJob "Avoid being blamed for a compliance miss"@en ;
    jtbd:hasEmotionalJob "Be seen as a strategic partner rather than an administrator"@en ;
    jtbd:executesJob ob:Job-J03, ob:Job-J05, ob:Job-J06, ob:Job-J09, ob:Job-J10, ob:Job-J12, ob:Job-J13, ob:Job-J14, ob:Job-J16, ob:Job-J18, ob:Job-J19, ob:Job-C2, ob:Job-C3 ;
    jtbd:participatesInJob ob:Job-J01, ob:Job-J07, ob:Job-J11, ob:Job-J15, ob:Job-J20, ob:Job-J21, ob:Job-C1, ob:Job-C4 ;
    dcterms:created "2026-10-22"^^xsd:date ;
    skos:editorialNote "Draft: pending business and compliance review before the survey is fielded."@en .

ob:OperationsAndSafetyLeader a owl:NamedIndividual, jtbd:client-persona ;
    rdfs:label "Operations and Safety Leader"@en ;
    skos:prefLabel "Operations and Safety Leader"@en ;
    skos:altLabel "Operations & Safety Leader"@en ;
    skos:altLabel "Ops/Safety"@en ;
    skos:definition "A client persona who is responsible for worksites where injury risk and workers' compensation cost matter to the business."@en ;
    jtbd:hasIdentifier "P4" ;
    jtbd:hasShortName "Ops/Safety" ;
    jtbd:hasTypicalTitles "Operations Manager, Safety Manager, Site Superintendent"@en ;
    jtbd:hasPersonaContext "Responsible for field or industrial worksites (construction, manufacturing, logistics, trades) where injury risk and workers' comp cost are material."@en ;
    jtbd:hasBuyingRole "Influencer on risk and safety services; user of injury and safety workflows"@en ;
    jtbd:hasPersonaGoal "Keep crews safe and productive and keep insurance cost under control."@en ;
    jtbd:hasEmotionalJob "Feel that no one will be seriously hurt on their watch"@en ;
    jtbd:hasEmotionalJob "Be seen by crews as someone who has their back after an injury"@en ;
    jtbd:executesJob ob:Job-J03, ob:Job-J11 ;
    jtbd:participatesInJob ob:Job-J04, ob:Job-J12 ;
    dcterms:created "2026-10-22"^^xsd:date ;
    skos:editorialNote "Draft: pending business and compliance review before the survey is fielded."@en .

ob:PeopleManager a owl:NamedIndividual, jtbd:client-persona ;
    rdfs:label "People Manager"@en ;
    skos:prefLabel "People Manager"@en ;
    skos:altLabel "Manager"@en ;
    skos:definition "A client persona who supervises a team and handles its hiring, time approval, coaching and performance conversations."@en ;
    jtbd:hasIdentifier "P5" ;
    jtbd:hasShortName "Manager" ;
    jtbd:hasTypicalTitles "Supervisor, Team Lead, Department Manager"@en ;
    jtbd:hasPersonaContext "Approves time, hires, coaches and evaluates a team; usually promoted for technical skill with little leadership training."@en ;
    jtbd:hasBuyingRole "User and influencer; their experience drives employee adoption"@en ;
    jtbd:hasPersonaGoal "Build a capable, engaged team and handle people issues well."@en ;
    jtbd:hasEmotionalJob "Feel competent handling difficult people conversations"@en ;
    jtbd:hasEmotionalJob "Be seen by their team as fair and supportive"@en ;
    jtbd:executesJob ob:Job-J03, ob:Job-J12, ob:Job-J13, ob:Job-J15, ob:Job-J17 ;
    jtbd:participatesInJob ob:Job-J10, ob:Job-J14, ob:Job-J16, ob:Job-J18, ob:Job-C3 ;
    dcterms:created "2026-10-22"^^xsd:date ;
    skos:editorialNote "Draft: pending business and compliance review before the survey is fielded."@en .

ob:WorksiteEmployee a owl:NamedIndividual, jtbd:client-persona ;
    rdfs:label "Worksite Employee"@en ;
    skos:prefLabel "Worksite Employee"@en ;
    skos:altLabel "Employee"@en ;
    skos:definition "A client persona who works for the client company and experiences the provider through pay, benefits, self-service and answers to questions."@en ;
    jtbd:hasIdentifier "P6" ;
    jtbd:hasShortName "Employee" ;
    jtbd:hasTypicalTitles "Any employee of the client company"@en ;
    jtbd:hasPersonaContext "Experiences the PEO through pay, benefits, self-service and HR answers; never chose the provider."@en ;
    jtbd:hasBuyingRole "End user; satisfaction affects client retention and renewal"@en ;
    jtbd:hasPersonaGoal "Get paid correctly, understand and use benefits, and get HR tasks done without friction."@en ;
    jtbd:hasEmotionalJob "Feel financially secure and protected by good benefits"@en ;
    jtbd:hasEmotionalJob "Feel respected and that personal data is handled with care"@en ;
    jtbd:executesJob ob:Job-J08, ob:Job-J22 ;
    jtbd:participatesInJob ob:Job-J03, ob:Job-J06, ob:Job-J07, ob:Job-J11, ob:Job-J13, ob:Job-J15, ob:Job-J16, ob:Job-J18 ;
    dcterms:created "2026-10-22"^^xsd:date ;
    skos:editorialNote "Draft: pending business and compliance review before the survey is fielded."@en .

ob:SystemsAdministrator a owl:NamedIndividual, jtbd:client-persona ;
    rdfs:label "Information Technology and Systems Administrator"@en ;
    skos:prefLabel "Information Technology and Systems Administrator"@en ;
    skos:altLabel "IT & Systems Administrator"@en ;
    skos:altLabel "IT"@en ;
    skos:definition "A client persona who connects employee data to other business systems and is accountable for its access and security."@en ;
    jtbd:hasIdentifier "P7" ;
    jtbd:hasShortName "IT" ;
    jtbd:hasTypicalTitles "IT Manager, Systems Administrator, outsourced MSP"@en ;
    jtbd:hasPersonaContext "Connects HR and payroll data to accounting, scheduling and identity systems; responsible for access and security."@en ;
    jtbd:hasBuyingRole "Technical evaluator; can veto on security or integration grounds"@en ;
    jtbd:hasPersonaGoal "Keep employee data flowing between systems accurately and securely with little maintenance."@en ;
    jtbd:hasEmotionalJob "Avoid being responsible for a data breach involving employee records"@en ;
    jtbd:executesJob ob:Job-J19, ob:Job-J21 ;
    jtbd:participatesInJob ob:Job-J13, ob:Job-C1, ob:Job-C2 ;
    dcterms:created "2026-10-22"^^xsd:date ;
    skos:editorialNote "Draft: pending business and compliance review before the survey is fielded."@en .
