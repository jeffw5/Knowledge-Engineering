voc:interactive-voice-response
  a skos:Concept ;
  skos:prefLabel "Interactive voice response"@en ;
  skos:altLabel "IVR"@en , "Interactive Voice Response"@en ;
  skos:definition "An acronym for Interactive Voice Response, this is a technology that allows customers to interact with a company’s phone system through voice prompts or keypad selections. This often involves navigating a menu to reach the appropriate department or information"@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:care-channel ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
