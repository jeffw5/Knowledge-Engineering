coreshp:PartyShape
  a sh:NodeShape ;
  rdfs:label "Party shape"@en ;
  skos:prefLabel "Party shape"@en ;
  skos:definition "A shape that checks the roles and locations of a party have the right type."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/core/> ;
