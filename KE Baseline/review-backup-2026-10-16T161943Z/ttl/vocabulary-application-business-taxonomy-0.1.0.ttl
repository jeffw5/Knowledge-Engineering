  dct:created "2025-08-01T19:18:08.377Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:service-type
  a skos:Concept ;
  skos:prefLabel "Service type"@en ;
  skos:definition "Describes the traditional Verizon business service areas to which Marketplace content is related."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
