  pricingcontracts:quote
    a owl:Class ;
    rdfs:label "Quote"@en ;
    skos:prefLabel "Quote"@en ;
    skos:definition "An information asset that states the prices at which the organization offers an offering to a prospect or client in pursuit of an opportunity, valid for a stated period."@en ;
    skos:scopeNote "Its components are the pricing components (measures); a proposal (Commercial Operations) presents one or more quotes."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty core:concerns ;
        owl:someValuesFrom commercialops:opportunity
    ] ,
        [
        a owl:Restriction ;
        owl:allValuesFrom core:measure ;
        owl:onProperty core:hasComponent
    ] ,
        core:information-asset ;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-pricing-and-contracts/> ;
    core:hasPrimaryTerm pricingcontractsvoc:quote ;
    dct:subject pricingcontractsvoc:quote ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-20"^^xsd:date ;
    dct:modified "2026-10-20T00:16:35Z"^^xsd:dateTime .

  pricingcontracts:census
    a owl:Class ;
    rdfs:label "Census"@en ;
    skos:prefLabel "Census"@en ;
    skos:definition "An information asset that lists a prospective client's employees with the attributes needed to price benefits and coverage."@en ;
    skos:scopeNote "Holds personal information about worksite employees; its handling is governed by the privacy and retention norms of the legal domain."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty core:concerns ;
        owl:someValuesFrom core:person
    ] ,
        core:information-asset ;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-pricing-and-contracts/> ;
    core:hasPrimaryTerm pricingcontractsvoc:census ;
    dct:subject pricingcontractsvoc:census ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-20"^^xsd:date ;
    dct:modified "2026-10-20T00:16:35Z"^^xsd:dateTime .

  pricingcontracts:underwriting
    a owl:Class ;
    rdfs:label "Underwriting"@en ;
    skos:prefLabel "Underwriting"@en ;
    skos:definition "A process that assesses the risk of covering a client and decides whether, and at what price, to offer coverage."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty core:hasStep ;
        owl:someValuesFrom core:process-step
    ] ,
        [
        a owl:Restriction ;
        owl:allValuesFrom core:directive ;
        owl:onProperty core:governedBy
    ] ,
        core:process ;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-pricing-and-contracts/> ;
    core:hasPrimaryTerm pricingcontractsvoc:underwriting ;
    dct:subject pricingcontractsvoc:underwriting ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-20"^^xsd:date ;
    dct:modified "2026-10-20T00:16:35Z"^^xsd:dateTime .

  pricingcontracts:underwriting-decision
    a owl:Class ;
    rdfs:label "Underwriting decision"@en ;
    skos:prefLabel "Underwriting decision"@en ;
    skos:definition "A decision, made in underwriting, on whether and on what terms to offer coverage to a client."@en ;
    skos:scopeNote "Kept as a class because it carries its own axioms; it consumes the census, loss runs, class codes and experience modification factor (Baseline decision 8)."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty core:consumes ;
        owl:someValuesFrom core:information-asset
    ] ,
        [
        a owl:Restriction ;
        owl:allValuesFrom core:directive ;
        owl:onProperty core:governedBy
    ] ,
        core:decision ;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-pricing-and-contracts/> ;
    core:hasPrimaryTerm decisionvoc:decision ;
