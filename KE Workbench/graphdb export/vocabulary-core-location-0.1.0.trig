<https://www.insperity.com/vocabulary/core-location/> {
  <https://www.insperity.com/vocabulary/core-location/> a skos:ConceptScheme;
    rdfs:label "Core location vocabulary"@en;
    skos:prefLabel "Core location vocabulary"@en;
    skos:hasTopConcept locationvoc:location;
    terms:description "A position or point in physical or digital space."@en;
    terms:title "Core location vocabulary"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2025-03-25T16:56:48.365Z"^^xsd:dateTime;
    skos:altLabel "Vocabulary | Core | Location"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/vocabulary/core-location/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  locationvoc:location a skos:Concept;
    skos:prefLabel "Location"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-25T17:20:32.397Z"^^xsd:dateTime;
    skos:definition "A position or point in physical or digital space."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-location/>;
    skos:altLabel "Place"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/core-location/>;
    skos:narrower locationvoc:geospatial, locationvoc:logical, locationvoc:physical .
  
  locationvoc:geospatial a skos:Concept;
    skos:prefLabel "Geospatial"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:26.239Z"^^xsd:dateTime;
    skos:definition "Relating to or involving the geographic location and spatial information of data."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-location/>;
    skos:broader locationvoc:location;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower locationvoc:latitude, locationvoc:longitude, locationvoc:polygon .
  
  locationvoc:logical a skos:Concept;
    skos:prefLabel "Logical"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:26.239Z"^^xsd:dateTime;
    skos:definition "A non-physical address or identifier that refers to a location or resource based on its function or purpose within a system."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-location/>;
    skos:broader locationvoc:location;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower locationvoc:email-address, locationvoc:internationalized-resource-identifier,
      locationvoc:phone-number, locationvoc:port-number, locationvoc:uniform-resource-identifier,
      locationvoc:uniform-resource-locator .
  
  locationvoc:physical a skos:Concept;
    skos:prefLabel "Physical"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:26.239Z"^^xsd:dateTime;
    skos:definition "A tangible location in the real world that can be identified by its geographic coordinates and/or a physical address."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-location/>;
    skos:broader locationvoc:location;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower locationvoc:post-office-box, locationvoc:street-address .
  
  locationvoc:latitude a skos:Concept;
    skos:prefLabel "Latitude"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:26.239Z"^^xsd:dateTime;
    skos:definition "The angular distance, measured in degrees, north or south of the equator (ranging from -90° to +90°)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-location/>;
    skos:broader locationvoc:geospatial;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  locationvoc:longitude a skos:Concept;
    skos:prefLabel "Longitude"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:26.239Z"^^xsd:dateTime;
    skos:definition "The angular distance, measured in degrees, east or west of the prime meridian (ranging from -180° to +180°)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-location/>;
    skos:broader locationvoc:geospatial;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  locationvoc:polygon a skos:Concept;
    skos:prefLabel "Polygon"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:26.239Z"^^xsd:dateTime;
    skos:definition "A closed geometric shape on a map defined by a connected sequence of latitude and longitude pairs, representing an area."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-location/>;
    skos:broader locationvoc:geospatial;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  locationvoc:email-address a skos:Concept;
    skos:prefLabel "Email address"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:26.239Z"^^xsd:dateTime;
    skos:definition "An electronic address used to send and receive email messages."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-location/>;
    skos:broader locationvoc:logical;
    skos:altLabel "Electronic Mail Address"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  locationvoc:internationalized-resource-identifier a skos:Concept;
    skos:prefLabel "Internationalized resource identifier"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:26.239Z"^^xsd:dateTime;
    skos:definition "A standardized text string that uniquely identifies a resource; a generalization of URI that allows for Unicode characters."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-location/>;
    skos:broader locationvoc:logical;
    skos:altLabel "IRI"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  locationvoc:phone-number a skos:Concept;
    skos:prefLabel "Phone number"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:26.239Z"^^xsd:dateTime;
    skos:definition "A numerical sequence used to identify and connect to a specific telephone line."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-location/>;
    skos:broader locationvoc:logical;
    skos:altLabel "Telephone Number"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  locationvoc:port-number a skos:Concept;
    skos:prefLabel "Port number"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:26.239Z"^^xsd:dateTime;
    skos:definition "A numerical identifier that distinguishes a specific process or service on a networked device, used alongside an IP address."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-location/>;
    skos:broader locationvoc:logical;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  locationvoc:uniform-resource-identifier a skos:Concept;
    skos:prefLabel "Uniform resource identifier"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:26.239Z"^^xsd:dateTime;
    skos:definition "A standardized string of characters used to identify a resource on a network, typically used for the World Wide Web."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-location/>;
    skos:broader locationvoc:logical;
    skos:altLabel "URI"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  locationvoc:uniform-resource-locator a skos:Concept;
    skos:prefLabel "Uniform resource locator"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:26.239Z"^^xsd:dateTime;
    skos:definition "A type of URI that specifies the location of a resource on a network and the protocol for retrieving it; often used interchangeably with URI."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-location/>;
    skos:broader locationvoc:logical;
    skos:altLabel "URL"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  locationvoc:post-office-box a skos:Concept;
    skos:prefLabel "Post office box"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:26.239Z"^^xsd:dateTime;
    skos:definition "A uniquely addressable box at a post office used for receiving mail."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-location/>;
    skos:broader locationvoc:physical;
    skos:altLabel "Post Office Box"@en, "PO box"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  locationvoc:street-address a skos:Concept;
    skos:prefLabel "Street address"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:26.239Z"^^xsd:dateTime;
    skos:definition "A standardized way of identifying the location of a building or property on a street, typically including house number, street name, and city."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-location/>;
    skos:broader locationvoc:physical;
    skos:altLabel "Address"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower locationvoc:city, locationvoc:province, locationvoc:region, locationvoc:state,
      locationvoc:street-name, locationvoc:street-number, locationvoc:zip-code .
  
  locationvoc:city a skos:Concept;
    skos:prefLabel "City"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:26.239Z"^^xsd:dateTime;
    skos:definition "A large human settlement with defined boundaries and a local government."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-location/>;
    skos:broader locationvoc:street-address;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  locationvoc:province a skos:Concept;
    skos:prefLabel "Province"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:26.239Z"^^xsd:dateTime;
    skos:definition "An administrative division within a country or state, often with its own level of government."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-location/>;
    skos:broader locationvoc:street-address;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  locationvoc:region a skos:Concept;
    skos:prefLabel "Region"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:26.239Z"^^xsd:dateTime;
    skos:definition "A geographical area with common characteristics or purpose, often less formally defined than a province or state."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-location/>;
    skos:broader locationvoc:street-address;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  locationvoc:state a skos:Concept;
    skos:prefLabel "State"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:26.239Z"^^xsd:dateTime;
    skos:definition "A political subdivision of a country with its own government and jurisdiction."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-location/>;
    skos:broader locationvoc:street-address;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  locationvoc:street-name a skos:Concept;
    skos:prefLabel "Street name"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:45:26.239Z"^^xsd:dateTime;
    skos:definition "The official name given to a street within a city or town."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-location/>;
    skos:broader locationvoc:street-address;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  locationvoc:street-number a skos:Concept;
    skos:prefLabel "Street number"@en;
