<https://www.insperity.com/vocabulary/inquiry-phase/> a skos:ConceptScheme ;
    rdfs:label "Inquiry phase vocabulary"@en ;
    skos:prefLabel "Inquiry phase vocabulary"@en ;
    skos:definition "A concept scheme of the four phases of the appreciative inquiry cycle used in persona interviews."@en ;
    skos:hasTopConcept phase:discover, phase:dream, phase:design, phase:destiny ;
    dcterms:title "Inquiry phase vocabulary"@en ;
    dcterms:description "A concept scheme of the four phases of the appreciative inquiry cycle used in persona interviews."@en ;
