  domainsalestax:demonstration
    a skos:Concept ;
    rdfs:label "Demonstration"@en ;
    skos:prefLabel "Demonstration"@en ;
    skos:definition "A selling activity that shows a buyer how an offering works in use."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/> ;
    skos:broader domainsalestax:selling-activity ;
    core:hasPrimaryTerm domainsalesvoc:demonstration ;
