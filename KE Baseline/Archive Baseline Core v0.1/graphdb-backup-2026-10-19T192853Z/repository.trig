  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#rx4_enabled>
    skos:definition "flag to indicate whether the radio is 4rx ports are enabled or not" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#rx_port_count>
    skos:definition "count of rx ports per carrier" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#sector> skos:definition
