<https://www.insperity.com/shapes/domain-sales/> {
  <https://www.insperity.com/shapes/domain-sales/> a owl:Ontology;
    rdfs:label "Domain sales shapes"@en;
    terms:description "SHACL shapes for selling steps and quotas."@en;
    terms:title "Domain sales shapes"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T02:31:43Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-19): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.9 (Draft), Part III."@en,
      "0.1.0 (2026-10-19): shapes moved out of the domain-sales ontology into their own shapes graph under https://www.insperity.com/shapes/, as Semantic Governance: Services, Architecture & Integration v1.9 (Draft), Part III requires."@en;
    terms:created "2026-10-20"^^xsd:date;
    skos:altLabel "Sales domain shapes"@en;
    owl:versionInfo "0.1.0";
    terms:subject domaintax:EnterpriseArchitecture;
    owl:imports <https://www.insperity.com/ontology/core/>, <https://www.insperity.com/ontology/domain-sales/>,
      <https://www.insperity.com/ontology/domain-sales/0.1.0/>;
    owl:versionIRI <https://www.insperity.com/shapes/domain-sales/0.1.0/>;
    vaem:namespace "https://www.insperity.com/shapes/domain-sales/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft;
    vann:preferredNamespacePrefix "domainsalesshp";
    terms:publisher <https://www.insperity.com/resource/core/Organization/insperity>;
    terms:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/> .
  
  domainsalesshp:quota-shape a sh:NodeShape;
    rdfs:label "Quota shape"@en;
    rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-sales/>;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T02:31:43Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    owl:versionInfo "0.1.0";
    sh:property _:node11854;
    sh:targetClass domainsales:quota;
    core:hasLifecycleStatus core:Draft .
  
  domainsalesshp:selling-step-shape a sh:NodeShape;
    rdfs:label "Selling step shape"@en;
    rdfs:isDefinedBy <https://www.insperity.com/shapes/domain-sales/>;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T02:31:43Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    owl:versionInfo "0.1.0";
    sh:property _:node11855, _:node11856;
    sh:targetClass domainsales:selling-step;
    core:hasLifecycleStatus core:Draft .
  
  _:node11854 sh:path core:measures;
    sh:minCount 1;
    sh:message "A quota must name the selling process, party or territory it measures."@en .
  
  _:node11855 sh:path core:isStepOf;
    sh:class domainsales:selling-process;
    sh:minCount 1;
    sh:message "A selling step must be a step of a selling process."@en .
  
  _:node11856 sh:path core:addresses;
    sh:class core:job-step;
    sh:message "addresses must point to a job step of the buyer persona."@en .
}
