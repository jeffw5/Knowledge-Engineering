  customercare:client-success-process
    a owl:Class ;
    rdfs:label "Client success process"@en ;
    skos:prefLabel "Client success process"@en ;
    skos:definition "A process by which the organization brings a won client into service and keeps, grows and turns it into an advocate."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty core:hasStep ;
        owl:someValuesFrom customercare:client-success-step
    ] ,
        core:process ;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-customer-care/> ;
    core:hasPrimaryTerm processvoc:process ;
    dct:subject processvoc:process ;
    owl:versionInfo "0.2.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-22"^^xsd:date ;
    dct:modified "2026-10-22T02:04:02Z"^^xsd:dateTime .

  customercare:client-success-step
    a owl:Class ;
    rdfs:label "Client success step"@en ;
    skos:prefLabel "Client success step"@en ;
    skos:definition "A process step of a client success process."@en ;
    skos:scopeNote "Addresses the client persona's job steps (core:addresses), intentionally not one-to-one; value gaps between their desired outcomes and the delivered outcomes are the leading indicators of churn."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty core:isStepOf ;
        owl:someValuesFrom customercare:client-success-process
    ] ,
        [
        a owl:Restriction ;
        owl:allValuesFrom core:job-step ;
        owl:onProperty core:addresses
    ] ,
        core:process-step ;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-customer-care/> ;
    core:hasPrimaryTerm processvoc:step ;
    dct:subject processvoc:step ;
    owl:versionInfo "0.2.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-22"^^xsd:date ;
    dct:modified "2026-10-22T02:04:02Z"^^xsd:dateTime .

  customercare:health-score
    a owl:Class ;
    rdfs:label "Health score"@en ;
    skos:prefLabel "Health score"@en ;
    skos:definition "A measure of the overall condition of a client relationship, computed from signals of use, satisfaction, risk and value."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty core:measures ;
        owl:someValuesFrom commercialops:account
    ] ,
        core:measure ;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-customer-care/> ;
    core:hasPrimaryTerm customercarevoc:health ;
    dct:subject customercarevoc:health ;
    owl:versionInfo "0.2.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-22"^^xsd:date ;
    dct:modified "2026-10-22T02:04:02Z"^^xsd:dateTime .

  customercare:playbook
    a owl:Class ;
    rdfs:label "Playbook"@en ;
    skos:prefLabel "Playbook"@en ;
    skos:definition "A directive that sets the steps a team follows to handle a recurring situation."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty core:governs ;
        owl:someValuesFrom customercare:client-success-step
    ] ,
        core:directive ;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-customer-care/> ;
    core:hasPrimaryTerm customercarevoc:playbook ;
