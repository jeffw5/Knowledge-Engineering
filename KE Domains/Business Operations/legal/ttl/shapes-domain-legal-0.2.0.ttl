<https://www.insperity.com/shapes/domain-legal/>
  a owl:Ontology ;
  rdfs:label "Domain Legal Shapes"@en ;
  dct:title "Domain Legal Shapes"@en ;
  dct:description "SHACL shapes that keep every norm traced to the provision that states it and every statute scoped to its jurisdiction."@en ;
  dct:subject domainvoc:legal ;
  owl:imports <https://www.insperity.com/ontology/domain-legal/> ;
