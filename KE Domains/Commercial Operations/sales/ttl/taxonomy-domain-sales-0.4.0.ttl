  skos:prefLabel "Sales process"@en ;
  skos:definition "A process the organization performs in selling, built from selling steps, that enables one or more sales services."@en ;
  skos:scopeNote "A sales service is enabled by one or more sales processes (core:supports); a process is built from its selling steps (core:hasStep) in order (core:precedes). A process shared by several services is a platform candidate."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/> ;
  skos:topConceptOf <https://www.insperity.com/taxonomy/domain-sales/> ;
  skos:narrower salestax:benefits-plan-analysis ,
      salestax:census-collection ,
      salestax:employment-cost-analysis ;
  core:hasPrimaryTerm processvoc:process ;
  dct:subject domainvoc:sales , processvoc:process ;
  core:formalizedBy core:process ;
  owl:versionInfo "0.4.0" ;
  skos:broadMatch processtax:operational-process ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-22"^^xsd:date ;
  dct:modified "2026-10-22T02:04:02Z"^^xsd:dateTime .

