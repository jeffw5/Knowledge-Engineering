voc:billing-segment
  a skos:Concept ;
  skos:prefLabel "Billing segment"@en ;
  skos:definition "Describes the billing status of a customer's connection as relates to Marketplace content."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
