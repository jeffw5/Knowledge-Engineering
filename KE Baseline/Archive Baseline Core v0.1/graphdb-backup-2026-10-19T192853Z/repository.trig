<https://www.insperity.com/ontology/core-asset/> {
  <https://www.insperity.com/ontology/core-asset/> terms:description "The core ontology of assets: resources an organization controls from which it expects future economic benefit. It arranges physical, biological, human and digital assets, and the digital assets that data and knowledge work produces (data, data products, analytics, artifacts, agents, intellectual property), into one class hierarchy, with each class linked to its term in the core asset vocabulary. Domain ontologies specialize these classes."@en;
    terms:title "Core asset ontology"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk" .
  
  ont:Asset terms:creator "Jeffrey Wallk" .
  
