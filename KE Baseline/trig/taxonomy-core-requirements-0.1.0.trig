  requirementstax:TransitionRequirement
    a skos:Concept ;
    rdfs:label "Transition requirement"@en ;
    skos:prefLabel "Transition requirement"@en ;
    skos:altLabel "Cutover requirement"@en , "Migration requirement"@en ;
    skos:definition "A requirement that states a capability needed only to move from the current to the future state."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/core-requirements/> ;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-requirements/> ;
