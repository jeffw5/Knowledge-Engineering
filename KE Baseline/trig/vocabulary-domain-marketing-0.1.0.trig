  voc:product-strategy
    a skos:Concept ;
    skos:prefLabel "Product strategy"@en ;
    skos:definition "A long-term plan for developing and managing products to achieve marketing objectives."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
    skos:broader voc:product-management ;
    owl:versionInfo "0.1.0" ;
