    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:project .
  
  applicationdatadomainvoc:project-role terms:created "2025-10-24T20:09:58.060Z"^^xsd:dateTime;
    skos:definition "Data defining the specific responsibilities and functions that individuals or groups play within a Project."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:project .
  
  applicationdatadomainvoc:project-scope terms:created "2025-10-24T20:09:58.060Z"^^xsd:dateTime;
    skos:definition "Data defining the boundaries, deliverables, and acceptance criteria for a Project."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:project .
  
  applicationdatadomainvoc:scrum-blade terms:created "2025-10-24T20:09:58.060Z"^^xsd:dateTime;
    skos:definition "Data entities specific to the SCRUM agile methodology used to extend the generic Project model."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
