  dct:created "2025-10-24T20:07:11.157Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:customer-billing-statistic
  a skos:Concept ;
  skos:prefLabel "Customer billing statistic"@en ;
  skos:definition "Aggregated and derived data (metrics) calculated from Customer Bill records for analysis and reporting."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
