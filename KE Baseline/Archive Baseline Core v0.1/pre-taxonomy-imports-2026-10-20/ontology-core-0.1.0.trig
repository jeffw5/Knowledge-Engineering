  core:lifecycle
    a owl:Class ;
    rdfs:label "Lifecycle"@en ;
    skos:prefLabel "Lifecycle"@en ;
    skos:definition "A process that takes an asset from its creation through a series of phases to its retirement."@en ;
    skos:scopeNote "All assets have lifecycles and go through the same stages: discover, define, design, develop and deliver at design time, then acquire, run and retire (decision 11)."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:allValuesFrom core:asset ;
        owl:onProperty core:lifecycleOf
    ] ,
        obo:BFO_0000015 ;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core/> ;
    core:hasPrimaryTerm lifecyclevoc:lifecycle ;
    dct:subject lifecyclevoc:lifecycle ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-19"^^xsd:date ;
    dct:modified "2026-10-19T18:45:40Z"^^xsd:dateTime .

  core:lifecycle-phase
    a owl:Class ;
    rdfs:label "Lifecycle phase"@en ;
    skos:prefLabel "Lifecycle phase"@en ;
    skos:definition "A process that is a bounded part of a lifecycle, such as discover, define, design, develop or deliver."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty core:isPhaseOf ;
        owl:someValuesFrom core:lifecycle
    ] ,
        obo:BFO_0000015 ;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core/> ;
    core:hasPrimaryTerm lifecyclevoc:phase ;
    dct:subject lifecyclevoc:lifecycle , lifecyclevoc:phase ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-19"^^xsd:date ;
    dct:modified "2026-10-19T18:45:40Z"^^xsd:dateTime .

  core:event
    a owl:Class ;
    rdfs:label "Event"@en ;
    skos:prefLabel "Event"@en ;
    skos:altLabel "Events"@en ;
    skos:definition "A process boundary at which something significant to the organization happens, such as a request arriving or a deadline passing, and which can trigger a process step."@en ;
    skos:scopeNote "Modeled as a BFO process boundary (an instantaneous occurrent): what happens over time is a step; the moment that starts or ends it is an event."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:allValuesFrom core:process-step ;
        owl:onProperty core:triggers
    ] ,
        obo:BFO_0000035 ;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core/> ;
    core:hasPrimaryTerm eventvoc:events ;
    dct:subject eventvoc:events ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-19"^^xsd:date ;
    dct:modified "2026-10-19T18:45:40Z"^^xsd:dateTime .

  core:job
    a owl:Class ;
    rdfs:label "Job"@en ;
    skos:prefLabel "Job"@en ;
    skos:definition "A process that a job executor is trying to get done, described independently of any product, service or process that might help."@en ;
    skos:scopeNote "Jobs are a type of activity kept apart from process models (decision 19). A job is unique to its executor; it generalizes on its own and gains contextual relevance when combined with the persona executing it. Kinds: functional and emotional; a job that involves money is associated with finance."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:allValuesFrom core:job-step ;
        owl:onProperty core:hasStep
    ] ,
        obo:BFO_0000015 ;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core/> ;
    core:hasPrimaryTerm jobvoc:job ;
    dct:subject jobvoc:job ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-19"^^xsd:date ;
    dct:modified "2026-10-19T18:45:40Z"^^xsd:dateTime .

  core:job-step
    a owl:Class ;
    rdfs:label "Job step"@en ;
    skos:prefLabel "Job step"@en ;
    skos:definition "A process that is a step a job executor takes within a job."@en ;
    skos:scopeNote "Akin to a process step but intentionally not one-to-one (decision 17). Job steps are unique to the job; they must not be confused with the selling steps of a provider, and the mismatch between them is where value gaps arise (decision 21)."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty core:isStepOf ;
        owl:someValuesFrom core:job
    ] ,
        obo:BFO_0000015 ;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core/> ;
    core:hasPrimaryTerm processvoc:step ;
    dct:subject jobvoc:job , processvoc:step ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-19"^^xsd:date ;
    dct:modified "2026-10-19T18:45:40Z"^^xsd:dateTime .

  core:asset
    a owl:Class ;
    rdfs:label "Asset"@en ;
    skos:prefLabel "Asset"@en ;
    skos:definition "A continuant that the organization controls and from which it expects future economic benefit."@en ;
    skos:scopeNote "The genus (decision 9). Physical assets and information assets are its BFO-grounded kinds; products, services, offerings and platforms are assets assembled from other assets, not a genus over physical or digital (decision 10)."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:allValuesFrom core:asset ;
        owl:onProperty core:hasComponent
    ] ,
        [
        a owl:Restriction ;
        owl:allValuesFrom core:lifecycle ;
        owl:onProperty core:hasLifecycle
    ] ,
        obo:BFO_0000002 ;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core/> ;
    core:hasPrimaryTerm assetvoc:asset ;
    dct:subject assetvoc:asset ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-19"^^xsd:date ;
    dct:modified "2026-10-19T18:45:40Z"^^xsd:dateTime .

  core:physical-asset
    a owl:Class ;
    rdfs:label "Physical asset"@en ;
    skos:prefLabel "Physical asset"@en ;
    skos:definition "An asset that is a material entity, such as equipment, a building or a vehicle."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty core:hasRole ;
        owl:someValuesFrom core:asset-role
    ] ,
        obo:BFO_0000040 ,
