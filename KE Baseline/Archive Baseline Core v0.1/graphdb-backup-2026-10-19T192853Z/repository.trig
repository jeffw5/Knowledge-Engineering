<https://www.insperity.com/vocabulary/core-rules/> {
  rulesvoc:action-enabler-rule skos:example "IF <condition> THEN action"@en .
  
  rulesvoc:guideline skos:example "<term> SHOULD HAVE <at least, at most, exactly n of> <term>"@en,
      "<term> SHOULD BE IN LIST <a,b,c>"@en .
  
  rulesvoc:mandatory-constraint skos:example "<term> MUST HAVE <at least, at most, exactly n of> <term>"@en,
      "<term> MUST BE IN LIST <a,b,c>"@en;
    skos:scopeNote "Grammar to use during rule documentation not implementation."@en .
  
  rulesvoc:computation-rule skos:example "<term> IS COMPUTED AS <formula>"@en .
  
  rulesvoc:inference-rule skos:example "IF <term> <operator> <term> THEN <term> <operator> <term>"@en .
}

<https://www.insperity.com/vocabulary/domain-governance/> {
  domaingovernancevoc:data-governance-controls skos:example "Data quality validation rules, mandatory data classification tags, data retention schedules, and policy approval workflows."@en .
  
  domaingovernancevoc:governance-reporting-and-metrics skos:example "Tracking data quality scores, policy adherence rates, time spent resolving data issues, and reduction in regulatory fines."@en;
    skos:scopeNote "To demonstrate the Return on Investment (ROI) of governance, identify areas of non-compliance, and track improvements in data quality, security, and process efficiency."@en .
}

<https://www.insperity.com/taxonomy/core/> {
  <https://www.insperity.com/taxonomy/core/financial-asset> skos:example "Cash; accounts receivable."@en .
  
  <https://www.insperity.com/taxonomy/core/information-asset> skos:example "A pay statement; a timesheet; a policy document."@en;
    skos:scopeNote "Aligned to the BFO generically dependent continuant category and the Information Artifact Ontology. Software is classified separately as a software asset."@en .
  
  <https://www.insperity.com/taxonomy/core/physical-asset> skos:example "A worksite building; a laptop."@en;
    skos:scopeNote "Aligned to the BFO material entity category."@en .
  
  <https://www.insperity.com/taxonomy/core/document> skos:example "Plan document; enrollment guide."@en .
  
  <https://www.insperity.com/taxonomy/core/application> skos:example "Payroll application; client portal."@en .
  
  <https://www.insperity.com/taxonomy/core/communication-equipment> skos:example "Telephone handset; network router."@en .
  
  <https://www.insperity.com/taxonomy/core/computing-equipment> skos:example "Laptop; server; tablet."@en .
  
  <https://www.insperity.com/taxonomy/core/form> skos:example "Enrollment form; tax withholding form."@en .
  
  <https://www.insperity.com/taxonomy/core/notice> skos:example "Benefits continuation notice."@en .
  
  <https://www.insperity.com/taxonomy/core/facility> skos:example "Headquarters building; regional service center."@en .
  
  <https://www.insperity.com/taxonomy/core/identifier> skos:example "Employee number; client number."@en .
  
  <https://www.insperity.com/taxonomy/core/intellectual-property> skos:example "Trademark; patent; copyright."@en .
  
  <https://www.insperity.com/taxonomy/core/ontology> skos:example "Core ontology; payroll ontology."@en .
  
  <https://www.insperity.com/taxonomy/core/transaction-record> skos:example "Payment record; payroll register entry."@en .
  
  <https://www.insperity.com/taxonomy/core/software-asset> skos:scopeNote "The deployed software is an asset; an artificial intelligence agent acting in a process is classified as an automated agent in the party taxonomy."@en .
  
  <https://www.insperity.com/taxonomy/core/record> skos:scopeNote "Records are subject to retention policies."@en .
}

<https://www.insperity.com/taxonomy/core-asset/> {
  assettax:financial-asset skos:example "Cash; accounts receivable."@en .
  
  assettax:information-asset skos:example "A pay statement; a timesheet; a policy document."@en;
    skos:scopeNote "Aligned to the BFO generically dependent continuant category and the Information Artifact Ontology. Software is classified separately as a software asset."@en .
  
  assettax:physical-asset skos:example "A worksite building; a laptop."@en;
    skos:scopeNote "Aligned to the BFO material entity category."@en .
  
  assettax:document skos:example "Plan document; enrollment guide."@en .
  
  assettax:application skos:example "Payroll application; client portal."@en .
  
  assettax:communication-equipment skos:example "Telephone handset; network router."@en .
  
  assettax:computing-equipment skos:example "Laptop; server; tablet."@en .
  
  assettax:form skos:example "Enrollment form; tax withholding form."@en .
  
  assettax:notice skos:example "Benefits continuation notice."@en .
  
  assettax:facility skos:example "Headquarters building; regional service center."@en .
  
  assettax:identifier skos:example "Employee number; client number."@en .
  
  assettax:intellectual-property skos:example "Trademark; patent; copyright."@en .
  
  assettax:ontology skos:example "Core ontology; payroll ontology."@en .
  
  assettax:transaction-record skos:example "Payment record; payroll register entry."@en .
  
  assettax:software-asset skos:scopeNote "The deployed software is an asset; an artificial intelligence agent acting in a process is classified as an automated agent in the party taxonomy."@en .
  
  assettax:record skos:scopeNote "Records are subject to retention policies."@en .
}

<https://www.insperity.com/taxonomy/core-event/> {
  <https://www.insperity.com/taxonomy/core-event/business-event> skos:example "Employee termination; client contract signed."@en .
  
  <https://www.insperity.com/taxonomy/core-event/transaction-event> skos:example "Payment issued; order placed."@en .
  
  <https://www.insperity.com/taxonomy/core-event/life-event> skos:example "Marriage; birth of a child."@en;
    skos:scopeNote "Personal circumstances such as marriage, birth, or loss of other coverage; domain ontologies specialize this."@en .
  
  <https://www.insperity.com/taxonomy/core-event/period-start> skos:example "Start of a pay period; start of a plan year."@en .
}

<https://www.insperity.com/taxonomy/core-issue/> {
  issuetax:problem skos:scopeNote "Problems are resolved by removing the cause, incidents by restoring service."@en .
  
  issuetax:risk skos:scopeNote "A risk has not yet occurred; once it occurs it is recorded as an incident or nonconformance."@en .
}

<https://www.insperity.com/taxonomy/core-lifecycle/> {
  lifecycletax:governance-lifecycle skos:scopeNote "The ten-stage knowledge governance lifecycle in Section 3.4 is in the lifecycle vocabulary."@en .
  
  lifecycletax:knowledge-artifact-lifecycle skos:scopeNote "Stages are in the lifecycle vocabulary; statuses run Draft, Candidate, Released, Deprecated, Retired."@en .
}

