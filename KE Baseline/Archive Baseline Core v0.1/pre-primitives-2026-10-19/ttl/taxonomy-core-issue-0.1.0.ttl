issuetax:Risk
  a skos:Concept ;
  rdfs:label "Risk"@en ;
  skos:prefLabel "Risk"@en ;
  skos:altLabel "Risk item"@en ;
  skos:definition "An issue that is the effect of uncertainty on objectives, expressed as a possible event and its consequence."@en ;
  skos:scopeNote "A risk has not yet occurred; once it occurs it is recorded as an incident or nonconformance."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core-issue/> ;
  skos:topConceptOf <https://www.insperity.com/taxonomy/core-issue/> ;
  skos:narrower issuetax:ArtificialIntelligenceRisk ,
      issuetax:ComplianceRisk ,
      issuetax:FinancialRisk ,
      issuetax:InformationSecurityRisk ,
      issuetax:OperationalRisk ,
      issuetax:StrategicRisk ;
  core:hasPrimaryTerm domainvoc:risk ;
  dct:subject domainvoc:risk ;
  core:formalizedBy core:Issue ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-17T01:38:18Z"^^xsd:dateTime ;
  dct:modified "2026-10-19T02:19:17Z"^^xsd:dateTime .

