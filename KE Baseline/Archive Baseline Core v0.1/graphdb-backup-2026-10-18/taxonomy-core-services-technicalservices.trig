  <https://www.insperity.com/taxonomy/core-services-technicalservices/> terms:description
      "The technical service taxonomy categorizes crucial technical functions within Verizon to enable a streamlined service delivery and enhanced user experience."@en;
    terms:title "Core services technicalservices taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime .
  
  <http://www.semanticweb.org/milsh69/ontologies/2024/2/end-to-end-governance-example#PassportIdentification>
    skos:definition "Past 7 Days Average Per Day Bytes Passed" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#_event_ingress_ts>
    skos:definition "timestamp of ingesting system at time of ingestion" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#_event_origin>
    skos:definition "identifies the location/system data was received from. pipelines that have multiple origins use pipe (" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#_event_tags>
    skos:definition "array of string values as tags for data" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#address> skos:definition
      "US Address means a street address in the United States which shall be used for all billing purposes and Policy Communications. A Post Office Box (P.O. Box) will not be acceptable for the purpose of a U.S. Address." .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#admin_status>
    skos:definition "administrative status of interface or card" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#administrative_state>
    skos:definition "administrative state of radios" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#allocated_bandwidth>
    skos:definition "allocated bandwidth for the interface in mbps" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#alternate_site_id>
    skos:definition "alternate site id corresponding to fuze site id" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#alternate_system>
    skos:definition "alternate system where the site_id corresponding to fuze originates from" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#antenna_uid>
    skos:definition "key that can be used to identify unique antenna on the network" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#area_name>
    skos:definition "Area of responsability under the hierarchy of Area for which a Submarket belongs to. (Fullname)" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#area_short>
    skos:definition "Area of responsability under the hierarchy of Area for which a Submarket belongs to. (Abbreviation)" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#auto_negotiate>
    skos:definition "Area of responsability under the hierarchy of Area for which a Submarket belongs to. (Abbreviation)" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#azimuth> skos:definition
      "antenna azimuth in degrees" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#band_capable>
    skos:definition "frequency band the radio is capable of operating in" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#bandwidth>
    skos:definition "bandwidth (hz)" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#bbu_uid> skos:definition
      "Key that can be used to identify unique BBU on the network" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#bea> skos:definition
      "(BEA) Bureau of Economic Analysis Economic Areas. Geographical economic areas as defined by the Bureau of Economic Analysis at the United States Department of Commerce and used by the FCC." .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#bundle_intf>
    skos:definition "bundle interface" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#bundle_min_links>
    skos:definition "minimum number of interfaces that need to be operational for bundle to be considered operational" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#card> skos:definition
      "a unique identifier containing the card number), as well as any parent cards the sub_card may be a part of" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#carrier> skos:definition
      "numeric value used to distinguish between the different carrier frequencies the radio is transmitting at" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#carrier_type>
    skos:definition "type of carrier based on the carrier band" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#cell_range>
    skos:definition "range of cell" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#centerline>
    skos:definition "antenna centerline in feet" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#city> skos:definition
      "city" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#clli> skos:definition
      "the first 8 digits of the hostname), associated to an msc for the ebh network" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#cma> skos:definition
      "Cellular Market Areas (Metropolitan Statistical Areas and Rural Service Areas) A geographic area used by the FCC to define the coverage of spectrum licenses in certain cellular services." .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#cma_name> skos:definition
      "Cellular Market Areas - Full Name" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#composed_of>
    skos:definition "a field used to understand the hierarchy of the cards/interfaces), in this case), what other cards are a part of this card/interface" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#configured_contact>
    skos:definition "contact information" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#configured_location>
    skos:definition "router location information" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#connection_type>
    skos:definition "the type of connection), containing the 2 endpoint device types" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#connection_uid>
    skos:definition "a unique id for the connection), containing a and z side device and interface" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#county> skos:definition
      "County Name" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#created_timestamp>
    skos:definition "Auto Generated record created time" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#description>
    skos:definition "a free text field populated by the network engineer configuring the router interface" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#device> skos:definition
      "a unique identifier which is the name of the device" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#device_uid>
    skos:definition "composite key that can be used to identify unique hardware on the network" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#du_ip_address_oam>
    skos:definition "DU IP Address" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#du_ip_address_telecom>
    skos:definition "DU IP Address" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#du_subnet>
    skos:definition "DU Subnet" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#dual_band_capable>
    skos:definition "indicates whether the radio supports dual bands" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#egress_qos>
    skos:definition "the qos (quality of service) policy applied to outgoing traffic for the interface" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#encapsulation>
    skos:definition "the packet encapsulation being used on the interface" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#enodeb_group>
    skos:definition "enodeb group that can encompass multiple enodeb_id" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#enodeb_id>
    skos:definition "enodeb/gnodeb identifier" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#event_time_utc>
    skos:definition "Timestamp of the session when established" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#fabric_policy>
    skos:definition "the qos (quality of service) policy appied to the card" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#fail_on_error>
    skos:definition "a parameter on the card indicating what it should do in the event of an error (true/false)" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#fdmimo_capable>
    skos:definition "Indicates whether the radio's are fdmimo capable" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#fiber_vendor>
    skos:definition "Fiber that comes out of the main baseband unit, some of that is owned by Verizon but some of it is provided by independent third party" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#fips> skos:definition
      "Federal Information Processing System (FIPS) Codes for States and Counties FIPS codes are numbers which uniquely identify geographic areas" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#frequency_capable>
    skos:definition "frequency the radio is capable of operating at), all values are in mhz" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#frequency_enabled>
    skos:definition "the (downlink) earfcn related to the frequency this carrier aggregation profile is related to. values are in mhz" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#generated_ts>
    skos:definition "timestamp of when the router configuration was generated in epoch milliseconds" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#gnb_du_id>
    skos:definition "gnodeb digital unit identifier" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#gnb_fsu_id>
    skos:definition "gnodeb field switchable unit identifier" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#host> skos:definition
      "identifies host from where data is received" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#indicator>
    skos:definition "Unit - Bytes In The total number of High Capacity octets - Octet=Byte - received on the interface" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#ingress_qos>
    skos:definition "the qos (quality of service) policy applied to incoming traffic for the interface" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#intf> skos:definition
