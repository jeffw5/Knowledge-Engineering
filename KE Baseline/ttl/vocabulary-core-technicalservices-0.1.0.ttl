  dct:created "2025-04-04T17:48:27.140Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:prevention
  a skos:Concept ;
  skos:prefLabel "Prevention"@en ;
  skos:definition "Proactive measures and strategies implemented to block or deter threats from reaching or damaging systems, networks, or data before they can cause harm."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-technicalservices/> ;
  skos:broader voc:threat-management ;
  owl:versionInfo "0.1.0" ;
