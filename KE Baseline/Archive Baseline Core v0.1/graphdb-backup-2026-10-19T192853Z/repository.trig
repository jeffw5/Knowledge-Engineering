  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#site_id> skos:definition
      "Unique site identifier, known as network flow id or fuze site id associated with enodeb_id" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#site_name>
    skos:definition "Site name" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#site_type>
    skos:definition "Type of site" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#software_version>
    skos:definition "the software version the device is running" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#speed_mbps>
    skos:definition "the speed of the interface in megabits per second" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#src> skos:definition
      "name of dataset" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#state> skos:definition
      "State (Abbreviation)" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#structure_type>
    skos:definition "Type of site structure" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#sub_type> skos:definition
      "Cell Site Sub Type" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#submarket>
    skos:definition "Name of Submarket" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#submarket_code>
    skos:definition "Submarket corresponding to the wireless network" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#submarket_short>
    skos:definition "Submarket (Abbreviation)" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#subnet> skos:definition
      "subnet" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#technology>
    skos:definition "technology supported" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#territory>
    skos:definition "Area of responsability under the hierarchy of Territory for which a Submarket belongs to." .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#timestamp>
    skos:definition "timestamp of data in epoch milliseconds" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#trans_dt> skos:definition
      "Record received date/Transactional date" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#tx4_capable>
    skos:definition "flag to indicate whether the radio is 4tx capable or not" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#tx4_enabled>
    skos:definition "flag to indicate whether the radio is 4tx ports are enabled or not" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#tx_port_count>
    skos:definition "count of tx ports per carrier" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#type> skos:definition
      "a category field used to understand the type of device" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#uace> skos:definition
      "Census Urban and Rural Classification and Urban Area Criteria" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#uace_name>
    skos:definition "UACE Name" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#util_avg> skos:definition
      "Average Per Hour Bits Passed" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#util_pct> skos:definition
      "Average Per Hour Bits as Percentage of Port Speed" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#vendor> skos:definition
      "name of inventory unit vendor (or vendors may provide manufacturer name)." .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#vlan> skos:definition
      "the vlan associated with the interface", "virtual local area network identifier" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#vlan_2> skos:definition
      "the 2nd vlan associated with an interface" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#vprn_customer>
    skos:definition "id that indicates the virtual private routed network customer. similar to a vrf), the vprn customer logically segments the router" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#vrf_name> skos:definition
      "the name of the virtual routing function), which logically segments the routing table of the router" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#vrrp_backup_ip>
    skos:definition "the virtual router redundancy protocol provides redundancy across routers. the backup_ip is the ip of the other router providing the redundancy." .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#xconnect> skos:definition
      "virtual interface used to implement the brix tests on cisco routers" .
  
  <http://www.semanticweb.org/wallkje/ontologies/2024/technical_services#zip_code> skos:definition
      "A ZIP Code (an acronym for Zone Improvement Plan) is a system of postal codes used by the United States Postal Service (USPS). A ZIP Code is a five digit numeric code that identifies a collection of mailing addresses within the United States and its territories to simplify the distribution of mail by the United States Postal Service (USPS)" .
}

<https://www.insperity.com/ontology/core-asset/> {
  ont:Asset skos:definition "A resource controlled by an entity from which future economic benefits are expected to be generated."@en .
  
  ont:BiologicalAsset skos:definition "A living animal or plant under the control of an entity, from which future economic benefits are expected (e.g., livestock, crops)."@en .
  
  ont:HumanAsset skos:definition "The skills, knowledge, and experience of an organization’s workforce, considered as a valuable resource."@en .
  
  ont:DigitalAsset skos:definition "Any content or data in digital form that has value and is owned or controlled by an entity (e.g., websites, documents, multimedia)."@en .
  
  ont:Analytics skos:definition "Tools, algorithms, models, and data that enable an organization to extract insights and value from data."@en .
  
  ont:AnalyticProduct skos:definition "A packaged output or result derived from applying analytics to data, designed to address a specific business need."@en .
  
  ont:Artifact skos:definition "A tangible by-product produced during the software development process (e.g., documents, code, models)."@en .
  
  ont:BusinessSpecification skos:definition "A document outlining the business requirements and objectives for a product, service, or system."@en .
  
  ont:DataEngineering skos:definition "The practice of designing, building, and maintaining systems for collecting, storing, and processing data at scale."@en .
  
  ont:DesignSpecification skos:definition "A detailed document outlining the technical requirements and specifications for a product, service, or system."@en .
  
  ont:DesignThinking skos:definition "A human-centered approach to problem-solving that emphasizes empathy, experimentation, and iterative prototyping."@en .
  
  ont:DetectiveControls skos:definition "A security mechanism designed to detect and alert on security incidents after they have occurred."@en .
  
  ont:FeatureDecomposition skos:definition "The process of breaking down a complex feature or product into smaller, more manageable components."@en .
  
  ont:KnowledgeEngineering skos:definition "The process of capturing, structuring, and representing knowledge from various sources to create a knowledge base."@en .
  
  ont:OperationalReadiness skos:definition "The state of preparedness of an organization or system to perform its intended functions effectively and efficiently."@en .
  
  ont:OperationalStandardOperatingProcedure skos:definition "A set of detailed instructions outlining the steps required to perform a specific operational task consistently."@en .
  
  ont:PreventativeControls skos:definition "A security mechanism designed to prevent security incidents from occurring in the first place."@en .
  
  ont:QualityEngineering skos:definition "The systematic application of engineering principles and methods to ensure the quality of products, services, and processes."@en .
  
  ont:ServiceLevelAgreement skos:definition "A contract outlining the agreed-upon level of service performance between a service provider and a customer."@en .
  
  ont:SolutionArchitecture skos:definition "The high-level design of a system, encompassing its components, their relationships, and the principles guiding its design."@en .
  
  ont:SystemEngineering skos:definition "An interdisciplinary approach to designing, building, and managing complex systems over their entire lifecycle."@en .
  
  ont:ValueMap skos:definition "A visual representation that maps the steps in a customer journey to the value they derive at each stage."@en .
  
  ont:Data skos:definition "A collection of data that is organized and managed in a way that makes it usable and valuable to an organization."@en .
  
  ont:DataProduct skos:definition "A packaged data set or data-driven application designed to deliver specific insights or functionality to users."@en .
  
  ont:DigitalAgent skos:definition "A software program that can perform tasks or actions on behalf of a user or another program in a digital environment."@en .
  
  ont:AutonomousAgent skos:definition "A type of intelligent agent that can operate independently and make decisions without human intervention."@en .
  
  ont:ArtificialIntelligenceAgent skos:definition "A type of intelligent agent that leverages artificial intelligence techniques to perform tasks, learn from data, and make decisions."@en .
  
  ont:BusinessIntelligenceAgent skos:definition "A type of intelligent agent that gathers and analyzes business data to provide insights and support decision-making."@en .
  
  ont:Document skos:definition "A written, printed, or electronic material that provides information or evidence."@en .
  
  ont:IntellectualProperty skos:definition "Creations of the mind, such as inventions, literary and artistic works, designs, and symbols, that are protected by law."@en .
  
  ont:Media skos:definition "The means of communication that reach a large audience (e.g., television, radio, internet)."@en .
  
  ont:Semantics skos:definition "The study of meaning in language and how words and phrases convey meaning."@en .
  
  ont:PhysicalAsset skos:definition "A tangible resource that has a physical form and is owned by an entity."@en .
}

