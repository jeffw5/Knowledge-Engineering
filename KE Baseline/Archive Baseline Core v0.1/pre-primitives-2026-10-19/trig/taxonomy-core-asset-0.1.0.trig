  assettax:SoftwareAsset
    a skos:Concept ;
    rdfs:label "Software asset"@en ;
    skos:prefLabel "Software asset"@en ;
    skos:altLabel "Digital system"@en , "Software"@en ;
    skos:definition "An asset that is a set of executable instructions or a trained model that performs computation."@en ;
    skos:scopeNote "The deployed software is an asset; an artificial intelligence agent acting in a process is classified as an automated agent in the party taxonomy."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/core-asset/> ;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-asset/> ;
    skos:narrower assettax:Application ,
        assettax:ApplicationProgrammingInterface ,
        assettax:DataStore ,
        assettax:MachineLearningModel ,
        assettax:SoftwareComponent ;
    core:formalizedBy core:SoftwareAsset ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-17T01:38:18Z"^^xsd:dateTime ;
    dct:modified "2026-10-19T02:19:17Z"^^xsd:dateTime .

  assettax:Application
    a skos:Concept ;
    rdfs:label "Application"@en ;
    skos:prefLabel "Application"@en ;
    skos:altLabel "Software application"@en , "System of record"@en ;
    skos:definition "A software asset that provides functions to users through an interface."@en ;
    skos:example "Payroll application; client portal."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/core-asset/> ;
    skos:broader assettax:SoftwareAsset ;
    core:hasPrimaryTerm applicationbusinesstaxonomyvoc:application ;
    dct:subject applicationbusinesstaxonomyvoc:application ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-17T01:38:18Z"^^xsd:dateTime ;
    dct:modified "2026-10-18T00:25:49Z"^^xsd:dateTime .

  assettax:ApplicationProgrammingInterface
    a skos:Concept ;
    rdfs:label "Application programming interface"@en ;
    skos:prefLabel "Application programming interface"@en ;
    skos:altLabel "API"@en , "Interface"@en ;
    skos:definition "A software asset that is a defined contract through which software components call one another."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/core-asset/> ;
    skos:broader assettax:SoftwareAsset ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-17T01:38:18Z"^^xsd:dateTime ;
    dct:modified "2026-10-18T00:25:49Z"^^xsd:dateTime .

  assettax:DataStore
    a skos:Concept ;
    rdfs:label "Data store"@en ;
    skos:prefLabel "Data store"@en ;
    skos:altLabel "Database"@en , "Repository"@en ;
    skos:definition "A software asset that persists and serves data."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/core-asset/> ;
    skos:broader assettax:SoftwareAsset ;
    skos:narrower assettax:DocumentStore ,
        assettax:GraphStore ,
        assettax:RelationalDatabase ,
        assettax:VectorStore ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
