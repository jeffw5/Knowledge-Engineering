<https://www.insperity.com/vocabulary/core-compliance/> {
  <https://www.insperity.com/vocabulary/core-compliance/> a skos:ConceptScheme;
    rdfs:label "Core compliance vocabulary"@en;
    skos:prefLabel "Core compliance vocabulary"@en;
    skos:hasTopConcept compliancevoc:compliance;
    terms:description "Adherence to laws, regulations, policies, and ethical standards relevant to an organization’s operations"@en;
    terms:title "Core compliance vocabulary"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2025-03-25T16:55:06.412Z"^^xsd:dateTime;
    skos:altLabel "Vocabulary | Core | Compliance"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/vocabulary/core-compliance/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  compliancevoc:compliance a skos:Concept;
    skos:prefLabel "Compliance"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-25T17:16:37.675Z"^^xsd:dateTime;
    skos:definition "Adherence to laws, regulations, policies, and ethical standards relevant to an organization’s operations."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/core-compliance/>;
    skos:narrower compliancevoc:controls, compliancevoc:documentation, compliancevoc:environmental,
      compliancevoc:guideline, compliancevoc:licensing, compliancevoc:regulation, compliancevoc:social-impact .
  
  compliancevoc:controls a skos:Concept;
    skos:prefLabel "Controls"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-27T18:17:59.545Z"^^xsd:dateTime;
    skos:definition "Mechanisms and procedures implemented to ensure compliance with regulations and internal policies."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/>;
    skos:broader compliancevoc:compliance;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower compliancevoc:analytics-and-artificial-intelligence-model-controls,
      compliancevoc:change-management-controls, compliancevoc:compliance-audits-and-controls-reporting,
      compliancevoc:data-access-controls, compliancevoc:data-lifecycle-controls, compliancevoc:data-privacy-and-data-protection-controls,
      compliancevoc:data-quality-controls, compliancevoc:data-retention-and-deletion-controls,
      compliancevoc:data-sharing-and-collaboration-controls, compliancevoc:ethical-artificial-intelligence-and-analytics-controls,
      compliancevoc:explanation-and-contextual-relevance-controls, compliancevoc:metrics-and-key-performance-indicator-monitoring-controls,
      compliancevoc:performance-and-scalability-controls, compliancevoc:semantic-knowledge-controls,
      compliancevoc:visualization-and-reporting-controls .
  
  compliancevoc:documentation a skos:Concept;
    skos:prefLabel "Documentation"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-03T21:10:28.015Z"^^xsd:dateTime;
    skos:definition "Formal records, procedures, and guidelines that provide evidence of compliance efforts and serve as a reference for employees."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/>;
    skos:broader compliancevoc:compliance;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower compliancevoc:enterprise-standards, compliancevoc:industry-standards .
  
  compliancevoc:environmental a skos:Concept;
    skos:prefLabel "Environmental"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-27T18:17:59.545Z"^^xsd:dateTime;
    skos:definition "Relating to the natural world and the impact of human activities on the environment."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/>;
    skos:broader compliancevoc:compliance;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower compliancevoc:energy-consumption, compliancevoc:waste-management .
  
  compliancevoc:guideline a skos:Concept;
    skos:prefLabel "Guideline"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-27T18:17:59.545Z"^^xsd:dateTime;
    skos:definition "A set of recommendations or best practices that provide guidance on achieving compliance but are not mandatory."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/>;
    skos:broader compliancevoc:compliance;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  compliancevoc:licensing a skos:Concept;
    skos:prefLabel "Licensing"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-27T18:17:59.545Z"^^xsd:dateTime;
    skos:definition "Legal agreements that grant permission to use software, data, or other intellectual property, often with specific compliance obligations."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/>;
    skos:broader compliancevoc:compliance;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  compliancevoc:regulation a skos:Concept;
    skos:prefLabel "Regulation"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-27T18:17:59.545Z"^^xsd:dateTime;
    skos:definition "Mandatory rules or laws imposed by government or regulatory bodies to govern specific industries or activities, including data protection and privacy."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/>;
    skos:broader compliancevoc:compliance;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower compliancevoc:california-consumer-privacy-act, compliancevoc:general-data-protection-regulation,
      compliancevoc:personal-data-protection-act, compliancevoc:protection-of-personal-information-act .
  
  compliancevoc:social-impact a skos:Concept;
    skos:prefLabel "Social impact"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-27T18:17:59.545Z"^^xsd:dateTime;
    skos:definition "The effects, both positive and negative, that an organization’s actions and operations have on society and the well-being of communities."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/>;
    skos:broader compliancevoc:compliance;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower compliancevoc:community-relations, compliancevoc:public-safety .
  
  compliancevoc:analytics-and-artificial-intelligence-model-controls a skos:Concept;
    skos:prefLabel "Analytics & artificial intelligence model controls"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-27T18:17:59.545Z"^^xsd:dateTime;
    skos:definition "Specific controls focused on the development, deployment, and use of analytics and AI models to ensure fairness, accuracy, and ethical considerations."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/>;
    skos:broader compliancevoc:controls;
    skos:altLabel "Analytics & Artificial Intelligence Model Controls"@en, "Analytics & AI model controls"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  compliancevoc:change-management-controls a skos:Concept;
    skos:prefLabel "Change management controls"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-27T18:17:59.545Z"^^xsd:dateTime;
    skos:definition "Processes and procedures designed to manage and control changes to systems, processes, and data to maintain compliance throughout the change lifecycle."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/>;
    skos:broader compliancevoc:controls;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  compliancevoc:compliance-audits-and-controls-reporting a skos:Concept;
    skos:prefLabel "Compliance audits & controls reporting"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-27T18:17:59.545Z"^^xsd:dateTime;
    skos:definition "Systematic evaluations and reports that assess the effectiveness of compliance controls and identify areas for improvement."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/>;
    skos:broader compliancevoc:controls;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  compliancevoc:data-access-controls a skos:Concept;
    skos:prefLabel "Data access controls"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-27T18:17:59.545Z"^^xsd:dateTime;
    skos:definition "Security measures that regulate who can access specific data based on their roles and responsibilities within an organization."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/>;
    skos:broader compliancevoc:controls;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  compliancevoc:data-lifecycle-controls a skos:Concept;
    skos:prefLabel "Data lifecycle controls"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-27T18:17:59.545Z"^^xsd:dateTime;
    skos:definition "Security measures applied throughout the lifecycle of data (collection, use, storage, archival, deletion) to ensure confidentiality, integrity, and availability."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/>;
    skos:broader compliancevoc:controls;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  compliancevoc:data-privacy-and-data-protection-controls a skos:Concept;
    skos:prefLabel "Data privacy & data protection controls"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-27T18:17:59.545Z"^^xsd:dateTime;
    skos:definition "Mechanisms and policies implemented to protect sensitive information from unauthorized access, use, disclosure, or destruction, ensuring compliance with privacy regulations."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/>;
    skos:broader compliancevoc:controls;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  compliancevoc:data-quality-controls a skos:Concept;
    skos:prefLabel "Data quality controls"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-27T18:17:59.545Z"^^xsd:dateTime;
    skos:definition "Processes and procedures used to ensure the accuracy, completeness, consistency, and reliability of data throughout its lifecycle."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/>;
    skos:broader compliancevoc:controls;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  compliancevoc:data-retention-and-deletion-controls a skos:Concept;
    skos:prefLabel "Data retention & deletion controls"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-27T18:17:59.545Z"^^xsd:dateTime;
    skos:definition "Policies and procedures that define how long data should be stored, archived, and eventually deleted based on legal, regulatory, and business requirements."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/>;
    skos:broader compliancevoc:controls;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  compliancevoc:data-sharing-and-collaboration-controls a skos:Concept;
    skos:prefLabel "Data sharing & collaboration controls"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-27T18:17:59.545Z"^^xsd:dateTime;
    skos:definition "Rules and guidelines for sharing data internally and externally while maintaining compliance with privacy, security, and data governance regulations."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/>;
    skos:broader compliancevoc:controls;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  compliancevoc:ethical-artificial-intelligence-and-analytics-controls a skos:Concept;
    skos:prefLabel "Ethical artificial intelligence & analytics controls"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-27T18:17:59.545Z"^^xsd:dateTime;
    skos:definition "Measures implemented to address ethical considerations in the development and use of AI and analytics, ensuring fairness, transparency, and accountability."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/>;
    skos:broader compliancevoc:controls;
    skos:altLabel "Ethical AI & analytics controls"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  compliancevoc:explanation-and-contextual-relevance-controls a skos:Concept;
    skos:prefLabel "Explanation & contextual relevance controls"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-27T18:17:59.545Z"^^xsd:dateTime;
    skos:definition "Mechanisms that provide clear explanations for AI and analytics outputs, ensuring transparency and understanding of how decisions are made."@en;
