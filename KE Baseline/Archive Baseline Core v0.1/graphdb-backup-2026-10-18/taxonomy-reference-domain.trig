<https://www.insperity.com/taxonomy/reference-domain/> {
  <https://www.insperity.com/taxonomy/reference-domain/> a owl:Ontology;
    rdfs:label "Reference domain taxonomy"@en;
    terms:description "The domain reference taxonomy categorizes and organizes information related to business operations. It encompasses key domains such as commercial aspects, corporate structure, network infrastructure, and supply chain management, providing a comprehensive view of an organization’s operational landscape. This taxonomy facilitates data analysis, knowledge management, and decision-making by standardizing terminology and relationships between different business areas."@en;
    terms:title "Reference domain taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2024-09-15T06:15:42.901Z"^^xsd:dateTime;
    skos:altLabel "Taxonomy | Reference | Domain"@en;
    owl:versionInfo "0.1.0";
    owl:imports <https://www.insperity.com/taxonomy/core-compliance/>, <https://www.insperity.com/ontology/domain-facilities/>,
      <https://www.insperity.com/ontology/domain-finance/>, <https://www.insperity.com/ontology/domain-governance/>,
      <https://www.insperity.com/ontology/domain-humanresource/>, <https://www.insperity.com/ontology/domain-informationtechnology/>,
      <https://www.insperity.com/ontology/domain-legal/>, <https://www.insperity.com/ontology/domain-marketing/>,
      <https://www.insperity.com/ontology/domain-network/>, <https://www.insperity.com/ontology/domain-procurement/>,
      <https://www.insperity.com/ontology/domain-sales/>, <https://www.insperity.com/ontology/domain-security/>,
      <https://www.insperity.com/ontology/domain-supplychain/>, <https://www.insperity.com/taxonomy/core-businessoperations/>;
    owl:versionIRI <https://www.insperity.com/taxonomy/reference-domain/0.1.0/>;
    vann:preferredNamespaceUri "https://www.insperity.com/taxonomy/reference-domain/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  referencedomaintax:Compliance a owl:Class;
