    skos:related applicationdatadomainvoc:trouble-or-problem .
  
  applicationdatadomainvoc:service-problem terms:created "2025-10-24T20:12:39.056Z"^^xsd:dateTime;
    skos:definition "A Service Problem is any detected or reported issue affecting the expected performance, availability, or behavior of a network service."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:service-network;
    skos:related applicationdatadomainvoc:trouble-or-problem .
  
  applicationdatadomainvoc:internet-protocol-detail-record terms:created "2025-10-24T20:10:15.621Z"^^xsd:dateTime;
    skos:definition "A specific type of Usage record that captures technical data about IP-based communication events (e.g., source/destination IP, bytes transferred)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:usage;
    skos:altLabel "IP detail record"@en .
  
  applicationdatadomainvoc:usage-specification terms:created "2025-10-24T20:10:15.621Z"^^xsd:dateTime;
    skos:definition "The technical blueprint that defines the characteristics and structure of a specific type of Usage event record."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:usage .
  
  applicationdatadomainvoc:product-usage terms:created "2025-10-24T20:10:46.974Z"^^xsd:dateTime;
