  dct:modified "2026-10-20T00:16:35Z"^^xsd:dateTime .

commercialopsvoc:human-capital-management
  a skos:Concept ;
  rdfs:label "human capital management"@en ;
  skos:prefLabel "human capital management"@en ;
  skos:altLabel "HCM"@en ;
  skos:definition "The practices and technology an organization uses to recruit, manage, develop, pay and retain its workforce."@en ;
  skos:scopeNote "A multiword lexical unit (Baseline decision 3)."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-commercial-operations/> ;
  skos:topConceptOf <https://www.insperity.com/vocabulary/domain-commercial-operations/> ;
