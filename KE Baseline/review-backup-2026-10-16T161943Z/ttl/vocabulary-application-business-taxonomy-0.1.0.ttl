voc:dashboard
  a skos:Concept ;
  skos:prefLabel "Dashboard"@en ;
  skos:definition "Serves as an interactive data visualization interface to consolidate and display a combination of Key Performance Indicators (KPIs), metrics and critical data points on a single, easily digestible screen."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:marketplace-content-type ;
  owl:versionInfo "0.1.0" ;
