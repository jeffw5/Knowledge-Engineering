<https://www.insperity.com/vocabulary/core-rules/> {
  <https://www.insperity.com/vocabulary/core-rules/> a skos:ConceptScheme;
    rdfs:label "Core rules vocabulary"@en;
    skos:prefLabel "Core rules vocabulary"@en;
    skos:hasTopConcept rulesvoc:rules;
    terms:description "Statements that define or restrict an organization's activities, guiding decision-making and ensuring actions align with business strategy, ultimately streamlining operations and enhancing efficiency."@en;
    terms:title "Core rules vocabulary"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2025-03-25T16:58:45.094Z"^^xsd:dateTime;
    skos:altLabel "Vocabulary | Core | Rules"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/vocabulary/core-rules/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  rulesvoc:rules a skos:Concept;
    skos:prefLabel "Rules"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-25T17:23:12.511Z"^^xsd:dateTime;
    skos:definition "Statements that define or restrict an organization's activities, guiding decision-making and ensuring actions align with business strategy, ultimately streamlining operations and enhancing efficiency."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/core-rules/>;
    skos:narrower rulesvoc:decision-logic, rulesvoc:process-flow, rulesvoc:structural-rule .
  
  rulesvoc:decision-logic a skos:Concept;
    skos:prefLabel "Decision logic"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime;
    skos:definition "Core of what is typically referred to as 'business rules.' When a business decision needs to be made, the business rules are the individual statements of business logic that determine the result of the decision."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/>;
    skos:broader rulesvoc:rules;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower rulesvoc:action-enabler-rule, rulesvoc:constraint-rule, rulesvoc:derivation-rule,
      rulesvoc:guideline .
  
  rulesvoc:process-flow a skos:Concept;
    skos:prefLabel "Process flow"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime;
    skos:definition "Rules that purely direct the movement through a process flow (or workflow, etc.)"@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/>;
    skos:broader rulesvoc:rules;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  rulesvoc:structural-rule a skos:Concept;
    skos:prefLabel "Structural rule"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime;
    skos:definition "Defines the fundamental structure and organization of data, concepts, and knowledge, ensuring consistency and facilitating analysis, and is often considered a \"definitional rule\"."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/>;
    skos:broader rulesvoc:rules;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower rulesvoc:facts, rulesvoc:terms .
  
  rulesvoc:action-enabler-rule a skos:Concept;
    skos:prefLabel "Action enabler rule"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime;
    skos:definition "Process based rules that test conditions and upon finding them true, initiate another business event, message or other activity"@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/>;
    skos:broader rulesvoc:decision-logic;
    skos:example "IF <condition> THEN action"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  rulesvoc:constraint-rule a skos:Concept;
    skos:prefLabel "Constraint rule"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime;
    skos:definition "Rules used for validation of data"@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/>;
    skos:broader rulesvoc:decision-logic;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower rulesvoc:mandatory-constraint, rulesvoc:operation-constraint, rulesvoc:stimulus-and-response,
      rulesvoc:structure-constraint .
  
  rulesvoc:derivation-rule a skos:Concept;
    skos:prefLabel "Derivation rule"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime;
    skos:definition "Also known as the Eligibility Rule, a set of conditions or logic that determines whether a specific characteristic or value should be derived or assigned based on other existing data or values."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/>;
    skos:broader rulesvoc:decision-logic;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower rulesvoc:computation-rule, rulesvoc:inference-rule .
  
  rulesvoc:guideline a skos:Concept;
    skos:prefLabel "Guideline"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime;
    skos:definition "Rule that does not reject the transaction; they merely warn about an undesirable circumstance. Usually translates to warning messages."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/>;
    skos:broader rulesvoc:decision-logic;
    skos:example "<term> SHOULD HAVE <at least, at most, exactly n of> <term>"@en, "<term> SHOULD BE IN LIST <a,b,c>"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  rulesvoc:mandatory-constraint a skos:Concept;
    skos:prefLabel "Mandatory constraint"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime;
    skos:definition "Rules that reject the attempted business transaction"@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/>;
    skos:broader rulesvoc:constraint-rule;
    skos:example "<term> MUST HAVE <at least, at most, exactly n of> <term>"@en, "<term> MUST BE IN LIST <a,b,c>"@en;
    skos:scopeNote "Grammar to use during rule documentation not implementation."@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  rulesvoc:operation-constraint a skos:Concept;
    skos:prefLabel "Operation constraint"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime;
    skos:definition "Places restrictions before and after a given operation"@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/>;
    skos:broader rulesvoc:constraint-rule;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  rulesvoc:stimulus-and-response a skos:Concept;
    skos:prefLabel "Stimulus & response"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime;
    skos:definition "Require conditions to be true prior to an action being taken"@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/>;
    skos:broader rulesvoc:constraint-rule;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  rulesvoc:structure-constraint a skos:Concept;
    skos:prefLabel "Structure constraint"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime;
    skos:definition "Authoritative constraint that established policies around classes, objects and the relationships between them that should not be disregarded"@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/>;
    skos:broader rulesvoc:constraint-rule;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  rulesvoc:computation-rule a skos:Concept;
    skos:prefLabel "Computation rule"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime;
    skos:definition "Rule that creates new information from existing information based on mathematical calculation or use of algorithm. Result is a piece of knowledge inferred, but not simply known."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/>;
    skos:broader rulesvoc:derivation-rule;
    skos:example "<term> IS COMPUTED AS <formula>"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  rulesvoc:inference-rule a skos:Concept;
    skos:prefLabel "Inference rule"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime;
    skos:definition "Specify that if certain facts are true, a particular conclusion can be determined."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/>;
    skos:broader rulesvoc:derivation-rule;
    skos:example "IF <term> <operator> <term> THEN <term> <operator> <term>"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  rulesvoc:facts a skos:Concept;
    skos:prefLabel "Facts"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime;
    skos:definition "Word or phrase used by the business"@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/>;
    skos:broader rulesvoc:structural-rule;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  rulesvoc:terms a skos:Concept;
    skos:prefLabel "Terms"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:49:47.371Z"^^xsd:dateTime;
    skos:definition "Relationships between two business concepts expressed as a statement connecting terms through prepositions and verbs into sensible business-relevant observations"@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-rules/>;
    skos:broader rulesvoc:structural-rule;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
}
