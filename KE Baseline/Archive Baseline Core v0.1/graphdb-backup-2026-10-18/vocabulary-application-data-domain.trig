    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:product;
    skos:related applicationdatadomainvoc:usage .
  
  applicationdatadomainvoc:resource-usage terms:created "2025-10-24T20:11:44.803Z"^^xsd:dateTime;
    skos:definition "Data that collects and records Resource consumption data (e.g., utilization) for use by other business entities."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:resource-network-and-device;
    skos:related applicationdatadomainvoc:usage .
  
  applicationdatadomainvoc:loyalty terms:created "2025-10-24T20:10:46.974Z"^^xsd:dateTime;
