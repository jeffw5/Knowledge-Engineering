  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-20"^^xsd:date ;
  dct:modified "2026-10-20T04:19:14Z"^^xsd:dateTime .

commercialops:attributedTo
  a owl:ObjectProperty ;
  rdfs:label "attributed to"@en ;
  skos:prefLabel "attributed to"@en ;
  skos:definition "A relation between a lead, opportunity or sale and the party credited with sourcing or influencing it."@en ;
  skos:scopeNote "The campaign or channel credited is reached through the process step the party performed."@en ;
  rdfs:subPropertyOf core:concerns ;
