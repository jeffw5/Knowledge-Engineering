voc:marketing-and-sales
  a skos:Concept ;
  skos:prefLabel "Marketing & sales"@en ;
  skos:definition "Activities related to promoting and selling products or services."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/> ;
  skos:broader voc:value-chain-analysis ;
  owl:versionInfo "0.1.0" ;
