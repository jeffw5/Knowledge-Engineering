  voc:product-management
    a skos:Concept ;
    skos:prefLabel "Product management"@en ;
    skos:definition "The process of planning, developing, launching, and managing products."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
    skos:broader voc:marketing-mix ;
    skos:narrower voc:product-strategy , voc:service-management ;
