<https://www.insperity.com/vocabulary/domain-governance/> {
  <https://www.insperity.com/vocabulary/domain-governance/> a skos:ConceptScheme;
    rdfs:label "Domain governance vocabulary"@en;
    skos:prefLabel "Domain governance vocabulary"@en;
    skos:hasTopConcept domaingovernancevoc:governance;
    terms:description "The system of rules, practices, and processes by which a company is directed and controlled, ensuring accountability, transparency, and ethical management."@en;
    terms:title "Domain governance vocabulary"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2025-03-25T17:01:46.816Z"^^xsd:dateTime;
    skos:altLabel "Vocabulary | Domain | Governance"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/vocabulary/domain-governance/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  domaingovernancevoc:governance a skos:Concept;
    skos:prefLabel "Governance"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-25T17:26:48.997Z"^^xsd:dateTime;
    skos:definition "The system of rules, practices, and processes by which a company is directed and controlled, ensuring accountability, transparency, and ethical management."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/>;
    skos:altLabel "Data Governance"@en, "Corporate Governance"@en, "Business Governance"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-governance/>;
    skos:narrower domaingovernancevoc:data-governance-activities, domaingovernancevoc:data-governance-agent,
      domaingovernancevoc:data-governance-lifecycle, domaingovernancevoc:data-governance-operations,
      domaingovernancevoc:data-governance-policy, domaingovernancevoc:data-governance-services,
      domaingovernancevoc:data-governance-standards, domaingovernancevoc:data-governance-tools .
  
  domaingovernancevoc:data-governance-activities a skos:Concept;
    skos:prefLabel "Data governance activities"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime;
    skos:definition "Encompass all the tasks and processes performed to establish, maintain, and enforce data governance principles and policies."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/>;
    skos:broader domaingovernancevoc:governance;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domaingovernancevoc:governance-control-activity, domaingovernancevoc:governance-development-activity,
      domaingovernancevoc:governance-operational-activity, domaingovernancevoc:governance-planning-activity .
  
  domaingovernancevoc:data-governance-agent a skos:Concept;
    skos:prefLabel "Data governance agent"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime;
    skos:definition "An individual or a role within an organization responsible for implementing and enforcing data governance policies and procedures, ensuring data quality, consistency, and security throughout its lifecycle."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/>;
    skos:broader domaingovernancevoc:governance;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domaingovernancevoc:data-governance-council, domaingovernancevoc:data-owners,
      domaingovernancevoc:data-stewards .
  
  domaingovernancevoc:data-governance-lifecycle a skos:Concept;
    skos:prefLabel "Data governance lifecycle"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime;
    skos:definition "A cyclical framework that outlines the stages of data governance, from initial planning and design to implementation, monitoring, and continuous improvement."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/>;
    skos:broader domaingovernancevoc:governance;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domaingovernancevoc:data-governance-operations a skos:Concept;
    skos:prefLabel "Data governance operations"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime;
    skos:definition "The ongoing activities and tasks performed to ensure that data governance policies and procedures are followed and that data quality is maintained."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/>;
    skos:broader domaingovernancevoc:governance;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domaingovernancevoc:artificial-intelligence-governance, domaingovernancevoc:data-catalog-operations,
      domaingovernancevoc:data-governance-controls, domaingovernancevoc:data-governance-design,
      domaingovernancevoc:data-literacy, domaingovernancevoc:data-protection, domaingovernancevoc:governance-reporting-and-metrics,
      domaingovernancevoc:semantic-governance .
  
  domaingovernancevoc:data-governance-policy a skos:Concept;
    skos:prefLabel "Data governance policy"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime;
    skos:definition "The process of creating, approving, implementing, communicating, enforcing, and maintaining data governance policies throughout their lifecycle."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/>;
    skos:broader domaingovernancevoc:governance;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domaingovernancevoc:access-control-policies, domaingovernancevoc:business-policy,
      domaingovernancevoc:data-privacy-regulations, domaingovernancevoc:data-quality-standards .
  
  domaingovernancevoc:data-governance-services a skos:Concept;
    skos:prefLabel "Data governance services"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime;
    skos:definition "Specialized expertise and support provided to organizations to help them establish, improve, or manage their data governance programs."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/>;
    skos:broader domaingovernancevoc:governance;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domaingovernancevoc:data-governance-standards a skos:Concept;
    skos:prefLabel "Data governance standards"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime;
    skos:definition "A set of documented rules, guidelines, and best practices that define how data should be managed, protected, and used within an organization."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/>;
    skos:broader domaingovernancevoc:governance;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domaingovernancevoc:data-governance-tools a skos:Concept;
    skos:prefLabel "Data governance tools"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime;
    skos:definition "Software applications designed to support data governance activities, such as data cataloging, metadata management, and policy enforcement."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/>;
    skos:broader domaingovernancevoc:governance;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domaingovernancevoc:business-glossary, domaingovernancevoc:data-governance-scorecards,
      domaingovernancevoc:document-management-tools, domaingovernancevoc:online-presence,
      domaingovernancevoc:workflow-tools .
  
  domaingovernancevoc:governance-control-activity a skos:Concept;
    skos:prefLabel "Governance control activity"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime;
    skos:definition "Activities designed to monitor and enforce data governance policies and standards, ensuring compliance and mitigating risks."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/>;
    skos:broader domaingovernancevoc:data-governance-activities;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domaingovernancevoc:data-governance-operating-framework, domaingovernancevoc:perform-discovery-and-business-alignment .
  
  domaingovernancevoc:governance-development-activity a skos:Concept;
    skos:prefLabel "Governance development activity"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime;
    skos:definition "Activities focused on creating, defining, and refining data governance frameworks, policies, standards, and procedures."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/>;
    skos:broader domaingovernancevoc:data-governance-activities;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domaingovernancevoc:define-data-governance, domaingovernancevoc:develop-goals-principles-and-policies,
      domaingovernancevoc:develop-organizational-touchpoints .
  
  domaingovernancevoc:governance-operational-activity a skos:Concept;
    skos:prefLabel "Governance operational activity"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime;
    skos:definition "Day-to-day activities that support the implementation and execution of data governance, such as data quality monitoring, issue resolution, and access management."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/>;
    skos:broader domaingovernancevoc:data-governance-activities;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domaingovernancevoc:change-management, domaingovernancevoc:data-management-project-support-and-prioritization,
      domaingovernancevoc:develop-data-governance-strategy, domaingovernancevoc:implement-data-governance,
      domaingovernancevoc:third-party-sharing .
  
  domaingovernancevoc:governance-planning-activity a skos:Concept;
    skos:prefLabel "Governance planning activity"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime;
    skos:definition "Activities related to defining the overall data governance strategy, setting goals, allocating resources, and establishing timelines."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/>;
    skos:broader domaingovernancevoc:data-governance-activities;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domaingovernancevoc:assess-regulatory-compliance-requirements, domaingovernancevoc:perform-readiness-assessment .
  
  domaingovernancevoc:data-governance-operating-framework a skos:Concept;
    skos:prefLabel "Data governance operating framework"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime;
    skos:definition "A comprehensive structure that outlines the processes, roles, responsibilities, and tools required to implement and maintain effective data governance."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/>;
    skos:broader domaingovernancevoc:governance-control-activity;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domaingovernancevoc:perform-discovery-and-business-alignment a skos:Concept;
    skos:prefLabel "Perform discovery & business alignment"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime;
    skos:definition "Understanding the current state of data management practices, identifying areas for improvement, and aligning data governance initiatives with business needs."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/>;
    skos:broader domaingovernancevoc:governance-control-activity;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower domaingovernancevoc:detective-controls, domaingovernancevoc:preventative-controls .
  
  domaingovernancevoc:detective-controls a skos:Concept;
    skos:prefLabel "Detective controls"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime;
    skos:definition "Security measures designed to detect and alert on security incidents or policy violations after they occur."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/>;
    skos:broader domaingovernancevoc:perform-discovery-and-business-alignment;
