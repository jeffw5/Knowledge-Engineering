    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A record of a sale entered when the client signs an agreement, before the client's service starts."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-sales/>;
    owl:versionInfo "0.2.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-sales/> .
  
  salesvoc:demonstration a skos:Concept;
