issuevoc:incident
  a skos:Concept ;
  rdfs:label "Incident"@en ;
  skos:prefLabel "Incident"@en ;
  skos:definition "An event that disrupts or could disrupt a service or system operation. Often used interchangeably with “problem”."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-issue/> ;
  skos:broader issuevoc:problem ;
