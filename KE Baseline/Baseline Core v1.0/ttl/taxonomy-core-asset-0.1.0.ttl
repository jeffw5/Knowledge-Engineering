assettax:financial-asset
  a skos:Concept ;
  rdfs:label "Financial asset"@en ;
  skos:prefLabel "Financial asset"@en ;
  skos:definition "An asset that is a monetary claim or contractual right to receive cash or another financial asset."@en ;
  skos:example "Cash; accounts receivable."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core-asset/> ;
  skos:topConceptOf <https://www.insperity.com/taxonomy/core-asset/> ;
  skos:narrower assettax:cash-and-cash-equivalent ,
      assettax:investment ,
      assettax:prepaid-amount ,
      assettax:receivable ;
  core:hasPrimaryTerm assetvoc:asset ;
  dct:subject assetvoc:asset ,
      <https://www.insperity.com/vocabulary/core-domain/finance> ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-17T01:38:18Z"^^xsd:dateTime ;
  dct:modified "2026-10-19T18:44:21Z"^^xsd:dateTime .

