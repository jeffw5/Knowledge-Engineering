  applicationdatadomainvoc:alarm terms:created "2025-10-24T20:12:15.215Z"^^xsd:dateTime;
    skos:definition "A data record signaling an unexpected or critical event or condition that indicates a potential Resource or service issue."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:resource-trouble .
  
  applicationdatadomainvoc:alarm-severity-assignment-profile terms:created "2025-10-24T20:12:15.215Z"^^xsd:dateTime;
    skos:definition "Data defining the rules for assigning a level of criticality (severity) to a specific type of Alarm."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:resource-trouble .
  
  applicationdatadomainvoc:service terms:created "2025-10-24T20:12:39.056Z"^^xsd:dateTime;
    skos:definition "Data representing the instances of both customer-facing and resource-facing types of network services."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:service-network .
  
  applicationdatadomainvoc:service-order terms:created "2025-10-24T20:12:39.056Z"^^xsd:dateTime;
    skos:definition "A Service Order is a formal request to create, modify, suspend, or terminate a network service instance based on a predefined service specification."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:service-network .
  
  applicationdatadomainvoc:service-specification terms:created "2025-10-24T20:12:39.056Z"^^xsd:dateTime;
    skos:definition "A Service Specification defines the detailed technical and functional description of a network-facing service within the telecom operator’s infrastructure. It acts as a blueprint for creating consistent and reusable service instances that deliver specific network capabilities, independent of any customer or commercial context. Scope: In the revised model, where the Services Domain is restricted to network-only services, the Service Specification exclusively defines characteristics of services that are: • Provisioned and managed directly by the network (physical or virtual) • Used as building blocks by higher-layer products or orchestration systems • Not directly visible or exposed to the end customer Examples of Network Service Specifications: • 5G Radio Access Service Specification • MPLS VPN Transport Service Specification • IMS Voice Core Routing Specification • Fiber Broadband Access Specification • Network Slice Specification for IoT Low-Latency Use Cases Attributes Typically Defined in a Network Service Specification: • Service type and category (e.g., transport, access, core) • Technical parameters (bandwidth, latency, QoS class) • Resource dependencies (e.g., physical ports, VNFs, slices) • Lifecycle behavior (provisioning rules, assurance triggers) • Interfaces and control protocols (e.g., NETCONF, REST, gRPC)"@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:service-network;
    skos:altLabel "Service Spec"@en .
  
  applicationdatadomainvoc:service-strategy-and-plan terms:created "2025-10-24T20:12:39.056Z"^^xsd:dateTime;
    skos:definition "Service Strategy and Plan refers to the roadmap, policies, and investment direction guiding the evolution, scaling, and optimization of network services."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:service-network .
  
  applicationdatadomainvoc:telecom-infra-project-service-management terms:created "2025-10-24T20:12:39.056Z"^^xsd:dateTime;
    skos:definition "In the context of Capital TIP, Service Management refers to the practices and frameworks for managing open, disaggregated, and vendor-neutral network services as defined by the Telecom Infra Project (TIP)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:service-network;
    skos:altLabel "TIP Service Management"@en .
  
  applicationdatadomainvoc:service-level-specification terms:created "2025-10-24T20:12:46.275Z"^^xsd:dateTime;
    skos:definition "A Service Level Specification defines the agreed set of performance commitments or objectives for a network service, usually expressed in measurable KPIs (Key Performance Indicators). These are often formalized in SLAs (Service Level Agreements)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:service-performance;
    skos:altLabel "Service Level Spec"@en .
  
  applicationdatadomainvoc:service-performance-specification terms:created "2025-10-24T20:12:46.275Z"^^xsd:dateTime;
    skos:definition "A Service Performance Specification defines what metrics to monitor, how they are measured, and the data collection methods used to assess the performance of a network service. It is more technical than the SLS and used by systems to implement performance monitoring."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:service-performance;
    skos:altLabel "Service Performance Spec"@en .
  
  applicationdatadomainvoc:resource-facing-service-specification terms:created "2025-10-24T20:12:56.127Z"^^xsd:dateTime;
    skos:definition "A Resource-Facing Service Specification defines a network service in terms of its direct interaction with and dependency on underlying network resources—such as physical infrastructure, virtual network functions (VNFs), and logical connections. It provides the technical blueprint required to bind service behavior with resource orchestration and assurance."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:service-specification;
    skos:example """  •        VNF-Based Firewall Service Specification
        •        Fiber Port Access Service Specification
        •        5G gNodeB Access Service Specification
        •        SD-WAN Overlay Resource Service Specification"""@en;
    skos:scopeNote """
        •        Models services tightly coupled with infrastructure elements (e.g., ports, links, VNFs, slices)
        •        Captures technical attributes required for automated provisioning, scaling, and monitoring
        •        Reused across multiple higher-level service or product specifications
"""@en .
  
  applicationdatadomainvoc:calendar terms:created "2025-10-24T20:13:06.652Z"^^xsd:dateTime;
    skos:definition "Represents Entities used to provide time related functions. This includes scheduling, time conflicts and time based presentation support"@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:shared-reference-data .
  
  applicationdatadomainvoc:digital-identity terms:created "2025-10-24T20:13:06.652Z"^^xsd:dateTime;
    skos:definition "Data entities used for identification and authentication of a Party or Resource to grant them system permissions based on their roles."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:shared-reference-data .
  
  applicationdatadomainvoc:location terms:created "2025-10-24T20:13:06.652Z"^^xsd:dateTime;
    skos:definition "Data representing the site or position of something (e.g., customer address, equipment site) using coordinates, addresses, or physical representations."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:shared-reference-data .
  
  applicationdatadomainvoc:party terms:created "2025-10-24T20:13:06.652Z"^^xsd:dateTime;
    skos:definition "A Party represents an individual, an organization, or an organization unit that are of interest, involved or that provide value directly or indirectly from an enterprise perspective (Enterprise is to be understood here as provider, service provider or operator). Hence the Party plays one or more roles with the enterprise or with another Party playing a role with the enterprise (indirectly). This is introduced to specify that the only party an enterprise would be interested in and will consider in its systems is a party playing a role (directly or indirectly)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:shared-reference-data .
  
  applicationdatadomainvoc:party-payment terms:created "2025-10-24T20:13:06.652Z"^^xsd:dateTime;
    skos:definition "Data entities required to describe a payment, including the method used (e.g., credit card, bank account)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:shared-reference-data .
  
  applicationdatadomainvoc:party-privacy terms:created "2025-10-24T20:13:06.652Z"^^xsd:dateTime;
    skos:definition "Data entities for specifying the information, rules, and choices made by Parties regarding the handling of their private data."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:shared-reference-data .
  
  applicationdatadomainvoc:permission terms:created "2025-10-27T18:01:14.324Z"^^xsd:dateTime;
    skos:definition "Data representing the granted rights or authorizations to a Party Role, whether explicit or implicit."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:shared-reference-data .
  
  applicationdatadomainvoc:schedule-definition terms:created "2025-10-27T17:52:14.925Z"^^xsd:dateTime;
    skos:definition "The technical blueprint that defines the parameters, frequency, and duration of a recurring Schedule."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:calendar .
  
  applicationdatadomainvoc:geographic-place terms:created "2025-10-27T17:53:46.439Z"^^xsd:dateTime;
    skos:definition "A group of entities that are used to define a geographic location and enable it to be marked it on a map or given an address"@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:location .
  
  applicationdatadomainvoc:local-place terms:created "2025-10-27T17:53:46.439Z"^^xsd:dateTime;
    skos:definition "A set of entities that determine where things are in relation to a local coordinate system."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:location .
  
  applicationdatadomainvoc:opengis-simple-features-specification terms:created "2025-10-27T17:53:46.439Z"^^xsd:dateTime;
    skos:definition "A set of geometric standards defined by the Open Geospatial Consortium (OGC), an international industry consortium made up of companies, government agencies, and universities participating in a consensus process to develop publicly available interface standards"@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:location;
    skos:altLabel "OpenGIS SFS"@en .
  
  applicationdatadomainvoc:contact-medium terms:created "2025-10-24T20:13:14.976Z"^^xsd:dateTime;
    skos:definition "Data representing the various means (e.g., phone number, email address) by which a Party Role or Account can be reached."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:party .
  
  applicationdatadomainvoc:currency terms:created "2025-10-24T20:13:14.976Z"^^xsd:dateTime;
    skos:definition "Data entities related to the representation and management of monetary units."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:party .
  
  applicationdatadomainvoc:identification terms:created "2025-10-24T20:13:14.976Z"^^xsd:dateTime;
    skos:definition "Data representing the various formats and instances of identification used by individuals and organizations (Parties)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:party .
  
  applicationdatadomainvoc:party-community terms:created "2025-10-24T20:13:14.976Z"^^xsd:dateTime;
    skos:definition "Data entities modeling a group (Community) of Parties (e.g., an organization) and their members, contributions, and assets."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:party .
  
  applicationdatadomainvoc:party-demographic terms:created "2025-10-24T20:13:14.976Z"^^xsd:dateTime;
    skos:definition "Demographics deal with the study of individuals and organizations (Parties), including their size, growth, density, and distribution, as well as statistics regarding birth, marriage, disease, and death. Demographic data is information about parties that allows decisions to be made such as the make-up and size of a market segment, classification and ranking of customers, and so forth. Demographics provide the key “what” information and can be broken down into two categories: individual demographics and organization demographics"@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:party .
  
  applicationdatadomainvoc:party-organization terms:created "2025-10-24T20:13:14.976Z"^^xsd:dateTime;
    skos:definition "Data used to model the structure, hierarchy, and attributes of an organizational Party."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:party .
  
  applicationdatadomainvoc:party-permission terms:created "2025-10-24T20:13:06.652Z"^^xsd:dateTime;
    skos:definition "Data entities for describing the scope, specifications, and effective grants of rights or authorizations to a Party Role."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:party .
  
  applicationdatadomainvoc:party-role-examples terms:created "2025-10-24T20:13:14.976Z"^^xsd:dateTime;
    skos:definition "Data illustrating common functions or responsibilities that a Party may assume (e.g., customer, supplier)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:party .
  
  applicationdatadomainvoc:party-role-group terms:created "2025-10-24T20:13:14.976Z"^^xsd:dateTime;
    skos:definition "Data entities used to specify and manage collections of Party Roles."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:party .
  
  applicationdatadomainvoc:skill terms:created "2025-10-24T20:13:14.976Z"^^xsd:dateTime;
    skos:definition "The skills an individual or organization possesses and a catalog of specification of skills"@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:party .
  
  applicationdatadomainvoc:bank terms:created "2025-10-24T20:13:21.158Z"^^xsd:dateTime;
    skos:definition "Data entities related to financial institutions where Parties or the enterprise may hold accounts."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:party-payment .
  
  applicationdatadomainvoc:party-privacy-profile terms:created "2025-10-24T20:13:27.402Z"^^xsd:dateTime;
    skos:definition "Data entities specifically recording the choices and preferences made by a Party regarding their own privacy."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:party-privacy .
  
  applicationdatadomainvoc:party-privacy-profile-type terms:created "2025-10-24T20:13:27.402Z"^^xsd:dateTime;
    skos:definition "Data entities specifying the types of information and the privacy rules themselves that govern party data."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:party-privacy .
  
  applicationdatadomainvoc:data-domain skos:definition "The Data Domain Taxonomy is used to to assign technical data stewards in the AI&D organization."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:business-partner skos:definition "The Business Partner domain represents roles, information and activities carried out by parties (e.g. individuals / organizations) playing roles that are involved in the strategic planning, definition, development, operational aspects and all types of contact with Business Partners (e.g. Suppliers, Partners, etc.) with which an enterprise collaborates in order to operate their business. Activities include management of Business Partner: strategies, capabilities, value propositions, relationships, profiles, data, privacy, security, interactions, communications, tenders, agreements, orders, requisitions, supplies, accounts, balances, inventories, reconciliations, service level agreements (SLAs), training, problems, cases, invoices, payments, revenues, disputes, collections, loyalty, performance, usage statistics, analytics and support of Business Partners as they supply, acquire, use, support, purchase, pay for and are supported for goods and services (products) that they provide and / or obtain from an enterprise. A Business Partner is a commercial party with which the Enterprise (i.e. Service Provider) has some form of cooperative alliance. This relationship may range from a formal contractual, exclusive bond in which both parties commit to not ally with third parties, to a loose arrangement of associated parties. Many of the Business Partner Domain information and activities are business partner role-specific specializations of generalized concepts defined within the Foundation Domain"@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:data-domain;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:customer-core skos:definition "Customer Core represents the foundational data and management structures related to the customer's identity, contractual agreements, billing, usage, payment, and collection activities. It focuses on the customer's official profile, financial status, service entitlements, and operational records critical for enabling and sustaining service delivery. This includes: • Customer Profile Management • Account and Contract Management • Billing and Charging Information • Usage and Consumption Tracking • Credit Management and Collections • Customer Analytics & Performance KPI"@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:data-domain;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:customer-experience skos:definition "Customer Experience focuses on the customer's journey, perception, and interactions across all touchpoints with the service provider. It captures customer engagements, reported problems, service or order requests, SLA commitments, satisfaction metrics, and feedback loops. It encompasses: • Interaction and Engagement Management • Customer Problem and Complaint Handling • SLA Monitoring and Performance Tracking • Customer Satisfaction and Feedback Management • Journey Mapping and Experience Analytics"@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:data-domain;
    skos:altLabel "CX"@en;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:enterprise-corporate skos:definition "The Enterprise domain represents roles, information and activities that are required to run and support a business. These concepts focus on both the setting and achieving of strategic corporate goals and objectives, as well as providing those support services that are required throughout an Enterprise. These concepts are sometimes considered to be the corporate functions and/or processes (e.g., Financial Management, Human Resources Management processes, etc.). Since Enterprise Management is aimed at general support within the Enterprise, they may interface as needed with almost every other process in the Enterprise, be they operational, strategy, infrastructure or product processes."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:data-domain;
    skos:altLabel "Enterprise"@en;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:market-sales skos:definition "Represents roles, information and activities pertaining to marketing and sales strategy, capability delivery, lifecycle management and support of parties (e.g. individuals / organizations) that move through sales lifecycle stages (e.g. contact / lead / prospect) as they learn about, inquire, choose, negotiate, order and are supported for goods and services (i.e. products) that are offered by an enterprise. On the Sales side, this includes sales contacts / leads / prospects through to the sales force and sales statistics. Market includes market strategy and plans, market segments, competitors and their products, through to campaign formulation and reporting."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:data-domain;
    skos:altLabel "Market & Sales"@en;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:patterns skos:definition "Includes content that describes common business entities that are to be categorized under other data domains. Only tables & columns should use the pattern domain."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:data-domain;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:product skos:definition "Represents roles, information and activities carried out by parties (e.g. individuals / organizations) playing roles that are involved in the strategic planning, definition, development and operational aspects of Products that are offered. Activities include management of Product: strategies, capabilities, lifecycles, offerings, instances, performance, contract operations, usage statistics and support of goods and services (products) that are offered to customers by an enterprise. Includes products bought by a Customer to the Service Provider & products bought by the Service Provider to Business Partners."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:data-domain;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:resource-network-and-device skos:definition "Represents roles, information and activities carried out by parties (e.g. individuals / organizations) playing roles that are involved in the strategic planning, definition, development and operational aspects of Resources (e.g. functions, applications, computing, networking and storage) that represent the infrastructure of an enterprise that are used to realize Services. The Resource domain includes physical and logical components of the telecom infrastructure that are used to support and deliver services. This includes hardware, software, network elements, and virtual resources such as VNFs and containers, which are provisioned, configured, and managed to enable network services. • Physical resources: Routers, switches, base stations, fiber cables, servers • Logical resources: IP addresses, VLANs, transport tunnels, slices • Virtual resources: Virtual Machines (VMs), containers, SDN-controlled links, virtual routers • Software resources: Network function applications Activities include management of: strategies, capabilities, lifecycles, inventories, topologies, installations, activations, alarms, problems, performance, mediation, usage statistics and support of Resources that are managed by an enterprise."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:data-domain;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:service-network skos:definition "Service (Network) exclusively models network-level services—the technical capabilities directly provisioned, managed, and assured by the telecom infrastructure. These services are infrastructure-facing, not customer-facing, and are used as enablers within products. Scope Includes: • Connectivity services (e.g., 5G access, LTE, broadband, MPLS VPN) • Transport services (e.g., fiber, microwave, DWDM links) • Core services (e.g., voice routing, IMS, EPC) • Network-sliced or virtualized services (e.g., NFV/SDN-based slices)"@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:data-domain;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:shared-reference-data skos:definition "The shared domain includes reference data information that is usable across content areas and describes content that is used across Verizon with the same definition."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:data-domain;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:applied-party-billing-rate skos:definition "The specific rate structure (price, discount, tax) applied to a Business Partner's billed items."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:business-partner;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:business-partner-account skos:definition "The technical record and core attributes for a financial or operational account held by an external Business Partner."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:business-partner;
    skos:related applicationdatadomainvoc:account;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:business-partner-performance skos:definition "Metrics and analytical data representing a Business Partner's operational and financial success (e.g., usage patterns, profitability)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:business-partner;
    skos:related applicationdatadomainvoc:performance;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:business-partner-product-order skos:definition "The data record of a formal communication used by the enterprise to purchase or modify goods/services from a Business Partner."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:business-partner;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:party-bill skos:definition "A preliminary document or record that details all charged items, credits, and the total monetary amount owed to or by a Party (e.g., a Business Partner)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:business-partner;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:party-bill-collection skos:definition "The process data and records related to managing overdue payments, credit violations, and financial recovery actions with a Party."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:business-partner;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:party-interaction skos:definition "The data record of communications and engagements with a Party (individual or organization), and the resulting events (e.g., creating an order or a problem)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:business-partner;
    skos:related applicationdatadomainvoc:business-interaction, applicationdatadomainvoc:communication-interaction;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:party-problem skos:definition "Data records for technical assistance issues or operational problems reported to or by another Party (e.g., a supplier or partner)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:business-partner;
    skos:related applicationdatadomainvoc:trouble-or-problem;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:party-product-specification-and-offering skos:definition
      "Data representing how Parties (playing roles) are involved with defining, procuring, or being billed for Product Specifications and Product Offerings."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:business-partner;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:party-revenue-and-settlement skos:definition "Data related to the distribution of revenue and final monetary settlements with a Party."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:business-partner;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:party-service-level-agreement skos:definition "A data record of the formal contract and performance commitments (SLA) established with a third-party organization (Party)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:business-partner;
    skos:altLabel "Party SLA"@en;
    skos:related applicationdatadomainvoc:agreement;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:party-strategy-and-plan skos:definition "Data assets related to the strategic roadmap, goals, and planning for business relationships with external Parties."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:business-partner;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:account skos:definition "The foundational data structure defining a formal record that tracks financial relationships, services, or resources."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:patterns;
    skos:related applicationdatadomainvoc:business-partner-account;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:performance skos:definition "Data representing a measure of the manner in which a Product, Service, and/or Resource is functioning."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:patterns;
    skos:related applicationdatadomainvoc:business-partner-performance, applicationdatadomainvoc:customer-core-performance,
      applicationdatadomainvoc:customer-experience-performance, applicationdatadomainvoc:marketing-performance,
      applicationdatadomainvoc:product-performance, applicationdatadomainvoc:resource-performance,
      applicationdatadomainvoc:service-performance;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:business-partner-payment skos:definition "The technical record of a transfer of wealth (e.g., payment, funds transfer) between the enterprise and a Business Partner."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:party-bill-collection;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:dunning skos:definition "The technical record of attempts, communications, and actions to collect overdue payments from a customer."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:party-bill-collection, applicationdatadomainvoc:customer-bill-collection;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:customer-bill-collection skos:definition "The process data and records related to managing overdue payments, credit violations, and facility billing audits for a Customer."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:customer-core;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:business-interaction skos:definition "Data representing a generic communication, arrangement, or contract between the enterprise and one or more other entities."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:patterns;
    skos:related applicationdatadomainvoc:party-interaction, applicationdatadomainvoc:communication-interaction,
      applicationdatadomainvoc:interactions;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:communication-interaction skos:definition "Data describing an exchange of information (e.g., call, email, chat) between two or more humans and/or machines."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:shared-reference-data;
    skos:related applicationdatadomainvoc:party-interaction, applicationdatadomainvoc:business-interaction,
      applicationdatadomainvoc:interactions;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:trouble-or-problem skos:definition "Data that collects information describing an operational issue or degradation in an entity (Resource, Service, or Product) that violates an expected SLA."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:patterns;
    skos:related applicationdatadomainvoc:party-problem, applicationdatadomainvoc:customer-problem,
      applicationdatadomainvoc:resource-trouble, applicationdatadomainvoc:service-problem;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:party-role-product-offering skos:definition "Data linking a specific Party Role (e.g., supplier) to the commercial Product Offerings they are involved with."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:party-product-specification-and-offering;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:party-role-product-specification skos:definition "Data linking a specific Party Role (e.g., product developer) to the technical blueprint (Product Specification) they are involved with."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:party-product-specification-and-offering;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:party-revenue-sharing skos:definition "The definition and records of how revenue is distributed among various stakeholders (Parties) based on an agreement."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:party-revenue-and-settlement;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:party-settlement skos:definition "Data representing the final calculated monetary value (pay-out or pay-in) due to or from a Party based on product/service usage or fees."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:party-revenue-and-settlement;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:agreement skos:definition "Data representing a formal contract or arrangement (e.g., service level agreement, price contract) between the enterprise and other entities."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:patterns;
    skos:related applicationdatadomainvoc:party-service-level-agreement, applicationdatadomainvoc:customer-service-level-agreement;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:billing skos:definition "Billing encompasses all aspects of customer invoicing and account management. This includes: Rate Application: Managing the correlation of usage data, applying regulated and non-regulated rates, discounts, and taxes to usage. Invoice Item Generation: Handling real-time and non-real-time call detail records (CDRs) and other data sources to create invoice items. Bill Management: Representing the bill format, scheduling bill production, managing customer invoicing profiles, performing financial calculations to determine the total bill amount (excluding rating and rating discounts), and processing credits and adjustments. Account and Balance Management: Managing customer accounts and their associated balance information. Balances represent monetary or non-monetary amounts (e.g., free minutes, loyalty points) indicating the financial relationship between the service provider and the customer, including pre-paid balances, post-paid accounts receivable, and other credit or debt scenarios."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:customer-core;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:customer-core-performance skos:definition "Customer Core Performance represent the analytical data and metrics derived from the customer’s financial, contractual, and operational activities. These statistics provide insights into customer usage patterns, billing trends, account behavior, credit status, and payment history. Examples Include: • Monthly data usage per customer segment • Average bill amount and payment delay rates • Churn probability based on billing irregularities • Number of active vs. dormant accounts • Collection success rate by region or segment"@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:customer-core;
    skos:related applicationdatadomainvoc:performance;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:customer-usage skos:definition "Customer Usage holds detailed records of how individual customers consume telecom services and products over time. It captures quantitative usage events such as data consumption, voice minutes, SMS, or other measurable activities linked to subscribed services or products. This information is critical for rating, billing, usage analytics, and customer profiling. In addition to core telecom usage, Customer Usage also tracks detailed consumption of service-layer offerings such as content streaming, cloud storage, gaming, and value-added services. These records help assess service performance, enable usage-based pricing, and support targeted customer engagement."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:customer-core;
    skos:related applicationdatadomainvoc:usage;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:profile skos:definition "A customer profile is a detailed description of a customer or group of customers, encompassing their demographics, behaviors, interests, and needs. Information included: Demographics: Age, gender, location, income, education, occupation, etc. Behavioral: Churn score, Channel Preference, Purchase history, website usage, social media engagement, etc."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:customer-core;
    skos:altLabel "Customer Profile"@en;
    skos:related applicationdatadomainvoc:party-profile;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:applied-customer-billing-rate-specification skos:definition
      "The detailed configuration or template for the billing rate (price, discount, tax) applied to a Customer's usage or subscribed items."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:billing;
    skos:altLabel "Applied Customer Billing Rate Spec"@en;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:customer-billing-statistic skos:definition "Aggregated and derived data (metrics) calculated from Customer Bill records for analysis and reporting."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:billing;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:customer-payment skos:definition "The technical record of a transfer of wealth (e.g., payment) received from a Customer for products or usage."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:customer-bill-collection;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:usage skos:definition "An occurrence record of employing a product, service, or resource for its intended purpose, which is of business interest and potentially chargeable."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:patterns;
    skos:related applicationdatadomainvoc:customer-usage, applicationdatadomainvoc:product-usage,
      applicationdatadomainvoc:resource-usage;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:party-profile skos:definition "Data defining the characteristics used to group Parties to typify market segments and target marketing campaigns."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:party;
    skos:related applicationdatadomainvoc:profile;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:customer-bill-inquiry skos:definition "Represents invoice inquiries associated with invoices sent to customers and handles disputes and adjustments on individual charges, invoices, and accounts. A request for information about a statement of money owed by a customer."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:customer-experience;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:customer-experience-performance skos:definition "Customer Experience Statistics reflect the measurements and trends related to customer interactions, perceptions, and satisfaction across all service channels and touchpoints. These statistics help evaluate service quality, responsiveness, and overall customer sentiment."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:customer-experience;
    skos:example """
• Average response time to customer complaints 
• Net Promoter Score (NPS) by product type 
• Volume of service issues reported per month 
• SLA breach rate by service or region 
• CSAT scores after support interactions"""@en;
    skos:related applicationdatadomainvoc:performance;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:customer-problem skos:definition "The data record for technical assistance and operational problem handling reported by or for a Customer."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:customer-experience;
    skos:related applicationdatadomainvoc:trouble-or-problem;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:customer-product-order skos:definition "The data record of a formal communication used by a Customer to procure, update, or remove one or many products."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:customer-experience;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:customer-service-level-agreement skos:definition "A data record of the formal contract and performance commitments (SLA) specifically established with a Customer."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:customer-experience;
    skos:altLabel "Customer SLA"@en;
    skos:related applicationdatadomainvoc:agreement;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:interactions skos:definition "The data record of communications with customers and the technical translation of those communications into system events (e.g., orders, inquiries, problems)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:customer-experience;
    skos:altLabel "Customer Interactions"@en;
    skos:related applicationdatadomainvoc:business-interaction, applicationdatadomainvoc:communication-interaction;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:sales-quote skos:definition "A document or record provided to a prospective customer (Prospect) detailing the cost and validity period for purchasing specific Products."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:customer-product-order;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:sales-quote-specification skos:definition "The technical blueprint or template that defines the structure, format, and common characteristics of a Sales Quote."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:customer-product-order;
    skos:altLabel "Sales Quote Spec"@en;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:enterprise-effectiveness skos:definition "Data used to measure and evaluate the overall success and efficiency of the enterprise, such as business objectives and process KPIs."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:enterprise-corporate;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:enterprise-party-roles skos:definition "Data defining the roles that different Parties play within the Enterprise (Corporate) domain."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:enterprise-corporate;
    skos:related applicationdatadomainvoc:party-roles;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:enterprise-risk skos:definition "Represents all items that relate to risk of an enterprise. It also concerns security vulnerabilities and operational capability to resolve any detected degradations and violations"@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:enterprise-corporate;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:finance skos:definition "Data assets describing all financial aspects of the enterprise, such as financial accounts, general ledgers, and accounting entries."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:enterprise-corporate;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:revenue-assurance skos:definition "Data controls, violations, and KPIs used to ensure accurate revenue capture and reconciliation across all business processes."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:enterprise-corporate;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:workforce skos:definition "Data modeling field resource management, including human and non-human field assets, their roles, skills, schedules, and work order assignments."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:enterprise-corporate;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:party-roles skos:definition "Data encompassing the various categories of functions or responsibilities a Party may play across all domains (e.g., Customer, Partner, Employee)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:shared-reference-data;
    skos:related applicationdatadomainvoc:enterprise-party-roles, applicationdatadomainvoc:product-party-roles;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:enterprise-security skos:definition "Data records related to security vulnerabilities, security events, and the operational capability to resolve detected degradations or violations."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:enterprise-risk;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:employee-pay skos:definition "The detailed data (e.g., pay grades, ranges, components) that defines an employee's compensation structure."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:workforce;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:work-specification skos:definition "The technical blueprint or definition for a specific type of work (e.g., installation, repair) that can be manually performed by a technician."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:workforce;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:workforce-resource skos:definition "Data representing the employees and other non-human assets specifically involved in field operational tasks."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:workforce;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:workforce-schedule skos:definition "Data defining the planning, reservation, and assignment of a technician or resource to a specific task or time slot."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:workforce;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:competitor skos:definition "Data used to identify, profile, and track other providers operating in the same market segments."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:market-sales;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:market-and-sales-strategy-plan skos:definition "Data assets related to the long-term business plans and strategies for market presence, product focus, and sales channels."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:market-sales;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:market-sales-forecast skos:definition "Data representing predictions and projections for future market demand, sales volume, new service requirements, and customer needs."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:market-sales;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:market-segment skos:definition "Data used to define and describe subsets of the market (e.g., based on demographics, behavior) for targeted marketing and sales efforts."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:market-sales;
    skos:altLabel "Market Segmentation"@en;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:marketing-campaign skos:definition "Data representing the strategy, plan, target market, and execution assets for promoting a product offering."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:market-sales;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:marketing-performance skos:definition "Data used to define performance objectives and measured indicators (KPIs) related to the effectiveness of marketing and sales activities."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:market-sales;
    skos:related applicationdatadomainvoc:performance;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:sales-channel skos:definition "Data structures for tracking distribution channels, sales activities, quotas, commission plans, and the sales force organization."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:market-sales;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:sales-commission skos:definition "Data entities used to define the rules, calculation, and applied amounts of commissions for sales agents or employees."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:market-sales;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:sales-lead-and-opportunity skos:definition "Data used to track potential customers (Leads) through the sales lifecycle, including proposals and the potential revenue pipeline."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:market-sales;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:competitor-intelligence skos:definition "Factual data gathered and analyzed about a competitor's plans, products, financial status, and market activities."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:competitor;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:competitor-product-correlation skos:definition "Data representing a comparison or mapping between the enterprise's Product Offerings and a competitor's product offerings."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:competitor;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:anomaly skos:definition "A group of business entities representing a deviation or abnormality in an entity's behavior or data, managed against a defined specification."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:patterns;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:base-types skos:definition "Data representing simple, non-identity-based objects (e.g., monetary amounts, date ranges) used as core data attributes across the model."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:patterns;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:capacity skos:definition "Data representing the ability to provide a certain capability (e.g., bandwidth, storage) for products, services, and resources over time."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:patterns;
    skos:related applicationdatadomainvoc:product-capacity, applicationdatadomainvoc:resource-capacity,
      applicationdatadomainvoc:service-capacity;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:catalog skos:definition "A generalized data structure used to provide consistency and federation across specifications and entities for products, services, and resources."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:patterns;
    skos:related applicationdatadomainvoc:product-catalog, applicationdatadomainvoc:resource-catalog,
      applicationdatadomainvoc:service-catalog;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:closed-loop skos:definition "A \"management framework\" data set where current outcomes are used as feedback to continually optimize and improve future outcomes."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:patterns;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:configuration-and-profiling skos:definition "Data defining how a resource, service, or product operates or functions in terms of its technical settings and characteristics."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:patterns;
    skos:related applicationdatadomainvoc:product-configuration, applicationdatadomainvoc:resource-configuration,
      applicationdatadomainvoc:service-configuration;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:event skos:definition "Data entities used to represent and record occurrences or changes within systems (e.g., state change, data receipt)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:patterns;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:goal skos:definition "Data representing a definition of a target or objective for a process, activity, or workflow to reach or achieve."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:patterns;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:intent skos:definition "Data entities required for specifying the basic attributes and relationships that describe a desired business or technical outcome."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:patterns;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:metric skos:definition "Data defining a standard of measurement, including units, values, calculation methods, and thresholds for evaluation."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:patterns;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:policy skos:definition "Layered data entities that define specifications and definitions used to manage the behavior, configuration, and change of other entities."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:patterns;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:project skos:definition "Data used by project managers to plan, schedule, and track work, ensuring quality, cost, and time objectives are met."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:patterns;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:root-business-entities skos:definition "A set of foundational data entities that provide coherence by linking entities from different domains."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:patterns;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:segmentation skos:definition "Data entities used to specify the rules and criteria for dividing a large set of entity instances (e.g., customers) into smaller subsets."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:patterns;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:test skos:definition "Data representing a procedure or method intended to establish the quality, performance, or reliability of an entity (product, service, or resource)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:patterns;
    skos:related applicationdatadomainvoc:product-test, applicationdatadomainvoc:resource-test,
      applicationdatadomainvoc:service-test;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:topology skos:definition "Data modeling the pairwise relationships (graphs) between objects, often used to represent network connectivity and structure."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:patterns;
    skos:related applicationdatadomainvoc:resource-topology;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:trouble-ticket skos:definition "A data record used for reporting, tracking, and managing the resolution process of a Trouble or Problem."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:patterns;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:workflow skos:definition "A business process model data structure composed of a sequence of activities that collectively achieve a specified objective."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:patterns;
    owl:versionInfo "0.1.0" .
  
  applicationdatadomainvoc:commitment skos:definition "Data representing a mutual agreement between parties regarding a specific deliverable (service, product, resource)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:agreement .
  
  applicationdatadomainvoc:base-types-example skos:definition "Data illustrating how simple Base Type entities are utilized as attributes within other entities."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:base-types .
  
  applicationdatadomainvoc:disputed-amount skos:definition "A data record of a request from an external party (e.g., Customer) to change or challenge a required payment amount."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:business-interaction .
  
