commercialopsvoc:territory
  a skos:Concept ;
  rdfs:label "territory"@en ;
  skos:prefLabel "territory"@en ;
  skos:definition "An assignment of accounts, geographies or segments to the parties responsible for pursuing them."@en ;
  skos:scopeNote "A commercial assignment, not a jurisdiction: a territory may follow geography but is defined by the organization."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-commercial-operations/> ;
