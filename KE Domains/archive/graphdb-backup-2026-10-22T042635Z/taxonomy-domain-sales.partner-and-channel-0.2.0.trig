  <https://www.insperity.com/taxonomy/domain-sales.partner-and-channel/> a skos:ConceptScheme;
    rdfs:label "Domain Sales.Partner & Channel Taxonomy"@en;
    skos:prefLabel "Domain Sales.Partner & Channel Taxonomy"@en;
