pricingcontractsvoc:class-code
  a skos:Concept ;
  rdfs:label "class code"@en ;
  skos:prefLabel "class code"@en ;
  skos:definition "A code that classifies a worker's occupation by its workers' compensation risk and sets the rate applied to that worker's pay."@en ;
  skos:scopeNote "A multiword lexical unit (Baseline decision 3)."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-pricing-and-contracts/> ;
  skos:topConceptOf <https://www.insperity.com/vocabulary/domain-pricing-and-contracts/> ;
