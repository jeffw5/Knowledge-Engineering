  domainsalestax:prospecting
    a skos:Concept ;
    rdfs:label "Prospecting"@en ;
    skos:prefLabel "Prospecting"@en ;
    skos:definition "A selling activity that searches for parties that fit the ideal customer profile."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/> ;
    skos:broader domainsalestax:selling-activity ;
    core:hasPrimaryTerm domainsalesvoc:prospecting ;
