    dct:created "2026-10-17T01:38:18Z"^^xsd:dateTime ;
    dct:modified "2026-10-18T00:25:49Z"^^xsd:dateTime .

  assettax:DocumentStore
    a skos:Concept ;
    rdfs:label "Document store"@en ;
    skos:prefLabel "Document store"@en ;
    skos:definition "A data store that stores semi-structured documents."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/core-asset/> ;
