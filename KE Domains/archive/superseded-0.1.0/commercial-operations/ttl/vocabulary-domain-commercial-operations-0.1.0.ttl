  dct:created "2026-10-20"^^xsd:date ;
  dct:modified "2026-10-20T00:16:35Z"^^xsd:dateTime .

commercialopsvoc:professional-employer-organization
  a skos:Concept ;
  rdfs:label "professional employer organization"@en ;
  skos:prefLabel "professional employer organization"@en ;
  skos:altLabel "PEO"@en ;
  skos:definition "An organization that enters a co-employment relationship with a client and takes on employer responsibilities such as payroll, benefits, employment taxes and workers' compensation for the client's worksite employees."@en ;
  skos:scopeNote "A multiword lexical unit (Baseline decision 3)."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-commercial-operations/> ;
  skos:topConceptOf <https://www.insperity.com/vocabulary/domain-commercial-operations/> ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-20"^^xsd:date ;
  dct:modified "2026-10-20T00:16:35Z"^^xsd:dateTime .

commercialopsvoc:administrative-services-organization
  a skos:Concept ;
  rdfs:label "administrative services organization"@en ;
  skos:prefLabel "administrative services organization"@en ;
  skos:altLabel "ASO"@en ;
  skos:definition "An organization that provides human resources, payroll and benefits administration to a client without entering a co-employment relationship."@en ;
  skos:scopeNote "A multiword lexical unit (Baseline decision 3)."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-commercial-operations/> ;
  skos:topConceptOf <https://www.insperity.com/vocabulary/domain-commercial-operations/> ;
