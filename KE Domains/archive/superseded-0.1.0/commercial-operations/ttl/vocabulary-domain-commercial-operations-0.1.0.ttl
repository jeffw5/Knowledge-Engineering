commercialopsvoc:unemployment
  a skos:Concept ;
  rdfs:label "unemployment"@en ;
  skos:prefLabel "unemployment"@en ;
  skos:definition "The condition of a person who is able and available to work but has no job."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-commercial-operations/> ;
  skos:topConceptOf <https://www.insperity.com/vocabulary/domain-commercial-operations/> ;
