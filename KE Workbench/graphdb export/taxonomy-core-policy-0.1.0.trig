<https://www.insperity.com/taxonomy/core-policy/> {
  <https://www.insperity.com/taxonomy/core-policy/> a skos:ConceptScheme;
    rdfs:label "Core policy taxonomy"@en;
    skos:prefLabel "Core policy taxonomy"@en;
    skos:hasTopConcept <https://www.insperity.com/taxonomy/core-policy/contractual-instrument>,
      <https://www.insperity.com/taxonomy/core-policy/guideline>, <https://www.insperity.com/taxonomy/core-policy/legal-norm-source>,
      <https://www.insperity.com/taxonomy/core-policy/norm>, <https://www.insperity.com/taxonomy/core-policy/organizational-policy>,
      <https://www.insperity.com/taxonomy/core-policy/procedure>, <https://www.insperity.com/taxonomy/core-policy/standard>;
    terms:description "Classification of policies and other normative sources, the governing statements that impose obligations, permissions, and prohibitions on parties and process steps."@en;
    terms:title "Core policy taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2026-10-14"^^xsd:dateTime;
    skos:altLabel "Policy taxonomy"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/taxonomy/core-policy/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-policy/contractual-instrument> a skos:Concept;
    skos:prefLabel "Contractual instrument"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A policy that arises from an agreement between parties and binds them to its terms."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-policy/>;
    skos:altLabel "Agreement"@en, "Contract"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-policy/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-policy/client-service-agreement>,
      <https://www.insperity.com/taxonomy/core-policy/data-processing-agreement>, <https://www.insperity.com/taxonomy/core-policy/plan-document>,
      <https://www.insperity.com/taxonomy/core-policy/service-level-agreement>, <https://www.insperity.com/taxonomy/core-policy/terms-of-service> .
  
  <https://www.insperity.com/taxonomy/core-policy/guideline> a skos:Concept;
    skos:prefLabel "Guideline"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A policy that recommends good practice without mandating it."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-policy/>;
    skos:altLabel "Best practice"@en, "Guidance note"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-policy/> .
  
  <https://www.insperity.com/taxonomy/core-policy/legal-norm-source> a skos:Concept;
    skos:prefLabel "Legal norm source"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A policy issued by a public authority with the force of law."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-policy/>;
    skos:altLabel "Legal source"@en, "Regulatory source"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-policy/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-policy/agency-guidance>, <https://www.insperity.com/taxonomy/core-policy/court-decision>,
      <https://www.insperity.com/taxonomy/core-policy/executive-order>, <https://www.insperity.com/taxonomy/core-policy/regulation>,
      <https://www.insperity.com/taxonomy/core-policy/statute> .
  
  <https://www.insperity.com/taxonomy/core-policy/norm> a skos:Concept;
    skos:prefLabel "Norm"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A policy statement that qualifies an action or state as obligatory, permitted, or prohibited for a party in a jurisdiction and period."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-policy/>;
    skos:altLabel "Deontic statement"@en, "Legal norm"@en;
    skos:scopeNote "Norms link to steps with governedBy and to their source with a source relation; each has a jurisdiction and effective period."@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-policy/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-policy/obligation>, <https://www.insperity.com/taxonomy/core-policy/permission>,
      <https://www.insperity.com/taxonomy/core-policy/prohibition>, <https://www.insperity.com/taxonomy/core-policy/right> .
  
  <https://www.insperity.com/taxonomy/core-policy/organizational-policy> a skos:Concept;
    skos:prefLabel "Organizational policy"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A policy issued by an organization to govern its own conduct and that of its workers and agents."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-policy/>;
    skos:altLabel "Company policy"@en, "Internal policy"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-policy/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-policy/acceptable-use-policy>,
      <https://www.insperity.com/taxonomy/core-policy/code-of-conduct>, <https://www.insperity.com/taxonomy/core-policy/data-classification-policy>,
      <https://www.insperity.com/taxonomy/core-policy/financial-control-policy>, <https://www.insperity.com/taxonomy/core-policy/information-security-policy>,
      <https://www.insperity.com/taxonomy/core-policy/privacy-policy>, <https://www.insperity.com/taxonomy/core-policy/records-retention-policy>,
      <https://www.insperity.com/taxonomy/core-policy/responsible-artificial-intelligence-policy>,
      <https://www.insperity.com/taxonomy/core-policy/workforce-policy> .
  
  <https://www.insperity.com/taxonomy/core-policy/procedure> a skos:Concept;
    skos:prefLabel "Procedure"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A policy that specifies the steps to carry out an activity in a consistent way."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-policy/>;
    skos:altLabel "SOP"@en, "Standard operating procedure"@en, "Work instruction"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-policy/> .
  
  <https://www.insperity.com/taxonomy/core-policy/standard> a skos:Concept;
    skos:prefLabel "Standard"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A policy that is a documented agreement on specifications or practices adopted voluntarily or by reference."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-policy/>;
    skos:altLabel "Specification"@en;
    owl:versionInfo "0.1.0";
