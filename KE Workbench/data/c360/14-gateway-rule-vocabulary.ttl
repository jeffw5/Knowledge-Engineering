grule:traceable a skos:Concept ;
    rdfs:label "Traceable"@en ;
    skos:prefLabel "Traceable"@en ;
    skos:definition "A gateway rule requiring the request to trace to at least one desired outcome, its job, a persona and a service."@en ;
    skos:notation "1" ;
    skos:inScheme <https://www.insperity.com/vocabulary/gateway-rule/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/gateway-rule/> .

grule:reviewed a skos:Concept ;
    rdfs:label "Reviewed"@en ;
    skos:prefLabel "Reviewed"@en ;
    skos:definition "A gateway rule requiring every targeted outcome to be accepted in the business and compliance review."@en ;
    skos:notation "2" ;
    skos:inScheme <https://www.insperity.com/vocabulary/gateway-rule/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/gateway-rule/> .

grule:evidenced a skos:Concept ;
    rdfs:label "Evidenced"@en ;
    skos:prefLabel "Evidenced"@en ;
    skos:definition "A gateway rule requiring each targeted outcome to show real unmet need, an opportunity of at least ten or a significant gap."@en ;
    skos:notation "3" ;
    skos:inScheme <https://www.insperity.com/vocabulary/gateway-rule/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/gateway-rule/> .

grule:measurable a skos:Concept ;
    rdfs:label "Measurable"@en ;
    skos:prefLabel "Measurable"@en ;
    skos:definition "A gateway rule requiring an acceptance criterion and a target score for every targeted outcome."@en ;
    skos:notation "4" ;
    skos:inScheme <https://www.insperity.com/vocabulary/gateway-rule/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/gateway-rule/> .

grule:owned a skos:Concept ;
    rdfs:label "Owned"@en ;
    skos:prefLabel "Owned"@en ;
    skos:definition "A gateway rule requiring a service-line theme accountable for delivering the request."@en ;
    skos:notation "5" ;
    skos:inScheme <https://www.insperity.com/vocabulary/gateway-rule/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/gateway-rule/> .

grule:unflagged a skos:Concept ;
    rdfs:label "Unflagged"@en ;
    skos:prefLabel "Unflagged"@en ;
    skos:definition "A gateway rule requiring that no compliance risk flag on a targeted outcome is left unresolved."@en ;
    skos:notation "6" ;
    skos:inScheme <https://www.insperity.com/vocabulary/gateway-rule/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/gateway-rule/> .
