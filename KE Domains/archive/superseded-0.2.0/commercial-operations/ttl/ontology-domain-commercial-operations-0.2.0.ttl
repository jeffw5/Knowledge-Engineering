  a owl:Class ;
  rdfs:label "Competitor"@en ;
  skos:prefLabel "Competitor"@en ;
  skos:definition "A role borne by an organization that offers buyers an alternative to the organization's offerings for the same job."@en ;
  rdfs:subClassOf [
      a owl:Restriction ;
