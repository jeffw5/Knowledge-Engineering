gstat:draft a skos:Concept ;
    rdfs:label "Draft"@en ;
    skos:prefLabel "Draft"@en ;
    skos:definition "A gateway status for a demand request that is still being written and has not been checked."@en ;
    skos:notation "1" ;
    skos:inScheme <https://www.insperity.com/vocabulary/gateway-status/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/gateway-status/> .

gstat:held a skos:Concept ;
    rdfs:label "Held"@en ;
    skos:prefLabel "Held"@en ;
    skos:definition "A gateway status for a demand request that failed at least one required gateway check."@en ;
    skos:notation "2" ;
    skos:inScheme <https://www.insperity.com/vocabulary/gateway-status/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/gateway-status/> .

gstat:admitted a skos:Concept ;
    rdfs:label "Admitted"@en ;
    skos:prefLabel "Admitted"@en ;
    skos:definition "A gateway status for a demand request that passed every required check and entered demand planning."@en ;
    skos:notation "3" ;
    skos:inScheme <https://www.insperity.com/vocabulary/gateway-status/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/gateway-status/> .

gstat:delivered a skos:Concept ;
    rdfs:label "Delivered"@en ;
    skos:prefLabel "Delivered"@en ;
    skos:definition "A gateway status for a demand request whose change has shipped and awaits re-measurement of its outcomes."@en ;
    skos:notation "4" ;
    skos:inScheme <https://www.insperity.com/vocabulary/gateway-status/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/gateway-status/> .
