      servicesvoc:define-target-operating-model .
  
  servicesvoc:preventive-controls skos:narrower servicesvoc:digital-asset-inventory-onboarding,
      servicesvoc:digital-assets-order-management, servicesvoc:lifecycle-management, servicesvoc:product-certification,
      servicesvoc:third-party-data-sharing .
  
  servicesvoc:exception-monitoring skos:narrower servicesvoc:access-management, servicesvoc:approval-management,
      servicesvoc:onboarding-management .
  
  servicesvoc:digital-asset-inventory-onboarding skos:narrower servicesvoc:catalog-services,
      servicesvoc:certification-services, servicesvoc:classification-services, servicesvoc:enrichment-services,
      servicesvoc:profiling-services .
  
  servicesvoc:digital-assets-order-management skos:narrower servicesvoc:digital-assets-order-entry,
      servicesvoc:digital-assets-order-fulfillment, servicesvoc:search-and-discovery .
}
