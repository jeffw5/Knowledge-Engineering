  assettax:MachineLearningModel
    a skos:Concept ;
    rdfs:label "Machine learning model"@en ;
    skos:prefLabel "Machine learning model"@en ;
    skos:altLabel "LLM"@en , "Language model"@en , "Large language model"@en , "Model"@en ;
    skos:definition "A software asset that is a trained statistical model producing predictions or generated content from inputs."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/core-asset/> ;
