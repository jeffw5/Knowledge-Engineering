#!/bin/bash
# Saves each leftover GraphDB graph as TriG in KE Baseline/graphdb-backup-2026-10-18/ before it is dropped.
REPO="${1:-value-kb}"; GDB="${GRAPHDB_URL:-http://localhost:7200}"
cd "$(dirname "$0")"; OUT=graphdb-backup-2026-10-18; mkdir -p "$OUT"
curl -sf -G "$GDB/repositories/$REPO/statements" --data-urlencode 'context=<https://www.insperity.com/ontology/core-asset/>' -H 'Accept: application/trig' -o "$OUT/ontology-core-asset.trig" && echo "saved ontology-core-asset.trig" || echo "FAILED ontology/core-asset/"
curl -sf -G "$GDB/repositories/$REPO/statements" --data-urlencode 'context=<https://www.insperity.com/taxonomy/application-business-taxonomy/>' -H 'Accept: application/trig' -o "$OUT/taxonomy-application-business-taxonomy.trig" && echo "saved taxonomy-application-business-taxonomy.trig" || echo "FAILED taxonomy/application-business-taxonomy/"
