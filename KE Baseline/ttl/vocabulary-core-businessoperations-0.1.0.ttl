voc:operations
  a skos:Concept ;
  skos:prefLabel "Operations"@en ;
  skos:definition "The transformation of inputs into outputs (i.e., the production process)."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/> ;
