<https://www.insperity.com/ontology/commercial-operations/> {
  <https://www.insperity.com/ontology/commercial-operations/> a owl:Ontology;
    rdfs:label "Commercial Operations Ontology"@en;
    skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en;
    terms:description "The container ontology of the Commercial Operations operational area. It extends the core domain ontology with the classes every commercial domain shares (account, lead, opportunity, proposal, client service agreement, clause, competitor, worksite employee, sale), so that the sales, marketing, legal, customer success, pricing and contracts, and partner and channel ontologies import only the core and this ontology, never each other."@en;
    terms:title "Commercial Operations Ontology"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_commercial_operations.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.2.0 (2026-10-20): Census moved here from pricing and contracts, because sales and pricing and contracts both use it (D2); the container holds the PEO buyer persona graph that every domain addresses. Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_commercial_operations.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.3.0 (2026-10-20): Supplier and customer of a process step (has supplier, has customer) for the SIPOCM view of assembled processes (D24), with a shape that checks they point to a party or a role. Built by build_domains.py from spec_commercial_operations.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.4.0 (2026-10-21): Restructured to the operational areas and the naming standard (D26, D27): titled 'Commercial Operations Vocabulary', '… Taxonomy', '… Ontology' and '… Shapes', at …/<kind>/commercial-operations/ (formerly …/<kind>/domain-commercial-operations/). The client service agreement, commercial agreement and clause (classes, concepts and the clause primitive) moved to Domain Legal in Business Operations. A taxonomy branch lists the area's domains. Built by build_domains.py from spec_commercial_operations.py against Baseline Core v1.0 (core 0.1.0)."@en;
    terms:created "2026-10-22"^^xsd:date;
    owl:versionInfo "0.4.0";
    terms:subject domainvoc:commercial;
    owl:imports <https://www.insperity.com/ontology/core/>;
    owl:versionIRI <https://www.insperity.com/ontology/commercial-operations/0.4.0/>;
    vaem:namespace "https://www.insperity.com/ontology/commercial-operations/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft;
    vann:preferredNamespacePrefix "commercialops";
    terms:publisher <https://www.insperity.com/resource/core/Organization/insperity>;
    terms:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/>, <http://purl.obolibrary.org/obo/bfo/2020/bfo.owl>;
    terms:identifier "ontology-commercial-operations";
    terms:requires <https://www.insperity.com/ontology/core/0.1.0/>;
    terms:replaces <https://www.insperity.com/ontology/commercial-operations/> .
  
  <https://www.insperity.com/ontology/commercial-operations/account> a owl:Class;
    rdfs:subClassOf core:information-asset, _:node12025;
    rdfs:label "Account"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/commercial-operations/>;
    skos:prefLabel "Account"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "An information asset that records the commercial relationship between the organization and a party that is, or may become, a client."@en;
    owl:versionInfo "0.4.0";
    terms:subject <https://www.insperity.com/vocabulary/commercial-operations/account>;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm <https://www.insperity.com/vocabulary/commercial-operations/account> .
  
  _:node12025 a owl:Restriction;
    owl:onProperty core:concerns;
    owl:someValuesFrom core:party .
  
  <https://www.insperity.com/ontology/commercial-operations/lead> a owl:Class;
    rdfs:subClassOf core:information-asset, _:node12026;
    rdfs:label "Lead"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/commercial-operations/>;
    skos:prefLabel "Lead"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "An information asset that records a party, or a person at a party, that has shown interest in or fits the profile for the organization's offerings and has not yet been qualified."@en;
    owl:versionInfo "0.4.0";
    terms:subject <https://www.insperity.com/vocabulary/commercial-operations/lead>;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm <https://www.insperity.com/vocabulary/commercial-operations/lead> .
  
  _:node12026 a owl:Restriction;
    owl:onProperty core:concerns;
    owl:someValuesFrom core:party .
  
  <https://www.insperity.com/ontology/commercial-operations/opportunity> a owl:Class;
    rdfs:subClassOf core:information-asset, _:node12027, _:node12028, _:node12029;
    rdfs:label "Opportunity"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/commercial-operations/>;
    skos:prefLabel "Opportunity"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "An information asset that records a potential sale of one or more offerings to a prospect or client that the organization has qualified and is pursuing."@en;
    skos:scopeNote "The opportunity is the record; the selling steps that advance it consume and produce it (core:consumes, core:produces), so its history stays anchored on the process step."@en;
    owl:versionInfo "0.4.0";
    terms:subject <https://www.insperity.com/vocabulary/commercial-operations/opportunity>;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm <https://www.insperity.com/vocabulary/commercial-operations/opportunity> .
  
  _:node12027 a owl:Restriction;
    owl:onProperty core:concerns;
    owl:someValuesFrom core:party .
  
  _:node12028 a owl:Restriction;
    owl:onProperty core:concerns;
    owl:someValuesFrom core:offering .
  
  _:node12029 a owl:Restriction;
    owl:onProperty <https://www.insperity.com/ontology/commercial-operations/attributedTo>;
    owl:allValuesFrom core:party .
  
  <https://www.insperity.com/ontology/commercial-operations/attributedTo> a owl:ObjectProperty;
    rdfs:subPropertyOf core:concerns;
    rdfs:label "attributed to"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/commercial-operations/>;
    skos:prefLabel "attributed to"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A relation between a lead, opportunity or sale and the party credited with sourcing or influencing it."@en;
    skos:scopeNote "The campaign or channel credited is reached through the process step the party performed."@en;
    owl:versionInfo "0.4.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/ontology/commercial-operations/proposal> a owl:Class;
    rdfs:subClassOf core:information-asset, _:node12030;
    rdfs:label "Proposal"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/commercial-operations/>;
    skos:prefLabel "Proposal"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "An information asset that sets out the offerings, terms and prices the organization offers a prospect or client in pursuit of an opportunity."@en;
    owl:versionInfo "0.4.0";
    terms:subject <https://www.insperity.com/vocabulary/commercial-operations/proposal>;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm <https://www.insperity.com/vocabulary/commercial-operations/proposal> .
  
  _:node12030 a owl:Restriction;
    owl:onProperty core:concerns;
    owl:someValuesFrom <https://www.insperity.com/ontology/commercial-operations/opportunity> .
  
  <https://www.insperity.com/ontology/commercial-operations/census> a owl:Class;
    rdfs:subClassOf core:information-asset, _:node12031;
    rdfs:label "Census"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/commercial-operations/>;
    skos:prefLabel "Census"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "An information asset that lists a prospective client's employees with the attributes needed to price benefits and coverage."@en;
    skos:scopeNote "Holds personal information about the employees it lists; its handling is governed by the data protection and retention norms of the legal domain."@en;
    owl:versionInfo "0.4.0";
    terms:subject <https://www.insperity.com/vocabulary/commercial-operations/census>;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm <https://www.insperity.com/vocabulary/commercial-operations/census> .
  
  _:node12031 a owl:Restriction;
    owl:onProperty core:concerns;
    owl:someValuesFrom core:person .
  
  <https://www.insperity.com/ontology/commercial-operations/competitor> a owl:Class;
    rdfs:subClassOf core:role, _:node12032;
    rdfs:label "Competitor"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/commercial-operations/>;
    skos:prefLabel "Competitor"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A role borne by an organization that offers buyers an alternative to the organization's offerings for the same job."@en;
    owl:versionInfo "0.4.0";
    terms:subject <https://www.insperity.com/vocabulary/commercial-operations/competitor>;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm <https://www.insperity.com/vocabulary/commercial-operations/competitor> .
  
  _:node12032 a owl:Restriction;
    owl:onProperty core:roleOf;
    owl:someValuesFrom core:organization .
  
  <https://www.insperity.com/ontology/commercial-operations/worksite-employee> a owl:Class;
    rdfs:subClassOf core:role, _:node12033;
    rdfs:label "Worksite employee"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/commercial-operations/>;
    skos:prefLabel "Worksite employee"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A role borne by a person employed at a client's worksite under a co-employment relationship between the client and a professional employer organization."@en;
    skos:altLabel "WSE"@en;
    skos:scopeNote "The unit in which a professional employer organization sizes opportunities, prices services and counts paid worksite employees. Formalizes core taxonomy-core-role \"Worksite employee\"."@en;
    owl:versionInfo "0.4.0";
    terms:subject rolevoc:employee;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm rolevoc:employee .
  
  _:node12033 a owl:Restriction;
    owl:onProperty core:roleOf;
    owl:someValuesFrom core:person .
  
  <https://www.insperity.com/ontology/commercial-operations/sale> a owl:Class;
    rdfs:subClassOf core:event, _:node12034;
    rdfs:label "Sale"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/commercial-operations/>;
    skos:prefLabel "Sale"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "An event in which a buyer commits to acquire an offering from the organization under an agreement."@en;
    owl:versionInfo "0.4.0";
    terms:subject <https://www.insperity.com/vocabulary/commercial-operations/sale>;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm <https://www.insperity.com/vocabulary/commercial-operations/sale> .
  
  _:node12034 a owl:Restriction;
    owl:onProperty core:triggers;
    owl:allValuesFrom core:process-step .
  
  <https://www.insperity.com/ontology/commercial-operations/hasSupplier> a owl:ObjectProperty;
    rdfs:subPropertyOf obo:RO_0000057;
    rdfs:label "has supplier"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/commercial-operations/>;
    skos:prefLabel "has supplier"@en;
    skos:editorialNote "Candidate for promotion to the core: supplier is the S of SIPOC and applies to every process, not only commercial ones; the core has consumes and produces but no supplier."@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A relation between a process step and a party, or a role, outside the process that provides one of the inputs the step consumes."@en;
    skos:scopeNote "Stated only for suppliers outside the assembled process, such as the prospect who sends its census. Inside a process, the supplier of an input is derived: whoever performs the step that produces it (D24). Specializes has participant: the supplier takes part in the step at its boundary, by handing over the input."@en;
    owl:versionInfo "0.4.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/ontology/commercial-operations/hasCustomer> a owl:ObjectProperty;
    rdfs:subPropertyOf obo:RO_0000057;
    rdfs:label "has customer"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/commercial-operations/>;
    skos:prefLabel "has customer"@en;
    skos:editorialNote "Candidate for promotion to the core: customer is the C of SIPOC and applies to every process, not only commercial ones; the core has consumes and produces but no customer."@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A relation between a process step and a party, or a role, outside the process that receives one of the outputs the step produces."@en;
    skos:scopeNote "Stated only for customers outside the assembled process, such as the prospect a cost comparison is handed to. Inside a process, the customer of an output is derived: whoever performs the step that consumes it (D24). Specializes has participant: the customer takes part in the step at its boundary, by receiving the output."@en;
    owl:versionInfo "0.4.0";
    core:hasLifecycleStatus core:Draft .
  
  roletax:worksite-employee core:formalizedBy <https://www.insperity.com/ontology/commercial-operations/worksite-employee> .
}
