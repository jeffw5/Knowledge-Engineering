    skos:prefLabel "Data quality"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime;
    skos:definition "The state of data being fit for its intended use, characterized by accuracy, completeness, consistency, timeliness, and validity."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/>;
    skos:broader domaingovernancevoc:value-drivers;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domaingovernancevoc:data-risk-management a skos:Concept;
    skos:prefLabel "Data risk management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime;
    skos:definition "The process of identifying, assessing, and mitigating risks associated with data, including unauthorized access, data breaches, and data loss."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/>;
    skos:broader domaingovernancevoc:value-drivers;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domaingovernancevoc:operational-efficiency a skos:Concept;
    skos:prefLabel "Operational efficiency"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime;
    skos:definition "The ability to perform data governance activities effectively and efficiently, minimizing manual effort and maximizing resource utilization."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/>;
    skos:broader domaingovernancevoc:value-drivers;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domaingovernancevoc:change-management a skos:Concept;
    skos:prefLabel "Change management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:58:13.719Z"^^xsd:dateTime;
    skos:definition "Systematic approach that organizations use to help people adapt to and embrace changes in their work environment, processes, or systems. It involves planning, implementing, and managing the transition to a new state, while also addressing the human impact of those changes."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-governance/>;
    skos:broader domaingovernancevoc:governance-operational-activity;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  domaingovernancevoc:data-management-project-support-and-prioritization a skos:Concept;
