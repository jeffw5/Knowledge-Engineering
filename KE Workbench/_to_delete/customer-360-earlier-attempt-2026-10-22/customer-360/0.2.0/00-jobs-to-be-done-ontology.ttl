  dct:modified "2026-10-22T19:46:03Z"^^xsd:dateTime .

jtbd:desired-outcome
  a owl:Class ;
  rdfs:label "Desired outcome"@en ;
  skos:prefLabel "Desired outcome"@en ;
  skos:definition "A desired outcome that a client persona uses to judge success at a job step, written as direction, metric, object of control and contextual clarifier."@en ;
  rdfs:subClassOf core:desired-outcome ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/jobs-to-be-done/> ;
  core:hasPrimaryTerm jobvoc:desired-outcome ;
