<https://www.insperity.com/vocabulary/core-asset/> {
  <https://www.insperity.com/vocabulary/core-asset/> a skos:ConceptScheme;
    rdfs:label "Core asset vocabulary"@en;
    skos:prefLabel "Core asset vocabulary"@en;
    skos:hasTopConcept assetvoc:asset;
    skos:editorialNote "Some definitions in this vocabulary were first drafted with the assistance of generative artificial intelligence tools."@en;
    terms:description "A controlled vocabulary of preferred terms, synonyms and definitions for the kinds of asset an organization controls (physical, biological, human and digital) and for the digital assets that data, analytics, knowledge and artificial intelligence work produces: data, data products, analytics, artifacts, digital agents and intellectual property. It supplies the terms that the classes of the core asset ontology are anchored to."@en;
    terms:title "Core asset vocabulary"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2025-03-25T16:59:57.433Z"^^xsd:dateTime;
    skos:altLabel "Vocabulary | Core | Asset"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/vocabulary/core-asset/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  assetvoc:asset a skos:Concept;
    skos:prefLabel "Asset"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-25T17:24:34.035Z"^^xsd:dateTime;
    skos:definition "A resource controlled by an entity from which future economic benefits are expected to be generated."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-asset/>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/core-asset/>;
    skos:narrower assetvoc:biological-asset, assetvoc:digital-asset, assetvoc:physical-asset .
  
  assetvoc:biological-asset a skos:Concept;
    skos:prefLabel "Biological asset"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:52:33.260Z"^^xsd:dateTime;
    skos:definition "A living animal or plant under the control of an entity, from which future economic benefits are expected (e.g., livestock, crops)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-asset/>;
    skos:broader assetvoc:asset;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower assetvoc:human-asset .
  
  assetvoc:human-asset a skos:Concept;
    skos:prefLabel "Human asset"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:52:33.260Z"^^xsd:dateTime;
    skos:definition "The skills, knowledge, and experience of an organization’s workforce, considered as a valuable resource."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-asset/>;
    skos:broader assetvoc:biological-asset;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  assetvoc:digital-asset a skos:Concept;
    skos:prefLabel "Digital asset"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:52:33.260Z"^^xsd:dateTime;
    skos:definition "Any content or data in digital form that has value and is owned or controlled by an entity (e.g., websites, documents, multimedia)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-asset/>;
    skos:broader assetvoc:asset;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower assetvoc:analytics, assetvoc:artifact, assetvoc:data, assetvoc:digital-agent,
      assetvoc:document, assetvoc:intellectual-property, assetvoc:media, assetvoc:semantics .
  
  assetvoc:analytics a skos:Concept;
    skos:prefLabel "Analytics"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:52:33.260Z"^^xsd:dateTime;
    skos:definition "Tools, algorithms, models, and data that enable an organization to extract insights and value from data."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-asset/>;
    skos:broader assetvoc:digital-asset;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower assetvoc:analytic-product .
  
  assetvoc:analytic-product a skos:Concept;
    skos:prefLabel "Analytic product"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:52:33.260Z"^^xsd:dateTime;
    skos:definition "A packaged output or result derived from applying analytics to data, designed to address a specific business need."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-asset/>;
    skos:broader assetvoc:analytics;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  assetvoc:artifact a skos:Concept;
    skos:prefLabel "Artifact"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:52:33.260Z"^^xsd:dateTime;
    skos:definition "A tangible by-product produced during the software development process (e.g., documents, code, models)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-asset/>;
    skos:broader assetvoc:digital-asset;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower assetvoc:business-specification, assetvoc:data-engineering, assetvoc:design-specification,
      assetvoc:design-thinking, assetvoc:detective-controls, assetvoc:feature-decomposition,
      assetvoc:knowledge-engineering, assetvoc:operational-readiness, assetvoc:operational-standard-operating-procedure,
      assetvoc:preventative-controls, assetvoc:quality-engineering, assetvoc:service-level-agreement,
      assetvoc:solution-architecture, assetvoc:system-engineering, assetvoc:value-map .
  
  assetvoc:business-specification a skos:Concept;
    skos:prefLabel "Business specification"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:52:33.260Z"^^xsd:dateTime;
    skos:definition "A document outlining the business requirements and objectives for a product, service, or system."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-asset/>;
    skos:broader assetvoc:artifact;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  assetvoc:data-engineering a skos:Concept;
    skos:prefLabel "Data engineering"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:52:33.260Z"^^xsd:dateTime;
    skos:definition "The practice of designing, building, and maintaining systems for collecting, storing, and processing data at scale."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-asset/>;
    skos:broader assetvoc:artifact;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  assetvoc:design-specification a skos:Concept;
    skos:prefLabel "Design specification"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:52:33.260Z"^^xsd:dateTime;
    skos:definition "A detailed document outlining the technical requirements and specifications for a product, service, or system."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-asset/>;
    skos:broader assetvoc:artifact;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  assetvoc:design-thinking a skos:Concept;
    skos:prefLabel "Design thinking"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:52:33.260Z"^^xsd:dateTime;
    skos:definition "A human-centered approach to problem-solving that emphasizes empathy, experimentation, and iterative prototyping."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-asset/>;
    skos:broader assetvoc:artifact;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  assetvoc:detective-controls a skos:Concept;
    skos:prefLabel "Detective controls"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:52:33.260Z"^^xsd:dateTime;
    skos:definition "A security mechanism designed to detect and alert on security incidents after they have occurred."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-asset/>;
    skos:broader assetvoc:artifact;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  assetvoc:feature-decomposition a skos:Concept;
    skos:prefLabel "Feature decomposition"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:52:33.260Z"^^xsd:dateTime;
    skos:definition "The process of breaking down a complex feature or product into smaller, more manageable components."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-asset/>;
    skos:broader assetvoc:artifact;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  assetvoc:knowledge-engineering a skos:Concept;
    skos:prefLabel "Knowledge engineering"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:52:33.260Z"^^xsd:dateTime;
    skos:definition "The process of capturing, structuring, and representing knowledge from various sources to create a knowledge base."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-asset/>;
    skos:broader assetvoc:artifact;
    skos:altLabel "KE"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  assetvoc:operational-readiness a skos:Concept;
    skos:prefLabel "Operational readiness"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:52:33.260Z"^^xsd:dateTime;
    skos:definition "The state of preparedness of an organization or system to perform its intended functions effectively and efficiently."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-asset/>;
    skos:broader assetvoc:artifact;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  assetvoc:operational-standard-operating-procedure a skos:Concept;
    skos:prefLabel "Operational standard operating procedure"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:52:33.260Z"^^xsd:dateTime;
    skos:definition "A set of detailed instructions outlining the steps required to perform a specific operational task consistently."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-asset/>;
    skos:broader assetvoc:artifact;
    skos:altLabel "Operational SOP"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  assetvoc:preventative-controls a skos:Concept;
    skos:prefLabel "Preventative controls"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:52:33.260Z"^^xsd:dateTime;
    skos:definition "A security mechanism designed to prevent security incidents from occurring in the first place."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-asset/>;
    skos:broader assetvoc:artifact;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  assetvoc:quality-engineering a skos:Concept;
    skos:prefLabel "Quality engineering"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:52:33.260Z"^^xsd:dateTime;
    skos:definition "The systematic application of engineering principles and methods to ensure the quality of products, services, and processes."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-asset/>;
    skos:broader assetvoc:artifact;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  assetvoc:service-level-agreement a skos:Concept;
    skos:prefLabel "Service level agreement"@en;
