# Graphs in GraphDB that are NOT in the final core list (run as a query after the DROP).
SELECT ?g (COUNT(*) AS ?statements) WHERE { GRAPH ?g { ?s ?p ?o } FILTER(?g NOT IN (
  <https://www.insperity.com/ontology/core-domain/>,
  <https://www.insperity.com/shapes/core-compliance/>,
  <https://www.insperity.com/shapes/core-domain/>,
  <https://www.insperity.com/shapes/core-party/>,
  <https://www.insperity.com/shapes/core-process/>,
  <https://www.insperity.com/shapes/core-product/>,
  <https://www.insperity.com/taxonomy/core-asset/>,
  <https://www.insperity.com/taxonomy/core-capability/>,
  <https://www.insperity.com/taxonomy/core-compliance/>,
  <https://www.insperity.com/taxonomy/core-decision/>,
  <https://www.insperity.com/taxonomy/core-event/>,
  <https://www.insperity.com/taxonomy/core-governance/>,
  <https://www.insperity.com/taxonomy/core-issue/>,
  <https://www.insperity.com/taxonomy/core-lifecycle/>,
  <https://www.insperity.com/taxonomy/core-location/>,
  <https://www.insperity.com/taxonomy/core-logic/>,
  <https://www.insperity.com/taxonomy/core-measure/>,
  <https://www.insperity.com/taxonomy/core-party/>,
  <https://www.insperity.com/taxonomy/core-persona/>,
  <https://www.insperity.com/taxonomy/core-policy/>,
  <https://www.insperity.com/taxonomy/core-process/>,
  <https://www.insperity.com/taxonomy/core-product/>,
  <https://www.insperity.com/taxonomy/core-requirements/>,
  <https://www.insperity.com/taxonomy/core-role/>,
  <https://www.insperity.com/taxonomy/core-rules/>,
  <https://www.insperity.com/taxonomy/core-services/>,
  <https://www.insperity.com/taxonomy/core-time/>,
  <https://www.insperity.com/taxonomy/core-value/>,
  <https://www.insperity.com/vocabulary/core-asset/>,
  <https://www.insperity.com/vocabulary/core-capability/>,
  <https://www.insperity.com/vocabulary/core-compliance/>,
  <https://www.insperity.com/vocabulary/core-domain/>,
  <https://www.insperity.com/vocabulary/core-event/>,
  <https://www.insperity.com/vocabulary/core-issue/>,
  <https://www.insperity.com/vocabulary/core-lifecycle/>,
  <https://www.insperity.com/vocabulary/core-location/>,
  <https://www.insperity.com/vocabulary/core-party/>,
  <https://www.insperity.com/vocabulary/core-persona/>,
  <https://www.insperity.com/vocabulary/core-process/>,
  <https://www.insperity.com/vocabulary/core-product/>,
  <https://www.insperity.com/vocabulary/core-requirements/>,
  <https://www.insperity.com/vocabulary/core-role/>,
  <https://www.insperity.com/vocabulary/core-rules/>,
  <https://www.insperity.com/vocabulary/core-services/>,
  <https://www.insperity.com/vocabulary/core-time/>,
  <https://www.insperity.com/vocabulary/core-valuestream/>,
  <https://www.insperity.com/graph/change-log>
)) } GROUP BY ?g ORDER BY ?g
