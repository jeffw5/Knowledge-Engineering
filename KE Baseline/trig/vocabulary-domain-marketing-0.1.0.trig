    dct:created "2025-03-31T20:29:05.848Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:personalized-content
    a skos:Concept ;
    skos:prefLabel "Personalized content"@en ;
    skos:definition "Tailoring content to the specific interests, needs, and preferences of individual customers or accounts."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
