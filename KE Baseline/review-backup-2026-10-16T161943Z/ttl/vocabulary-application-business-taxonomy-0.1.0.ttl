voc:margin
  a skos:Concept ;
  skos:prefLabel "Margin"@en ;
  skos:definition "A measure of profitability expressed as a percentage of revenue."@en ;
  skos:notation "TL4000133" ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:profitability ;
  skos:narrower voc:gross-profit-margin ,
      voc:net-profit-margin ,
      voc:operating-profit-margin ;
