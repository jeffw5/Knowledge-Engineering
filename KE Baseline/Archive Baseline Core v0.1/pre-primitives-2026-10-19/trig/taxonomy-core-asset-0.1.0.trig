  assettax:GraphStore
    a skos:Concept ;
    rdfs:label "Graph store"@en ;
    skos:prefLabel "Graph store"@en ;
    skos:altLabel "Knowledge graph store"@en , "Triple store"@en ;
    skos:definition "A data store that stores and queries data as a graph of nodes and edges."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/core-asset/> ;
