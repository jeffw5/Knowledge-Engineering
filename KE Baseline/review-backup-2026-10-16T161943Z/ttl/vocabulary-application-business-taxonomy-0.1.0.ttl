voc:marketplace-content-type
  a skos:Concept ;
  skos:prefLabel "Marketplace content type"@en ;
  skos:definition "Describes the type of Marketplace content."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
