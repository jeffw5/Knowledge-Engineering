voc:small-and-medium-sized-business
  a skos:Concept ;
  skos:prefLabel "Small and medium-sized business"@en ;
  skos:altLabel "SMB"@en , "Small Medium Business"@en ;
  skos:definition "This is Companies that fall below certain revenue or employee thresholds, varying by industry and country."@en ;
