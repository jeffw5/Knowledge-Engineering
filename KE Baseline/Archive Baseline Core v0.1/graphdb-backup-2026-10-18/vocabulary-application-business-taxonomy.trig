  applicationbusinesstaxonomyvoc:upgrades terms:created "2025-07-31T20:39:38.373Z"^^xsd:dateTime;
    skos:definition "Encouraging customers to upgrade to a newer or more advanced version of a product or service."@en .
  
  applicationbusinesstaxonomyvoc:acquisition-rate-and-conversion terms:created "2025-07-31T20:39:58.745Z"^^xsd:dateTime;
    skos:definition "The percentage of potential customers who convert into paying customers."@en .
  
  applicationbusinesstaxonomyvoc:gross-adds terms:created "2025-07-31T20:39:58.745Z"^^xsd:dateTime;
    skos:definition "The total number of new customers acquired during a specific period."@en .
  
  applicationbusinesstaxonomyvoc:net-adds terms:created "2025-07-31T20:39:58.745Z"^^xsd:dateTime;
    skos:definition "The number of new customers remaining after deducting churned customers from gross adds."@en .
  
  applicationbusinesstaxonomyvoc:accessory-sales terms:created "2025-07-31T20:39:44.708Z"^^xsd:dateTime;
    skos:definition "Revenue generated from the sale of accessories related to a company’s core products, such as phone cases, chargers and headphones."@en .
  
  applicationbusinesstaxonomyvoc:device-sales terms:created "2025-07-31T20:39:44.708Z"^^xsd:dateTime;
    skos:definition "Revenue generated from the sale of electronic devices, such as smartphones, tablets and laptops."@en .
  
  applicationbusinesstaxonomyvoc:gross-sales terms:created "2025-07-31T20:39:44.708Z"^^xsd:dateTime;
    skos:definition "Total revenue generated from sales before deducting returns, discounts and allowances."@en .
  
  applicationbusinesstaxonomyvoc:net-sales terms:created "2025-07-31T20:39:44.708Z"^^xsd:dateTime;
    skos:definition "Revenue remaining after deducting returns, discounts and allowances from gross sales."@en .
  
  applicationbusinesstaxonomyvoc:service-sales terms:created "2025-07-31T20:39:44.708Z"^^xsd:dateTime;
    skos:definition "Revenue generated from the sale of services, such as telecommunications, internet and cloud computing."@en .
  
  applicationbusinesstaxonomyvoc:device-upgrades terms:created "2025-07-31T20:39:52.416Z"^^xsd:dateTime;
    skos:definition "Revenue generated from upgrading to a newer model of a device, such as a smartphone or tablet."@en .
  
  applicationbusinesstaxonomyvoc:gross-upgrades terms:created "2025-07-31T20:39:52.416Z"^^xsd:dateTime;
    skos:definition "The total number of upgrades before deducting downgrades or cancellations."@en .
  
  applicationbusinesstaxonomyvoc:net-upgrades terms:created "2025-07-31T20:39:52.416Z"^^xsd:dateTime;
    skos:definition "The number of upgrades remaining after deducting downgrades or cancellations."@en .
  
  applicationbusinesstaxonomyvoc:service-upgrades terms:created "2025-07-31T20:39:52.416Z"^^xsd:dateTime;
    skos:definition "Revenue generated from upgrading to a higher-tier service plan with more features or benefits."@en .
  
  applicationbusinesstaxonomyvoc:account terms:created "2025-07-31T20:46:34.855Z"^^xsd:dateTime;
    skos:definition "A record of financial transactions, credits, and debits, or a formal business relationship with a customer or client."@en .
  
  applicationbusinesstaxonomyvoc:agreement terms:created "2025-07-31T20:46:34.855Z"^^xsd:dateTime;
    skos:definition "A formal understanding or arrangement between two or more parties, outlining mutual obligations and terms."@en .
  
  applicationbusinesstaxonomyvoc:anomaly terms:created "2025-07-31T20:46:34.855Z"^^xsd:dateTime;
    skos:definition "A deviation from what is standard, normal, or expected; an irregularity or outlier in a dataset or process."@en .
  
  applicationbusinesstaxonomyvoc:base-types terms:created "2025-07-31T20:46:34.855Z"^^xsd:dateTime;
    skos:definition "The fundamental data types (e.g., string, integer, boolean) from which more complex data structures are built in a data model."@en .
  
  applicationbusinesstaxonomyvoc:business-interaction terms:created "2025-07-31T20:46:34.855Z"^^xsd:dateTime;
    skos:definition "An instance of communication or activity between two or more business parties, or between a business and a system."@en .
  
  applicationbusinesstaxonomyvoc:catalog terms:created "2025-07-31T20:46:34.855Z"^^xsd:dateTime;
    skos:definition "A structured and organized collection of items, products, or services, including their descriptive information."@en .
  
  applicationbusinesstaxonomyvoc:closed-loop terms:created "2025-07-31T20:46:34.855Z"^^xsd:dateTime;
    skos:definition "A process or system in which the output is used to modify the input in a continuous cycle of feedback and adjustment."@en .
  
  applicationbusinesstaxonomyvoc:event terms:created "2025-07-31T20:46:34.855Z"^^xsd:dateTime;
    skos:definition "An occurrence or happening of significance at a specific point in time, often triggering a response or action within a system."@en .
  
  applicationbusinesstaxonomyvoc:goal terms:created "2025-07-31T20:46:34.855Z"^^xsd:dateTime;
    skos:definition "A desired future state or outcome that a person or a group of people envisions, plans, and commits to achieve."@en .
  
  applicationbusinesstaxonomyvoc:intent terms:created "2025-07-31T20:46:34.855Z"^^xsd:dateTime;
    skos:definition "The underlying purpose or objective that drives an action or a business interaction."@en .
  
  applicationbusinesstaxonomyvoc:metric terms:created "2025-07-31T20:46:34.855Z"^^xsd:dateTime;
    skos:definition "Represent areas of business operation that are important in assessing business performance, customer satisfaction/loyalty and operational efficiency, typically following a preferred progression or a numerical directionality which indicates how the business is improving."@en .
  
  applicationbusinesstaxonomyvoc:policy terms:created "2025-07-31T20:46:34.855Z"^^xsd:dateTime;
    skos:definition "A set of rules, guidelines, or principles that governs the actions and decisions of an organization or system."@en .
  
  applicationbusinesstaxonomyvoc:project terms:created "2025-07-31T20:46:34.855Z"^^xsd:dateTime;
    skos:definition "A temporary and planned endeavor undertaken to create a unique product, service, or result with a defined scope, start, and end."@en .
  
  applicationbusinesstaxonomyvoc:root-business-entities terms:created "2025-07-31T20:46:34.855Z"^^xsd:dateTime;
    skos:definition "The core, high-level concepts in a business data model that are central to its operations, such as Customer, Product, or Order."@en .
  
  applicationbusinesstaxonomyvoc:workflow terms:created "2025-07-31T20:46:34.855Z"^^xsd:dateTime;
    skos:definition "A sequence of connected steps or tasks, often automated, that constitute a work process from initiation to completion."@en .
  
  applicationbusinesstaxonomyvoc:commitment terms:created "2025-07-31T20:46:44.876Z"^^xsd:dateTime;
    skos:definition "A pledge or obligation to undertake a future action or to adhere to a specific course of conduct."@en .
  
  applicationbusinesstaxonomyvoc:association terms:created "2025-07-31T20:46:50.239Z"^^xsd:dateTime;
    skos:definition "A relationship or link that connects two or more business entities or objects, describing how they interact."@en .
  
  applicationbusinesstaxonomyvoc:product-capacity terms:created "2025-07-31T20:40:36.466Z"^^xsd:dateTime;
    skos:definition "The maximum output, volume, or number of users a product can handle or support effectively within a given timeframe and under specified conditions."@en .
  
  applicationbusinesstaxonomyvoc:product-configuration terms:created "2025-07-31T20:40:36.466Z"^^xsd:dateTime;
    skos:definition "The process or result of customizing a product by selecting and arranging various options, components, or features to meet specific customer requirements or create distinct product variants."@en .
  
  applicationbusinesstaxonomyvoc:product-lifecycle terms:created "2025-07-31T20:40:36.466Z"^^xsd:dateTime;
    skos:definition "The stages a product goes through from its initial development to its eventual decline."@en .
  
  applicationbusinesstaxonomyvoc:product-performance terms:created "2025-07-31T20:40:36.466Z"^^xsd:dateTime;
    skos:definition "A measure of how well a product fulfills its intended purpose and meets user expectations, often evaluated through metrics related to its functionality, reliability, speed, efficiency, usability, and market success."@en .
  
  applicationbusinesstaxonomyvoc:product-portfolio terms:created "2025-07-31T20:40:36.466Z"^^xsd:dateTime;
    skos:definition "The collection of all products or services offered by a company."@en .
  
  applicationbusinesstaxonomyvoc:product-segmentation terms:created "2025-07-31T20:40:36.466Z"^^xsd:dateTime;
    skos:definition "Offering different versions or variations of a product to appeal to different customer segments."@en .
  
  applicationbusinesstaxonomyvoc:product-specification terms:created "2025-07-31T20:40:36.466Z"^^xsd:dateTime;
    skos:definition "A detailed document outlining a product's requirements, including its features, functionality, design, technical aspects, and performance criteria, serving as a blueprint for the development team."@en .
  
  applicationbusinesstaxonomyvoc:product-usage terms:created "2025-07-31T20:40:36.466Z"^^xsd:dateTime;
    skos:definition "The manner and extent to which customers interact with a product, encompassing aspects like frequency of use, features utilized, duration of engagement, and overall user behavior patterns."@en .
  
  applicationbusinesstaxonomyvoc:product-development terms:created "2025-07-31T20:40:44.505Z"^^xsd:dateTime;
    skos:definition "The process of designing, creating and bringing a new product to market."@en .
  
  applicationbusinesstaxonomyvoc:product-research-and-analysis terms:created "2025-07-31T20:40:44.505Z"^^xsd:dateTime;
    skos:definition "Gathering information about customer needs, market trends and competitive products to inform product development decisions."@en .
  
