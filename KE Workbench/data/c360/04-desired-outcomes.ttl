    jtbd:isOutcomeOfJob ob:Job-J01 ;
    jtbd:occursAtJobStep ob:DefineStep ;
    jtbd:hasBenchmarkTheme theme:payroll ;
    jtbd:hasOutcomeMetricType metric:speed ;
    jtbd:hasImportanceQuestion "When you pay employees accurately and on time, how important is it to minimize the time required to determine which pay rules apply to each employee, e.g., overtime, shift differentials, bonuses?"@en ;
    jtbd:hasSatisfactionQuestion "How satisfied are you with your current ability to minimize the time required to determine which pay rules apply to each employee, e.g., overtime, shift differentials, bonuses?"@en ;
