  dct:created "2026-10-19"^^xsd:date ;
  dct:modified "2026-10-19T02:19:17Z"^^xsd:dateTime .

core:Requirement
  a owl:Class ;
  rdfs:label "Requirement"@en ;
  skos:prefLabel "Requirement"@en ;
  skos:definition "A directive that states a need that a product, service or process step must fulfill."@en ;
  rdfs:subClassOf core:Directive ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/core/> ;
