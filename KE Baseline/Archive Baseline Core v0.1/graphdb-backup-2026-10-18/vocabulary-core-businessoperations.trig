  businessoperationsvoc:crisis-communication a skos:Concept;
    skos:prefLabel "Crisis communication"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime;
    skos:definition "The process of communicating with the public and stakeholders during a crisis."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:communications;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:external-communication a skos:Concept;
    skos:prefLabel "External communication"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime;
    skos:definition "Communication between an organization and its external stakeholders (e.g., customers, investors)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:communications;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:internal-communication a skos:Concept;
    skos:prefLabel "Internal communication"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime;
    skos:definition "Communication within an organization, between employees and management."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:communications;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:continuous-improvement a skos:Concept;
    skos:prefLabel "Continuous improvement"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime;
    skos:definition "An ongoing effort to improve products, services, or processes."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:quality-management;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:quality-assurance a skos:Concept;
    skos:prefLabel "Quality assurance"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime;
    skos:definition "A system of preventing mistakes and defects in manufactured products and avoiding problems when delivering services to customers."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:quality-management;
    skos:altLabel "QA"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:quality-control a skos:Concept;
    skos:prefLabel "Quality control"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime;
    skos:definition "A process that ensures products or services meet predefined quality standards."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:quality-management;
    skos:altLabel "QC"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:quality-planning a skos:Concept;
    skos:prefLabel "Quality planning"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime;
    skos:definition "Defining quality standards and determining how to meet them."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:quality-management;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:total-quality-management a skos:Concept;
    skos:prefLabel "Total quality management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime;
    skos:definition "A management approach that aims to involve all employees in the continuous improvement of quality."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:quality-management;
    skos:altLabel "TQM"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:business-model-canvas a skos:Concept;
    skos:prefLabel "Business model canvas"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime;
    skos:definition "A strategic management template for developing new business models or documenting existing ones."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:strategy;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower businessoperationsvoc:channels, businessoperationsvoc:cost-structure,
      businessoperationsvoc:customer-relationships, businessoperationsvoc:customer-segmentation,
      businessoperationsvoc:key-activities, businessoperationsvoc:key-partnerships, businessoperationsvoc:key-resources,
      businessoperationsvoc:revenue-streams .
  
  businessoperationsvoc:competitive-advantage a skos:Concept;
    skos:prefLabel "Competitive advantage"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime;
    skos:definition "A condition that allows a company to operate in a more efficient or otherwise higher-quality manner than its competitors."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:strategy;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower businessoperationsvoc:competitive-analysis, businessoperationsvoc:core-competencies,
      businessoperationsvoc:sustainable-advantage, businessoperationsvoc:value-proposition .
  
  businessoperationsvoc:cost-leadership a skos:Concept;
    skos:prefLabel "Cost leadership"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime;
    skos:definition "A strategy focused on having the lowest cost of production and operation in the industry."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:strategy;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:differentiation a skos:Concept;
    skos:prefLabel "Differentiation"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime;
    skos:definition "A strategy focused on offering unique products or services that customers value."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:strategy;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:focus a skos:Concept;
    skos:prefLabel "Focus"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime;
    skos:definition "A strategy focused on serving a specific niche market segment."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:strategy;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:growth-strategies a skos:Concept;
    skos:prefLabel "Growth strategies"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime;
    skos:definition "Strategies that focus on increasing revenue, market share, or both."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:strategy;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower businessoperationsvoc:diversification, businessoperationsvoc:market-development,
      businessoperationsvoc:market-penetration, businessoperationsvoc:product-development .
  
  businessoperationsvoc:operational-efficiency a skos:Concept;
    skos:prefLabel "Operational efficiency"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime;
    skos:definition "Performing business processes in the most cost-effective and productive manner."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:strategy;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower businessoperationsvoc:process-optimization, businessoperationsvoc:resource-allocation,
      businessoperationsvoc:waste-reduction .
  
  businessoperationsvoc:strengths-weaknesses-opportunities-and-threats-analysis a skos:Concept;
    skos:prefLabel "Strengths, weaknesses, opportunities and threats analysis"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime;
    skos:definition "A planning tool used to analyze an organization’s strengths, weaknesses, opportunities, and threats."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:strategy;
    skos:altLabel "Strengths Weaknesses Opportunities Threats Analysis"@en, "SWOT analysis"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower businessoperationsvoc:external-analysis, businessoperationsvoc:internal-analysis,
      businessoperationsvoc:strategic-fit .
  
  businessoperationsvoc:value-chain-analysis a skos:Concept;
    skos:prefLabel "Value chain analysis"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime;
    skos:definition "A tool used to analyze the activities an organization performs to create value for its customers."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:strategy;
    skos:altLabel "VCA"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower businessoperationsvoc:inbound-logistics, businessoperationsvoc:marketing-and-sales,
      businessoperationsvoc:operations, businessoperationsvoc:outbound-logistics, businessoperationsvoc:service,
      businessoperationsvoc:support-activities .
  
  businessoperationsvoc:channels a skos:Concept;
    skos:prefLabel "Channels"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-01T20:31:38.318Z"^^xsd:dateTime;
    skos:definition "Channels describe how a company communicates with and reaches its customer segments to deliver its value proposition. This includes channels for raising awareness, evaluating your product, purchasing, delivering the product/service, and providing post-purchase support."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:business-model-canvas;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:cost-structure a skos:Concept;
    skos:prefLabel "Cost structure"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-01T20:31:38.318Z"^^xsd:dateTime;
    skos:definition "The cost structure defines all the significant expenses a company incurs to operate its business model. This includes fixed costs (e.g., rent, salaries) and variable costs (e.g., raw materials, marketing expenses)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:business-model-canvas;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:customer-relationships a skos:Concept;
    skos:prefLabel "Customer relationships"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-01T20:31:38.318Z"^^xsd:dateTime;
    skos:definition "This describes the types of relationships a company establishes with its customer segments. This could range from personal and hands-on to automated and self-service. Examples include personal assistance, dedicated account managers, self-service portals, and automated email communication."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:business-model-canvas;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:customer-segmentation a skos:Concept;
    skos:prefLabel "Customer segmentation"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-01T20:31:38.318Z"^^xsd:dateTime;
    skos:definition "Customer segmentation involves dividing a company’s target market into distinct groups based on shared characteristics like demographics, behaviors, needs, and wants. This allows for more targeted marketing and product development."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:business-model-canvas;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:key-activities a skos:Concept;
    skos:prefLabel "Key activities"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-01T20:31:38.318Z"^^xsd:dateTime;
    skos:definition "Key activities are the most important actions a company must perform to operate successfully. These are the crucial tasks that directly contribute to delivering the value proposition, reaching customers, maintaining relationships, and generating revenue."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:business-model-canvas;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:key-partnerships a skos:Concept;
    skos:prefLabel "Key partnerships"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-01T20:31:38.318Z"^^xsd:dateTime;
    skos:definition "Key partnerships refer to the network of suppliers and partners that make the business model possible. This can include strategic alliances with other companies, joint ventures, or buyer-supplier relationships."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:business-model-canvas;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:key-resources a skos:Concept;
    skos:prefLabel "Key resources"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-01T20:31:38.318Z"^^xsd:dateTime;
    skos:definition "Key resources are the most important assets required to make the business model work. These can be physical (e.g., manufacturing facilities, inventory), intellectual (e.g., patents, brand), human (e.g., skilled employees), or financial (e.g., funding, lines of credit)."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:business-model-canvas;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:revenue-streams a skos:Concept;
    skos:prefLabel "Revenue streams"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-01T20:31:38.318Z"^^xsd:dateTime;
    skos:definition "Revenue streams represent the cash a company generates from each customer segment. This outlines how the company makes money, whether through product sales, service fees, subscriptions, licensing, advertising, or other means."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:business-model-canvas;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:competitive-analysis a skos:Concept;
    skos:prefLabel "Competitive analysis"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-01T20:34:17.752Z"^^xsd:dateTime;
    skos:definition "A strategic assessment that identifies and evaluates competitors to understand their strengths, weaknesses, strategies, and objectives. This information helps businesses make informed decisions to gain a competitive edge."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:competitive-advantage;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:core-competencies a skos:Concept;
    skos:prefLabel "Core competencies"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-01T20:34:17.752Z"^^xsd:dateTime;
    skos:definition "Unique strengths and capabilities that differentiate a company from its rivals. These are deeply ingrained within a company’s structure, processes, and culture, making them difficult for competitors to replicate."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:competitive-advantage;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:sustainable-advantage a skos:Concept;
    skos:prefLabel "Sustainable advantage"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-01T20:34:17.752Z"^^xsd:dateTime;
    skos:definition "A long-term competitive advantage that is difficult for competitors to imitate or overcome. It arises from factors such as strong brand equity, proprietary technology, or exclusive access to resources."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:competitive-advantage;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:value-proposition a skos:Concept;
    skos:prefLabel "Value proposition"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-01T20:34:17.752Z"^^xsd:dateTime;
    skos:definition "A clear statement that explains the benefits customers receive by choosing a particular product or service over alternatives. It outlines how the offering solves a customer problem or fulfills a need better than the competition."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:competitive-advantage;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:diversification a skos:Concept;
    skos:prefLabel "Diversification"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime;
    skos:definition "A strategy of entering new markets or offering new products that are unrelated to a company’s core business."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:growth-strategies;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:market-development a skos:Concept;
    skos:prefLabel "Market development"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime;
    skos:definition "A strategy of selling existing products or services in new markets."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:growth-strategies;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:market-penetration a skos:Concept;
    skos:prefLabel "Market penetration"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime;
    skos:definition "A strategy of increasing sales of existing products or services to existing market segments."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:growth-strategies;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:product-development a skos:Concept;
    skos:prefLabel "Product development"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime;
    skos:definition "A strategy of developing new products or services for existing markets."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:growth-strategies;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:process-optimization a skos:Concept;
    skos:prefLabel "Process optimization"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime;
    skos:definition "The practice of identifying and eliminating bottlenecks and inefficiencies in business processes."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:operational-efficiency;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:resource-allocation a skos:Concept;
    skos:prefLabel "Resource allocation"@en;
    terms:creator "Jeffrey Wallk";
