<https://www.insperity.com/taxonomy/domain-partner-and-channel/> {
  <https://www.insperity.com/taxonomy/domain-partner-and-channel/> a skos:ConceptScheme;
    rdfs:label "Partner and channel domain taxonomy"@en;
    skos:prefLabel "Partner and channel domain taxonomy"@en;
    skos:hasTopConcept partnerchanneltax:channel-partner-type, partnerchanneltax:partner-agreement,
      partnerchanneltax:partner-attribution, partnerchanneltax:partner-measure, partnerchanneltax:partner-program,
      partnerchanneltax:sales-channel, partnerchanneltax:technology-integration;
    skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en;
    terms:description "A classification of channel partner types, sales channels, partner program elements, partner agreements, partner attribution, partner measures and technology integrations."@en;
    terms:title "Partner and channel domain taxonomy"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_partner_and_channel.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.1.1 (2026-10-20): Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_partner_and_channel.py against Baseline Core v1.0 (core 0.1.0)."@en;
    terms:created "2026-10-20"^^xsd:date;
    owl:versionInfo "0.1.1";
    terms:subject domainvoc:commercial;
    terms:isPartOf <https://www.insperity.com/domain/commercial-operations/>;
    owl:versionIRI <https://www.insperity.com/taxonomy/domain-partner-and-channel/0.1.1/>;
    terms:source <https://www.insperity.com/vocabulary/core-asset/>, <https://www.insperity.com/vocabulary/core-capability/>,
      <https://www.insperity.com/vocabulary/core-domain/>, <https://www.insperity.com/vocabulary/core-product/>,
      <https://www.insperity.com/vocabulary/core-role/>, <https://www.insperity.com/vocabulary/core-measure/>,
      <https://www.insperity.com/vocabulary/core-policy/>, <https://www.insperity.com/vocabulary/domain-commercial-operations/>,
      <https://www.insperity.com/vocabulary/domain-partner-and-channel/>;
    vaem:namespace "https://www.insperity.com/taxonomy/domain-partner-and-channel/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft;
    vann:preferredNamespacePrefix "partnerchanneltax";
    terms:publisher <https://www.insperity.com/resource/core/Organization/insperity>;
    terms:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/>;
    terms:identifier "taxonomy-domain-partner-and-channel" .
  
  partnerchanneltax:channel-partner-type a skos:Concept;
    rdfs:label "Channel partner type"@en;
    skos:prefLabel "Channel partner type"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A kind of organization that bears the channel partner role for the organization."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-partner-and-channel/>;
    owl:versionInfo "0.1.1";
    terms:subject rolevoc:partner, productvoc:channel;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-partner-and-channel/>;
    skos:narrower partnerchanneltax:accountant-partner, partnerchanneltax:alliance-partner,
      partnerchanneltax:association-partner, partnerchanneltax:bank-partner, partnerchanneltax:benefits-broker,
      partnerchanneltax:franchise-partner, partnerchanneltax:insurance-broker, partnerchanneltax:reseller,
      partnerchanneltax:technology-partner;
    core:hasPrimaryTerm rolevoc:partner;
    core:formalizedBy partnerchannel:channel-partner;
    skos:broadMatch roletax:partner .
  
  partnerchanneltax:partner-agreement a skos:Concept;
    rdfs:label "Partner agreement"@en;
    skos:prefLabel "Partner agreement"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A commercial agreement between the organization and a partner."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-partner-and-channel/>;
    owl:versionInfo "0.1.1";
    terms:subject rolevoc:partner, policyvoc:agreement;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-partner-and-channel/>;
    skos:narrower partnerchanneltax:alliance-agreement, partnerchanneltax:broker-of-record,
      partnerchanneltax:referral-agreement;
    core:hasPrimaryTerm policyvoc:agreement;
    core:formalizedBy core:directive;
    skos:broadMatch commercialopstax:commercial-agreement .
  
  partnerchanneltax:partner-attribution a skos:Concept;
    rdfs:label "Partner attribution"@en;
    skos:prefLabel "Partner attribution"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "An information asset that records the credit given to a partner for a lead, opportunity or sale."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-partner-and-channel/>;
    owl:versionInfo "0.1.1";
    terms:subject rolevoc:partner, domaincommercialoperationsvoc:attribution;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-partner-and-channel/>;
    skos:narrower partnerchanneltax:partner-influenced-opportunity, partnerchanneltax:partner-sourced-opportunity;
    core:hasPrimaryTerm domaincommercialoperationsvoc:attribution;
    core:formalizedBy core:information-asset;
    skos:broadMatch commercialopstax:attribution .
  
  partnerchanneltax:partner-measure a skos:Concept;
    rdfs:label "Partner measure"@en;
    skos:prefLabel "Partner measure"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A measure of the performance of the partner channel."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-partner-and-channel/>;
    owl:versionInfo "0.1.1";
    terms:subject rolevoc:partner, measurevoc:measure;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-partner-and-channel/>;
    skos:narrower partnerchanneltax:partner-sourced-pipeline, partnerchanneltax:partner-sourced-sales,
      partnerchanneltax:referral-conversion-rate;
    core:hasPrimaryTerm measurevoc:measure;
    core:formalizedBy core:measure;
    skos:broadMatch measuretax:key-performance-indicator .
  
  partnerchanneltax:partner-program a skos:Concept;
    rdfs:label "Partner program"@en;
    skos:prefLabel "Partner program"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A directive that sets the activities, benefits and rules under which partners refer, sell and are rewarded."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-partner-and-channel/>;
    owl:versionInfo "0.1.1";
    terms:subject rolevoc:partner, partnerchannelvoc:program;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-partner-and-channel/>;
    skos:narrower partnerchanneltax:co-marketing, partnerchanneltax:opportunity-registration,
      partnerchanneltax:partner-enablement, partnerchanneltax:partner-incentive, partnerchanneltax:partner-level;
    core:hasPrimaryTerm partnerchannelvoc:program;
    core:formalizedBy partnerchannel:partner-program .
  
  partnerchanneltax:sales-channel a skos:Concept;
    rdfs:label "Sales channel"@en;
    skos:prefLabel "Sales channel"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A route through which the organization's offerings reach their buyers."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-partner-and-channel/>;
    owl:versionInfo "0.1.1";
    terms:subject domainvoc:sales, productvoc:channel;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-partner-and-channel/>;
    skos:narrower partnerchanneltax:alliance-channel, partnerchanneltax:broker-channel,
      partnerchanneltax:marketplace-channel, partnerchanneltax:referral-channel;
    core:hasPrimaryTerm productvoc:channel;
    core:formalizedBy core:asset .
  
  partnerchanneltax:technology-integration a skos:Concept;
    rdfs:label "Technology integration"@en;
    skos:prefLabel "Technology integration"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A capability that connects a technology partner's software with the organization's, so that data and processes flow between them."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-partner-and-channel/>;
    owl:versionInfo "0.1.1";
    terms:subject capabilityvoc:integration, assetvoc:technology;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-partner-and-channel/>;
    skos:narrower partnerchanneltax:marketplace-listing;
    core:hasPrimaryTerm capabilityvoc:integration;
    core:formalizedBy core:capability .
  
  partnerchanneltax:accountant-partner a skos:Concept;
    rdfs:label "Accountant partner"@en;
    skos:prefLabel "Accountant partner"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A channel partner type that is an accounting firm advising small and mid-sized businesses on tax and payroll."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-partner-and-channel/>;
    skos:broader partnerchanneltax:channel-partner-type;
