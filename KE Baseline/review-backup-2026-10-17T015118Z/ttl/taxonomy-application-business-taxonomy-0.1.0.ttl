tax:ResponsibleBusinessMetricStewards
  a owl:Class ;
  rdfs:label "Responsible business metric stewards"@en ;
  skos:prefLabel "Responsible business metric stewards"@en ;
  skos:definition "This role fully understands the business context of the metric and very often comes up with the need for the metric, defines and manages the business definition, objectives and purpose of the metric, provides business formula for the calculation of the metric in simple understandable language, manages & approves all business decisions related to the metric, and is responsible for ongoing maintenance of business metadata of the metric."@en ;
  rdfs:subClassOf skos:Concept , tax:Owner ;
  rdfs:isDefinedBy <https://www.insperity.com/taxonomy/application-business-taxonomy/> ;
  dc:subject applicationbusinesstaxonomyvoc:responsible-business-metric-stewards ;
