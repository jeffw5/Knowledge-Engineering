  <https://www.insperity.com/ontology/domain-legal/>
    a owl:Ontology ;
    rdfs:label "Legal domain ontology"@en ;
    dct:title "Legal domain ontology"@en ;
    dct:description "The legal ontology. It extends the core domain ontology and the Commercial Operations ontology with deontic norms (obligation, permission, prohibition, right) that bind roles and are traced to the provisions that state them, statutes and regulations scoped to a jurisdiction, and legal matters, so that rules, constraints and logic have a single source of truth in law."@en ;
    dct:subject domainvoc:legal ;
    owl:imports <https://www.insperity.com/ontology/core/> ,
        <https://www.insperity.com/ontology/domain-commercial-operations/> ;
    vaem:namespace "https://www.insperity.com/ontology/domain-legal/"^^xsd:anyURI ;
    vann:preferredNamespacePrefix "legal" ;
    dct:language "en" ;
    dct:publisher <https://www.insperity.com/resource/core/Organization/insperity> ;
    dct:conformsTo <http://purl.obolibrary.org/obo/bfo/2020/bfo.owl> ,
        <https://www.insperity.com/standard/semantic-governance/1.9/> ;
    skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en ;
    skos:changeNote "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_legal.py against Baseline Core v1.0 (core 0.1.0)."@en ,
        "0.1.1 (2026-10-20): Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_legal.py against Baseline Core v1.0 (core 0.1.0)."@en ;
    owl:versionInfo "0.1.1" ;
    owl:versionIRI <https://www.insperity.com/ontology/domain-legal/0.1.1/> ;
    dct:identifier "ontology-domain-legal" ;
    dct:isPartOf <https://www.insperity.com/domain/commercial-operations/> ;
    dct:requires <https://www.insperity.com/ontology/core/0.1.0/> ,
        <https://www.insperity.com/ontology/domain-commercial-operations/0.2.0/> ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-20"^^xsd:date ;
    dct:modified "2026-10-20T04:19:14Z"^^xsd:dateTime .

  legal:norm
    a owl:Class ;
    rdfs:label "Norm"@en ;
    skos:prefLabel "Norm"@en ;
    skos:definition "A policy that states what a party in a role is obliged, permitted or forbidden to do, or is entitled to."@en ;
    skos:scopeNote "Deontic norms after the Legal Knowledge Interchange Format. A norm is part of the provision, clause or policy that states it (core:componentOf), which is its single source of truth; rules and constraints that implement it are governed by it."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:allValuesFrom core:role ;
        owl:onProperty legal:binds
    ] ,
        [
        a owl:Restriction ;
        owl:onProperty core:componentOf ;
        owl:someValuesFrom core:directive
    ] ,
        core:policy ;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/domain-legal/> ;
    core:hasPrimaryTerm policyvoc:norm ;
    dct:subject policyvoc:norm ;
    owl:versionInfo "0.1.1" ;
