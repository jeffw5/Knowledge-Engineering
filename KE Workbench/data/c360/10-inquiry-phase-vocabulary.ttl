phase:discover a skos:Concept ;
    rdfs:label "Discover"@en ;
    skos:prefLabel "Discover"@en ;
    skos:definition "An inquiry phase in which the participant describes when the work goes at its best and what made it so."@en ;
    skos:notation "1" ;
    skos:inScheme <https://www.insperity.com/vocabulary/inquiry-phase/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/inquiry-phase/> .

phase:dream a skos:Concept ;
    rdfs:label "Dream"@en ;
    skos:prefLabel "Dream"@en ;
    skos:definition "An inquiry phase in which the participant imagines what the work would look like if it always went that well."@en ;
    skos:notation "2" ;
    skos:inScheme <https://www.insperity.com/vocabulary/inquiry-phase/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/inquiry-phase/> .

phase:design a skos:Concept ;
    rdfs:label "Design"@en ;
    skos:prefLabel "Design"@en ;
    skos:definition "An inquiry phase in which the participant describes the steps, support and conditions that would make the dream real."@en ;
    skos:notation "3" ;
    skos:inScheme <https://www.insperity.com/vocabulary/inquiry-phase/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/inquiry-phase/> .

phase:destiny a skos:Concept ;
    rdfs:label "Destiny"@en ;
    skos:prefLabel "Destiny"@en ;
    skos:definition "An inquiry phase in which the participant names what must be true, and how they would measure it, to sustain the change."@en ;
    skos:notation "4" ;
    skos:inScheme <https://www.insperity.com/vocabulary/inquiry-phase/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/inquiry-phase/> ;
    skos:altLabel "Deliver"@en .
