voc:awning
  a skos:Concept ;
  skos:prefLabel "Awning"@en ;
  skos:definition "A roof-like cover, often made of fabric, metal, or plastic, that extends over a window, door, or patio to provide shade from the sun. Awnings can be retractable or stationary."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-facilities/> ;
  skos:broader voc:furniture ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
