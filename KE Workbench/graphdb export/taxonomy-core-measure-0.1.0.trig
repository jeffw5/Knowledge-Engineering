<https://www.insperity.com/taxonomy/core-measure/> {
  <https://www.insperity.com/taxonomy/core-measure/> a skos:ConceptScheme;
    rdfs:label "Core measure taxonomy"@en;
    skos:prefLabel "Core measure taxonomy"@en;
    skos:hasTopConcept <https://www.insperity.com/taxonomy/core-measure/base-measure>,
      <https://www.insperity.com/taxonomy/core-measure/calculation>, <https://www.insperity.com/taxonomy/core-measure/derived-measure>,
      <https://www.insperity.com/taxonomy/core-measure/forecast-value>, <https://www.insperity.com/taxonomy/core-measure/indicator>,
      <https://www.insperity.com/taxonomy/core-measure/measurement-dimension>, <https://www.insperity.com/taxonomy/core-measure/observation>,
      <https://www.insperity.com/taxonomy/core-measure/target>, <https://www.insperity.com/taxonomy/core-measure/threshold>;
    terms:description "Classification of measures and calculations, the quantified evaluations of processes, assets, and qualities and the governed formulas that compute them."@en;
    terms:title "Core measure taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2026-10-14"^^xsd:dateTime;
    skos:altLabel "Measure taxonomy"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/taxonomy/core-measure/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-measure/base-measure> a skos:Concept;
    skos:prefLabel "Base measure"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A measure that quantifies a single attribute by a direct method."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-measure/>;
    skos:altLabel "Count"@en, "Raw measure"@en;
    skos:example "Number of answers served; hours worked."@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-measure/> .
  
  <https://www.insperity.com/taxonomy/core-measure/calculation> a skos:Concept;
    skos:prefLabel "Calculation"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A governed formula specification that computes a value from inputs and is verified against test vectors."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-measure/>;
    skos:altLabel "Calc"@en, "Computation"@en, "Formula"@en;
    skos:scopeNote "Authored once in the single source of truth and generated into services."@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-measure/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-measure/aggregation-calculation>,
      <https://www.insperity.com/taxonomy/core-measure/allocation-calculation>, <https://www.insperity.com/taxonomy/core-measure/arithmetic-calculation>,
      <https://www.insperity.com/taxonomy/core-measure/conversion-calculation>, <https://www.insperity.com/taxonomy/core-measure/date-calculation>,
      <https://www.insperity.com/taxonomy/core-measure/ratio-calculation>, <https://www.insperity.com/taxonomy/core-measure/scoring-calculation>,
      <https://www.insperity.com/taxonomy/core-measure/statistical-calculation> .
  
  <https://www.insperity.com/taxonomy/core-measure/derived-measure> a skos:Concept;
    skos:prefLabel "Derived measure"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A measure computed from two or more base or derived measures."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-measure/>;
    skos:altLabel "Calculated measure"@en, "Computed measure"@en;
    skos:example "Average handling time."@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-measure/> .
  
  <https://www.insperity.com/taxonomy/core-measure/forecast-value> a skos:Concept;
    skos:prefLabel "Forecast value"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A measure value that estimates a future value of a measure from assumptions and history."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-measure/>;
    skos:altLabel "Forecast"@en, "Projection"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-measure/> .
  
  <https://www.insperity.com/taxonomy/core-measure/indicator> a skos:Concept;
    skos:prefLabel "Indicator"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A measure that estimates or evaluates an attribute against an information need, often compared to a target."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-measure/>;
    skos:altLabel "Metric"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-measure/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-measure/knowledge-quality-indicator>,
      <https://www.insperity.com/taxonomy/core-measure/key-performance-indicator>, <https://www.insperity.com/taxonomy/core-measure/key-risk-indicator>,
      <https://www.insperity.com/taxonomy/core-measure/reliability-indicator>, <https://www.insperity.com/taxonomy/core-measure/service-level-indicator> .
  
  <https://www.insperity.com/taxonomy/core-measure/measurement-dimension> a skos:Concept;
    skos:prefLabel "Measurement dimension"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A characteristic along which measures are evaluated or broken down."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-measure/>;
    skos:altLabel "Dimension"@en, "Quality dimension group"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-measure/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-measure/data-quality-dimension>,
      <https://www.insperity.com/taxonomy/core-measure/performance-dimension>, <https://www.insperity.com/taxonomy/core-measure/trust-dimension> .
  
  <https://www.insperity.com/taxonomy/core-measure/observation> a skos:Concept;
    skos:prefLabel "Observation"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A measure value recorded for a specific subject, period, and set of dimensions."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-measure/>;
    skos:altLabel "Measurement"@en, "Data point"@en, "Fact"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-measure/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-measure/actual-value>, <https://www.insperity.com/taxonomy/core-measure/benchmark-value> .
  
  <https://www.insperity.com/taxonomy/core-measure/target> a skos:Concept;
    skos:prefLabel "Target"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A measure value that a party commits to achieve within a period."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-measure/>;
    skos:altLabel "Goal"@en, "Objective value"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-measure/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-measure/budget-target>, <https://www.insperity.com/taxonomy/core-measure/service-level-objective> .
  
  <https://www.insperity.com/taxonomy/core-measure/threshold> a skos:Concept;
    skos:prefLabel "Threshold"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A measure value that, when crossed, triggers an alert, decision, or action."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-measure/>;
    skos:altLabel "Limit"@en, "Tolerance"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-measure/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-measure/alert-threshold>, <https://www.insperity.com/taxonomy/core-measure/tolerance-threshold>,
      <https://www.insperity.com/taxonomy/core-measure/trip-threshold> .
  
  <https://www.insperity.com/taxonomy/core-measure/accuracy> a skos:Concept;
    skos:prefLabel "Accuracy"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A data quality dimension of how closely values agree with reality or an authoritative source."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-measure/>;
    skos:broader <https://www.insperity.com/taxonomy/core-measure/data-quality-dimension>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-measure/data-quality-dimension> a skos:Concept;
    skos:prefLabel "Data quality dimension"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A measurement dimension of how fit data is for its intended use."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-measure/>;
    skos:broader <https://www.insperity.com/taxonomy/core-measure/measurement-dimension>;
    skos:altLabel "Data quality characteristic"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower <https://www.insperity.com/taxonomy/core-measure/accuracy>, <https://www.insperity.com/taxonomy/core-measure/completeness>,
      <https://www.insperity.com/taxonomy/core-measure/consistency>, <https://www.insperity.com/taxonomy/core-measure/timeliness>,
      <https://www.insperity.com/taxonomy/core-measure/uniqueness>, <https://www.insperity.com/taxonomy/core-measure/validity> .
  
  <https://www.insperity.com/taxonomy/core-measure/actual-value> a skos:Concept;
    skos:prefLabel "Actual value"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An observation that records what occurred."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-measure/>;
    skos:broader <https://www.insperity.com/taxonomy/core-measure/observation>;
    skos:altLabel "Actual"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-measure/aggregation-calculation> a skos:Concept;
    skos:prefLabel "Aggregation calculation"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A calculation that summarizes many values into one, such as a sum, count, or average."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-measure/>;
    skos:broader <https://www.insperity.com/taxonomy/core-measure/calculation>;
    skos:altLabel "Aggregate"@en, "Rollup"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-measure/alert-threshold> a skos:Concept;
    skos:prefLabel "Alert threshold"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A threshold that triggers a notification for attention."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-measure/>;
    skos:broader <https://www.insperity.com/taxonomy/core-measure/threshold>;
    skos:altLabel "Warning threshold"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-measure/allocation-calculation> a skos:Concept;
