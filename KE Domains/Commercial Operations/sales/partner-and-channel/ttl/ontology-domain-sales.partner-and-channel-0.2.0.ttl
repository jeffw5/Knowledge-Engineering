<https://www.insperity.com/ontology/domain-sales.partner-and-channel/>
  a owl:Ontology ;
  rdfs:label "Domain Sales.Partner & Channel Ontology"@en ;
  dct:title "Domain Sales.Partner & Channel Ontology"@en ;
  dct:description "The partner and channel ontology, an L2 domain of Domain Sales. It extends the core domain ontology, the Commercial Operations ontology and the Domain Sales ontology with the channel partner role borne by organizations and the partner programs that govern how partners refer, sell and are rewarded."@en ;
