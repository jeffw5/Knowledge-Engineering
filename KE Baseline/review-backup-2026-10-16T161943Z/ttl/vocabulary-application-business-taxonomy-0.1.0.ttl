  dct:created "2025-08-01T19:10:10.510Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:retail
  a skos:Concept ;
  skos:prefLabel "Retail"@en ;
  skos:definition "Physical store locations where customers can interact with staff for assistance or information."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:care-channel ;
  owl:versionInfo "0.1.0" ;
