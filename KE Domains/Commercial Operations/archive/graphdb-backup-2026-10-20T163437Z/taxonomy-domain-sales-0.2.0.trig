<https://www.insperity.com/taxonomy/domain-sales/> {
  <https://www.insperity.com/taxonomy/domain-sales/> a skos:ConceptScheme;
    rdfs:label "Domain sales taxonomy"@en;
    skos:prefLabel "Domain sales taxonomy"@en;
    skos:hasTopConcept domainsalestax:buying-committee, domainsalestax:buying-role, domainsalestax:sales-measure,
      domainsalestax:sales-plan, domainsalestax:sales-record, domainsalestax:sales-role,
      domainsalestax:selling-activity, domainsalestax:selling-stage;
    terms:description "A classification of the selling process stages (the provider's view of the buyer's journey), selling activities, buying and sales roles, sales plans, records and measures."@en;
    terms:title "Domain sales taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T02:31:43Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-19): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.9 (Draft), Part III."@en;
    terms:created "2026-10-20"^^xsd:date;
    skos:altLabel "Sales domain taxonomy"@en;
    owl:versionInfo "0.1.0";
    terms:subject domaintax:EnterpriseArchitecture;
    owl:versionIRI <https://www.insperity.com/taxonomy/domain-sales/0.1.0/>;
    terms:source <https://www.insperity.com/vocabulary/core-asset/>, <https://www.insperity.com/vocabulary/core-domain/>,
      <https://www.insperity.com/vocabulary/core-event/>, <https://www.insperity.com/vocabulary/core-lifecycle/>,
      <https://www.insperity.com/vocabulary/core-location/>, <https://www.insperity.com/vocabulary/core-process/>,
      <https://www.insperity.com/vocabulary/core-role/>, <https://www.insperity.com/vocabulary/core-time/>,
      <https://www.insperity.com/vocabulary/domain-sales/>, <https://www.insperity.com/vocabulary/core-decision/>,
      <https://www.insperity.com/vocabulary/core-governance/>, <https://www.insperity.com/vocabulary/core-measure/>,
      <https://www.insperity.com/vocabulary/core-value/>, <https://www.insperity.com/vocabulary/domain-commercial-operations/>;
    vaem:namespace "https://www.insperity.com/taxonomy/domain-sales/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft;
    vann:preferredNamespacePrefix "domainsalestax";
    terms:publisher <https://www.insperity.com/resource/core/Organization/insperity>;
    terms:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/> .
  
  domainsalestax:buying-committee a skos:Concept;
    rdfs:label "Buying committee"@en;
    skos:prefLabel "Buying committee"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T02:31:43Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A group of persons at a buyer who together bear the buying roles in a purchase decision."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/>;
    owl:versionInfo "0.1.0";
    terms:subject governancevoc:buying-committee, domaincommercialoperationsvoc:buying-committee;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-sales/>;
    core:formalizedBy core:organization .
  
  domainsalestax:buying-role a skos:Concept;
    rdfs:label "Buying role"@en;
    skos:prefLabel "Buying role"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T02:31:43Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A role borne by a person at a buyer that shapes how the buyer reaches its decision."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/>;
    skos:scopeNote "Buying roles are roles in a purchase decision, not personas (Baseline decisions 22 and 23): a persona instance may bear one in a given opportunity."@en;
    owl:versionInfo "0.1.0";
    terms:subject rolevoc:buying-role, domaincommercialoperationsvoc:buying-role;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-sales/>;
    skos:narrower domainsalestax:champion, domainsalestax:decision-maker, domainsalestax:economic-buyer,
      domainsalestax:gatekeeper, domainsalestax:influencer;
    core:formalizedBy core:role;
    skos:broadMatch roletax:commercial-role .
  
  domainsalestax:sales-measure a skos:Concept;
    rdfs:label "Sales measure"@en;
    skos:prefLabel "Sales measure"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T02:31:43Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A measure of the performance of selling."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/>;
    owl:versionInfo "0.1.0";
    terms:subject domainvoc:sales-measure, measurevoc:sales-measure;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-sales/>;
    skos:narrower domainsalestax:average-opportunity-size, domainsalestax:quota, domainsalestax:quota-attainment,
      domainsalestax:sales-cycle-length, domainsalestax:sales-forecast, domainsalestax:worksite-employees-sold;
    core:formalizedBy core:measure;
    skos:broadMatch measuretax:key-performance-indicator .
  
  domainsalestax:sales-plan a skos:Concept;
    rdfs:label "Sales plan"@en;
    skos:prefLabel "Sales plan"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T02:31:43Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A directive that sets how sellers will pursue accounts, territories or leads."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/>;
    owl:versionInfo "0.1.0";
    terms:subject domainvoc:sales-plan, processvoc:sales-plan;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-sales/>;
    skos:narrower domainsalestax:account-plan, domainsalestax:cadence, domainsalestax:sales-incentive,
      domainsalestax:territory-plan;
    core:formalizedBy core:directive .
  
  domainsalestax:sales-record a skos:Concept;
    rdfs:label "Sales record"@en;
    skos:prefLabel "Sales record"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T02:31:43Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "An information asset that records the outcome of selling."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/>;
    owl:versionInfo "0.1.0";
    terms:subject assetvoc:sales-record, domainvoc:sales-record;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-sales/>;
    skos:narrower domainsalestax:booking;
    core:formalizedBy core:information-asset .
  
  domainsalestax:sales-role a skos:Concept;
    rdfs:label "Sales role"@en;
    skos:prefLabel "Sales role"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T02:31:43Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A role borne by a person in the organization who sells its offerings."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/>;
    owl:versionInfo "0.1.0";
    terms:subject domainvoc:sales-role, rolevoc:sales-role;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-sales/>;
    skos:narrower domainsalestax:sales-executive, domainsalestax:sales-manager, domainsalestax:sales-representative;
    core:formalizedBy core:role;
    skos:broadMatch roletax:employment-role .
  
  domainsalestax:selling-activity a skos:Concept;
    rdfs:label "Selling activity"@en;
    skos:prefLabel "Selling activity"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T02:31:43Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A process step a seller performs to find, advance or close opportunities."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/>;
    owl:versionInfo "0.1.0";
    terms:subject domainvoc:selling-activity, processvoc:selling-activity;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-sales/>;
    skos:narrower domainsalestax:client-handoff, domainsalestax:demonstration, domainsalestax:objection-handling,
      domainsalestax:outreach, domainsalestax:prospecting;
    core:formalizedBy core:process-step .
  
  domainsalestax:selling-stage a skos:Concept;
    rdfs:label "Selling stage"@en;
    skos:prefLabel "Selling stage"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T02:31:43Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A process step of the selling process: the provider's view of where an opportunity stands in the buyer's journey."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/>;
    skos:scopeNote "Buying stages are the provider's point of view (Baseline decision 21). A stage may address one or more of the buyer persona's jobs or job steps; it must not be confused with those job steps, and the mismatch between them is where value gaps are created."@en;
    owl:versionInfo "0.1.0";
    terms:subject domainvoc:selling-stage, domaincommercialoperationsvoc:selling-stage;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-sales/>;
    skos:narrower domainsalestax:decide, domainsalestax:discover, domainsalestax:evaluate,
      domainsalestax:onboard, domainsalestax:propose, domainsalestax:qualify;
    core:formalizedBy domainsales:selling-step;
    skos:broadMatch processtax:process-step .
  
  domainsalestax:champion a skos:Concept;
    rdfs:label "Champion"@en;
    skos:prefLabel "Champion"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T02:31:43Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A buying role borne by a person who advocates internally for the organization's offering."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/>;
    skos:broader domainsalestax:buying-role;
    owl:versionInfo "0.1.0";
    terms:subject domainsalesvoc:champion;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm domainsalesvoc:champion .
  
  domainsalestax:decision-maker a skos:Concept;
    rdfs:label "Decision maker"@en;
    skos:prefLabel "Decision maker"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T02:31:43Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A buying role borne by a person with authority to commit the buyer to an agreement."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/>;
    skos:broader domainsalestax:buying-role;
    owl:versionInfo "0.1.0";
    terms:subject domainsalesvoc:decision-maker;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm domainsalesvoc:decision-maker .
  
  domainsalestax:economic-buyer a skos:Concept;
    rdfs:label "Economic buyer"@en;
    skos:prefLabel "Economic buyer"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T02:31:43Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A buying role borne by the person who controls the budget the purchase is paid from."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/>;
    skos:broader domainsalestax:buying-role;
    owl:versionInfo "0.1.0";
    terms:subject valuevoc:economic-buyer, domaincommercialoperationsvoc:economic-buyer;
    core:hasLifecycleStatus core:Draft .
  
  domainsalestax:gatekeeper a skos:Concept;
    rdfs:label "Gatekeeper"@en;
