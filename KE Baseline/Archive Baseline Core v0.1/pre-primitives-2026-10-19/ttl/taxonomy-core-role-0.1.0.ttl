roletax:KnowledgeEngineeringRole
  a skos:Concept ;
  rdfs:label "Knowledge engineering role"@en ;
  skos:prefLabel "Knowledge engineering role"@en ;
  skos:altLabel "Design-time role"@en ;
  skos:definition "A role that builds, reviews, or maintains governed knowledge artifacts."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core-role/> ;
  skos:topConceptOf <https://www.insperity.com/taxonomy/core-role/> ;
  skos:narrower roletax:DraftingAssistant ,
      roletax:KnowledgeEngineer ,
      roletax:SubjectMatterExpert ;
  core:formalizedBy core:PartyRole ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-17T01:38:18Z"^^xsd:dateTime ;
  dct:modified "2026-10-19T02:19:17Z"^^xsd:dateTime .

roletax:DraftingAssistant
  a skos:Concept ;
  rdfs:label "Drafting assistant"@en ;
  skos:prefLabel "Drafting assistant"@en ;
  skos:altLabel "AI drafting assistant"@en ;
  skos:definition "A knowledge engineering role borne by an artificial intelligence agent that drafts definitions, labels, mappings, and shapes for human review and never commits on its own."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core-role/> ;
  skos:broader roletax:KnowledgeEngineeringRole ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-17T01:38:18Z"^^xsd:dateTime ;
  dct:modified "2026-10-18T00:25:49Z"^^xsd:dateTime .

roletax:KnowledgeEngineer
  a skos:Concept ;
  rdfs:label "Knowledge engineer"@en ;
  skos:prefLabel "Knowledge engineer"@en ;
  skos:definition "A knowledge engineering role borne by the person who builds and extends ontologies under the naming, URI, and definition standards."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core-role/> ;
  skos:broader roletax:KnowledgeEngineeringRole ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-17T01:38:18Z"^^xsd:dateTime ;
  dct:modified "2026-10-18T00:25:49Z"^^xsd:dateTime .

roletax:SubjectMatterExpert
  a skos:Concept ;
  rdfs:label "Subject matter expert"@en ;
  skos:prefLabel "Subject matter expert"@en ;
  skos:altLabel "Domain expert"@en , "SME"@en ;
  skos:definition "A knowledge engineering role borne by the person who confirms definitions, rules, and relationships for a domain."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core-role/> ;
  skos:broader roletax:KnowledgeEngineeringRole ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-17T01:38:18Z"^^xsd:dateTime ;
  dct:modified "2026-10-18T00:25:49Z"^^xsd:dateTime .

roletax:PlanRole
  a skos:Concept ;
  rdfs:label "Plan role"@en ;
  skos:prefLabel "Plan role"@en ;
  skos:altLabel "Benefit plan role"@en ;
  skos:definition "A role that arises from participation in a benefit, retirement, or insurance plan."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core-role/> ;
  skos:topConceptOf <https://www.insperity.com/taxonomy/core-role/> ;
  skos:narrower roletax:Beneficiary ,
      roletax:Dependent ,
      roletax:PlanAdministrator ,
      roletax:PlanParticipant ,
      roletax:PlanSponsor ;
  core:formalizedBy core:PartyRole ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-17T01:38:18Z"^^xsd:dateTime ;
  dct:modified "2026-10-19T02:19:17Z"^^xsd:dateTime .

roletax:Beneficiary
  a skos:Concept ;
  rdfs:label "Beneficiary"@en ;
  skos:prefLabel "Beneficiary"@en ;
  skos:altLabel "Designated beneficiary"@en ;
  skos:definition "A plan role borne by a party designated to receive a benefit on a participant's death."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core-role/> ;
