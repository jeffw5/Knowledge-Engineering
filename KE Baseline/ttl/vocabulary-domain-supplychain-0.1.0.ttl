voc:planning
  a skos:Concept ;
  skos:prefLabel "Planning"@en ;
  skos:definition "The process of setting goals and objectives and developing strategies to achieve them."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-supplychain/> ;
  skos:broader voc:supply-chain ;
