# Core domain ontology: authored source
# Edit this file, then run   python3 ingest/build_core.py   to publish ontology-core-<version>.ttl/.trig
# and shapes-core-<version>.ttl/.trig into KE Baseline. The build adds rdfs:label, rdfs:isDefinedBy and the
# governance fields (status, version, creator, created, modified) to every term, so they are not written here.
#
# Design (Semantic Governance v1.9 Part III, §3.1, §3.9, §3.10):
#   BFO 2020 (ISO/IEC 21838-2)  <-  RO Core + RO extract  <-  this ontology  <-  domain ontologies
#   * every class has a named BFO parent (rdfs:subClassOf), directly or through another core class;
#   * every object property specializes a BFO or RO relation (rdfs:subPropertyOf);
#   * the process step is the anchor: each core class is tied to core:ProcessStep by one relation,
#     drawn as a class restriction here and checked by the SHACL shapes in shapes-core.source.ttl;
#   * no rdfs:domain / rdfs:range on core relations (§3.9: they infer types, they do not validate);
#     the BFO/RO parents already carry the upper-level signature;
#   * taxonomy concepts point here with core:formalizedBy; vocabulary terms are reached with core:hasPrimaryTerm.

@prefix core: <https://www.insperity.com/ontology/core/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix processvoc: <https://www.insperity.com/vocabulary/core-process/> .
@prefix partyvoc: <https://www.insperity.com/vocabulary/core-party/> .
@prefix rolevoc: <https://www.insperity.com/vocabulary/core-role/> .
@prefix assetvoc: <https://www.insperity.com/vocabulary/core-asset/> .
@prefix locationvoc: <https://www.insperity.com/vocabulary/core-location/> .
@prefix timevoc: <https://www.insperity.com/vocabulary/core-time/> .
@prefix eventvoc: <https://www.insperity.com/vocabulary/core-event/> .
@prefix issuevoc: <https://www.insperity.com/vocabulary/core-issue/> .
@prefix productvoc: <https://www.insperity.com/vocabulary/core-product/> .
@prefix servicesvoc: <https://www.insperity.com/vocabulary/core-services/> .
@prefix capabilityvoc: <https://www.insperity.com/vocabulary/core-capability/> .
@prefix personavoc: <https://www.insperity.com/vocabulary/core-persona/> .
@prefix domainvoc: <https://www.insperity.com/vocabulary/core-domain/> .
@prefix rulesvoc: <https://www.insperity.com/vocabulary/core-rules/> .
@prefix requirementsvoc: <https://www.insperity.com/vocabulary/core-requirements/> .
@prefix lifecyclevoc: <https://www.insperity.com/vocabulary/core-lifecycle/> .
@prefix valuestreamvoc: <https://www.insperity.com/vocabulary/core-valuestream/> .
@prefix compliancevoc: <https://www.insperity.com/vocabulary/core-compliance/> .

# ───────────────────────────── header ─────────────────────────────
<https://www.insperity.com/ontology/core/>
  a owl:Ontology ;
  dct:title "Core domain ontology"@en ;
  skos:altLabel "Core ontology"@en ;
  dct:identifier "ontology-core" ;
  dct:description "The ontology of the classes and relations shared by every domain of the company. It is aligned to Basic Formal Ontology 2020 (ISO/IEC 21838-2): each class specializes a BFO class and each relation specializes a BFO or Relation Ontology relation. It is anchored on the process step, so every domain ontology extends it and every fact can be traced to the step in which it is created, used or governed."@en ;
  skos:scopeNote "Only this ontology ties into BFO. Core taxonomies reach BFO through core:formalizedBy on their concepts, and core vocabularies through core:hasPrimaryTerm on the classes here."@en ;
  owl:imports <http://purl.obolibrary.org/obo/bfo.owl> ,
      <http://purl.obolibrary.org/obo/ro/core.owl> ,
      <https://www.insperity.com/reference/ro-extract/> ;
  dct:created "2024-10-02"^^xsd:date .

# ───────────────────────────── governance (annotation properties) ─────────────────────────────
core:hasLifecycleStatus
  a owl:AnnotationProperty ;
  skos:prefLabel "has lifecycle status"@en ;
  skos:definition "A relation between a term or asset and the lifecycle status it is in."@en .

core:hasPrimaryTerm
  a owl:AnnotationProperty ;
  rdfs:subPropertyOf dct:subject ;
  skos:prefLabel "has primary term"@en ;
  skos:definition "A relation between a class or taxonomy concept and the one vocabulary term that names it."@en .

core:formalizedBy
  a owl:AnnotationProperty ;
  skos:prefLabel "formalized by"@en ;
  skos:definition "A relation between a taxonomy concept and the core or domain ontology class that gives it a formal, BFO-aligned meaning."@en ;
  skos:scopeNote "Taxonomies stay in SKOS (§3.11). A concept is not a subclass of anything; formalized by is the path from a taxonomy to BFO."@en .

core:hasTermType
  a owl:AnnotationProperty ;
  skos:prefLabel "has term type"@en ;
  skos:definition "A relation between a vocabulary term and the kind of term it is."@en .

core:intendedForPersona
  a owl:AnnotationProperty ;
  skos:prefLabel "intended for persona"@en ;
  skos:definition "A relation between a label or definition and the persona it is written for."@en .

core:LifecycleStatus
  a owl:Class ;
  rdfs:subClassOf obo:BFO_0000031 ;
  skos:prefLabel "Lifecycle status"@en ;
  skos:definition "A generically dependent continuant that states which governance stage a term or asset is in: draft, candidate, released, deprecated or retired."@en .

core:Draft a core:LifecycleStatus ; skos:prefLabel "Draft"@en ;
  skos:definition "A lifecycle status of a term or asset that is being written and is not yet ready for review."@en .
core:Candidate a core:LifecycleStatus ; skos:prefLabel "Candidate"@en ;
  skos:definition "A lifecycle status of a term or asset that is complete and under review for release."@en .
core:Released a core:LifecycleStatus ; skos:prefLabel "Released"@en ;
  skos:definition "A lifecycle status of a term or asset that is approved and may be used."@en .
core:Deprecated a core:LifecycleStatus ; skos:prefLabel "Deprecated"@en ;
  skos:definition "A lifecycle status of a term or asset that is still published but should no longer be used for new work."@en .
core:Retired a core:LifecycleStatus ; skos:prefLabel "Retired"@en ;
  skos:definition "A lifecycle status of a term or asset that is withdrawn and kept only for traceability."@en .

# ───────────────────────────── occurrents ─────────────────────────────
core:Process
  a owl:Class ;
  rdfs:subClassOf obo:BFO_0000015 ;
  skos:prefLabel "Process"@en ;
  skos:definition "A process that the organization carries out, or has carried out on its behalf, to achieve a defined outcome, and that is made up of process steps."@en ;
  core:hasPrimaryTerm processvoc:process .

core:ProcessStep
  a owl:Class ;
  rdfs:subClassOf core:Process ,
      [ a owl:Restriction ; owl:onProperty core:isStepOf ; owl:someValuesFrom core:Process ] ,
      [ a owl:Restriction ; owl:onProperty core:performedBy ; owl:allValuesFrom core:Party ] ,
      [ a owl:Restriction ; owl:onProperty core:fulfillsRole ; owl:allValuesFrom core:Role ] ,
      [ a owl:Restriction ; owl:onProperty core:exercisesCapability ; owl:allValuesFrom core:Capability ] ,
      [ a owl:Restriction ; owl:onProperty core:governedBy ; owl:allValuesFrom core:Directive ] ,
      [ a owl:Restriction ; owl:onProperty core:measuredBy ; owl:allValuesFrom core:Measure ] ,
      [ a owl:Restriction ; owl:onProperty core:hasIssue ; owl:allValuesFrom core:Issue ] ,
      [ a owl:Restriction ; owl:onProperty core:triggeredBy ; owl:allValuesFrom core:Event ] ,
      [ a owl:Restriction ; owl:onProperty core:precedes ; owl:allValuesFrom core:ProcessStep ] ,
      [ a owl:Restriction ; owl:onProperty core:occursIn ; owl:allValuesFrom core:Location ] ,
      [ a owl:Restriction ; owl:onProperty core:occupiesTime ; owl:allValuesFrom core:Time ] ;
  skos:prefLabel "Process step"@en ;
  skos:altLabel "Activity"@en , "Task"@en ;
  skos:definition "A process that is a bounded part of a larger process, performed by a party in a role, consuming and producing continuants, and to which every other fact in the unifying ontology is anchored."@en ;
  skos:scopeNote "The anchor of the unifying ontology (§3.1): parties, roles, assets, directives, measures, issues, events, locations and times are each tied to the step in which they are created, used or governed."@en ;
  core:hasPrimaryTerm processvoc:process-step .

core:ValueStream
  a owl:Class ;
  rdfs:subClassOf core:Process ;
  skos:prefLabel "Value stream"@en ;
  skos:definition "A process that delivers a product or service to a customer from end to end, made up of the process steps that each add value."@en ;
  core:hasPrimaryTerm valuestreamvoc:value-stream .

core:Service
  a owl:Class ;
  rdfs:subClassOf core:Process ;
  skos:prefLabel "Service"@en ;
  skos:altLabel "Services"@en ;
  skos:definition "A process in which one party performs work for the benefit of another party, typically in exchange for payment."@en ;
  core:hasPrimaryTerm servicesvoc:services .

core:Decision
  a owl:Class ;
  rdfs:subClassOf core:Process ;
  skos:prefLabel "Decision"@en ;
  skos:definition "A process in which a party chooses one course of action from among alternatives, following a decision model or rule."@en .

core:Lifecycle
  a owl:Class ;
  rdfs:subClassOf core:Process ;
  skos:prefLabel "Lifecycle"@en ;
  skos:definition "A process that takes one continuant, such as an asset, an agreement or a party relationship, from its creation through a series of phases to its retirement."@en ;
  core:hasPrimaryTerm lifecyclevoc:lifecycle .

core:LifecyclePhase
  a owl:Class ;
  rdfs:subClassOf core:Process ,
      [ a owl:Restriction ; owl:onProperty core:isPhaseOf ; owl:someValuesFrom core:Lifecycle ] ;
  skos:prefLabel "Lifecycle phase"@en ;
  skos:definition "A process that is a bounded part of a lifecycle during which the continuant it concerns keeps one status."@en .

core:Event
  a owl:Class ;
  rdfs:subClassOf obo:BFO_0000035 ,
      [ a owl:Restriction ; owl:onProperty core:triggers ; owl:allValuesFrom core:ProcessStep ] ;
  skos:prefLabel "Event"@en ;
  skos:altLabel "Events"@en ;
  skos:definition "A process boundary at which something significant to the organization happens, such as a request arriving or a deadline passing, and which can trigger a process step."@en ;
  skos:scopeNote "Modeled as a BFO process boundary (an instantaneous occurrent): what happens over time is a process step; the moment that starts or ends it is an event."@en ;
  core:hasPrimaryTerm eventvoc:events .

# ───────────────────────────── independent continuants ─────────────────────────────
core:Party
  a owl:Class ;
  rdfs:subClassOf obo:BFO_0000040 ,
      [ a owl:Restriction ; owl:onProperty core:locatedIn ; owl:allValuesFrom core:Location ] ;
  skos:prefLabel "Party"@en ;
  skos:definition "A material entity, either a person or an organization, that can take part in process steps and bear roles such as employee, client or supplier."@en ;
  core:hasPrimaryTerm partyvoc:party .

core:Person
  a owl:Class ;
  rdfs:subClassOf core:Party , obo:BFO_0000030 ;
  skos:prefLabel "Person"@en ;
  skos:definition "A party that is a single human being."@en ;
  core:hasPrimaryTerm partyvoc:person .

core:Organization
  a owl:Class ;
  rdfs:subClassOf core:Party , obo:BFO_0000027 ,
      [ a owl:Restriction ; owl:onProperty core:hasMember ; owl:allValuesFrom core:Party ] ;
  skos:prefLabel "Organization"@en ;
  skos:definition "A party that is an aggregate of persons organized for a common purpose, such as a company, a government agency or a charity."@en ;
  core:hasPrimaryTerm partyvoc:organization .

core:PhysicalAsset
  a owl:Class ;
  rdfs:subClassOf obo:BFO_0000040 ,
      [ a owl:Restriction ; owl:onProperty core:hasRole ; owl:someValuesFrom core:AssetRole ] ;
  skos:prefLabel "Physical asset"@en ;
  skos:definition "A material entity that bears an asset role, such as equipment, a building or a vehicle."@en ;
  core:hasPrimaryTerm assetvoc:physical-asset .

core:Location
  a owl:Class ;
  rdfs:subClassOf obo:BFO_0000029 ;
  skos:prefLabel "Location"@en ;
  skos:definition "A site at which a party or asset is located or a process step occurs, such as an office, a work site or a geographic area."@en ;
  skos:scopeNote "A physical place. An address, a web address or a channel that identifies a place is a location reference."@en ;
  core:hasPrimaryTerm locationvoc:location .

# ───────────────────────────── realizable entities ─────────────────────────────
core:Role
  a owl:Class ;
  rdfs:subClassOf obo:BFO_0000023 ;
  skos:prefLabel "Role"@en ;
  skos:definition "A role that an independent continuant bears because of the organizational, legal or social situation it is in, and that is realized in the process steps it takes part in."@en ;
  core:hasPrimaryTerm rolevoc:role .

core:PartyRole
  a owl:Class ;
  rdfs:subClassOf core:Role ;
  skos:prefLabel "Party role"@en ;
  skos:definition "A role that a party bears, such as employee, client, supplier or approver."@en .

core:AssetRole
  a owl:Class ;
  rdfs:subClassOf core:Role ;
  skos:prefLabel "Asset role"@en ;
  skos:definition "A role that an independent continuant bears when the organization controls it and expects future economic benefit from it."@en ;
  skos:scopeNote "Asset as a role: an asset is anything that bears an asset role, so one thing can become, and stop being, an asset without changing class. An information asset cannot bear a role itself (BFO); its asset role is borne by the carriers it is concretized in."@en ;
  core:hasPrimaryTerm assetvoc:asset .

core:Capability
  a owl:Class ;
  rdfs:subClassOf obo:BFO_0000016 ;
  skos:prefLabel "Capability"@en ;
  skos:definition "A disposition of an organization, borne through its people, processes and technology, to carry out a kind of process step to a measurable level."@en ;
  core:hasPrimaryTerm capabilityvoc:capability .

# ───────────────────────────── generically dependent continuants ─────────────────────────────
core:InformationAsset
  a owl:Class ;
  rdfs:subClassOf obo:BFO_0000031 ;
  skos:prefLabel "Information asset"@en ;
  skos:altLabel "Digital asset"@en ;
  skos:definition "A generically dependent continuant, such as a data set, a document, a model or a piece of software, that the organization controls and expects future economic benefit from."@en ;
  skos:scopeNote "Its asset role is borne by the carriers (files, databases, devices) it is concretized in."@en ;
  core:hasPrimaryTerm assetvoc:digital-asset .

core:SoftwareAsset
  a owl:Class ;
  rdfs:subClassOf core:InformationAsset ;
  skos:prefLabel "Software asset"@en ;
  skos:definition "An information asset that is a set of instructions a computer can execute."@en .

core:Product
  a owl:Class ;
  rdfs:subClassOf obo:BFO_0000031 ;
  skos:prefLabel "Product"@en ;
  skos:definition "A generically dependent continuant that specifies a good or service the organization offers to the market to meet a customer need."@en ;
  skos:scopeNote "The offering, not the delivery: delivering a product is a service (a process) or the hand-over of a physical asset."@en ;
  core:hasPrimaryTerm productvoc:product .

core:LocationReference
  a owl:Class ;
  rdfs:subClassOf obo:BFO_0000031 ;
  skos:prefLabel "Location reference"@en ;
  skos:definition "A generically dependent continuant that identifies a location or a virtual place where a process step occurs, such as a postal address, a web address or a communication channel."@en .

core:Persona
  a owl:Class ;
  rdfs:subClassOf obo:BFO_0000031 ,
      [ a owl:Restriction ; owl:onProperty core:characterizes ; owl:allValuesFrom core:PartyRole ] ;
  skos:prefLabel "Persona"@en ;
  skos:definition "A generically dependent continuant that describes a typical party in a role, with its goals and needs, so that terms, services and products can be designed for it."@en ;
  core:hasPrimaryTerm personavoc:persona .

core:Domain
  a owl:Class ;
  rdfs:subClassOf obo:BFO_0000031 ;
  skos:prefLabel "Domain"@en ;
  skos:definition "A subject area of the business, such as Payroll or Benefits, whose terms, rules, and relationships specialize the core ontology and are owned by a domain owner and released together as one knowledge component."@en ;
  skos:scopeNote "A domain is information content (a generically dependent continuant in BFO): the body of knowledge about a subject area, not the people or systems that work in it."@en ;
  core:hasPrimaryTerm domainvoc:domain ;
  dct:created "2024-10-02T01:08:09.624Z"^^xsd:dateTime .

core:Issue
  a owl:Class ;
  rdfs:subClassOf obo:BFO_0000031 ;
  skos:prefLabel "Issue"@en ;
  skos:definition "A generically dependent continuant that records a problem, risk, concern or question arising in a process step that needs to be addressed."@en ;
  skos:scopeNote "The issue as recorded. The occurrence behind it (an outage, a complaint being made) is an event or a process step."@en ;
  core:hasPrimaryTerm issuevoc:issue .

core:Measure
  a owl:Class ;
  rdfs:subClassOf obo:BFO_0000031 ;
  skos:prefLabel "Measure"@en ;
  skos:definition "A generically dependent continuant that states a quantity observed, calculated, targeted or forecast for a process step, a party or an asset, such as a cycle time, a count or a threshold."@en .

core:Time
  a owl:Class ;
  rdfs:subClassOf obo:BFO_0000008 ;
  skos:prefLabel "Time"@en ;
  skos:definition "A temporal region that a process step or event occupies, such as an instant or an interval."@en ;
  skos:scopeNote "A duration is a measure of a time, and a schedule is a directive; neither is a time."@en ;
  core:hasPrimaryTerm timevoc:time .

core:Directive
  a owl:Class ;
  rdfs:subClassOf obo:BFO_0000031 ;
  skos:prefLabel "Directive"@en ;
  skos:definition "A generically dependent continuant that prescribes how process steps are to be carried out, such as a policy, a rule, a requirement or a control."@en .

core:Policy
  a owl:Class ;
  rdfs:subClassOf core:Directive ;
  skos:prefLabel "Policy"@en ;
  skos:definition "A directive that states the intent of the organization or of an authority, and the principles its process steps must follow."@en .

core:Rule
  a owl:Class ;
  rdfs:subClassOf core:Directive ;
  skos:prefLabel "Rule"@en ;
  skos:altLabel "Rules"@en ;
  skos:definition "A directive that states a condition and the action or constraint that follows from it, precisely enough to be evaluated or automated."@en ;
  core:hasPrimaryTerm rulesvoc:rules .

core:Requirement
  a owl:Class ;
  rdfs:subClassOf core:Directive ;
  skos:prefLabel "Requirement"@en ;
  skos:definition "A directive that states a need that a product, service or process step must fulfill."@en ;
  core:hasPrimaryTerm requirementsvoc:requirement .

core:ComplianceObligation
  a owl:Class ;
  rdfs:subClassOf core:Directive ;
  skos:prefLabel "Compliance obligation"@en ;
  skos:definition "A directive that obliges the organization to meet a law, regulation, contract or standard, and against which its process steps are assessed."@en ;
  core:hasPrimaryTerm compliancevoc:compliance .

core:Control
  a owl:Class ;
  rdfs:subClassOf core:Directive ;
  skos:prefLabel "Control"@en ;
  skos:definition "A directive that specifies a check or safeguard applied in a process step to keep a risk or an obligation within accepted limits."@en .

core:DecisionModel
  a owl:Class ;
  rdfs:subClassOf core:Directive ;
  skos:prefLabel "Decision model"@en ;
  skos:definition "A directive that specifies how a decision is to be made, from its inputs, rules and possible outcomes."@en .

core:BusinessLogic
  a owl:Class ;
  rdfs:subClassOf core:Directive ;
  skos:prefLabel "Business logic"@en ;
  skos:definition "A directive that specifies the flow, calculation or reasoning a process step follows, for execution by people or software."@en .

# ───────────────────────────── relations ─────────────────────────────
# Each specializes a BFO 2020 or RO relation. Inverses are declared once, on the first of the pair.

core:hasStep
  a owl:ObjectProperty ;
  rdfs:subPropertyOf obo:BFO_0000117 ;
  owl:inverseOf core:isStepOf ;
  skos:prefLabel "has step"@en ;
  skos:definition "A relation between a process and a process step that is one of its bounded parts."@en .

core:isStepOf
  a owl:ObjectProperty ;
  rdfs:subPropertyOf obo:BFO_0000132 ;
  skos:prefLabel "is step of"@en ;
  skos:definition "A relation between a process step and the process it is a bounded part of."@en .

core:hasPhase
  a owl:ObjectProperty ;
  rdfs:subPropertyOf obo:BFO_0000117 ;
  owl:inverseOf core:isPhaseOf ;
  skos:prefLabel "has phase"@en ;
  skos:definition "A relation between a lifecycle and a lifecycle phase that is one of its parts."@en .

core:isPhaseOf
  a owl:ObjectProperty ;
  rdfs:subPropertyOf obo:BFO_0000132 ;
  skos:prefLabel "is phase of"@en ;
  skos:definition "A relation between a lifecycle phase and the lifecycle it is part of."@en .

core:precedes
  a owl:ObjectProperty ;
  rdfs:subPropertyOf obo:BFO_0000063 ;
  owl:inverseOf core:follows ;
  skos:prefLabel "precedes"@en ;
  skos:definition "A relation between a process step and a process step that starts after it ends, in the same process."@en .

core:follows
  a owl:ObjectProperty ;
  rdfs:subPropertyOf obo:BFO_0000062 ;
  skos:prefLabel "follows"@en ;
  skos:definition "A relation between a process step and a process step that ends before it starts, in the same process."@en .

core:triggers
  a owl:ObjectProperty ;
  rdfs:subPropertyOf obo:BFO_0000063 ;
  owl:inverseOf core:triggeredBy ;
  skos:prefLabel "triggers"@en ;
  skos:definition "A relation between an event and a process step that starts because the event happened."@en .

core:triggeredBy
  a owl:ObjectProperty ;
  rdfs:subPropertyOf obo:BFO_0000062 ;
  skos:prefLabel "triggered by"@en ;
  skos:definition "A relation between a process step and the event that started it."@en .

core:performedBy
  a owl:ObjectProperty ;
  rdfs:subPropertyOf obo:RO_0000057 ;
  owl:inverseOf core:performs ;
  skos:prefLabel "performed by"@en ;
  skos:definition "A relation between a process step and a party that carries it out."@en .

core:performs
  a owl:ObjectProperty ;
  rdfs:subPropertyOf obo:RO_0000056 ;
  skos:prefLabel "performs"@en ;
  skos:definition "A relation between a party and a process step it carries out."@en .

core:fulfillsRole
  a owl:ObjectProperty ;
  rdfs:subPropertyOf obo:BFO_0000055 ;
  skos:prefLabel "fulfills role"@en ;
  skos:definition "A relation between a process step and a role that is realized in it, such as the approver role in an approval step."@en .

core:exercisesCapability
  a owl:ObjectProperty ;
  rdfs:subPropertyOf obo:BFO_0000055 ;
  skos:prefLabel "exercises capability"@en ;
  skos:definition "A relation between a process step and a capability of the organization that is realized in it."@en .

core:consumes
  a owl:ObjectProperty ;
  rdfs:subPropertyOf obo:RO_0002233 ;
  skos:prefLabel "consumes"@en ;
  skos:definition "A relation between a process step and a continuant, such as a physical asset or a record, that is present at its start and is used or changed by it."@en ;
  skos:scopeNote "RO defines has input for material entities. When a step uses information, the input is the carrier (a file, a record, a database) that the information is concretized in."@en .

core:produces
  a owl:ObjectProperty ;
  rdfs:subPropertyOf obo:RO_0002234 ;
  skos:prefLabel "produces"@en ;
  skos:definition "A relation between a process step and a continuant, such as a record or a product, that it creates or changes."@en .

core:governs
  a owl:ObjectProperty ;
  rdfs:subPropertyOf obo:IAO_0000136 ;
  owl:inverseOf core:governedBy ;
  skos:prefLabel "governs"@en ;
  skos:definition "A relation between a directive and a process step whose conduct it prescribes."@en .

core:governedBy
  a owl:ObjectProperty ;
  skos:prefLabel "governed by"@en ;
  skos:definition "A relation between a process step and a directive that prescribes how it is carried out."@en .

core:measures
  a owl:ObjectProperty ;
  rdfs:subPropertyOf obo:IAO_0000136 ;
  owl:inverseOf core:measuredBy ;
  skos:prefLabel "measures"@en ;
  skos:definition "A relation between a measure and the process step, party or asset whose quantity it states."@en .

core:measuredBy
  a owl:ObjectProperty ;
  skos:prefLabel "measured by"@en ;
  skos:definition "A relation between a process step, party or asset and a measure that states one of its quantities."@en .

core:concerns
  a owl:ObjectProperty ;
  rdfs:subPropertyOf obo:IAO_0000136 ;
  owl:inverseOf core:hasIssue ;
  skos:prefLabel "concerns"@en ;
  skos:definition "A relation between an issue and the process step in which it arose or which it affects."@en .

core:hasIssue
  a owl:ObjectProperty ;
  skos:prefLabel "has issue"@en ;
  skos:definition "A relation between a process step and an issue that arose in it or affects it."@en .

core:characterizes
  a owl:ObjectProperty ;
  rdfs:subPropertyOf obo:IAO_0000136 ;
  skos:prefLabel "characterizes"@en ;
  skos:definition "A relation between a persona and the party role whose typical bearer it describes."@en .

core:occursIn
  a owl:ObjectProperty ;
  rdfs:subPropertyOf obo:BFO_0000066 ;
  skos:prefLabel "occurs in"@en ;
  skos:definition "A relation between a process step and the location where it takes place."@en .

core:occupiesTime
  a owl:ObjectProperty ;
  rdfs:subPropertyOf obo:BFO_0000199 ;
  skos:prefLabel "occupies time"@en ;
  skos:definition "A relation between a process step or event and the time it takes up."@en .

core:locatedIn
  a owl:ObjectProperty ;
  rdfs:subPropertyOf obo:BFO_0000171 ;
  skos:prefLabel "located in"@en ;
  skos:definition "A relation between a party or physical asset and the location it is in."@en .

core:hasRole
  a owl:ObjectProperty ;
  rdfs:subPropertyOf obo:RO_0000087 ;
  owl:inverseOf core:roleOf ;
  skos:prefLabel "has role"@en ;
  skos:definition "A relation between a party or physical asset and a role it bears."@en .

core:roleOf
  a owl:ObjectProperty ;
  rdfs:subPropertyOf obo:RO_0000081 ;
  skos:prefLabel "role of"@en ;
  skos:definition "A relation between a role and the party or physical asset that bears it."@en .

core:hasMember
  a owl:ObjectProperty ;
  rdfs:subPropertyOf obo:BFO_0000115 ;
  owl:inverseOf core:memberOf ;
  skos:prefLabel "has member"@en ;
  skos:definition "A relation between an organization and a party that is one of its members."@en .

core:memberOf
  a owl:ObjectProperty ;
  rdfs:subPropertyOf obo:BFO_0000129 ;
  skos:prefLabel "member of"@en ;
  skos:definition "A relation between a party and an organization it is a member of."@en .
