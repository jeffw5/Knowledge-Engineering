  assettax:VectorStore
    a skos:Concept ;
    rdfs:label "Vector store"@en ;
    skos:prefLabel "Vector store"@en ;
    skos:altLabel "Vector database"@en ;
    skos:definition "A data store that stores embeddings and supports similarity search."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/core-asset/> ;
    skos:broader assettax:DataStore ;
