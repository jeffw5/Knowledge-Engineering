<https://www.insperity.com/taxonomy/core-time/> {
  <https://www.insperity.com/taxonomy/core-time/> a skos:ConceptScheme;
    rdfs:label "Core time taxonomy"@en;
    skos:prefLabel "Core time taxonomy"@en;
    skos:hasTopConcept timetax:duration, timetax:instant, timetax:interval, timetax:schedule;
    terms:description "Classification of temporal entities, the instants, intervals, durations, and schedules used to date, sequence, and bound facts, rules, and process steps."@en;
    terms:title "Core time taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2026-10-14"^^xsd:dateTime;
    skos:altLabel "Time taxonomy"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/taxonomy/core-time/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  timetax:duration a skos:Concept;
    skos:prefLabel "Duration"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A temporal entity that is an amount of time without a fixed position on the time line."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-time/>;
    skos:altLabel "Length of time"@en, "Time span"@en;
    skos:example "Ninety days; forty hours."@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-time/>;
    skos:narrower timetax:notice-period, timetax:retention-period, timetax:service-level-duration,
      timetax:waiting-period .
  
  timetax:instant a skos:Concept;
    skos:prefLabel "Instant"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A temporal entity that is a single point on a time line with no duration."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-time/>;
    skos:altLabel "Point in time"@en, "Time instant"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-time/>;
    skos:narrower timetax:calendar-date, timetax:date-and-time, timetax:deadline, timetax:effective-date,
      timetax:end-date .
  
  timetax:interval a skos:Concept;
    skos:prefLabel "Interval"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A temporal entity that is a stretch of time with a beginning and an end."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-time/>;
    skos:altLabel "Period"@en, "Time interval"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-time/>;
    skos:narrower timetax:business-period, timetax:calendar-period, timetax:fiscal-period,
      timetax:reporting-period, timetax:time-window, timetax:validity-period .
  
  timetax:schedule a skos:Concept;
    skos:prefLabel "Schedule"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A temporal entity that specifies when recurring or planned occurrences happen."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-time/>;
    skos:altLabel "Timetable"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-time/>;
    skos:narrower timetax:business-calendar, timetax:one-time-schedule, timetax:recurring-schedule .
  
  timetax:business-calendar a skos:Concept;
    skos:prefLabel "Business calendar"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A schedule that defines working days, holidays, and cut-off times."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-time/>;
    skos:broader timetax:schedule;
    skos:altLabel "Holiday calendar"@en, "Working calendar"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  timetax:business-period a skos:Concept;
    skos:prefLabel "Business period"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An interval defined by a business cycle such as a pay, plan, coverage, or reporting cycle."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-time/>;
    skos:broader timetax:interval;
    skos:altLabel "Cycle period"@en;
    skos:scopeNote "Specialized in domain ontologies as pay period, plan year, coverage period, and so on."@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  timetax:calendar-date a skos:Concept;
    skos:prefLabel "Calendar date"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An instant identified at the precision of a day."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-time/>;
    skos:broader timetax:instant;
    skos:altLabel "Date"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  timetax:calendar-day a skos:Concept;
    skos:prefLabel "Calendar day"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A calendar period of one day from midnight to midnight in a time zone."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-time/>;
    skos:broader timetax:calendar-period;
    skos:altLabel "Day"@en;
    owl:versionInfo "0.1.0";
    dc:subject timevoc:day;
    core:hasLifecycleStatus core:Draft .
  
  timetax:calendar-period a skos:Concept;
    skos:prefLabel "Calendar period"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An interval aligned to the civil calendar."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-time/>;
    skos:broader timetax:interval;
    skos:altLabel "Calendar interval"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower timetax:calendar-day, timetax:calendar-month, timetax:calendar-quarter,
      timetax:calendar-week, timetax:calendar-year .
  
  timetax:calendar-month a skos:Concept;
    skos:prefLabel "Calendar month"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A calendar period corresponding to one month of the civil calendar."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-time/>;
    skos:broader timetax:calendar-period;
    skos:altLabel "Month"@en;
    owl:versionInfo "0.1.0";
    dc:subject timevoc:month;
    core:hasLifecycleStatus core:Draft .
  
  timetax:calendar-quarter a skos:Concept;
    skos:prefLabel "Calendar quarter"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A calendar period of three consecutive months beginning in January, April, July, or October."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-time/>;
    skos:broader timetax:calendar-period;
    skos:altLabel "Quarter"@en;
    owl:versionInfo "0.1.0";
    dc:subject timevoc:quarter;
    core:hasLifecycleStatus core:Draft .
  
  timetax:calendar-week a skos:Concept;
    skos:prefLabel "Calendar week"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A calendar period of seven consecutive days."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-time/>;
    skos:broader timetax:calendar-period;
    skos:altLabel "Week"@en;
    owl:versionInfo "0.1.0";
    dc:subject timevoc:week;
    core:hasLifecycleStatus core:Draft .
  
  timetax:calendar-year a skos:Concept;
    skos:prefLabel "Calendar year"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A calendar period from the first of January to the thirty-first of December."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-time/>;
    skos:broader timetax:calendar-period;
    skos:altLabel "Year"@en;
    owl:versionInfo "0.1.0";
    dc:subject timevoc:year;
    core:hasLifecycleStatus core:Draft .
  
  timetax:date-and-time a skos:Concept;
    skos:prefLabel "Date and time"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An instant identified to the second or finer, with a time zone."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-time/>;
    skos:broader timetax:instant;
    skos:altLabel "Date time"@en, "Timestamp"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  timetax:deadline a skos:Concept;
    skos:prefLabel "Deadline"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An instant by which an action must be completed."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-time/>;
    skos:broader timetax:instant;
    skos:altLabel "Cut-off"@en, "Due date"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  timetax:notice-period a skos:Concept;
    skos:prefLabel "Notice period"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A duration of advance notice required before an action takes effect."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-time/>;
    skos:broader timetax:duration;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  timetax:retention-period a skos:Concept;
    skos:prefLabel "Retention period"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A duration for which a record must be kept."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-time/>;
    skos:broader timetax:duration;
    skos:altLabel "Records retention period"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  timetax:service-level-duration a skos:Concept;
    skos:prefLabel "Service level duration"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A duration committed for responding to or resolving a request."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-time/>;
    skos:broader timetax:duration;
    skos:altLabel "Resolution time target"@en, "Response time target"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  timetax:waiting-period a skos:Concept;
    skos:prefLabel "Waiting period"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A duration that must elapse before an entitlement begins."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-time/>;
    skos:broader timetax:duration;
    skos:altLabel "Probationary period"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  timetax:effective-date a skos:Concept;
