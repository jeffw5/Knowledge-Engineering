      businessoperationsvoc:data-preparation .
  
  businessoperationsvoc:key-performance-indicators a skos:Concept;
    skos:prefLabel "Key performance indicators"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:56:03.213Z"^^xsd:dateTime;
    skos:definition "Measurable values that demonstrate how effectively an organization is achieving key business objectives."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/>;
    skos:broader businessoperationsvoc:performance-measurement;
    skos:altLabel "KPIs"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  businessoperationsvoc:data-cleaning a skos:Concept;
    skos:prefLabel "Data cleaning"@en;
