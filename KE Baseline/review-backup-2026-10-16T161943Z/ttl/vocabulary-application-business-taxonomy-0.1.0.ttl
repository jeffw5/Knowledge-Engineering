voc:website
  a skos:Concept ;
  skos:prefLabel "Website"@en ;
  skos:definition "A company’s online portal that may offer self-service resources like FAQs, knowledge bases and online forms for contacting support."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
