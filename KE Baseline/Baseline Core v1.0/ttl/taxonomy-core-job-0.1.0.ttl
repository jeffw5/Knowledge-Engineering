<https://www.insperity.com/taxonomy/core-job/>
  a skos:ConceptScheme ;
  rdfs:label "Core job taxonomy"@en ;
  skos:prefLabel "Core job taxonomy"@en ;
  dct:title "Core job taxonomy"@en ;
  dct:description "A taxonomy of the Jobs model (Jobs To Be Done) that supports the persona model: jobs by kind, the steps within a job, the desired and delivered outcomes mapped to each step, and the parties and studies around them. Job steps are akin to process steps but intentionally not one-to-one."@en ;
  skos:hasTopConcept jobtax:delivered-outcome ,
