tax:information-asset
  a skos:Concept ;
  skos:prefLabel "Information asset"@en ;
  skos:altLabel "Information artifact"@en , "Information entity"@en ;
  skos:definition "An asset that consists of information that can be copied across physical or digital carriers without losing its identity."@en ;
  skos:scopeNote "Aligned to the BFO generically dependent continuant category and the Information Artifact Ontology. Software is classified separately as a software asset."@en ;
  skos:example "A pay statement; a timesheet; a policy document."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core/> ;
  skos:topConceptOf <https://www.insperity.com/taxonomy/core/> ;
  skos:narrower tax:dataset , tax:document , tax:identifier , tax:knowledge-artifact , tax:record ;
  dc:subject tax:information-asset ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-16T23:03:55Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T23:03:55Z"^^xsd:dateTime .

