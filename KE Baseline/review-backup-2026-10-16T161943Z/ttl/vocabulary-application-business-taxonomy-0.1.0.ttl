  dct:created "2025-07-31T20:46:04.860Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:service-performance
  a skos:Concept ;
  skos:prefLabel "Service performance"@en ;
  skos:definition "Measures how effectively a service is delivering on its promised quality and functionality from a user perspective. It encompasses various metrics like response time, availability, reliability, and throughput, ensuring the service meets agreed-upon service level objectives (SLOs)."@en ;
  skos:notation "TL3000131" ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:service-assurance ;
  owl:versionInfo "0.1.0" ;
