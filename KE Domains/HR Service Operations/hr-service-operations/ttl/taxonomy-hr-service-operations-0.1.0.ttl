      hrserviceopstax:employee-benefits-and-retirement-sponsorship-domain ,
      hrserviceopstax:government-compliance-and-employer-risk-management-domain ,
      hrserviceopstax:hr-technology-platform-and-employee-experience-domain ,
      hrserviceopstax:organizational-values-culture-and-ethics-stewardship-domain ,
      hrserviceopstax:talent-management-and-organizational-development-domain ,
      hrserviceopstax:workforce-administration-and-payroll-domain ,
      hrserviceopstax:workforce-development-coaching-and-performance-measurement-domain ;
  core:hasPrimaryTerm domainvoc:domain ;
