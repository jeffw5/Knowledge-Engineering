roletax:ResponsibilityRole
  a skos:Concept ;
  rdfs:label "Responsibility role"@en ;
  skos:prefLabel "Responsibility role"@en ;
  skos:altLabel "RACI role"@en , "Responsibility assignment"@en ;
  skos:definition "A role that defines the kind of responsibility a party has for a process step or decision."@en ;
  skos:scopeNote "Used to qualify performedBy and approvedBy."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core-role/> ;
  skos:topConceptOf <https://www.insperity.com/taxonomy/core-role/> ;
  skos:narrower roletax:AccountableRole ,
      roletax:ConsultedRole ,
      roletax:InformedRole ,
      roletax:ResponsibleRole ;
  core:formalizedBy core:PartyRole ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-17T01:38:18Z"^^xsd:dateTime ;
  dct:modified "2026-10-19T02:19:17Z"^^xsd:dateTime .

roletax:AccountableRole
  a skos:Concept ;
  rdfs:label "Accountable role"@en ;
  skos:prefLabel "Accountable role"@en ;
  skos:altLabel "Accountable"@en , "Approver"@en ;
  skos:definition "A responsibility role borne by the party that answers for the outcome and approves the work."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core-role/> ;
  skos:broader roletax:ResponsibilityRole ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-17T01:38:18Z"^^xsd:dateTime ;
  dct:modified "2026-10-18T00:25:49Z"^^xsd:dateTime .

roletax:ConsultedRole
  a skos:Concept ;
  rdfs:label "Consulted role"@en ;
  skos:prefLabel "Consulted role"@en ;
  skos:altLabel "Advisor"@en , "Consulted"@en ;
  skos:definition "A responsibility role borne by a party whose input is sought before work or decisions."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core-role/> ;
  skos:broader roletax:ResponsibilityRole ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-17T01:38:18Z"^^xsd:dateTime ;
  dct:modified "2026-10-18T00:25:49Z"^^xsd:dateTime .

roletax:InformedRole
  a skos:Concept ;
  rdfs:label "Informed role"@en ;
  skos:prefLabel "Informed role"@en ;
  skos:altLabel "Informed"@en ;
  skos:definition "A responsibility role borne by a party kept up to date on progress or outcome."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core-role/> ;
  skos:broader roletax:ResponsibilityRole ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-17T01:38:18Z"^^xsd:dateTime ;
  dct:modified "2026-10-18T00:25:49Z"^^xsd:dateTime .

roletax:ResponsibleRole
  a skos:Concept ;
  rdfs:label "Responsible role"@en ;
  skos:prefLabel "Responsible role"@en ;
  skos:altLabel "Doer"@en , "Responsible"@en ;
  skos:definition "A responsibility role borne by the party that does the work."@en ;
