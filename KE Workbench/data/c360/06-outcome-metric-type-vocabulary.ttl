<https://www.insperity.com/vocabulary/outcome-metric-type/> a skos:ConceptScheme ;
    rdfs:label "Outcome metric type vocabulary"@en ;
    skos:prefLabel "Outcome metric type vocabulary"@en ;
    skos:definition "A concept scheme of the kinds of measure a desired outcome statement uses."@en ;
    skos:hasTopConcept metric:speed, metric:stability, metric:cost-and-exposure, metric:effort, metric:output ;
    dcterms:title "Outcome metric type vocabulary"@en ;
    dcterms:description "A concept scheme of the kinds of measure a desired outcome statement uses."@en ;
    dcterms:subject domaintax:EnterpriseArchitecture ;
    vaem:namespace "https://www.insperity.com/vocabulary/outcome-metric-type/"^^xsd:anyURI ;
    vann:preferredNamespacePrefix "metric" ;
    dcterms:language "en" ;
    dcterms:creator "Jeffrey Wallk" ;
    dcterms:publisher <https://www.insperity.com/resource/core/Organization/insperity> ;
