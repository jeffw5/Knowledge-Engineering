voc:data-asset-valuation
  a skos:Concept ;
  skos:prefLabel "Data asset valuation"@en ;
  skos:definition "The process of determining the monetary or strategic worth of a specific set of data within an organization. This considers factors like revenue generation potential, cost savings, and competitive advantage."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-technicalservices/> ;
  skos:broader voc:data-operations ;
  skos:narrower voc:data-asset-inventory ,
      voc:data-asset-investment ,
      voc:data-asset-prioritization ,
      voc:data-asset-quantification ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:29:16.049Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:data-asset-inventory
  a skos:Concept ;
  skos:prefLabel "Data asset inventory"@en ;
  skos:definition "A centralized repository or catalog that documents all data assets owned or managed by an organization. It typically includes information about data location, structure, quality, and sensitivity."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-technicalservices/> ;
  skos:broader voc:data-asset-valuation ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:29:16.049Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:data-asset-investment
  a skos:Concept ;
  skos:prefLabel "Data asset investment"@en ;
  skos:definition "The allocation of financial and human resources towards acquiring, storing, managing, protecting, and analyzing data assets to achieve specific business goals."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-technicalservices/> ;
  skos:broader voc:data-asset-valuation ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:29:16.049Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:data-asset-prioritization
  a skos:Concept ;
  skos:prefLabel "Data asset prioritization"@en ;
  skos:definition "A process for ranking data assets based on their perceived value, risk, and alignment with strategic objectives. This helps organizations focus resources on managing and leveraging the most critical data first."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-technicalservices/> ;
  skos:broader voc:data-asset-valuation ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:29:16.049Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:data-asset-quantification
  a skos:Concept ;
  skos:prefLabel "Data asset quantification"@en ;
  skos:definition "The practice of measuring and expressing the value of data assets using tangible metrics. This could involve calculating ROI on data-driven initiatives, assessing the impact of data quality on business outcomes, or determining the cost of poor data management."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-technicalservices/> ;
  skos:broader voc:data-asset-valuation ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:29:16.049Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:data-quality-management
  a skos:Concept ;
  skos:prefLabel "Data quality management"@en ;
  skos:definition "The process of ensuring that data is accurate, complete, consistent, timely, and relevant."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-technicalservices/> ;
