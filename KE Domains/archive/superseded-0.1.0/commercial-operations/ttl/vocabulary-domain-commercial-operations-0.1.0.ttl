  a skos:Concept ;
  rdfs:label "pipeline"@en ;
  skos:prefLabel "pipeline"@en ;
  skos:definition "A set of open opportunities arranged by the stage each has reached in the selling process."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-commercial-operations/> ;
