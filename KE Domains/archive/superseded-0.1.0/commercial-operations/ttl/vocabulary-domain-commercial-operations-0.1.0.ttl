  rdfs:label "conversion"@en ;
  skos:prefLabel "conversion"@en ;
  skos:definition "A change of a lead into an opportunity, or of an opportunity or prospect into a client."@en ;
  skos:scopeNote "The commercial sense. core-logic conversion changes a value from one unit or format to another and is a different term."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-commercial-operations/> ;
  skos:topConceptOf <https://www.insperity.com/vocabulary/domain-commercial-operations/> ;
