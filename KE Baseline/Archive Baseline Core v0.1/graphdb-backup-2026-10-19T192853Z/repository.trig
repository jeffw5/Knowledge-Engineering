  <https://www.insperity.com/taxonomy/core-services-technicalservices/SystemAccess>
    skos:definition "Access to systems and applications."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/DirectoryManagement>
    skos:definition "The process of maintaining directories, such as user directories and resource directories."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/ExternalEntities>
    skos:definition "Entities that are outside of the organization."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/InternalEntities>
    skos:definition "Entities that are within the organization."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/LogicalLocation>
    skos:definition "A location that is defined in software, such as a network address."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/PhysicalLocation>
    skos:definition "A physical location, such as a building or room."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/MetadataManagement>
    skos:definition "The process of managing metadata, which is data about data."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/ContextAlignment>
    skos:definition "The process of aligning data with its context."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/ContextCapture>
    skos:definition "The process of capturing information about the context in which data is created or used."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/ContextToEntityMapping>
    skos:definition "The process of mapping context information to entities in a system."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/RegistryManagement>
    skos:definition "The process of managing registries, which are databases of information about systems and applications."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/IdentityManagement>
    skos:definition "The process of managing and securing digital identities within an organization, encompassing the identification, authentication, and authorization of users and devices to access resources and systems."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/CentralizedAdministration>
    skos:definition "Administration of systems and applications from a central location."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/DelegatedAdministration>
    skos:definition "The process of delegating administrative tasks to other users or groups."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/GroupAdministration>
    skos:definition "The process of managing groups of users."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/IdentityFederation>
    skos:definition "The process of enabling users to access resources across multiple security domains."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/IdentityMediation>
    skos:definition "The process of translating between different identity formats."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/IdentityPropogation>
    skos:definition "The process of propagating identity information across multiple systems."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/IdentityQualificationApproval>
    skos:definition "The process of qualifying and approving identities for access to resources."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/IdentityRegistration>
    skos:definition "The process of registering identities in a system."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/PolicyManagement>
    skos:definition "The process of creating, managing, and enforcing policies."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/AssetSecurityPolicies>
    skos:definition "Policies that govern the security of assets, such as hardware and software."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/CorporatePolicies>
    skos:definition "Policies that are specific to the organization."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/DataSecurityPolicies>
    skos:definition "Policies that govern the security of data."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/DataAvailability>
    skos:definition "Ensuring that data is available when it is needed."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/DataConfidentiality>
    skos:definition "Protecting data from unauthorized access."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/DataIntegrity>
    skos:definition "The accuracy, completeness, and consistency of data."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/Identities> skos:definition
      "Electronic representations of users, systems, or devices."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/LawsCitationsCompliance>
    skos:definition "Ensuring that systems and applications comply with relevant laws and regulations."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/NetworkSecurityPolicies>
    skos:definition "Policies that govern the security of the network."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/PhysicalSecurityPolicies>
    skos:definition "Policies that govern the physical security of assets, such as hardware and data centers."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/PolicyEnforcement>
    skos:definition "The process of enforcing policies."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/ConstraintManagement>
    skos:definition "The process of managing constraints on data."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/RulesManagement>
    skos:definition "The process of managing rules that govern the behavior of systems and applications."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/QualityPolicies>
    skos:definition "Policies that govern the quality of products and services."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/ProtectionManagement>
    skos:definition "The process of managing the protection of assets, such as data and systems."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/DataCategorization>
    skos:definition "The process of classifying data into categories."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/DataMasking> skos:definition
      "The process of hiding sensitive data from unauthorized users."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/DataReleasability>
    skos:definition "The process of determining whether data can be released to a third party."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/Decryption> skos:definition
      "The process of converting encrypted data back into its original form."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/EncryptionAtRest>
    skos:definition "The process of encrypting data that is stored on disk."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/EncryptionInMotion>
    skos:definition "The process of encrypting data that is in transit over a network."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/ResourceProtection>
    skos:definition "The process of protecting resources, such as data and systems, from unauthorized access."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/TemporalConstraintTimer>
    skos:definition "A restriction placed on one or more temporal data items, which represent time points or time periods"@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/TokenAssignment>
    skos:definition "The process of managing and assigning tokens, which are used to authenticate users and authorize access to resources."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/TokenManagement>
    skos:definition "The process of managing and assigning tokens, which are used to authenticate users and authorize access to resources."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/ReportingAnalytics>
    skos:definition "The process of collecting, analyzing, and reporting on security-related data."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/ExposureAnalysis>
    skos:definition "The process of identifying and assessing security vulnerabilities."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/PredictiveAnalytics>
    skos:definition "The use of statistical techniques to predict future events."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/ResolutionAssessment>
    skos:definition "The process of assessing the effectiveness of security controls."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/ThreatManagement>
    skos:definition "A comprehensive process that encompasses identifying, assessing, and responding to potential threats, using various strategies and techniques to mitigate risks and protect organizations or individuals."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/Investigation>
    skos:definition "A detailed analysis of detected threats to understand their nature, origin, potential impact, and to develop an effective incident response plan, including identifying and containing the incident, mitigating damage, and recovering compromised systems."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/Mitigation> skos:definition
      "The proactive strategies and actions taken to reduce or minimize the potential impact of threats and vulnerabilities. It involves identifying risks, implementing protective measures, and continuously monitoring for threats to prevent security breaches."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/Monitoring> skos:definition
      "A proactive security measure that enables organizations to detect, identify, and respond to potential security incidents in an increasingly sophisticated and pervasive era."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/Prevention> skos:definition
      "Proactive measures and strategies implemented to block or deter threats from reaching or damaging systems, networks, or data before they can cause harm."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/Training> skos:definition
      "Equipping individuals with the knowledge, skills, and awareness necessary to identify, assess, and respond to potential threats, ultimately enhancing an organization's ability to mitigate risks."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/SystemsOperations>
    skos:definition "The set of tasks and processes involved in operating and maintaining systems."@en .
  
  <https://www.insperity.com/taxonomy/core-services-technicalservices/WorkflowAutomation>
    skos:definition "The process of automating business processes using workflow software."@en .
}

<https://www.insperity.com/taxonomy/reference-domain/> {
  referencedomaintax:Domain skos:definition "A business domain defines the core area of expertise and operations for a company."@en .
  
  referencedomaintax:Commercial skos:definition "Relating to business or commerce, particularly the buying and selling of goods and services."@en .
  
  referencedomaintax:Corporate skos:definition "Relating to a corporation or large company, often referring to its overall structure, management, and operations."@en .
}

<https://www.insperity.com/taxonomy/core-asset/> {
  assettax:financial-asset skos:definition "An asset that is a monetary claim or contractual right to receive cash or another financial asset."@en .
  
  assettax:information-asset skos:definition "An asset that consists of information that can be copied across physical or digital carriers without losing its identity."@en .
  
  assettax:intangible-asset skos:definition "An asset that has no physical substance but provides future value through rights, knowledge, or reputation."@en .
  
  assettax:physical-asset skos:definition "An asset that has material existence and can be located, handled, or occupied."@en .
  
  assettax:software-asset skos:definition "An asset that is a set of executable instructions or a trained model that performs computation."@en .
  
  assettax:agreement-document skos:definition "A document that records the terms agreed between two or more parties."@en .
  
  assettax:document skos:definition "An information asset that is a bounded, human-readable unit of content with a title and author."@en .
  
  assettax:application skos:definition "A software asset that provides functions to users through an interface."@en .
  
  assettax:application-programming-interface skos:definition "A software asset that is a defined contract through which software components call one another."@en .
  
  assettax:audit-record skos:definition "A record that documents who performed an action, when, and with what result, for later review."@en .
  
  assettax:record skos:definition "An information asset that is evidence of an activity, transaction, or state, kept for reference or compliance."@en .
  
  assettax:brand skos:definition "An intangible asset that is the name, identity, and reputation by which an organization or offering is recognized."@en .
  
  assettax:cash-and-cash-equivalent skos:definition "A financial asset that is currency or a highly liquid investment readily convertible to a known amount of cash."@en .
  
  assettax:change-record skos:definition "A record that documents an approved change to a knowledge artifact, its reason, and its approver."@en .
  
  assettax:communication-equipment skos:definition "An equipment that transmits or receives voice or data."@en .
  
  assettax:equipment skos:definition "A physical asset that is a durable device or apparatus used to perform work."@en .
  
  assettax:computing-equipment skos:definition "An equipment that processes, stores, or displays digital information."@en .
  
  assettax:data-store skos:definition "A software asset that persists and serves data."@en .
  
  assettax:document-store skos:definition "A data store that stores semi-structured documents."@en .
  
  assettax:graph-store skos:definition "A data store that stores and queries data as a graph of nodes and edges."@en .
  
  assettax:relational-database skos:definition "A data store that stores data in tables related by keys and queried with a structured query language."@en .
  
  assettax:vector-store skos:definition "A data store that stores embeddings and supports similarity search."@en .
  
  assettax:dataset skos:definition "An information asset that is a collection of related data published or curated as a unit."@en .
  
  assettax:form skos:definition "A document that has structured fields for collecting information from a person or system."@en .
  
  assettax:knowledge-article skos:definition "A document that answers a specific question or explains a topic for reuse in support and self-service."@en .
  
  assettax:notice skos:definition "A document that formally informs a party of a fact, right, obligation, or change."@en .
  
  assettax:policy-document skos:definition "A document that states a policy, standard, or procedure in human-readable form."@en .
  
  assettax:report skos:definition "A document that presents organized facts, analysis, or measures for a stated purpose and period."@en .
  
  assettax:operational-equipment skos:definition "An equipment that is used directly in producing goods or delivering physical services."@en .
  
  assettax:facility skos:definition "A physical asset that is a building, room, or fixed installation used to house people, equipment, or operations."@en .
  
  assettax:investment skos:definition "A financial asset that is held to generate income or appreciation."@en .
  
  assettax:prepaid-amount skos:definition "A financial asset that is a payment made in advance for goods or services not yet received."@en .
  
  assettax:receivable skos:definition "A financial asset that is an amount owed to the organization by another party."@en .
  
  assettax:identifier skos:definition "An information asset that is a symbol or code assigned to uniquely designate an entity within a context."@en .
  
  assettax:knowledge-artifact skos:definition "An information asset that encodes governed meaning, structure, or logic for use by people, applications, and artificial intelligence agents."@en .
  
  assettax:intellectual-property skos:definition "An intangible asset that is a legally protected creation of the mind."@en .
  
  assettax:license-right skos:definition "An intangible asset that is a granted permission to use property owned by another party under stated terms."@en .
  
  assettax:relationship-asset skos:definition "An intangible asset that is the established, valuable connection between the organization and a group of parties."@en .
  
  assettax:inventory skos:definition "A physical asset that is a stock of materials or goods held for use, sale, or distribution."@en .
  
  assettax:mapping-specification skos:definition "A knowledge artifact that defines how elements of a source schema or vocabulary correspond to ontology terms."@en .
  
  assettax:ontology skos:definition "A knowledge artifact that formally defines classes, relations, and axioms for a domain using a logic-based language."@en .
  
  assettax:prompt-template skos:definition "A knowledge artifact that defines the versioned instructions, tone, and answer format given to a language model for a persona or task."@en .
  
  assettax:rule-specification skos:definition "A knowledge artifact that declaratively defines a business rule, constraint, logic component, or calculation in the single source of truth."@en .
  
  assettax:taxonomy skos:definition "A knowledge artifact that arranges concepts into a classification hierarchy."@en .
  
  assettax:validation-shape skos:definition "A knowledge artifact that defines the constraints data must satisfy, expressed in a shapes language."@en .
  
  assettax:vocabulary skos:definition "A knowledge artifact that defines the preferred, alternate, and hidden labels and definitions of a set of terms."@en .
  
  assettax:machine-learning-model skos:definition "A software asset that is a trained statistical model producing predictions or generated content from inputs."@en .
  
  assettax:party-record skos:definition "A record that holds identifying and descriptive information about a party."@en .
  
  assettax:vehicle skos:definition "A physical asset that is a means of transporting people or goods."@en .
  
  assettax:transaction-record skos:definition "A record that captures the details of a single business transaction."@en .
  
  assettax:software-component skos:definition "A software asset that is a deployable unit of code providing a defined function to other software."@en .
}

<https://www.insperity.com/taxonomy/core-capability/> {
  <https://www.insperity.com/taxonomy/core-capability/customer-facing-capability> skos:definition
      "A capability for creating and delivering value to clients and their workers."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/information-and-knowledge-capability>
    skos:definition "A capability for managing and using data, knowledge, and artificial intelligence."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/strategic-capability> skos:definition
      "A capability for setting direction and shaping the organization."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/supporting-capability> skos:definition
      "A capability that enables strategic and customer-facing capabilities."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/analytics-management> skos:definition
      "An information and knowledge capability to analyze data and report insights."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/artificial-intelligence-management>
    skos:definition "An information and knowledge capability to develop, deploy, monitor, and govern artificial intelligence systems responsibly."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/client-relationship-management>
    skos:definition "A customer-facing capability to acquire, understand, serve, and retain clients."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/client-support-management> skos:definition
      "A customer-facing capability to answer inquiries and resolve requests."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/content-management> skos:definition
      "An information and knowledge capability to create, publish, and retain documents and content."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/marketing-management> skos:definition
      "A customer-facing capability to generate awareness and demand."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/offering-management> skos:definition
      "A customer-facing capability to define, price, and evolve products and services."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/sales-management> skos:definition
      "A customer-facing capability to pursue and win new and renewed business."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/service-delivery-management> skos:definition
      "A customer-facing capability to fulfil services to agreed levels."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/data-management> skos:definition
      "An information and knowledge capability to acquire, define, store, and govern data."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/enterprise-architecture-management>
    skos:definition "A strategic capability to design and govern the structure of business, information, and technology."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/facilities-management> skos:definition
      "A supporting capability to provide and maintain workplaces."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/financial-management> skos:definition
      "A supporting capability to plan, record, report, and control money."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/knowledge-management> skos:definition
      "An information and knowledge capability to capture, organize, and share knowledge."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/semantic-management> skos:definition
      "An information and knowledge capability to define and govern shared meaning through vocabularies, taxonomies, and ontologies."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/innovation-management> skos:definition
      "A strategic capability to generate, test, and scale new ideas."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/legal-management> skos:definition
      "A supporting capability to manage agreements, legal advice, and disputes."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/performance-management> skos:definition
      "A strategic capability to set targets, measure results, and drive improvement."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/portfolio-management> skos:definition
      "A strategic capability to select and balance investments in initiatives and offerings."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/procurement-management> skos:definition
      "A supporting capability to source and manage suppliers."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/risk-and-compliance-management>
    skos:definition "A supporting capability to identify and treat risks and meet obligations."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/strategy-management> skos:definition
      "A strategic capability to define, communicate, and adjust strategy and objectives."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/technology-management> skos:definition
      "A supporting capability to plan, build, run, and secure technology."@en .
  
  <https://www.insperity.com/taxonomy/core-capability/workforce-management> skos:definition
      "A supporting capability to attract, pay, develop, and retain people."@en .
}

<https://www.insperity.com/taxonomy/core-decision/> {
  <https://www.insperity.com/taxonomy/core-decision/decision-model> skos:definition
      "A decision-related information artifact that specifies how a decision is made from its inputs."@en .
  
  <https://www.insperity.com/taxonomy/core-decision/operational-decision> skos:definition
      "A decision made repeatedly in the course of day-to-day work, often by rules or agents."@en .
  
  <https://www.insperity.com/taxonomy/core-decision/strategic-decision> skos:definition
      "A decision that sets long-term direction, scope, or major resource commitments."@en .
  
  <https://www.insperity.com/taxonomy/core-decision/tactical-decision> skos:definition
      "A decision that translates strategy into plans, budgets, and allocations for a medium term."@en .
  
  <https://www.insperity.com/taxonomy/core-decision/allocation-decision> skos:definition
      "An operational decision that distributes resources or amounts among recipients."@en .
  
  <https://www.insperity.com/taxonomy/core-decision/answer-decision> skos:definition
      "An operational decision by an artificial intelligence agent on whether to answer, ask, escalate, or decline."@en .
  
  <https://www.insperity.com/taxonomy/core-decision/approval-decision> skos:definition
      "An operational decision that accepts or rejects a request or item."@en .
  
  <https://www.insperity.com/taxonomy/core-decision/classification-decision> skos:definition
      "An operational decision that assigns an item to a category."@en .
  
  <https://www.insperity.com/taxonomy/core-decision/compliance-determination> skos:definition
      "An operational decision that establishes whether an obligation applies and is met."@en .
  
  <https://www.insperity.com/taxonomy/core-decision/decision-requirements-graph> skos:definition
      "A decision model that shows decisions, their input data, knowledge sources, and dependencies."@en .
  
  <https://www.insperity.com/taxonomy/core-decision/decision-table> skos:definition
      "A decision model that maps combinations of input conditions to outputs in rows governed by a hit policy."@en .
  
  <https://www.insperity.com/taxonomy/core-decision/decision-tree> skos:definition "A decision model that reaches an outcome through a sequence of branching tests."@en .
  
  <https://www.insperity.com/taxonomy/core-decision/predictive-decision-model> skos:definition
      "A decision model whose output is produced by a trained machine learning model."@en .
  
  <https://www.insperity.com/taxonomy/core-decision/scoring-model> skos:definition "A decision model that combines weighted factors into a score compared to cut-offs."@en .
  
  <https://www.insperity.com/taxonomy/core-decision/eligibility-determination> skos:definition
      "An operational decision that establishes whether a party qualifies for something."@en .
  
  <https://www.insperity.com/taxonomy/core-decision/exception-decision> skos:definition
      "An operational decision on whether and how to handle a departure from a rule or path."@en .
  
  <https://www.insperity.com/taxonomy/core-decision/pricing-decision> skos:definition
      "An operational decision that sets a price, rate, or fee."@en .
  
  <https://www.insperity.com/taxonomy/core-decision/prioritization-decision> skos:definition
      "An operational decision that orders work by importance or urgency."@en .
  
  <https://www.insperity.com/taxonomy/core-decision/routing-decision> skos:definition
      "An operational decision that selects where work or a request goes next."@en .
}

<https://www.insperity.com/taxonomy/core-event/> {
  <https://www.insperity.com/taxonomy/core-event/business-event> skos:definition "An event that changes the state of a business relationship, agreement, or transaction."@en .
  
  <https://www.insperity.com/taxonomy/core-event/change-event> skos:definition "An event that records a change in data, configuration, or governed knowledge."@en .
  
  <https://www.insperity.com/taxonomy/core-event/governance-event> skos:definition "An event in which a governance decision or control outcome is recorded."@en .
  
  <https://www.insperity.com/taxonomy/core-event/interaction-event> skos:definition
      "An event in which a party communicates with the organization or one of its systems."@en .
  
  <https://www.insperity.com/taxonomy/core-event/process-event> skos:definition "An event that marks a change in the execution state of a process or process step."@en .
  
  <https://www.insperity.com/taxonomy/core-event/system-event> skos:definition "An event that is generated by a software system about its own operation."@en .
  
  <https://www.insperity.com/taxonomy/core-event/time-event> skos:definition "An event that occurs because a point in time is reached."@en .
  
  <https://www.insperity.com/taxonomy/core-event/agreement-amendment> skos:definition
      "An agreement event in which the terms of an existing agreement are changed."@en .
  
  <https://www.insperity.com/taxonomy/core-event/agreement-event> skos:definition "A business event that creates, changes, or ends an agreement between parties."@en .
  
  <https://www.insperity.com/taxonomy/core-event/agreement-execution> skos:definition
      "An agreement event in which parties sign or accept an agreement and it becomes binding."@en .
  
  <https://www.insperity.com/taxonomy/core-event/agreement-renewal> skos:definition
      "An agreement event in which an agreement is extended for a further term."@en .
  
  <https://www.insperity.com/taxonomy/core-event/agreement-termination> skos:definition
      "An agreement event in which an agreement ends before or at its expiry."@en .
  
  <https://www.insperity.com/taxonomy/core-event/answer-delivery> skos:definition "An interaction event in which an artificial intelligence agent or person returns an answer to a question."@en .
  
  <https://www.insperity.com/taxonomy/core-event/approval-denied> skos:definition "A governance event in which an authorized party rejects an item."@en .
  
  <https://www.insperity.com/taxonomy/core-event/approval-granted> skos:definition "A governance event in which an authorized party approves an item."@en .
  
  <https://www.insperity.com/taxonomy/core-event/audit-completed> skos:definition "A governance event in which an audit concludes with recorded findings."@en .
  
  <https://www.insperity.com/taxonomy/core-event/availability-change> skos:definition
      "A system event in which a system becomes available or unavailable."@en .
  
  <https://www.insperity.com/taxonomy/core-event/party-event> skos:definition "A business event that changes the status or attributes of a party."@en .
  
  <https://www.insperity.com/taxonomy/core-event/transaction-event> skos:definition
      "A business event in which value is exchanged or committed between parties."@en .
  
  <https://www.insperity.com/taxonomy/core-event/configuration-change> skos:definition
      "A change event in which settings of a system or service are altered."@en .
  
  <https://www.insperity.com/taxonomy/core-event/data-change> skos:definition "A change event in which a stored record is created, updated, or deleted."@en .
  
  <https://www.insperity.com/taxonomy/core-event/knowledge-change> skos:definition "A change event in which a governed term, rule, mapping, or shape is created, changed, or deprecated."@en .
  
  <https://www.insperity.com/taxonomy/core-event/regulatory-change> skos:definition
      "A change event in which a law, regulation, or official guidance is enacted, amended, or repealed."@en .
  
  <https://www.insperity.com/taxonomy/core-event/control-failure-detected> skos:definition
      "A governance event in which a control or quality gate does not pass."@en .
  
  <https://www.insperity.com/taxonomy/core-event/deadline-reached> skos:definition "A time event that marks the latest time by which an action must be completed."@en .
  
  <https://www.insperity.com/taxonomy/core-event/effective-date-reached> skos:definition
      "A time event that marks when a rule, policy, agreement, or change takes effect."@en .
  
  <https://www.insperity.com/taxonomy/core-event/enrollment> skos:definition "A transaction event in which a party elects to participate in an offering or plan."@en .
  
  <https://www.insperity.com/taxonomy/core-event/escalation-raised> skos:definition
      "A process event in which work is referred to a higher authority or specialist."@en .
  
  <https://www.insperity.com/taxonomy/core-event/expiration-reached> skos:definition
      "A time event that marks when a right, agreement, or document ceases to be valid."@en .
  
  <https://www.insperity.com/taxonomy/core-event/feedback-submission> skos:definition
      "An interaction event in which a party rates or comments on a service or answer."@en .
  
  <https://www.insperity.com/taxonomy/core-event/release-published> skos:definition
      "A governance event in which a versioned artifact is promoted to an environment."@en .
  
  <https://www.insperity.com/taxonomy/core-event/handoff> skos:definition "A process event in which responsibility for work passes from one party or role to another."@en .
  
  <https://www.insperity.com/taxonomy/core-event/inquiry> skos:definition "An interaction event in which a party asks a question or requests information."@en .
  
  <https://www.insperity.com/taxonomy/core-event/notification-delivery> skos:definition
      "An interaction event in which the organization sends information to a party."@en .
  
  <https://www.insperity.com/taxonomy/core-event/request-submission> skos:definition
      "An interaction event in which a party submits a request for action."@en .
  
  <https://www.insperity.com/taxonomy/core-event/job-completion> skos:definition "A system event that marks the end of a scheduled or batch job."@en .
  
  <https://www.insperity.com/taxonomy/core-event/life-event> skos:definition "A party event in which a change in a person's personal circumstances occurs."@en .
  
  <https://www.insperity.com/taxonomy/core-event/message-receipt> skos:definition "A system event in which a system receives a message or file from another system."@en .
  
  <https://www.insperity.com/taxonomy/core-event/order-placement> skos:definition "A transaction event in which a party requests goods or services under stated terms."@en .
  
  <https://www.insperity.com/taxonomy/core-event/party-change> skos:definition "A party event in which identifying, contact, or status attributes of a party change."@en .
  
  <https://www.insperity.com/taxonomy/core-event/party-offboarding> skos:definition
      "A party event in which an active relationship with a party ends."@en .
  
  <https://www.insperity.com/taxonomy/core-event/party-onboarding> skos:definition "A party event in which a party is registered and begins an active relationship with the organization."@en .
  
  <https://www.insperity.com/taxonomy/core-event/payment> skos:definition "A transaction event in which money is transferred from one party to another."@en .
  
  <https://www.insperity.com/taxonomy/core-event/period-end> skos:definition "A time event that marks the end of a defined period."@en .
  
  <https://www.insperity.com/taxonomy/core-event/period-start> skos:definition "A time event that marks the beginning of a defined period."@en .
  
  <https://www.insperity.com/taxonomy/core-event/process-completion> skos:definition
      "A process event that marks the successful end of a process or process step instance."@en .
  
  <https://www.insperity.com/taxonomy/core-event/process-exception> skos:definition
      "A process event that marks a deviation from the expected path of a process step."@en .
  
  <https://www.insperity.com/taxonomy/core-event/process-start> skos:definition "A process event that marks the beginning of a process or process step instance."@en .
  
  <https://www.insperity.com/taxonomy/core-event/refund> skos:definition "A transaction event in which money is returned to a party."@en .
  
  <https://www.insperity.com/taxonomy/core-event/system-alert> skos:definition "A system event that signals a condition requiring attention."@en .
}

<https://www.insperity.com/taxonomy/core-governance/> {
  <https://www.insperity.com/taxonomy/core-governance/control> skos:definition "A governance measure that modifies risk by preventing, detecting, or correcting unwanted outcomes."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/governance-activity> skos:definition
      "A governance process step undertaken to direct, assure, or improve governed work."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/governance-body> skos:definition
      "A governance structure that is a group with authority to make or review governance decisions."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/governance-discipline> skos:definition
      "A governance area of practice that directs and oversees a defined subject."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/governance-record> skos:definition
      "A governance information artifact that documents governance decisions, obligations, or evidence."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/access-control> skos:definition
      "A control that restricts who can read or change information."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/architecture-review-board> skos:definition
      "A governance body that reviews and approves architecture and core and mapping changes."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/artificial-intelligence-governance>
    skos:definition "A governance discipline concerned with responsible design, deployment, and oversight of artificial intelligence."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/artificial-intelligence-impact-assessment>
    skos:definition "An impact assessment of the effects of an artificial intelligence system on people and the organization."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/impact-assessment> skos:definition
      "A governance activity that evaluates the effects of a proposed change or system before it proceeds."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/artificial-intelligence-oversight-committee>
    skos:definition "A governance body that reviews artificial intelligence use, impact assessments, and incidents."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/attestation> skos:definition "A governance activity in which a party formally confirms compliance or acknowledgment."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/audit> skos:definition "A governance activity that independently examines records and controls against criteria."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/audit-trail> skos:definition "A governance record of the sequence of actions on an item, who took them, and when."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/board-of-directors> skos:definition
      "A governance body elected to oversee the organization on behalf of owners."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/change-advisory-board> skos:definition
      "A governance body that assesses and approves changes to production."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/change-control> skos:definition
      "A governance activity that ensures every change is traceable to an approved requirement, tested, and versioned."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/charter> skos:definition "A governance record that establishes the purpose, authority, and membership of a governance body or program."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/corrective-control> skos:definition
      "A control that limits damage and restores the expected state after an unwanted outcome."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/detective-control> skos:definition
      "A control that identifies an unwanted outcome after it occurs."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/human-oversight> skos:definition
      "A control in which a person reviews, approves, or can override an automated decision or output."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/preventive-control> skos:definition
      "A control that stops an unwanted outcome before it occurs."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/quality-gate> skos:definition
      "A control that blocks release of an artifact that fails defined checks."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/segregation-of-duties> skos:definition
      "A control that divides conflicting responsibilities among different parties."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/corporate-governance> skos:definition
      "A governance discipline concerned with direction and control of the organization by its board and executives."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/data-governance> skos:definition
      "A governance discipline concerned with the quality, security, and proper use of data."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/data-governance-council> skos:definition
      "A governance body that sets data policies and resolves data issues across domains."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/decision-log> skos:definition
      "A governance record that lists governance decisions, their rationale, and approvers."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/monitoring> skos:definition "A governance activity that continuously observes artifacts, services, and answers against targets."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/review> skos:definition "A governance activity in which a qualified party examines work for correctness and conformance."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/risk-assessment> skos:definition
      "A governance activity that identifies, analyzes, and evaluates risks."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/risk-governance> skos:definition
      "A governance discipline concerned with risk appetite, oversight, and accountability."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/semantic-governance> skos:definition
      "A governance discipline concerned with shared, governed meaning in vocabularies, taxonomies, ontologies, rules, and mappings."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/technology-governance> skos:definition
      "A governance discipline concerned with the value, risk, and performance of technology."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/metadata-registry> skos:definition
      "A governance record that registers each artifact, version, and status."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/obligations-register> skos:definition
      "A governance record that lists obligations, their sources, owners, and controls."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/release-manifest> skos:definition
      "A governance record that lists the artifacts, versions, and checksums in a release."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/risk-register> skos:definition
      "A governance record that lists risks, their ratings, owners, and treatments."@en .
  
  <https://www.insperity.com/taxonomy/core-governance/privacy-impact-assessment> skos:definition
      "An impact assessment of the effects of processing on personal information."@en .
}

<https://www.insperity.com/taxonomy/core-issue/> {
  issuetax:complaint skos:definition "An issue that is an expression of dissatisfaction by a party about a product, service, or interaction."@en .
  
  issuetax:defect skos:definition "An issue that is a fault in an artifact causing it to differ from its specification or intended meaning."@en .
  
  issuetax:exception skos:definition "An issue that is an approved or detected departure from the normal rule or path."@en .
  
  issuetax:incident skos:definition "An issue that is an unplanned interruption or reduction in the quality of a service."@en .
  
  issuetax:nonconformance skos:definition "An issue in which a requirement, norm, or control is not met."@en .
  
  issuetax:problem skos:definition "An issue that is the underlying cause of one or more incidents or defects."@en .
  
  issuetax:question-gap skos:definition "An issue in which a question cannot be answered from governed knowledge."@en .
  
  issuetax:risk skos:definition "An issue that is the effect of uncertainty on objectives, expressed as a possible event and its consequence."@en .
  
  issuetax:artificial-intelligence-output-defect skos:definition "A defect in content generated by an artificial intelligence agent."@en .
  
  issuetax:hallucination skos:definition "An artificial intelligence output defect in which the output states something that is not supported by governed facts or sources."@en .
  
  issuetax:incorrect-citation skos:definition "An artificial intelligence output defect in which an answer cites a source that does not support it."@en .
  
  issuetax:policy-violating-output skos:definition "An artificial intelligence output defect in which the output breaches a guardrail or policy."@en .
  
  issuetax:ungrounded-answer skos:definition "An artificial intelligence output defect in which an answer does not cite the governed terms and sources it relied on."@en .
  
  issuetax:artificial-intelligence-risk skos:definition "A risk arising from the design, data, or use of an artificial intelligence system."@en .
  
  issuetax:audit-finding skos:definition "A nonconformance identified and recorded during an audit."@en .
  
  issuetax:classification-defect skos:definition "A knowledge defect in which a term is placed under the wrong parent or has no path to the core."@en .
  
  issuetax:knowledge-defect skos:definition "A defect in a governed vocabulary, taxonomy, ontology, mapping, or rule."@en .
  
  issuetax:compliance-risk skos:definition "A risk of failing to meet a legal, regulatory, or contractual obligation."@en .
  
  issuetax:control-deficiency skos:definition "A nonconformance in which a control is missing, poorly designed, or not operating as intended."@en .
  
  issuetax:data-defect skos:definition "A defect in data values or records."@en .
  
  issuetax:duplicate-record skos:definition "A data defect in which the same entity is recorded more than once."@en .
  
  issuetax:inconsistent-value skos:definition "A data defect in which values about the same fact disagree across records or systems."@en .
  
  issuetax:invalid-value skos:definition "A data defect in which a value does not conform to its allowed type, format, or range."@en .
  
  issuetax:missing-value skos:definition "A data defect in which a required value is absent."@en .
  
  issuetax:stale-value skos:definition "A data defect in which a value is older than its required freshness."@en .
  
  issuetax:software-defect skos:definition "A defect in software code or configuration."@en .
  
  issuetax:definition-defect skos:definition "A knowledge defect in which a term's definition is missing, circular, ambiguous, or wrong."@en .
  
  issuetax:policy-exception skos:definition "An exception in which a party is permitted to depart from a policy for a stated reason and period."@en .
  
  issuetax:process-exception-issue skos:definition "An exception in which a process step cannot complete along its expected path and needs handling."@en .
  
  issuetax:financial-risk skos:definition "A risk of monetary loss or adverse financial outcome."@en .
  
  issuetax:performance-degradation skos:definition "An incident in which a service is available but slower or less reliable than its service level."@en .
  
  issuetax:privacy-incident skos:definition "An incident in which personal information is accessed, used, or disclosed without authorization."@en .
  
  issuetax:security-incident skos:definition "An incident that compromises the confidentiality, integrity, or availability of information or systems."@en .
  
  issuetax:service-outage skos:definition "An incident in which a service is unavailable to its users."@en .
  
  issuetax:information-security-risk skos:definition "A risk to the confidentiality, integrity, or availability of information."@en .
  
  issuetax:label-defect skos:definition "A knowledge defect in which a label is missing, duplicated, colliding, or uses an unapproved acronym."@en .
  
  issuetax:mapping-defect skos:definition "A knowledge defect in which a source element is mapped to the wrong term or not mapped."@en .
  
  issuetax:rule-defect skos:definition "A knowledge defect in which a rule has a gap, overlap, or incorrect outcome."@en .
  
  issuetax:norm-violation skos:definition "A nonconformance in which an obligation or prohibition in a law, regulation, or policy is breached."@en .
  
  issuetax:service-level-breach skos:definition "A nonconformance in which a committed service level is not met."@en .
  
  issuetax:operational-risk skos:definition "A risk of loss from failed processes, people, systems, or external events."@en .
  
  issuetax:strategic-risk skos:definition "A risk that threatens the organization's direction or competitive position."@en .
}

<https://www.insperity.com/taxonomy/core-lifecycle/> {
  lifecycletax:agreement-lifecycle skos:definition "A lifecycle of an agreement from drafting and negotiation through execution, performance, renewal, and termination."@en .
  
  lifecycletax:artifact-lifecycle skos:definition "A lifecycle of an information or software asset from creation to retirement."@en .
  
  lifecycletax:asset-lifecycle skos:definition "A lifecycle of a physical or financial asset from planning and acquisition through operation and maintenance to disposal."@en .
  
  lifecycletax:governance-lifecycle skos:definition "A lifecycle of governed oversight that a policy, control, or governed artifact passes through from definition to retirement."@en .
  
  lifecycletax:offering-lifecycle skos:definition "A lifecycle of something offered to clients from concept to withdrawal."@en .
  
  lifecycletax:party-lifecycle skos:definition "A lifecycle of a party's relationship with the organization."@en .
  
  lifecycletax:work-item-lifecycle skos:definition "A lifecycle of a unit of tracked work from creation to closure."@en .
  
  lifecycletax:data-lifecycle skos:definition "An artifact lifecycle of data from creation or acquisition through use, archiving, and deletion."@en .
  
  lifecycletax:document-lifecycle skos:definition "An artifact lifecycle of a document from drafting through review, publication, revision, and disposal."@en .
  
  lifecycletax:knowledge-artifact-lifecycle skos:definition "An artifact lifecycle of a vocabulary, taxonomy, ontology, mapping, shape, or rule from ideation to retirement."@en .
  
  lifecycletax:model-lifecycle skos:definition "An artifact lifecycle of a machine learning model from design and training through validation, deployment, monitoring, and retirement."@en .
  
  lifecycletax:record-lifecycle skos:definition "An artifact lifecycle of a record from capture through retention to disposition."@en .
  
  lifecycletax:software-release-lifecycle skos:definition "An artifact lifecycle of a software or knowledge release from build through test, stage, and production promotion to retirement."@en .
  
  lifecycletax:change-lifecycle skos:definition "A work item lifecycle of a change from request through assessment, approval, implementation, and review."@en .
  
  lifecycletax:client-lifecycle skos:definition "A party lifecycle of a client from prospect through onboarding, service, renewal, and exit."@en .
  
  lifecycletax:control-lifecycle skos:definition "A governance lifecycle of a control from design through implementation, testing, operation, and remediation."@en .
  
  lifecycletax:decision-lifecycle skos:definition "A work item lifecycle of a decision from framing through analysis and choice to communication and review."@en .
  
  lifecycletax:employment-lifecycle skos:definition "A party lifecycle of a worker from recruitment and hire through employment changes to separation."@en .
  
  lifecycletax:policy-lifecycle skos:definition "A governance lifecycle of a policy from drafting and approval through publication, attestation, review, and retirement."@en .
  
  lifecycletax:issue-lifecycle skos:definition "A work item lifecycle of an issue from detection through triage and resolution to closure."@en .
  
  lifecycletax:product-lifecycle skos:definition "An offering lifecycle of a product from concept, design, and launch through growth, maturity, and discontinuation."@en .
  
  lifecycletax:service-lifecycle skos:definition "An offering lifecycle of a service from strategy and design through transition, operation, and retirement."@en .
  
  lifecycletax:supplier-lifecycle skos:definition "A party lifecycle of a supplier from qualification and contracting through performance management to exit."@en .
  
  lifecycletax:requirement-lifecycle skos:definition "A work item lifecycle of a requirement from elicitation through approval, implementation, and verification."@en .
}

<https://www.insperity.com/taxonomy/core-location/> {
  locationtax:geographic-area skos:definition "A location that is a region of the earth's surface identified by name or boundary."@en .
  
  locationtax:jurisdiction skos:definition "A location that is the territory within which a governing authority's laws and regulations apply."@en .
  
  locationtax:location-reference skos:definition "A location-related information artifact that identifies a place."@en .
  
  locationtax:site skos:definition "A location where an organization carries out activities or keeps assets."@en .
  
  locationtax:virtual-location skos:definition "A location in a network or digital space rather than physical space."@en .
  
  locationtax:city skos:definition "A geographic area that is a municipality or populated place."@en .
  
  locationtax:cloud-region skos:definition "A virtual location that is a provider-defined geographic grouping of data centers."@en .
  
  locationtax:collaboration-space skos:definition "A virtual location where people share content and communicate."@en .
  
  locationtax:country skos:definition "A geographic area that is a sovereign nation."@en .
  
  locationtax:county skos:definition "A geographic area that is a subdivision of a state used for local government."@en .
  
  locationtax:data-center skos:definition "A site that houses computing and storage infrastructure."@en .
  
  locationtax:distribution-site skos:definition "A site where goods are stored and shipped."@en .
  
  locationtax:postal-area skos:definition "A geographic area identified by a postal code."@en .
  
  locationtax:region skos:definition "A geographic area grouping countries, states, or cities for business purposes."@en .
  
  locationtax:state-or-province skos:definition "A geographic area that is a first-level subdivision of a country."@en .
  
  locationtax:geographic-coordinate skos:definition "A location reference given as latitude and longitude."@en .
  
  locationtax:local-jurisdiction skos:definition "A jurisdiction of a county, city, or other local government."@en .
  
  locationtax:national-jurisdiction skos:definition "A jurisdiction of a national government."@en .
  
  locationtax:state-jurisdiction skos:definition "A jurisdiction of a state or provincial government."@en .
  
  locationtax:tax-jurisdiction skos:definition "A jurisdiction defined by a taxing authority, which may cross other boundaries."@en .
  
  locationtax:location-code skos:definition "A location reference given as a code from a standard or system."@en .
  
  locationtax:postal-address skos:definition "A location reference that identifies a delivery point by street, city, state, and postal code."@en .
  
  locationtax:office skos:definition "A site used mainly for administrative and professional work."@en .
  
  locationtax:remote-work-location skos:definition "A site outside the employer's premises where a worker regularly works."@en .
  
  locationtax:worksite skos:definition "A site where workers perform work for a client employer."@en .
  
  locationtax:web-address skos:definition "A virtual location identified by a uniform resource locator."@en .
}

<https://www.insperity.com/taxonomy/core-logic/> {
  <https://www.insperity.com/taxonomy/core-logic/control-flow-logic> skos:definition
      "A logic component that determines the order and conditions under which process steps are carried out."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/data-flow-logic> skos:definition "A logic component that moves, transforms, or combines data."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/orchestration-logic> skos:definition
      "A logic component that coordinates several services or agents to complete a request."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/reasoning-logic> skos:definition "A logic component that draws conclusions from facts and knowledge."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/retrieval-logic> skos:definition "A logic component that selects the governed facts and content used to answer a question."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/abductive-reasoning> skos:definition
      "A reasoning logic that infers the most likely explanation for observations."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/agent-orchestration> skos:definition
      "An orchestration logic in which a coordinating agent delegates tasks to other agents and tools."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/causal-reasoning> skos:definition "A reasoning logic that determines how changes in one factor produce changes in another."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/compensation-logic> skos:definition
      "An error handling logic that undoes the effects of completed steps when a later step fails."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/error-handling-logic> skos:definition
      "A control flow logic that detects failures and decides how to recover."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/conditional-branching> skos:definition
      "A control flow logic in which one path is chosen from several by evaluating conditions."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/context-assembly> skos:definition "A retrieval logic that composes retrieved facts, definitions, and sources into model context within a token budget."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/event-based-branching> skos:definition
      "A control flow logic in which the path taken depends on which event occurs first."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/iteration> skos:definition "A control flow logic in which steps repeat until a condition is met or a collection is exhausted."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/parallel-execution> skos:definition
      "A control flow logic in which several paths run at the same time and later join."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/sequence> skos:definition "A control flow logic in which steps run one after another."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/enrichment-logic> skos:definition "A data flow logic that adds attributes or links from other sources."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/filtering-logic> skos:definition "A data flow logic that keeps or removes records by conditions."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/matching-logic> skos:definition "A data flow logic that determines whether records refer to the same entity."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/routing-logic> skos:definition "A data flow logic that directs messages or records to destinations by content or type."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/transformation-logic> skos:definition
      "A data flow logic that changes the structure, format, or values of data."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/dead-letter-routing> skos:definition
      "An error handling logic that sets aside messages that cannot be processed after allowed recovery actions."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/deductive-reasoning> skos:definition
      "A reasoning logic that derives conclusions that necessarily follow from premises and axioms."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/fallback-logic> skos:definition "An error handling logic that switches to an alternate path or degraded answer when a step fails."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/retry-logic> skos:definition "An error handling logic that repeats a failed step after a delay."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/graph-traversal> skos:definition "A retrieval logic that follows relationships in the knowledge graph from a starting entity."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/hybrid-retrieval> skos:definition "A retrieval logic that combines keyword, vector, and graph results and ranks them together."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/inductive-reasoning> skos:definition
      "A reasoning logic that generalizes from observed cases to probable rules."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/service-choreography> skos:definition
      "An orchestration logic in which services react to each other's events without a central controller."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/service-orchestration> skos:definition
      "An orchestration logic in which a central controller calls services in a defined order."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/probabilistic-reasoning> skos:definition
      "A reasoning logic that computes likelihoods of conclusions under uncertainty."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/temporal-reasoning> skos:definition
      "A reasoning logic that draws conclusions about the order, overlap, and validity of facts over time."@en .
  
  <https://www.insperity.com/taxonomy/core-logic/semantic-search> skos:definition "A retrieval logic that finds content by meaning using labels, synonyms, and embeddings."@en .
}

<https://www.insperity.com/taxonomy/core-measure/> {
  <https://www.insperity.com/taxonomy/core-measure/base-measure> skos:definition "A measure that quantifies a single attribute by a direct method."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/calculation> skos:definition "A governed formula specification that computes a value from inputs and is verified against test vectors."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/derived-measure> skos:definition
      "A measure computed from two or more base or derived measures."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/forecast-value> skos:definition "A measure value that estimates a future value of a measure from assumptions and history."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/indicator> skos:definition "A measure that estimates or evaluates an attribute against an information need, often compared to a target."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/measurement-dimension> skos:definition
      "A characteristic along which measures are evaluated or broken down."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/observation> skos:definition "A measure value recorded for a specific subject, period, and set of dimensions."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/target> skos:definition "A measure value that a party commits to achieve within a period."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/threshold> skos:definition "A measure value that, when crossed, triggers an alert, decision, or action."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/accuracy> skos:definition "A data quality dimension of how closely values agree with reality or an authoritative source."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/data-quality-dimension> skos:definition
      "A measurement dimension of how fit data is for its intended use."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/actual-value> skos:definition "An observation that records what occurred."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/aggregation-calculation> skos:definition
      "A calculation that summarizes many values into one, such as a sum, count, or average."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/alert-threshold> skos:definition
      "A threshold that triggers a notification for attention."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/allocation-calculation> skos:definition
      "A calculation that distributes an amount across recipients by a defined basis."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/answer-traceability-rate> skos:definition
      "A knowledge quality indicator equal to the share of artificial intelligence answers that cite governed terms and mappings."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/knowledge-quality-indicator> skos:definition
      "An indicator of the coverage, accuracy, or traceability of governed knowledge and the answers that use it."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/arithmetic-calculation> skos:definition
      "A calculation that combines inputs using addition, subtraction, multiplication, or division."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/benchmark-value> skos:definition
      "An observation from a comparable population used as a reference."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/budget-target> skos:definition "A target expressed as a planned amount of money."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/conversion-calculation> skos:definition
      "A calculation that converts a value between units, currencies, or periods."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/date-calculation> skos:definition
      "A calculation that derives a date or duration from other dates and rules."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/ratio-calculation> skos:definition
      "A calculation that divides one quantity by another to express a proportion or rate."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/scoring-calculation> skos:definition
      "A calculation that combines weighted factors into a single score."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/statistical-calculation> skos:definition
      "A calculation that estimates a distribution, trend, or relationship from data."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/competency-question-pass-rate> skos:definition
      "A knowledge quality indicator equal to the share of competency questions passing in a release."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/completeness> skos:definition "A data quality dimension of whether all required values are present."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/consistency> skos:definition "A data quality dimension of whether values agree across records and systems."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/cost> skos:definition "A performance dimension of the money spent to produce an output."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/performance-dimension> skos:definition
      "A measurement dimension of how well a process or service achieves results with resources."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/timeliness> skos:definition "A data quality dimension of whether values are current enough for use."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/uniqueness> skos:definition "A data quality dimension of whether each entity is recorded once."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/validity> skos:definition "A data quality dimension of whether values conform to defined formats and domains."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/effectiveness> skos:definition "A performance dimension of the degree to which intended results are achieved."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/efficiency> skos:definition "A performance dimension of output relative to resources used."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/explainability> skos:definition "A trust dimension of whether outputs can be traced to inputs, rules, and sources."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/trust-dimension> skos:definition
      "A measurement dimension of how much confidence users can place in information or answers."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/key-performance-indicator> skos:definition
      "An indicator that tracks performance against a strategic or operational objective."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/key-risk-indicator> skos:definition
      "An indicator that signals a change in risk exposure."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/reliability-indicator> skos:definition
      "An indicator of how long or how often a system works without failure."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/service-level-indicator> skos:definition
      "An indicator that measures an aspect of service performance experienced by users."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/mapping-accuracy> skos:definition
      "A knowledge quality indicator equal to the share of agent-proposed mappings accepted on review."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/mapping-coverage> skos:definition
      "A knowledge quality indicator equal to the share of inbound schema elements mapped to ontology terms."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/search-success-rate> skos:definition
      "A knowledge quality indicator equal to the share of searches returning a result the user accepts."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/mean-time-between-failures> skos:definition
      "A reliability indicator equal to operating time divided by the number of failures."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/mean-time-between-hallucinations>
    skos:definition "A reliability indicator equal to answers served or hours in service divided by confirmed hallucinations."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/mean-time-to-recover> skos:definition
      "A reliability indicator equal to the average time to restore service after a failure."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/speed> skos:definition "A performance dimension of the time taken to produce an output."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/provenance> skos:definition "A trust dimension of whether the origin and lineage of information are recorded."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/service-level-objective> skos:definition
      "A target for a service level indicator agreed internally."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/tolerance-threshold> skos:definition
      "A threshold that defines the acceptable band around a target."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/trip-threshold> skos:definition "A threshold that triggers automatic suspension or fallback."@en .
  
  <https://www.insperity.com/taxonomy/core-measure/verification> skos:definition "A trust dimension of whether facts have been checked against published sources."@en .
}

<https://www.insperity.com/taxonomy/core-policy/> {
  <https://www.insperity.com/taxonomy/core-policy/contractual-instrument> skos:definition
      "A policy that arises from an agreement between parties and binds them to its terms."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/guideline> skos:definition "A policy that recommends good practice without mandating it."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/legal-norm-source> skos:definition
      "A policy issued by a public authority with the force of law."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/norm> skos:definition "A policy statement that qualifies an action or state as obligatory, permitted, or prohibited for a party in a jurisdiction and period."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/organizational-policy> skos:definition
      "A policy issued by an organization to govern its own conduct and that of its workers and agents."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/procedure> skos:definition "A policy that specifies the steps to carry out an activity in a consistent way."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/standard> skos:definition "A policy that is a documented agreement on specifications or practices adopted voluntarily or by reference."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/acceptable-use-policy> skos:definition
      "An organizational policy that governs permitted use of systems and data."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/agency-guidance> skos:definition "A legal norm source issued by an agency to interpret or apply law without the force of regulation."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/client-service-agreement> skos:definition
      "A contractual instrument that sets the services, fees, and responsibilities between the organization and a client."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/code-of-conduct> skos:definition "An organizational policy that states expected ethical behavior."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/data-processing-agreement> skos:definition
      "A contractual instrument that governs how one party processes personal data for another."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/plan-document> skos:definition "A contractual instrument that sets the legally binding terms of a benefit or retirement plan."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/service-level-agreement> skos:definition
      "A contractual instrument that commits measurable service levels and remedies."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/terms-of-service> skos:definition
      "A contractual instrument that sets the conditions for using a service or application."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/court-decision> skos:definition "A legal norm source that is a ruling by a court establishing or interpreting law."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/data-classification-policy> skos:definition
      "An organizational policy that defines classification levels and the handling each requires."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/executive-order> skos:definition "A legal norm source issued by a head of government directing government operations."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/financial-control-policy> skos:definition
      "An organizational policy that governs spending, approval authority, and financial reporting."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/industry-standard> skos:definition
      "A standard published by an industry or professional body."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/information-security-policy> skos:definition
      "An organizational policy that protects information and systems."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/internal-standard> skos:definition
      "A standard adopted by the organization for its own work."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/international-standard> skos:definition
      "A standard published by an international standards body."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/regulation> skos:definition "A legal norm source issued by a regulatory agency under statutory authority."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/statute> skos:definition "A legal norm source enacted by a legislative body."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/obligation> skos:definition "A norm that requires a party to perform an action or achieve a state."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/permission> skos:definition "A norm that allows a party to perform an action without requiring it."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/prohibition> skos:definition "A norm that forbids a party from performing an action."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/right> skos:definition "A norm that entitles a party to an action, benefit, or protection from another party."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/privacy-policy> skos:definition "An organizational policy that governs collection, use, and disclosure of personal information."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/records-retention-policy> skos:definition
      "An organizational policy that defines how long records are kept and how they are disposed of."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/responsible-artificial-intelligence-policy>
    skos:definition "An organizational policy that governs the design, use, and oversight of artificial intelligence."@en .
  
  <https://www.insperity.com/taxonomy/core-policy/workforce-policy> skos:definition
      "An organizational policy that governs employment practices, leave, conduct, and pay."@en .
}

<https://www.insperity.com/taxonomy/core-process/> {
  processtax:management-process skos:definition "A process that sets direction, allocates resources, and oversees performance of the organization."@en .
  
  processtax:operational-process skos:definition "A process that directly creates or delivers value to clients."@en .
  
  processtax:process-step skos:definition "A process that is a bounded part of a larger process, performed by a party or role, consuming and producing assets."@en .
  
  processtax:support-process skos:definition "A process that enables management and operational processes."@en .
  
  processtax:approval-step skos:definition "A process step in which an authorized party accepts or rejects an item."@en .
  
  processtax:automated-step skos:definition "A process step performed entirely by software without human intervention."@en .
  
  processtax:calculation-step skos:definition "A process step that computes a value from inputs using a governed calculation."@en .
  
  processtax:client-onboarding-process skos:definition "An operational process that sets up a new client and its workforce for service."@en .
  
  processtax:client-support-process skos:definition "An operational process that answers inquiries and resolves requests from clients and workers."@en .
  
  processtax:communication-step skos:definition "A process step that sends or receives information to or from a party."@en .
  
  processtax:data-and-knowledge-management-process skos:definition "A support process that acquires, defines, governs, and publishes data and knowledge."@en .
  
  processtax:decision-step skos:definition "A process step that selects an outcome or path by applying a decision model or judgement."@en .
  
  processtax:enterprise-architecture-process skos:definition "A management process that defines and governs the structure of business, information, and technology."@en .
  
  processtax:financial-management-process skos:definition "A support process that records, reports, plans, and controls money."@en .
  
  processtax:human-capital-management-process skos:definition "A support process that recruits, pays, develops, and retains the workforce."@en .
  
  processtax:information-technology-management-process skos:definition "A support process that plans, builds, and runs technology services."@en .
  
  processtax:legal-process skos:definition "A support process that drafts agreements, advises on law, and manages disputes."@en .
  
  processtax:performance-management-process skos:definition "A management process that sets targets, measures results, and drives improvement."@en .
  
  processtax:risk-and-compliance-management-process skos:definition "A management process that identifies, assesses, treats, and monitors risks and obligations."@en .
  
  processtax:strategy-and-planning-process skos:definition "A management process that defines objectives, plans, and budgets."@en .
  
  processtax:manual-step skos:definition "A process step performed by a person without system automation."@en .
  
  processtax:marketing-and-sales-process skos:definition "An operational process that generates demand and wins clients."@en .
  
  processtax:offering-development-process skos:definition "An operational process that designs, builds, and launches products and services."@en .
  
  processtax:service-delivery-process skos:definition "An operational process that fulfils services for clients and their workers."@en .
  
  processtax:subprocess-step skos:definition "A process step that invokes another process as a unit."@en .
  
  processtax:user-step skos:definition "A process step performed by a person with the help of a software application."@en .
  
  processtax:validation-step skos:definition "A process step that checks data or work against constraints and rules."@en .
  
  processtax:wait-step skos:definition "A process step that pauses until a time, event, or condition occurs."@en .
  
  processtax:procurement-process skos:definition "A support process that sources and buys goods and services."@en .
}

<https://www.insperity.com/taxonomy/core-requirements/> {
  <https://www.insperity.com/taxonomy/core-requirements/constraint> skos:definition
      "A requirement that limits the design or implementation options available."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/knowledge-requirement> skos:definition
      "A requirement that states what governed knowledge must define or be able to answer."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/solution-requirement> skos:definition
      "A requirement that states a characteristic a solution must have to meet stakeholder requirements."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/stakeholder-requirement> skos:definition
      "A requirement that states what a stakeholder needs, independent of any solution."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/transition-requirement> skos:definition
      "A requirement that states a capability needed only to move from the current to the future state."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/accessibility-requirement> skos:definition
      "A quality requirement on use by people with the widest range of abilities."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/quality-requirement> skos:definition
      "A solution requirement that states how well the solution must perform a function or a characteristic it must exhibit."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/availability-requirement> skos:definition
      "A quality requirement on the proportion of time a solution is operational."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/business-constraint> skos:definition
      "A constraint imposed by budget, schedule, staffing, or policy."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/business-requirement> skos:definition
      "A stakeholder requirement that states an organizational goal, objective, or outcome."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/competency-question> skos:definition
      "A knowledge requirement written as a question the knowledge must be able to answer, run as a test in each release."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/technical-constraint> skos:definition
      "A constraint imposed by technology standards, platforms, or existing systems."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/contractual-requirement> skos:definition
      "A stakeholder requirement that arises from the terms of an agreement."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/coverage-requirement> skos:definition
      "A knowledge requirement on the terms, mappings, or sources that must be included."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/data-definition-requirement>
    skos:definition "A data requirement on the meaning, format, and allowed values of a data element."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/data-requirement> skos:definition
      "A solution requirement that states what data must be captured, defined, stored, or retained."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/data-quality-requirement> skos:definition
      "A data requirement on the accuracy, completeness, consistency, timeliness, or validity of data."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/data-retention-requirement>
    skos:definition "A data requirement on how long data is kept and how it is disposed of."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/explainability-requirement>
    skos:definition "A quality requirement on the ability to trace and explain outputs to their inputs and rules."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/functional-requirement> skos:definition
      "A solution requirement that states a behavior or function the solution must perform."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/interface-requirement> skos:definition
      "A solution requirement that states how the solution interacts with users, systems, or devices."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/interoperability-requirement>
    skos:definition "A quality requirement on exchanging and using information with other systems."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/maintainability-requirement>
    skos:definition "A quality requirement on the ease of changing and correcting the solution."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/performance-requirement> skos:definition
      "A quality requirement on response time, throughput, or resource use."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/privacy-requirement> skos:definition
      "A quality requirement on the lawful and limited collection and use of personal information."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/reliability-requirement> skos:definition
      "A quality requirement on the ability to perform without failure over a period."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/scalability-requirement> skos:definition
      "A quality requirement on handling growth in load or data."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/security-requirement> skos:definition
      "A quality requirement on protecting confidentiality, integrity, and availability."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/usability-requirement> skos:definition
      "A quality requirement on ease of learning and efficient use."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/regulatory-requirement> skos:definition
      "A stakeholder requirement that arises from a law, regulation, or binding guidance."@en .
  
  <https://www.insperity.com/taxonomy/core-requirements/user-requirement> skos:definition
      "A stakeholder requirement that states what a user must be able to do or experience."@en .
}

<https://www.insperity.com/taxonomy/core-role/> {
  roletax:agreement-party-role skos:definition "A role borne by a party because it is a signatory to or named in an agreement."@en .
  
  roletax:commercial-role skos:definition "A role that arises from a commercial relationship or agreement."@en .
  
  roletax:employment-role skos:definition "A role that arises from an employment relationship between a worker and an employer."@en .
  
  roletax:governance-role skos:definition "A role that carries authority or duty for the oversight of policies, data, knowledge, or controls."@en .
  
  roletax:knowledge-engineering-role skos:definition "A role that builds, reviews, or maintains governed knowledge artifacts."@en .
  
  roletax:plan-role skos:definition "A role that arises from participation in a benefit, retirement, or insurance plan."@en .
  
  roletax:responsibility-role skos:definition "A role that defines the kind of responsibility a party has for a process step or decision."@en .
  
  roletax:accountable-role skos:definition "A responsibility role borne by the party that answers for the outcome and approves the work."@en .
  
  roletax:guarantor skos:definition "An agreement party role borne by a party that promises to meet another party's obligation if it defaults."@en .
  
  roletax:principal skos:definition "An agreement party role borne by the party on whose behalf an agreement is made or an action taken."@en .
  
  roletax:representative skos:definition "An agreement party role borne by a party authorized to act for another."@en .
  
  roletax:auditor skos:definition "A governance role borne by a party who independently examines records and controls."@en .
  
  roletax:beneficiary skos:definition "A plan role borne by a party designated to receive a benefit on a participant's death."@en .
  
  roletax:broker skos:definition "A commercial role borne by a party that arranges agreements between other parties for a commission or fee."@en .
  
  roletax:carrier skos:definition "A supplier that underwrites and pays insurance benefits."@en .
  
  roletax:supplier skos:definition "A commercial role borne by a party that provides goods or services to the organization."@en .
  
  roletax:change-reviewer skos:definition "A governance role borne by the party who approves changes before they enter source control and release."@en .
  
  roletax:client skos:definition "A commercial role borne by a party that purchases services from the organization under an agreement."@en .
  
  roletax:client-employer skos:definition "An employer that is a client of a co-employer and directs the day-to-day work of worksite employees."@en .
  
  roletax:employer skos:definition "An employment role borne by an organization that hires and directs workers."@en .
  
  roletax:co-employer skos:definition "An employer that shares employer responsibilities for the same workers with another employer under a co-employment agreement."@en .
  
  roletax:partner skos:definition "A commercial role borne by a party that collaborates with the organization to deliver or sell offerings."@en .
  
  roletax:prospect skos:definition "A commercial role borne by a party being evaluated or pursued as a future client."@en .
  
  roletax:consulted-role skos:definition "A responsibility role borne by a party whose input is sought before work or decisions."@en .
  
  roletax:contingent-worker skos:definition "A worker engaged for a limited period or task without standard employment."@en .
  
  roletax:worker skos:definition "An employment role borne by a person who performs work for an organization."@en .
  
  roletax:custodian skos:definition "A governance role borne by the party who operates the systems that store and protect an asset."@en .
  
  roletax:dependent skos:definition "A plan role borne by a person who receives coverage through a plan participant."@en .
  
  roletax:drafting-assistant skos:definition "A knowledge engineering role borne by an artificial intelligence agent that drafts definitions, labels, mappings, and shapes for human review and never commits on its own."@en .
  
  roletax:employee skos:definition "A worker who is employed under an employment relationship and paid through payroll."@en .
  
  roletax:worksite-employee skos:definition "An employee who performs work at a client worksite under a co-employment relationship."@en .
  
  roletax:executive skos:definition "An employment role borne by a person accountable for the direction of an organization or major unit."@en .
  
  roletax:manager skos:definition "An employment role borne by a person who directs the work of other workers."@en .
  
  roletax:owner skos:definition "A governance role borne by the party accountable for an asset, domain, or artifact and for approving changes to it."@en .
  
  roletax:regulator skos:definition "A governance role borne by a government body that oversees compliance with law in a domain."@en .
  
  roletax:steward skos:definition "A governance role borne by the party who maintains the quality, labels, and definitions of data or vocabularies day to day."@en .
  
  roletax:informed-role skos:definition "A responsibility role borne by a party kept up to date on progress or outcome."@en .
  
  roletax:knowledge-engineer skos:definition "A knowledge engineering role borne by the person who builds and extends ontologies under the naming, URI, and definition standards."@en .
  
  roletax:subject-matter-expert skos:definition "A knowledge engineering role borne by the person who confirms definitions, rules, and relationships for a domain."@en .
  
  roletax:plan-administrator skos:definition "A plan role borne by a party responsible for operating a plan under its terms."@en .
  
  roletax:plan-participant skos:definition "A plan role borne by a person who is enrolled in a plan."@en .
  
  roletax:plan-sponsor skos:definition "A plan role borne by an organization that establishes and maintains a plan."@en .
  
  roletax:responsible-role skos:definition "A responsibility role borne by the party that does the work."@en .
}

<https://www.insperity.com/taxonomy/core-rules/> {
  rulestax:access-control-rule skos:definition "A rule that states which parties may read or change which information under which conditions."@en .
  
  rulestax:business-rule skos:definition "A rule that states a business policy or decision logic in terms the business understands."@en .
  
  rulestax:data-constraint skos:definition "A rule that states what must always be true about data."@en .
  
  rulestax:data-quality-rule skos:definition "A rule that measures or enforces a dimension of data quality."@en .
  
  rulestax:guardrail-rule skos:definition "A rule that limits the inputs, actions, or outputs of an automated agent."@en .
  
  rulestax:transformation-rule skos:definition "A rule that states how data in one form is converted into another form."@en .
  
  rulestax:accuracy-rule skos:definition "A data quality rule that checks values agree with an authoritative source."@en .
  
  rulestax:action-guardrail skos:definition "A guardrail rule that restricts which tools or actions an agent may take."@en .
  
  rulestax:authorization-rule skos:definition "A business rule that states who may perform or approve an action."@en .
  
  rulestax:decision-rule skos:definition "A business rule that determines an outcome from input conditions, typically one row of a decision table."@en .
  
  rulestax:derivation-rule skos:definition "A business rule that states how a fact is concluded from other facts."@en .
  
  rulestax:cardinality-constraint skos:definition "A data constraint on how many values a property may or must have."@en .
  
  rulestax:circuit-breaker-rule skos:definition "A guardrail rule that suspends or degrades an agent when reliability falls below a threshold."@en .
  
  rulestax:completeness-rule skos:definition "A data quality rule that checks required values are present."@en .
  
  rulestax:conditional-constraint skos:definition "A data constraint that applies only when a stated condition holds."@en .
  
  rulestax:consistency-rule skos:definition "A data quality rule that checks values agree across records and systems."@en .
  
  rulestax:referential-constraint skos:definition "A data constraint that a referenced entity must exist."@en .
  
  rulestax:temporal-constraint skos:definition "A data constraint on the order or overlap of dates and periods."@en .
  
  rulestax:uniqueness-constraint skos:definition "A data constraint that a value or combination of values identifies at most one entity."@en .
  
  rulestax:value-constraint skos:definition "A data constraint on the type, format, range, or allowed list of a value."@en .
  
  rulestax:timeliness-rule skos:definition "A data quality rule that checks values are current within an agreed period."@en .
  
  rulestax:validity-rule skos:definition "A data quality rule that checks values conform to defined formats and domains."@en .
  
  rulestax:eligibility-rule skos:definition "A decision rule that determines whether a party qualifies for a benefit, service, or action."@en .
  
  rulestax:pricing-rule skos:definition "A decision rule that determines a price, fee, or rate."@en .
  
  rulestax:routing-rule skos:definition "A decision rule that determines where work or a request is sent."@en .
  
  rulestax:threshold-rule skos:definition "A decision rule that triggers an outcome when a measure crosses a defined limit."@en .
  
  rulestax:timing-rule skos:definition "A decision rule that determines a due date, waiting period, or effective date."@en .
  
  rulestax:input-guardrail skos:definition "A guardrail rule that screens requests before an agent acts on them."@en .
  
  rulestax:output-guardrail skos:definition "A guardrail rule that checks an agent's output before it is released."@en .
}

<https://www.insperity.com/taxonomy/core-time/> {
  timetax:duration skos:definition "A temporal entity that is an amount of time without a fixed position on the time line."@en .
  
  timetax:instant skos:definition "A temporal entity that is a single point on a time line with no duration."@en .
  
  timetax:interval skos:definition "A temporal entity that is a stretch of time with a beginning and an end."@en .
  
  timetax:schedule skos:definition "A temporal entity that specifies when recurring or planned occurrences happen."@en .
  
  timetax:business-calendar skos:definition "A schedule that defines working days, holidays, and cut-off times."@en .
  
  timetax:business-period skos:definition "An interval defined by a business cycle such as a pay, plan, coverage, or reporting cycle."@en .
  
  timetax:calendar-date skos:definition "An instant identified at the precision of a day."@en .
  
  timetax:calendar-day skos:definition "A calendar period of one day from midnight to midnight in a time zone."@en .
  
  timetax:calendar-period skos:definition "An interval aligned to the civil calendar."@en .
  
  timetax:calendar-month skos:definition "A calendar period corresponding to one month of the civil calendar."@en .
  
  timetax:calendar-quarter skos:definition "A calendar period of three consecutive months beginning in January, April, July, or October."@en .
  
  timetax:calendar-week skos:definition "A calendar period of seven consecutive days."@en .
  
  timetax:calendar-year skos:definition "A calendar period from the first of January to the thirty-first of December."@en .
  
  timetax:date-and-time skos:definition "An instant identified to the second or finer, with a time zone."@en .
  
  timetax:deadline skos:definition "An instant by which an action must be completed."@en .
  
  timetax:notice-period skos:definition "A duration of advance notice required before an action takes effect."@en .
  
  timetax:retention-period skos:definition "A duration for which a record must be kept."@en .
  
  timetax:service-level-duration skos:definition "A duration committed for responding to or resolving a request."@en .
  
  timetax:waiting-period skos:definition "A duration that must elapse before an entitlement begins."@en .
  
  timetax:effective-date skos:definition "An instant from which a rule, agreement, election, or value applies."@en .
  
  timetax:end-date skos:definition "An instant after which a rule, agreement, election, or value no longer applies."@en .
  
  timetax:fiscal-month skos:definition "A fiscal period that is one month of the fiscal calendar."@en .
  
  timetax:fiscal-period skos:definition "An interval used for financial reporting that may differ from the calendar."@en .
  
  timetax:fiscal-quarter skos:definition "A fiscal period that is one quarter of the fiscal year."@en .
  
  timetax:fiscal-year skos:definition "A fiscal period of twelve months used for financial reporting and budgeting."@en .
  
  timetax:reporting-period skos:definition "An interval that measures and observations are reported for."@en .
  
  timetax:time-window skos:definition "An interval during which an action is permitted or must occur."@en .
  
  timetax:validity-period skos:definition "An interval during which a rule, agreement, value, or version is in force."@en .
  
  timetax:one-time-schedule skos:definition "A schedule for a single planned occurrence."@en .
  
  timetax:recurring-schedule skos:definition "A schedule that repeats at a defined frequency."@en .
}

<https://www.insperity.com/taxonomy/core-value/> {
  <https://www.insperity.com/taxonomy/core-value/economic-value> skos:definition "A value expressed as a financial gain, saving, or avoided cost."@en .
  
  <https://www.insperity.com/taxonomy/core-value/information-value> skos:definition
      "A value from better knowledge, decisions, and trust."@en .
  
  <https://www.insperity.com/taxonomy/core-value/risk-reduction-value> skos:definition
      "A value from lowering the likelihood or impact of adverse events."@en .
  
  <https://www.insperity.com/taxonomy/core-value/societal-value> skos:definition "A value that benefits communities or the wider public beyond direct stakeholders."@en .
  
  <https://www.insperity.com/taxonomy/core-value/stakeholder-value> skos:definition
      "A value experienced by a particular group of stakeholders."@en .
  
  <https://www.insperity.com/taxonomy/core-value/value-proposition> skos:definition
      "A value-related statement of the benefits an offering or capability delivers to a stakeholder and why it is preferable to alternatives."@en .
  
  <https://www.insperity.com/taxonomy/core-value/value-stream> skos:definition "A value-related structure that is an end-to-end sequence of stages delivering an outcome to a stakeholder."@en .
  
  <https://www.insperity.com/taxonomy/core-value/capital-efficiency> skos:definition
      "An economic value from using less capital or working capital for the same outcome."@en .
  
  <https://www.insperity.com/taxonomy/core-value/client-value> skos:definition "A stakeholder value experienced by client organizations."@en .
  
  <https://www.insperity.com/taxonomy/core-value/client-value-proposition> skos:definition
      "A value proposition addressed to clients."@en .
  
  <https://www.insperity.com/taxonomy/core-value/community-value> skos:definition "A societal value that benefits the communities where the organization and its clients operate."@en .
  
  <https://www.insperity.com/taxonomy/core-value/compliance-assurance> skos:definition
      "A risk reduction value from meeting legal, regulatory, and contractual obligations."@en .
  
  <https://www.insperity.com/taxonomy/core-value/cost-avoidance> skos:definition "An economic value from preventing spending that would otherwise occur."@en .
  
  <https://www.insperity.com/taxonomy/core-value/cost-reduction> skos:definition "An economic value from lowering current spending."@en .
  
  <https://www.insperity.com/taxonomy/core-value/customer-value-stream> skos:definition
      "A value stream that delivers an outcome to an external client or worker."@en .
  
  <https://www.insperity.com/taxonomy/core-value/decision-quality> skos:definition "An information value from making decisions that are faster, more consistent, and better informed."@en .
  
  <https://www.insperity.com/taxonomy/core-value/productivity-gain> skos:definition
      "An economic value from producing more output with the same resources."@en .
  
  <https://www.insperity.com/taxonomy/core-value/revenue-growth> skos:definition "An economic value from increased sales, retention, or pricing."@en .
  
  <https://www.insperity.com/taxonomy/core-value/employee-value> skos:definition "A stakeholder value experienced by workers, such as security, wellbeing, and growth."@en .
  
  <https://www.insperity.com/taxonomy/core-value/employee-value-proposition> skos:definition
      "A value proposition addressed to current and prospective workers."@en .
  
  <https://www.insperity.com/taxonomy/core-value/environmental-value> skos:definition
      "A societal value from reducing harm to or improving the natural environment."@en .
  
  <https://www.insperity.com/taxonomy/core-value/reuse-value> skos:definition "An information value from defining knowledge once and reusing it across services and domains."@en .
  
  <https://www.insperity.com/taxonomy/core-value/trust-and-transparency> skos:definition
      "An information value from answers and records that can be traced, explained, and verified."@en .
  
  <https://www.insperity.com/taxonomy/core-value/internal-value-stream> skos:definition
      "A value stream that delivers an outcome to an internal stakeholder."@en .
  
  <https://www.insperity.com/taxonomy/core-value/loss-avoidance> skos:definition "A risk reduction value from preventing fraud, errors, penalties, or incidents."@en .
  
  <https://www.insperity.com/taxonomy/core-value/partner-value> skos:definition "A stakeholder value experienced by suppliers, carriers, and partners."@en .
  
  <https://www.insperity.com/taxonomy/core-value/resilience> skos:definition "A risk reduction value from the ability to continue and recover when disruption occurs."@en .
  
  <https://www.insperity.com/taxonomy/core-value/shareholder-value> skos:definition
      "A stakeholder value experienced by owners and investors."@en .
}

