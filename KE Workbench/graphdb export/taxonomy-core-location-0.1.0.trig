<https://www.insperity.com/taxonomy/core-location/> {
  <https://www.insperity.com/taxonomy/core-location/> a skos:ConceptScheme;
    rdfs:label "Core location taxonomy"@en;
    skos:prefLabel "Core location taxonomy"@en;
    skos:hasTopConcept locationtax:geographic-area, locationtax:jurisdiction, locationtax:location-reference,
      locationtax:site, locationtax:virtual-location;
    terms:description "Classification of locations, the places, jurisdictions, sites, and references where parties, assets, and process steps are located or where norms apply."@en;
    terms:title "Core location taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2026-10-14"^^xsd:dateTime;
    skos:altLabel "Location taxonomy"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/taxonomy/core-location/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  locationtax:geographic-area a skos:Concept;
    skos:prefLabel "Geographic area"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A location that is a region of the earth's surface identified by name or boundary."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-location/>;
    skos:altLabel "Place"@en, "Geographic location"@en;
    owl:versionInfo "0.1.0";
    dc:subject locationvoc:location;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-location/>;
    skos:narrower locationtax:city, locationtax:country, locationtax:county, locationtax:postal-area,
      locationtax:region, locationtax:state-or-province .
  
  locationtax:jurisdiction a skos:Concept;
    skos:prefLabel "Jurisdiction"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A location that is the territory within which a governing authority's laws and regulations apply."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-location/>;
    skos:altLabel "Legal jurisdiction"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-location/>;
    skos:narrower locationtax:local-jurisdiction, locationtax:national-jurisdiction, locationtax:state-jurisdiction,
      locationtax:tax-jurisdiction .
  
  locationtax:location-reference a skos:Concept;
    skos:prefLabel "Location reference"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A location-related information artifact that identifies a place."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-location/>;
    skos:altLabel "Location identifier"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-location/>;
    skos:narrower locationtax:geographic-coordinate, locationtax:location-code, locationtax:postal-address .
  
  locationtax:site a skos:Concept;
    skos:prefLabel "Site"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A location where an organization carries out activities or keeps assets."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-location/>;
    skos:altLabel "Business location"@en, "Physical site"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-location/>;
    skos:narrower locationtax:data-center, locationtax:distribution-site, locationtax:office,
      locationtax:remote-work-location, locationtax:worksite .
  
  locationtax:virtual-location a skos:Concept;
    skos:prefLabel "Virtual location"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A location in a network or digital space rather than physical space."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-location/>;
    skos:altLabel "Digital location"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-location/>;
    skos:narrower locationtax:cloud-region, locationtax:collaboration-space, locationtax:web-address .
  
  locationtax:city a skos:Concept;
    skos:prefLabel "City"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A geographic area that is a municipality or populated place."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-location/>;
    skos:broader locationtax:geographic-area;
    skos:altLabel "Municipality"@en, "Town"@en;
    owl:versionInfo "0.1.0";
    dc:subject locationvoc:city;
    core:hasLifecycleStatus core:Draft .
  
  locationtax:cloud-region a skos:Concept;
    skos:prefLabel "Cloud region"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A virtual location that is a provider-defined geographic grouping of data centers."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-location/>;
    skos:broader locationtax:virtual-location;
    skos:altLabel "Availability zone"@en, "Hosting region"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  locationtax:collaboration-space a skos:Concept;
    skos:prefLabel "Collaboration space"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A virtual location where people share content and communicate."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-location/>;
    skos:broader locationtax:virtual-location;
    skos:altLabel "Channel"@en, "Team site"@en, "Workspace"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  locationtax:country a skos:Concept;
    skos:prefLabel "Country"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A geographic area that is a sovereign nation."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-location/>;
    skos:broader locationtax:geographic-area;
    skos:altLabel "Nation"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  locationtax:county a skos:Concept;
    skos:prefLabel "County"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A geographic area that is a subdivision of a state used for local government."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-location/>;
    skos:broader locationtax:geographic-area;
    skos:altLabel "Borough"@en, "Parish"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  locationtax:data-center a skos:Concept;
    skos:prefLabel "Data center"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A site that houses computing and storage infrastructure."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-location/>;
    skos:broader locationtax:site;
    skos:altLabel "Hosting facility"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  locationtax:distribution-site a skos:Concept;
    skos:prefLabel "Distribution site"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A site where goods are stored and shipped."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-location/>;
    skos:broader locationtax:site;
    skos:altLabel "Warehouse"@en, "Fulfilment center"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  locationtax:postal-area a skos:Concept;
    skos:prefLabel "Postal area"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A geographic area identified by a postal code."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-location/>;
    skos:broader locationtax:geographic-area;
    skos:altLabel "Postal code area"@en, "Zip code area"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  locationtax:region a skos:Concept;
    skos:prefLabel "Region"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A geographic area grouping countries, states, or cities for business purposes."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-location/>;
    skos:broader locationtax:geographic-area;
    skos:altLabel "Sales region"@en, "Service region"@en, "Territory"@en;
    owl:versionInfo "0.1.0";
    dc:subject locationvoc:region;
    core:hasLifecycleStatus core:Draft .
  
  locationtax:state-or-province a skos:Concept;
    skos:prefLabel "State or province"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A geographic area that is a first-level subdivision of a country."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-location/>;
    skos:broader locationtax:geographic-area;
    skos:altLabel "Province"@en, "State"@en, "Subnational division"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  locationtax:geographic-coordinate a skos:Concept;
    skos:prefLabel "Geographic coordinate"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A location reference given as latitude and longitude."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-location/>;
    skos:broader locationtax:location-reference;
    skos:altLabel "Coordinates"@en, "Geolocation"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  locationtax:local-jurisdiction a skos:Concept;
