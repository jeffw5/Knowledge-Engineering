hrserviceopstax:hr-service-operations-domain
  a skos:Concept ;
  rdfs:label "Human resources service operations domain"@en ;
  skos:prefLabel "Human resources service operations domain"@en ;
  skos:definition "A domain of the HR Service Operations operational area: an L1 domain of the HR Services & PEO Enterprise Business Model that delivers external services to clients and their worksite employees."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/hr-service-operations/> ;
