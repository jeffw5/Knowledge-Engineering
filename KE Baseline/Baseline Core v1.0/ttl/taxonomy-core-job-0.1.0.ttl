jobtax:job-step
  a skos:Concept ;
  rdfs:label "Job step"@en ;
  skos:prefLabel "Job step"@en ;
  skos:definition "A step that a job executor takes within a job. Job steps are unique to the job and are not the selling steps of a provider."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core-job/> ;
  skos:topConceptOf <https://www.insperity.com/taxonomy/core-job/> ;
  core:hasPrimaryTerm <https://www.insperity.com/vocabulary/core-process/step> ;
  dct:subject jobvoc:job , <https://www.insperity.com/vocabulary/core-process/step> ;
  core:formalizedBy core:job-step ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2026-10-19"^^xsd:date ;
  dct:modified "2026-10-19T18:44:21Z"^^xsd:dateTime .

jobtax:desired-outcome
  a skos:Concept ;
  rdfs:label "Desired outcome"@en ;
  skos:prefLabel "Desired outcome"@en ;
  skos:definition "An outcome a job executor wants at a job step, stated as a direction (minimize or maximize), a metric and a target."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core-job/> ;
  skos:topConceptOf <https://www.insperity.com/taxonomy/core-job/> ;
  core:hasPrimaryTerm jobvoc:desired-outcome ;
