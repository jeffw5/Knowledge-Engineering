  domainsalestax:onboard
    a skos:Concept ;
    rdfs:label "Onboard"@en ;
    skos:prefLabel "Onboard"@en ;
    skos:altLabel "Onboarding stage"@en ;
    skos:definition "A selling stage in which a won client is handed off to be brought into active service."@en ;
    skos:scopeNote "The last selling stage ends at the handoff; bringing the client into service is customer success onboarding."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/> ;
    skos:broader domainsalestax:selling-stage ;
    core:hasPrimaryTerm eventvoc:onboard ;
    dct:subject eventvoc:onboard ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-20"^^xsd:date ;
    dct:modified "2026-10-20T02:31:43Z"^^xsd:dateTime .

  domainsalestax:propose
    a skos:Concept ;
    rdfs:label "Propose"@en ;
    skos:prefLabel "Propose"@en ;
    skos:altLabel "Proposal stage"@en ;
    skos:definition "A selling stage in which the organization presents a proposal of offerings, terms and prices."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/> ;
