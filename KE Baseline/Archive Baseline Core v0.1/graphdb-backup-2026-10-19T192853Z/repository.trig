<https://www.insperity.com/vocabulary/application-business-taxonomy/> {
  applicationbusinesstaxonomyvoc:business-taxonomy skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> .
  
  applicationbusinesstaxonomyvoc:filters skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> .
  
  applicationbusinesstaxonomyvoc:business-partner skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> .
  
  applicationbusinesstaxonomyvoc:customer skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> .
  
