<https://www.insperity.com/taxonomy/commercial-operations/> {
  <https://www.insperity.com/taxonomy/commercial-operations/> a skos:ConceptScheme;
    rdfs:label "Commercial Operations Taxonomy"@en;
    skos:prefLabel "Commercial Operations Taxonomy"@en;
    skos:hasTopConcept <https://www.insperity.com/taxonomy/commercial-operations/claim>,
      <https://www.insperity.com/taxonomy/commercial-operations/commercial-activity>, <https://www.insperity.com/taxonomy/commercial-operations/commercial-event>,
      <https://www.insperity.com/taxonomy/commercial-operations/commercial-measure>, <https://www.insperity.com/taxonomy/commercial-operations/commercial-operations-domain>,
      <https://www.insperity.com/taxonomy/commercial-operations/commercial-party-role>,
      <https://www.insperity.com/taxonomy/commercial-operations/commercial-record>, <https://www.insperity.com/taxonomy/commercial-operations/employment-service>,
      <https://www.insperity.com/taxonomy/commercial-operations/market-structure>, <https://www.insperity.com/taxonomy/commercial-operations/service-model>;
    skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en;
    terms:description "A classification of the commercial roles, records, agreements, service models, markets, measures, events and processes shared by the Commercial Operations domains."@en;
    terms:title "Commercial Operations Taxonomy"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_commercial_operations.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.2.0 (2026-10-20): Census moved here from pricing and contracts, because sales and pricing and contracts both use it (D2); the container holds the PEO buyer persona graph that every domain addresses. Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_commercial_operations.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.3.0 (2026-10-20): Supplier and customer of a process step (has supplier, has customer) for the SIPOCM view of assembled processes (D24), with a shape that checks they point to a party or a role. Built by build_domains.py from spec_commercial_operations.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.4.0 (2026-10-21): Restructured to the operational areas and the naming standard (D26, D27): titled 'Commercial Operations Vocabulary', '… Taxonomy', '… Ontology' and '… Shapes', at …/<kind>/commercial-operations/ (formerly …/<kind>/domain-commercial-operations/). The client service agreement, commercial agreement and clause (classes, concepts and the clause primitive) moved to Domain Legal in Business Operations. A taxonomy branch lists the area's domains. Built by build_domains.py from spec_commercial_operations.py against Baseline Core v1.0 (core 0.1.0)."@en;
    terms:created "2026-10-22"^^xsd:date;
    owl:versionInfo "0.4.0";
    terms:subject domainvoc:commercial;
    owl:versionIRI <https://www.insperity.com/taxonomy/commercial-operations/0.4.0/>;
    terms:source <https://www.insperity.com/vocabulary/core-asset/>, <https://www.insperity.com/vocabulary/core-domain/>,
      <https://www.insperity.com/vocabulary/core-event/>, <https://www.insperity.com/vocabulary/core-location/>,
      <https://www.insperity.com/vocabulary/core-party/>, <https://www.insperity.com/vocabulary/core-process/>,
      <https://www.insperity.com/vocabulary/core-product/>, <https://www.insperity.com/vocabulary/core-role/>,
      <https://www.insperity.com/vocabulary/core-services/>, <https://www.insperity.com/vocabulary/core-decision/>,
      <https://www.insperity.com/vocabulary/core-measure/>, <https://www.insperity.com/vocabulary/core-value/>,
      <https://www.insperity.com/vocabulary/commercial-operations/>;
    vaem:namespace "https://www.insperity.com/taxonomy/commercial-operations/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft;
    vann:preferredNamespacePrefix "commercialopstax";
    terms:publisher <https://www.insperity.com/resource/core/Organization/insperity>;
    terms:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/>;
    terms:identifier "taxonomy-commercial-operations";
    terms:replaces <https://www.insperity.com/taxonomy/commercial-operations/> .
  
  <https://www.insperity.com/taxonomy/commercial-operations/claim> a skos:Concept;
    rdfs:label "Claim"@en;
    skos:prefLabel "Claim"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "An information asset that records a demand for a payment, remedy or right asserted to be owed."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/commercial-operations/>;
    owl:versionInfo "0.4.0";
    terms:subject <https://www.insperity.com/vocabulary/commercial-operations/claim>;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/commercial-operations/>;
    skos:narrower <https://www.insperity.com/taxonomy/commercial-operations/insurance-claim>,
      <https://www.insperity.com/taxonomy/commercial-operations/workers-compensation-claim>;
    core:hasPrimaryTerm <https://www.insperity.com/vocabulary/commercial-operations/claim>;
    core:formalizedBy core:information-asset .
  
  <https://www.insperity.com/taxonomy/commercial-operations/commercial-activity> a skos:Concept;
    rdfs:label "Commercial activity"@en;
    skos:prefLabel "Commercial activity"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A process step performed in pursuit of, or in service of, the organization's commercial relationships and shared by more than one commercial domain."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/commercial-operations/>;
    owl:versionInfo "0.4.0";
    terms:subject partyvoc:commercial, processvoc:activity;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/commercial-operations/>;
    skos:narrower <https://www.insperity.com/taxonomy/commercial-operations/attribution>,
      <https://www.insperity.com/taxonomy/commercial-operations/enablement>, <https://www.insperity.com/taxonomy/commercial-operations/negotiation>,
      <https://www.insperity.com/taxonomy/commercial-operations/qualification>;
    core:hasPrimaryTerm processvoc:activity;
    core:formalizedBy core:process-step .
  
  <https://www.insperity.com/taxonomy/commercial-operations/commercial-event> a skos:Concept;
    rdfs:label "Commercial event"@en;
    skos:prefLabel "Commercial event"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "An event in the organization's commercial relationships that changes the state of a lead, opportunity or account."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/commercial-operations/>;
    skos:scopeNote "Agreement events (execution, amendment, renewal, termination) are in core taxonomy-core-event and are used directly."@en;
    owl:versionInfo "0.4.0";
    terms:subject eventvoc:event, partyvoc:commercial;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/commercial-operations/>;
    skos:narrower <https://www.insperity.com/taxonomy/commercial-operations/lead-conversion>,
      <https://www.insperity.com/taxonomy/commercial-operations/referral>, <https://www.insperity.com/taxonomy/commercial-operations/sale>;
    core:hasPrimaryTerm eventvoc:event;
    core:formalizedBy core:event;
    skos:broadMatch eventtax:business-event .
  
  <https://www.insperity.com/taxonomy/commercial-operations/commercial-measure> a skos:Concept;
    rdfs:label "Commercial measure"@en;
    skos:prefLabel "Commercial measure"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A measure of the organization's commercial performance shared by the Commercial Operations domains."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/commercial-operations/>;
    owl:versionInfo "0.4.0";
    terms:subject partyvoc:commercial, measurevoc:measure;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/commercial-operations/>;
    skos:narrower <https://www.insperity.com/taxonomy/commercial-operations/conversion-rate>,
      <https://www.insperity.com/taxonomy/commercial-operations/paid-worksite-employees>,
      <https://www.insperity.com/taxonomy/commercial-operations/pipeline-coverage>, <https://www.insperity.com/taxonomy/commercial-operations/win-rate>;
    core:hasPrimaryTerm measurevoc:measure;
    core:formalizedBy core:measure;
    skos:broadMatch measuretax:key-performance-indicator .
  
  <https://www.insperity.com/taxonomy/commercial-operations/commercial-operations-domain>
    a skos:Concept;
    rdfs:label "Commercial operations domain"@en;
    skos:prefLabel "Commercial operations domain"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A domain of the Commercial Operations operational area: a department that sells, markets, prices or cares for the organization's offerings and clients."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/commercial-operations/>;
