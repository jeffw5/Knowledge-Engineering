  dct:created "2026-10-19"^^xsd:date ;
  dct:modified "2026-10-19T02:19:17Z"^^xsd:dateTime .

core:Persona
  a owl:Class ;
  rdfs:label "Persona"@en ;
  skos:prefLabel "Persona"@en ;
  skos:definition "A generically dependent continuant that describes a typical party in a role, with its goals and needs, so that terms, services and products can be designed for it."@en ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom core:PartyRole ;
      owl:onProperty core:characterizes
  ] ,
      obo:BFO_0000031 ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/core/> ;
  core:hasPrimaryTerm personavoc:persona ;
  dct:subject personavoc:persona ;
