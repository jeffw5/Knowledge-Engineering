<https://www.insperity.com/ontology/core-asset/> {
  <https://www.insperity.com/ontology/core-asset/> a owl:Ontology;
    rdfs:label "Core asset ontology"@en;
    terms:description "The core ontology of assets: resources an organization controls from which it expects future economic benefit. It arranges physical, biological, human and digital assets, and the digital assets that data and knowledge work produces (data, data products, analytics, artifacts, agents, intellectual property), into one class hierarchy, with each class linked to its term in the core asset vocabulary. Domain ontologies specialize these classes."@en;
    terms:title "Core asset ontology"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T01:55:00Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-15): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2024-09-24T15:52:20.458Z"^^xsd:dateTime;
    skos:altLabel "Ontology | Core | Asset"@en;
    owl:versionInfo "0.1.0";
    owl:imports <https://www.insperity.com/ontology/core/>, <https://www.insperity.com/taxonomy/core-party/>,
      <https://www.insperity.com/taxonomy/core-product/>;
    owl:versionIRI <https://www.insperity.com/ontology/core-asset/0.1.0/>;
    vann:preferredNamespaceUri "https://www.insperity.com/ontology/core-asset/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  ont:Asset a owl:Class;
    rdfs:label "Asset"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core-asset/>;
    skos:prefLabel "Asset"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T01:55:00Z"^^xsd:dateTime;
    terms:created "2024-09-24T17:06:34.595Z"^^xsd:dateTime;
    skos:definition "A resource controlled by an entity from which future economic benefits are expected to be generated."@en;
    owl:versionInfo "0.1.0";
    dc:subject assetvoc:asset;
    core:hasLifecycleStatus core:Draft .
  
  ont:BiologicalAsset a owl:Class;
    rdfs:subClassOf ont:Asset;
    rdfs:label "Biological asset"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core-asset/>;
    skos:prefLabel "Biological asset"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T01:55:00Z"^^xsd:dateTime;
    terms:created "2024-09-24T17:06:34.595Z"^^xsd:dateTime;
    skos:definition "A living animal or plant under the control of an entity, from which future economic benefits are expected (e.g., livestock, crops)."@en;
    owl:versionInfo "0.1.0";
    dc:subject assetvoc:biological-asset;
    core:hasLifecycleStatus core:Draft .
  
  ont:HumanAsset a owl:Class;
    rdfs:subClassOf ont:BiologicalAsset, partytax:Person;
    rdfs:label "Human asset"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core-asset/>;
    skos:prefLabel "Human asset"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T01:55:00Z"^^xsd:dateTime;
    terms:created "2024-09-24T17:06:34.595Z"^^xsd:dateTime;
    skos:definition "The skills, knowledge, and experience of an organization’s workforce, considered as a valuable resource."@en;
    owl:versionInfo "0.1.0";
    dc:subject assetvoc:human-asset;
    core:hasLifecycleStatus core:Draft .
  
  ont:DigitalAsset a owl:Class;
    rdfs:subClassOf ont:Asset;
    rdfs:label "Digital asset"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core-asset/>;
    skos:prefLabel "Digital asset"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T01:55:00Z"^^xsd:dateTime;
    terms:created "2024-09-24T17:06:34.595Z"^^xsd:dateTime;
    skos:definition "Any content or data in digital form that has value and is owned or controlled by an entity (e.g., websites, documents, multimedia)."@en;
    owl:versionInfo "0.1.0";
    dc:subject assetvoc:digital-asset;
    core:hasLifecycleStatus core:Draft .
  
  ont:Analytics a owl:Class;
    rdfs:subClassOf ont:DigitalAsset;
    rdfs:label "Analytics"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core-asset/>;
    skos:prefLabel "Analytics"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T01:55:00Z"^^xsd:dateTime;
    terms:created "2024-09-24T17:33:22.282Z"^^xsd:dateTime;
    skos:definition "Tools, algorithms, models, and data that enable an organization to extract insights and value from data."@en;
    owl:versionInfo "0.1.0";
    dc:subject assetvoc:analytics;
    core:hasLifecycleStatus core:Draft .
  
  ont:AnalyticProduct a owl:Class;
    rdfs:subClassOf ont:Analytics;
    rdfs:label "Analytic product"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core-asset/>;
    skos:prefLabel "Analytic product"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T01:55:00Z"^^xsd:dateTime;
    terms:created "2024-09-24T17:33:22.282Z"^^xsd:dateTime;
    skos:definition "A packaged output or result derived from applying analytics to data, designed to address a specific business need."@en;
    owl:versionInfo "0.1.0";
    dc:subject assetvoc:analytic-product;
    core:hasLifecycleStatus core:Draft .
  
  ont:Artifact a owl:Class;
    rdfs:subClassOf ont:DigitalAsset;
    rdfs:label "Artifact"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core-asset/>;
    skos:prefLabel "Artifact"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T01:55:00Z"^^xsd:dateTime;
    terms:created "2024-09-24T17:33:22.282Z"^^xsd:dateTime;
    skos:definition "A tangible by-product produced during the software development process (e.g., documents, code, models)."@en;
    owl:versionInfo "0.1.0";
    dc:subject assetvoc:artifact;
    core:hasLifecycleStatus core:Draft .
  
  ont:BusinessSpecification a owl:Class;
    rdfs:subClassOf ont:Artifact;
    rdfs:label "Business specification"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core-asset/>;
    skos:prefLabel "Business specification"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T01:55:00Z"^^xsd:dateTime;
    terms:created "2024-09-24T20:47:11.594Z"^^xsd:dateTime;
    skos:definition "A document outlining the business requirements and objectives for a product, service, or system."@en;
    owl:versionInfo "0.1.0";
    dc:subject assetvoc:business-specification;
    core:hasLifecycleStatus core:Draft .
  
  ont:DataEngineering a owl:Class;
    rdfs:subClassOf ont:Artifact;
    rdfs:label "Data engineering"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core-asset/>;
    skos:prefLabel "Data engineering"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T01:55:00Z"^^xsd:dateTime;
    terms:created "2024-09-24T20:47:11.594Z"^^xsd:dateTime;
    skos:definition "The practice of designing, building, and maintaining systems for collecting, storing, and processing data at scale."@en;
    owl:versionInfo "0.1.0";
    dc:subject assetvoc:data-engineering;
    core:hasLifecycleStatus core:Draft .
  
  ont:DesignSpecification a owl:Class;
    rdfs:subClassOf ont:Artifact;
    rdfs:label "Design specification"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core-asset/>;
    skos:prefLabel "Design specification"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T01:55:00Z"^^xsd:dateTime;
    terms:created "2024-09-24T20:47:11.594Z"^^xsd:dateTime;
    skos:definition "A detailed document outlining the technical requirements and specifications for a product, service, or system."@en;
    owl:versionInfo "0.1.0";
    dc:subject assetvoc:design-specification;
    core:hasLifecycleStatus core:Draft .
  
  ont:DesignThinking a owl:Class;
    rdfs:subClassOf ont:Artifact;
    rdfs:label "Design thinking"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core-asset/>;
    skos:prefLabel "Design thinking"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T01:55:00Z"^^xsd:dateTime;
    terms:created "2024-09-24T20:47:11.594Z"^^xsd:dateTime;
    skos:definition "A human-centered approach to problem-solving that emphasizes empathy, experimentation, and iterative prototyping."@en;
    owl:versionInfo "0.1.0";
    dc:subject assetvoc:design-thinking;
    core:hasLifecycleStatus core:Draft .
  
  ont:DetectiveControls a owl:Class;
    rdfs:subClassOf ont:Artifact;
    rdfs:label "Detective controls"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core-asset/>;
    skos:prefLabel "Detective controls"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T01:55:00Z"^^xsd:dateTime;
    terms:created "2024-09-24T20:47:11.594Z"^^xsd:dateTime;
    skos:definition "A security mechanism designed to detect and alert on security incidents after they have occurred."@en;
    owl:versionInfo "0.1.0";
    dc:subject assetvoc:detective-controls;
    core:hasLifecycleStatus core:Draft .
  
  ont:FeatureDecomposition a owl:Class;
    rdfs:subClassOf ont:Artifact;
    rdfs:label "Feature decomposition"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core-asset/>;
    skos:prefLabel "Feature decomposition"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T01:55:00Z"^^xsd:dateTime;
    terms:created "2024-09-24T20:47:11.594Z"^^xsd:dateTime;
    skos:definition "The process of breaking down a complex feature or product into smaller, more manageable components."@en;
    owl:versionInfo "0.1.0";
    dc:subject assetvoc:feature-decomposition;
    core:hasLifecycleStatus core:Draft .
  
  ont:KnowledgeEngineering a owl:Class;
    rdfs:subClassOf ont:Artifact;
    rdfs:label "Knowledge engineering"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core-asset/>;
    skos:prefLabel "Knowledge engineering"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T01:55:00Z"^^xsd:dateTime;
    terms:created "2024-09-24T20:47:11.594Z"^^xsd:dateTime;
    skos:definition "The process of capturing, structuring, and representing knowledge from various sources to create a knowledge base."@en;
    skos:altLabel "KE"@en;
    owl:versionInfo "0.1.0";
    dc:subject assetvoc:knowledge-engineering;
    core:hasLifecycleStatus core:Draft .
  
  ont:OperationalReadiness a owl:Class;
    rdfs:subClassOf ont:Artifact;
    rdfs:label "Operational readiness"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core-asset/>;
    skos:prefLabel "Operational readiness"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T01:55:00Z"^^xsd:dateTime;
    terms:created "2024-09-24T20:47:11.594Z"^^xsd:dateTime;
    skos:definition "The state of preparedness of an organization or system to perform its intended functions effectively and efficiently."@en;
    owl:versionInfo "0.1.0";
    dc:subject assetvoc:operational-readiness;
    core:hasLifecycleStatus core:Draft .
  
  ont:OperationalStandardOperatingProcedure a owl:Class;
    rdfs:subClassOf ont:Artifact;
    rdfs:label "Operational standard operating procedure"@en;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core-asset/>;
