  dct:created "2025-04-03T21:10:10.310Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:document-and-content-management
  a skos:Concept ;
  skos:prefLabel "Document & content management"@en ;
  skos:definition "This area of DAMA-DMBOK2 deals with managing information assets stored in various formats, including electronic documents, paper records, and digital content. It covers aspects like capture, storage, retrieval, version control, retention, and disposition of documents and content."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/> ;
  skos:broader voc:data-governance ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-03-27T18:17:59.545Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:metadata
  a skos:Concept ;
  skos:prefLabel "Metadata"@en ;
  skos:definition "Data about data, providing context, definitions, and lineage information to support data governance initiatives."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/> ;
  skos:broader voc:data-governance ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-03T21:22:50.362Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:reference-and-master-data
  a skos:Concept ;
  skos:prefLabel "Reference & master data"@en ;
  skos:definition "DAMA-DMBOK2 defines reference data as relatively static data used to classify and categorize other data, such as country codes or product categories. Master data, on the other hand, represents core business entities like customers, products, and employees, providing a single, consistent view of these entities across the organization."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/> ;
  skos:broader voc:data-governance ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-03T21:26:10.681Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

