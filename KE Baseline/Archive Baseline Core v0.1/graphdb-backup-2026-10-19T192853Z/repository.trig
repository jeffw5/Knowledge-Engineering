  applicationbusinesstaxonomyvoc:market-and-sales skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> .
  
  applicationbusinesstaxonomyvoc:patterns skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> .
  
  applicationbusinesstaxonomyvoc:product skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> .
  
  applicationbusinesstaxonomyvoc:resource skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> .
  
  applicationbusinesstaxonomyvoc:service skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> .
  
  applicationbusinesstaxonomyvoc:shared skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> .
  
