marketingvoc:strengths-weaknesses-opportunities-and-threats-analysis
  a skos:Concept ;
  rdfs:label "strengths, weaknesses, opportunities and threats analysis"@en ;
  skos:prefLabel "strengths, weaknesses, opportunities and threats analysis"@en ;
  skos:altLabel "SWOT analysis"@en ;
