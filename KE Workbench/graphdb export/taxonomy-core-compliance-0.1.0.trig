    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "Policies and procedures that define how long data should be stored, archived, and eventually deleted based on legal, regulatory, and business requirements."@en;
    owl:versionInfo "0.1.0" .
  
  compliancetax:DataSharingCollaborationControls a owl:Class;
    rdfs:subClassOf compliancetax:Controls;
    rdfs:label "Data sharing & collaboration controls"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-compliance/>;
