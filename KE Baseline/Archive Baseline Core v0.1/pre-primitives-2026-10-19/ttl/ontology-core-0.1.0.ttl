core:Deprecated
  a core:LifecycleStatus ;
  rdfs:label "Deprecated"@en ;
  skos:prefLabel "Deprecated"@en ;
  skos:definition "A lifecycle status of a term or asset that is still published but should no longer be used for new work."@en ;
