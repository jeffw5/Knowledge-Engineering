<https://www.insperity.com/taxonomy/core-requirements/> {
  <https://www.insperity.com/taxonomy/core-requirements/> a skos:ConceptScheme;
    rdfs:label "Core requirements taxonomy"@en;
    skos:prefLabel "Core requirements taxonomy"@en;
    skos:hasTopConcept <https://www.insperity.com/taxonomy/core-requirements/constraint>,
      <https://www.insperity.com/taxonomy/core-requirements/knowledge-requirement>, <https://www.insperity.com/taxonomy/core-requirements/solution-requirement>,
      <https://www.insperity.com/taxonomy/core-requirements/stakeholder-requirement>, <https://www.insperity.com/taxonomy/core-requirements/transition-requirement>;
    terms:description "Classification of statements of need, capability, condition, or constraint that a solution, service, process, or knowledge artifact must satisfy."@en;
    terms:title "Core requirements taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2026-10-14"^^xsd:dateTime;
    skos:altLabel "Requirement taxonomy"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/taxonomy/core-requirements/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-requirements/constraint> a skos:Concept;
    skos:prefLabel "Constraint"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A requirement that limits the design or implementation options available."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-requirements/>;
    skos:altLabel "Design constraint"@en;
    skos:scopeNote "Distinct from data constraints in the rule taxonomy, which state what must be true about data."@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-requirements/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-requirements/business-constraint>,
      <https://www.insperity.com/taxonomy/core-requirements/technical-constraint> .
  
  <https://www.insperity.com/taxonomy/core-requirements/knowledge-requirement> a skos:Concept;
    skos:prefLabel "Knowledge requirement"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A requirement that states what governed knowledge must define or be able to answer."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-requirements/>;
    skos:altLabel "Ontology requirement"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-requirements/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-requirements/competency-question>,
      <https://www.insperity.com/taxonomy/core-requirements/coverage-requirement> .
  
  <https://www.insperity.com/taxonomy/core-requirements/solution-requirement> a skos:Concept;
    skos:prefLabel "Solution requirement"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A requirement that states a characteristic a solution must have to meet stakeholder requirements."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-requirements/>;
    skos:altLabel "Product requirement"@en, "System requirement"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-requirements/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-requirements/quality-requirement>,
      <https://www.insperity.com/taxonomy/core-requirements/data-requirement>, <https://www.insperity.com/taxonomy/core-requirements/functional-requirement>,
      <https://www.insperity.com/taxonomy/core-requirements/interface-requirement> .
  
  <https://www.insperity.com/taxonomy/core-requirements/stakeholder-requirement> a skos:Concept;
    skos:prefLabel "Stakeholder requirement"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A requirement that states what a stakeholder needs, independent of any solution."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-requirements/>;
    skos:altLabel "Stakeholder need"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-requirements/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-requirements/business-requirement>,
      <https://www.insperity.com/taxonomy/core-requirements/contractual-requirement>, <https://www.insperity.com/taxonomy/core-requirements/regulatory-requirement>,
      <https://www.insperity.com/taxonomy/core-requirements/user-requirement> .
  
  <https://www.insperity.com/taxonomy/core-requirements/transition-requirement> a skos:Concept;
    skos:prefLabel "Transition requirement"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A requirement that states a capability needed only to move from the current to the future state."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-requirements/>;
    skos:altLabel "Cutover requirement"@en, "Migration requirement"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-requirements/> .
  
  <https://www.insperity.com/taxonomy/core-requirements/accessibility-requirement> a
      skos:Concept;
    skos:prefLabel "Accessibility requirement"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A quality requirement on use by people with the widest range of abilities."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-requirements/>;
    skos:broader <https://www.insperity.com/taxonomy/core-requirements/quality-requirement>;
    skos:altLabel "WCAG requirement"@en, "Web Content Accessibility Guidelines requirement"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-requirements/quality-requirement> a skos:Concept;
    skos:prefLabel "Quality requirement"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A solution requirement that states how well the solution must perform a function or a characteristic it must exhibit."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-requirements/>;
    skos:broader <https://www.insperity.com/taxonomy/core-requirements/solution-requirement>;
    skos:altLabel "Non-functional requirement"@en, "Quality attribute requirement"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower <https://www.insperity.com/taxonomy/core-requirements/accessibility-requirement>,
      <https://www.insperity.com/taxonomy/core-requirements/availability-requirement>, <https://www.insperity.com/taxonomy/core-requirements/explainability-requirement>,
      <https://www.insperity.com/taxonomy/core-requirements/interoperability-requirement>,
      <https://www.insperity.com/taxonomy/core-requirements/maintainability-requirement>,
      <https://www.insperity.com/taxonomy/core-requirements/performance-requirement>, <https://www.insperity.com/taxonomy/core-requirements/privacy-requirement>,
      <https://www.insperity.com/taxonomy/core-requirements/reliability-requirement>, <https://www.insperity.com/taxonomy/core-requirements/scalability-requirement>,
      <https://www.insperity.com/taxonomy/core-requirements/security-requirement>, <https://www.insperity.com/taxonomy/core-requirements/usability-requirement> .
  
  <https://www.insperity.com/taxonomy/core-requirements/availability-requirement> a
      skos:Concept;
    skos:prefLabel "Availability requirement"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A quality requirement on the proportion of time a solution is operational."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-requirements/>;
    skos:broader <https://www.insperity.com/taxonomy/core-requirements/quality-requirement>;
    skos:altLabel "Uptime requirement"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-requirements/business-constraint> a skos:Concept;
    skos:prefLabel "Business constraint"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A constraint imposed by budget, schedule, staffing, or policy."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-requirements/>;
    skos:broader <https://www.insperity.com/taxonomy/core-requirements/constraint>;
    skos:altLabel "Project constraint"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-requirements/business-requirement> a skos:Concept;
    skos:prefLabel "Business requirement"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A stakeholder requirement that states an organizational goal, objective, or outcome."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-requirements/>;
    skos:broader <https://www.insperity.com/taxonomy/core-requirements/stakeholder-requirement>;
    skos:altLabel "Business need"@en, "Business objective requirement"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-requirements/competency-question> a skos:Concept;
    skos:prefLabel "Competency question"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A knowledge requirement written as a question the knowledge must be able to answer, run as a test in each release."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-requirements/>;
    skos:broader <https://www.insperity.com/taxonomy/core-requirements/knowledge-requirement>;
    skos:altLabel "CQ"@en, "Competency test"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-requirements/technical-constraint> a skos:Concept;
    skos:prefLabel "Technical constraint"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A constraint imposed by technology standards, platforms, or existing systems."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-requirements/>;
    skos:broader <https://www.insperity.com/taxonomy/core-requirements/constraint>;
    skos:altLabel "Technology constraint"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-requirements/contractual-requirement> a skos:Concept;
    skos:prefLabel "Contractual requirement"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A stakeholder requirement that arises from the terms of an agreement."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-requirements/>;
    skos:broader <https://www.insperity.com/taxonomy/core-requirements/stakeholder-requirement>;
    skos:altLabel "Contract requirement"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-requirements/coverage-requirement> a skos:Concept;
    skos:prefLabel "Coverage requirement"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A knowledge requirement on the terms, mappings, or sources that must be included."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-requirements/>;
    skos:broader <https://www.insperity.com/taxonomy/core-requirements/knowledge-requirement>;
    skos:altLabel "Mapping coverage requirement"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-requirements/data-definition-requirement>
    a skos:Concept;
    skos:prefLabel "Data definition requirement"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
