<https://www.insperity.com/vocabulary/demand-status/>
  a skos:ConceptScheme ;
  rdfs:label "Demand status vocabulary"@en ;
  skos:prefLabel "Demand status vocabulary"@en ;
  dct:title "Demand status vocabulary"@en ;
  dct:description "A controlled vocabulary of the statuses a demand item moves through in demand planning, ending with re-measurement in a later survey wave."@en ;
  dct:subject <https://www.insperity.com/taxonomy/core-domain/EnterpriseArchitecture> ;
  vaem:namespace "https://www.insperity.com/vocabulary/demand-status/"^^xsd:anyURI ;
