    skos:broader capabilityvoc:technical-capability;
    skos:altLabel "AI & ML"@en, "AI/ML"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  capabilityvoc:business-intelligence a skos:Concept;
    skos:prefLabel "Business intelligence"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:06.912Z"^^xsd:dateTime;
    skos:definition "Processes and technologies for analyzing data to gain insights, support decision-making, and improve business performance."@en;
