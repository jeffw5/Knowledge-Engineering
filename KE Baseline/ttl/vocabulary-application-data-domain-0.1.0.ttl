voc:party-community
  a skos:Concept ;
  skos:prefLabel "Party community"@en ;
  skos:definition "Data entities modeling a group (Community) of Parties (e.g., an organization) and their members, contributions, and assets."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:party ;
  owl:versionInfo "0.1.0" ;
