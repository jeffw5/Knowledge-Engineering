<https://www.insperity.com/vocabulary/core-lifecycle/> {
  <https://www.insperity.com/vocabulary/core-lifecycle/> a skos:ConceptScheme;
    rdfs:label "Core lifecycle vocabulary"@en;
    skos:prefLabel "Core lifecycle vocabulary"@en;
    skos:hasTopConcept lifecyclevoc:lifecycle;
    terms:description "The complete progression of a system or product through a series of stages, from its initial conception to its eventual retirement."@en;
    terms:title "Core lifecycle vocabulary"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2025-03-25T16:56:24.468Z"^^xsd:dateTime;
    skos:altLabel "Vocabulary | Core | Lifecycle"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/vocabulary/core-lifecycle/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  lifecyclevoc:lifecycle a skos:Concept;
    skos:prefLabel "Lifecycle"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-25T17:19:58.200Z"^^xsd:dateTime;
    skos:definition "The complete progression of a system or product through a series of stages, from its initial conception to its eventual retirement."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-lifecycle/>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/core-lifecycle/>;
    skos:narrower lifecyclevoc:acquire, lifecyclevoc:design-time, lifecyclevoc:inventory,
      lifecyclevoc:retire, lifecyclevoc:run-time .
  
  lifecyclevoc:acquire a skos:Concept;
    skos:prefLabel "Acquire"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:44:55.411Z"^^xsd:dateTime;
    skos:definition "To obtain a system, component, or resource from an external source, typically through purchase or licensing."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-lifecycle/>;
    skos:broader lifecyclevoc:lifecycle;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  lifecyclevoc:design-time a skos:Concept;
    skos:prefLabel "Design time"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:44:55.411Z"^^xsd:dateTime;
    skos:definition "The phase in the lifecycle where the system’s architecture, functionalities, and features are planned and specified."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-lifecycle/>;
    skos:broader lifecyclevoc:lifecycle;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower lifecyclevoc:build, lifecyclevoc:buy .
  
  lifecyclevoc:inventory a skos:Concept;
    skos:prefLabel "Inventory"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:44:55.411Z"^^xsd:dateTime;
    skos:definition "To catalog and manage all components, resources, and dependencies of the system."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-lifecycle/>;
    skos:broader lifecyclevoc:lifecycle;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower lifecyclevoc:publish, lifecyclevoc:warehouse .
  
  lifecyclevoc:retire a skos:Concept;
    skos:prefLabel "Retire"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:44:55.411Z"^^xsd:dateTime;
    skos:definition "To formally decommission and remove a system from operation at the end of its lifecycle."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-lifecycle/>;
    skos:broader lifecyclevoc:lifecycle;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower lifecyclevoc:destroy, lifecyclevoc:remove .
  
  lifecyclevoc:run-time a skos:Concept;
    skos:prefLabel "Run time"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:44:55.411Z"^^xsd:dateTime;
    skos:definition "The period during which the system is operational and actively executing its functionalities."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-lifecycle/>;
    skos:broader lifecyclevoc:lifecycle;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower lifecyclevoc:deploy, lifecyclevoc:execute, lifecyclevoc:support .
  
  lifecyclevoc:build a skos:Concept;
    skos:prefLabel "Build"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:44:55.411Z"^^xsd:dateTime;
    skos:definition "The stage where the system is constructed by developing code, integrating components, and implementing the design specifications."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-lifecycle/>;
    skos:broader lifecyclevoc:design-time;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower lifecyclevoc:define, lifecyclevoc:deliver, lifecyclevoc:design, lifecyclevoc:develop,
      lifecyclevoc:discover .
  
  lifecyclevoc:buy a skos:Concept;
    skos:prefLabel "Buy"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:44:55.411Z"^^xsd:dateTime;
    skos:definition "To procure necessary hardware, software, or services from external vendors."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-lifecycle/>;
    skos:broader lifecyclevoc:design-time;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  lifecyclevoc:define a skos:Concept;
    skos:prefLabel "Define"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:44:55.411Z"^^xsd:dateTime;
    skos:definition "The initial stage of outlining the purpose, scope, and requirements of the system."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-lifecycle/>;
    skos:broader lifecyclevoc:build;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  lifecyclevoc:deliver a skos:Concept;
    skos:prefLabel "Deliver"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:44:55.411Z"^^xsd:dateTime;
    skos:definition "The process of transferring the completed system or components to the end-users or customers."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-lifecycle/>;
    skos:broader lifecyclevoc:build;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  lifecyclevoc:design a skos:Concept;
    skos:prefLabel "Design"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:44:55.411Z"^^xsd:dateTime;
    skos:definition "The process of creating a detailed plan and specifications for the system based on defined requirements."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-lifecycle/>;
    skos:broader lifecyclevoc:build;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  lifecyclevoc:develop a skos:Concept;
    skos:prefLabel "Develop"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:44:55.411Z"^^xsd:dateTime;
    skos:definition "To create and implement the system’s functionalities through coding, testing, and integration of components."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-lifecycle/>;
    skos:broader lifecyclevoc:build;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  lifecyclevoc:discover a skos:Concept;
    skos:prefLabel "Discover"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:44:55.411Z"^^xsd:dateTime;
    skos:definition "To identify and gather information about existing systems, user needs, and potential solutions."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-lifecycle/>;
    skos:broader lifecyclevoc:build;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  lifecyclevoc:publish a skos:Concept;
    skos:prefLabel "Publish"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:44:55.411Z"^^xsd:dateTime;
    skos:definition "To make the system accessible to its intended users or customers."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-lifecycle/>;
    skos:broader lifecyclevoc:inventory;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  lifecyclevoc:warehouse a skos:Concept;
    skos:prefLabel "Warehouse"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:44:55.411Z"^^xsd:dateTime;
    skos:definition "To store and manage system data, artifacts, and components for future use or reference."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-lifecycle/>;
    skos:broader lifecyclevoc:inventory;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  lifecyclevoc:destroy a skos:Concept;
    skos:prefLabel "Destroy"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:44:55.411Z"^^xsd:dateTime;
    skos:definition "To completely eliminate all data and components of a system, ensuring no further use is possible."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-lifecycle/>;
    skos:broader lifecyclevoc:retire;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  lifecyclevoc:remove a skos:Concept;
    skos:prefLabel "Remove"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:44:55.411Z"^^xsd:dateTime;
    skos:definition "To uninstall or delete a system or component from its operational environment."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-lifecycle/>;
    skos:broader lifecyclevoc:retire;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  lifecyclevoc:deploy a skos:Concept;
    skos:prefLabel "Deploy"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:44:55.411Z"^^xsd:dateTime;
    skos:definition "To install and configure the system in its target environment, making it ready for use."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-lifecycle/>;
    skos:broader lifecyclevoc:run-time;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  lifecyclevoc:execute a skos:Concept;
    skos:prefLabel "Execute"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:44:55.411Z"^^xsd:dateTime;
    skos:definition "The act of running the system and performing its intended operations."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-lifecycle/>;
    skos:broader lifecyclevoc:run-time;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  lifecyclevoc:support a skos:Concept;
    skos:prefLabel "Support"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:44:55.411Z"^^xsd:dateTime;
    skos:definition "Providing ongoing maintenance, troubleshooting, and assistance to users throughout the system’s operational life."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-lifecycle/>;
    skos:broader lifecyclevoc:run-time;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower lifecyclevoc:improve .
  
  lifecyclevoc:improve a skos:Concept;
    skos:prefLabel "Improve"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:44:55.411Z"^^xsd:dateTime;
    skos:definition "To enhance the system’s performance, features, or capabilities based on user feedback and evolving requirements."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-lifecycle/>;
    skos:broader lifecyclevoc:support;
    owl:versionInfo "0.1.0";
