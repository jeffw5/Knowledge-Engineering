evid:candidate a skos:Concept ;
    rdfs:label "Candidate"@en ;
    skos:prefLabel "Candidate"@en ;
    skos:definition "An evidence status for an element coded from interviews that has not yet been reviewed."@en ;
    skos:notation "1" ;
    skos:inScheme <https://www.insperity.com/vocabulary/evidence-status/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/evidence-status/> .

evid:validated a skos:Concept ;
    rdfs:label "Validated"@en ;
    skos:prefLabel "Validated"@en ;
    skos:definition "An evidence status for an element supported by interviews and accepted by subject-matter experts."@en ;
    skos:notation "2" ;
    skos:inScheme <https://www.insperity.com/vocabulary/evidence-status/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/evidence-status/> .

evid:benchmarked a skos:Concept ;
    rdfs:label "Benchmarked"@en ;
    skos:prefLabel "Benchmarked"@en ;
    skos:definition "An evidence status for an element that is rated for importance and satisfaction in the job study survey."@en ;
    skos:notation "3" ;
    skos:inScheme <https://www.insperity.com/vocabulary/evidence-status/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/evidence-status/> .

evid:retired a skos:Concept ;
    rdfs:label "Retired"@en ;
    skos:prefLabel "Retired"@en ;
    skos:definition "An evidence status for an element merged into another or dropped after review."@en ;
    skos:notation "4" ;
    skos:inScheme <https://www.insperity.com/vocabulary/evidence-status/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/evidence-status/> .
