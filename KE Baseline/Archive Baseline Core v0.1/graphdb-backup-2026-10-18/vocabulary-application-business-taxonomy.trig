  applicationbusinesstaxonomyvoc:margin terms:created "2025-07-31T20:53:26.466Z"^^xsd:dateTime;
    skos:definition "A measure of profitability expressed as a percentage of revenue."@en .
  
  applicationbusinesstaxonomyvoc:operating-income terms:created "2025-07-31T20:53:26.466Z"^^xsd:dateTime;
    skos:definition "Profit generated from core business operations, excluding interest and taxes."@en .
  
  applicationbusinesstaxonomyvoc:gross-profit-margin terms:created "2025-07-31T20:53:31.968Z"^^xsd:dateTime;
    skos:definition "A measurement of Total Revenue minus Cost of Goods Sold divided by Revenue."@en .
  
  applicationbusinesstaxonomyvoc:net-profit-margin terms:created "2025-07-31T20:53:31.968Z"^^xsd:dateTime;
    skos:definition "A measurement of Net Income divided by Revenue."@en .
  
  applicationbusinesstaxonomyvoc:operating-profit-margin terms:created "2025-07-31T20:53:31.968Z"^^xsd:dateTime;
    skos:definition "A measurement of Operating Income divided by Revenue."@en .
  
  applicationbusinesstaxonomyvoc:account-receivable terms:created "2025-07-31T20:52:07.041Z"^^xsd:dateTime;
    skos:definition "Money owed to an enterprise by its customers for goods or services delivered but not yet paid for."@en .
  
  applicationbusinesstaxonomyvoc:billing-management terms:created "2025-07-31T20:52:07.041Z"^^xsd:dateTime;
    skos:definition "The process of generating, delivering and managing customer invoices."@en .
  
  applicationbusinesstaxonomyvoc:collections-management terms:created "2025-07-31T20:52:07.041Z"^^xsd:dateTime;
    skos:definition "The process of collecting overdue payments from customers."@en .
  
  applicationbusinesstaxonomyvoc:revenue-assurance terms:created "2025-07-31T20:52:07.041Z"^^xsd:dateTime;
    skos:definition "Ensuring that all revenue earned is accurately billed and collected."@en .
  
  applicationbusinesstaxonomyvoc:revenue-growth terms:created "2025-07-31T20:52:07.041Z"^^xsd:dateTime;
    skos:definition "The rate at which the organization's revenue is increasing over time."@en .
  
  applicationbusinesstaxonomyvoc:revenue-recovery terms:created "2025-07-31T20:52:07.041Z"^^xsd:dateTime;
    skos:definition "Recovering lost or uncollected revenue."@en .
  
  applicationbusinesstaxonomyvoc:revenue-sharing-and-settlement terms:created "2025-07-31T20:52:07.041Z"^^xsd:dateTime;
    skos:definition "A business arrangement where two or more parties agree to distribute earned revenue amongst themselves based on predetermined terms, followed by the formal process of calculating, verifying, and disbursing these allocated funds to fulfill the agreed-upon obligations."@en .
  
  applicationbusinesstaxonomyvoc:revenue-streams terms:created "2025-07-31T20:52:07.041Z"^^xsd:dateTime;
    skos:definition "The various sources from which the organization generates revenue."@en .
  
  applicationbusinesstaxonomyvoc:aging-analysis terms:created "2025-07-31T20:52:46.812Z"^^xsd:dateTime;
    skos:definition "Categorizing accounts receivable by the length of time they have been outstanding."@en .
  
  applicationbusinesstaxonomyvoc:credit-management terms:created "2025-07-31T20:52:46.812Z"^^xsd:dateTime;
    skos:definition "The process of managing credit risk and ensuring timely payment from customers."@en .
  
  applicationbusinesstaxonomyvoc:bill terms:created "2025-07-31T20:52:32.198Z"^^xsd:dateTime;
    skos:definition "A document that outlines charges for goods or services."@en .
  
  applicationbusinesstaxonomyvoc:billing-communications terms:created "2025-07-31T20:52:32.198Z"^^xsd:dateTime;
    skos:definition "The process of sending bills and other account-related information to customers, including invoices, payment reminders, and service usage summaries."@en .
  
  applicationbusinesstaxonomyvoc:billing-rate terms:created "2025-07-31T20:52:32.198Z"^^xsd:dateTime;
