  voc:decision-action
    a skos:Concept ;
    skos:prefLabel "Decision action"@en ;
    skos:definition "A specific point within a process where a choice must be made, potentially altering the process flow."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/core-process/> ;
