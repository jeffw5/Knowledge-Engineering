voc:facility-security
  a skos:Concept ;
  skos:prefLabel "Facility security"@en ;
  skos:definition "The measures taken to protect a building, its occupants, and assets from unauthorized access, physical harm, and other threats. This encompasses various aspects, including access control, surveillance, physical barriers, and incident response plans."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:countermeasures ;
  owl:versionInfo "0.1.0" ;
