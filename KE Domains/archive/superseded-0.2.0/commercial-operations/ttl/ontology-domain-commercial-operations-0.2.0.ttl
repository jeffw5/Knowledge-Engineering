  a owl:Class ;
  rdfs:label "Sale"@en ;
  skos:prefLabel "Sale"@en ;
  skos:definition "An event in which a buyer commits to acquire an offering from the organization under an agreement."@en ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom core:process-step ;
      owl:onProperty core:triggers
  ] ,
