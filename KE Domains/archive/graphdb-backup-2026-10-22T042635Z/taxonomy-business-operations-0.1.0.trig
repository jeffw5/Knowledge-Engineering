<https://www.insperity.com/taxonomy/business-operations/> {
  <https://www.insperity.com/taxonomy/business-operations/> a skos:ConceptScheme;
    rdfs:label "Business Operations Taxonomy"@en;
    skos:prefLabel "Business Operations Taxonomy"@en;
    skos:hasTopConcept businessopstax:business-operations-domain;
    skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en;
    terms:description "A classification of the Business Operations domains: finance, accounting, human resources, billing and accounts receivable, compliance, legal and security."@en;
    terms:title "Business Operations Taxonomy"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-21): first release: the shared assets of the operational area, with a taxonomy of its domains (D26). Built by build_domains.py from spec_business_operations.py against Baseline Core v1.0 (core 0.1.0)."@en;
    terms:created "2026-10-22"^^xsd:date;
    owl:versionInfo "0.1.0";
    terms:subject domainvoc:business;
    owl:versionIRI <https://www.insperity.com/taxonomy/business-operations/0.1.0/>;
    terms:source <https://www.insperity.com/vocabulary/core-domain/>, <https://www.insperity.com/vocabulary/business-operations/>;
    vaem:namespace "https://www.insperity.com/taxonomy/business-operations/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft;
    vann:preferredNamespacePrefix "businessopstax";
    terms:publisher <https://www.insperity.com/resource/core/Organization/insperity>;
    terms:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/>;
    terms:identifier "taxonomy-business-operations" .
  
  businessopstax:business-operations-domain a skos:Concept;
    rdfs:label "Business operations domain"@en;
    skos:prefLabel "Business operations domain"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A domain of the Business Operations operational area: a department that runs the organization's own business."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/business-operations/>;
    owl:versionInfo "0.1.0";
    terms:subject domainvoc:domain, domainvoc:business;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/business-operations/>;
    skos:narrower businessopstax:accounting-domain, businessopstax:billing-and-accounts-receivable-domain,
      businessopstax:compliance-domain, businessopstax:finance-domain, businessopstax:human-resources-domain,
      businessopstax:legal-domain, businessopstax:security-domain;
    core:hasPrimaryTerm domainvoc:domain;
    core:formalizedBy core:domain .
  
  businessopstax:accounting-domain a skos:Concept;
    rdfs:label "Accounting domain"@en;
    skos:prefLabel "Accounting domain"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A business operations domain that records, classifies and reports the organization's financial transactions."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/business-operations/>;
    skos:broader businessopstax:business-operations-domain;
    owl:versionInfo "0.1.0";
    terms:subject domainvoc:domain, businessopsvoc:accounting;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm domainvoc:domain .
  
  businessopstax:billing-and-accounts-receivable-domain a skos:Concept;
    rdfs:label "Billing and accounts receivable domain"@en;
    skos:prefLabel "Billing and accounts receivable domain"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A business operations domain that invoices clients for service fees and collects what they owe."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/business-operations/>;
    skos:broader businessopstax:business-operations-domain;
    owl:versionInfo "0.1.0";
    terms:subject domainvoc:domain, businessopsvoc:accounts-receivable, businessopsvoc:billing;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm domainvoc:domain .
  
  businessopstax:compliance-domain a skos:Concept;
    rdfs:label "Compliance domain"@en;
    skos:prefLabel "Compliance domain"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A business operations domain that keeps the organization in conformance with the laws, regulations and standards that apply to it."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/business-operations/>;
    skos:broader businessopstax:business-operations-domain;
    owl:versionInfo "0.1.0";
    terms:subject domainvoc:domain, domainvoc:compliance;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm domainvoc:domain .
  
  businessopstax:finance-domain a skos:Concept;
    rdfs:label "Finance domain"@en;
    skos:prefLabel "Finance domain"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A business operations domain that plans, funds and controls the organization's financial resources."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/business-operations/>;
    skos:broader businessopstax:business-operations-domain;
    owl:versionInfo "0.1.0";
    terms:subject domainvoc:domain, domainvoc:finance;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm domainvoc:domain .
  
  businessopstax:human-resources-domain a skos:Concept;
    rdfs:label "Human resources domain"@en;
    skos:prefLabel "Human resources domain"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A business operations domain that manages the organization's own employees."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/business-operations/>;
    skos:broader businessopstax:business-operations-domain;
    owl:versionInfo "0.1.0";
    terms:subject domainvoc:domain, domainvoc:human-resource;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm domainvoc:domain .
  
  businessopstax:legal-domain a skos:Concept;
    rdfs:label "Legal domain"@en;
    skos:prefLabel "Legal domain"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A business operations domain that gives legal advice and manages the organization's agreements and legal matters."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/business-operations/>;
    skos:broader businessopstax:business-operations-domain;
    owl:versionInfo "0.1.0";
    terms:subject domainvoc:domain, domainvoc:legal;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm domainvoc:domain .
  
  businessopstax:security-domain a skos:Concept;
    rdfs:label "Security domain"@en;
    skos:prefLabel "Security domain"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A business operations domain that protects the organization's people, premises and information."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/business-operations/>;
    skos:broader businessopstax:business-operations-domain;
    owl:versionInfo "0.1.0";
    terms:subject domainvoc:domain, domainvoc:security;
    core:hasLifecycleStatus core:Draft;
    core:hasPrimaryTerm domainvoc:domain .
}
