    core:hasPrimaryTerm <https://www.insperity.com/vocabulary/core-lifecycle/lifecycle> ;
    dct:subject <https://www.insperity.com/vocabulary/core-lifecycle/lifecycle> ,
        <https://www.insperity.com/vocabulary/core-process/work-item> ;
