<https://www.insperity.com/shapes/core-asset/>
  a owl:Ontology ;
  rdfs:label "Core asset shapes"@en ;
  dct:title "Core asset shapes"@en ;
  dct:description "SHACL shapes that constrain how assets, data products and analytic products relate to lifecycles, value streams, personas and parties."@en ;
  owl:imports <https://www.insperity.com/ontology/core-asset/> ,
