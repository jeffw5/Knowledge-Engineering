roletax:AgreementPartyRole
  a skos:Concept ;
  rdfs:label "Agreement party role"@en ;
  skos:prefLabel "Agreement party role"@en ;
  skos:altLabel "Contracting party"@en ;
  skos:definition "A role borne by a party because it is a signatory to or named in an agreement."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core-role/> ;
  skos:topConceptOf <https://www.insperity.com/taxonomy/core-role/> ;
  skos:narrower roletax:Guarantor , roletax:Principal , roletax:Representative ;
  core:formalizedBy core:PartyRole ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
