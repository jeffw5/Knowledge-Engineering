  dct:created "2026-10-16T23:03:55Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T23:03:55Z"^^xsd:dateTime .

tax:transaction-record
  a skos:Concept ;
  skos:prefLabel "Transaction record"@en ;
  skos:definition "A record that captures the details of a single business transaction."@en ;
  skos:example "Payment record; payroll register entry."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core/> ;
  skos:broader tax:record ;
  dc:subject tax:transaction-record ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
