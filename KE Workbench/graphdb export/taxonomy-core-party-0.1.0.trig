<https://www.insperity.com/taxonomy/core-party/> {
  <https://www.insperity.com/taxonomy/core-party/> a owl:Ontology;
    rdfs:label "Core party taxonomy"@en;
    terms:description "The party taxonomy categorizes entities such as organizations (companies, agencies), persons (individuals, contacts) and vendors (suppliers of goods or services) which helps to effectively manage relationships and interactions with various internal & external entities."@en;
    terms:title "Core party taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T02:09:15Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en,
      "2026-10-17: Conformance Review before release — 1 term removed."@en, "2026-10-17: Conformance Review before release — 1 label changed."@en,
      "2026-10-17: Conformance Review before release — 1 definition changed."@en;
    terms:created "2024-08-29T17:21:12.502Z"^^xsd:dateTime;
    skos:altLabel "Taxonomy | Core | Party"@en;
    owl:versionInfo "0.1.0";
    owl:imports <https://www.insperity.com/ontology/core/>;
    owl:versionIRI <https://www.insperity.com/taxonomy/core-party/0.1.0/>;
    vann:preferredNamespaceUri "https://www.insperity.com/taxonomy/core-party/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  partytax:Person a owl:Class;
    rdfs:subClassOf partytax:Party;
    rdfs:label "Person"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-party/>;
    skos:prefLabel "Person"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2024-10-01T19:45:51.149Z"^^xsd:dateTime;
    skos:definition "An individual, typically an employee, customer, or partner."@en;
    owl:versionInfo "0.1.0";
    dc:subject partyvoc:person;
    core:hasLifecycleStatus core:Draft .
  
  partytax:Party a owl:Class;
    rdfs:label "Party"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-party/>;
    skos:prefLabel "Party"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T02:09:15Z"^^xsd:dateTime;
    terms:created "2024-09-04T17:55:47.470Z"^^xsd:dateTime;
    skos:definition "n abstract, top-level generalized entity representing any autonomous human actor (Individual / Natural Person) or legally recognized group, collective, or organization (Institution / Legal Entity) that has agency, can incur legal rights and obligations, possess assets, or enter into transactions and relationships within an enterprise ecosystem."@en;
    owl:versionInfo "0.1.0";
    dc:subject partyvoc:party;
    core:hasLifecycleStatus core:Draft .
  
  partytax:BusinessUnit a owl:Class;
    rdfs:subClassOf partytax:Organization;
    rdfs:label "Business unit"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-party/>;
    skos:prefLabel "Business unit"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:57:55Z"^^xsd:dateTime;
    terms:created "2024-09-04T21:26:59.196Z"^^xsd:dateTime;
    skos:definition "A distinct and often independently operated segment of a company (e.g., the organization's Business Group, the organization's Consumer Group)."@en;
    owl:versionInfo "0.1.0";
    dc:subject partyvoc:business-unit;
    core:hasLifecycleStatus core:Draft .
  
  partytax:CorporateServices a owl:Class;
