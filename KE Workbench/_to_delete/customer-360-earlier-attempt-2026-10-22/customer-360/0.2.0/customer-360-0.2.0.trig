    jtbd:hasTypicalTitles "CFO, Controller, Office / Finance Manager who runs payroll"@en ;
    jtbd:hasPersonaContext "Owns payroll funding, tax deposits, GL posting and the HR provider invoice; frequently also the payroll processor in smaller firms."@en ;
    jtbd:hasBuyingRole "Evaluator and gatekeeper on total cost; often the day-to-day payroll user"@en ;
    jtbd:hasPersonaGoal "Keep employer costs predictable and the books accurate with minimal manual reconciliation."@en ;
