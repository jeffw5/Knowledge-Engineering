<https://www.insperity.com/taxonomy/core-rules/> {
  <https://www.insperity.com/taxonomy/core-rules/> a skos:ConceptScheme;
    rdfs:label "Core rules taxonomy"@en;
    skos:prefLabel "Core rules taxonomy"@en;
    skos:hasTopConcept rulestax:access-control-rule, rulestax:business-rule, rulestax:data-constraint,
      rulestax:data-quality-rule, rulestax:guardrail-rule, rulestax:transformation-rule;
    terms:description "Classification of rules, the declarative statements authored once in the single source of truth that constrain data, derive decisions, or guard the behavior of services and agents."@en;
    terms:title "Core rules taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2026-10-14"^^xsd:dateTime;
    skos:altLabel "Rule taxonomy"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/taxonomy/core-rules/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  rulestax:access-control-rule a skos:Concept;
    skos:prefLabel "Access control rule"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A rule that states which parties may read or change which information under which conditions."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-rules/>;
    skos:altLabel "Access rule"@en, "Entitlement rule"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-rules/> .
  
  rulestax:business-rule a skos:Concept;
    skos:prefLabel "Business rule"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A rule that states a business policy or decision logic in terms the business understands."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-rules/>;
    skos:altLabel "Business logic rule"@en;
    owl:versionInfo "0.1.0";
    dc:subject applicationdatadomainvoc:business-rule;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-rules/>;
    skos:narrower rulestax:authorization-rule, rulestax:decision-rule, rulestax:derivation-rule .
  
  rulestax:data-constraint a skos:Concept;
    skos:prefLabel "Data constraint"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A rule that states what must always be true about data."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-rules/>;
    skos:altLabel "Constraint rule"@en, "Integrity constraint"@en;
    skos:scopeNote "Authored as ontology terms and SHACL shapes or JSON Schema."@en;
    owl:versionInfo "0.1.0";
    dc:subject rulesvoc:constraint-rule;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-rules/>;
    skos:narrower rulestax:cardinality-constraint, rulestax:conditional-constraint, rulestax:referential-constraint,
      rulestax:temporal-constraint, rulestax:uniqueness-constraint, rulestax:value-constraint .
  
  rulestax:data-quality-rule a skos:Concept;
    skos:prefLabel "Data quality rule"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A rule that measures or enforces a dimension of data quality."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-rules/>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-rules/>;
    skos:narrower rulestax:accuracy-rule, rulestax:completeness-rule, rulestax:consistency-rule,
      rulestax:timeliness-rule, rulestax:validity-rule .
  
  rulestax:guardrail-rule a skos:Concept;
    skos:prefLabel "Guardrail rule"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A rule that limits the inputs, actions, or outputs of an automated agent."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-rules/>;
    skos:altLabel "AI guardrail"@en, "Agent guardrail"@en, "Artificial intelligence guardrail"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-rules/>;
    skos:narrower rulestax:action-guardrail, rulestax:circuit-breaker-rule, rulestax:input-guardrail,
      rulestax:output-guardrail .
  
  rulestax:transformation-rule a skos:Concept;
    skos:prefLabel "Transformation rule"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A rule that states how data in one form is converted into another form."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-rules/>;
    skos:altLabel "Conversion rule"@en, "Mapping rule"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-rules/> .
  
  rulestax:accuracy-rule a skos:Concept;
    skos:prefLabel "Accuracy rule"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A data quality rule that checks values agree with an authoritative source."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-rules/>;
    skos:broader rulestax:data-quality-rule;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  rulestax:action-guardrail a skos:Concept;
    skos:prefLabel "Action guardrail"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A guardrail rule that restricts which tools or actions an agent may take."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-rules/>;
    skos:broader rulestax:guardrail-rule;
    skos:altLabel "Tool use limit"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  rulestax:authorization-rule a skos:Concept;
    skos:prefLabel "Authorization rule"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A business rule that states who may perform or approve an action."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-rules/>;
    skos:broader rulestax:business-rule;
    skos:altLabel "Approval authority rule"@en, "Delegation of authority rule"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  rulestax:decision-rule a skos:Concept;
    skos:prefLabel "Decision rule"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A business rule that determines an outcome from input conditions, typically one row of a decision table."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-rules/>;
    skos:broader rulestax:business-rule;
    skos:altLabel "DMN rule"@en, "Decision table rule"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower rulestax:eligibility-rule, rulestax:pricing-rule, rulestax:routing-rule,
      rulestax:threshold-rule, rulestax:timing-rule .
  
  rulestax:derivation-rule a skos:Concept;
    skos:prefLabel "Derivation rule"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A business rule that states how a fact is concluded from other facts."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-rules/>;
    skos:broader rulestax:business-rule;
    skos:altLabel "Inference rule"@en, "Derived fact rule"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  rulestax:cardinality-constraint a skos:Concept;
    skos:prefLabel "Cardinality constraint"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A data constraint on how many values a property may or must have."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-rules/>;
    skos:broader rulestax:data-constraint;
    skos:altLabel "Multiplicity constraint"@en;
    skos:example "A payroll run has exactly one pay period."@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  rulestax:circuit-breaker-rule a skos:Concept;
    skos:prefLabel "Circuit breaker rule"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A guardrail rule that suspends or degrades an agent when reliability falls below a threshold."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-rules/>;
    skos:broader rulestax:guardrail-rule;
    skos:altLabel "AI circuit breaker"@en, "Artificial intelligence circuit breaker"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  rulestax:completeness-rule a skos:Concept;
    skos:prefLabel "Completeness rule"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A data quality rule that checks required values are present."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-rules/>;
    skos:broader rulestax:data-quality-rule;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  rulestax:conditional-constraint a skos:Concept;
    skos:prefLabel "Conditional constraint"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A data constraint that applies only when a stated condition holds."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-rules/>;
    skos:broader rulestax:data-constraint;
    skos:altLabel "Dependency constraint"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  rulestax:consistency-rule a skos:Concept;
    skos:prefLabel "Consistency rule"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A data quality rule that checks values agree across records and systems."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-rules/>;
    skos:broader rulestax:data-quality-rule;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  rulestax:referential-constraint a skos:Concept;
    skos:prefLabel "Referential constraint"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A data constraint that a referenced entity must exist."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-rules/>;
    skos:broader rulestax:data-constraint;
    skos:altLabel "Referential integrity rule"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  rulestax:temporal-constraint a skos:Concept;
    skos:prefLabel "Temporal constraint"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A data constraint on the order or overlap of dates and periods."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-rules/>;
    skos:broader rulestax:data-constraint;
    skos:altLabel "Date order constraint"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  rulestax:uniqueness-constraint a skos:Concept;
    skos:prefLabel "Uniqueness constraint"@en;
    terms:creator "Jeffrey Wallk";
