  a skos:Concept ;
  skos:prefLabel "General data protection regulation"@en ;
  skos:altLabel "GDPR"@en ;
  skos:definition "A comprehensive data protection regulation applicable to organizations operating within the European Union or processing the personal data of EU residents."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/> ;
