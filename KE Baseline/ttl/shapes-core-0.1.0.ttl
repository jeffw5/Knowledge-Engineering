      sh:message "A directive should govern at least one process step."@en ;
      sh:minCount "1"^^xsd:integer ;
      sh:severity sh:Warning
  ] ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
