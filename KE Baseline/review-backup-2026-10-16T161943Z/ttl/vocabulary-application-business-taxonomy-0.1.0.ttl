voc:policy
  a skos:Concept ;
  skos:prefLabel "Policy"@en ;
  skos:definition "A set of rules, guidelines, or principles that governs the actions and decisions of an organization or system."@en ;
  skos:notation "TL2000068" ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
