voc:enterprise-customer-segment
  a skos:Concept ;
  skos:prefLabel "Enterprise customer segment"@en ;
  skos:definition "Large-scale organizations, often with complex operations and a wide geographic reach."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
