dtype:fix a skos:Concept ;
    rdfs:label "Fix"@en ;
    skos:prefLabel "Fix"@en ;
    skos:definition "A demand type for outcomes where clients of the company are under-served and worse off than the alternative."@en ;
    skos:notation "1" ;
    skos:inScheme <https://www.insperity.com/vocabulary/demand-type/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/demand-type/> .

dtype:innovate a skos:Concept ;
    rdfs:label "Innovate"@en ;
    skos:prefLabel "Innovate"@en ;
    skos:definition "A demand type for outcomes that every segment finds under-served, calling for a new capability or offering."@en ;
    skos:notation "2" ;
    skos:inScheme <https://www.insperity.com/vocabulary/demand-type/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/demand-type/> .

dtype:protect a skos:Concept ;
    rdfs:label "Protect"@en ;
    skos:prefLabel "Protect"@en ;
    skos:definition "A demand type for outcomes where the company's clients are measurably better served, to be sustained and marketed."@en ;
    skos:notation "3" ;
    skos:inScheme <https://www.insperity.com/vocabulary/demand-type/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/demand-type/> .

dtype:simplify a skos:Concept ;
    rdfs:label "Simplify"@en ;
    skos:prefLabel "Simplify"@en ;
    skos:definition "A demand type for outcomes that clients rate as over-served, where effort or cost can be taken out."@en ;
    skos:notation "4" ;
    skos:inScheme <https://www.insperity.com/vocabulary/demand-type/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/demand-type/> .
