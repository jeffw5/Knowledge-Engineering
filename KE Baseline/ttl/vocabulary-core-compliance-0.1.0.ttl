  a skos:Concept ;
  skos:prefLabel "Protection of personal information act"@en ;
  skos:altLabel "PPIA"@en ;
  skos:definition "Legislation similar to PDPA, focusing on safeguarding personal information and outlining individual rights regarding their data."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/> ;
