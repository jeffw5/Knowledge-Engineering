<https://www.insperity.com/taxonomy/core-logic/> {
  <https://www.insperity.com/taxonomy/core-logic/> a skos:ConceptScheme;
    rdfs:label "Core logic taxonomy"@en;
    skos:prefLabel "Core logic taxonomy"@en;
    skos:hasTopConcept <https://www.insperity.com/taxonomy/core-logic/control-flow-logic>,
      <https://www.insperity.com/taxonomy/core-logic/data-flow-logic>, <https://www.insperity.com/taxonomy/core-logic/orchestration-logic>,
      <https://www.insperity.com/taxonomy/core-logic/reasoning-logic>, <https://www.insperity.com/taxonomy/core-logic/retrieval-logic>;
    terms:description "Classification of logic components, the governed specifications of how a multi-step process, data flow, or reasoning task is carried out by services and agents."@en;
    terms:title "Core logic taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2026-10-14"^^xsd:dateTime;
    skos:altLabel "Logic taxonomy"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/taxonomy/core-logic/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-logic/control-flow-logic> a skos:Concept;
    skos:prefLabel "Control flow logic"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A logic component that determines the order and conditions under which process steps are carried out."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-logic/>;
    skos:altLabel "Flow logic"@en, "Orchestration flow"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-logic/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-logic/error-handling-logic>,
      <https://www.insperity.com/taxonomy/core-logic/conditional-branching>, <https://www.insperity.com/taxonomy/core-logic/event-based-branching>,
      <https://www.insperity.com/taxonomy/core-logic/iteration>, <https://www.insperity.com/taxonomy/core-logic/parallel-execution>,
      <https://www.insperity.com/taxonomy/core-logic/sequence> .
  
  <https://www.insperity.com/taxonomy/core-logic/data-flow-logic> a skos:Concept;
    skos:prefLabel "Data flow logic"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A logic component that moves, transforms, or combines data."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-logic/>;
    skos:altLabel "Data pipeline logic"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-logic/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-logic/enrichment-logic>, <https://www.insperity.com/taxonomy/core-logic/filtering-logic>,
      <https://www.insperity.com/taxonomy/core-logic/matching-logic>, <https://www.insperity.com/taxonomy/core-logic/routing-logic>,
      <https://www.insperity.com/taxonomy/core-logic/transformation-logic> .
  
  <https://www.insperity.com/taxonomy/core-logic/orchestration-logic> a skos:Concept;
    skos:prefLabel "Orchestration logic"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A logic component that coordinates several services or agents to complete a request."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-logic/>;
    skos:altLabel "Coordination logic"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-logic/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-logic/agent-orchestration>,
      <https://www.insperity.com/taxonomy/core-logic/service-choreography>, <https://www.insperity.com/taxonomy/core-logic/service-orchestration> .
  
  <https://www.insperity.com/taxonomy/core-logic/reasoning-logic> a skos:Concept;
    skos:prefLabel "Reasoning logic"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A logic component that draws conclusions from facts and knowledge."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-logic/>;
    skos:altLabel "Inference logic"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-logic/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-logic/abductive-reasoning>,
      <https://www.insperity.com/taxonomy/core-logic/causal-reasoning>, <https://www.insperity.com/taxonomy/core-logic/deductive-reasoning>,
      <https://www.insperity.com/taxonomy/core-logic/inductive-reasoning>, <https://www.insperity.com/taxonomy/core-logic/probabilistic-reasoning>,
      <https://www.insperity.com/taxonomy/core-logic/temporal-reasoning> .
  
  <https://www.insperity.com/taxonomy/core-logic/retrieval-logic> a skos:Concept;
    skos:prefLabel "Retrieval logic"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A logic component that selects the governed facts and content used to answer a question."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-logic/>;
    skos:altLabel "RAG logic"@en, "Retrieval-augmented generation logic"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-logic/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-logic/context-assembly>, <https://www.insperity.com/taxonomy/core-logic/graph-traversal>,
      <https://www.insperity.com/taxonomy/core-logic/hybrid-retrieval>, <https://www.insperity.com/taxonomy/core-logic/semantic-search> .
  
  <https://www.insperity.com/taxonomy/core-logic/abductive-reasoning> a skos:Concept;
    skos:prefLabel "Abductive reasoning"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A reasoning logic that infers the most likely explanation for observations."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-logic/>;
    skos:broader <https://www.insperity.com/taxonomy/core-logic/reasoning-logic>;
    skos:altLabel "Abduction"@en, "Diagnostic reasoning"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-logic/agent-orchestration> a skos:Concept;
    skos:prefLabel "Agent orchestration"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An orchestration logic in which a coordinating agent delegates tasks to other agents and tools."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-logic/>;
    skos:broader <https://www.insperity.com/taxonomy/core-logic/orchestration-logic>;
    skos:altLabel "Agent-to-agent delegation"@en, "Multi-agent orchestration"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-logic/causal-reasoning> a skos:Concept;
    skos:prefLabel "Causal reasoning"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A reasoning logic that determines how changes in one factor produce changes in another."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-logic/>;
    skos:broader <https://www.insperity.com/taxonomy/core-logic/reasoning-logic>;
    skos:altLabel "Causal inference"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-logic/compensation-logic> a skos:Concept;
    skos:prefLabel "Compensation logic"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An error handling logic that undoes the effects of completed steps when a later step fails."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-logic/>;
    skos:broader <https://www.insperity.com/taxonomy/core-logic/error-handling-logic>;
    skos:altLabel "Rollback"@en, "Saga compensation"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-logic/error-handling-logic> a skos:Concept;
    skos:prefLabel "Error handling logic"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A control flow logic that detects failures and decides how to recover."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-logic/>;
    skos:broader <https://www.insperity.com/taxonomy/core-logic/control-flow-logic>;
    skos:altLabel "Exception handling"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower <https://www.insperity.com/taxonomy/core-logic/compensation-logic>,
      <https://www.insperity.com/taxonomy/core-logic/dead-letter-routing>, <https://www.insperity.com/taxonomy/core-logic/fallback-logic>,
      <https://www.insperity.com/taxonomy/core-logic/retry-logic> .
  
  <https://www.insperity.com/taxonomy/core-logic/conditional-branching> a skos:Concept;
    skos:prefLabel "Conditional branching"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A control flow logic in which one path is chosen from several by evaluating conditions."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-logic/>;
    skos:broader <https://www.insperity.com/taxonomy/core-logic/control-flow-logic>;
    skos:altLabel "Branch"@en, "Exclusive gateway"@en, "If then else"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-logic/context-assembly> a skos:Concept;
    skos:prefLabel "Context assembly"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A retrieval logic that composes retrieved facts, definitions, and sources into model context within a token budget."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-logic/>;
    skos:broader <https://www.insperity.com/taxonomy/core-logic/retrieval-logic>;
    skos:altLabel "Context engineering"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-logic/event-based-branching> a skos:Concept;
    skos:prefLabel "Event-based branching"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A control flow logic in which the path taken depends on which event occurs first."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-logic/>;
    skos:broader <https://www.insperity.com/taxonomy/core-logic/control-flow-logic>;
    skos:altLabel "Event gateway"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-logic/iteration> a skos:Concept;
    skos:prefLabel "Iteration"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A control flow logic in which steps repeat until a condition is met or a collection is exhausted."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-logic/>;
    skos:broader <https://www.insperity.com/taxonomy/core-logic/control-flow-logic>;
    skos:altLabel "Loop"@en, "Repeat"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-logic/parallel-execution> a skos:Concept;
    skos:prefLabel "Parallel execution"@en;
    terms:creator "Jeffrey Wallk";
