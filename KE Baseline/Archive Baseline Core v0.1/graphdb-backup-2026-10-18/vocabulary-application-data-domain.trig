    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:resource-order .
  
  applicationdatadomainvoc:resource-number-portability-role terms:created "2025-10-24T20:11:59.728Z"^^xsd:dateTime;
    skos:definition "Data entities related to the different roles (e.g., gaining provider) involved in the number portability process."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:resource-order .
  
  applicationdatadomainvoc:compound-resource-specification terms:created "2025-10-24T20:12:05.962Z"^^xsd:dateTime;
