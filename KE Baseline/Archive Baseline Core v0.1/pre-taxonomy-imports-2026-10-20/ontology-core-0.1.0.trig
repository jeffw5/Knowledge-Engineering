    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-19"^^xsd:date ;
    dct:modified "2026-10-19T18:45:40Z"^^xsd:dateTime .

  core:produces
    a owl:ObjectProperty ;
    rdfs:label "produces"@en ;
    skos:prefLabel "produces"@en ;
    skos:definition "A relation between a step and a continuant, such as a record or a product, that it creates or changes."@en ;
    rdfs:subPropertyOf obo:RO_0002234 ;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core/> ;
    owl:versionInfo "0.1.0" ;
