<https://www.insperity.com/taxonomy/core-issue/> {
  <https://www.insperity.com/taxonomy/core-issue/> a skos:ConceptScheme;
    rdfs:label "Core issue taxonomy"@en;
    skos:prefLabel "Core issue taxonomy"@en;
    skos:hasTopConcept issuetax:complaint, issuetax:defect, issuetax:exception, issuetax:incident,
      issuetax:nonconformance, issuetax:problem, issuetax:question-gap, issuetax:risk;
    terms:description "A taxonomy for classifying issues (defects, problems, incidents and requests) so that teams track, prioritize and resolve them in a consistent way."@en;
    terms:title "Core issue taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2026-10-14"^^xsd:dateTime;
    skos:altLabel "Issue taxonomy"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/taxonomy/core-issue/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  issuetax:complaint a skos:Concept;
    skos:prefLabel "Complaint"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An issue that is an expression of dissatisfaction by a party about a product, service, or interaction."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-issue/>;
    skos:altLabel "Customer complaint"@en, "Grievance"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-issue/> .
  
  issuetax:defect a skos:Concept;
    skos:prefLabel "Defect"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An issue that is a fault in an artifact causing it to differ from its specification or intended meaning."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-issue/>;
    skos:altLabel "Bug"@en, "Fault"@en;
    owl:versionInfo "0.1.0";
    dc:subject issuevoc:defect;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-issue/>;
    skos:narrower issuetax:artificial-intelligence-output-defect, issuetax:knowledge-defect,
      issuetax:data-defect, issuetax:software-defect .
  
  issuetax:exception a skos:Concept;
    skos:prefLabel "Exception"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An issue that is an approved or detected departure from the normal rule or path."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-issue/>;
    skos:altLabel "Deviation"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-issue/>;
    skos:narrower issuetax:policy-exception, issuetax:process-exception-issue .
  
  issuetax:incident a skos:Concept;
    skos:prefLabel "Incident"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An issue that is an unplanned interruption or reduction in the quality of a service."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-issue/>;
    skos:altLabel "Service incident"@en;
    owl:versionInfo "0.1.0";
    dc:subject issuevoc:incident;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-issue/>;
    skos:narrower issuetax:performance-degradation, issuetax:privacy-incident, issuetax:security-incident,
      issuetax:service-outage .
  
  issuetax:nonconformance a skos:Concept;
    skos:prefLabel "Nonconformance"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An issue in which a requirement, norm, or control is not met."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-issue/>;
    skos:altLabel "Noncompliance"@en, "Nonconformity"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-issue/>;
    skos:narrower issuetax:audit-finding, issuetax:control-deficiency, issuetax:norm-violation,
      issuetax:service-level-breach .
  
  issuetax:problem a skos:Concept;
    skos:prefLabel "Problem"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An issue that is the underlying cause of one or more incidents or defects."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-issue/>;
    skos:altLabel "Root cause problem"@en;
    skos:scopeNote "Problems are resolved by removing the cause, incidents by restoring service."@en;
    owl:versionInfo "0.1.0";
    dc:subject issuevoc:problem;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-issue/> .
  
  issuetax:question-gap a skos:Concept;
    skos:prefLabel "Question gap"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An issue in which a question cannot be answered from governed knowledge."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-issue/>;
    skos:altLabel "Knowledge gap"@en, "Unanswered question"@en, "Zero-result search"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-issue/> .
  
  issuetax:risk a skos:Concept;
    skos:prefLabel "Risk"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An issue that is the effect of uncertainty on objectives, expressed as a possible event and its consequence."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-issue/>;
    skos:altLabel "Risk item"@en;
    skos:scopeNote "A risk has not yet occurred; once it occurs it is recorded as an incident or nonconformance."@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-issue/>;
    skos:narrower issuetax:artificial-intelligence-risk, issuetax:compliance-risk, issuetax:financial-risk,
      issuetax:information-security-risk, issuetax:operational-risk, issuetax:strategic-risk .
  
  issuetax:artificial-intelligence-output-defect a skos:Concept;
    skos:prefLabel "Artificial intelligence output defect"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A defect in content generated by an artificial intelligence agent."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-issue/>;
    skos:broader issuetax:defect;
    skos:altLabel "AI output defect"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower issuetax:hallucination, issuetax:incorrect-citation, issuetax:policy-violating-output,
      issuetax:ungrounded-answer .
  
  issuetax:hallucination a skos:Concept;
    skos:prefLabel "Hallucination"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An artificial intelligence output defect in which the output states something that is not supported by governed facts or sources."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-issue/>;
    skos:broader issuetax:artificial-intelligence-output-defect;
    skos:altLabel "Confabulation"@en, "Fabricated answer"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  issuetax:incorrect-citation a skos:Concept;
    skos:prefLabel "Incorrect citation"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An artificial intelligence output defect in which an answer cites a source that does not support it."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-issue/>;
    skos:broader issuetax:artificial-intelligence-output-defect;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  issuetax:policy-violating-output a skos:Concept;
    skos:prefLabel "Policy violating output"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An artificial intelligence output defect in which the output breaches a guardrail or policy."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-issue/>;
    skos:broader issuetax:artificial-intelligence-output-defect;
    skos:altLabel "Guardrail breach"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  issuetax:ungrounded-answer a skos:Concept;
    skos:prefLabel "Ungrounded answer"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An artificial intelligence output defect in which an answer does not cite the governed terms and sources it relied on."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-issue/>;
    skos:broader issuetax:artificial-intelligence-output-defect;
    skos:altLabel "Missing citation"@en, "Untraceable answer"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  issuetax:artificial-intelligence-risk a skos:Concept;
    skos:prefLabel "Artificial intelligence risk"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A risk arising from the design, data, or use of an artificial intelligence system."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-issue/>;
    skos:broader issuetax:risk;
    skos:altLabel "AI risk"@en, "Model risk"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  issuetax:audit-finding a skos:Concept;
    skos:prefLabel "Audit finding"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A nonconformance identified and recorded during an audit."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-issue/>;
    skos:broader issuetax:nonconformance;
    skos:altLabel "Finding"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  issuetax:classification-defect a skos:Concept;
    skos:prefLabel "Classification defect"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A knowledge defect in which a term is placed under the wrong parent or has no path to the core."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-issue/>;
    skos:broader issuetax:knowledge-defect;
    skos:altLabel "Misclassification"@en, "Orphan term"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  issuetax:knowledge-defect a skos:Concept;
    skos:prefLabel "Knowledge defect"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A defect in a governed vocabulary, taxonomy, ontology, mapping, or rule."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-issue/>;
    skos:broader issuetax:defect;
    skos:altLabel "Design-time defect"@en, "Semantic defect"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower issuetax:classification-defect, issuetax:definition-defect, issuetax:label-defect,
      issuetax:mapping-defect, issuetax:rule-defect .
  
  issuetax:compliance-risk a skos:Concept;
    skos:prefLabel "Compliance risk"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A risk of failing to meet a legal, regulatory, or contractual obligation."@en;
