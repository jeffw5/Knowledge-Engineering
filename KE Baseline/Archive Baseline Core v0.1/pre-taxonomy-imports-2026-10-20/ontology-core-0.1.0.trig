  core:process-step
    a owl:Class ;
    rdfs:label "Process step"@en ;
    skos:prefLabel "Process step"@en ;
    skos:altLabel "Activity"@en , "Task"@en ;
    skos:definition "A process that is a bounded part of a larger process, performed by a party or an agent, consuming and producing continuants, and to which the organization's facts are anchored."@en ;
    skos:scopeNote "The anchor of the organization's side of the unifying ontology (§3.1): parties, roles, assets, directives, measures, issues, events, locations and times are tied to the step in which they are created, used or governed. A delivery is a process step that is the delivery of an asset; a step performed by a person is manual, one performed by a digital agent is automated."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty core:isStepOf ;
        owl:someValuesFrom core:process
    ] ,
        [
        a owl:Restriction ;
        owl:allValuesFrom core:time ;
        owl:onProperty core:occupiesTime
    ] ,
        [
        a owl:Restriction ;
        owl:allValuesFrom core:asset ;
        owl:onProperty core:deliveryOf
    ] ,
        [
        a owl:Restriction ;
        owl:allValuesFrom core:job-step ;
        owl:onProperty core:addresses
    ] ,
        [
        a owl:Restriction ;
        owl:allValuesFrom core:role ;
        owl:onProperty core:fulfillsRole
    ] ,
        [
        a owl:Restriction ;
        owl:allValuesFrom core:capability ;
        owl:onProperty core:exercisesCapability
    ] ,
        [
        a owl:Restriction ;
        owl:allValuesFrom core:directive ;
        owl:onProperty core:governedBy
    ] ,
        [
        a owl:Restriction ;
        owl:allValuesFrom core:measure ;
        owl:onProperty core:measuredBy
    ] ,
        [
        a owl:Restriction ;
        owl:allValuesFrom core:issue ;
        owl:onProperty core:hasIssue
    ] ,
        [
        a owl:Restriction ;
        owl:allValuesFrom core:event ;
        owl:onProperty core:triggeredBy
    ] ,
        [
        a owl:Restriction ;
        owl:allValuesFrom core:process-step ;
        owl:onProperty core:precedes
    ] ,
        [
        a owl:Restriction ;
        owl:allValuesFrom core:location ;
        owl:onProperty core:occursIn
    ] ,
        core:process ;
    rdfs:isDefinedBy <https://www.insperity.com/ontology/core/> ;
    core:hasPrimaryTerm processvoc:process-step ;
    dct:subject processvoc:process , processvoc:process-step , processvoc:step ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-19"^^xsd:date ;
