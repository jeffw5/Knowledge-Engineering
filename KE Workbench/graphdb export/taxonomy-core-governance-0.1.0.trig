  <https://www.insperity.com/taxonomy/core-governance/architecture-review-board> a skos:Concept;
    skos:prefLabel "Architecture review board"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
