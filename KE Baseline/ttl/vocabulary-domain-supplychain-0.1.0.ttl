voc:quality-control
  a skos:Concept ;
  skos:prefLabel "Quality control"@en ;
  skos:definition "The process of ensuring that products meet quality standards."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-supplychain/> ;
