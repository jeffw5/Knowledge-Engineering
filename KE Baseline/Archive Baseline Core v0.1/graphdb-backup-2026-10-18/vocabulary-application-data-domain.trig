    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:root-business-entities .
  
  applicationdatadomainvoc:external-system-capability terms:created "2025-10-24T20:10:06.124Z"^^xsd:dateTime;
    skos:definition "Data used to define the functional abilities (e.g., charging, fulfillment) provided by external IT systems."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:root-business-entities .
  
  applicationdatadomainvoc:root-entity-attachment terms:created "2025-10-24T20:10:06.124Z"^^xsd:dateTime;
    skos:definition "Data entities used to define and manage related files or documents (e.g., images, documentation) linked to a core entity."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:root-business-entities .
  
  applicationdatadomainvoc:root-entity-group terms:created "2025-10-24T20:10:06.124Z"^^xsd:dateTime;
    skos:definition "Data that enables core entities to be related or selected as a group, reducing the need for numerous individual relationships."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:root-business-entities .
  
  applicationdatadomainvoc:product-test terms:created "2025-10-24T20:10:46.974Z"^^xsd:dateTime;
    skos:definition "A Product Test is a function performed on a product that results in measures being produced that reflect the functioning of the product under test."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:product;
    skos:related applicationdatadomainvoc:test .
  
  applicationdatadomainvoc:resource-test terms:created "2025-10-24T20:11:44.803Z"^^xsd:dateTime;
    skos:definition "Data representing a procedure performed on a Resource (physical, logical, or compound) to diagnose or verify its function."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:resource-network-and-device;
    skos:related applicationdatadomainvoc:test .
  
  applicationdatadomainvoc:service-test terms:created "2025-10-24T20:12:39.056Z"^^xsd:dateTime;
    skos:definition "A Service Test is a controlled validation process to verify the performance, integrity, and readiness of a network service instance or configuration before, during, or after deployment."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:service-network;
    skos:related applicationdatadomainvoc:test .
  
  applicationdatadomainvoc:resource-topology terms:created "2025-10-24T20:11:44.803Z"^^xsd:dateTime;
    skos:definition "Data defining the physical, logical, and network connectivity structure between Resource entities."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:resource-network-and-device;
    skos:related applicationdatadomainvoc:topology .
  
  applicationdatadomainvoc:resource-trouble terms:created "2025-10-24T20:11:44.803Z"^^xsd:dateTime;
    skos:definition "Data managing problems (e.g., alarms, degradations) found in allocated Resource instances, including detection and resolution history."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
