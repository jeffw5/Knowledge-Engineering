jtbd:appreciative-inquiry-interview
  a owl:Class ;
  rdfs:label "Appreciative inquiry interview"@en ;
  skos:prefLabel "Appreciative inquiry interview"@en ;
  skos:definition "A process in which an interviewer asks a client persona what works at its best, what it hopes for and what it needs, to discover jobs, job steps and desired outcomes."@en ;
  rdfs:subClassOf obo:BFO_0000015 ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/jobs-to-be-done/> ;
  core:hasLifecycleStatus core:Draft ;
  dct:created "2026-10-22"^^xsd:date ;
  dct:modified "2026-10-22T19:46:03Z"^^xsd:dateTime .

jtbd:interview-note
  a owl:Class ;
  rdfs:label "Interview note"@en ;
  skos:prefLabel "Interview note"@en ;
  skos:definition "A generically dependent continuant that records one observation or quote from an appreciative inquiry interview, tagged with its inquiry phase."@en ;
  rdfs:subClassOf obo:BFO_0000031 ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/jobs-to-be-done/> ;
  core:hasLifecycleStatus core:Draft ;
