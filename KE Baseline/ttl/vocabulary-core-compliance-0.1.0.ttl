voc:personal-data-protection-act
  a skos:Concept ;
  skos:prefLabel "Personal data protection act"@en ;
  skos:altLabel "PDPA"@en ;
  skos:definition "Legislation designed to protect the personal information of individuals, often with specific requirements for data collection, storage, and use."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/> ;
