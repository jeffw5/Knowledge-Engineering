  domainsalestax:selling-activity
    a skos:Concept ;
    rdfs:label "Selling activity"@en ;
    skos:prefLabel "Selling activity"@en ;
    skos:definition "A process step a seller performs to find, advance or close opportunities."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/> ;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-sales/> ;
    skos:narrower domainsalestax:client-handoff ,
        domainsalestax:demonstration ,
        domainsalestax:objection-handling ,
        domainsalestax:outreach ,
        domainsalestax:prospecting ;
