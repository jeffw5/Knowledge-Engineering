    dct:created "2026-10-17T01:38:18Z"^^xsd:dateTime ;
    dct:modified "2026-10-18T00:25:49Z"^^xsd:dateTime .

  assettax:ComputingEquipment
    a skos:Concept ;
    rdfs:label "Computing equipment"@en ;
    skos:prefLabel "Computing equipment"@en ;
    skos:altLabel "Computing device"@en , "Hardware"@en ;
    skos:definition "An equipment that processes, stores, or displays digital information."@en ;
    skos:example "Laptop; server; tablet."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/core-asset/> ;
    skos:broader assettax:Equipment ;
    core:hasPrimaryTerm businessoperationsvoc:computing-equipment ;
