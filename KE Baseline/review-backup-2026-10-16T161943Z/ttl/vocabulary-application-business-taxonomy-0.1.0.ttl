  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:indirect
  a skos:Concept ;
  skos:prefLabel "Indirect"@en ;
  skos:definition "A sales channel that relies on intermediaries, such as distributors, resellers, or affiliates, to sell products or services on behalf of the company."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:sales-channel ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
