  dct:created "2025-10-24T20:07:48.966Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:revenue-assurance
  a skos:Concept ;
  skos:prefLabel "Revenue assurance"@en ;
  skos:definition "Data controls, violations, and KPIs used to ensure accurate revenue capture and reconciliation across all business processes."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:enterprise-corporate ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-10-24T20:07:48.966Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:workforce
  a skos:Concept ;
  skos:prefLabel "Workforce"@en ;
  skos:definition "Data modeling field resource management, including human and non-human field assets, their roles, skills, schedules, and work order assignments."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:enterprise-corporate ;
  skos:narrower voc:employee-pay ,
      voc:work-specification ,
