  voc:needs
    a skos:Concept ;
    skos:prefLabel "Needs"@en ;
    skos:definition "High-level requirements or expectations that must be met for a product or system to be successful."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/core-issue/> ;
    skos:broader voc:request ;
    owl:versionInfo "0.1.0" ;
