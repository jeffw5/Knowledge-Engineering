<https://www.insperity.com/taxonomy/domain-pricing-and-contracts/> {
  <https://www.insperity.com/taxonomy/domain-pricing-and-contracts/> a skos:ConceptScheme;
    rdfs:label "Pricing and contracts domain taxonomy"@en;
    skos:prefLabel "Pricing and contracts domain taxonomy"@en;
    skos:hasTopConcept pricingcontractstax:agreement-status, pricingcontractstax:agreement-term,
      pricingcontractstax:contract-management-step, pricingcontractstax:pricing-component,
      pricingcontractstax:pricing-model, pricingcontractstax:quote, pricingcontractstax:underwriting-input,
      pricingcontractstax:underwriting-outcome;
    skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en;
    terms:description "A classification of pricing components and models, quotes, underwriting inputs and outcomes, contract management steps, agreement terms and agreement statuses."@en;
    terms:title "Pricing and contracts domain taxonomy"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_pricing_and_contracts.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.2.0 (2026-10-20): Census moved to the Commercial Operations container (D2). Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_pricing_and_contracts.py against Baseline Core v1.0 (core 0.1.0)."@en;
    terms:created "2026-10-20"^^xsd:date;
    owl:versionInfo "0.2.0";
    terms:subject domainvoc:commercial;
    terms:isPartOf <https://www.insperity.com/domain/commercial-operations/>;
    owl:versionIRI <https://www.insperity.com/taxonomy/domain-pricing-and-contracts/0.2.0/>;
    terms:source <https://www.insperity.com/vocabulary/core-asset/>, <https://www.insperity.com/vocabulary/core-event/>,
      <https://www.insperity.com/vocabulary/core-issue/>, <https://www.insperity.com/vocabulary/core-lifecycle/>,
      <https://www.insperity.com/vocabulary/core-location/>, <https://www.insperity.com/vocabulary/core-process/>,
      <https://www.insperity.com/vocabulary/core-product/>, <https://www.insperity.com/vocabulary/core-role/>,
      <https://www.insperity.com/vocabulary/core-rules/>, <https://www.insperity.com/vocabulary/core-services/>,
      <https://www.insperity.com/vocabulary/core-time/>, <https://www.insperity.com/vocabulary/core-decision/>,
      <https://www.insperity.com/vocabulary/core-governance/>, <https://www.insperity.com/vocabulary/core-job/>,
      <https://www.insperity.com/vocabulary/core-measure/>, <https://www.insperity.com/vocabulary/core-policy/>,
      <https://www.insperity.com/vocabulary/domain-commercial-operations/>, <https://www.insperity.com/vocabulary/domain-pricing-and-contracts/>;
    vaem:namespace "https://www.insperity.com/taxonomy/domain-pricing-and-contracts/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft;
    vann:preferredNamespacePrefix "pricingcontractstax";
    terms:publisher <https://www.insperity.com/resource/core/Organization/insperity>;
    terms:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/>;
    terms:identifier "taxonomy-domain-pricing-and-contracts" .
  
  pricingcontractstax:agreement-status a skos:Concept;
    rdfs:label "Agreement status"@en;
    skos:prefLabel "Agreement status"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A status of a commercial agreement that records where it stands."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-pricing-and-contracts/>;
    owl:versionInfo "0.2.0";
    terms:subject lifecyclevoc:status, policyvoc:agreement;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-pricing-and-contracts/>;
    skos:narrower pricingcontractstax:draft-agreement, pricingcontractstax:executed-agreement,
      pricingcontractstax:expired-agreement, pricingcontractstax:terminated-agreement;
    core:hasPrimaryTerm lifecyclevoc:status;
    core:formalizedBy core:lifecycle-status .
  
  pricingcontractstax:agreement-term a skos:Concept;
    rdfs:label "Agreement term"@en;
    skos:prefLabel "Agreement term"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A clause that sets the period for which an agreement is in force and how it renews or ends."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-pricing-and-contracts/>;
    owl:versionInfo "0.2.0";
    terms:subject policyvoc:agreement, pricingcontractsvoc:term;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-pricing-and-contracts/>;
    skos:narrower pricingcontractstax:effective-date, pricingcontractstax:initial-term,
      pricingcontractstax:notice-period, pricingcontractstax:renewal-term;
    core:hasPrimaryTerm pricingcontractsvoc:term;
    core:formalizedBy commercialops:clause;
    skos:broadMatch commercialopstax:clause .
  
  pricingcontractstax:contract-management-step a skos:Concept;
    rdfs:label "Contract management step"@en;
    skos:prefLabel "Contract management step"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A process step that prepares, agrees, maintains or ends a commercial agreement."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-pricing-and-contracts/>;
    skos:scopeNote "Process steps, not lifecycle stages: the agreement, as an asset, also has the five lifecycle stages (Baseline decision 11)."@en;
    owl:versionInfo "0.2.0";
    terms:subject policyvoc:contract, processvoc:management, processvoc:step;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-pricing-and-contracts/>;
    skos:narrower pricingcontractstax:contract-amendment, pricingcontractstax:contract-approval,
      pricingcontractstax:contract-drafting, pricingcontractstax:contract-negotiation, pricingcontractstax:contract-renewal,
      pricingcontractstax:contract-termination, pricingcontractstax:pricing-review, pricingcontractstax:signature;
    core:hasPrimaryTerm processvoc:step;
    core:formalizedBy core:process-step;
    skos:broadMatch servicestax:contract-management .
  
  pricingcontractstax:pricing-component a skos:Concept;
    rdfs:label "Pricing component"@en;
    skos:prefLabel "Pricing component"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A measure that is one of the amounts or rates from which the price of a professional employer organization offering is built."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-pricing-and-contracts/>;
    owl:versionInfo "0.2.0";
    terms:subject assetvoc:component, decisionvoc:pricing;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-pricing-and-contracts/>;
    skos:narrower pricingcontractstax:benefits-rate, pricingcontractstax:discount, pricingcontractstax:employer-burden,
      pricingcontractstax:service-fee, pricingcontractstax:unemployment-insurance-rate,
      pricingcontractstax:workers-compensation-rate;
    core:hasPrimaryTerm assetvoc:component;
    core:formalizedBy core:measure .
  
  pricingcontractstax:pricing-model a skos:Concept;
    rdfs:label "Pricing model"@en;
    skos:prefLabel "Pricing model"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A directive that sets how the price of an offering is built from its pricing components."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-pricing-and-contracts/>;
    owl:versionInfo "0.2.0";
    terms:subject assetvoc:model, decisionvoc:pricing;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-pricing-and-contracts/>;
    skos:narrower pricingcontractstax:bundled-pricing, pricingcontractstax:per-worksite-employee-pricing,
      pricingcontractstax:percentage-of-payroll-pricing, pricingcontractstax:unbundled-pricing;
    core:hasPrimaryTerm assetvoc:model;
    core:formalizedBy core:directive;
    skos:broadMatch producttax:pricing-models-and-structures .
  
  pricingcontractstax:quote a skos:Concept;
    rdfs:label "Quote"@en;
    skos:prefLabel "Quote"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "An information asset that states the prices at which the organization offers an offering to a prospect or client, valid for a stated period."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-pricing-and-contracts/>;
    owl:versionInfo "0.2.0";
    terms:subject pricingcontractsvoc:quote;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-pricing-and-contracts/>;
    skos:narrower pricingcontractstax:benefits-quote, pricingcontractstax:renewal-quote,
      pricingcontractstax:workers-compensation-quote;
    core:hasPrimaryTerm pricingcontractsvoc:quote;
    core:formalizedBy pricingcontracts:quote;
    skos:broadMatch commercialopstax:proposal .
  
  pricingcontractstax:underwriting-input a skos:Concept;
    rdfs:label "Underwriting input"@en;
    skos:prefLabel "Underwriting input"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "An information asset consumed by underwriting to assess the risk of covering a client."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-pricing-and-contracts/>;
    owl:versionInfo "0.2.0";
    terms:subject processvoc:inputs, pricingcontractsvoc:underwriting;
