<https://www.insperity.com/taxonomy/core-product/> {
  <https://www.insperity.com/taxonomy/core-product/> a owl:Ontology;
    rdfs:label "Core product taxonomy"@en;
    terms:description "The product taxonomy organizes products based on shared characteristics. This structured categorization, ranging from broad concepts (business driver) to specific details (physical attributes), helps to understand how products are utilized across the organization."@en;
    terms:title "Core product taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2024-09-24T15:52:38.882Z"^^xsd:dateTime;
    skos:altLabel "Taxonomy | Core | Product"@en;
    owl:versionInfo "0.1.0";
    owl:imports <https://www.insperity.com/ontology/core/>, <https://www.insperity.com/taxonomy/core-party/>,
      <https://www.insperity.com/taxonomy/core-lifecycle/>, <https://www.insperity.com/taxonomy/core-persona/>,
      <https://www.insperity.com/taxonomy/core-valuestream/>;
    owl:versionIRI <https://www.insperity.com/taxonomy/core-product/0.1.0/>;
    vann:preferredNamespaceUri "https://www.insperity.com/taxonomy/core-product/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
