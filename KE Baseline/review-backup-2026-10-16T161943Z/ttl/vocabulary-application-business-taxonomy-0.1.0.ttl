voc:field
  a skos:Concept ;
  skos:prefLabel "Field"@en ;
  skos:definition "A sales channel involving sales representatives who travel to meet with potential customers in person, often at their place of business or events."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:sales-channel ;
  owl:versionInfo "0.1.0" ;
