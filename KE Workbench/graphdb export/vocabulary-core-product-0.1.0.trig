    terms:created "2025-03-31T18:48:06.981Z"^^xsd:dateTime;
    skos:definition "The final stage of the product lifecycle, characterized by decreasing sales and eventual withdrawal from the market."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-product/>;
    skos:broader productvoc:product-lifecycle;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
