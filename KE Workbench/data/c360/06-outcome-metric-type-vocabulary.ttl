metric:speed a skos:Concept ;
    rdfs:label "Speed"@en ;
    skos:prefLabel "Speed"@en ;
    skos:definition "An outcome metric type that measures the time required to complete part of a job."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/outcome-metric-type/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/outcome-metric-type/> .

metric:stability a skos:Concept ;
    rdfs:label "Stability"@en ;
    skos:prefLabel "Stability"@en ;
    skos:definition "An outcome metric type that measures the likelihood that part of a job goes wrong or goes right."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/outcome-metric-type/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/outcome-metric-type/> .

metric:cost-and-exposure a skos:Concept ;
    rdfs:label "Cost and exposure"@en ;
    skos:prefLabel "Cost and exposure"@en ;
    skos:definition "An outcome metric type that measures the money spent or the liability carried in getting a job done."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/outcome-metric-type/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/outcome-metric-type/> ;
    skos:altLabel "Cost & exposure"@en .

metric:effort a skos:Concept ;
    rdfs:label "Effort"@en ;
    skos:prefLabel "Effort"@en ;
    skos:definition "An outcome metric type that measures the work or administrative burden a job places on the executor."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/outcome-metric-type/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/outcome-metric-type/> .

metric:output a skos:Concept ;
    rdfs:label "Output"@en ;
    skos:prefLabel "Output"@en ;
    skos:definition "An outcome metric type that measures a count or rate produced while getting a job done."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/outcome-metric-type/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/outcome-metric-type/> .
