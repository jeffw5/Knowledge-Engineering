<https://www.insperity.com/taxonomy/core-decision/> {
  <https://www.insperity.com/taxonomy/core-decision/> a skos:ConceptScheme;
    rdfs:label "Core decision taxonomy"@en;
    skos:prefLabel "Core decision taxonomy"@en;
    skos:hasTopConcept <https://www.insperity.com/taxonomy/core-decision/decision-model>,
      <https://www.insperity.com/taxonomy/core-decision/operational-decision>, <https://www.insperity.com/taxonomy/core-decision/strategic-decision>,
      <https://www.insperity.com/taxonomy/core-decision/tactical-decision>;
    terms:description "Classification of decisions, the determinations of an outcome or course of action made by a party or automated agent, and of the models used to make them."@en;
    terms:title "Core decision taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2026-10-14"^^xsd:dateTime;
    skos:altLabel "Decision taxonomy"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/taxonomy/core-decision/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-decision/decision-model> a skos:Concept;
    skos:prefLabel "Decision model"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A decision-related information artifact that specifies how a decision is made from its inputs."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-decision/>;
    skos:altLabel "Decision logic specification"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-decision/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-decision/decision-requirements-graph>,
      <https://www.insperity.com/taxonomy/core-decision/decision-table>, <https://www.insperity.com/taxonomy/core-decision/decision-tree>,
      <https://www.insperity.com/taxonomy/core-decision/predictive-decision-model>, <https://www.insperity.com/taxonomy/core-decision/scoring-model> .
  
  <https://www.insperity.com/taxonomy/core-decision/operational-decision> a skos:Concept;
    skos:prefLabel "Operational decision"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A decision made repeatedly in the course of day-to-day work, often by rules or agents."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-decision/>;
    skos:altLabel "Day-to-day decision"@en, "Transactional decision"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-decision/>;
    skos:narrower <https://www.insperity.com/taxonomy/core-decision/allocation-decision>,
      <https://www.insperity.com/taxonomy/core-decision/answer-decision>, <https://www.insperity.com/taxonomy/core-decision/approval-decision>,
      <https://www.insperity.com/taxonomy/core-decision/classification-decision>, <https://www.insperity.com/taxonomy/core-decision/compliance-determination>,
      <https://www.insperity.com/taxonomy/core-decision/eligibility-determination>, <https://www.insperity.com/taxonomy/core-decision/exception-decision>,
      <https://www.insperity.com/taxonomy/core-decision/pricing-decision>, <https://www.insperity.com/taxonomy/core-decision/prioritization-decision>,
      <https://www.insperity.com/taxonomy/core-decision/routing-decision> .
  
  <https://www.insperity.com/taxonomy/core-decision/strategic-decision> a skos:Concept;
    skos:prefLabel "Strategic decision"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A decision that sets long-term direction, scope, or major resource commitments."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-decision/>;
    skos:altLabel "Executive decision"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-decision/> .
  
  <https://www.insperity.com/taxonomy/core-decision/tactical-decision> a skos:Concept;
    skos:prefLabel "Tactical decision"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A decision that translates strategy into plans, budgets, and allocations for a medium term."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-decision/>;
    skos:altLabel "Management decision"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-decision/> .
  
  <https://www.insperity.com/taxonomy/core-decision/allocation-decision> a skos:Concept;
    skos:prefLabel "Allocation decision"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An operational decision that distributes resources or amounts among recipients."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-decision/>;
    skos:broader <https://www.insperity.com/taxonomy/core-decision/operational-decision>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-decision/answer-decision> a skos:Concept;
    skos:prefLabel "Answer decision"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An operational decision by an artificial intelligence agent on whether to answer, ask, escalate, or decline."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-decision/>;
    skos:broader <https://www.insperity.com/taxonomy/core-decision/operational-decision>;
    skos:altLabel "Respond or escalate decision"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-decision/approval-decision> a skos:Concept;
    skos:prefLabel "Approval decision"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An operational decision that accepts or rejects a request or item."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-decision/>;
    skos:broader <https://www.insperity.com/taxonomy/core-decision/operational-decision>;
    skos:altLabel "Authorization decision"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-decision/classification-decision> a skos:Concept;
    skos:prefLabel "Classification decision"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An operational decision that assigns an item to a category."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-decision/>;
    skos:broader <https://www.insperity.com/taxonomy/core-decision/operational-decision>;
    skos:altLabel "Categorization"@en, "Triage decision"@en;
    owl:versionInfo "0.1.0";
    dc:subject applicationbusinesstaxonomyvoc:categorization;
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-decision/compliance-determination> a skos:Concept;
    skos:prefLabel "Compliance determination"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An operational decision that establishes whether an obligation applies and is met."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-decision/>;
    skos:broader <https://www.insperity.com/taxonomy/core-decision/operational-decision>;
    skos:altLabel "Compliance decision"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-decision/decision-requirements-graph> a skos:Concept;
    skos:prefLabel "Decision requirements graph"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A decision model that shows decisions, their input data, knowledge sources, and dependencies."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-decision/>;
    skos:broader <https://www.insperity.com/taxonomy/core-decision/decision-model>;
    skos:altLabel "DRD"@en, "Decision requirements diagram"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-decision/decision-table> a skos:Concept;
    skos:prefLabel "Decision table"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A decision model that maps combinations of input conditions to outputs in rows governed by a hit policy."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-decision/>;
    skos:broader <https://www.insperity.com/taxonomy/core-decision/decision-model>;
    skos:altLabel "DMN decision table"@en, "Rule table"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-decision/decision-tree> a skos:Concept;
    skos:prefLabel "Decision tree"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A decision model that reaches an outcome through a sequence of branching tests."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-decision/>;
    skos:broader <https://www.insperity.com/taxonomy/core-decision/decision-model>;
    skos:altLabel "Decision flow"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-decision/predictive-decision-model> a skos:Concept;
    skos:prefLabel "Predictive decision model"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A decision model whose output is produced by a trained machine learning model."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-decision/>;
    skos:broader <https://www.insperity.com/taxonomy/core-decision/decision-model>;
    skos:altLabel "Machine learning decision model"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-decision/scoring-model> a skos:Concept;
    skos:prefLabel "Scoring model"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A decision model that combines weighted factors into a score compared to cut-offs."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-decision/>;
    skos:broader <https://www.insperity.com/taxonomy/core-decision/decision-model>;
    skos:altLabel "Scorecard"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-decision/eligibility-determination> a skos:Concept;
    skos:prefLabel "Eligibility determination"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An operational decision that establishes whether a party qualifies for something."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-decision/>;
    skos:broader <https://www.insperity.com/taxonomy/core-decision/operational-decision>;
    skos:altLabel "Eligibility decision"@en, "Qualification decision"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core-decision/exception-decision> a skos:Concept;
    skos:prefLabel "Exception decision"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An operational decision on whether and how to handle a departure from a rule or path."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-decision/>;
    skos:broader <https://www.insperity.com/taxonomy/core-decision/operational-decision>;
    skos:altLabel "Override decision"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
