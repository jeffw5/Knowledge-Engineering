<https://www.insperity.com/vocabulary/domain-humanresource/> {
  <https://www.insperity.com/vocabulary/domain-humanresource/> a skos:ConceptScheme;
    rdfs:label "Domain humanresource vocabulary"@en;
    skos:prefLabel "Domain humanresource vocabulary"@en;
    skos:hasTopConcept <https://www.insperity.com/vocabulary/domain-humanresource/human-resource>;
    terms:description "The department within a company responsible for managing employee-related matters, including recruitment, compensation, benefits, training, and compliance with labor laws."@en;
    terms:title "Domain humanresource vocabulary"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2025-03-25T17:02:04.795Z"^^xsd:dateTime;
    skos:altLabel "Vocabulary | Domain | Human Resource"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/vocabulary/domain-humanresource/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
