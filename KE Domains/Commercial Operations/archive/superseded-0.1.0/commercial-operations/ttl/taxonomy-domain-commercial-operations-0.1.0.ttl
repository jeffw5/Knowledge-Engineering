commercialopstax:allocation-of-employer-responsibilities
  a skos:Concept ;
  rdfs:label "Allocation of employer responsibilities"@en ;
  skos:prefLabel "Allocation of employer responsibilities"@en ;
  skos:definition "A clause of a client service agreement that states which employer responsibilities the professional employer organization takes on, which the client keeps and which they share."@en ;
  skos:scopeNote "Most state professional employer organization statutes require the allocation to be in writing."@en ;
