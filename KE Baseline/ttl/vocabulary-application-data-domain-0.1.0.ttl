voc:resource-catalog
  a skos:Concept ;
  skos:prefLabel "Resource catalog"@en ;
  skos:definition "A collection of data entities representing the structured repository of Resource Specifications."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
