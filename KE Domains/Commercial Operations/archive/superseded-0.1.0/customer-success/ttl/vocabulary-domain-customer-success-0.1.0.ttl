customersuccessvoc:net-promoter-score
  a skos:Concept ;
  rdfs:label "net promoter score"@en ;
  skos:prefLabel "net promoter score"@en ;
  skos:altLabel "NPS"@en ;
  skos:definition "A measure of advocacy computed as the share of clients who would recommend the organization minus the share who would not."@en ;
  skos:scopeNote "A multiword lexical unit naming a method (Baseline decision 3)."@en ;
