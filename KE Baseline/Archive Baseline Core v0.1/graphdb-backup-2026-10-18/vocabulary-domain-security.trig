<https://www.insperity.com/vocabulary/domain-security/> {
  <https://www.insperity.com/vocabulary/domain-security/> a skos:ConceptScheme;
    rdfs:label "Domain security vocabulary"@en;
    skos:prefLabel "Domain security vocabulary"@en;
    skos:hasTopConcept domainsecurityvoc:security;
    terms:description "The practice of protecting information and systems from unauthorized access, use, disclosure, disruption, modification, or destruction."@en;
    terms:title "Domain security vocabulary"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2025-03-25T17:04:55.281Z"^^xsd:dateTime .
  
  domainsecurityvoc:security a skos:Concept;
    skos:prefLabel "Security"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-25T17:30:51.117Z"^^xsd:dateTime;
    skos:definition "The practice of protecting information and systems from unauthorized access, use, disclosure, disruption, modification, or destruction."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> .
  
  domainsecurityvoc:agent a skos:Concept;
    skos:prefLabel "Agent"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime;
    skos:definition "Person or program that performs specific tasks on behalf of a user or another program."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:security .
  
  domainsecurityvoc:countermeasures a skos:Concept;
    skos:prefLabel "Countermeasures"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime;
    skos:definition "Actions, devices, or systems implemented to mitigate security risks and vulnerabilities."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:security .
  
  domainsecurityvoc:protected-assets a skos:Concept;
    skos:prefLabel "Protected assets"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime;
    skos:definition "Valuable resources, data, or systems that need to be protected from unauthorized access or harm."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:security .
  
  domainsecurityvoc:risk a skos:Concept;
    skos:prefLabel "Risk"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-25T15:45:11.803Z"^^xsd:dateTime;
    skos:definition "The potential for loss or damage that could happen if a thread successfully exploits a vulnerability."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:security .
  
  domainsecurityvoc:security-activities a skos:Concept;
    skos:prefLabel "Security activities"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-25T15:51:22.586Z"^^xsd:dateTime;
    skos:definition "Refers to measures taken to protect individuals, organizations, or information from harm, risks, or threats."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:security .
  
  domainsecurityvoc:security-processes a skos:Concept;
    skos:prefLabel "Security processes"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-25T15:59:20.713Z"^^xsd:dateTime;
    skos:definition "The procedures and protocols designed to safeguard an organization's assets, data, and systems from unauthorized access, threats, or breaches. They encompass a range of actions, from physical security measures to cybersecurity practices, all aimed at ensuring the safety and integrity of the organization's resources."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:security .
  
  domainsecurityvoc:security-tools a skos:Concept;
    skos:prefLabel "Security tools"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T14:30:48.776Z"^^xsd:dateTime;
    skos:definition "Software or hardware used to enhance security posture and mitigate risks."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:security .
  
  domainsecurityvoc:threats a skos:Concept;
    skos:prefLabel "Threats"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T14:30:48.776Z"^^xsd:dateTime;
    skos:definition "Potential dangers or risks that could exploit vulnerabilities and cause harm."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:security .
  
  domainsecurityvoc:vulnerability a skos:Concept;
    skos:prefLabel "Vulnerability"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T14:30:48.776Z"^^xsd:dateTime;
    skos:definition "A weakness in a system or application that could be exploited by a threat."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:security .
  
  domainsecurityvoc:malware a skos:Concept;
    skos:prefLabel "Malware"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime;
    skos:definition "Malicious software designed to harm computer systems or steal data."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:agent .
  
  domainsecurityvoc:threat-actors a skos:Concept;
    skos:prefLabel "Threat actors"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T14:30:48.776Z"^^xsd:dateTime;
    skos:definition "Individuals or groups who attempt to exploit vulnerabilities for malicious purposes."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:agent .
  
  domainsecurityvoc:access-controls a skos:Concept;
    skos:prefLabel "Access controls"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime;
    skos:definition "Mechanisms that limit access to resources based on predefined rules and permissions."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:countermeasures .
  
  domainsecurityvoc:attack-management a skos:Concept;
    skos:prefLabel "Attack management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime;
    skos:definition "The process of identifying, analyzing, and responding to security incidents and attacks."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:countermeasures .
  
  domainsecurityvoc:data-protection a skos:Concept;
    skos:prefLabel "Data protection"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime;
    skos:definition "Safeguarding data from unauthorized access, use, or disclosure throughout its lifecycle."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:countermeasures .
  
  domainsecurityvoc:electronic-communication-security a skos:Concept;
    skos:prefLabel "Electronic communication security"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-25T15:39:10.237Z"^^xsd:dateTime;
    skos:definition "The measures taken to protect the privacy and integrity of electronic communications, ensuring they are secure from unauthorized access, interception, or disclosure. This includes protecting both the content of communications (like emails, text messages, and phone calls) and the infrastructure used to transmit them."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:countermeasures .
  
  domainsecurityvoc:facility-security a skos:Concept;
    skos:prefLabel "Facility security"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-25T15:40:02.502Z"^^xsd:dateTime;
    skos:definition "The measures taken to protect a building, its occupants, and assets from unauthorized access, physical harm, and other threats. This encompasses various aspects, including access control, surveillance, physical barriers, and incident response plans."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:countermeasures .
  
  domainsecurityvoc:firewall-management a skos:Concept;
    skos:prefLabel "Firewall management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime;
    skos:definition "The process of configuring, maintaining, and monitoring firewalls to control network traffic."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:countermeasures .
  
  domainsecurityvoc:mobile-device-management a skos:Concept;
    skos:prefLabel "Mobile device management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime;
    skos:definition "Security software and practices for managing and securing mobile devices in an organization."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:countermeasures .
  
  domainsecurityvoc:secure-coding-practices a skos:Concept;
    skos:prefLabel "Secure coding practices"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime;
    skos:definition "Guidelines and techniques used to develop software that is resistant to vulnerabilities."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:countermeasures .
  
  domainsecurityvoc:security-controls a skos:Concept;
    skos:prefLabel "Security controls"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T14:30:48.776Z"^^xsd:dateTime;
    skos:definition "Safeguards or countermeasures used to avoid, mitigate, or minimize security risks."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:countermeasures .
  
  domainsecurityvoc:security-requirements a skos:Concept;
    skos:prefLabel "Security requirements"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T14:30:48.776Z"^^xsd:dateTime;
    skos:definition "Specific criteria or objectives that must be met to ensure the security of a system or organization."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:countermeasures .
  
  domainsecurityvoc:user-account-management a skos:Concept;
    skos:prefLabel "User account management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T14:30:48.776Z"^^xsd:dateTime;
    skos:definition "The process of creating, managing, and disabling user accounts to control access to systems and resources."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:countermeasures .
  
  domainsecurityvoc:user-education-and-awareness a skos:Concept;
    skos:prefLabel "User education & awareness"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T14:30:48.776Z"^^xsd:dateTime;
    skos:definition "Training and communication programs to educate users about security threats and best practices."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:countermeasures .
  
  domainsecurityvoc:vulnerability-testing a skos:Concept;
    skos:prefLabel "Vulnerability testing"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T14:30:48.776Z"^^xsd:dateTime;
    skos:definition "Assessing systems and applications for weaknesses that could be exploited by attackers."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:countermeasures .
  
  domainsecurityvoc:intrusion-detection-and-prevention a skos:Concept;
    skos:prefLabel "Intrusion detection & prevention"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime;
    skos:definition "Security tools and techniques used to detect and prevent unauthorized access to networks and systems."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:attack-management .
  
  domainsecurityvoc:data-encryption a skos:Concept;
    skos:prefLabel "Data encryption"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime;
    skos:definition "Transforming data into an unreadable format to prevent unauthorized access."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:data-protection .
  
  domainsecurityvoc:data-obfuscation a skos:Concept;
    skos:prefLabel "Data obfuscation"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-25T15:36:29.672Z"^^xsd:dateTime;
    skos:definition "The process of concealing sensitive data by replacing it with modified or fake information, making it unusable to unauthorized individuals while preserving its utility for authorized users. This technique is often used to protect confidential information in test or development environments where realistic data is needed for software development but the actual data should not be exposed."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:data-protection .
  
  domainsecurityvoc:asymmetric-encryption a skos:Concept;
    skos:prefLabel "Asymmetric encryption"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-25T15:34:38.914Z"^^xsd:dateTime;
    skos:definition "A cryptographic method that uses two mathematically linked keys: a public key for encryption and a private key for decryption. This differs from symmetric encryption, which uses the same secret key for both encryption and decryption."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:data-encryption .
  
  domainsecurityvoc:symmetric-encryption a skos:Concept;
    skos:prefLabel "Symmetric encryption"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-25T15:35:13.855Z"^^xsd:dateTime;
    skos:definition "A method of encrypting and decrypting data using the same secret key. This means that both the sender and the recipient need to have access to the same key to securely encrypt and decrypt the information."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:data-encryption .
  
  domainsecurityvoc:data-masking a skos:Concept;
    skos:prefLabel "Data masking"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime;
    skos:definition "A method of protecting sensitive data by replacing it with fictitious, yet realistic, data."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/>;
    skos:broader domainsecurityvoc:data-obfuscation .
  
  domainsecurityvoc:data-randomization a skos:Concept;
    skos:prefLabel "Data randomization"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-25T15:37:18.351Z"^^xsd:dateTime;
    skos:definition "A method of modifying data values based on a randomized pattern or algorithm, often used for anonymization or data privacy purposes. It involves introducing systematic noise or changes to the original data to obscure identifying characteristics while attempting to maintain the data's utility for analysis or other intended uses."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> .
  
  domainsecurityvoc:spam-management a skos:Concept;
    skos:prefLabel "Spam management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-04-04T14:30:48.776Z"^^xsd:dateTime;
    skos:definition "Techniques and tools used to filter and block unsolicited or unwanted email messages."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> .
  
