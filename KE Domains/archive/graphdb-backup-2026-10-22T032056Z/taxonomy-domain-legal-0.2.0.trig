<https://www.insperity.com/taxonomy/domain-legal/> {
  <https://www.insperity.com/taxonomy/domain-legal/> a skos:ConceptScheme;
    rdfs:label "Domain Legal Taxonomy"@en;
    skos:prefLabel "Domain Legal Taxonomy"@en;
    skos:hasTopConcept legaltax:benefit-plan-arrangement, legaltax:commercial-legal-norm,
      legaltax:law, legaltax:legal-activity, legaltax:legal-matter, legaltax:legal-role,
      legaltax:regulatory-credential, legaltax:regulatory-requirement, legaltax:agreement-status,
      legaltax:commercial-agreement, legaltax:contract-management-step;
    skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en;
    terms:description "A classification of the law that applies to a professional employer organization's commercial operations, the commercial legal norms and regulatory requirements derived from it, contract provisions, regulatory credentials, legal matters, legal activities, legal roles and benefit plan arrangements."@en;
    terms:title "Domain Legal Taxonomy"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_legal.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.1.1 (2026-10-20): Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_legal.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.2.0 (2026-10-21): Restructured to the operational areas and the naming standard (D26, D27): titled 'Domain Legal Vocabulary', '… Taxonomy', '… Ontology' and '… Shapes'; moved from Commercial Operations to Business Operations. It now owns the client service agreement, commercial agreement and clause (from Commercial Operations) and the contract management steps, agreement terms and agreement statuses (from Pricing and contracts). It cites Commercial Operations primitives (D27) but imports only the core and the Business Operations ontology. Built by build_domains.py from spec_legal.py against Baseline Core v1.0 (core 0.1.0)."@en;
    terms:created "2026-10-22"^^xsd:date;
    owl:versionInfo "0.2.0";
    terms:subject domainvoc:legal .
  
  legaltax:benefit-plan-arrangement a skos:Concept;
    rdfs:label "Benefit plan arrangement"@en;
    skos:prefLabel "Benefit plan arrangement"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "An offering arrangement, defined by law, under which a professional employer organization provides benefits to the employees of many clients."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-legal/>;
    owl:versionInfo "0.2.0";
    terms:subject productvoc:plan, <https://www.insperity.com/vocabulary/commercial-operations/benefit> .
  
  legaltax:commercial-legal-norm a skos:Concept;
    rdfs:label "Commercial legal norm"@en;
    skos:prefLabel "Commercial legal norm"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A norm that binds a party in the organization's commercial operations."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-legal/>;
    skos:scopeNote "Specializes core taxonomy-core-policy \"Norm\" and its obligation, permission, prohibition and right."@en;
    owl:versionInfo "0.2.0";
    terms:subject partyvoc:commercial, policyvoc:norm .
  
  legaltax:contract-provision a skos:Concept;
    rdfs:label "Contract provision"@en;
    skos:prefLabel "Contract provision"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A clause of a commercial agreement that states a legal term of the relationship."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-legal/>;
    skos:broader legaltax:clause;
    owl:versionInfo "0.2.0";
    terms:subject policyvoc:contract, legalvoc:provision .
  
  legaltax:law a skos:Concept;
    rdfs:label "Law"@en;
    skos:prefLabel "Law"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A body of statutes, regulations and court decisions that applies to the organization's commercial operations."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-legal/>;
    skos:scopeNote "The named statutes specialize core taxonomy-core-policy \"Statute\" (skos:broadMatch); state law varies by jurisdiction and is modeled with legal:hasJurisdiction."@en;
    owl:versionInfo "0.2.0";
    terms:subject legalvoc:law .
  
  legaltax:legal-activity a skos:Concept;
    rdfs:label "Legal activity"@en;
    skos:prefLabel "Legal activity"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A process step performed to give legal advice or to meet a legal requirement."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-legal/>;
    owl:versionInfo "0.2.0";
    terms:subject domainvoc:legal, processvoc:activity .
  
  legaltax:legal-matter a skos:Concept;
    rdfs:label "Legal matter"@en;
    skos:prefLabel "Legal matter"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A process in which a legal issue, case or transaction is handled as a unit of legal work."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-legal/>;
    owl:versionInfo "0.2.0";
    terms:subject domainvoc:legal, legalvoc:matter .
  
  legaltax:legal-role a skos:Concept;
    rdfs:label "Legal role"@en;
    skos:prefLabel "Legal role"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A role defined by law or borne in a legal relationship."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-legal/>;
    owl:versionInfo "0.2.0";
    terms:subject domainvoc:legal, rolevoc:role .
  
  legaltax:regulatory-credential a skos:Concept;
    rdfs:label "Regulatory credential"@en;
    skos:prefLabel "Regulatory credential"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A permission, granted by a regulator or accrediting body, that the organization must hold to sell or provide an offering."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-legal/>;
    owl:versionInfo "0.2.0";
    terms:subject compliancevoc:regulation, policyvoc:permission .
  
  legaltax:regulatory-requirement a skos:Concept;
    rdfs:label "Regulatory requirement"@en;
    skos:prefLabel "Regulatory requirement"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A requirement that law places on the organization as a condition of selling or providing its offerings."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-legal/>;
    owl:versionInfo "0.2.0";
    terms:subject compliancevoc:regulation, requirementsvoc:requirement .
  
  legaltax:employee-benefits-law a skos:Concept;
    rdfs:label "Employee benefits law"@en;
    skos:prefLabel "Employee benefits law"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "Law that governs benefit plans offered to employees and the duties of those who run them."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-legal/>;
    skos:broader legaltax:law;
    owl:versionInfo "0.2.0";
    terms:subject rolevoc:employee, legalvoc:law, <https://www.insperity.com/vocabulary/commercial-operations/benefit> .
  
  legaltax:employment-law a skos:Concept;
    rdfs:label "Employment law"@en;
    skos:prefLabel "Employment law"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "Law that governs the relationship between employers and the workers they employ."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-legal/>;
    skos:broader legaltax:law;
    owl:versionInfo "0.2.0";
    terms:subject partyvoc:employment, legalvoc:law .
  
  legaltax:employment-tax-law a skos:Concept;
    rdfs:label "Employment tax law"@en;
    skos:prefLabel "Employment tax law"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "Law that imposes, and sets who must pay and report, taxes on wages."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-legal/>;
