<https://www.insperity.com/vocabulary/core-capability/> {
  <https://www.insperity.com/vocabulary/core-capability/> a skos:ConceptScheme;
    rdfs:label "Core capability vocabulary"@en;
    skos:prefLabel "Core capability vocabulary"@en;
    skos:hasTopConcept capabilityvoc:capability;
    terms:description "A measurable business competency achieved through the combined effectiveness of people, processes, and technology."@en;
    terms:title "Core capability vocabulary"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2025-03-25T17:00:13.295Z"^^xsd:dateTime;
    skos:altLabel "Vocabulary | Core | Capability"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/vocabulary/core-capability/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  capabilityvoc:capability a skos:Concept;
    skos:prefLabel "Capability"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-25T17:24:52.903Z"^^xsd:dateTime;
    skos:definition "A measurable business competency achieved through the combined effectiveness of people, processes, and technology."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-capability/>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/core-capability/>;
    skos:narrower capabilityvoc:business-capability, capabilityvoc:functional-capability,
      capabilityvoc:technical-capability .
  
  capabilityvoc:business-capability a skos:Concept;
    skos:prefLabel "Business capability"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:06.912Z"^^xsd:dateTime;
    skos:definition "A specific ability or competency that a business possesses to achieve a desired outcome, e.g., marketing, sales, or product development."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-capability/>;
    skos:broader capabilityvoc:capability;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower capabilityvoc:business-marketplace, capabilityvoc:product-management,
      capabilityvoc:risk-management, capabilityvoc:service-activation-management, capabilityvoc:service-assurance-management,
      capabilityvoc:service-provisioning-management .
  
  capabilityvoc:functional-capability a skos:Concept;
    skos:prefLabel "Functional capability"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:06.912Z"^^xsd:dateTime;
    skos:definition "A specific ability or function within a broader business capability, e.g., online payment processing within the sales capability."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-capability/>;
    skos:broader capabilityvoc:capability;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower capabilityvoc:billing-and-accounting-management, capabilityvoc:customer-relationship-management,
      capabilityvoc:order-management, capabilityvoc:product-data-syndication, capabilityvoc:product-information-management,
      capabilityvoc:resource-management, capabilityvoc:service-portfolio-management .
  
  capabilityvoc:technical-capability a skos:Concept;
    skos:prefLabel "Technical capability"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:06.912Z"^^xsd:dateTime;
    skos:definition "An organization’s ability to effectively utilize technology and technical expertise to achieve business objectives."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-capability/>;
    skos:broader capabilityvoc:capability;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower capabilityvoc:artificial-intelligence-and-machine-learning, capabilityvoc:business-intelligence,
      capabilityvoc:data-and-process-integration, capabilityvoc:data-architecture, capabilityvoc:data-catalog,
      capabilityvoc:data-discovery, capabilityvoc:data-fabric, capabilityvoc:data-lineage-management,
      capabilityvoc:data-management, capabilityvoc:data-marketplace, capabilityvoc:data-quality-capability,
      capabilityvoc:data-reporting, capabilityvoc:data-science, capabilityvoc:digital-asset-management,
      capabilityvoc:integration, capabilityvoc:master-data-management, capabilityvoc:metric-management,
      capabilityvoc:storage-management, capabilityvoc:test-data-management .
  
  capabilityvoc:business-marketplace a skos:Concept;
    skos:prefLabel "Business marketplace"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:06.912Z"^^xsd:dateTime;
    skos:definition "A platform facilitating transactions between businesses, often involving products, services, or data exchange."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-capability/>;
    skos:broader capabilityvoc:business-capability;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  capabilityvoc:product-management a skos:Concept;
    skos:prefLabel "Product management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:06.912Z"^^xsd:dateTime;
    skos:definition "The strategic process of planning, developing, launching, and managing products or services throughout their lifecycle."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-capability/>;
    skos:broader capabilityvoc:business-capability;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  capabilityvoc:risk-management a skos:Concept;
    skos:prefLabel "Risk management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:06.912Z"^^xsd:dateTime;
    skos:definition "The identification, assessment, and prioritization of potential risks, followed by coordinated efforts to minimize, control, or eliminate their impact."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-capability/>;
    skos:broader capabilityvoc:business-capability;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  capabilityvoc:service-activation-management a skos:Concept;
    skos:prefLabel "Service activation management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:06.912Z"^^xsd:dateTime;
    skos:definition "Processes ensuring new or modified services are effectively set up, tested, and deployed to customers."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-capability/>;
    skos:broader capabilityvoc:business-capability;
    skos:altLabel "SAM"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  capabilityvoc:service-assurance-management a skos:Concept;
    skos:prefLabel "Service assurance management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:06.912Z"^^xsd:dateTime;
    skos:definition "Activities focused on maintaining and improving the quality and reliability of services delivered to customers."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-capability/>;
    skos:broader capabilityvoc:business-capability;
    skos:altLabel "SAM"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  capabilityvoc:service-provisioning-management a skos:Concept;
    skos:prefLabel "Service provisioning management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:06.912Z"^^xsd:dateTime;
    skos:definition "Processes related to providing and managing access to IT services for users and systems."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-capability/>;
    skos:broader capabilityvoc:business-capability;
    skos:altLabel "SPM"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  capabilityvoc:billing-and-accounting-management a skos:Concept;
    skos:prefLabel "Billing & accounting management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:06.912Z"^^xsd:dateTime;
    skos:definition "Processes encompassing invoicing, payment processing, revenue tracking, and financial reporting."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-capability/>;
    skos:broader capabilityvoc:functional-capability;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  capabilityvoc:customer-relationship-management a skos:Concept;
    skos:prefLabel "Customer relationship management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:06.912Z"^^xsd:dateTime;
    skos:definition "Strategies, processes, and tools used to manage interactions with existing and potential customers."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-capability/>;
    skos:broader capabilityvoc:functional-capability;
    skos:altLabel "CRM"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  capabilityvoc:order-management a skos:Concept;
    skos:prefLabel "Order management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:06.912Z"^^xsd:dateTime;
    skos:definition "Processes for receiving, processing, fulfilling, and tracking customer orders."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-capability/>;
    skos:broader capabilityvoc:functional-capability;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  capabilityvoc:product-data-syndication a skos:Concept;
    skos:prefLabel "Product data syndication"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:06.912Z"^^xsd:dateTime;
    skos:definition "The distribution of standardized product information from suppliers to retailers or other channels."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-capability/>;
    skos:broader capabilityvoc:functional-capability;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  capabilityvoc:product-information-management a skos:Concept;
    skos:prefLabel "Product information management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:06.912Z"^^xsd:dateTime;
    skos:definition "Centralized management of product information across its entire lifecycle, ensuring consistency and accuracy."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-capability/>;
    skos:broader capabilityvoc:functional-capability;
    skos:altLabel "PIM"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  capabilityvoc:resource-management a skos:Concept;
    skos:prefLabel "Resource management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:06.912Z"^^xsd:dateTime;
    skos:definition "Efficient and effective allocation, utilization, and monitoring of resources, including personnel, equipment, and finances."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-capability/>;
    skos:broader capabilityvoc:functional-capability;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  capabilityvoc:service-portfolio-management a skos:Concept;
    skos:prefLabel "Service portfolio management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:06.912Z"^^xsd:dateTime;
    skos:definition "The strategic management of an organization’s entire portfolio of services, aligning them with business goals and customer needs."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/core-capability/>;
    skos:broader capabilityvoc:functional-capability;
    skos:altLabel "SPM"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  capabilityvoc:artificial-intelligence-and-machine-learning a skos:Concept;
    skos:prefLabel "Artificial intelligence & machine learning"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:53:06.912Z"^^xsd:dateTime;
    skos:definition "The simulation of human intelligence processes by computer systems, including learning, reasoning, and self-correction."@en;
