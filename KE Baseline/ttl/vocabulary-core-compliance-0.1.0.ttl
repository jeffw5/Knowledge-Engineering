  a skos:Concept ;
  skos:prefLabel "Data retention & deletion controls"@en ;
  skos:definition "Policies and procedures that define how long data should be stored, archived, and eventually deleted based on legal, regulatory, and business requirements."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/> ;
