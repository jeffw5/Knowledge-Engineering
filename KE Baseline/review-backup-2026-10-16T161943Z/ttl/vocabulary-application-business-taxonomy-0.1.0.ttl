voc:business
  a skos:Concept ;
  skos:prefLabel "Business"@en ;
  skos:definition "Organizations that purchase goods or services to support their operations, production, or resale activities."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
