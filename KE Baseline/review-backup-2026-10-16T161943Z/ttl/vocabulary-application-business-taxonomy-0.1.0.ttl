  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:retail-sales
  a skos:Concept ;
  skos:prefLabel "Retail sales"@en ;
  skos:definition "A sales channel where products are sold directly to consumers through physical stores owned or operated by the company."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:sales-channel ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-08-01T19:18:08.377Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:system-integrator
  a skos:Concept ;
  skos:prefLabel "System integrator"@en ;
  skos:altLabel "SI"@en , "System Integrator"@en ;
  skos:definition "An acronym for System Integrator, this is a specialized type of indirect partner that designs, builds, and implements complex technology systems, often incorporating products or services from multiple vendors."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:sales-channel ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
