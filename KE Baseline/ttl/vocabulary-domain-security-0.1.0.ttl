  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:asymmetric-encryption
  a skos:Concept ;
  skos:prefLabel "Asymmetric encryption"@en ;
  skos:altLabel "Public-Key Encryption"@en ;
  skos:definition "A cryptographic method that uses two mathematically linked keys: a public key for encryption and a private key for decryption. This differs from symmetric encryption, which uses the same secret key for both encryption and decryption."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:data-encryption ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T15:34:38.914Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:symmetric-encryption
  a skos:Concept ;
  skos:prefLabel "Symmetric encryption"@en ;
  skos:altLabel "Secret-key Encryption"@en ;
  skos:definition "A method of encrypting and decrypting data using the same secret key. This means that both the sender and the recipient need to have access to the same key to securely encrypt and decrypt the information."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:data-encryption ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T15:35:13.855Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:data-obfuscation
  a skos:Concept ;
  skos:prefLabel "Data obfuscation"@en ;
  skos:definition "The process of concealing sensitive data by replacing it with modified or fake information, making it unusable to unauthorized individuals while preserving its utility for authorized users. This technique is often used to protect confidential information in test or development environments where realistic data is needed for software development but the actual data should not be exposed."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:data-protection ;
  skos:narrower voc:data-masking , voc:data-randomization ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T15:36:29.672Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:data-masking
  a skos:Concept ;
  skos:prefLabel "Data masking"@en ;
  skos:definition "A method of protecting sensitive data by replacing it with fictitious, yet realistic, data."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:data-obfuscation ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-04T14:30:27.297Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:data-randomization
  a skos:Concept ;
  skos:prefLabel "Data randomization"@en ;
  skos:definition "A method of modifying data values based on a randomized pattern or algorithm, often used for anonymization or data privacy purposes. It involves introducing systematic noise or changes to the original data to obscure identifying characteristics while attempting to maintain the data's utility for analysis or other intended uses."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:data-obfuscation ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T15:37:18.351Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:electronic-communication-security
  a skos:Concept ;
  skos:prefLabel "Electronic communication security"@en ;
  skos:definition "The measures taken to protect the privacy and integrity of electronic communications, ensuring they are secure from unauthorized access, interception, or disclosure. This includes protecting both the content of communications (like emails, text messages, and phone calls) and the infrastructure used to transmit them."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:countermeasures ;
  skos:narrower voc:spam-management ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2025-04-25T15:39:10.237Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:spam-management
  a skos:Concept ;
  skos:prefLabel "Spam management"@en ;
  skos:definition "Techniques and tools used to filter and block unsolicited or unwanted email messages."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:electronic-communication-security ;
  owl:versionInfo "0.1.0" ;
