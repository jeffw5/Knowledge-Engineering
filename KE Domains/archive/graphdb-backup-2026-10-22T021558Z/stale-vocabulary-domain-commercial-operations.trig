<https://www.insperity.com/vocabulary/domain-commercial-operations/> {
  <https://www.insperity.com/vocabulary/domain-commercial-operations/> a skos:ConceptScheme;
    rdfs:label "Commercial operations domain vocabulary"@en;
    skos:prefLabel "Commercial operations domain vocabulary"@en;
    skos:hasTopConcept domaincommercialoperationsvoc:account, domaincommercialoperationsvoc:administrative-services-organization,
      domaincommercialoperationsvoc:analysis, domaincommercialoperationsvoc:attribution,
      domaincommercialoperationsvoc:benefit, domaincommercialoperationsvoc:buyer, domaincommercialoperationsvoc:census,
      domaincommercialoperationsvoc:claim, domaincommercialoperationsvoc:clause, domaincommercialoperationsvoc:commission,
      domaincommercialoperationsvoc:competitor, domaincommercialoperationsvoc:conversion,
      domaincommercialoperationsvoc:enablement, domaincommercialoperationsvoc:engagement,
      domaincommercialoperationsvoc:human-capital-management, domaincommercialoperationsvoc:ideal-customer-profile,
      domaincommercialoperationsvoc:incentive, domaincommercialoperationsvoc:industry, domaincommercialoperationsvoc:influence,
      domaincommercialoperationsvoc:insurance, domaincommercialoperationsvoc:lead, domaincommercialoperationsvoc:negotiation,
      domaincommercialoperationsvoc:opportunity, domaincommercialoperationsvoc:payroll,
      domaincommercialoperationsvoc:pipeline, domaincommercialoperationsvoc:professional-employer-organization,
      domaincommercialoperationsvoc:proposal, domaincommercialoperationsvoc:qualification,
      domaincommercialoperationsvoc:referral, domaincommercialoperationsvoc:registration,
      domaincommercialoperationsvoc:sale, domaincommercialoperationsvoc:segment, domaincommercialoperationsvoc:signal,
      domaincommercialoperationsvoc:stage, domaincommercialoperationsvoc:territory, domaincommercialoperationsvoc:unemployment,
      domaincommercialoperationsvoc:win, domaincommercialoperationsvoc:workers-compensation;
    skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en;
    terms:description "A controlled vocabulary of the primitives that the Commercial Operations domains of a professional employer organization share: the accounts, leads, opportunities, proposals and agreements that pass between marketing, sales, pricing and contracts, legal, customer success and partners, and the employment-cost services a professional employer organization sells."@en;
    terms:title "Commercial operations domain vocabulary"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T17:03:21Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_commercial_operations.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.2.0 (2026-10-20): Census moved here from pricing and contracts, because sales and pricing and contracts both use it (D2); the container holds the PEO buyer persona graph that every domain addresses. Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_commercial_operations.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.3.0 (2026-10-20): Supplier and customer of a process step (has supplier, has customer) for the SIPOCM view of assembled processes (D24), with a shape that checks they point to a party or a role. Built by build_domains.py from spec_commercial_operations.py against Baseline Core v1.0 (core 0.1.0)."@en;
    terms:created "2026-10-20"^^xsd:date;
    owl:versionInfo "0.3.0";
    terms:subject domainvoc:commercial;
    terms:isPartOf <https://www.insperity.com/domain/commercial-operations/>;
    owl:versionIRI <https://www.insperity.com/vocabulary/domain-commercial-operations/0.3.0/>;
    vaem:namespace "https://www.insperity.com/vocabulary/domain-commercial-operations/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft;
    vann:preferredNamespacePrefix "commercialopsvoc";
    terms:publisher <https://www.insperity.com/resource/core/Organization/insperity>;
    terms:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/>;
    terms:identifier "vocabulary-domain-commercial-operations" .
  
  domaincommercialoperationsvoc:account a skos:Concept;
    rdfs:label "account"@en;
    skos:prefLabel "account"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T17:03:21Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A record of the commercial relationship between the organization and a party that is, or may become, a client."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-commercial-operations/>;
    skos:scopeNote "The record, not the party: the party bears the prospect or client role; the account is about it. Relinks core-services \"sales account\", which is polymorphic."@en;
    owl:versionInfo "0.3.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-commercial-operations/> .
  
  domaincommercialoperationsvoc:administrative-services-organization a skos:Concept;
    rdfs:label "administrative services organization"@en;
    skos:prefLabel "administrative services organization"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T17:03:21Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "An organization that provides human resources, payroll and benefits administration to a client without entering a co-employment relationship."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-commercial-operations/>;
    skos:altLabel "ASO"@en;
    skos:scopeNote "A multiword lexical unit (Baseline decision 3)."@en;
    owl:versionInfo "0.3.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-commercial-operations/> .
  
  domaincommercialoperationsvoc:analysis a skos:Concept;
    rdfs:label "analysis"@en;
    skos:prefLabel "analysis"@en;
    skos:editorialNote "Candidate for promotion to the core: General primitive missing from the core (core-services holds only polymorphic analysis terms)."@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T17:03:21Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A detailed examination of the elements or structure of something to understand it or inform a decision."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-commercial-operations/>;
    owl:versionInfo "0.3.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-commercial-operations/> .
  
  domaincommercialoperationsvoc:attribution a skos:Concept;
    rdfs:label "attribution"@en;
    skos:prefLabel "attribution"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T17:03:21Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "An assignment of credit for a lead, opportunity or sale to the parties, campaigns or channels that sourced or influenced it."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-commercial-operations/>;
    owl:versionInfo "0.3.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-commercial-operations/> .
  
  domaincommercialoperationsvoc:benefit a skos:Concept;
    rdfs:label "benefit"@en;
    skos:prefLabel "benefit"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T17:03:21Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A form of compensation other than wages, such as health coverage or a retirement plan, provided to workers."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-commercial-operations/>;
    skos:scopeNote "core-product plan is the arrangement under which a benefit is provided."@en;
    owl:versionInfo "0.3.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-commercial-operations/> .
  
  domaincommercialoperationsvoc:buyer a skos:Concept;
    rdfs:label "buyer"@en;
    skos:prefLabel "buyer"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T17:03:21Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A role borne by a party that evaluates, makes or influences a decision to acquire an offering."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-commercial-operations/>;
    owl:versionInfo "0.3.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-commercial-operations/> .
  
  domaincommercialoperationsvoc:census a skos:Concept;
    rdfs:label "census"@en;
    skos:prefLabel "census"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T17:03:21Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A list of a prospective client's employees with the attributes needed to price benefits and coverage, such as age, location, pay and coverage elections."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-commercial-operations/>;
    skos:scopeNote "Moved from the pricing and contracts vocabulary in 0.2.0: sales collects it and pricing and contracts underwrites from it."@en;
    owl:versionInfo "0.3.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-commercial-operations/> .
  
  domaincommercialoperationsvoc:claim a skos:Concept;
    rdfs:label "claim"@en;
    skos:prefLabel "claim"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T17:03:21Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A demand by a party for a payment, remedy or right that it asserts is owed under an agreement, policy or law."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-commercial-operations/>;
    owl:versionInfo "0.3.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-commercial-operations/> .
  
  domaincommercialoperationsvoc:clause a skos:Concept;
    rdfs:label "clause"@en;
    skos:prefLabel "clause"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T17:03:21Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A distinct provision of an agreement or instrument that states a right, obligation, condition or term."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-commercial-operations/>;
    owl:versionInfo "0.3.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/vocabulary/domain-commercial-operations/> .
  
  domaincommercialoperationsvoc:commission a skos:Concept;
    rdfs:label "commission"@en;
    skos:prefLabel "commission"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T17:03:21Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "An amount paid to a party for a sale or referral, calculated as a share of the value it produced."@en;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-commercial-operations/>;
