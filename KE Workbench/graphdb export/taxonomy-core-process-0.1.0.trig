<https://www.insperity.com/taxonomy/core-process/> {
  <https://www.insperity.com/taxonomy/core-process/> a skos:ConceptScheme;
    rdfs:label "Core process taxonomy"@en;
    skos:prefLabel "Core process taxonomy"@en;
    skos:hasTopConcept processtax:management-process, processtax:operational-process,
      processtax:process-step, processtax:support-process;
    terms:description "Classification of processes and process steps, the occurrents that unfold over time and to which every other fact is anchored in the unifying ontology."@en;
    terms:title "Core process taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2026-10-14"^^xsd:dateTime;
    skos:altLabel "Process taxonomy"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/taxonomy/core-process/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  processtax:management-process a skos:Concept;
    skos:prefLabel "Management process"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A process that sets direction, allocates resources, and oversees performance of the organization."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-process/>;
    skos:altLabel "Governing process"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-process/>;
    skos:narrower processtax:enterprise-architecture-process, processtax:performance-management-process,
      processtax:risk-and-compliance-management-process, processtax:strategy-and-planning-process .
  
  processtax:operational-process a skos:Concept;
    skos:prefLabel "Operational process"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A process that directly creates or delivers value to clients."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-process/>;
    skos:altLabel "Core process"@en, "Primary process"@en, "Value chain process"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-process/>;
    skos:narrower processtax:client-onboarding-process, processtax:client-support-process,
      processtax:marketing-and-sales-process, processtax:offering-development-process, processtax:service-delivery-process .
  
  processtax:process-step a skos:Concept;
    skos:prefLabel "Process step"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A process that is a bounded part of a larger process, performed by a party or role, consuming and producing assets."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-process/>;
    skos:altLabel "Activity"@en, "Step"@en, "Task"@en;
    skos:example "Validate timesheet; calculate gross pay; approve payroll run."@en;
    skos:scopeNote "In the unifying ontology every fact is attached to the step in which it is created, used, or governed. Kinds below follow BPMN task types."@en;
    owl:versionInfo "0.1.0";
    dc:subject processvoc:process-step;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-process/>;
    skos:narrower processtax:approval-step, processtax:automated-step, processtax:calculation-step,
      processtax:communication-step, processtax:decision-step, processtax:manual-step, processtax:subprocess-step,
      processtax:user-step, processtax:validation-step, processtax:wait-step .
  
  processtax:support-process a skos:Concept;
    skos:prefLabel "Support process"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A process that enables management and operational processes."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-process/>;
    skos:altLabel "Enabling process"@en, "Supporting process"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-process/>;
    skos:narrower processtax:data-and-knowledge-management-process, processtax:financial-management-process,
      processtax:human-capital-management-process, processtax:information-technology-management-process,
      processtax:legal-process, processtax:procurement-process .
  
  processtax:approval-step a skos:Concept;
    skos:prefLabel "Approval step"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A process step in which an authorized party accepts or rejects an item."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-process/>;
    skos:broader processtax:process-step;
    skos:altLabel "Approval task"@en, "Sign-off step"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  processtax:automated-step a skos:Concept;
    skos:prefLabel "Automated step"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A process step performed entirely by software without human intervention."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-process/>;
    skos:broader processtax:process-step;
    skos:altLabel "Service task"@en, "System task"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  processtax:calculation-step a skos:Concept;
    skos:prefLabel "Calculation step"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A process step that computes a value from inputs using a governed calculation."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-process/>;
    skos:broader processtax:process-step;
    skos:altLabel "Computation step"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  processtax:client-onboarding-process a skos:Concept;
    skos:prefLabel "Client onboarding process"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An operational process that sets up a new client and its workforce for service."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-process/>;
    skos:broader processtax:operational-process;
    skos:altLabel "Implementation process"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  processtax:client-support-process a skos:Concept;
    skos:prefLabel "Client support process"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An operational process that answers inquiries and resolves requests from clients and workers."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-process/>;
    skos:broader processtax:operational-process;
    skos:altLabel "Case management process"@en, "Customer service process"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  processtax:communication-step a skos:Concept;
    skos:prefLabel "Communication step"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A process step that sends or receives information to or from a party."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-process/>;
    skos:broader processtax:process-step;
    skos:altLabel "Notification step"@en, "Receive task"@en, "Send task"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  processtax:data-and-knowledge-management-process a skos:Concept;
    skos:prefLabel "Data and knowledge management process"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A support process that acquires, defines, governs, and publishes data and knowledge."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-process/>;
    skos:broader processtax:support-process;
    skos:altLabel "Data management process"@en, "Knowledge engineering process"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  processtax:decision-step a skos:Concept;
    skos:prefLabel "Decision step"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A process step that selects an outcome or path by applying a decision model or judgement."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-process/>;
    skos:broader processtax:process-step;
    skos:altLabel "Business rule task"@en, "Gateway decision"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  processtax:enterprise-architecture-process a skos:Concept;
    skos:prefLabel "Enterprise architecture process"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A management process that defines and governs the structure of business, information, and technology."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-process/>;
    skos:broader processtax:management-process;
    skos:altLabel "Architecture governance process"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  processtax:financial-management-process a skos:Concept;
    skos:prefLabel "Financial management process"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A support process that records, reports, plans, and controls money."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-process/>;
    skos:broader processtax:support-process;
    skos:altLabel "Record to report"@en, "Finance process"@en;
    owl:versionInfo "0.1.0";
    dc:subject domainfinancevoc:record-to-report;
    core:hasLifecycleStatus core:Draft .
  
  processtax:human-capital-management-process a skos:Concept;
    skos:prefLabel "Human capital management process"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A support process that recruits, pays, develops, and retains the workforce."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-process/>;
    skos:broader processtax:support-process;
    skos:altLabel "Hire to retire"@en, "Human resources process"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  processtax:information-technology-management-process a skos:Concept;
    skos:prefLabel "Information technology management process"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A support process that plans, builds, and runs technology services."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-process/>;
    skos:broader processtax:support-process;
    skos:altLabel "IT management process"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  processtax:legal-process a skos:Concept;
    skos:prefLabel "Legal process"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A support process that drafts agreements, advises on law, and manages disputes."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-process/>;
    skos:broader processtax:support-process;
    skos:altLabel "Legal affairs process"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  processtax:performance-management-process a skos:Concept;
    skos:prefLabel "Performance management process"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A management process that sets targets, measures results, and drives improvement."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-process/>;
    skos:broader processtax:management-process;
