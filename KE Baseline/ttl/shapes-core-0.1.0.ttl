  skos:prefLabel "Measure shape"@en ;
  skos:definition "A shape that checks a measure states a quantity of something."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/shapes/core/> ;
  sh:targetClass core:Measure ;
  sh:property [
      sh:path core:measures ;
