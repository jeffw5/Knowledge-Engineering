  dct:created "2025-04-03T21:09:56.173Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:data-warehousing-and-business-intelligence
  a skos:Concept ;
  skos:prefLabel "Data warehousing & business intelligence"@en ;
  skos:altLabel "Data Warehousing & BI"@en ;
  skos:definition "The collection, storage, and analysis of large datasets to support strategic decision-making within an organization."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-compliance/> ;
  skos:broader voc:data-governance ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
