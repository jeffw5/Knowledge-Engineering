  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:product-capacity
  a skos:Concept ;
  skos:prefLabel "Product capacity"@en ;
  skos:definition "Data representing the measurable, specific ability of a Product entity over an extended period (e.g., maximum user throughput)."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
