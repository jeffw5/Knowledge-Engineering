<https://www.insperity.com/taxonomy/domain-pricing/> {
  <https://www.insperity.com/taxonomy/domain-pricing/> a skos:ConceptScheme;
    rdfs:label "Domain Pricing Taxonomy"@en;
    skos:prefLabel "Domain Pricing Taxonomy"@en;
    skos:hasTopConcept pricingtax:pricing-component, pricingtax:pricing-model, pricingtax:pricing-review,
      pricingtax:quote, pricingtax:underwriting-input, pricingtax:underwriting-outcome;
    skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en;
    terms:description "A classification of pricing components and models, quotes, underwriting inputs and outcomes, and pricing review. Contract management, agreement terms and statuses are in Domain Legal."@en;
    terms:title "Domain Pricing Taxonomy"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    skos:changeNote "0.3.0 (2026-10-21): Restructured to the operational areas and the naming standard (D26, D27): titled 'Domain Pricing Vocabulary', '… Taxonomy', '… Ontology' and '… Shapes', at …/<kind>/domain-pricing/ (formerly Pricing and contracts, …/<kind>/domain-pricing-and-contracts/). Contract management steps, agreement terms and agreement statuses, with the term and signature primitives, moved to Domain Legal (Business Operations); pricing review stays here. Built by build_domains.py from spec_pricing.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_pricing.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.2.0 (2026-10-20): Census moved to the Commercial Operations container (D2). Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_pricing.py against Baseline Core v1.0 (core 0.1.0)."@en;
    terms:created "2026-10-22"^^xsd:date;
    owl:versionInfo "0.3.0";
    terms:subject domainvoc:commercial;
    terms:isPartOf <https://www.insperity.com/taxonomy/commercial-operations/>;
    owl:versionIRI <https://www.insperity.com/taxonomy/domain-pricing/0.3.0/>;
    terms:source <https://www.insperity.com/vocabulary/core-asset/>, <https://www.insperity.com/vocabulary/core-event/>,
      <https://www.insperity.com/vocabulary/core-issue/>, <https://www.insperity.com/vocabulary/core-location/>,
      <https://www.insperity.com/vocabulary/core-process/>, <https://www.insperity.com/vocabulary/core-product/>,
      <https://www.insperity.com/vocabulary/core-role/>, <https://www.insperity.com/vocabulary/core-rules/>,
      <https://www.insperity.com/vocabulary/core-services/>, <https://www.insperity.com/vocabulary/core-time/>,
      <https://www.insperity.com/vocabulary/core-decision/>, <https://www.insperity.com/vocabulary/core-governance/>,
      <https://www.insperity.com/vocabulary/core-job/>, <https://www.insperity.com/vocabulary/core-measure/>,
      <https://www.insperity.com/vocabulary/commercial-operations/>, <https://www.insperity.com/vocabulary/domain-pricing/>;
    vaem:namespace "https://www.insperity.com/taxonomy/domain-pricing/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft;
    vann:preferredNamespacePrefix "pricingtax";
    terms:publisher <https://www.insperity.com/resource/core/Organization/insperity>;
    terms:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/>;
    terms:identifier "taxonomy-domain-pricing";
    terms:replaces <https://www.insperity.com/taxonomy/domain-pricing-and-contracts/> .
  
  pricingtax:pricing-component a skos:Concept;
    rdfs:label "Pricing component"@en;
    skos:prefLabel "Pricing component"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A measure that is one of the amounts or rates from which the price of a professional employer organization offering is built."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-pricing/>;
    owl:versionInfo "0.3.0";
    terms:subject assetvoc:component, decisionvoc:pricing;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-pricing/>;
    skos:narrower pricingtax:benefits-rate, pricingtax:discount, pricingtax:employer-burden,
      pricingtax:service-fee, pricingtax:unemployment-insurance-rate, pricingtax:workers-compensation-rate;
    core:hasPrimaryTerm assetvoc:component;
    core:formalizedBy core:measure .
  
  pricingtax:pricing-model a skos:Concept;
    rdfs:label "Pricing model"@en;
    skos:prefLabel "Pricing model"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A directive that sets how the price of an offering is built from its pricing components."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-pricing/>;
    owl:versionInfo "0.3.0";
    terms:subject assetvoc:model, decisionvoc:pricing;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-pricing/>;
    skos:narrower pricingtax:bundled-pricing, pricingtax:per-worksite-employee-pricing,
      pricingtax:percentage-of-payroll-pricing, pricingtax:unbundled-pricing;
    core:hasPrimaryTerm assetvoc:model;
    core:formalizedBy core:directive;
    skos:broadMatch producttax:pricing-models-and-structures .
  
  pricingtax:pricing-review a skos:Concept;
    rdfs:label "Pricing review"@en;
    skos:prefLabel "Pricing review"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A process step that reviews and approves non-standard prices or terms before a proposal or agreement is offered."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-pricing/>;
    skos:altLabel "Deal desk review"@en;
    owl:versionInfo "0.3.0";
    terms:subject decisionvoc:pricing, governancevoc:review;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-pricing/>;
    core:hasPrimaryTerm governancevoc:review;
    core:formalizedBy core:process-step;
    skos:broadMatch servicestax:contract-management .
  
  pricingtax:quote a skos:Concept;
    rdfs:label "Quote"@en;
    skos:prefLabel "Quote"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "An information asset that states the prices at which the organization offers an offering to a prospect or client, valid for a stated period."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-pricing/>;
    owl:versionInfo "0.3.0";
    terms:subject pricingvoc:quote;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-pricing/>;
    skos:narrower pricingtax:benefits-quote, pricingtax:renewal-quote, pricingtax:workers-compensation-quote;
    core:hasPrimaryTerm pricingvoc:quote;
    core:formalizedBy pricing:quote;
    skos:broadMatch <https://www.insperity.com/taxonomy/commercial-operations/proposal> .
  
  pricingtax:underwriting-input a skos:Concept;
    rdfs:label "Underwriting input"@en;
    skos:prefLabel "Underwriting input"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "An information asset consumed by underwriting to assess the risk of covering a client."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-pricing/>;
    owl:versionInfo "0.3.0";
    terms:subject processvoc:inputs, pricingvoc:underwriting;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-pricing/>;
    skos:narrower pricingtax:class-code, pricingtax:experience-modification-factor, pricingtax:loss-run,
      pricingtax:underwriting-guideline;
    core:hasPrimaryTerm processvoc:inputs;
    core:formalizedBy core:information-asset .
  
  pricingtax:underwriting-outcome a skos:Concept;
    rdfs:label "Underwriting outcome"@en;
    skos:prefLabel "Underwriting outcome"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    terms:created "2026-10-22"^^xsd:date;
    skos:definition "A decision reached by underwriting on whether, and on what terms, to offer coverage."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-pricing/>;
    owl:versionInfo "0.3.0";
    terms:subject jobvoc:outcome, pricingvoc:underwriting;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-pricing/>;
    skos:narrower pricingtax:conditional-approval, pricingtax:pricing-exception, pricingtax:underwriting-approval,
      pricingtax:underwriting-denial;
    core:hasPrimaryTerm jobvoc:outcome;
