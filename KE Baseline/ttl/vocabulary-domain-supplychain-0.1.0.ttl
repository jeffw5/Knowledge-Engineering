  skos:prefLabel "Warehouse safety"@en ;
  skos:definition "The implementation of measures to ensure the safety of workers and goods in a warehouse."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-supplychain/> ;
  skos:broader voc:warehouse-management ;
  owl:versionInfo "0.1.0" ;
