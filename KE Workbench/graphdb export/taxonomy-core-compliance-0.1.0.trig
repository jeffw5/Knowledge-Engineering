  <https://www.insperity.com/taxonomy/core-compliance/> a owl:Ontology;
    rdfs:label "Core compliance taxonomy"@en;
    terms:description "The compliance taxonomy organizes and categorizes Verizon’s compliance obligations to effectively manage compliance risks, streamline audits and ensure adherence to relevant legal and ethical requirements."@en;
    terms:title "Core compliance taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:altLabel "Taxonomy | Core | Compliance"@en;
    owl:versionInfo "0.1.0" .
  
  compliancetax:Compliance a owl:Class;
    rdfs:label "Compliance"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-compliance/>;
    skos:prefLabel "Compliance"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2024-10-02T18:03:28.133Z"^^xsd:dateTime;
    skos:definition "Adherence to laws, regulations, policies, and ethical standards relevant to an organization’s operations."@en;
    owl:versionInfo "0.1.0" .
  
  compliancetax:Documentation a owl:Class;
    rdfs:subClassOf compliancetax:Compliance;
    rdfs:label "Documentation"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-compliance/>;
    skos:prefLabel "Documentation"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "Formal records, procedures, and guidelines that provide evidence of compliance efforts and serve as a reference for employees."@en;
    owl:versionInfo "0.1.0" .
  
  compliancetax:Regulation a owl:Class;
    rdfs:subClassOf compliancetax:Compliance;
    rdfs:label "Regulation"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-compliance/>;
    skos:prefLabel "Regulation"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "Mandatory rules or laws imposed by government or regulatory bodies to govern specific industries or activities, including data protection and privacy."@en;
    owl:versionInfo "0.1.0" .
  
  compliancetax:Controls a owl:Class;
    rdfs:subClassOf compliancetax:Compliance;
    rdfs:label "Controls"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-compliance/>;
    skos:prefLabel "Controls"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "Mechanisms and procedures implemented to ensure compliance with regulations and internal policies."@en;
    owl:versionInfo "0.1.0" .
  
  compliancetax:AnalyticsAiModelControls a owl:Class;
    rdfs:subClassOf compliancetax:Controls;
    rdfs:label "Analytics & artificial intelligence model controls"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-compliance/>;
    skos:prefLabel "Analytics & artificial intelligence model controls"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "Specific controls focused on the development, deployment, and use of analytics and AI models to ensure fairness, accuracy, and ethical considerations."@en;
    skos:altLabel "Analytics & AI model controls"@en;
    owl:versionInfo "0.1.0" .
  
  compliancetax:ChangeManagementControls a owl:Class;
    rdfs:subClassOf compliancetax:Controls;
    rdfs:label "Change management controls"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-compliance/>;
    skos:prefLabel "Change management controls"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "Processes and procedures designed to manage and control changes to systems, processes, and data to maintain compliance throughout the change lifecycle."@en;
    owl:versionInfo "0.1.0" .
  
  compliancetax:ComplianceAuditsControlsReporting a owl:Class;
    rdfs:subClassOf compliancetax:Controls;
    rdfs:label "Compliance audits & controls reporting"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-compliance/>;
    skos:prefLabel "Compliance audits & controls reporting"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "Systematic evaluations and reports that assess the effectiveness of compliance controls and identify areas for improvement."@en;
    owl:versionInfo "0.1.0" .
  
  compliancetax:DataAccessControls a owl:Class;
    rdfs:subClassOf compliancetax:Controls;
    rdfs:label "Data access controls"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-compliance/>;
    skos:prefLabel "Data access controls"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "Security measures that regulate who can access specific data based on their roles and responsibilities within an organization."@en;
    owl:versionInfo "0.1.0" .
  
  compliancetax:DataLifecycleControls a owl:Class;
    rdfs:subClassOf compliancetax:Controls;
    rdfs:label "Data lifecycle controls"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-compliance/>;
    skos:prefLabel "Data lifecycle controls"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2025-03-25T19:37:28.192Z"^^xsd:dateTime;
    skos:definition "Security measures applied throughout the lifecycle of data (collection, use, storage, archival, deletion) to ensure confidentiality, integrity, and availability."@en;
    owl:versionInfo "0.1.0" .
  
  compliancetax:DataPrivacyDataProtectionControls a owl:Class;
    rdfs:subClassOf compliancetax:Controls;
    rdfs:label "Data privacy & data protection controls"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-compliance/>;
    skos:prefLabel "Data privacy & data protection controls"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "Mechanisms and policies implemented to protect sensitive information from unauthorized access, use, disclosure, or destruction, ensuring compliance with privacy regulations."@en;
    owl:versionInfo "0.1.0" .
  
  compliancetax:DataQualityControls a owl:Class;
    rdfs:subClassOf compliancetax:Controls;
    rdfs:label "Data quality controls"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-compliance/>;
    skos:prefLabel "Data quality controls"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "Processes and procedures used to ensure the accuracy, completeness, consistency, and reliability of data throughout its lifecycle."@en;
    owl:versionInfo "0.1.0" .
  
  compliancetax:DataRetentionDeletionControls a owl:Class;
    rdfs:subClassOf compliancetax:Controls;
    rdfs:label "Data retention & deletion controls"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-compliance/>;
    skos:prefLabel "Data retention & deletion controls"@en;
