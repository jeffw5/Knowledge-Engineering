    skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/>;
    skos:broader applicationdatadomainvoc:resource-specification;
    skos:altLabel "Compound Resource Spec"@en .
  
  applicationdatadomainvoc:logical-resource-specification terms:created "2025-10-24T20:12:05.962Z"^^xsd:dateTime;
