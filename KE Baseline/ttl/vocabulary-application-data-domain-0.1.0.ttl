  a skos:Concept ;
  skos:prefLabel "Market & sales strategy plan"@en ;
  skos:definition "Data assets related to the long-term business plans and strategies for market presence, product focus, and sales channels."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:market-sales ;
