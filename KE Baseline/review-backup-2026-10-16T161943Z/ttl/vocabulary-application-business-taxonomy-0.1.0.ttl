voc:product-performance
  a skos:Concept ;
  skos:prefLabel "Product performance"@en ;
  skos:definition "A measure of how well a product fulfills its intended purpose and meets user expectations, often evaluated through metrics related to its functionality, reliability, speed, efficiency, usability, and market success."@en ;
  skos:notation "TL2000029" ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
