    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "Rules and guidelines for sharing data internally and externally while maintaining compliance with privacy, security, and data governance regulations."@en;
    owl:versionInfo "0.1.0" .
  
  compliancetax:EthicalAiAnalyticsControls a owl:Class;
    rdfs:subClassOf compliancetax:Controls;
