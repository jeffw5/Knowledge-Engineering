voc:functional-job
  a skos:Concept ;
  skos:prefLabel "Functional job"@en ;
  skos:definition "The specific tasks and actions that users need to perform to accomplish their goals."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-requirements/> ;
