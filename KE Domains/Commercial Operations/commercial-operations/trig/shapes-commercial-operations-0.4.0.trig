  commercialopsshp:process-step-boundary-shape
    a sh:NodeShape ;
    rdfs:label "Process step boundary shape"@en ;
    skos:prefLabel "Process step boundary shape"@en ;
    skos:definition "A shape that checks the supplier and customer of a process step are parties or roles."@en ;
    rdfs:isDefinedBy <https://www.insperity.com/shapes/commercial-operations/> ;
    sh:targetClass core:process-step ;
    sh:property [
        sh:path commercialops:hasSupplier ;
        sh:message "has supplier must point to a party or a role."@en ;
        sh:or ( [
            sh:class core:party
        ] [
            sh:class core:role
        ] )
    ] ,
        [
        sh:path commercialops:hasCustomer ;
        sh:message "has customer must point to a party or a role."@en ;
        sh:or ( [
            sh:class core:party
        ] [
            sh:class core:role
        ] )
    ] ;
    owl:versionInfo "0.4.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-22"^^xsd:date ;
    dct:modified "2026-10-22T02:04:02Z"^^xsd:dateTime .

  commercialopsshp:account-shape
    a sh:NodeShape ;
    rdfs:label "Account shape"@en ;
    skos:prefLabel "Account shape"@en ;
    skos:definition "A shape that checks an account names the party it is about."@en ;
    rdfs:isDefinedBy <https://www.insperity.com/shapes/commercial-operations/> ;
    sh:targetClass commercialops:account ;
    sh:property [
        sh:path core:concerns ;
        sh:class core:party ;
        sh:message "An account must be about a party (the prospect or client)."@en ;
        sh:minCount "1"^^xsd:integer
    ] ;
    owl:versionInfo "0.4.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-22"^^xsd:date ;
    dct:modified "2026-10-22T02:04:02Z"^^xsd:dateTime .

  commercialopsshp:opportunity-shape
    a sh:NodeShape ;
    rdfs:label "Opportunity shape"@en ;
    skos:prefLabel "Opportunity shape"@en ;
    skos:definition "A shape that checks an opportunity names its party and offerings and credits a party for its source."@en ;
    rdfs:isDefinedBy <https://www.insperity.com/shapes/commercial-operations/> ;
    sh:targetClass commercialops:opportunity ;
    sh:property [
        sh:path core:concerns ;
        sh:message "An opportunity must be about the prospect or client it pursues and the offerings it would sell."@en ;
        sh:minCount "1"^^xsd:integer
    ] ,
        [
        sh:path commercialops:attributedTo ;
        sh:class core:party ;
        sh:message "attributed to must point to a party."@en
    ] ;
    owl:versionInfo "0.4.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-22"^^xsd:date ;
    dct:modified "2026-10-22T02:04:02Z"^^xsd:dateTime .

  commercialopsshp:census-shape
    a sh:NodeShape ;
    rdfs:label "Census shape"@en ;
    skos:prefLabel "Census shape"@en ;
    skos:definition "A shape that checks a census is about the persons it lists."@en ;
    rdfs:isDefinedBy <https://www.insperity.com/shapes/commercial-operations/> ;
    sh:targetClass commercialops:census ;
    sh:property [
        sh:path core:concerns ;
        sh:class core:person ;
        sh:message "A census must be about the employees it lists."@en ;
        sh:minCount "1"^^xsd:integer ;
        sh:severity sh:Warning
    ] ;
    owl:versionInfo "0.4.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
