  domainsalestax:outreach
    a skos:Concept ;
    rdfs:label "Outreach"@en ;
    skos:prefLabel "Outreach"@en ;
    skos:definition "A selling activity in which the seller contacts a party that has not asked to be contacted."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/> ;
    skos:broader domainsalestax:selling-activity ;
    core:hasPrimaryTerm domainsalesvoc:outreach ;
