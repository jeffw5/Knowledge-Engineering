<https://www.insperity.com/taxonomy/core/> {
  <https://www.insperity.com/taxonomy/core/> a skos:ConceptScheme;
    rdfs:label "Core taxonomy"@en;
    skos:prefLabel "Core taxonomy"@en;
    skos:hasTopConcept <https://www.insperity.com/taxonomy/core/financial-asset>, <https://www.insperity.com/taxonomy/core/information-asset>,
      <https://www.insperity.com/taxonomy/core/intangible-asset>, <https://www.insperity.com/taxonomy/core/physical-asset>,
      <https://www.insperity.com/taxonomy/core/software-asset>;
    terms:description "Classification of the things of value that process steps consume, produce, use, or maintain, from buildings and equipment to documents, records, datasets, and software."@en;
    terms:title "Core taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T23:03:55Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2026-10-14"^^xsd:dateTime;
    skos:altLabel "Asset taxonomy"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/taxonomy/core/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core/financial-asset> a skos:Concept;
    skos:prefLabel "Financial asset"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T23:03:55Z"^^xsd:dateTime;
    terms:created "2026-10-16T23:03:55Z"^^xsd:dateTime;
    skos:definition "An asset that is a monetary claim or contractual right to receive cash or another financial asset."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core/>;
    skos:example "Cash; accounts receivable."@en;
    owl:versionInfo "0.1.0";
    dc:subject <https://www.insperity.com/taxonomy/core/financial-asset>;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core/>;
    skos:narrower <https://www.insperity.com/taxonomy/core/cash-and-cash-equivalent>,
      <https://www.insperity.com/taxonomy/core/investment>, <https://www.insperity.com/taxonomy/core/prepaid-amount>,
      <https://www.insperity.com/taxonomy/core/receivable> .
  
  <https://www.insperity.com/taxonomy/core/information-asset> a skos:Concept;
    skos:prefLabel "Information asset"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T23:03:55Z"^^xsd:dateTime;
    terms:created "2026-10-16T23:03:55Z"^^xsd:dateTime;
    skos:definition "An asset that consists of information that can be copied across physical or digital carriers without losing its identity."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core/>;
    skos:altLabel "Information artifact"@en, "Information entity"@en;
    skos:example "A pay statement; a timesheet; a policy document."@en;
    skos:scopeNote "Aligned to the BFO generically dependent continuant category and the Information Artifact Ontology. Software is classified separately as a software asset."@en;
    owl:versionInfo "0.1.0";
    dc:subject <https://www.insperity.com/taxonomy/core/information-asset>;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core/>;
    skos:narrower <https://www.insperity.com/taxonomy/core/document>, <https://www.insperity.com/taxonomy/core/record>,
      <https://www.insperity.com/taxonomy/core/dataset>, <https://www.insperity.com/taxonomy/core/identifier>,
      <https://www.insperity.com/taxonomy/core/knowledge-artifact> .
  
  <https://www.insperity.com/taxonomy/core/intangible-asset> a skos:Concept;
    skos:prefLabel "Intangible asset"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T23:03:55Z"^^xsd:dateTime;
    terms:created "2026-10-16T23:03:55Z"^^xsd:dateTime;
    skos:definition "An asset that has no physical substance but provides future value through rights, knowledge, or reputation."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core/>;
    skos:altLabel "Non-physical asset"@en;
    owl:versionInfo "0.1.0";
    dc:subject <https://www.insperity.com/taxonomy/core/intangible-asset>;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core/>;
    skos:narrower <https://www.insperity.com/taxonomy/core/brand>, <https://www.insperity.com/taxonomy/core/intellectual-property>,
      <https://www.insperity.com/taxonomy/core/license-right>, <https://www.insperity.com/taxonomy/core/relationship-asset> .
  
  <https://www.insperity.com/taxonomy/core/physical-asset> a skos:Concept;
    skos:prefLabel "Physical asset"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T23:03:55Z"^^xsd:dateTime;
    terms:created "2026-10-16T23:03:55Z"^^xsd:dateTime;
    skos:definition "An asset that has material existence and can be located, handled, or occupied."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core/>;
    skos:altLabel "Material asset"@en, "Tangible asset"@en;
    skos:example "A worksite building; a laptop."@en;
    skos:scopeNote "Aligned to the BFO material entity category."@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core/>;
    skos:narrower <https://www.insperity.com/taxonomy/core/equipment>, <https://www.insperity.com/taxonomy/core/facility>,
      <https://www.insperity.com/taxonomy/core/inventory>, <https://www.insperity.com/taxonomy/core/vehicle> .
  
  <https://www.insperity.com/taxonomy/core/software-asset> a skos:Concept;
    skos:prefLabel "Software asset"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T23:03:55Z"^^xsd:dateTime;
    terms:created "2026-10-16T23:03:55Z"^^xsd:dateTime;
    skos:definition "An asset that is a set of executable instructions or a trained model that performs computation."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core/>;
    skos:altLabel "Software"@en, "Digital system"@en;
    skos:scopeNote "The deployed software is an asset; an artificial intelligence agent acting in a process is classified as an automated agent in the party taxonomy."@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core/>;
    skos:narrower <https://www.insperity.com/taxonomy/core/application>, <https://www.insperity.com/taxonomy/core/application-programming-interface>,
      <https://www.insperity.com/taxonomy/core/data-store>, <https://www.insperity.com/taxonomy/core/machine-learning-model>,
      <https://www.insperity.com/taxonomy/core/software-component> .
  
  <https://www.insperity.com/taxonomy/core/agreement-document> a skos:Concept;
    skos:prefLabel "Agreement document"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T23:03:55Z"^^xsd:dateTime;
    terms:created "2026-10-16T23:03:55Z"^^xsd:dateTime;
    skos:definition "A document that records the terms agreed between two or more parties."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core/>;
    skos:broader <https://www.insperity.com/taxonomy/core/document>;
    skos:altLabel "Contract document"@en, "Contract"@en;
    owl:versionInfo "0.1.0";
    dc:subject <https://www.insperity.com/taxonomy/core/agreement-document>;
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core/document> a skos:Concept;
    skos:prefLabel "Document"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T23:03:55Z"^^xsd:dateTime;
    terms:created "2026-10-16T23:03:55Z"^^xsd:dateTime;
    skos:definition "An information asset that is a bounded, human-readable unit of content with a title and author."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core/>;
    skos:broader <https://www.insperity.com/taxonomy/core/information-asset>;
    skos:example "Plan document; enrollment guide."@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:narrower <https://www.insperity.com/taxonomy/core/agreement-document>, <https://www.insperity.com/taxonomy/core/form>,
      <https://www.insperity.com/taxonomy/core/knowledge-article>, <https://www.insperity.com/taxonomy/core/notice>,
      <https://www.insperity.com/taxonomy/core/policy-document>, <https://www.insperity.com/taxonomy/core/report> .
  
  <https://www.insperity.com/taxonomy/core/application> a skos:Concept;
    skos:prefLabel "Application"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T23:03:55Z"^^xsd:dateTime;
    terms:created "2026-10-16T23:03:55Z"^^xsd:dateTime;
    skos:definition "A software asset that provides functions to users through an interface."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core/>;
    skos:broader <https://www.insperity.com/taxonomy/core/software-asset>;
    skos:altLabel "Software application"@en, "System of record"@en;
    skos:example "Payroll application; client portal."@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core/application-programming-interface> a skos:Concept;
    skos:prefLabel "Application programming interface"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T23:03:55Z"^^xsd:dateTime;
    terms:created "2026-10-16T23:03:55Z"^^xsd:dateTime;
    skos:definition "A software asset that is a defined contract through which software components call one another."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core/>;
    skos:broader <https://www.insperity.com/taxonomy/core/software-asset>;
    skos:altLabel "Interface"@en, "API"@en;
    owl:versionInfo "0.1.0";
    dc:subject <https://www.insperity.com/taxonomy/core/application-programming-interface>;
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core/audit-record> a skos:Concept;
    skos:prefLabel "Audit record"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T23:03:55Z"^^xsd:dateTime;
    terms:created "2026-10-16T23:03:55Z"^^xsd:dateTime;
    skos:definition "A record that documents who performed an action, when, and with what result, for later review."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core/>;
    skos:broader <https://www.insperity.com/taxonomy/core/record>;
    skos:altLabel "Audit log entry"@en, "Audit trail entry"@en;
    owl:versionInfo "0.1.0";
    dc:subject <https://www.insperity.com/taxonomy/core/audit-record>;
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core/record> a skos:Concept;
    skos:prefLabel "Record"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T23:03:55Z"^^xsd:dateTime;
    terms:created "2026-10-16T23:03:55Z"^^xsd:dateTime;
    skos:definition "An information asset that is evidence of an activity, transaction, or state, kept for reference or compliance."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core/>;
    skos:broader <https://www.insperity.com/taxonomy/core/information-asset>;
    skos:altLabel "Business record"@en;
    skos:scopeNote "Records are subject to retention policies."@en;
    owl:versionInfo "0.1.0";
    dc:subject <https://www.insperity.com/taxonomy/core/record>;
    core:hasLifecycleStatus core:Draft;
    skos:narrower <https://www.insperity.com/taxonomy/core/audit-record>, <https://www.insperity.com/taxonomy/core/change-record>,
      <https://www.insperity.com/taxonomy/core/party-record>, <https://www.insperity.com/taxonomy/core/transaction-record> .
  
  <https://www.insperity.com/taxonomy/core/brand> a skos:Concept;
    skos:prefLabel "Brand"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T23:03:55Z"^^xsd:dateTime;
    terms:created "2026-10-16T23:03:55Z"^^xsd:dateTime;
    skos:definition "An intangible asset that is the name, identity, and reputation by which an organization or offering is recognized."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core/>;
    skos:broader <https://www.insperity.com/taxonomy/core/intangible-asset>;
    skos:altLabel "Trademark identity"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core/cash-and-cash-equivalent> a skos:Concept;
    skos:prefLabel "Cash and cash equivalent"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T23:03:55Z"^^xsd:dateTime;
    terms:created "2026-10-16T23:03:55Z"^^xsd:dateTime;
    skos:definition "A financial asset that is currency or a highly liquid investment readily convertible to a known amount of cash."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core/>;
    skos:broader <https://www.insperity.com/taxonomy/core/financial-asset>;
    skos:altLabel "Cash"@en;
    owl:versionInfo "0.1.0";
    dc:subject <https://www.insperity.com/taxonomy/core/cash-and-cash-equivalent>;
    core:hasLifecycleStatus core:Draft .
  
  <https://www.insperity.com/taxonomy/core/change-record> a skos:Concept;
    skos:prefLabel "Change record"@en;
    terms:creator "Jeffrey Wallk";
