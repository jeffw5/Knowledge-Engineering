curl -sf -G "$GDB/repositories/$REPO/statements" --data-urlencode 'context=<https://www.insperity.com/taxonomy/core/>' -H 'Accept: application/trig' -o "$OUT/taxonomy-core.trig" && echo "saved taxonomy-core.trig" || echo "FAILED taxonomy/core/"
curl -sf -G "$GDB/repositories/$REPO/statements" --data-urlencode 'context=<https://www.insperity.com/taxonomy/reference-domain/>' -H 'Accept: application/trig' -o "$OUT/taxonomy-reference-domain.trig" && echo "saved taxonomy-reference-domain.trig" || echo "FAILED taxonomy/reference-domain/"
curl -sf -G "$GDB/repositories/$REPO/statements" --data-urlencode 'context=<https://www.insperity.com/vocabulary/application-business-taxonomy/>' -H 'Accept: application/trig' -o "$OUT/vocabulary-application-business-taxonomy.trig" && echo "saved vocabulary-application-business-taxonomy.trig" || echo "FAILED vocabulary/application-business-taxonomy/"
