      <https://www.insperity.com/taxonomy/core-governance/risk-register> .
  
  <https://www.insperity.com/taxonomy/core-governance/access-control> a skos:Concept;
    skos:prefLabel "Access control"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A control that restricts who can read or change information."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-governance/>;
