<https://www.insperity.com/taxonomy/core-services/> {
  <https://www.insperity.com/taxonomy/core-services/> a owl:Ontology;
    rdfs:label "Core services taxonomy"@en;
    terms:description "The service taxonomy categorizes services to help Verizon align services with business goals. Business services focus on high-level organizational outcomes, functional services group activities to deliver business value, and technical services support functional services through specific technology-based functions."@en;
    terms:title "Core services taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2024-09-05T03:49:47.301Z"^^xsd:dateTime;
    skos:altLabel "Taxonomy | Core | Services"@en;
    owl:versionInfo "0.1.0" .
  
  servicestax:Services a owl:Class;
    rdfs:label "Services"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-services/>;
    skos:prefLabel "Services"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2024-09-10T09:54:14.532Z"^^xsd:dateTime;
    skos:definition "Intangible activities or benefits provided by one party to another, often in exchange for payment."@en;
    owl:versionInfo "0.1.0";
    dc:subject servicesvoc:services .
  
  servicestax:BusinessServices a owl:Class;
    rdfs:subClassOf servicestax:Services;
    rdfs:label "Business services"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-services/>;
    skos:prefLabel "Business services"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2024-09-05T03:56:09.230Z"^^xsd:dateTime;
    skos:definition "A service provided to a business to support its core operations or achieve specific business outcomes."@en;
    owl:versionInfo "0.1.0";
    dc:subject servicesvoc:business-services .
  
  servicestax:CommercialServices a owl:Class;
    rdfs:subClassOf servicestax:BusinessServices;
    rdfs:label "Commercial services"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-services/>;
    skos:prefLabel "Commercial services"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2024-09-05T03:56:09.230Z"^^xsd:dateTime;
    skos:definition "Services designed for use by businesses and organizations, as opposed to individual consumers."@en;
    owl:versionInfo "0.1.0";
    dc:subject servicesvoc:commercial-services .
  
  servicestax:ContractManagement a owl:Class;
    rdfs:subClassOf servicestax:CommercialServices;
    rdfs:label "Contract management"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-services/>;
    skos:prefLabel "Contract management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2024-09-05T03:56:09.230Z"^^xsd:dateTime;
    skos:definition "The process of managing contracts with customers, vendors, partners, or employees."@en;
    owl:versionInfo "0.1.0";
    dc:subject servicesvoc:contract-management .
  
  servicestax:DemandManagement a owl:Class;
    rdfs:subClassOf servicestax:CommercialServices, servicestax:CustomerServices;
    rdfs:label "Demand management"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-services/>;
    skos:prefLabel "Demand management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2024-09-05T04:07:31.119Z"^^xsd:dateTime;
    skos:definition "The process of forecasting, influencing, and fulfilling customer demand for products and services."@en;
    owl:versionInfo "0.1.0";
    dc:subject servicesvoc:demand-management .
  
  servicestax:CustomerServices a owl:Class;
    rdfs:subClassOf servicestax:BusinessServices;
    rdfs:label "Customer services"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-services/>;
    skos:prefLabel "Customer services"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2024-09-05T03:56:09.230Z"^^xsd:dateTime;
    skos:definition "Support provided to customers before, during, and after a purchase. It encompasses all interactions a customer has with a company."@en;
    owl:versionInfo "0.1.0";
    dc:subject servicesvoc:customer-services .
  
  servicestax:MarketingManagement a owl:Class;
    rdfs:subClassOf servicestax:CommercialServices;
    rdfs:label "Marketing management"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-services/>;
    skos:prefLabel "Marketing management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2024-09-05T03:56:09.230Z"^^xsd:dateTime;
    skos:definition "The process of planning, executing, and measuring marketing campaigns to achieve specific business goals."@en;
    owl:versionInfo "0.1.0";
    dc:subject servicesvoc:marketing-management .
  
  servicestax:Advertising a owl:Class;
    rdfs:subClassOf servicestax:MarketingManagement;
    rdfs:label "Advertising"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-services/>;
    skos:prefLabel "Advertising"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2024-09-05T03:56:09.230Z"^^xsd:dateTime;
    skos:definition "A form of marketing communication that uses paid media to reach a target audience with persuasive messages."@en;
    owl:versionInfo "0.1.0";
    dc:subject servicesvoc:advertising .
  
  servicestax:CampaignManagement a owl:Class;
    rdfs:subClassOf servicestax:MarketingManagement;
    rdfs:label "Campaign management"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-services/>;
    skos:prefLabel "Campaign management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2024-09-05T03:56:09.230Z"^^xsd:dateTime;
    skos:definition "The process of planning, executing, and measuring marketing campaigns across multiple channels."@en;
    owl:versionInfo "0.1.0";
    dc:subject servicesvoc:campaign-management .
  
  servicestax:CompetitiveAnalysis a owl:Class;
    rdfs:subClassOf servicestax:MarketingManagement;
    rdfs:label "Competitive analysis"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-services/>;
    skos:prefLabel "Competitive analysis"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2024-09-05T04:07:31.119Z"^^xsd:dateTime;
    skos:definition "The process of identifying and evaluating competitors to understand their strengths, weaknesses, and strategies."@en;
    owl:versionInfo "0.1.0";
    dc:subject servicesvoc:competitive-analysis .
  
  servicestax:CompetitiveBenchmarking a owl:Class;
    rdfs:subClassOf servicestax:CompetitiveAnalysis;
    rdfs:label "Competitive benchmarking"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-services/>;
    skos:prefLabel "Competitive benchmarking"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2024-09-05T04:07:31.119Z"^^xsd:dateTime;
    skos:definition "The process of comparing a company’s products, services, and processes against those of its competitors or industry best practices."@en;
    owl:versionInfo "0.1.0";
    dc:subject servicesvoc:competitive-benchmarking .
  
  servicestax:IndustryStandards a owl:Class;
    rdfs:subClassOf servicestax:CompetitiveAnalysis;
    rdfs:label "Industry standards"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-services/>;
    skos:prefLabel "Industry standards"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2024-09-05T04:07:31.119Z"^^xsd:dateTime;
    skos:definition "Established norms, guidelines, or specifications that define acceptable quality, performance, or safety levels within a particular industry."@en;
    owl:versionInfo "0.1.0";
    dc:subject servicesvoc:industry-standards .
  
  servicestax:Innovation a owl:Class;
    rdfs:subClassOf servicestax:CompetitiveAnalysis;
    rdfs:label "Innovation"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-services/>;
    skos:prefLabel "Innovation"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2024-09-05T04:07:31.119Z"^^xsd:dateTime;
    skos:definition "The process of introducing new ideas, products, services, or processes that create value."@en;
    owl:versionInfo "0.1.0";
    dc:subject servicesvoc:innovation .
  
  servicestax:MarketDifferentiation a owl:Class;
    rdfs:subClassOf servicestax:CompetitiveAnalysis;
    rdfs:label "Market differentiation"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-services/>;
    skos:prefLabel "Market differentiation"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2024-09-05T04:07:31.119Z"^^xsd:dateTime;
    skos:definition "The process of creating a unique value proposition for a product or service that distinguishes it from competitors in the minds of customers."@en;
    owl:versionInfo "0.1.0";
    dc:subject servicesvoc:market-differentiation .
  
  servicestax:MarketingMonitoringMeasurement a owl:Class;
    rdfs:subClassOf servicestax:MarketingManagement;
    rdfs:label "Marketing monitoring & measurement"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-services/>;
    skos:prefLabel "Marketing monitoring & measurement"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2024-09-05T04:07:31.119Z"^^xsd:dateTime;
    skos:definition "The process of tracking, analyzing, and reporting on the performance of marketing campaigns and activities."@en;
    owl:versionInfo "0.1.0";
    dc:subject servicesvoc:marketing-monitoring-and-measurement .
  
  servicestax:ChurnPredictionModeling a owl:Class;
    rdfs:subClassOf servicestax:MarketingMonitoringMeasurement;
    rdfs:label "Churn prediction modeling"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-services/>;
    skos:prefLabel "Churn prediction modeling"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2024-09-05T04:07:31.119Z"^^xsd:dateTime;
    skos:definition "The use of statistical techniques to identify customers who are likely to stop using a product or service."@en;
    owl:versionInfo "0.1.0";
    dc:subject servicesvoc:churn-prediction-modeling .
  
  servicestax:CustomerSegmentation a owl:Class;
    rdfs:subClassOf servicestax:MarketingMonitoringMeasurement;
    rdfs:label "Customer segmentation"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-services/>;
    skos:prefLabel "Customer segmentation"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2024-09-05T04:07:31.119Z"^^xsd:dateTime;
    skos:definition "The process of dividing a customer base into groups with similar characteristics, needs, or behaviors."@en;
    owl:versionInfo "0.1.0";
    dc:subject servicesvoc:customer-segmentation .
  
  servicestax:PricingManagement a owl:Class;
    rdfs:subClassOf servicestax:CommercialServices;
    rdfs:label "Pricing management"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-services/>;
    skos:prefLabel "Pricing management"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2024-09-05T03:56:09.230Z"^^xsd:dateTime;
    skos:definition "The process of setting and adjusting prices for products and services to maximize profitability."@en;
    owl:versionInfo "0.1.0";
    dc:subject servicesvoc:pricing-management .
  
  servicestax:RetailOperations a owl:Class;
    rdfs:subClassOf servicestax:CommercialServices;
    rdfs:label "Retail operations"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-services/>;
    skos:prefLabel "Retail operations"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2024-09-05T03:56:09.230Z"^^xsd:dateTime;
    skos:definition "All activities related to selling goods or services directly to consumers for their personal use."@en;
    owl:versionInfo "0.1.0";
    dc:subject servicesvoc:retail-operations .
  
  servicestax:SalesOperations a owl:Class;
    rdfs:subClassOf servicestax:CommercialServices;
    rdfs:label "Sales operations"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-services/>;
    skos:prefLabel "Sales operations"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2024-09-05T03:56:09.230Z"^^xsd:dateTime;
    skos:definition "All activities that support the sales process, including sales forecasting, territory planning, and sales training."@en;
    owl:versionInfo "0.1.0";
    dc:subject servicesvoc:sales-operations .
  
  servicestax:SalesAccount a owl:Class;
    rdfs:subClassOf servicestax:SalesOperations;
    rdfs:label "Sales account"@en;
    rdfs:isDefinedBy <https://www.insperity.com/taxonomy/core-services/>;
