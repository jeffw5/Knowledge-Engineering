  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:support-activities
  a skos:Concept ;
  skos:prefLabel "Support activities"@en ;
  skos:definition "Activities that support the primary activities of the value chain (e.g., procurement, technology development)."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/core-businessoperations/> ;
  skos:broader voc:value-chain-analysis ;
  owl:versionInfo "0.1.0" ;
