voc:demand-forecasting
  a skos:Concept ;
  skos:prefLabel "Demand forecasting"@en ;
  skos:definition "The process of predicting future demand for products or services."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-supplychain/> ;
