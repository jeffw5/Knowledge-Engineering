<https://www.insperity.com/ontology/core-asset/>
  a owl:Ontology ;
  rdfs:label "Core asset ontology"@en ;
  dct:title "Core asset ontology"@en ;
  skos:altLabel "Ontology | Core | Asset"@en ;
  dct:description "The core ontology of assets: resources an organization controls from which it expects future economic benefit. It arranges physical, biological, human and digital assets, and the digital assets that data and knowledge work produces (data, data products, analytics, artifacts, agents, intellectual property), into one class hierarchy, with each class linked to its term in the core asset vocabulary. Domain ontologies specialize these classes."@en ;
  owl:imports <https://www.insperity.com/ontology/core/> ,
      <https://www.insperity.com/taxonomy/core-party/> ,
      <https://www.insperity.com/taxonomy/core-product/> ;
  vann:preferredNamespaceUri "https://www.insperity.com/ontology/core-asset/"^^xsd:anyURI ;
  dct:language "en" ;
  skos:changeNote "0.1.0 (2026-10-15): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en ;
  owl:versionInfo "0.1.0" ;
  owl:versionIRI <https://www.insperity.com/ontology/core-asset/0.1.0/> ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:contributor "Jeffrey Wallk" ;
  dct:created "2024-09-24T15:52:20.458Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T01:55:00Z"^^xsd:dateTime .

ont:Asset
  a owl:Class ;
  rdfs:label "Asset"@en ;
  skos:prefLabel "Asset"@en ;
  skos:definition "A resource controlled by an entity from which future economic benefits are expected to be generated."@en ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/core-asset/> ;
  dc:subject assetvoc:asset ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2024-09-24T17:06:34.595Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T01:55:00Z"^^xsd:dateTime .

ont:BiologicalAsset
  a owl:Class ;
  rdfs:label "Biological asset"@en ;
  skos:prefLabel "Biological asset"@en ;
  skos:definition "A living animal or plant under the control of an entity, from which future economic benefits are expected (e.g., livestock, crops)."@en ;
  rdfs:subClassOf ont:Asset ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/core-asset/> ;
  dc:subject assetvoc:biological-asset ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
