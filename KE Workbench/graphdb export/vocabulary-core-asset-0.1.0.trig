    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:52:33.260Z"^^xsd:dateTime;
    skos:definition "A contract outlining the agreed-upon level of service performance between a service provider and a customer."@en;
