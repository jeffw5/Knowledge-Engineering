  dct:modified "2026-10-22T19:46:03Z"^^xsd:dateTime .

jtbd:outcome-score
  a owl:Class ;
  rdfs:label "Outcome score"@en ;
  skos:prefLabel "Outcome score"@en ;
  skos:definition "A measure that states the importance and satisfaction one survey segment gave a desired outcome in one survey wave."@en ;
  rdfs:subClassOf core:measure ;
  rdfs:isDefinedBy <https://www.insperity.com/ontology/jobs-to-be-done/> ;
  core:hasPrimaryTerm measurevoc:measure ;
  core:hasLifecycleStatus core:Draft ;
  dct:created "2026-10-22"^^xsd:date ;
  dct:modified "2026-10-22T19:46:03Z"^^xsd:dateTime .

