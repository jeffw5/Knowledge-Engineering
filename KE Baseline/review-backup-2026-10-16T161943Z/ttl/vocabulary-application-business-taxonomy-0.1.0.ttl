  dct:created "2025-08-01T19:18:08.377Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T16:13:08Z"^^xsd:dateTime .

voc:value-added-reseller
  a skos:Concept ;
  skos:prefLabel "Value-Added reseller"@en ;
  skos:altLabel "VAR"@en , "Value-Added Reseller"@en ;
  skos:definition "An acronym for Value-Added Reseller, this is a type of indirect channel partner that not only sells a company’s products but also adds value by providing additional services, such as customization, integration, or support."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-business-taxonomy/> ;
  skos:broader voc:sales-channel ;
  owl:versionInfo "0.1.0" ;
