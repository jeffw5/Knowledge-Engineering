  voc:performance-marketing
    a skos:Concept ;
    skos:prefLabel "Performance marketing"@en ;
    skos:definition "A type of marketing where advertisers pay only when a specific action is taken, such as a sale or lead."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
    skos:broader voc:marketing ;
    skos:narrower voc:affiliate-marketing ,
        voc:conversion-rate-optimization ,
        voc:native-advertising ,
        voc:search-engine-marketing ,
        voc:social-media-marketing ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T20:29:05.848Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:affiliate-marketing
    a skos:Concept ;
    skos:prefLabel "Affiliate marketing"@en ;
    skos:definition "A type of performance-based marketing in which a business rewards one or more affiliates for each visitor or customer brought by the affiliate’s own marketing efforts."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
    skos:broader voc:performance-marketing ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T20:29:05.848Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:conversion-rate-optimization
    a skos:Concept ;
    skos:prefLabel "Conversion rate optimization"@en ;
    skos:altLabel "CRO"@en ;
    skos:definition "Improving the percentage of website visitors who take a desired action, such as making a purchase or filling out a form."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
    skos:broader voc:performance-marketing ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
    dct:creator "Jeffrey Wallk" ;
    dct:created "2025-03-31T20:29:05.848Z"^^xsd:dateTime ;
    dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

  voc:native-advertising
    a skos:Concept ;
    skos:prefLabel "Native advertising"@en ;
    skos:definition "Paid advertising that matches the form and function of the platform upon which it appears."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/domain-marketing/> ;
    skos:broader voc:performance-marketing ;
    owl:versionInfo "0.1.0" ;
    core:hasLifecycleStatus core:Draft ;
