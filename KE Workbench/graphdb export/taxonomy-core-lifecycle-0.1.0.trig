<https://www.insperity.com/taxonomy/core-lifecycle/> {
  <https://www.insperity.com/taxonomy/core-lifecycle/> a skos:ConceptScheme;
    rdfs:label "Core lifecycle taxonomy"@en;
    skos:prefLabel "Core lifecycle taxonomy"@en;
    skos:hasTopConcept lifecycletax:agreement-lifecycle, lifecycletax:artifact-lifecycle,
      lifecycletax:asset-lifecycle, lifecycletax:governance-lifecycle, lifecycletax:offering-lifecycle,
      lifecycletax:party-lifecycle, lifecycletax:work-item-lifecycle;
    terms:description "Classification of the kinds of lifecycle, the ordered sets of stages through which a thing passes from creation to retirement."@en;
    terms:title "Core lifecycle taxonomy"@en;
    terms:contributor "Jeffrey Wallk";
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-16): ingested into the https://www.insperity.com/ namespace; IRIs, labels and metadata brought into line with Semantic Governance: Services, Architecture & Integration v1.8 (Draft), Part III."@en;
    terms:created "2026-10-14"^^xsd:dateTime;
    skos:altLabel "Lifecycle taxonomy"@en;
    owl:versionInfo "0.1.0";
    vann:preferredNamespaceUri "https://www.insperity.com/taxonomy/core-lifecycle/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft .
  
  lifecycletax:agreement-lifecycle a skos:Concept;
    skos:prefLabel "Agreement lifecycle"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A lifecycle of an agreement from drafting and negotiation through execution, performance, renewal, and termination."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-lifecycle/>;
    skos:altLabel "Contract lifecycle"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-lifecycle/> .
  
  lifecycletax:artifact-lifecycle a skos:Concept;
    skos:prefLabel "Artifact lifecycle"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A lifecycle of an information or software asset from creation to retirement."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-lifecycle/>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-lifecycle/>;
    skos:narrower lifecycletax:data-lifecycle, lifecycletax:document-lifecycle, lifecycletax:knowledge-artifact-lifecycle,
      lifecycletax:model-lifecycle, lifecycletax:record-lifecycle, lifecycletax:software-release-lifecycle .
  
  lifecycletax:asset-lifecycle a skos:Concept;
    skos:prefLabel "Asset lifecycle"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A lifecycle of a physical or financial asset from planning and acquisition through operation and maintenance to disposal."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-lifecycle/>;
    skos:altLabel "Asset life cycle"@en, "Plan to dispose"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-lifecycle/> .
  
  lifecycletax:governance-lifecycle a skos:Concept;
    skos:prefLabel "Governance lifecycle"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A lifecycle of governed oversight that a policy, control, or governed artifact passes through from definition to retirement."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-lifecycle/>;
    skos:altLabel "Oversight lifecycle"@en;
    skos:scopeNote "The ten-stage knowledge governance lifecycle in Section 3.4 is in the lifecycle vocabulary."@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-lifecycle/>;
    skos:narrower lifecycletax:control-lifecycle, lifecycletax:policy-lifecycle .
  
  lifecycletax:offering-lifecycle a skos:Concept;
    skos:prefLabel "Offering lifecycle"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A lifecycle of something offered to clients from concept to withdrawal."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-lifecycle/>;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-lifecycle/>;
    skos:narrower lifecycletax:product-lifecycle, lifecycletax:service-lifecycle .
  
  lifecycletax:party-lifecycle a skos:Concept;
    skos:prefLabel "Party lifecycle"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A lifecycle of a party's relationship with the organization."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-lifecycle/>;
    skos:altLabel "Relationship lifecycle"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-lifecycle/>;
    skos:narrower lifecycletax:client-lifecycle, lifecycletax:employment-lifecycle, lifecycletax:supplier-lifecycle .
  
  lifecycletax:work-item-lifecycle a skos:Concept;
    skos:prefLabel "Work item lifecycle"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A lifecycle of a unit of tracked work from creation to closure."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-lifecycle/>;
    skos:altLabel "Ticket lifecycle"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/core-lifecycle/>;
    skos:narrower lifecycletax:change-lifecycle, lifecycletax:decision-lifecycle, lifecycletax:issue-lifecycle,
      lifecycletax:requirement-lifecycle .
  
  lifecycletax:data-lifecycle a skos:Concept;
    skos:prefLabel "Data lifecycle"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An artifact lifecycle of data from creation or acquisition through use, archiving, and deletion."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-lifecycle/>;
    skos:broader lifecycletax:artifact-lifecycle;
    skos:altLabel "Information lifecycle"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  lifecycletax:document-lifecycle a skos:Concept;
    skos:prefLabel "Document lifecycle"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An artifact lifecycle of a document from drafting through review, publication, revision, and disposal."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-lifecycle/>;
    skos:broader lifecycletax:artifact-lifecycle;
    skos:altLabel "Content lifecycle"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  lifecycletax:knowledge-artifact-lifecycle a skos:Concept;
    skos:prefLabel "Knowledge artifact lifecycle"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An artifact lifecycle of a vocabulary, taxonomy, ontology, mapping, shape, or rule from ideation to retirement."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-lifecycle/>;
    skos:broader lifecycletax:artifact-lifecycle;
    skos:altLabel "SKL"@en, "Semantic knowledge lifecycle"@en;
    skos:scopeNote "Stages are in the lifecycle vocabulary; statuses run Draft, Candidate, Released, Deprecated, Retired."@en;
    owl:versionInfo "0.1.0";
    dc:subject technicalservicesvoc:semantic-knowledge-layer;
    core:hasLifecycleStatus core:Draft .
  
  lifecycletax:model-lifecycle a skos:Concept;
    skos:prefLabel "Model lifecycle"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An artifact lifecycle of a machine learning model from design and training through validation, deployment, monitoring, and retirement."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-lifecycle/>;
    skos:broader lifecycletax:artifact-lifecycle;
    skos:altLabel "AI lifecycle"@en, "Artificial intelligence system lifecycle"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  lifecycletax:record-lifecycle a skos:Concept;
    skos:prefLabel "Record lifecycle"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An artifact lifecycle of a record from capture through retention to disposition."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-lifecycle/>;
    skos:broader lifecycletax:artifact-lifecycle;
    skos:altLabel "Records retention lifecycle"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  lifecycletax:software-release-lifecycle a skos:Concept;
    skos:prefLabel "Software release lifecycle"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "An artifact lifecycle of a software or knowledge release from build through test, stage, and production promotion to retirement."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-lifecycle/>;
    skos:broader lifecycletax:artifact-lifecycle;
    skos:altLabel "Release lifecycle"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  lifecycletax:change-lifecycle a skos:Concept;
    skos:prefLabel "Change lifecycle"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A work item lifecycle of a change from request through assessment, approval, implementation, and review."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-lifecycle/>;
    skos:broader lifecycletax:work-item-lifecycle;
    skos:altLabel "Change request lifecycle"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  lifecycletax:client-lifecycle a skos:Concept;
    skos:prefLabel "Client lifecycle"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A party lifecycle of a client from prospect through onboarding, service, renewal, and exit."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-lifecycle/>;
    skos:broader lifecycletax:party-lifecycle;
    skos:altLabel "Customer lifecycle"@en, "Prospect to client"@en;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  lifecycletax:control-lifecycle a skos:Concept;
    skos:prefLabel "Control lifecycle"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A governance lifecycle of a control from design through implementation, testing, operation, and remediation."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-lifecycle/>;
    skos:broader lifecycletax:governance-lifecycle;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  lifecycletax:decision-lifecycle a skos:Concept;
    skos:prefLabel "Decision lifecycle"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-17T01:38:18Z"^^xsd:dateTime;
    terms:created "2026-10-17T01:38:18Z"^^xsd:dateTime;
    skos:definition "A work item lifecycle of a decision from framing through analysis and choice to communication and review."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/core-lifecycle/>;
    skos:broader lifecycletax:work-item-lifecycle;
    owl:versionInfo "0.1.0";
    core:hasLifecycleStatus core:Draft .
  
  lifecycletax:employment-lifecycle a skos:Concept;
