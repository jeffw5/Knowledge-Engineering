<https://www.insperity.com/taxonomy/domain-commercial-operations/> {
  <https://www.insperity.com/taxonomy/domain-commercial-operations/> a skos:ConceptScheme;
    rdfs:label "Commercial operations domain taxonomy"@en;
    skos:prefLabel "Commercial operations domain taxonomy"@en;
    skos:hasTopConcept commercialopstax:claim, commercialopstax:commercial-activity, commercialopstax:commercial-agreement,
      commercialopstax:commercial-event, commercialopstax:commercial-measure, commercialopstax:commercial-party-role,
      commercialopstax:commercial-record, commercialopstax:employment-service, commercialopstax:market-structure,
      commercialopstax:service-model;
    skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en;
    terms:description "A classification of the commercial roles, records, agreements, service models, markets, measures, events and processes shared by the Commercial Operations domains."@en;
    terms:title "Commercial operations domain taxonomy"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-20): first release. Built by build_domains.py from spec_commercial_operations.py against Baseline Core v1.0 (core 0.1.0)."@en,
      "0.2.0 (2026-10-20): Census moved here from pricing and contracts, because sales and pricing and contracts both use it (D2); the container holds the PEO buyer persona graph that every domain addresses. Domain ontologies and shapes now name the plain ontology IRIs in owl:imports, so the KE Workbench resolves them, and pin the version built against in dcterms:requires. Built by build_domains.py from spec_commercial_operations.py against Baseline Core v1.0 (core 0.1.0)."@en;
    terms:created "2026-10-20"^^xsd:date;
    owl:versionInfo "0.2.0";
    terms:subject domainvoc:commercial;
    terms:isPartOf <https://www.insperity.com/domain/commercial-operations/>;
    owl:versionIRI <https://www.insperity.com/taxonomy/domain-commercial-operations/0.2.0/>;
    terms:source <https://www.insperity.com/vocabulary/core-asset/>, <https://www.insperity.com/vocabulary/core-domain/>,
      <https://www.insperity.com/vocabulary/core-event/>, <https://www.insperity.com/vocabulary/core-location/>,
      <https://www.insperity.com/vocabulary/core-party/>, <https://www.insperity.com/vocabulary/core-process/>,
      <https://www.insperity.com/vocabulary/core-product/>, <https://www.insperity.com/vocabulary/core-role/>,
      <https://www.insperity.com/vocabulary/core-services/>, <https://www.insperity.com/vocabulary/core-logic/>,
      <https://www.insperity.com/vocabulary/core-measure/>, <https://www.insperity.com/vocabulary/core-policy/>,
      <https://www.insperity.com/vocabulary/core-value/>, <https://www.insperity.com/vocabulary/domain-commercial-operations/>;
    vaem:namespace "https://www.insperity.com/taxonomy/domain-commercial-operations/"^^xsd:anyURI;
    terms:language "en";
    core:hasLifecycleStatus core:Draft;
    vann:preferredNamespacePrefix "commercialopstax";
    terms:publisher <https://www.insperity.com/resource/core/Organization/insperity>;
    terms:conformsTo <https://www.insperity.com/standard/semantic-governance/1.9/>;
    terms:identifier "taxonomy-domain-commercial-operations" .
  
  commercialopstax:claim a skos:Concept;
    rdfs:label "Claim"@en;
    skos:prefLabel "Claim"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "An information asset that records a demand for a payment, remedy or right asserted to be owed."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-commercial-operations/>;
    owl:versionInfo "0.2.0";
    terms:subject domaincommercialoperationsvoc:claim;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-commercial-operations/>;
    skos:narrower commercialopstax:insurance-claim, commercialopstax:workers-compensation-claim;
    core:hasPrimaryTerm domaincommercialoperationsvoc:claim;
    core:formalizedBy core:information-asset .
  
  commercialopstax:commercial-activity a skos:Concept;
    rdfs:label "Commercial activity"@en;
    skos:prefLabel "Commercial activity"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A process step performed in pursuit of, or in service of, the organization's commercial relationships and shared by more than one commercial domain."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-commercial-operations/>;
    owl:versionInfo "0.2.0";
    terms:subject partyvoc:commercial, processvoc:activity;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-commercial-operations/>;
    skos:narrower commercialopstax:attribution, commercialopstax:enablement, commercialopstax:negotiation,
      commercialopstax:qualification;
    core:hasPrimaryTerm processvoc:activity;
    core:formalizedBy core:process-step .
  
  commercialopstax:commercial-agreement a skos:Concept;
    rdfs:label "Commercial agreement"@en;
    skos:prefLabel "Commercial agreement"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A contractual instrument under which the organization provides offerings to a client or works with a partner."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-commercial-operations/>;
    skos:scopeNote "Specializes core taxonomy-core-policy \"Contractual instrument\", which already holds \"Client service agreement\", \"Service level agreement\" and \"Data processing agreement\"."@en;
    owl:versionInfo "0.2.0";
    terms:subject partyvoc:commercial, policyvoc:agreement;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-commercial-operations/>;
    skos:narrower commercialopstax:clause;
    core:hasPrimaryTerm policyvoc:agreement;
    core:formalizedBy core:directive;
    skos:broadMatch policytax:contractual-instrument .
  
  commercialopstax:commercial-event a skos:Concept;
    rdfs:label "Commercial event"@en;
    skos:prefLabel "Commercial event"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "An event in the organization's commercial relationships that changes the state of a lead, opportunity or account."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-commercial-operations/>;
    skos:scopeNote "Agreement events (execution, amendment, renewal, termination) are in core taxonomy-core-event and are used directly."@en;
    owl:versionInfo "0.2.0";
    terms:subject eventvoc:event, partyvoc:commercial;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-commercial-operations/>;
    skos:narrower commercialopstax:lead-conversion, commercialopstax:referral, commercialopstax:sale;
    core:hasPrimaryTerm eventvoc:event;
    core:formalizedBy core:event;
    skos:broadMatch eventtax:business-event .
  
  commercialopstax:commercial-measure a skos:Concept;
    rdfs:label "Commercial measure"@en;
    skos:prefLabel "Commercial measure"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A measure of the organization's commercial performance shared by the Commercial Operations domains."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-commercial-operations/>;
    owl:versionInfo "0.2.0";
    terms:subject partyvoc:commercial, measurevoc:measure;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-commercial-operations/>;
    skos:narrower commercialopstax:conversion-rate, commercialopstax:paid-worksite-employees,
      commercialopstax:pipeline-coverage, commercialopstax:win-rate;
    core:hasPrimaryTerm measurevoc:measure;
    core:formalizedBy core:measure;
    skos:broadMatch measuretax:key-performance-indicator .
  
  commercialopstax:commercial-party-role a skos:Concept;
    rdfs:label "Commercial party role"@en;
    skos:prefLabel "Commercial party role"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A role borne by a party in the organization's commercial relationships that the core commercial roles do not already name."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-commercial-operations/>;
    skos:scopeNote "Specializes core taxonomy-core-role \"Commercial role\" (broker, client, partner, prospect, supplier), which the domains use directly."@en;
    owl:versionInfo "0.2.0";
    terms:subject partyvoc:commercial, rolevoc:role;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-commercial-operations/>;
    skos:narrower commercialopstax:buyer, commercialopstax:competitor, commercialopstax:referral-source;
    core:hasPrimaryTerm rolevoc:role;
    core:formalizedBy core:role;
    skos:broadMatch roletax:commercial-role .
  
  commercialopstax:commercial-record a skos:Concept;
    rdfs:label "Commercial record"@en;
    skos:prefLabel "Commercial record"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "An information asset that records the organization's pursuit of, or relationship with, a prospect or client."@en;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-commercial-operations/>;
    owl:versionInfo "0.2.0";
    terms:subject partyvoc:commercial, assetvoc:record;
    core:hasLifecycleStatus core:Draft;
    skos:topConceptOf <https://www.insperity.com/taxonomy/domain-commercial-operations/>;
    skos:narrower commercialopstax:account, commercialopstax:census, commercialopstax:commercial-signal,
      commercialopstax:lead, commercialopstax:opportunity, commercialopstax:pipeline, commercialopstax:proposal;
    core:hasPrimaryTerm assetvoc:record;
    core:formalizedBy core:information-asset .
  
  commercialopstax:employment-service a skos:Concept;
    rdfs:label "Employment service"@en;
    skos:prefLabel "Employment service"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-20T04:19:14Z"^^xsd:dateTime;
    terms:created "2026-10-20"^^xsd:date;
    skos:definition "A service within a professional employer organization offering that carries out an employer responsibility for a client's worksite employees."@en;
