  skos:prefLabel "Cash and cash equivalent"@en ;
  skos:altLabel "Cash"@en ;
  skos:definition "A financial asset that is currency or a highly liquid investment readily convertible to a known amount of cash."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core-asset/> ;
  skos:broader assettax:financial-asset ;
  core:hasPrimaryTerm domainfinancevoc:cash-equivalent ;
