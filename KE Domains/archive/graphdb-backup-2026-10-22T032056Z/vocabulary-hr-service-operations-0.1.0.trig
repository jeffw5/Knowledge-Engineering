  <https://www.insperity.com/vocabulary/hr-service-operations/> a skos:ConceptScheme;
    rdfs:label "Human Resources Service Operations Vocabulary"@en;
    skos:prefLabel "Human Resources Service Operations Vocabulary"@en;
    skos:hasTopConcept hrserviceopsvoc:administration, hrserviceopsvoc:coaching, hrserviceopsvoc:culture,
      hrserviceopsvoc:ethics, hrserviceopsvoc:experience, hrserviceopsvoc:government, hrserviceopsvoc:retirement,
      hrserviceopsvoc:sponsorship, hrserviceopsvoc:stewardship, hrserviceopsvoc:talent;
    skos:editorialNote "Definitions were first drafted with the assistance of generative artificial intelligence tools, at the direction of the author, and are under review."@en;
    terms:description "A controlled vocabulary of the primitives that the HR Service Operations domains share and that the core lacks."@en;
    terms:title "Human Resources Service Operations Vocabulary"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-22T02:04:02Z"^^xsd:dateTime;
    skos:changeNote "0.1.0 (2026-10-21): first release: the shared assets of the operational area, with a taxonomy of its domains (D26). Built by build_domains.py from spec_hr_service_operations.py against Baseline Core v1.0 (core 0.1.0)."@en;
    terms:created "2026-10-22"^^xsd:date;
    skos:altLabel "HR Service Operations Vocabulary"@en;
    owl:versionInfo "0.1.0";
    terms:subject domainvoc:human-resource;
