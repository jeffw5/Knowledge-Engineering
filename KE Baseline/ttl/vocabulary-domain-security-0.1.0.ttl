voc:data-encryption
  a skos:Concept ;
  skos:prefLabel "Data encryption"@en ;
  skos:definition "Transforming data into an unreadable format to prevent unauthorized access."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/domain-security/> ;
  skos:broader voc:data-protection ;
  skos:narrower voc:asymmetric-encryption , voc:symmetric-encryption ;
