  assetvoc:asset
    a skos:Concept ;
    rdfs:label "Asset"@en ;
    skos:prefLabel "Asset"@en ;
    skos:definition "A resource controlled by an entity from which future economic benefits are expected to be generated."@en ;
    skos:inScheme <https://www.insperity.com/vocabulary/core-asset/> ;
    skos:topConceptOf <https://www.insperity.com/vocabulary/core-asset/> ;
    skos:narrower assetvoc:biological-asset , assetvoc:digital-asset , assetvoc:physical-asset ;
    owl:versionInfo "0.1.0" ;
