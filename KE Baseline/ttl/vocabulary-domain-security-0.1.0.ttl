  dct:modified "2026-10-16T17:19:14Z"^^xsd:dateTime .

voc:firewall-management
  a skos:Concept ;
  skos:prefLabel "Firewall management"@en ;
  skos:definition "The process of configuring, maintaining, and monitoring firewalls to control network traffic."@en ;
