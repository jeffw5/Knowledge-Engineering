  a skos:Concept ;
  skos:prefLabel "Enterprise party roles"@en ;
  skos:definition "Data defining the roles that different Parties play within the Enterprise (Corporate) domain."@en ;
  skos:inScheme <https://www.insperity.com/vocabulary/application-data-domain/> ;
  skos:broader voc:enterprise-corporate ;
