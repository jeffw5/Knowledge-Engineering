      personavoc:preference-privacy-settings, personavoc:preferred-communication, personavoc:preferred-content,
      personavoc:preferred-topics .
  
  personavoc:prior-history-data a skos:Concept;
    skos:prefLabel "Prior history data"@en;
    terms:creator "Jeffrey Wallk";
    terms:modified "2026-10-16T17:19:14Z"^^xsd:dateTime;
    terms:created "2025-03-31T18:46:17.202Z"^^xsd:dateTime;
