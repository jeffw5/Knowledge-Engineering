  dct:created "2026-10-16T23:03:55Z"^^xsd:dateTime ;
  dct:modified "2026-10-16T23:03:55Z"^^xsd:dateTime .

tax:rule-specification
  a skos:Concept ;
  skos:prefLabel "Rule specification"@en ;
  skos:definition "A knowledge artifact that declaratively defines a business rule, constraint, logic component, or calculation in the single source of truth."@en ;
  skos:inScheme <https://www.insperity.com/taxonomy/core/> ;
  skos:broader tax:knowledge-artifact ;
  dc:subject tax:rule-specification ;
  owl:versionInfo "0.1.0" ;
  core:hasLifecycleStatus core:Draft ;
