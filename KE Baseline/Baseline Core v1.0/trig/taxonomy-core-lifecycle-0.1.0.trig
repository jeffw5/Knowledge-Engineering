    skos:topConceptOf <https://www.insperity.com/taxonomy/core-lifecycle/> ;
    skos:narrower lifecycletax:change-lifecycle ,
        lifecycletax:decision-lifecycle ,
        lifecycletax:issue-lifecycle ,
