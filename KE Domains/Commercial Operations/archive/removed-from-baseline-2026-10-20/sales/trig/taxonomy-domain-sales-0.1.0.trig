    dct:creator "Jeffrey Wallk" ;
    dct:created "2026-10-20"^^xsd:date ;
    dct:modified "2026-10-20T02:31:43Z"^^xsd:dateTime .

  domainsalestax:client-handoff
    a skos:Concept ;
    rdfs:label "Client handoff"@en ;
    skos:prefLabel "Client handoff"@en ;
    skos:definition "A selling activity that passes responsibility for a won client from sales to the team that brings it into service."@en ;
    skos:inScheme <https://www.insperity.com/taxonomy/domain-sales/> ;
    skos:broader domainsalestax:selling-activity ;
    dct:subject eventvoc:client-handoff , rolevoc:client-handoff ;
